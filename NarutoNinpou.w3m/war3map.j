		set dist=150
		set x1=(((s__CrabWhirlpool_target_x[this] )*1.0) + Cos((( angle1 )*1.0)) * (( dist)*1.0)) // INLINED!!
		set y1=(((s__CrabWhirlpool_target_y[this] )*1.0) + Sin((( angle1 )*1.0)) * (( dist)*1.0)) // INLINED!!
