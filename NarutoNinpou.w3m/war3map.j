        call SetHeroInt(s__MuuInvisibility_caster[this], GetHeroInt(s__MuuInvisibility_caster[this], false) + s__MuuInvisibility_stat[this], false)
        call TimerStart(NewTimerEx(this), 3 + 0.5 * GetUnitAbilityLevel(s__MuuInvisibility_caster[this], s__MuuInvisibility_SPELL_ID), false, function s__MuuInvisibility_finish)
