 function s__PakuraQ_dealDamage takes nothing returns boolean
        local unit u= GetFilterUnit()
		if IsUnitType(u, UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(u) > 0.405 and not IsUnitInGroup(u, s__PakuraQ_damaged[s__PakuraQ_instance]) then
			if IsUnitEnemy(u, GetOwningPlayer(s__PakuraQ_caster[s__PakuraQ_instance])) then
				call UnitDamageTarget(s__PakuraQ_caster[s__PakuraQ_instance], u, GetHeroInt(s__PakuraQ_caster[s__PakuraQ_instance], true) * 0.8 * GetUnitAbilityLevel(s__PakuraQ_caster[s__PakuraQ_instance], s__PakuraQ_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			endif
			call GroupAddUnit(s__PakuraQ_damaged[s__PakuraQ_instance], u)
		endif
        set u=null
		return false
 endfunction 

    function s__PakuraQ_periodic2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local group g
        local unit u

        if GetWidgetLife(s__PakuraQ_orb[this]) <= 0.405 then
            call s__PakuraQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
            return
        endif

        set x=(((GetUnitX(s__PakuraQ_orb[this]) )*1.0) + Cos((( Deg2Rad(s__PakuraQ_angle[this]) )*1.0)) * (( s__PakuraQ_ORB_SPEED)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__PakuraQ_orb[this]) )*1.0) + Sin((( Deg2Rad(s__PakuraQ_angle[this]) )*1.0)) * (( s__PakuraQ_ORB_SPEED)*1.0)) // INLINED!!
        call SetUnitX(s__PakuraQ_orb[this], x)
        call SetUnitY(s__PakuraQ_orb[this], y)

        set s__PakuraQ_remainder[this]=s__PakuraQ_remainder[this] - s__PakuraQ_ORB_SPEED

        set g=CreateGroup()
        call GroupEnumUnitsInRange(g, x, y, s__PakuraQ_EXPLOSION_RADIUS, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            if IsUnitEnemy(u, GetOwningPlayer(s__PakuraQ_caster[this])) and GetWidgetLife(u) > 0.405 then
				call UnitDamageTarget(s__PakuraQ_caster[this], u, ( GetHeroInt(s__PakuraQ_caster[this], true) / 2 + 30 ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", x, y))
                call KillUnit(s__PakuraQ_orb[this])
                call GroupRemoveUnit(PakuraAllOrbs, s__PakuraQ_orb[this])
                call GroupRemoveUnit(g, u)
                exitwhen true
            endif
            call GroupRemoveUnit(g, u)
        endloop
        call DestroyGroup(g)
        set u=null
        set g=null

        if s__PakuraQ_remainder[this] <= 0.0 then
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", x, y))
            call KillUnit(s__PakuraQ_orb[this])
            call s__PakuraQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__PakuraQ_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local integer index
        local unit orb
        local real ox
        local real oy
        local real dist
        local integer this2
        local group g= CreateGroup()

        set i=0
        loop
            exitwhen i >= s__PakuraQ_WAVE_COUNT
            set index=this * s__PakuraQ_WAVE_COUNT + i
            if GetWidgetLife(PakuraQ_Wave[index]) > 0.405 then
                set PakuraQ_WaveX[index]=(((GetUnitX(PakuraQ_Wave[index]) )*1.0) + Cos((( Deg2Rad(PakuraQ_WaveAngle[index]) )*1.0)) * (( s__PakuraQ_WAVE_SPEED)*1.0)) // INLINED!!
                set PakuraQ_WaveY[index]=(((GetUnitY(PakuraQ_Wave[index]) )*1.0) + Sin((( Deg2Rad(PakuraQ_WaveAngle[index]) )*1.0)) * (( s__PakuraQ_WAVE_SPEED)*1.0)) // INLINED!!
                call SetUnitX(PakuraQ_Wave[index], PakuraQ_WaveX[index])
                call SetUnitY(PakuraQ_Wave[index], PakuraQ_WaveY[index])
                
                call GroupEnumUnitsInRange(g, PakuraQ_WaveX[index], PakuraQ_WaveY[index], 150, Filter(function s__PakuraQ_dealDamage))
            endif
            set i=i + 1
        endloop
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null

        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(PakuraAllOrbs, bj_lastCreatedGroup)
        loop
            set orb=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen orb == null
            set ox=GetUnitX(orb)
            set oy=GetUnitY(orb)
            set i=0
            loop
                exitwhen i >= s__PakuraQ_WAVE_COUNT
                set index=this * s__PakuraQ_WAVE_COUNT + i
                if GetWidgetLife(PakuraQ_Wave[index]) > 0.405 then
                    set dist=SquareRoot(( ox - PakuraQ_WaveX[index] ) * ( ox - PakuraQ_WaveX[index] ) + ( oy - PakuraQ_WaveY[index] ) * ( oy - PakuraQ_WaveY[index] ))
                    if dist < s__PakuraQ_HIT_RADIUS then
                        set this2=s__PakuraQ_allocate()
                        set s__PakuraQ_caster[this2]=s__PakuraQ_caster[this]
                        set s__PakuraQ_orb[this2]=orb
                        set s__PakuraQ_remainder[this2]=s__PakuraQ_distance[this]
                        set s__PakuraQ_angle[this2]=Atan2(oy - GetUnitY(s__PakuraQ_caster[this]), ox - GetUnitX(s__PakuraQ_caster[this])) * bj_RADTODEG
                        call TimerStart(NewTimerEx(this2), 0.03, true, function s__PakuraQ_periodic2)
                        call GroupRemoveUnit(PakuraAllOrbs, orb)
                        exitwhen true
                    endif
                endif
                set i=i + 1
            endloop
            call GroupRemoveUnit(bj_lastCreatedGroup, orb)
        endloop
        set orb=null
        call DestroyGroup(bj_lastCreatedGroup)
        
        set bj_lastCreatedGroup=CreateGroup()
        call DestroyGroup(bj_lastCreatedGroup)

        set s__PakuraQ_count[this]=s__PakuraQ_count[this] + 1
        set s__PakuraQ_traveled[this]=s__PakuraQ_traveled[this] + s__PakuraQ_WAVE_SPEED

        if s__PakuraQ_traveled[this] >= s__PakuraQ_range[this] or s__PakuraQ_count[this] > 20 then
            set i=0
            loop
                exitwhen i >= s__PakuraQ_WAVE_COUNT
                set index=this * s__PakuraQ_WAVE_COUNT + i
                if GetWidgetLife(PakuraQ_Wave[index]) > 0.405 then
                    call KillUnit(PakuraQ_Wave[index])
                endif
                set PakuraQ_Wave[index]=null
                set i=i + 1
            endloop
            call DestroyGroup(s__PakuraQ_damaged[this])
            call ReleaseTimer(GetExpiredTimer())
            call s__PakuraQ_deallocate(this)
        endif
    endfunction

    function s__PakuraQ_actions takes nothing returns nothing
        local integer this= s__PakuraQ_allocate()
        local unit caster= GetTriggerUnit()
        local real x= GetUnitX(caster)
        local real y= GetUnitY(caster)
        local real x2= (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(caster)))]) // INLINED!!
        local real y2= (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(caster)))]) // INLINED!!
        local real facing= Atan2(y2 - y, x2 - x) * bj_RADTODEG
        local real dist= GetDistance(x , y , x2 , y2)
        local real angle_start
        local real angle_step
        local integer i
        local integer index

        set s__PakuraQ_caster[this]=caster
        set caster=null
        set s__PakuraQ_traveled[this]=0.0
        set s__PakuraQ_range[this]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(s__PakuraQ_caster[this], s__PakuraQ_SPELL_ID), ABILITY_RLF_CAST_RANGE, 0)
        call BlzSetUnitFacingEx(s__PakuraQ_caster[this], facing)

        if dist < 150.0 then
            set dist=150.0
        elseif dist > 600 then
            set dist=600.0
        endif

        set s__PakuraQ_spread[this]=s__PakuraQ_MIN_SPREAD + ( dist / s__PakuraQ_range[this] ) * ( s__PakuraQ_MAX_SPREAD - s__PakuraQ_MIN_SPREAD )
        set s__PakuraQ_distance[this]=s__PakuraQ_MAX_PUSH + ( dist / s__PakuraQ_range[this] ) * ( s__PakuraQ_MIN_PUSH - s__PakuraQ_MAX_PUSH )

        set angle_step=s__PakuraQ_spread[this]
        set angle_start=facing - ( s__PakuraQ_spread[this] * ( s__PakuraQ_WAVE_COUNT - 1 ) ) / 2.0
        set s__PakuraQ_count[this]=0
        set i=0
        loop
            exitwhen i >= s__PakuraQ_WAVE_COUNT
            set index=this * s__PakuraQ_WAVE_COUNT + i
            set PakuraQ_WaveAngle[index]=angle_start + i * angle_step
            set PakuraQ_Wave[index]=CreateUnit(GetOwningPlayer(s__PakuraQ_caster[this]), 'h09H', x, y, PakuraQ_WaveAngle[index])
            call SetUnitFlyHeight(PakuraQ_Wave[index], 0, 0)
            call SetUnitScale(PakuraQ_Wave[index], 1.25, 1.25, 1.25)
            call UnitApplyTimedLife(PakuraQ_Wave[index], 'BTLF', 2.0)
            set PakuraQ_WaveX[index]=x
            set PakuraQ_WaveY[index]=y
            set i=i + 1
        endloop
        call PauseUnit(s__PakuraQ_caster[this], true)
        call SetUnitAnimation(s__PakuraQ_caster[this], "attack")
        call PauseUnit(s__PakuraQ_caster[this], false)
        set s__PakuraQ_damaged[this]=CreateGroup()
        set s__PakuraQ_instance=this
        call TimerStart(NewTimerEx(this), 0.03, true, function s__PakuraQ_periodic)
    endfunction

    function s__PakuraQ_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(87 , s__PakuraQ_SPELL_ID , function s__PakuraQ_actions)
    endfunction
