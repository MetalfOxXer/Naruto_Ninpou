                        call SetUnitX(bj_lastCreatedUnit, new_x)
                        call SetUnitY(bj_lastCreatedUnit, new_y)
                    endif
                    if not IsUnitInGroup(bj_lastCreatedUnit, s__AsumaAssault_damaged[this]) then
                        call GroupAddUnit(s__AsumaAssault_damaged[this], bj_lastCreatedUnit)
                        call UnitDamageTarget(s__AsumaAssault_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__AsumaAssault_caster[this], true) * GetUnitAbilityLevel(s__AsumaAssault_caster[this], s__AsumaAssault_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
