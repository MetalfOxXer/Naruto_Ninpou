                		set angle=Atan3(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , GetUnitX(s__KohakuNoJohei_caster[this]) , GetUnitY(s__KohakuNoJohei_caster[this]))
