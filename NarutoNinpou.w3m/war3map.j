function sa__HagoromoTQ_onDash takes nothing returns boolean

            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real casterX= GetUnitX(s__HagoromoTQ_caster[this])
            local real casterY= GetUnitY(s__HagoromoTQ_caster[this])
            local real moveX
            local real moveY
            if s__HagoromoTQ_distanceTravelled[this] >= ExplodingChargeDetonatingPalm___DASH_DISTANCE then
                call sc__HagoromoTQ_onExplosion(this)
                call sc__HagoromoTQ_cleanup(this)
            else
                set moveX=ExplodingChargeDetonatingPalm___DASH_SPEED * 0.03 * Cos(s__HagoromoTQ_angle[this])
                set moveY=ExplodingChargeDetonatingPalm___DASH_SPEED * 0.03 * Sin(s__HagoromoTQ_angle[this])
                set s__HagoromoTQ_distanceTravelled[this]=s__HagoromoTQ_distanceTravelled[this] + SquareRoot(moveX * moveX + moveY * moveY)
                call SetUnitX(s__HagoromoTQ_caster[this], casterX + moveX)
                call SetUnitY(s__HagoromoTQ_caster[this], casterY + moveY)
                call sc__HagoromoTQ_dragUnits(this)
            endif
   return true
endfunction
