 function s__SasukeChidoriEiso_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__SasukeChidoriEiso_missile[this])
  local real y= GetUnitY(s__SasukeChidoriEiso_missile[this])
  local real new_x= (((x )*1.0) + Cos((( s__SasukeChidoriEiso_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__SasukeChidoriEiso_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
  local unit u
  local integer i
		call SetUnitX(s__SasukeChidoriEiso_missile[this], new_x)
		call SetUnitY(s__SasukeChidoriEiso_missile[this], new_y)
		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SasukeChidoriEiso_caster[this]), 'h087', new_x, new_y, Rad2Deg(s__SasukeChidoriEiso_angle[this]))
		call GroupAddUnit(s__SasukeChidoriEiso_senbons[this], bj_lastCreatedUnit)
		if not s__SasukeChidoriEiso_hitsword[this] and s__SasukeAmenotejikara_another_sword != null and GetWidgetLife(s__SasukeAmenotejikara_another_sword) > 0.405 and GetDistanceUnits(s__SasukeChidoriEiso_missile[this] , s__SasukeAmenotejikara_another_sword) < 220 then
			call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_luolei.mdl" ), (( GetUnitX(s__SasukeAmenotejikara_another_sword) )*1.0), (( GetUnitY(s__SasukeAmenotejikara_another_sword))*1.0))) // INLINED!!
			set i=0
            		loop
                		set i=i + 1
                		exitwhen i > 3
                		set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__SasukeChidoriEiso_caster[this]) ), ( 'e01G' ), (( GetUnitX(s__SasukeAmenotejikara_another_sword) )*1.0), (( GetUnitY(s__SasukeAmenotejikara_another_sword) )*1.0), (( GetRandomReal(0, 360))*1.0))) // INLINED!!
                		call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            		endloop
			set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'e06R', GetUnitX(s__SasukeAmenotejikara_another_sword), GetUnitY(s__SasukeAmenotejikara_another_sword), 270)
            		call PauseUnit(u, true)
			call SetUnitFlyHeight(u, 0, 0)
			set i=0
            		loop
                		set i=i + 1
                		exitwhen i > 36
                		set new_x=GetUnitX(s__SasukeAmenotejikara_another_sword) + Cos(Deg2Rad(10 * i)) * 200
                		set new_y=GetUnitY(s__SasukeAmenotejikara_another_sword) + Sin(Deg2Rad(10 * i)) * 200
                		set bj_lastCreatedUnit=CreateAbilityDummy(s__SasukeChidoriEiso_caster[this] , 'A0JP')
                		call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__SasukeAmenotejikara_another_sword))
                		call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__SasukeAmenotejikara_another_sword))
                		call SetUnitFlyHeight(bj_lastCreatedUnit, 700, 0.0)
                		call IssueTargetOrder(bj_lastCreatedUnit, "fingerofdeath", u)
            		endloop
			call UnitApplyTimedLife(u, 'BTLF', 2.0)
			set u=null
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SasukeAmenotejikara_another_sword), GetUnitY(s__SasukeAmenotejikara_another_sword), 300, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasukeChidoriEiso_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
					//call StunUnitTimed(this.caster, bj_lastCreatedUnit, 0.5)
					call UnitDamageTarget(s__SasukeChidoriEiso_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__SasukeChidoriEiso_caster[this], true) * GetUnitAbilityLevel(s__SasukeChidoriEiso_caster[this], s__SasukeChidoriEiso_SPELL_ID) / 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			set s__SasukeChidoriEiso_hitsword[this]=true
		endif
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasukeChidoriEiso_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__SasukeChidoriEiso_damaged[this]) then
				call UnitDamageTarget(s__SasukeChidoriEiso_caster[this], bj_lastCreatedUnit, 0.8 * GetHeroAgi(s__SasukeChidoriEiso_caster[this], true) * GetUnitAbilityLevel(s__SasukeChidoriEiso_caster[this], s__SasukeChidoriEiso_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
				call GroupAddUnit(s__SasukeChidoriEiso_damaged[this], bj_lastCreatedUnit)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__SasukeChidoriEiso_count[this]=s__SasukeChidoriEiso_count[this] + 1
		if s__SasukeChidoriEiso_count[this] > 16 then
			call UnitRemoveAbility(s__SasukeChidoriEiso_caster[this], 'B00T')
			set s__SasukeChidori_blackchidori=false
			call PauseUnit(s__SasukeChidoriEiso_caster[this], false)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__SasukeChidoriEiso_senbons[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__SasukeChidoriEiso_senbons[this], bj_lastCreatedUnit)
				call KillUnit(bj_lastCreatedUnit)
				call ShowUnit(bj_lastCreatedUnit, false)
			endloop
			call DestroyGroup(s__SasukeChidoriEiso_senbons[this])
			set s__SasukeChidoriEiso_senbons[this]=null
			call DestroyGroup(s__SasukeChidoriEiso_damaged[this])
			set s__SasukeChidoriEiso_damaged[this]=null
			call s__SasukeChidoriEiso_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__SasukeChidoriEiso_spear takes nothing returns nothing
  local integer this= s__SasukeChidoriEiso_allocate()
		set s__SasukeChidoriEiso_caster[this]=GetTriggerUnit()
		set s__SasukeChidoriEiso_angle[this]=Atan3(GetUnitX(s__SasukeChidoriEiso_caster[this]) , GetUnitY(s__SasukeChidoriEiso_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
