    function s__KidomaruWebPrison_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KidomaruWebPrison_web[this])
        local real y= GetUnitY(s__KidomaruWebPrison_web[this])
        local real new_x= (((x )*1.0) + Cos((( s__KidomaruWebPrison_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KidomaruWebPrison_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        call SetUnitX(s__KidomaruWebPrison_web[this], new_x)
        call SetUnitY(s__KidomaruWebPrison_web[this], new_y)
        set s__KidomaruWebPrison_count[this]=s__KidomaruWebPrison_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 130, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KidomaruWebPrison_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                set s__KidomaruWebPrison_prison[this]=CreateUnit(GetOwningPlayer(s__KidomaruWebPrison_caster[this]), 'h04F', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), GetUnitFacing(s__KidomaruWebPrison_web[this]) + 180)
                set s__KidomaruWebPrison_target[this]=bj_lastCreatedUnit
                call EsnareUnitTimed(s__KidomaruWebPrison_caster[this] , s__KidomaruWebPrison_target[this] , 1.0)
                //call ShowUnit(this.target, false)
                call UnitDamageTarget(s__KidomaruWebPrison_caster[this], s__KidomaruWebPrison_target[this], GetHeroAgi(s__KidomaruWebPrison_caster[this], true) * GetUnitAbilityLevel(s__KidomaruWebPrison_caster[this], s__KidomaruWebPrison_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__KidomaruWebPrison_finish)
                call KillUnit(s__KidomaruWebPrison_web[this])
		set s__KidomaruWebPrison_count[this]=0
                exitwhen true
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KidomaruWebPrison_target[this] == null then
            if s__KidomaruWebPrison_count[this] > 30 then
                set s__KidomaruWebPrison_count[this]=0
                call s__KidomaruWebPrison_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        else
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KidomaruWebPrison_actions takes nothing returns nothing
        local integer this= s__KidomaruWebPrison_allocate()
        local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
        local real x= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
        local real y= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
        set s__KidomaruWebPrison_caster[this]=GetTriggerUnit()
        set s__KidomaruWebPrison_angle[this]=angle
        set s__KidomaruWebPrison_web[this]=CreateUnit(GetTriggerPlayer(), 'h046', x, y, Rad2Deg(s__KidomaruWebPrison_angle[this]) + 180)
        set s__KidomaruWebPrison_count[this]=0
	call SetUnitFlyHeight(s__KidomaruWebPrison_web[this], 100, 0)
        call SetUnitScale(s__KidomaruWebPrison_web[this], 1.0, 0, 0)
        call SetUnitAnimation(s__KidomaruWebPrison_caster[this], "attack spell")
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KidomaruWebPrison_periodic)
    endfunction 
    
    function s__KidomaruWebPrison_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(88 , s__KidomaruWebPrison_SPELL_ID , function s__KidomaruWebPrison_actions)
    endfunction 

