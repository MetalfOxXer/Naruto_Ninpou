                if not withinRadius and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoR_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( s__HagoromoR_angle[this] )*1.0)) * (( speed)*1.0)) // INLINED!!
                    set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( s__HagoromoR_angle[this] )*1.0)) * (( speed)*1.0)) // INLINED!!
                    call SetUnitPosition(bj_lastCreatedUnit, x, y)
                    if not IsUnitInGroup(bj_lastCreatedUnit, s__HagoromoR_damaged[this]) then
                        call UnitDamageTarget(s__HagoromoR_caster[this], bj_lastCreatedUnit, 250 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) * 0.75 ) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(s__HagoromoR_damaged[this], bj_lastCreatedUnit)
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)

            // Fireball Enhancement
            if (s__HagoromoE_instanceFireball[s__HagoromoE_instance]) != null then // INLINED!!
                if GetDistance(GetUnitX((s__HagoromoE_instanceFireball[s__HagoromoE_instance])) , GetUnitY((s__HagoromoE_instanceFireball[s__HagoromoE_instance])) , new_x , new_y) <= 300 then // INLINED!!
                    call s__HagoromoE_enableEmpowered(s__HagoromoR_angle[this])
                endif
            endif
            
            // Freeze Basin Empowerment Trigger
            if s__HagoromoW_basin != null then
                if GetDistance(GetUnitX(s__HagoromoW_basin) , GetUnitY(s__HagoromoW_basin) , new_x , new_y) <= 225 then
                    call s__HagoromoW_enableEmpowered()
                endif
            endif

            // Smash Wall Enhancement
            if s__HagoromoQ_wall != null and IsUnitAliveBJ(s__HagoromoQ_wall) then
                if GetDistance(GetUnitX(s__HagoromoQ_wall) , GetUnitY(s__HagoromoQ_wall) , new_x , new_y) <= 250 then
                    //call GroupEnumUnitsInRange(this.explosion, GetUnitX(HagoromoQ.wall), GetUnitY(HagoromoQ.wall), 250, Filter(function thistype.damagenumunits1))
                    
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__HagoromoQ_wall), GetUnitY(s__HagoromoQ_wall), 250, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoR_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                            call StunUnitTimed(s__HagoromoR_caster[this] , bj_lastCreatedUnit , 1.0)
                            //call BJDebugMsg(R2S(250 + (GetHeroInt(HagoromoD.Hagoromo, true) * ((GetHeroLevel(HagoromoD.Hagoromo) / 10.0) / 2))))
                            call UnitDamageTarget(s__HagoromoD_Hagoromo, bj_lastCreatedUnit, 500 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) * 0.75 ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        endif
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    endloop
                    call DestroyGroup(bj_lastCreatedGroup)
                    set s__HagoromoR_rock1=AddSpecialEffect("war3mapImported\\Rock Explosion.mdl", GetUnitX(s__HagoromoQ_wall), GetUnitY(s__HagoromoQ_wall)) //GetUnitX(HagoromoQ.wall)+ 64 * Cos((GetUnitFacing(u) * bj_DEGTORAD) + (bj_PI / 2)), GetUnitY(HagoromoQ.wall) + 32 * Sin((GetUnitFacing(u) * bj_DEGTORAD) + (bj_PI / 2)))
                    call BlzPlaySpecialEffectWithTimeScale(s__HagoromoR_rock1, ANIM_TYPE_BIRTH, 1.0)
                    call BlzSetSpecialEffectColor(s__HagoromoR_rock1, 125, 125, 125)
                    call BlzSetSpecialEffectScale(s__HagoromoR_rock1, 2.0)
                    call BlzSetSpecialEffectZ(s__HagoromoR_rock1, 100)
                    set s__HagoromoR_rock2=AddSpecialEffect("war3mapImported\\Rock Explosion.mdl", GetUnitX(s__HagoromoQ_wall), GetUnitY(s__HagoromoQ_wall)) //, GetUnitX(HagoromoQ.wall) + 64 * Cos((GetUnitFacing(u) * bj_DEGTORAD) - (bj_PI / 2)), GetUnitY(HagoromoQ.wall) + 32 * Sin((GetUnitFacing(u) * bj_DEGTORAD) - (bj_PI / 2)))
                    call BlzPlaySpecialEffectWithTimeScale(s__HagoromoR_rock2, ANIM_TYPE_BIRTH, 1.0)
                    call BlzSetSpecialEffectColor(s__HagoromoR_rock1, 125, 125, 125)
                    call BlzSetSpecialEffectScale(s__HagoromoR_rock2, 2.0)
                    call BlzSetSpecialEffectZ(s__HagoromoR_rock1, 50)
                    call KillUnit(s__HagoromoQ_wall)
                    call TimerStart(NewTimerEx(this), 1.0, false, function sc__HagoromoR_removeRocks)
                endif
            endif
        endfunction 

        function s__HagoromoR_removeRocks takes nothing returns nothing
            local integer this= s__HagoromoR_allocate()
            call DestroyEffect(s__HagoromoR_rock1)
            call DestroyEffect(s__HagoromoR_rock2)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__HagoromoR_actions takes nothing returns nothing
            local integer this= s__HagoromoR_allocate()
            set s__HagoromoR_caster[this]=s__HagoromoD_Hagoromo
            set s__HagoromoR_angle[this]=Atan2(GetSpellTargetY() - GetUnitY(s__HagoromoR_caster[this]), GetSpellTargetX() - GetUnitX(s__HagoromoR_caster[this]))
            set s__HagoromoR_count[this]=0
            set s__HagoromoR_damaged[this]=CreateGroup()
            set s__HagoromoR_explosion[this]=CreateGroup()
            set s__HagoromoR_wind[this]=CreateUnit(GetTriggerPlayer(), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this]))
            call SetUnitScale(s__HagoromoR_wind[this], 0.5, 0.5, 0.5)
            call SetUnitTimeScale(s__HagoromoR_wind[this], 2.0)
            set s__HagoromoWindR_gust[0]= CreateUnit(GetOwningPlayer(s__HagoromoR_caster[this]), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this] + 90))
            call SetUnitScale(s__HagoromoWindR_gust[0], 0.5, 0.5, 0.5)
            set s__HagoromoWindR_gust[1]= CreateUnit(GetOwningPlayer(s__HagoromoR_caster[this]), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this] + 45))
            call SetUnitScale(s__HagoromoWindR_gust[1], 0.5, 0.5, 0.5)
            set s__HagoromoWindR_gust[2]= CreateUnit(GetOwningPlayer(s__HagoromoR_caster[this]), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this] - 90))
            call SetUnitScale(s__HagoromoWindR_gust[2], 0.5, 0.5, 0.5)
            set s__HagoromoWindR_gust[3]= CreateUnit(GetOwningPlayer(s__HagoromoR_caster[this]), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this] - 45))
            call SetUnitScale(s__HagoromoWindR_gust[3], 0.5, 0.5, 0.5)
            set s__HagoromoWindR_gust[4]= CreateUnit(GetOwningPlayer(s__HagoromoR_caster[this]), 'h06K', GetUnitX(s__HagoromoR_caster[this]), GetUnitY(s__HagoromoR_caster[this]), Rad2Deg(s__HagoromoR_angle[this]))
            call SetUnitScale(s__HagoromoWindR_gust[4], 0.5, 0.5, 0.5)
	    call SetUnitAnimationByIndex(s__HagoromoR_caster[this], 16)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoR_periodic)
        endfunction 


