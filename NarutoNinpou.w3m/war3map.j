	endloop
        call DestroyGroup(s__ToneriT_damagedtwo[this])
        set s__ToneriT_damagedtwo[this]=null
        call s__ToneriT_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction


