        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__YamanakaTech_caster[this]) )*1.0), (( GetUnitY(s__YamanakaTech_caster[this]))*1.0))) // INLINED!!
