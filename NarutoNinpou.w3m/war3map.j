  local integer this= s__KimimaroCursedSealAbiltiies_allocate()
  local integer i
  local real x= GetUnitX(GetTriggerUnit())
  local real y= GetUnitY(GetTriggerUnit())
  local real x2
  local real y2
		set s__KimimaroCursedSealAbiltiies_caster[this]=GetTriggerUnit()
		set i=0
		loop
			exitwhen i > 10
			set x2=(((x )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
			set y2=(((y )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
			set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h07D', x2, y2, GetRandomReal(0, 360))
			call SetUnitTimeScale(bj_lastCreatedUnit, 0.3)
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
			set i=i + 1
		endloop
		if GetUnitTypeId(GetTriggerUnit()) == 'E021' then
			if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
				call PlaySoundOnUnitBJ(gg_snd_Kimimaro_R, 100, GetTriggerUnit())
			endif
			call TimerStart(NewTimerEx(this), 0.01, false, function s__KimimaroCursedSealAbiltiies_delay)
    		endif
 endfunction

