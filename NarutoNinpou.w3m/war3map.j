    // Enma
    
    function s__HiruzenWEnma_destroy takes integer this returns nothing
        call SetUnitFlyHeight(s__HiruzenWEnma_puppet[this], 0, 0)
        if not HiruzenCore_IsChanneling then
            call PauseUnit(s__HiruzenWEnma_puppet[this], false)
            call ResetUnitAnimation(s__HiruzenWEnma_puppet[this])
        endif
        set s__HiruzenWEnma_caster[this]=null
        call s__HiruzenWEnma_deallocate(this)
    endfunction

    function s__HiruzenWEnma_damagefix takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(HiruzenCore_Hiruzen)) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            call UnitDamageTarget(HiruzenCore_Hiruzen, GetFilterUnit(), ( 25 + GetHeroStr(HiruzenCore_Hiruzen, true) ) / 2 * GetUnitAbilityLevel(HiruzenCore_Hiruzen, s__HiruzenWEnma_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
            call StunUnitTimed(HiruzenCore_Hiruzen , GetFilterUnit() , 1.5)
        endif
    return false
    endfunction
  
    function s__HiruzenWEnma_jumpMovement takes nothing returns nothing
    local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
    local real x= GetUnitX(HiruzenCore_Enma)
    local real y= GetUnitY(HiruzenCore_Enma)
    local real new_x= (((x )*1.0) + Cos((( s__HiruzenWEnma_angle[this] )*1.0)) * (( s__HiruzenWEnma_dist[this] / 14)*1.0)) // INLINED!!
    local real new_y= (((y )*1.0) + Sin((( s__HiruzenWEnma_angle[this] )*1.0)) * (( s__HiruzenWEnma_dist[this] / 14)*1.0)) // INLINED!!
    local unit u
    local integer i
    local integer j
    set s__HiruzenWEnma_count[this]=s__HiruzenWEnma_count[this] + 1
    call SetUnitFacing(HiruzenCore_Enma, Rad2Deg(s__HiruzenWEnma_angle[this]))
    call SetUnitX(HiruzenCore_Enma, new_x)
    call SetUnitY(HiruzenCore_Enma, new_y)
    call SetUnitFlyHeight(HiruzenCore_Enma, ParabolaZ(500 , s__HiruzenWEnma_dist[this] , s__HiruzenWEnma_dist[this] / 14.0 * s__HiruzenWEnma_count[this]), 0)
    if s__HiruzenWEnma_count[this] > 13 then
        set i=1
        loop
            exitwhen i > 3
            set j=1
            loop
                exitwhen j > 10
                set x=(((new_x )*1.0) + Cos((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                set y=(((new_y )*1.0) + Sin((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                //call AddSpecialEffectEx("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", x, y)
                set j=j + 1
            endloop
            set i=i + 1
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        set s__HiruzenWEnma_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300.0, Filter(function s__HiruzenWEnma_damagefix))
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set u=null
        set i=1
        loop
            exitwhen i > s__HiruzenWEnma_count[this] / 3
            set j=0
            loop
                set j=j + 1
                exitwhen j > 6
                set x=(((GetUnitX(HiruzenCore_Enma) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 30 * ( i + 1 ))*1.0)) // INLINED!!
                set y=(((GetUnitY(HiruzenCore_Enma) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 30 * ( i + 1 ))*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            endloop
            set i=i + 1
        endloop
              
        if not HiruzenCore_IsChanneling then
            set HiruzenCore_IsCasting=false
        endif

        call s__HiruzenWEnma_destroy(this)
        call ReleaseTimer(GetExpiredTimer())
    endif
    endfunction
    
    function s__HiruzenWEnma_resetCD takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call BlzStartUnitAbilityCooldown(HiruzenCore_Hiruzen, 'A0O6', 0.00)
        call BlzEndUnitAbilityCooldown(HiruzenCore_Hiruzen, 'A0O6')
        set HiruzenCore_IsCasting=false
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__HiruzenWEnma_actions takes nothing returns nothing
        local integer this= s__HiruzenWEnma_allocate()
        local real x
        local real y
        local real distance
        local real distance1
        set HiruzenCore_IsCasting=true
            set s__HiruzenWEnma_caster[this]=HiruzenCore_Hiruzen
            set s__HiruzenWEnma_puppet[this]=HiruzenCore_Enma
            set distance=GetDistance(GetUnitX(s__HiruzenWEnma_caster[this]) , GetUnitY(s__HiruzenWEnma_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
            set distance1=GetDistance(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , GetSpellTargetX() , GetSpellTargetY())
            if GetDistance(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , GetSpellTargetX() , GetSpellTargetY()) <= 500 then
                set s__HiruzenWEnma_x[this]=GetSpellTargetX()
                set s__HiruzenWEnma_y[this]=GetSpellTargetY()
                set s__HiruzenWEnma_angle[this]=Atan3(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , s__HiruzenWEnma_x[this] , s__HiruzenWEnma_y[this])
                set s__HiruzenWEnma_dist[this]=GetDistance(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , s__HiruzenWEnma_x[this] , s__HiruzenWEnma_y[this])
                set s__HiruzenWEnma_count[this]=0
                call IssueImmediateOrder(s__HiruzenWEnma_puppet[this], "stop")
                call SetUnitFacing(s__HiruzenWEnma_puppet[this], Rad2Deg(s__HiruzenWEnma_angle[this]))
                call PauseUnit(s__HiruzenWEnma_puppet[this], true)
                call SetUnitAnimation(s__HiruzenWEnma_puppet[this], "attack 2")
                call SetUnitTimeScalePercent(s__HiruzenWEnma_puppet[this], 120.00)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__HiruzenWEnma_jumpMovement)
            elseif distance < distance1 and GetDistance(GetUnitX(s__HiruzenWEnma_caster[this]) , GetUnitY(s__HiruzenWEnma_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) <= 1250 then
                call SetUnitX(s__HiruzenWEnma_puppet[this], GetUnitX(s__HiruzenWEnma_caster[this]))
                call SetUnitY(s__HiruzenWEnma_puppet[this], GetUnitY(s__HiruzenWEnma_caster[this]))
                set s__HiruzenWEnma_x[this]=GetSpellTargetX()
                set s__HiruzenWEnma_y[this]=GetSpellTargetY()
                set s__HiruzenWEnma_angle[this]=Atan3(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , s__HiruzenWEnma_x[this] , s__HiruzenWEnma_y[this])
                set s__HiruzenWEnma_dist[this]=GetDistance(GetUnitX(s__HiruzenWEnma_puppet[this]) , GetUnitY(s__HiruzenWEnma_puppet[this]) , s__HiruzenWEnma_x[this] , s__HiruzenWEnma_y[this])
                set s__HiruzenWEnma_count[this]=0
                call IssueImmediateOrder(s__HiruzenWEnma_puppet[this], "stop")
                call SetUnitFacing(s__HiruzenWEnma_puppet[this], Rad2Deg(s__HiruzenWEnma_angle[this]))
                call PauseUnit(s__HiruzenWEnma_puppet[this], true)
                call SetUnitAnimation(s__HiruzenWEnma_puppet[this], "attack 2")
                call SetUnitTimeScalePercent(s__HiruzenWEnma_puppet[this], 120.00)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__HiruzenWEnma_jumpMovement)
            else
                set HiruzenCore_IsAttacking=true
                call SetUnitManaBJ(s__HiruzenWEnma_caster[this], BlzGetUnitRealField(s__HiruzenWEnma_caster[this], UNIT_RF_MANA) + BlzGetUnitAbilityManaCost(s__HiruzenWEnma_caster[this], s__HiruzenWEnma_SPELL_ID, GetUnitAbilityLevel(s__HiruzenWEnma_caster[this], s__HiruzenWEnma_SPELL_ID) - 1))
                call IssuePointOrder(s__HiruzenWEnma_puppet[this], "move", GetSpellTargetX(), GetSpellTargetY())
                //call IssueImmediateOrder(this.caster, "stop")
                call TimerStart(NewTimerEx(this), 0.1, false, function s__HiruzenWEnma_resetCD)
            endif
    endfunction 
    
    function s__HiruzenWEnma_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(36 , s__HiruzenWEnma_SPELL_ID , function s__HiruzenWEnma_actions)
    endfunction 
    
