                call UnitDamageTarget(s__KakuzuGrab_caster[this], bj_lastCreatedUnit, 40.0 * GetUnitAbilityLevel(s__KakuzuGrab_caster[this], s__KakuzuGrab_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
