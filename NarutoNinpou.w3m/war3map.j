    //private unit target
    
    function s__TobiramaHiraishingiri_end2 takes nothing returns nothing
 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	call UnitRemoveAbility(s__TobiramaHiraishingiri_caster[this], 'A0C2')
	call SetPlayerAbilityAvailable(GetOwningPlayer(s__TobiramaHiraishingiri_caster[this]), 'A0BQ', true)
	set s__TobiramaHiraishingiri_caster[this]=null
	call s__TobiramaHiraishingiri_deallocate(this)
