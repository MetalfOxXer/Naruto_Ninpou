    function s__ToneriR_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ToneriR_target[this])
        local real y= GetUnitY(s__ToneriR_target[this])
        local real x1= GetUnitX(s__ToneriR_caster[this])
        local real y1= GetUnitY(s__ToneriR_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__ToneriR_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__ToneriR_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_x1= (((x1 )*1.0) + Cos((( s__ToneriR_angle[this] )*1.0)) * (( - 30)*1.0)) // INLINED!!
        local real new_y1= (((y1 )*1.0) + Sin((( s__ToneriR_angle[this] )*1.0)) * (( - 30)*1.0)) // INLINED!!
 local real scaling= GetUnitState(s__ToneriR_target[this], UNIT_STATE_LIFE) / GetUnitState(s__ToneriR_target[this], UNIT_STATE_MAX_LIFE)
        set s__ToneriR_count[this]=s__ToneriR_count[this] + 1
        set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Wind.mdl", new_x, new_y)
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__ToneriR_caster[this]) + 300)
        call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__ToneriR_angle[this])
        call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 190, 194, 190)
        call DestroyEffect(bj_lastCreatedEffect)
        set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Wind.mdl", new_x1, new_y1)
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__ToneriR_caster[this]) + 300)
        call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__ToneriR_angle[this])
        call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 190, 194, 190)
        call DestroyEffect(bj_lastCreatedEffect)
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__ToneriR_target[this], new_x)
            call SetUnitY(s__ToneriR_target[this], new_y)
        endif
	if not IsTerrainPathable(new_x1, new_y1, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__ToneriR_caster[this], new_x1)
            call SetUnitY(s__ToneriR_caster[this], new_y1)
	endif
        if s__ToneriR_count[this] > 15 then
	 if GetWidgetLife(s__ToneriR_target[this]) > 0.405 and IsUnitEnemy(s__ToneriR_target[this], GetOwningPlayer(s__ToneriR_caster[this])) then
		if GetUnitAbilityLevel(s__ToneriR_caster[this], 'A0FN') > 0 and GetUnitState(s__ToneriR_target[this], UNIT_STATE_LIFE) / GetUnitState(s__ToneriR_target[this], UNIT_STATE_MAX_LIFE) <= 0.70 then
			if scaling <= 0.35 then
				set scaling=0.35
			endif
                	call UnitDamageTarget(s__ToneriR_caster[this], s__ToneriR_target[this], 6.0 * ( 1 + ( .70 - scaling ) ) * GetHeroInt(s__ToneriR_caster[this], true) * GetUnitAbilityLevel(s__ToneriR_caster[this], s__ToneriR_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		else
                	call UnitDamageTarget(s__ToneriR_caster[this], s__ToneriR_target[this], 6.0 * GetHeroInt(s__ToneriR_caster[this], true) * GetUnitAbilityLevel(s__ToneriR_caster[this], s__ToneriR_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		endif
	 endif
	    call PauseUnit(s__ToneriR_caster[this], false)
	    call PauseUnit(s__ToneriR_target[this], false)
            call s__ToneriR_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

