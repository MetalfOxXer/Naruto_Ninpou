            set s__MadaraMokuton__Spell_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', caster_x, caster_y, Rad2Deg(angle))
            call SetUnitX(s__MadaraMokuton__Spell_dummy[this], caster_x)
