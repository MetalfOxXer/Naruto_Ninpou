    function s__KurenaiCharm_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitX(s__KurenaiCharm_heart[this], GetUnitX(s__KurenaiCharm_target[this]))
        call SetUnitY(s__KurenaiCharm_heart[this], GetUnitY(s__KurenaiCharm_target[this]))
        set s__KurenaiCharm_count[this]=s__KurenaiCharm_count[this] + 1
        if s__KurenaiCharm_count[this] > 9 then
            set bj_lastCreatedEffect=AddSpecialEffect("Boom.mdx", GetUnitX(s__KurenaiCharm_target[this]), GetUnitY(s__KurenaiCharm_target[this]))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.4)
            call DestroyEffect(bj_lastCreatedEffect)
            call UnitDamageTarget(s__KurenaiCharm_caster[this], s__KurenaiCharm_target[this], 100 * GetUnitAbilityLevel(s__KurenaiCharm_caster[this], s__KurenaiCharm_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            call KillUnit(s__KurenaiCharm_heart[this])
            call ShowUnit(s__KurenaiCharm_heart[this], false)
            set s__KurenaiCharm_heart[this]=null
            set s__KurenaiCharm_target[this]=null
            call s__KurenaiCharm_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KurenaiCharm_actions takes nothing returns nothing
        local integer this
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 500, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set this=s__KurenaiCharm_allocate()
                set s__KurenaiCharm_caster[this]=GetTriggerUnit()
                set s__KurenaiCharm_target[this]=bj_lastCreatedUnit
                set s__KurenaiCharm_count[this]=0
                set s__KurenaiCharm_heart[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h02B' ), (( GetUnitX(s__KurenaiCharm_target[this]) )*1.0), (( GetUnitY(s__KurenaiCharm_target[this]) )*1.0), (( 270)*1.0))) // INLINED!!
                call SetUnitAnimation(s__KurenaiCharm_heart[this], "stand")
                call TimerStart(NewTimerEx(this), 0.02, true, function s__KurenaiCharm_periodic)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction 
    
    function s__KurenaiCharm_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(63 , s__KurenaiCharm_SPELL_ID , function s__KurenaiCharm_actions)
    endfunction 
    
