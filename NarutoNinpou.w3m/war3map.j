        function s__RoshiKakazan___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real unit_x
            local real unit_y
            local real angle
            local real offset
            local real new_x
            local real new_y
            set s__RoshiKakazan___Spell_count[this]=s__RoshiKakazan___Spell_count[this] + 1
            set angle=GetRandomReal(0, 360)
            set offset=GetRandomReal(0, 500)
            set new_x=(((s__RoshiKakazan___Spell_target_x[this] )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            set new_y=(((s__RoshiKakazan___Spell_target_y[this] )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            //call AddSpecialEffectEx("Abilities\\Spells\\Other\\Volcano\\VolcanoMissile.md", new_x, new_y)
            set angle=GetRandomReal(0, 360)
            set offset=GetRandomReal(0, 500)
            set new_x=(((s__RoshiKakazan___Spell_target_x[this] )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            set new_y=(((s__RoshiKakazan___Spell_target_y[this] )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            set angle=GetRandomReal(0, 360)
            set offset=GetRandomReal(0, 500)
            set new_x=(((s__RoshiKakazan___Spell_target_x[this] )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            set new_y=(((s__RoshiKakazan___Spell_target_y[this] )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\DemolisherFireMissile\\DemolisherFireMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
	    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__RoshiKakazan___Spell_target_x[this], s__RoshiKakazan___Spell_target_y[this], 500.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__RoshiKakazan___Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) then
                    set unit_x=GetUnitX(bj_lastCreatedUnit)
                    set unit_y=GetUnitY(bj_lastCreatedUnit)
                    set angle=Atan2(( s__RoshiKakazan___Spell_target_y[this] - unit_y ), ( s__RoshiKakazan___Spell_target_x[this] - unit_x ))
                    set new_x=unit_x + Cos(angle) * 8
                    set new_y=unit_y + Sin(angle) * 8
                    //call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                    

				if GetUnitState(s__RoshiKakazan___Spell_caster[this], UNIT_STATE_LIFE) < GetUnitState(s__RoshiKakazan___Spell_caster[this], UNIT_STATE_MAX_LIFE) / 2 and GetWidgetLife(s__RoshiKakazan___Spell_caster[this]) > 0.405 then
					call UnitDamageTarget(s__RoshiKakazan___Spell_caster[this], bj_lastCreatedUnit, ( 700 + 6.0 * GetHeroStr(s__RoshiKakazan___Spell_caster[this], true) ) * GetUnitAbilityLevel(s__RoshiKakazan___Spell_caster[this], s__RoshiKakazan___Spell_SPELL_ID) / ( 33.0 * 4 ) * ( 1.5 - GetUnitState(s__RoshiKakazan___Spell_caster[this], UNIT_STATE_LIFE) / GetUnitState(s__RoshiKakazan___Spell_caster[this], UNIT_STATE_MAX_LIFE) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__RoshiKakazan___Spell_caster[this], bj_lastCreatedUnit, ( 700 + 6.0 * GetHeroStr(s__RoshiKakazan___Spell_caster[this], true) ) * GetUnitAbilityLevel(s__RoshiKakazan___Spell_caster[this], s__RoshiKakazan___Spell_SPELL_ID) / ( 33.0 * 4 ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				endif

                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            if s__RoshiKakazan___Spell_count[this] > 4 * 33 then
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(s__RoshiKakazan___Spell_damaged[this])
                    exitwhen bj_lastCreatedUnit == null
                    call PauseUnit(bj_lastCreatedUnit, false)
                    call GroupRemoveUnit(s__RoshiKakazan___Spell_damaged[this], bj_lastCreatedUnit)
                endloop
                call DestroyGroup(s__RoshiKakazan___Spell_damaged[this])
                set s__RoshiKakazan___Spell_damaged[this]=null
                set s__RoshiKakazan___Spell_caster[this]=null
                call s__RoshiKakazan___Spell_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
        
        function s__RoshiKakazan___Spell_actions takes nothing returns nothing
            local integer this= s__RoshiKakazan___Spell_allocate()
            local real new_x
            local real new_y
            local real angle
            local real offset
            local integer n
            local integer i= 0
            local location l= GetSpellTargetLoc()
	
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            		call PlaySoundOnUnitBJ(gg_snd_Roshi_R, 100, GetTriggerUnit())
		endif

            set s__RoshiKakazan___Spell_damaged[this]=CreateGroup()
            set s__RoshiKakazan___Spell_caster[this]=GetTriggerUnit()
            set s__RoshiKakazan___Spell_target_x[this]=GetSpellTargetX()
            set s__RoshiKakazan___Spell_target_y[this]=GetSpellTargetY()
            //call TerrainDeformationCraterBJ(4.00, false, l, 500.00, 1000.00)
            call RemoveLocation(l)
            set l=null
            set n=50
            loop
                set i=i + 1
                exitwhen i > n
                set angle=( 360 / n ) * i
                set offset=300
                set new_x=s__RoshiKakazan___Spell_target_x[this] + Cos(Deg2Rad(angle)) * offset
                set new_y=s__RoshiKakazan___Spell_target_y[this] + Sin(Deg2Rad(angle)) * offset
                set angle=Atan2(( s__RoshiKakazan___Spell_target_y[this] - new_y ), ( s__RoshiKakazan___Spell_target_x[this] - new_x ))
                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e055', new_x, new_y, Rad2Deg(angle))
                call SetUnitX(bj_lastCreatedUnit, new_x)
                call SetUnitY(bj_lastCreatedUnit, new_y)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 4.5)
            endloop
            set s__RoshiKakazan___Spell_count[this]=0
            call TimerStart(NewTimerEx(this), 0.03, true, function s__RoshiKakazan___Spell_periodic)
        endfunction
        
        function s__RoshiKakazan___Spell_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(80 , s__RoshiKakazan___Spell_SPELL_ID , function s__RoshiKakazan___Spell_actions)
        endfunction
        
    
