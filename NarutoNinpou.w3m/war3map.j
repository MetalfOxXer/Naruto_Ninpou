                set s__TayuyaQOgre_caster_y[this]=GetUnitY(s__TayuyaQOgre_caster[this])
                set s__TayuyaQOgre_count[this]=0
                set s__TayuyaQOgre_castPoint[this]=GetUnitLoc(TayuyaCore_Tayuya)
                call IssueImmediateOrder(s__TayuyaQOgre_caster[this], "stop")
                call PauseUnit(s__TayuyaQOgre_caster[this], true)
                call ShowUnit(s__TayuyaQOgre_caster[this], false)
                call IssueImmediateOrder(s__TayuyaQOgre_caster[this], "holdposition")
                call SetUnitAnimation(TayuyaCore_Tayuya, "attack")
                call SetUnitTimeScale(TayuyaCore_Tayuya, 0.0)
                call SetUnitTimeScalePercent(TayuyaCore_Tayuya, 0.00)
                call BlzSetUnitRealField(TayuyaCore_Tayuya, UNIT_RF_ACQUISITION_RANGE, 0.0)
                call TimerStart(NewTimerEx(this), 0.1, false, function s__TayuyaQOgre_spawnaoe)
            elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h03H' then
                set s__TayuyaQOgre_caster[this]=TayuyaCore_Tayuya
                set s__TayuyaQOgre_puppet[this]=TayuyaCore_Puppet
