            set s__SasoriPoison_Alloc___recycle[(0)]=this
        endfunction
        
        
        function s__SasoriPoison_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x= GetUnitX(s__SasoriPoison_poison[this])
            local real y= GetUnitY(s__SasoriPoison_poison[this])
            local real angle= Atan3(x , y , s__SasoriPoison_target_x[this] , s__SasoriPoison_target_y[this])
            local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            local integer i
            if GetDistance(x , y , s__SasoriPoison_target_x[this] , s__SasoriPoison_target_y[this]) >= 70 then
                call SetUnitX(s__SasoriPoison_poison[this], new_x)
                call SetUnitY(s__SasoriPoison_poison[this], new_y)
                set i=0
                loop
                    exitwhen i > 4
                    set x=(((new_x )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                    set y=(((new_y )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                    call SetUnitX(s__SasoriPoison___sasoripoison[(this)*(1)+i], new_x)
                    call SetUnitY(s__SasoriPoison___sasoripoison[(this)*(1)+i], new_y)
                    set i=i + 1
                endloop
            endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SasoriPoison_poison[this]), GetUnitY(s__SasoriPoison_poison[this]), 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                exitwhen bj_lastCreatedUnit == null
                if not IsUnitInGroup(bj_lastCreatedUnit, s__SasoriPoison_damaged[this]) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriPoison_caster[this])) then
                    call UnitDamageTarget(s__SasoriPoison_caster[this], bj_lastCreatedUnit, 90 * s__SasoriLevelSpells_sasori_level, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__SasoriPoison_damaged[this], bj_lastCreatedUnit)
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__SasoriPoison_count[this]=s__SasoriPoison_count[this] + 1
            if s__SasoriPoison_count[this] >= 100 then
                set i=0
                loop
                    exitwhen i > 4
                    call ShowUnit(s__SasoriPoison___sasoripoison[(this)*(1)+i], false)
                    call KillUnit(s__SasoriPoison___sasoripoison[(this)*(1)+i])
                    set s__SasoriPoison___sasoripoison[(this)*(1)+i]= null
                    set i=i + 1
                endloop
                call ShowUnit(s__SasoriPoison_poison[this], false)
                call KillUnit(s__SasoriPoison_poison[this])
                set s__SasoriPoison_poison[this]=null
                call DestroyGroup(s__SasoriPoison_damaged[this])
                set s__SasoriPoison_damaged[this]=null
                call s__SasoriPoison_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction 
        
        function s__SasoriPoison_actions takes nothing returns nothing
            local integer this= s__SasoriPoison_allocate()
            local integer i= 0
            local real x
            local real y
            set s__SasoriPoison_caster[this]=GetTriggerUnit()
            set s__SasoriPoison_target_x[this]=GetSpellTargetX()
            set s__SasoriPoison_target_y[this]=GetSpellTargetY()
            set s__SasoriPoison_count[this]=0
            set s__SasoriPoison_damaged[this]=CreateGroup()
            set s__SasoriPoison_poison[this]=CreateUnit(GetOwningPlayer(s__SasoriPoison_caster[this]), 'h03V', GetUnitX(s__SasoriPoison_caster[this]), GetUnitY(s__SasoriPoison_caster[this]), 270)
            call SetUnitScale(s__SasoriPoison_poison[this], 1.5, 1.5, 1.5)
            call SetUnitVertexColor((s__SasoriPoison_poison[this] ), ( 255 ), ( 50 ), ( 255 ), ( 255)) // INLINED!!
            call SetUnitFlyHeight(s__SasoriPoison_poison[this], GetRandomReal(50.00, 200.00), 100.00)
            loop
                exitwhen i > 4
                set x=(((GetUnitX(s__SasoriPoison_caster[this]) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__SasoriPoison_caster[this]) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                set s__SasoriPoison___sasoripoison[(this)*(1)+i]= CreateUnit(GetOwningPlayer(s__SasoriPoison_caster[this]), 'h03V', x, y, 270)
                call SetUnitScale(s__SasoriPoison___sasoripoison[(this)*(1)+i], 1.5, 1.5, 1.5)
                call SetUnitVertexColor((s__SasoriPoison___sasoripoison[(this)*(1)+i] ), ( 255 ), ( 50 ), ( 255 ), ( 255)) // INLINED!!
                call SetUnitFlyHeight(s__SasoriPoison___sasoripoison[(this)*(1)+i], GetRandomReal(50.00, 200.00), 100.00)
                set i=i + 1
            endloop
            call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__SasoriPoison_periodic , "SasoriPoison_periodic")
        endfunction 
    
