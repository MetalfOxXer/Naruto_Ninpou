    function s__DanzoFuuton_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real offset= 60
        local real angle= s__DanzoFuuton_angle[this] - Deg2Rad(90)
        local real angle2= s__DanzoFuuton_angle[this] + Deg2Rad(90)
        local real new_x
        local real new_y
        local group g
        local group damaged
        local unit needle
        local integer i
        set angle=angle + Deg2Rad(18 * s__DanzoFuuton_count[this])
        if angle > s__DanzoFuuton_angle[this] + Deg2Rad(90) then
            set angle=s__DanzoFuuton_angle[this] + ( Deg2Rad(90) - Deg2Rad(18 * ( s__DanzoFuuton_count[this] - 10 )) )
        endif
        if angle < s__DanzoFuuton_angle[this] - Deg2Rad(90) then
            set angle=s__DanzoFuuton_angle[this] - ( Deg2Rad(90) + Deg2Rad(18 * ( s__DanzoFuuton_count[this] - 20 )) )
        endif
        set new_x=(((s__DanzoFuuton_caster_x[this] )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set new_y=(((s__DanzoFuuton_caster_y[this] )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__DanzoFuuton_caster[this]), 'h01Q', new_x, new_y, Rad2Deg(s__DanzoFuuton_angle[this]))
	call SetUnitTimeScale(bj_lastCreatedUnit, 0.3)
        call GroupAddUnit(s__DanzoFuuton_needles[this], bj_lastCreatedUnit)
        set damaged=CreateGroup()
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__DanzoFuuton_needles[this], bj_lastCreatedGroup)
        loop
            set needle=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen needle == null
            set new_x=(((GetUnitX(needle) )*1.0) + Cos((( s__DanzoFuuton_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
            set new_y=(((GetUnitY(needle) )*1.0) + Sin((( s__DanzoFuuton_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
            call SetUnitX(needle, new_x)
            call SetUnitY(needle, new_y)
            if GetDistance(s__DanzoFuuton_caster_x[this] , s__DanzoFuuton_caster_y[this] , new_x , new_y) > 800 then
                call KillUnit(needle)
                call ShowUnit(needle, false)
                call GroupRemoveUnit(s__DanzoFuuton_needles[this], needle)
            else
                set g=CreateGroup()
                call GroupEnumUnitsInRange(g, new_x, new_y, 220.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(g)
                    exitwhen bj_lastCreatedUnit == null
                    if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__DanzoFuuton_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                        call GroupAddUnit(damaged, bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(g, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(g)
                set g=null
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, needle)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(damaged)
            exitwhen bj_lastCreatedUnit == null
            if ModuloInteger(s__DanzoFuuton_count[this], 5) == 0 then
                set bj_lastCreatedEffect=AddSpecialEffect("zhanji-blue.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(0.25, 0.3))
                call DestroyEffect(bj_lastCreatedEffect)

                call DestroyEffect(AddSpecialEffect(("war3mapImported\\wanhuajing.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
            endif
            call UnitDamageTarget(s__DanzoFuuton_caster[this], bj_lastCreatedUnit, 90 / 30 * GetUnitAbilityLevel(s__DanzoFuuton_caster[this], s__DanzoFuuton_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
            call GroupRemoveUnit(damaged, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(damaged)
        set damaged=null
        set s__DanzoFuuton_count[this]=s__DanzoFuuton_count[this] + 1
        if s__DanzoFuuton_count[this] >= 30 then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__DanzoFuuton_needles[this])
                exitwhen bj_lastCreatedUnit == null
                call KillUnit(bj_lastCreatedUnit)
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__DanzoFuuton_needles[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__DanzoFuuton_needles[this])
            set s__DanzoFuuton_needles[this]=null
            call s__DanzoFuuton_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__DanzoFuuton_actions takes nothing returns nothing
        local integer this= s__DanzoFuuton_allocate()
        set s__DanzoFuuton_caster[this]=GetTriggerUnit()
        set s__DanzoFuuton_caster_x[this]=GetUnitX(s__DanzoFuuton_caster[this])
        set s__DanzoFuuton_caster_y[this]=GetUnitY(s__DanzoFuuton_caster[this])
        set s__DanzoFuuton_angle[this]=Atan3(GetUnitX(s__DanzoFuuton_caster[this]) , GetUnitY(s__DanzoFuuton_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__DanzoFuuton_count[this]=0
        set s__DanzoFuuton_needles[this]=CreateGroup()
        call TimerStart(NewTimerEx(this), 0.03, true, function s__DanzoFuuton_periodic)
    endfunction
    
