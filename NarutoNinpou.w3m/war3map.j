        endfunction

    function s__ThunderingTotsuka_death takes nothing returns nothing
    local integer i= 1
    local real charges
	   if IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true and GetUnitTypeId(GetTriggerUnit()) != 'H09A' and GetUnitTypeId(GetTriggerUnit()) != 'U00R' and GetUnitTypeId(GetTriggerUnit()) != 'U00Q' and GetUnitTypeId(GetTriggerUnit()) != 'U00S' and GetUnitTypeId(GetTriggerUnit()) != 'N01R' and GetUnitTypeId(GetTriggerUnit()) != 'N01Q' then
	   	loop
			exitwhen i > 6
			if GetItemTypeId(UnitItemInSlotBJ(GetKillingUnit(), i)) == 'I058' then
				set charges=I2R(GetItemCharges(UnitItemInSlotBJ(GetKillingUnit(), i))) + 1
				if charges <= 34 then
					call SetItemCharges(UnitItemInSlotBJ(GetKillingUnit(), i), GetItemCharges(UnitItemInSlotBJ(GetKillingUnit(), i)) + 1)
				endif
			endif
			set i=i + 1
		endloop
	   endif
     endfunction

 function s__ThunderingTotsuka_actions takes nothing returns nothing
  local integer this= s__ThunderingTotsuka_allocate()
     local integer i= 1
     local real damage
     local real charges
     local unit u
	   	loop
			exitwhen i > 6
			if GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), i)) == 'I058' then
				call SetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), i), GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), i)) + 1)
				set charges=I2R(GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), i))) - 1
				if charges > 33 then
					set charges=33
				endif
				set damage=GetUnitState(GetSpellTargetUnit(), UNIT_STATE_MAX_LIFE) * charges / 100
				call DestroyEffect(AddSpecialEffect(("war3mapImported\\Lightning_.mdx" ), (( GetUnitX(GetSpellTargetUnit()) )*1.0), (( GetUnitY(GetSpellTargetUnit()))*1.0))) // INLINED!!
            			call UnitDamageTarget(GetTriggerUnit(), GetSpellTargetUnit(), damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			endif
			set i=i + 1
	   	endloop
		set u=CreateAbilityDummy(GetTriggerUnit() , 'A055')
		call IssueTargetOrder(u, "soulburn", GetSpellTargetUnit())
        	call UnitApplyTimedLife(u, 'BTLF', 1.0)
		set u=null
		call s__ThunderingTotsuka_deallocate(this)
 endfunction 


 function s__ThunderingTotsuka_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2(('A0K7' ) , Filter(( function s__ThunderingTotsuka_actions))) // INLINED!!
        	call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__ThunderingTotsuka_death))) // INLINED!!
 endfunction 

