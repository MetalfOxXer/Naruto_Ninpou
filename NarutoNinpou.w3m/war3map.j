 endfunction

//===========================================================================
// Trigger: SaiFlyLevel
//===========================================================================

    function s__SaiFlyLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A1E7') == 0 and GetUnitTypeId(u) != 'O008' and GetUnitAbilityLevel(u, 'A0F5') == 10 and GetUnitAbilityLevel(u, 'A049') == 10 and GetUnitAbilityLevel(u, 'A0W8') == 10 and GetUnitAbilityLevel(u, 'A0IS') == 1 then
                call UnitRemoveAbility(u, 'A04Y')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A04Y', false)
                call UnitAddAbility(u, 'A1E7')
		call SetUnitFlyHeight(u, 200, 400)
		call BlzSetUnitWeaponIntegerFieldBJ(u, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__SaiFlyLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'O006' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__SaiFlyLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__SaiFlyLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'O006' or GetUnitTypeId(GetTriggerUnit()) == 'O008' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A04Y', true)
        endif
    endfunction

    function s__SaiFlyLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__SaiFlyLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__SaiFlyLevel_death))) // INLINED!!
    endfunction 

