function Trig_SuperBootsSpeedBuff_Func002C takes nothing returns boolean
    if UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03E') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04Z') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I050') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03F') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04V') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04W') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03G') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04X') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I04Y') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I03V') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I051') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I052') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I062') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I063') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I064') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I077') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I05F') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I00U') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I079') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I08A') or UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I08B') then
        return true
    endif
