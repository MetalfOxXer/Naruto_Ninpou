        // Ogre 01
        function s__TayuyaQOgre_PeriodicStomp takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real temp_x= GetUnitX(s__TayuyaQOgre_caster[this])
            local real temp_y= GetUnitY(s__TayuyaQOgre_caster[this])
            call IssueImmediateOrder(s__TayuyaQOgre_dummy[this], "stomp")
            call SetUnitAnimationByIndex(s__TayuyaQOgre_caster[this], 5)
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", temp_x, temp_y)
            call DestroyEffect(bj_lastCreatedEffect)

            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, temp_x, temp_y, 300.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(TayuyaCore_Puppet)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, ( 60 + GetHeroInt(TayuyaCore_Tayuya, true) / 3.5 + GetHeroStr(TayuyaCore_Tayuya, true) / 2 ) * GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaQOgre_SPELL_ID) / 5, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)

            set s__TayuyaQOgre_count[this]=s__TayuyaQOgre_count[this] + 1
            if s__TayuyaQOgre_count[this] >= 4 then
                call PauseUnit(s__TayuyaQOgre_caster[this], false)
                call SetUnitTimeScale(s__TayuyaQOgre_caster[this], 1)
                set TayuyaCore_IsChanneling=false
                set TayuyaCore_IsCasting=false
                call s__TayuyaQOgre_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction

        // Ogre 02

        function s__TayuyaQOgre_CleanDummy takes unit dummy returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local unit u= dummy
            call RemoveUnit(dummy)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__TayuyaQOgre_periodicaoe takes nothing returns nothing

            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real angle
            local real offset
            local unit dummy
            local real new_x
            local real new_y
            local real angle2
            local real clam_x
            local real clam_y
            local real temp_x
            local real temp_y
            local integer i= 0
            local location tempLoc
            //if GetWidgetLife(TayuyaCore_Puppet) > 0.405 then
            call ShowUnit(TayuyaCore_Puppet, false)
            set temp_x=GetUnitX(TayuyaCore_Puppet)
            set temp_y=GetUnitY(TayuyaCore_Puppet)
            //endif
            set s__TayuyaQOgre_count[this]=s__TayuyaQOgre_count[this] + 1
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, temp_x, temp_y, 400.0, null)
            set tempLoc=GetUnitLoc(TayuyaCore_Tayuya)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(TayuyaCore_Puppet)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    if bj_lastCreatedUnit == TayuyaCore_DokiMark then
                        call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, ( ( GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaQOgre_SPELL_ID) * ( 0.3 * GetHeroInt(TayuyaCore_Tayuya, true) + 0.9 * GetHeroAgi(TayuyaCore_Tayuya, true) ) ) * 1.25 ) / 60, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    else
                        call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, ( GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaQOgre_SPELL_ID) * ( 0.3 * GetHeroInt(TayuyaCore_Tayuya, true) + 0.9 * GetHeroAgi(TayuyaCore_Tayuya, true) ) ) / 60, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop

            call DestroyGroup(bj_lastCreatedGroup)
            loop
                set i=i + 1
                exitwhen i > 5
                set angle=GetRandomReal(0, 360)
                set offset=GetRandomReal(0, 300)
                set new_x=temp_x + Cos(Deg2Rad(angle)) * offset
                set new_y=temp_y + Sin(Deg2Rad(angle)) * offset
                set angle2=Atan2(( temp_y - new_y ), ( temp_x - new_x ))
                call SetUnitX(s__TayuyaQAbility___ogretrail[(this)*(1)+i], new_x)
                call SetUnitY(s__TayuyaQAbility___ogretrail[(this)*(1)+i], new_y)
                call SetUnitFacing(s__TayuyaQAbility___ogretrail[(this)*(1)+i], Rad2Deg(angle2))
            endloop
        
            if s__TayuyaQOgre_count[this] > 60 then // or (DistanceBetweenPoints(this.castPoint, tempLoc) > 20)
                call PauseUnit(TayuyaCore_Puppet, false)
                call ShowUnit(TayuyaCore_Puppet, true)
                call RemoveLocation(s__TayuyaQOgre_castPoint[this])
                set s__TayuyaQOgre_caster[this]=null
                call s__TayuyaQOgre_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
                set TayuyaCore_IsCasting=false
                set TayuyaCore_IsChanneling=false
                call RemoveLocation(tempLoc)
                call SetUnitTimeScale(TayuyaCore_Tayuya, 1.0)
                call SetUnitTimeScalePercent(TayuyaCore_Tayuya, 100.00)
                set TayuyaCore_OgreQ=false
                call BlzSetUnitRealField(TayuyaCore_Tayuya, UNIT_RF_ACQUISITION_RANGE, 500.0)
                if not TayuyaCore_OgreRCasting then
                    call UnitRemoveAbility(TayuyaCore_Puppet, 'Aloc')
                    call UnitAddAbility(TayuyaCore_Puppet, 'Aloc')
                endif
            endif

            call RemoveLocation(tempLoc)

        endfunction
    
        function s__TayuyaQOgre_spawnaoe takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer i= 0
            loop
                set i=i + 1
                exitwhen i > 5
                set s__TayuyaQAbility___ogretrail[(this)*(1)+i]= CreateUnit(GetOwningPlayer(TayuyaCore_Puppet), 'h04C', GetUnitX(TayuyaCore_Puppet), GetUnitY(TayuyaCore_Puppet), GetRandomReal(0, 360)) // 'h04H'
                call UnitApplyTimedLife(s__TayuyaQAbility___ogretrail[(this)*(1)+i], 'BTLF', 3.0)
            endloop
            call TimerStart(NewTimerEx(this), 0.03, true, function s__TayuyaQOgre_periodicaoe)
            call ReleaseTimer(GetExpiredTimer())
        endfunction
        
        function s__TayuyaQOgre_applyEffect takes unit centerUnit,unit caster returns nothing
            local group l__tempGroup= CreateGroup()
            call GroupEnumUnitsInRange(l__tempGroup, GetUnitX(centerUnit), GetUnitY(centerUnit), 600, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(l__tempGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(l__tempGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(caster)) then
                    call UnitDamageTarget(caster, bj_lastCreatedUnit, ( ( GetUnitAbilityLevel(caster, s__TayuyaQOgre_SPELL_ID) + 2 ) * ( 0.8 * GetHeroInt(caster, true) + 0.2 * GetHeroStr(caster, true) + 0.2 * GetHeroAgi(caster, true) ) ) / 200, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
            endloop
            call DestroyGroup(l__tempGroup)
        endfunction

        // Ogre 03
        function s__TayuyaQOgre_SpawnSegmentRing takes real cx,real cy,real r,integer pulseIndex returns nothing
            local integer i= 0
            local integer segN= s__TayuyaQOgre_SEG_COUNT + 2 * pulseIndex
            local real a
            local real x
            local real y
            local effect fx

            if segN < 6 then
                set segN=6
            endif

            loop
                exitwhen i >= segN
                set a=( 2.0 * bj_PI * i ) / I2R(segN)
                set x=cx + r * Cos(a)
                set y=cy + r * Sin(a)

                set fx=AddSpecialEffect(s__TayuyaQOgre_ROCK_SEG_MODEL, x, y)
                call BlzSetSpecialEffectYaw(fx, a)
                call BlzSetSpecialEffectScale(fx, 2.0)
                call BlzSetSpecialEffectHeight(fx, GetPointZ(x , y))
                call s__EffectUtils__EffectTimer_create((fx ) , (( s__TayuyaQOgre_SEG_LIFETIME)*1.0) , true) // INLINED!!
                set fx=null

                set i=i + 1
            endloop
        endfunction
        
        function s__TayuyaQOgre_channel takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local group l__tempGroup= CreateGroup()

            local integer wave
            local real slamX
            local real slamY
            local real dmg

            set s__TayuyaQOgre_count[this]=s__TayuyaQOgre_count[this] + 1

            if s__TayuyaQOgre_count[this] < 6 then
                call SetUnitFlyHeight(s__TayuyaQOgre_puppet[this], GetUnitFlyHeight(s__TayuyaQOgre_puppet[this]) + 20, 0)
            else
                call SetUnitFlyHeight(s__TayuyaQOgre_puppet[this], GetUnitFlyHeight(s__TayuyaQOgre_puppet[this]) - 20, 0)
            endif

            if s__TayuyaQOgre_count[this] == 7 then
                set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__TayuyaQOgre_caster[this]) ), ( 'e02R' ), (( GetUnitX(s__TayuyaQOgre_puppet[this]) )*1.0), (( GetUnitY(s__TayuyaQOgre_puppet[this]) )*1.0), (( GetRandomReal(0, 360))*1.0))) // INLINED!!
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 0)
                call KillUnit(bj_lastCreatedUnit)
            endif

            if s__TayuyaQOgre_count[this] > 13 then
                set slamX=GetUnitX(s__TayuyaQOgre_puppet[this])
                set slamY=GetUnitY(s__TayuyaQOgre_puppet[this])
                call SetUnitFlyHeight(s__TayuyaQOgre_puppet[this], 0, 0)

                set wave=s__TayuyaQOgre_allocate()
                set s__TayuyaQOgre_caster[wave]=s__TayuyaQOgre_caster[this]
                set s__TayuyaQOgre_puppet[wave]=s__TayuyaQOgre_puppet[this]
                set s__TayuyaQOgre_shockX[wave]=slamX
                set s__TayuyaQOgre_shockY[wave]=slamY
                set s__TayuyaQOgre_shockDamaged[wave]=CreateGroup()

                set s__TayuyaQOgre_shockPulse[wave]=0
                set s__TayuyaQOgre_shockPulseMax[wave]=1

                set s__TayuyaQOgre_shockPrevR[wave]=s__TayuyaQOgre_BASE_RADIUS
                set s__TayuyaQOgre_shockR[wave]=s__TayuyaQOgre_BASE_RADIUS
                set s__TayuyaQOgre_shockDamageBonus[wave]=TayuyaCore_WDamage

                set s__TayuyaQOgre_shockFx[wave]=AddSpecialEffect(s__TayuyaQOgre_ROCK_RING_MODEL, slamX, slamY)
                call BlzSetSpecialEffectScale(s__TayuyaQOgre_shockFx[wave], 2.0)
                call BlzSetSpecialEffectHeight(s__TayuyaQOgre_shockFx[wave], GetPointZ(slamX , slamY))
                call BlzSetSpecialEffectTimeScale(s__TayuyaQOgre_shockFx[wave], s__TayuyaQOgre_IMPACT_TIMESCALE)

                set dmg=( 100.0 * I2R(GetUnitAbilityLevel(s__TayuyaQOgre_caster[this], s__TayuyaQOgre_SPELL_ID)) ) + TayuyaCore_WDamage
                set s__TayuyaQOgre_shockDamageBonus[this]=TayuyaCore_WDamage

                if TayuyaCore_WDamage > 0.00 then
