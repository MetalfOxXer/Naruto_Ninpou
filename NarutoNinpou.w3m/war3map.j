                set s__KurenaiInvisibility_Alloc___instanceCount=s__KurenaiInvisibility_Alloc___instanceCount + 1
                set this=s__KurenaiInvisibility_Alloc___instanceCount
            else
                set this=s__KurenaiInvisibility_Alloc___recycle[(0)]
                set s__KurenaiInvisibility_Alloc___recycle[(0)]=s__KurenaiInvisibility_Alloc___recycle[s__KurenaiInvisibility_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
