 function s__MadaraSusanooSlash_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__MadaraSusanooSlash_slash[this])
  local real y= GetUnitY(s__MadaraSusanooSlash_slash[this])
  local real new_x= (((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__MadaraSusanooSlash_slash[this])) )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__MadaraSusanooSlash_slash[this])) )*1.0)) * (( 50)*1.0)) // INLINED!!
		call SetUnitX(s__MadaraSusanooSlash_slash[this], new_x)
		call SetUnitY(s__MadaraSusanooSlash_slash[this], new_y)
		call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MadaraSusanooSlash_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__MadaraSusanooSlash_damaged[this]) then
