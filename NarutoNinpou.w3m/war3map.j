    function s__FuuNewE_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__FuuNewE_caster[s__FuuNewE_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
            call UnitDamageTarget(s__FuuNewE_caster[s__FuuNewE_instance], GetFilterUnit(), GetHeroAgi(s__FuuNewE_caster[s__FuuNewE_instance], true) * GetUnitAbilityLevel(s__FuuNewE_caster[s__FuuNewE_instance], s__FuuNewE_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
			call GroupAddUnit(s__FuuNewE_damaged[s__FuuNewE_instance], GetFilterUnit())
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl" ), (( GetUnitX(GetFilterUnit()) )*1.0), (( GetUnitY(GetFilterUnit()))*1.0))) // INLINED!!
