//Implemented from module Alloc:
    
        function s__PakuraT_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__PakuraT_Alloc___recycle[(0)] == 0 ) then
                set s__PakuraT_Alloc___instanceCount=s__PakuraT_Alloc___instanceCount + 1
                set this=s__PakuraT_Alloc___instanceCount
            else
                set this=s__PakuraT_Alloc___recycle[(0)]
                set s__PakuraT_Alloc___recycle[(0)]=s__PakuraT_Alloc___recycle[s__PakuraT_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__PakuraT_deallocate takes integer this returns nothing
            set s__PakuraT_Alloc___recycle[this]=s__PakuraT_Alloc___recycle[(0)]
            set s__PakuraT_Alloc___recycle[(0)]=this
        endfunction



    function s__PakuraT_dealDamage takes nothing returns boolean
        local unit u= GetFilterUnit()
        if IsUnitEnemy(u, GetOwningPlayer(s__PakuraT_caster[s__PakuraT_instance])) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            call UnitDamageTarget(s__PakuraT_caster[s__PakuraT_instance], u, s__PakuraT_DAMAGE_BASE + ( ( GetHeroInt(s__PakuraT_caster[s__PakuraT_instance], true) ) * ( 8 + ( s__PakuraT_absorbed[s__PakuraT_instance] * 0.45 ) ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(u) )*1.0), (( GetUnitY(u))*1.0))) // INLINED!!
        endif
        return false
    endfunction

    function s__PakuraT_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real px
        local real py
        local real dx
        local real dy
        local real tx
        local real ty
        local real ox
        local real oy
        local real ex
        local real ey
        local real dist
        local real new_x
        local real new_y
        local real drag_angle
        local real progress
        local real normalizedScale
        local unit u
        local unit orb
        local group g
        local integer i
        local integer j
        local location loc

        set s__PakuraT_count[this]=s__PakuraT_count[this] + 1

        if s__PakuraT_phase[this] == 0 then
            set s__PakuraT_scale[this]=s__PakuraT_scale[this] + s__PakuraT_SCALE_RATE
            set s__PakuraT_trailScale[this]=s__PakuraT_trailScale[this] + 0.001

            set px=GetUnitX(s__PakuraT_projectile[this])
            set py=GetUnitY(s__PakuraT_projectile[this])

            set g=CreateGroup()
            call GroupAddGroup(PakuraAllOrbs, g)
            loop
                set orb=FirstOfGroup(g)
                exitwhen orb == null
                set ox=GetUnitX(orb)
                set oy=GetUnitY(orb)
                set dist=SquareRoot(( px - ox ) * ( px - ox ) + ( py - oy ) * ( py - oy ))
                if dist < s__PakuraT_SCALE_RADIUS + ( s__PakuraLerpCount[this] * 22 ) and s__PakuraLerpCount[this] < 10 then
                    set s__PakuraLerpOrbs[this * 10 + s__PakuraLerpCount[this]]= orb
                    set s__PakuraLerpStartX[this * 10 + s__PakuraLerpCount[this]]= ox
                    set s__PakuraLerpStartY[this * 10 + s__PakuraLerpCount[this]]= oy
                    set s__PakuraLerpElapsed[this * 10 + s__PakuraLerpCount[this]]= 0.0
                    set s__PakuraLerpDuration[this * 10 + s__PakuraLerpCount[this]]= ( ( 25 + s__PakuraT_absorbed[this] * 3 ) - ( s__PakuraT_count[this] + 1 ) ) * 0.03
                    set s__PakuraLerpCount[this]= s__PakuraLerpCount[this] + 1
					call UnitApplyTimedLife(orb, 'BTLF', 2.0)
                    call GroupRemoveUnit(PakuraAllOrbs, orb)
                    call PauseUnit(orb, true)
                    call SetUnitFlyHeight(orb, 0, 0)
                endif
                call GroupRemoveUnit(g, orb)
            endloop
            call DestroyGroup(g)

            set i=0
            loop
                exitwhen i >= s__PakuraLerpCount[this]
                set s__PakuraLerpElapsed[this * 10 + i]= s__PakuraLerpElapsed[this * 10 + i] + 0.03
                set progress=s__PakuraLerpElapsed[this * 10 + i] / s__PakuraLerpDuration[this * 10 + i]
                if progress >= 0.85 then
                    set progress=1.0
                endif
                set new_x=s__PakuraLerpStartX[this * 10 + i] + ( px - s__PakuraLerpStartX[this * 10 + i] ) * progress
                set new_y=s__PakuraLerpStartY[this * 10 + i] + ( py - s__PakuraLerpStartY[this * 10 + i] ) * progress
                call SetUnitX(s__PakuraLerpOrbs[this * 10 + i], new_x)
                call SetUnitY(s__PakuraLerpOrbs[this * 10 + i], new_y)

                if progress >= 1.0 then
                    call KillUnit(s__PakuraLerpOrbs[this * 10 + i])
                    call ShowUnit(s__PakuraLerpOrbs[this * 10 + i], false)
                    //set this.scale = this.scale + 0.36
                    set s__PakuraT_explosionRadius[this]=s__PakuraT_explosionRadius[this] + 23.0
                    set s__PakuraT_absorbed[this]=s__PakuraT_absorbed[this] + 1
                    set j=i
                    loop
                        exitwhen j >= s__PakuraLerpCount[this] - 1
                        set s__PakuraLerpOrbs[this * 10 + j]= s__PakuraLerpOrbs[this * 10 + j + 1]
                        set s__PakuraLerpStartX[this * 10 + j]= s__PakuraLerpStartX[this * 10 + j + 1]
                        set s__PakuraLerpStartY[this * 10 + j]= s__PakuraLerpStartY[this * 10 + j + 1]
                        set s__PakuraLerpElapsed[this * 10 + j]= s__PakuraLerpElapsed[this * 10 + j + 1]
                        set s__PakuraLerpDuration[this * 10 + j]= s__PakuraLerpDuration[this * 10 + j + 1]
                        set j=j + 1
                    endloop
                    set s__PakuraLerpCount[this]= s__PakuraLerpCount[this] - 1
                    set i=i - 1
                endif
                set i=i + 1
            endloop

            call SetUnitScale(s__PakuraT_projectile[this], s__PakuraT_scale[this], s__PakuraT_scale[this], s__PakuraT_scale[this])
            call SetUnitFlyHeight(s__PakuraT_projectile[this], GetUnitFlyHeight(s__PakuraT_projectile[this]) + ( s__PakuraT_scale[this] - 1.0 ) * 1.0, 0)

            set s__PakuraT_trailScale[this]=s__PakuraT_trailScale[this] + 0.003
            if s__PakuraT_trailScale[this] > 0.2 then
                set s__PakuraT_trailScale[this]=0.2
            endif
            call BlzSetSpecialEffectScale(s__PakuraT_scorchTrail[this], s__PakuraT_trailScale[this])

            if s__PakuraT_count[this] >= 25 + ( s__PakuraT_absorbed[this] * 3 ) or s__PakuraT_scale[this] >= s__PakuraT_MAX_SCALE + ( 0.36 * s__PakuraT_absorbed[this] ) then
                set s__PakuraT_phase[this]=1
                set s__PakuraT_count[this]=0
				//set bj_lastCreatedEffect = AddSpecialEffect("Doodads\\LordaeronSummer\\Props\\SmokeSmudge\\SmokeSmudge2.mdl", px, py)
				//call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 10)
				//call DestroyEffectTimed(bj_lastCreatedEffect, 1.0)     
                set tx=(((px )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( 400)*1.0)) // INLINED!!
                set ty=(((py )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( 400)*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\ScorchedEarth.mdl", tx, ty)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__PakuraT_angle[this] - bj_PI)
			    call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.6)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 3.0)*1.0) , false) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\ScorchedEarth.mdl", tx, ty)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__PakuraT_angle[this] - bj_PI)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.6)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 3.0)*1.0) , false) // INLINED!!

        if IsUnitVisible(s__PakuraT_caster[this], GetLocalPlayer()) then
           call PlaySoundOnUnitBJ(gg_snd_Pakura_T2, 75.0, s__PakuraT_caster[this])
        endif

	    call SetUnitAnimation(s__PakuraT_caster[this], "attack")
	    call PauseUnit(s__PakuraT_caster[this], false)
            endif

        elseif s__PakuraT_phase[this] == 1 then
            set px=GetUnitX(s__PakuraT_projectile[this])
            set py=GetUnitY(s__PakuraT_projectile[this])
            set dx=s__PakuraT_target_x[this] - px
            set dy=s__PakuraT_target_y[this] - py
            set s__PakuraT_angle[this]=Atan2(dy, dx)

            set tx=(((px )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( s__PakuraT_LAUNCH_SPEED)*1.0)) // INLINED!!
            set ty=(((py )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( s__PakuraT_LAUNCH_SPEED)*1.0)) // INLINED!!

            call SetUnitX(s__PakuraT_projectile[this], tx)
            call SetUnitY(s__PakuraT_projectile[this], ty)

            set ex=(((tx )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( - 80.0)*1.0)) // INLINED!!
            set ey=(((ty )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( - 80.0)*1.0)) // INLINED!!
            call BlzSetSpecialEffectX(s__PakuraT_scorchTrail[this], ex)
            call BlzSetSpecialEffectY(s__PakuraT_scorchTrail[this], ey)
            set loc=Location(ex, ey)
            call BlzSetSpecialEffectZ(s__PakuraT_scorchTrail[this], GetLocationZ(loc))
            call RemoveLocation(loc)
            set loc=null

            set g=CreateGroup()
            call GroupEnumUnitsInRange(g, tx, ty, s__PakuraT_DRAG_RADIUS + ( s__PakuraT_absorbed[this] * 12 ), null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)

                if IsUnitEnemy(u, GetOwningPlayer(s__PakuraT_caster[this])) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, s__PakuraT_damaged[this]) then
                    call EsnareUnitTimed(s__PakuraT_caster[this] , u , 1.5)
                    call GroupAddUnit(s__PakuraT_damaged[this], u)
                endif

                if IsUnitInGroup(u, s__PakuraT_damaged[this]) then
                    set px=GetUnitX(u)
                    set py=GetUnitY(u)
                    set drag_angle=Atan3(px , py , tx , ty)
                    set new_x=(((px )*1.0) + Cos((( drag_angle )*1.0)) * (( s__PakuraT_DRAG_STEP)*1.0)) // INLINED!!
                    set new_y=(((py )*1.0) + Sin((( drag_angle )*1.0)) * (( s__PakuraT_DRAG_STEP)*1.0)) // INLINED!!

                    if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    else
                        if IsUnitType(u, UNIT_TYPE_HERO) == true then
                            set s__PakuraT_phase[this]=2
                        endif
                    endif

                    if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(u, new_x)
                        call SetUnitY(u, new_y)
                    endif
                endif
            endloop
            call DestroyGroup(g)

            if ModuloInteger(s__PakuraT_count[this], 5) == 0 then
			    //set bj_lastCreatedEffect = AddSpecialEffect("LW10.mdl", tx, ty)
			    //call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.6)
			    //call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
				set bj_lastCreatedEffect=AddSpecialEffect("Doodads\\LordaeronSummer\\Props\\SmokeSmudge\\SmokeSmudge2.mdl", tx, ty)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 10)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.0)*1.0) , false) // INLINED!!
                set tx=(((px )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( 400)*1.0)) // INLINED!!
                set ty=(((py )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( 400)*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\ScorchedEarth.mdl", tx, ty)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__PakuraT_angle[this] - bj_PI)
			    call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.75)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.6)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 3.0)*1.0) , false) // INLINED!!
            endif

            set s__PakuraT_count[this]=s__PakuraT_count[this] + 1
            if GetDistance(tx , ty , s__PakuraT_target_x[this] , s__PakuraT_target_y[this]) <= 40 or ( s__PakuraT_count[this] * 0.03 > s__PakuraT_range[this] / s__PakuraT_LAUNCH_SPEED ) then
                set s__PakuraT_phase[this]=2
                set s__PakuraT_count[this]=0
            endif

        elseif s__PakuraT_phase[this] == 2 then
            set px=GetUnitX(s__PakuraT_projectile[this])
            set py=GetUnitY(s__PakuraT_projectile[this])
            set s__PakuraT_explosionRadius[this]=s__PakuraT_explosionRadius[this] + ( s__PakuraT_absorbed[this] * 23 )
            if s__PakuraT_explosionRadius[this] > 500 then
                set s__PakuraT_explosionRadius[this]=500
            endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, px, py, s__PakuraT_explosionRadius[this], Filter(function s__PakuraT_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)

            call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", px, py))
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Firaga2.mdl", px, py)
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\bwaxec.mdl", px, py)
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)

            call RemoveUnit(s__PakuraT_projectile[this])
            call DestroyEffect(s__PakuraT_scorchTrail[this])
            call GroupClear(s__PakuraT_damaged[this])
            call DestroyGroup(s__PakuraT_damaged[this])
            call s__PakuraT_deallocate(this)
            call s__PakuraT_deallocate(s__PakuraT_instance)
            set s__PakuraT_instance=0
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__PakuraT_actions takes nothing returns nothing
        local integer this= s__PakuraT_allocate()
        local real x
        local real y
        local real x2
        local real y2
        local real offset= 200
        local location loc

        set s__PakuraT_caster[this]=GetTriggerUnit()
        set x=GetSpellTargetX()
        set y=GetSpellTargetY()
        set s__PakuraT_count[this]=0
        set s__PakuraT_scale[this]=0.01
        set s__PakuraT_trailScale[this]=0.01
        set s__PakuraT_phase[this]=0
        set s__PakuraT_absorbed[this]=0
        set s__PakuraT_explosionRadius[this]=s__PakuraT_EXPLOSION_RADIUS_BASE
        set s__PakuraT_damaged[this]=CreateGroup()
        set s__PakuraT_angle[this]=Atan3(GetUnitX(s__PakuraT_caster[this]) , GetUnitY(s__PakuraT_caster[this]) , x , y)
        set s__PakuraT_range[this]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(s__PakuraT_caster[this], s__PakuraT_SPELL_ID), ABILITY_RLF_CAST_RANGE, 0)
        set s__PakuraT_target_x[this]=(((GetUnitX(s__PakuraT_caster[this]) )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( s__PakuraT_range[this])*1.0)) // INLINED!!
        set s__PakuraT_target_y[this]=(((GetUnitY(s__PakuraT_caster[this]) )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( s__PakuraT_range[this])*1.0)) // INLINED!!

        set x2=(((GetUnitX(s__PakuraT_caster[this]) )*1.0) + Cos((( s__PakuraT_angle[this] )*1.0)) * (( offset)*1.0)) // INLINED!!
        set y2=(((GetUnitY(s__PakuraT_caster[this]) )*1.0) + Sin((( s__PakuraT_angle[this] )*1.0)) * (( offset)*1.0)) // INLINED!!
        set s__PakuraT_projectile[this]=CreateUnit(GetOwningPlayer(s__PakuraT_caster[this]), 'h0A0', x2, y2, 0)
        call SetUnitScale(s__PakuraT_projectile[this], s__PakuraT_scale[this], s__PakuraT_scale[this], s__PakuraT_scale[this])

        set s__PakuraT_scorchTrail[this]=AddSpecialEffect("war3mapImported\\ScorchedGround.mdl", x2, y2)
        call BlzSetSpecialEffectScale(s__PakuraT_scorchTrail[this], 0.01)
        set loc=Location(x2, y2)
        call BlzSetSpecialEffectZ(s__PakuraT_scorchTrail[this], GetLocationZ(loc))
        call RemoveLocation(loc)
        set loc=null
        
        set s__PakuraT_instance=this

        set s__PakuraLerpCount[this]= 0

	call PauseUnit(s__PakuraT_caster[this], true)
	call SetUnitAnimationByIndex(s__PakuraT_caster[this], 5)

        if IsUnitVisible(s__PakuraT_caster[this], GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Pakura_T1, 75.0, s__PakuraT_caster[this])
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Pakura: Enough talk! My body has been reanimated.|r")
        endif

        call TimerStart(NewTimerEx(this), 0.03, true, function s__PakuraT_periodic)
    endfunction 

    function s__PakuraT_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__PakuraT_SPELL_ID ) , Filter(( function s__PakuraT_actions))) // INLINED!!
    endfunction
