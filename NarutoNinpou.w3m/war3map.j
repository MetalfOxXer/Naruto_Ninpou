	call SetUnitX(s__TentenNewBomb_projectile[this], new_x)
	call SetUnitY(s__TentenNewBomb_projectile[this], new_y)
	if GetDistance(x , y , s__TentenNewBomb_target_x[this] , s__TentenNewBomb_target_y[this]) < 50 then
	   call KillUnit(s__TentenNewBomb_projectile[this])
	   call ShowUnit(s__TentenNewBomb_projectile[this], false)
	   set s__TentenNewBomb_projectile[this]=null
       	   set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TentenNewBomb_caster[this]), 'n01W', s__TentenNewBomb_target_x[this], s__TentenNewBomb_target_y[this], 270)
       	   call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
       	   call TimerStart(NewTimerEx(this), 0.03, true, function s__TentenNewBomb_periodic)
           call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction 

