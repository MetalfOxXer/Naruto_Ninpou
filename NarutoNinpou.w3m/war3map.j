function Trig_NarutoMorph_Actions takes nothing returns nothing
    local real x= GetUnitX(GetTriggerUnit())
    local real y= GetUnitY(GetTriggerUnit())
    if GetUnitTypeId(GetTriggerUnit()) == 'H07B' then
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Naruto_Sage_T, 100.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Naruto: AARRRGHHHH!!!!|r")
        endif
    endif
    set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(GetTriggerUnit()) ), ( 'h0AA' ), (( x )*1.0), (( y )*1.0), (( 270.0)*1.0))) // INLINED!!
    call SetUnitAnimation(bj_lastCreatedUnit, "stand")
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
endfunction

