        call RegisterSpellEffectEventForId(67 , s__YaguraUltimate_SPELL_ID , function s__YaguraUltimate_actions)
	call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__YaguraUltimate_leave))) // INLINED!!
    endfunction 
    
