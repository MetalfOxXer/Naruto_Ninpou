 function s__NagatoChibakuTensei_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x
  local real y
  local real new_x
  local real new_y
  local real angle
		set s__NagatoChibakuTensei_count[this]=s__NagatoChibakuTensei_count[this] + 0.03

		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__NagatoChibakuTensei_target_x[this], s__NagatoChibakuTensei_target_y[this], 600, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NagatoChibakuTensei_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__NagatoChibakuTensei_damaged[this]) then
			set x=GetUnitX(bj_lastCreatedUnit)
			set y=GetUnitY(bj_lastCreatedUnit)
			set angle=Atan3(x , y , s__NagatoChibakuTensei_target_x[this] , s__NagatoChibakuTensei_target_y[this])
			set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 6)*1.0)) // INLINED!!
			set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 6)*1.0)) // INLINED!!
                    	if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(bj_lastCreatedUnit, new_x)
                        call SetUnitY(bj_lastCreatedUnit, new_y)
                    	endif
			call SetUnitX(bj_lastCreatedUnit, new_x)
			call SetUnitY(bj_lastCreatedUnit, new_y)
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
			call DestroyGroup(bj_lastCreatedGroup)
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__NagatoChibakuTensei_target_x[this], s__NagatoChibakuTensei_target_y[this], 400, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NagatoChibakuTensei_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__NagatoChibakuTensei_damaged[this]) then
				call PauseUnit(bj_lastCreatedUnit, true)
				call GroupAddUnit(s__NagatoChibakuTensei_damaged[this], bj_lastCreatedUnit)
			endif
		endloop
		call GroupAddGroup(s__NagatoChibakuTensei_damaged[this], bj_lastCreatedGroup)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			set x=GetUnitX(bj_lastCreatedUnit)
			set y=GetUnitY(bj_lastCreatedUnit)
			set angle=Atan3(x , y , s__NagatoChibakuTensei_target_x[this] , s__NagatoChibakuTensei_target_y[this])
			set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 10)*1.0)) // INLINED!!
			set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 10)*1.0)) // INLINED!!
			call SetUnitX(bj_lastCreatedUnit, new_x)
			call SetUnitY(bj_lastCreatedUnit, new_y)
			if not IsUnitInGroup(bj_lastCreatedUnit, s__NagatoChibakuTensei_nagato[this]) then
				call GroupAddUnit(s__NagatoChibakuTensei_nagato[this], bj_lastCreatedUnit)
			endif
			if GetUnitFlyHeight(bj_lastCreatedUnit) < 400 then
				call UnitAddAbility(bj_lastCreatedUnit, 'Arav')
				call UnitRemoveAbility(bj_lastCreatedUnit, 'Arav')
				call SetUnitFlyHeight(bj_lastCreatedUnit, GetUnitFlyHeight(bj_lastCreatedUnit) + 20, 0)
			else
				call ShowUnit(bj_lastCreatedUnit, false)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if s__NagatoChibakuTensei_count[this] > 1.7 then
			call TimerStart(NewTimerEx(this), 0.5, false, function s__NagatoChibakuTensei_pause1)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__NagatoChibakuTensei_actions takes nothing returns nothing
  local integer this= s__NagatoChibakuTensei_allocate()
		set s__NagatoChibakuTensei_caster[this]=GetTriggerUnit()
		set s__NagatoChibakuTensei_target_x[this]=GetSpellTargetX()
		set s__NagatoChibakuTensei_target_y[this]=GetSpellTargetY()
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
			call PlaySoundOnUnitBJ(gg_snd_Nagato_T_Chibaku, 100.0, GetTriggerUnit())
		endif
		set s__NagatoChibakuTensei_count[this]=0
		set s__NagatoChibakuTensei_damaged[this]=CreateGroup()
		set s__NagatoChibakuTensei_nagato[this]=CreateGroup()
		set s__NagatoChibakuTensei_dummy[this]=CreateUnit(GetTriggerPlayer(), 'n00W', GetSpellTargetX(), GetSpellTargetY(), 270)
		call SetUnitAnimation(s__NagatoChibakuTensei_dummy[this], "birth")
		call SetUnitTimeScale(s__NagatoChibakuTensei_dummy[this], 0.95)
    		call UnitApplyTimedLife(s__NagatoChibakuTensei_dummy[this], 'BTLF', 1.7)
		call TimerStart(NewTimerEx(this), 0.03, true, function s__NagatoChibakuTensei_periodic)
 endfunction 

