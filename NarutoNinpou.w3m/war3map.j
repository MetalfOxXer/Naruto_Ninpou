    function s__SuigetsuUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__SuigetsuUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__SuigetsuUltimateChoice_caster[this]), 'A13T', false)
        else
            call s__SuigetsuUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SuigetsuUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__SuigetsuUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__SuigetsuUltimateChoice_u, s__SuigetsuUltimateChoice_TATE_EBOSHI)
            call UnitMakeAbilityPermanent(s__SuigetsuUltimateChoice_u, true, s__SuigetsuUltimateChoice_TATE_EBOSHI)
        else
            call UnitAddAbility(s__SuigetsuUltimateChoice_u, s__SuigetsuUltimateChoice_WAVE_SLASH)
            call UnitMakeAbilityPermanent(s__SuigetsuUltimateChoice_u, true, s__SuigetsuUltimateChoice_WAVE_SLASH)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A13T', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A13T', false)
        set s__s__SuigetsuUltimateChoice_b[0]= null
        set s__s__SuigetsuUltimateChoice_b[1]= null
        set s__SuigetsuUltimateChoice_u=null
        call s__Dialog_destroy(s__SuigetsuUltimateChoice_d)
        call DestroyBoolExpr(s__SuigetsuUltimateChoice_pick)
        set s__SuigetsuUltimateChoice_pick=null
        set this=s__SuigetsuUltimateChoice_allocate()
        set s__SuigetsuUltimateChoice_caster[this]=s__SuigetsuUltimateChoice_u
        set s__SuigetsuUltimateChoice_pp[this]=GetOwningPlayer(s__SuigetsuUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__SuigetsuUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__SuigetsuUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__SuigetsuUltimateChoice_TATE_EBOSHI) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__SuigetsuUltimateChoice_WAVE_SLASH) == 0 then
            set s__SuigetsuUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__SuigetsuUltimateChoice_d,"Pick a skill")
            set s__s__SuigetsuUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__SuigetsuUltimateChoice_d)], ("Suiton: Tate Eboshi" ), ( 0))) // INLINED!!
            set s__s__SuigetsuUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__SuigetsuUltimateChoice_d)], ("Suiton: Great Wave Slash" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__SuigetsuUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__SuigetsuUltimateChoice_d,s__SuigetsuUltimateChoice_pick)
            set s__SuigetsuUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__SuigetsuUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A13T' then
            set s__SuigetsuUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__SuigetsuUltimateChoice_onInit takes nothing returns nothing
        set s__SuigetsuUltimateChoice_pick=Condition(function s__SuigetsuUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__SuigetsuUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A13T' ) , Filter(( function s__SuigetsuUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Suigetsu", "A13T", "A0HY", "TATE_EBOSHI", "Suiton: Tate Eboshi", "A13S", "WAVE_SLASH", "Suiton: Great Wave Slash")

//===========================================================================
// Trigger: SuigetsuAssassinPassive
//===========================================================================


function Trig_SuigetsuAssassinPassive_Actions takes nothing returns nothing
	if GetTriggerUnit() == udg_units33[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] and GetUnitAbilityLevel(GetKillingUnit(), 'A0XE') > 0 then
    		call ModifyHeroStat(bj_HEROSTAT_AGI, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 1)
		call ModifyHeroStat(bj_HEROSTAT_STR, GetKillingUnitBJ(), bj_MODIFYMETHOD_ADD, 1)
	endif
endfunction

//===========================================================================
function InitTrig_SuigetsuAssassinPassive takes nothing returns nothing
    call RegisterPlayerUnitEventForId(46 , EVENT_PLAYER_UNIT_DEATH , function Trig_SuigetsuAssassinPassive_Actions)
endfunction


//===========================================================================
// Trigger: TayuyaPassive
//
// 
//             call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0PI', GetUnitAbilityLevel(GetTriggerUnit(), SPELL_ID)) 
//===========================================================================
// scope TayuyaCore begins



//Implemented from module Alloc:
    
        function s__TayuyaD_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__TayuyaD_Alloc___recycle[(0)] == 0 ) then
                set s__TayuyaD_Alloc___instanceCount=s__TayuyaD_Alloc___instanceCount + 1
                set this=s__TayuyaD_Alloc___instanceCount
            else
                set this=s__TayuyaD_Alloc___recycle[(0)]
                set s__TayuyaD_Alloc___recycle[(0)]=s__TayuyaD_Alloc___recycle[s__TayuyaD_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__TayuyaD_deallocate takes integer this returns nothing
            set s__TayuyaD_Alloc___recycle[this]=s__TayuyaD_Alloc___recycle[(0)]
            set s__TayuyaD_Alloc___recycle[(0)]=this
        endfunction


        


        
        function s__TayuyaD_conditionsPassive takes nothing returns boolean
            if GetSpellAbilityId() == 'A0LW' then
                return true
            elseif GetSpellAbilityId() == 'A0M0' then
                return true
            elseif GetSpellAbilityId() == 'A0M1' then
                return true
            endif
            return false
        endfunction
        
        function s__TayuyaD_actionsPassive takes nothing returns nothing
            local integer i= 0
            local integer index= 0
            local integer abilityCast= GetSpellAbilityId()
            local unit caster= GetTriggerUnit()

            set s__TayuyaD_tempPoint=GetUnitLoc(TayuyaCore_Puppet)
            call RemoveUnit(TayuyaCore_Puppet)
            if abilityCast == 'A0LW' then
                set TayuyaCore_Puppet=CreateUnit(GetOwningPlayer(caster), 'h034', GetLocationX(s__TayuyaD_tempPoint), GetLocationY(s__TayuyaD_tempPoint), GetUnitFacing(caster))
                call SetUnitAnimationByIndex(TayuyaCore_Puppet, 5)
                call SetUnitAbilityLevel(TayuyaCore_Puppet, 'A05D', GetUnitAbilityLevel(TayuyaCore_Tayuya, 'A0MW'))
                set TayuyaCore_SelectionIndex=0
                set index=2
            elseif abilityCast == 'A0M0' then
                set TayuyaCore_Puppet=CreateUnit(GetOwningPlayer(TayuyaCore_Tayuya), 'h035', GetLocationX(s__TayuyaD_tempPoint), GetLocationY(s__TayuyaD_tempPoint), GetUnitFacing(GetTriggerUnit()))
                call SetUnitAnimationByIndex(TayuyaCore_Puppet, 6)
                set TayuyaCore_SelectionIndex=1
                set index=2
            else
                set TayuyaCore_Puppet=CreateUnit(GetOwningPlayer(TayuyaCore_Tayuya), 'h03H', GetLocationX(s__TayuyaD_tempPoint), GetLocationY(s__TayuyaD_tempPoint), GetUnitFacing(GetTriggerUnit()))
                call SetUnitAnimationByIndex(TayuyaCore_Puppet, 9)
                call SetUnitAbilityLevel(TayuyaCore_Puppet, 'A0WE', GetUnitAbilityLevel(TayuyaCore_Tayuya, 'A0MW'))
                set TayuyaCore_SelectionIndex=2
                set index=2
            endif
            call RemoveLocation(s__TayuyaD_tempPoint)
            set s__TayuyaD_tempPoint=null
            call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(TayuyaCore_Puppet) )*1.0), (( GetUnitY(TayuyaCore_Puppet))*1.0))) // INLINED!!
                
            loop
                exitwhen i > 10
                
                //W
                call BlzSetAbilityIntegerLevelField(BlzGetUnitAbility(TayuyaCore_Tayuya, 'A0MX'), ABILITY_ILF_TARGET_TYPE, i, index)
                set i=i + 1
            endloop
        endfunction

        function s__TayuyaD_conditionsTayuyaAutoAttacks takes nothing returns boolean
            if ( not ( ( GetUnitTypeId(GetAttacker()) == 'H02T' ) or ( GetUnitTypeId(GetAttacker()) == 'E023' ) ) ) then
                return false
            endif
            return true
        endfunction
        
        function s__TayuyaD_actionsTayuyaAutoAttacks takes nothing returns nothing
            if ( ( TayuyaCore_PuppetTarget == null ) or ( IsUnitDeadBJ(TayuyaCore_PuppetTarget) == true ) ) then
                call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
                set TayuyaCore_IsAttacking=true
                set TayuyaCore_PuppetTarget=GetAttackedUnitBJ()
                call IssueTargetOrderBJ(TayuyaCore_Puppet, "attack", TayuyaCore_PuppetTarget)
            endif
        endfunction

        function s__TayuyaD_conditionsTayuyaAttacks takes nothing returns boolean
            if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("attack") ) ) then
                return false
            endif
            if ( not ( GetTriggerUnit() == TayuyaCore_Tayuya ) ) then
                return false
            endif
            return true
        endfunction

        function s__TayuyaD_actionsTayuyaAttackMove takes nothing returns nothing
            set TayuyaCore_PuppetTarget=null
            set TayuyaCore_IsAttacking=true
            set s__TayuyaD_tempPoint=GetOrderPointLoc()
            call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
            call IssuePointOrderLocBJ(TayuyaCore_Puppet, "move", s__TayuyaD_tempPoint)
            call RemoveLocation(s__TayuyaD_tempPoint)
            set s__TayuyaD_tempPoint=null
        endfunction
        
        function s__TayuyaD_actionsTayuyaAttacks takes nothing returns nothing
            set TayuyaCore_PuppetTarget=GetOrderTargetUnit()
            call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
            call IssueTargetOrderBJ(TayuyaCore_Puppet, "attack", TayuyaCore_PuppetTarget)
        endfunction
        
        function s__TayuyaD_conditionsPuppetAttacking takes nothing returns boolean
            if ( not ( GetAttacker() == TayuyaCore_Puppet ) ) then
                return false
            endif
            return true
        endfunction
        
        function s__TayuyaD_actionsPuppetAttacking takes nothing returns nothing
            set TayuyaCore_IsAttacking=true
            set TayuyaCore_PuppetTarget=GetAttackedUnitBJ()
            call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
            call IssueTargetOrderBJ(TayuyaCore_Puppet, "attack", TayuyaCore_PuppetTarget)
        endfunction

        function s__TayuyaD_conditionsAttackTargetSmart takes nothing returns boolean
            if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
                return false
            endif
            if ( not ( GetTriggerUnit() == TayuyaCore_Tayuya ) ) then
                return false
            endif
            if ( not ( TayuyaCore_PuppetTarget == null ) ) then
                return false
            endif
            if ( not ( IsPlayerEnemy(GetTriggerPlayer(), GetOwningPlayer(GetOrderTargetUnit())) == true ) ) then
                return false
            endif
            return true
        endfunction
        
        function s__TayuyaD_actionsAttackTargetSmart takes nothing returns nothing
            set TayuyaCore_PuppetTarget=GetOrderTargetUnit()
            call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
            call IssueTargetOrderBJ(TayuyaCore_Puppet, "attack", TayuyaCore_PuppetTarget)
        endfunction

        function s__TayuyaD_conditionsSM takes nothing returns boolean
            if ( not ( TayuyaCore_IsCasting == false ) ) then
                return false
            endif
            return true
        endfunction

        function s__TayuyaD_actionsSM takes nothing returns nothing
            local real range= 1250.00
            if s__TayuyaD_tempPoint != null then
                call RemoveLocation(s__TayuyaD_tempPoint)
            endif
            set s__TayuyaD_tempPoint=GetUnitLoc(TayuyaCore_Puppet)
            
            if s__TayuyaD_tempPointStart != null then
                call RemoveLocation(s__TayuyaD_tempPointStart)
            endif
            set s__TayuyaD_tempPointStart=GetUnitLoc(TayuyaCore_Tayuya)
            
            if s__TayuyaD_tempPointEnd != null then
                call RemoveLocation(s__TayuyaD_tempPointEnd)
            endif
            set s__TayuyaD_tempPointEnd=OffsetLocation(s__TayuyaD_tempPointStart, ( CosBJ(( GetUnitFacing(TayuyaCore_Tayuya) - bj_PI )) * s__TayuyaD_offsetDistance ), ( SinBJ(( GetUnitFacing(TayuyaCore_Tayuya) - bj_PI )) * s__TayuyaD_offsetDistance ))
        
            // Remove Doki
            if ( ( IsUnitAliveBJ(TayuyaCore_Tayuya) == false ) or GetWidgetLife(TayuyaCore_Tayuya) < 0.405 ) and ( ( TayuyaCore_IsCasting == false ) and ( TayuyaCore_IsChanneling == false ) ) then
                //call AddSpecialEffectEx("s_Shadow_Smoke.mdx", GetUnitX(Puppet), GetUnitY(Puppet))
                call SetUnitX(TayuyaCore_Puppet, 7100.0)
                call SetUnitY(TayuyaCore_Puppet, - 9100.0)
                call IssueImmediateOrder(TayuyaCore_Puppet, "stop")
            endif

            // Swap Owner if not same as Tayuya
            if ( GetOwningPlayer(TayuyaCore_Tayuya) != GetOwningPlayer(TayuyaCore_Puppet) ) then
                call SetUnitOwner(TayuyaCore_Puppet, GetOwningPlayer(TayuyaCore_Tayuya), true)
            endif
        
            if GetUnitTypeId(TayuyaCore_Puppet) == 'h034' then
                call BlzSetUnitBaseDamage(TayuyaCore_Puppet, 10 + GetHeroStr(TayuyaCore_Tayuya, true), 0)
                set range=1050
            elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h035' then
                call BlzSetUnitBaseDamage(TayuyaCore_Puppet, 10 + GetHeroAgi(TayuyaCore_Tayuya, true), 0)
                set range=1150
            elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h03H' then
                call BlzSetUnitBaseDamage(TayuyaCore_Puppet, 10 + GetHeroInt(TayuyaCore_Tayuya, true), 0)
                set range=1250
            endif
        
            // Out of Leash Range and not casting spells
            if GetWidgetLife(TayuyaCore_Tayuya) > 0.405 then
                if ( ( DistanceBetweenPoints(s__TayuyaD_tempPoint, s__TayuyaD_tempPointStart) ) > range + ( 50 * R2I(GetHeroLevel(TayuyaCore_Tayuya) / 10) ) and ( TayuyaCore_IsChanneling == false ) and ( TayuyaCore_IsCasting == false ) ) then
                    set TayuyaCore_IsAttacking=false
                    set TayuyaCore_PuppetTarget=null
                    call SetUnitPositionLoc(TayuyaCore_Puppet, s__TayuyaD_tempPointStart)
                // Follow Return Range, 50  for constant follow, and 600 for puppet auto attack nearest.
                elseif ( GetUnitCurrentOrder(TayuyaCore_Tayuya) != String2OrderIdBJ("attack") and GetUnitCurrentOrder(TayuyaCore_Puppet) != String2OrderIdBJ("attack") and GetUnitCurrentOrder(TayuyaCore_Puppet) != String2OrderIdBJ("smart") and TayuyaCore_IsAttacking == false and ( DistanceBetweenPoints(s__TayuyaD_tempPoint, s__TayuyaD_tempPointEnd) ) > 100.00 ) then
                    if ( DistanceBetweenPoints(s__TayuyaD_tempPoint, s__TayuyaD_tempPointEnd) < 200.00 ) then
                        call SetUnitMoveSpeed(TayuyaCore_Puppet, GetUnitMoveSpeed(TayuyaCore_Tayuya))
                    else
                        call SetUnitMoveSpeed(TayuyaCore_Puppet, 522.00)
                    endif
                    call IssuePointOrderLocBJ(TayuyaCore_Puppet, "move", s__TayuyaD_tempPointEnd)
                // Attack Select Target
                elseif ( GetUnitCurrentOrder(TayuyaCore_Puppet) != String2OrderIdBJ("attack") and TayuyaCore_PuppetTarget != null and GetWidgetLife(TayuyaCore_PuppetTarget) > 0.405 ) then
                    call IssueTargetOrderBJ(TayuyaCore_Puppet, "attack", TayuyaCore_PuppetTarget)
                endif
            endif
        
            call RemoveLocation(s__TayuyaD_tempPoint)
            call RemoveLocation(s__TayuyaD_tempPointEnd)
            call RemoveLocation(s__TayuyaD_tempPointStart)
            set s__TayuyaD_tempPoint=null
            set s__TayuyaD_tempPointEnd=null
            set s__TayuyaD_tempPointStart=null
        endfunction

        function s__TayuyaD_conditionsRevive takes nothing returns boolean
            if ( not ( GetTriggerUnit() == TayuyaCore_Tayuya ) ) then
                return false
            endif
            return true
        endfunction

        function s__TayuyaD_actionsRevive takes nothing returns nothing
            set TayuyaCore_IsAttacking=false
            set TayuyaCore_PuppetTarget=null
            set TayuyaCore_IsCasting=false
            set TayuyaCore_IsChanneling=false
            set TayuyaCore_OgreQ=false
            set TayuyaCore_W2=false
            if s__TayuyaD_tempPoint != null then
                call RemoveLocation(s__TayuyaD_tempPoint)
            endif
            set s__TayuyaD_tempPoint=null
            call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(TayuyaCore_Puppet) )*1.0), (( GetUnitY(TayuyaCore_Puppet))*1.0))) // INLINED!!
        endfunction

        function s__TayuyaD_conditionsSpawn takes nothing returns boolean
            if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H02T' ) ) then
                return false
            endif
            if ( not ( TayuyaCore_Puppet == null ) ) then
                return false
            endif
            return true
        endfunction

        function s__TayuyaD_actionsSpawn takes nothing returns nothing
            set TayuyaCore_Tayuya=GetTriggerUnit()
            set TayuyaCore_Puppet=CreateUnit(GetOwningPlayer(TayuyaCore_Tayuya), 'h03H', GetUnitX(TayuyaCore_Tayuya), GetUnitY(TayuyaCore_Tayuya), GetUnitFacing(TayuyaCore_Tayuya))
            set s__TayuyaD_puppetTimer=CreateTimer()
            call TimerStart(s__TayuyaD_puppetTimer, 0.3, true, function s__TayuyaD_actionsSM)
        endfunction

        function s__TayuyaD_initTriggersMethod takes nothing returns nothing
            local trigger t1
            local trigger t2
            local trigger t3
            local trigger t4
            local trigger t5

            // Smart Command
            set t1=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t1, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
            call TriggerAddCondition(t1, Condition(function s__TayuyaD_conditionsAttackTargetSmart))
            call TriggerAddAction(t1, function s__TayuyaD_actionsAttackTargetSmart)

            // Puppet Attacks
            set t2=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_ATTACKED)
            call TriggerAddCondition(t2, Condition(function s__TayuyaD_conditionsPuppetAttacking))
            call TriggerAddAction(t2, function s__TayuyaD_actionsPuppetAttacking)

            // Tayuya Attack Target
            set t3=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t3, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
            call TriggerAddCondition(t3, Condition(function s__TayuyaD_conditionsTayuyaAttacks))
            call TriggerAddAction(t3, function s__TayuyaD_actionsTayuyaAttacks)

            // Tayuya Attack Move
            set t4=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t4, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
            call TriggerAddCondition(t4, Condition(function s__TayuyaD_conditionsTayuyaAttacks))
            call TriggerAddAction(t4, function s__TayuyaD_actionsTayuyaAttackMove)

            // Tayuya Attacks
            set t5=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t5, EVENT_PLAYER_UNIT_ATTACKED)
            call TriggerAddCondition(t5, Condition(function s__TayuyaD_conditionsTayuyaAutoAttacks))
            call TriggerAddAction(t5, function s__TayuyaD_actionsTayuyaAutoAttacks)

            //local integer i = 0

            // Command Triggers
            //loop
            //    exitwhen(i > 24)
            //        call TriggerRegisterPlayerMouseEventBJ(t10 , Player(i), bj_MOUSEEVENTTYPE_DOWN) 
            //        call TriggerRegisterPlayerMouseEventBJ(t11 , Player(i), bj_MOUSEEVENTTYPE_UP)  
            //        call BlzTriggerRegisterPlayerKeyEvent(t12 , Player(i), OSKEY_LCONTROL, 2, true)  
            //        call BlzTriggerRegisterPlayerKeyEvent(t13 , Player(i), OSKEY_LCONTROL, 0, false)
            //        set i = i + 1 
            //endloop
            //call TriggerAddCondition(t10 , Condition(function isRMBPress))  
            //call TriggerAddCondition(t11 , Condition(function isRMBRelease))
            //call TriggerAddAction(t10 , function actions)
            //call TriggerAddAction(t11 , function actions)
            //call TriggerAddAction(t12 , function pressCTRL)   
            //call TriggerAddAction(t13 , function releaseCTRL)
        endfunction

        function s__TayuyaD_onInit takes nothing returns nothing
            local timer initTimer
            local trigger t1
            local trigger t2
            local trigger t3

            set initTimer=CreateTimer()
            call TimerStart(initTimer, 5.00, false, function s__TayuyaD_initTriggersMethod)

            // Passive
            call RegisterSpellEffectEventForId(71 , 'A0LW' , function s__TayuyaD_actionsPassive)
            call RegisterSpellEffectEventForId(71 , 'A0M0' , function s__TayuyaD_actionsPassive)
            call RegisterSpellEffectEventForId(71 , 'A0M1' , function s__TayuyaD_actionsPassive)

            // Spawn Tayuya
            set t1=CreateTrigger()
            call TriggerRegisterEnterRectSimple(t1, GetPlayableMapRect())
            call TriggerAddCondition(t1, Condition(function s__TayuyaD_conditionsSpawn))
            call TriggerAddAction(t1, function s__TayuyaD_actionsSpawn)

            // Revive and Reset Tayuya Variables
            set t2=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_HERO_REVIVE_FINISH)
            call TriggerAddCondition(t2, Condition(function s__TayuyaD_conditionsRevive))
            call TriggerAddAction(t2, function s__TayuyaD_actionsRevive)
        endfunction
// scope TayuyaCore ends
//===========================================================================
// Trigger: TayuyaCommandMovePuppet
//===========================================================================

function updateTayuya takes nothing returns nothing
    local location tempLoc
    set tempLoc=Location(tayuyaMouseX, tayuyaMouseY)
    if GetUnitCurrentOrder(TayuyaCore_Tayuya) == 0 and metaCtrlDownTayuya then
        call IssueImmediateOrder(TayuyaCore_Tayuya, "stop")
    elseif GetUnitCurrentOrder(TayuyaCore_Tayuya) == 851971 and metaCtrlDownTayuya then
        call IssuePointOrderLoc(TayuyaCore_Tayuya, "move", tempLoc)
    endif
    call RemoveLocation(tempLoc)
    set tempLoc=null
    call DestroyTimer(GetExpiredTimer())
endfunction

function isRMBPress takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(TayuyaCore_Tayuya) then
        set tayuyaMoveTimer=CreateTimer()
        if not metaCtrlDownTayuya then
            set tayuyaMouseX=BlzGetTriggerPlayerMouseX()
            set tayuyaMouseY=BlzGetTriggerPlayerMouseY()
        endif
        call TimerStart(tayuyaMoveTimer, 0.01, true, function updateTayuya)
        if metaCtrlDownTayuya then
            return true
        endif
    endif
    return false
endfunction

function isRMBRelease takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(TayuyaCore_Tayuya) then
        set tayuyaMoveTimer=CreateTimer()
        call TimerStart(tayuyaMoveTimer, 0.01, true, function updateTayuya)
        if metaCtrlDownTayuya then
            return true
        endif
    endif
    return false
endfunction

function actions takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(TayuyaCore_Tayuya) then
        set TayuyaCore_IsAttacking=true
        set TayuyaCore_PuppetTarget=null
            call SetUnitMoveSpeed(TayuyaCore_Puppet, 522)
        call IssuePointOrderLocBJ(TayuyaCore_Puppet, "move", BlzGetTriggerPlayerMousePosition())
    endif
endfunction

function pressCTRL takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(TayuyaCore_Tayuya) then
        set metaCtrlDownTayuya=true
    endif
endfunction  

function releaseCTRL takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(TayuyaCore_Tayuya) then
        set metaCtrlDownTayuya=false
    endif
endfunction

//===========================================================================
function InitTrig_TayuyaCommandMovePuppet takes nothing returns nothing
    local integer i= 0
    
    loop
    exitwhen ( i > 24 )
        call TriggerRegisterPlayerMouseEventBJ(rmbClickTriggerTayuya, Player(i), bj_MOUSEEVENTTYPE_DOWN)
        call TriggerRegisterPlayerMouseEventBJ(rmbReleaseTriggerTayuya, Player(i), bj_MOUSEEVENTTYPE_UP)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlDownTayuyaTriggerTayuya, Player(i), OSKEY_LCONTROL, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlUpTriggerTayuya, Player(i), OSKEY_LCONTROL, 0, false)
        set i=i + 1
    endloop
    
    call TriggerAddCondition(rmbClickTriggerTayuya, Condition(function isRMBPress))
    call TriggerAddCondition(rmbReleaseTriggerTayuya, Condition(function isRMBRelease))
    call TriggerAddAction(rmbClickTriggerTayuya, function actions)
    call TriggerAddAction(rmbReleaseTriggerTayuya, function actions)
    call TriggerAddAction(metaCtrlDownTayuyaTriggerTayuya, function pressCTRL)
    call TriggerAddAction(metaCtrlUpTriggerTayuya, function releaseCTRL)
endfunction
