        	set s__s__KankuroSalamander_fire[(this)*(1)+s__KankuroSalamander_count[this]]= AddSpecialEffect("PerfectAnimeKaton.mdx", x, y)
        	call BlzSetSpecialEffectRoll(s__s__KankuroSalamander_fire[(this)*(1)+s__KankuroSalamander_count[this]], s__KankuroSalamander_angle[this])
