			set s__HinataLionPalm_charges=false
		endif
		call ReleaseTimer(GetExpiredTimer())
 endfunction

 function s__HinataLionPalm_pull takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__HinataLionPalm_target[this])
  local real y= GetUnitY(s__HinataLionPalm_target[this])
  local real angle= Atan3(x , y , GetUnitX(s__HinataLionPalm_caster[this]) , GetUnitY(s__HinataLionPalm_caster[this]))
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 40)*1.0)) // INLINED!!
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__HinataLionPalm_target[this], new_x)
			call SetUnitY(s__HinataLionPalm_target[this], new_y)
		endif
		set bj_lastCreatedEffect=AddSpecialEffect("DustWaveGeneric.mdl", new_x, new_y)
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.3)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HinataLionPalm_angle[this])
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(new_x , new_y))
		call DestroyEffect(bj_lastCreatedEffect)
		set s__HinataLionPalm_count[this]=s__HinataLionPalm_count[this] + 1
		if s__HinataLionPalm_count[this] > 10 then
			call s__HinataLionPalm_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction


 function s__HinataLionPalm_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__HinataLionPalm_dummy[this])
  local real y= GetUnitY(s__HinataLionPalm_dummy[this])
  local real new_x= (((x )*1.0) + Cos((( s__HinataLionPalm_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__HinataLionPalm_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
		call SetUnitX(s__HinataLionPalm_dummy[this], new_x)
		call SetUnitY(s__HinataLionPalm_dummy[this], new_y)
		set s__HinataLionPalm_count[this]=s__HinataLionPalm_count[this] + 1

		set bj_lastCreatedEffect=AddSpecialEffect("DustWaveGeneric.mdl", new_x, new_y)
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.3)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HinataLionPalm_angle[this])
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(new_x , new_y))
		call DestroyEffect(bj_lastCreatedEffect)

		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 250.0, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HinataLionPalm_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
				call UnitDamageTarget(s__HinataLionPalm_caster[this], bj_lastCreatedUnit, 35 * GetUnitAbilityLevel(s__HinataLionPalm_caster[this], 'A0VQ'), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
				set s__HinataLionPalm_target[this]=bj_lastCreatedUnit
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
			
		if s__HinataLionPalm_count[this] > 19 or s__HinataLionPalm_target[this] != null then
			call ShowUnit(s__HinataLionPalm_dummy[this], false)
			call KillUnit(s__HinataLionPalm_dummy[this])
			set s__HinataLionPalm_dummy[this]=null
			if not s__HinataLionPalm_charges then
				call BlzEndUnitAbilityCooldown(s__HinataLionPalm_caster[this], s__HinataLionPalm_SPELL_ID)
				set s__HinataLionPalm_charges=true
				call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 20.0, false, function s__HinataLionPalm_removeCharges) // INLINED!!
			else
				set s__HinataLionPalm_charges=false
			endif
			if s__HinataLionPalm_target[this] != null then
				set s__HinataLionPalm_count[this]=0
                		call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__HinataLionPalm_pull , "HinataLionPalm_pull")
				call ReleaseTimer(GetExpiredTimer())
			else
				call s__HinataLionPalm_deallocate(this)
				call ReleaseTimer(GetExpiredTimer())
			endif
		endif
 endfunction 

 function s__HinataLionPalm_actions takes nothing returns nothing
  local integer this= s__HinataLionPalm_allocate()
  local real x
  local real y
		set s__HinataLionPalm_caster[this]=GetTriggerUnit()
		set s__HinataLionPalm_target_x[this]=GetSpellTargetX()
		set s__HinataLionPalm_target_y[this]=GetSpellTargetY()
		set s__HinataLionPalm_angle[this]=Atan3(GetUnitX(s__HinataLionPalm_caster[this]) , GetUnitY(s__HinataLionPalm_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
		if GetUnitTypeId(s__HinataLionPalm_caster[this]) == 'H09G' then
			set s__HinataLionPalm_dummy[this]=CreateUnit(GetTriggerPlayer(), 'o00F', GetUnitX(s__HinataLionPalm_caster[this]), GetUnitY(s__HinataLionPalm_caster[this]), Rad2Deg(Atan3(GetUnitX(s__HinataLionPalm_caster[this]) , GetUnitY(s__HinataLionPalm_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
		else
			set x=(((GetUnitX(s__HinataLionPalm_caster[this]) )*1.0) + Cos((( s__HinataLionPalm_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
			set y=(((GetUnitY(s__HinataLionPalm_caster[this]) )*1.0) + Sin((( s__HinataLionPalm_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
			set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h00W', x, y, Rad2Deg(s__HinataLionPalm_angle[this]))
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
			set s__HinataLionPalm_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__HinataLionPalm_caster[this]), GetUnitY(s__HinataLionPalm_caster[this]), Rad2Deg(Atan3(GetUnitX(s__HinataLionPalm_caster[this]) , GetUnitY(s__HinataLionPalm_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
		endif
		set s__HinataLionPalm_target[this]=null
		set s__HinataLionPalm_count[this]=0
		call TimerStart(NewTimerEx(this), 0.03, true, function s__HinataLionPalm_periodic)
 endfunction 

 function s__HinataLionPalm_onInit takes nothing returns nothing
		set s__HinataLionPalm_charges=false
		call RegisterSpellEffectEventForId(8 , s__HinataLionPalm_SPELL_ID , function s__HinataLionPalm_actions)
 endfunction 


