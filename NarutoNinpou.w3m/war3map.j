 function s__HayateNewW_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__HayateNewW_caster[this])
  local real y= GetUnitY(s__HayateNewW_caster[this])
  local real new_x= (((x )*1.0) + Cos((( s__HayateNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__HayateNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__HayateNewW_caster[this], new_x)
			call SetUnitY(s__HayateNewW_caster[this], new_y)
		endif
		set bj_lastCreatedEffect=AddSpecialEffect("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdl", new_x, new_y)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HayateNewW_angle[this])
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
		call BlzSetSpecialEffectAlpha(bj_lastCreatedEffect, 200)
		call DestroyEffect(bj_lastCreatedEffect)
		if s__HayateNewW_count[this] == 0 or s__HayateNewW_count[this] == 8 or s__HayateNewW_count[this] == 16 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HayateNewW_caster[this]), 'e044', x, y, Rad2Deg(s__HayateNewW_angle[this]))
			call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 100)
			call SetUnitTimeScale(bj_lastCreatedUnit, 0.5)
			call SetUnitAnimation(bj_lastCreatedUnit, "spell channel four")
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
			set bj_lastCreatedEffect=AddSpecialEffect("animeslashfinal.mdl", GetUnitX(s__HayateNewW_caster[this]), GetUnitY(s__HayateNewW_caster[this]))
        		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HayateNewW_angle[this])
        		call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 0, 0, 255)
        		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__HayateNewW_caster[this]) , GetUnitY(s__HayateNewW_caster[this])))
        		call DestroyEffect(bj_lastCreatedEffect)
			call SetUnitAnimation(s__HayateNewW_caster[this], "Attack")
		endif
		set bj_lastCreatedGroup=CreateGroup()
        	call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
        	loop
            		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            		exitwhen bj_lastCreatedUnit == null
            		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HayateNewW_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
				//call IssueTargetOrder(bj_lastCreatedUnit,"attack",this.caster)
				set x=GetUnitX(bj_lastCreatedUnit)
                		set y=GetUnitY(bj_lastCreatedUnit)
                		set new_x=(((x )*1.0) + Cos((( s__HayateNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                		set new_y=(((y )*1.0) + Sin((( s__HayateNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetUnitTypeId(bj_lastCreatedUnit) != 'e03B' then
                    			call SetUnitX(bj_lastCreatedUnit, new_x)
                    			call SetUnitY(bj_lastCreatedUnit, new_y)
				endif
				if not IsUnitInGroup(bj_lastCreatedUnit, s__HayateNewW_damaged[this]) then
					call UnitDamageTarget(s__HayateNewW_caster[this], bj_lastCreatedUnit, 90 * GetUnitAbilityLevel(s__HayateNewW_caster[this], s__HayateNewW_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                			call GroupAddUnit(s__HayateNewW_damaged[this], bj_lastCreatedUnit)
				endif
	        	endif
        	call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        	endloop
        	call DestroyGroup(bj_lastCreatedGroup)
		set s__HayateNewW_count[this]=s__HayateNewW_count[this] + 1
		if s__HayateNewW_count[this] >= 24 or s__HayateNewW_slashactive then
			call DestroyGroup(s__HayateNewW_damaged[this])
        		set s__HayateNewW_damaged[this]=null
			set s__HayateNewW_count[this]=0
			call TimerStart(NewTimerEx(this), 0.03, true, function s__HayateNewW_removespell)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

