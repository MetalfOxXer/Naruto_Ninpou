        local real x= GetUnitX(s__ToneriT_dummy[this])
        local real y= GetUnitY(s__ToneriT_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__ToneriT_dummy[this])) )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__ToneriT_dummy[this])) )*1.0)) * (( 30)*1.0)) // INLINED!!
        call SetUnitX(s__ToneriT_dummy[this], new_x)
