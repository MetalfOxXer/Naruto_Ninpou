 function s__MechaNarutoMissile_moveMissile takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__MechaNarutoMissile_missile[this])
  local real y= GetUnitY(s__MechaNarutoMissile_missile[this])
  local real angle= Atan3(x , y , s__MechaNarutoMissile_target_x[this] , s__MechaNarutoMissile_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real height
		if s__MechaNarutoMissile_count[this] >= s__MechaNarutoMissile_max_count_2[this] then
			set height=s__MechaNarutoMissile_original_height[this] - ( s__MechaNarutoMissile_count[this] - s__MechaNarutoMissile_max_count_2[this] ) * 25
		else
			set height=s__MechaNarutoMissile_original_height[this] + ParabolaZ(300 , s__MechaNarutoMissile_max_count_2[this] , s__MechaNarutoMissile_max_count_2[this] - s__MechaNarutoMissile_count[this])
		endif
		call SetUnitX(s__MechaNarutoMissile_missile[this], new_x)
		call SetUnitY(s__MechaNarutoMissile_missile[this], new_y)
		call SetUnitFlyHeight(s__MechaNarutoMissile_missile[this], height, 0)
		set s__MechaNarutoMissile_count[this]=s__MechaNarutoMissile_count[this] + 1
		if s__MechaNarutoMissile_count[this] >= s__MechaNarutoMissile_max_count[this] then
			call DestroyEffect(AddSpecialEffect(("war3mapImported\\NewGroundEX.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MechaNarutoMissile_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__MechaNarutoMissile_damaged) then
					call UnitDamageTarget(s__MechaNarutoMissile_caster[this], bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(s__MechaNarutoMissile_caster[this], s__MechaNarutoMissile_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					call EsnareUnitTimed(s__MechaNarutoMissile_caster[this] , bj_lastCreatedUnit , 1.5)
					call GroupAddUnit(s__MechaNarutoMissile_damaged, bj_lastCreatedUnit)
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			call KillUnit(s__MechaNarutoMissile_missile[this])
			set s__MechaNarutoMissile_missile[this]=null
			call s__MechaNarutoMissile_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__MechaNarutoMissile_actions takes nothing returns nothing
  local integer this
  local real offset
  local real angle
  local real x
  local real y
  local integer i= 0
		call GroupClear(s__MechaNarutoMissile_damaged)
		loop
			exitwhen i > 10
			set offset=GetRandomReal(0, 300)
			set angle=Deg2Rad(GetRandomReal(0, 360))
			set x=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
			set y=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
			set this=s__MechaNarutoMissile_allocate()
			set s__MechaNarutoMissile_caster[this]=GetTriggerUnit()
			set s__MechaNarutoMissile_missile[this]=CreateUnit(GetTriggerPlayer(), 'e069', GetUnitX(s__MechaNarutoMissile_caster[this]), GetUnitY(s__MechaNarutoMissile_caster[this]), Rad2Deg(Atan3(GetUnitX(s__MechaNarutoMissile_caster[this]) , GetUnitY(s__MechaNarutoMissile_caster[this]) , x , y)))
			set s__MechaNarutoMissile_target_x[this]=x
			set s__MechaNarutoMissile_target_y[this]=y
			set s__MechaNarutoMissile_count[this]=0
			set s__MechaNarutoMissile_original_height[this]=GetUnitFlyHeight(s__MechaNarutoMissile_caster[this]) + 80
			set s__MechaNarutoMissile_max_count_2[this]=R2I(GetDistance(GetUnitX(s__MechaNarutoMissile_missile[this]) , GetUnitY(s__MechaNarutoMissile_missile[this]) , s__MechaNarutoMissile_target_x[this] , s__MechaNarutoMissile_target_y[this]) / 25)
			set s__MechaNarutoMissile_max_count[this]=R2I(GetDistance(GetUnitX(s__MechaNarutoMissile_missile[this]) , GetUnitY(s__MechaNarutoMissile_missile[this]) , s__MechaNarutoMissile_target_x[this] , s__MechaNarutoMissile_target_y[this]) / 25 + s__MechaNarutoMissile_original_height[this] / 25)
			//call SetUnitFlyHeight(this.missile, GetUnitFlyHeight(this.caster) + 80, 0)
			set s__MechaNarutoMissile_dist[this]=GetDistance(GetUnitX(s__MechaNarutoMissile_missile[this]) , GetUnitY(s__MechaNarutoMissile_missile[this]) , s__MechaNarutoMissile_target_x[this] , s__MechaNarutoMissile_target_y[this])
			call TimerStart(NewTimerEx(this), 0.03, true, function s__MechaNarutoMissile_moveMissile)
			set i=i + 1
		endloop
 endfunction 

