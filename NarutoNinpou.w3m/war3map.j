    function s__RoshiFarming_dealDamage takes nothing returns boolean
            if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__RoshiFarming_caster[s__RoshiFarming_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
				if GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_LIFE) < GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_MAX_LIFE) / 2 and GetWidgetLife(s__RoshiFarming_caster[s__RoshiFarming_instance]) > 0.405 then
					if GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_LIFE) / GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_MAX_LIFE) <= 0.1 then
						call StunUnitTimed(s__RoshiFarming_caster[s__RoshiFarming_instance] , GetFilterUnit() , 1.0)
					endif
					call UnitDamageTarget(s__RoshiFarming_caster[s__RoshiFarming_instance], GetFilterUnit(), 80 * GetUnitAbilityLevel(s__RoshiFarming_caster[s__RoshiFarming_instance], s__RoshiFarming_SPELL_ID) * ( 1.5 - GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_LIFE) / GetUnitState(s__RoshiFarming_caster[s__RoshiFarming_instance], UNIT_STATE_MAX_LIFE) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__RoshiFarming_caster[s__RoshiFarming_instance], GetFilterUnit(), 80 * GetUnitAbilityLevel(s__RoshiFarming_caster[s__RoshiFarming_instance], s__RoshiFarming_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				endif

		set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", GetUnitX(GetFilterUnit()), GetUnitY(GetFilterUnit()))
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(GetFilterUnit()) , GetUnitY(GetFilterUnit())))
		call DestroyEffect(bj_lastCreatedEffect)
            endif
        return false
    endfunction


    function s__RoshiFarming_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	set bj_lastCreatedEffect=AddSpecialEffect("AnimeFireEffectJiraiya.mdl", s__RoshiFarming_x[this], s__RoshiFarming_y[this])
	call DestroyEffect(bj_lastCreatedEffect)
        set bj_lastCreatedGroup=CreateGroup()
        set s__RoshiFarming_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__RoshiFarming_x[this], s__RoshiFarming_y[this], 400.0, Filter(function s__RoshiFarming_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
	set s__RoshiFarming_caster[this]=null
        call s__RoshiFarming_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__RoshiFarming_actions takes nothing returns nothing
        local integer this= s__RoshiFarming_allocate()
 local integer i
 local real x
 local real y
 local real offset
 local real angle
        set s__RoshiFarming_caster[this]=GetTriggerUnit()
        set s__RoshiFarming_x[this]=GetSpellTargetX()
        set s__RoshiFarming_y[this]=GetSpellTargetY()
	set i=0
	loop
		set offset=GetRandomReal(0, 300)
		set angle=GetRandomReal(0, 360)
		set x=(((s__RoshiFarming_x[this] )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
		set y=(((s__RoshiFarming_y[this] )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
        	set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A1EB')
        	call SetUnitFlyHeight(bj_lastCreatedUnit, 100.0, 0)
        	call SetUnitScale(bj_lastCreatedUnit, 2.0, 0, 0)
        	//call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", x, y)
        	set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A1EC')
        	call SetUnitFlyHeight(bj_lastCreatedUnit, 100.0, 0)
        	call SetUnitScale(bj_lastCreatedUnit, 1.5, 0, 0)
        	call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", x, y)
		set i=i + 1
		exitwhen i > 3
	endloop
	call TimerStart(NewTimerEx(this), 0.5, false, function s__RoshiFarming_damage)
    endfunction

    //===========================================================================
    function s__RoshiFarming_onInit takes nothing returns nothing
