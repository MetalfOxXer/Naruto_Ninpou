        call SetUnitPositionLocFacingLocBJ(GetEnumUnit(), udg_Duel2_Point[1], udg_Duel2_Point[2])
        call SetUnitLifePercentBJ(GetEnumUnit(), 100)
        call SetUnitManaPercentBJ(GetEnumUnit(), 100)
        if ( Trig_Duel_receiver_answer_Func001Func005Func020Func001Func004C() ) then
            call UnitResetCooldown(GetEnumUnit())
            if GetUnitTypeId(GetEnumUnit()) == 'N02G' then
		set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
		set s__HagoromoD_HagoromoSpellPrevious=0
		set s__HagoromoD_HagoromoSpellPenultimate=0
		set s__HagoromoD_HagoromoSpellAntepenultimate=0
		set s__HagoromoD_HagoromoRecharging=false
		set s__HagoromoD_HagoromoStreakReward=3
	    endif
        endif
        call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL, GetEnumUnit())
        call SetUnitInvulnerable(GetEnumUnit(), true)
        call PauseUnitBJ(true, GetEnumUnit())
    else
    endif
endfunction

