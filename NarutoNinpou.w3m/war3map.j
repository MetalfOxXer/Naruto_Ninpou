                    set x=(((s__KidomaruKuchiyose_target_x[this] )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
                    set y=(((s__KidomaruKuchiyose_target_y[this] )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
                    set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KidomaruKuchiyose_caster[this]), 'h00P', x, y, 270.0)
                    call SetUnitScale(bj_lastCreatedUnit, 1.0, 1.0, 1.0)
                    call GroupAddUnit(s__KidomaruKuchiyose_effects[this], bj_lastCreatedUnit)
            		set x=(((s__KidomaruKuchiyose_target_x[this] )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 350)*1.0)) // INLINED!!
            		set y=(((s__KidomaruKuchiyose_target_y[this] )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 350)*1.0)) // INLINED!!
            		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KidomaruKuchiyose_caster[this]), 'h00P', x, y, 270.0)
	    		    call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            		call GroupAddUnit(s__KidomaruKuchiyose_effects[this], bj_lastCreatedUnit)
            		set i=i + 1
        	endloop
        	call TimerStart(NewTimerEx(this), 0.03, true, function s__KidomaruKuchiyose_periodic)
        	call ReleaseTimer(GetExpiredTimer())
		call SetUnitColor(s__KidomaruKuchiyose_spider[this], PLAYER_COLOR_RED)
 endfunction 

 function s__KidomaruKuchiyose_actions takes nothing returns nothing
  local integer this= s__KidomaruKuchiyose_allocate()
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                	call PlaySoundOnUnitBJ(gg_snd_Kidomaru_D, 100, GetTriggerUnit())
        	endif
		set s__KidomaruKuchiyose_caster[this]=GetTriggerUnit()
