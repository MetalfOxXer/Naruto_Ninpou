 function s__KonohamaruShuriken_dealDamage takes nothing returns boolean
                if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KonohamaruShuriken_caster[s__KonohamaruShuriken_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                    //call AddSpecialEffectEx("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.mdl", GetUnitX(GetFilterUnit()), GetUnitY(GetFilterUnit()))
                    //call StunUnitTimed(instance.caster, GetFilterUnit(), 2.0)
