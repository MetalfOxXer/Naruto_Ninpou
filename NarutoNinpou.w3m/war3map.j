//Implemented from module Alloc:
    
        function s__ToruneNewQ_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ToruneNewQ_Alloc___recycle[(0)] == 0 ) then
                set s__ToruneNewQ_Alloc___instanceCount=s__ToruneNewQ_Alloc___instanceCount + 1
                set this=s__ToruneNewQ_Alloc___instanceCount
            else
                set this=s__ToruneNewQ_Alloc___recycle[(0)]
                set s__ToruneNewQ_Alloc___recycle[(0)]=s__ToruneNewQ_Alloc___recycle[s__ToruneNewQ_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ToruneNewQ_deallocate takes integer this returns nothing
            set s__ToruneNewQ_Alloc___recycle[this]=s__ToruneNewQ_Alloc___recycle[(0)]
            set s__ToruneNewQ_Alloc___recycle[(0)]=this
        endfunction
    
    function s__ToruneNewQ_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real dist
        local real angle
        local real angle2
        local integer i= 0
        set s__ToruneNewQ_count[this]=s__ToruneNewQ_count[this] + 0.05
        set dist=s__ToruneNewQ_count[this] * 400
        if dist > 400 then
            set dist=400
        endif
        set angle=( s__ToruneNewQ_count[this] / 0.05 ) * 8.0
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ToruneNewQ_tornadoes[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            set x=(((s__ToruneNewQ_target_x[this] )*1.0) + Cos((( Deg2Rad(72 * i + angle) )*1.0)) * (( dist)*1.0)) // INLINED!!
            set y=(((s__ToruneNewQ_target_y[this] )*1.0) + Sin((( Deg2Rad(72 * i + angle) )*1.0)) * (( dist)*1.0)) // INLINED!!
            set angle2=Atan3(s__ToruneNewQ_target_x[this] , s__ToruneNewQ_target_y[this] , x , y)
            call SetUnitX(bj_lastCreatedUnit, x)
            call SetUnitY(bj_lastCreatedUnit, y)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            set i=i + 1
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ToruneNewQ_target_x[this], s__ToruneNewQ_target_y[this], dist, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToruneNewQ_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set angle=Atan3(s__ToruneNewQ_target_x[this] , s__ToruneNewQ_target_x[this] , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit))
                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 10.0)*1.0)) // INLINED!!
                set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 10.0)*1.0)) // INLINED!!
                if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, x)
                    call SetUnitY(bj_lastCreatedUnit, y)
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__ToruneNewQ_damaged[this]) then
                    call UnitDamageTarget(s__ToruneNewQ_caster[this], bj_lastCreatedUnit, 100.0 * GetUnitAbilityLevel(s__ToruneNewQ_caster[this], s__ToruneNewQ_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__ToruneNewQ_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__ToruneNewQ_count[this] >= 2.0 then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__ToruneNewQ_tornadoes[this])
                exitwhen bj_lastCreatedUnit == null
                call KillUnit(bj_lastCreatedUnit)
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__ToruneNewQ_tornadoes[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__ToruneNewQ_damaged[this])
            set s__ToruneNewQ_damaged[this]=null
            set s__ToruneNewQ_tornadoes[this]=null
            call s__ToruneNewQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToruneNewQ_actions takes nothing returns nothing
        local integer this= s__ToruneNewQ_allocate()
        local integer i= 0
        set s__ToruneNewQ_caster[this]=GetTriggerUnit()
        set s__ToruneNewQ_tornadoes[this]=CreateGroup()
        set s__ToruneNewQ_count[this]=0
        set s__ToruneNewQ_damaged[this]=CreateGroup()
        set s__ToruneNewQ_target_x[this]=GetSpellTargetX()
        set s__ToruneNewQ_target_y[this]=GetSpellTargetY()
        loop
            set i=i + 1
            exitwhen i > 5
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h0AM', s__ToruneNewQ_target_x[this], s__ToruneNewQ_target_y[this], 72 * i)
            call SetUnitTimeScale(bj_lastCreatedUnit, 0.52)
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call SetUnitScale(bj_lastCreatedUnit, 0.7, 0.7, 0.7)
            call GroupAddUnit(s__ToruneNewQ_tornadoes[this], bj_lastCreatedUnit)
        endloop
        call TimerStart(NewTimerEx(this), 0.05, true, function s__ToruneNewQ_periodic)
    endfunction 
    
    function s__ToruneNewQ_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(72 , s__ToruneNewQ_SPELL_ID , function s__ToruneNewQ_actions)
    endfunction 
    
