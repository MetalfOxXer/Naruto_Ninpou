        local integer this= s__KakashiKamuiShuriken___Spell_allocate()
        set s__KakashiKamuiShuriken___Spell_caster[this]=GetTriggerUnit()
        set s__KakashiKamuiShuriken___Spell_angle[this]=Atan3(GetUnitX(s__KakashiKamuiShuriken___Spell_caster[this]) , GetUnitY(s__KakashiKamuiShuriken___Spell_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set udg_SusanooKamui=true
