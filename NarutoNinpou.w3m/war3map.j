 function s__SpawnCreeps_onInit takes nothing returns nothing
     local trigger t2= CreateTrigger()
		call TriggerRegisterAnyUnitEventBJ(t2, EVENT_PLAYER_UNIT_DEATH)
		call TriggerAddAction(t2, function s__SpawnCreeps_anbudeath)
		set s__SpawnCreeps_Repick=false
		set s__SpawnCreeps_ForestAnbu1=null
		set s__SpawnCreeps_ForestAnbu2=null
		set s__SpawnCreeps_ForestAnbu3=null
		set s__SpawnCreeps_ForestAnbu4=null
		set s__SpawnCreeps_ForestAnbu5=null
		set s__SpawnCreeps_ForestAnbu6=null
		set s__SpawnCreeps_ForestAnbu7=null
		set s__SpawnCreeps_ForestAnbu8=null
		set s__SpawnCreeps_ForestAnbu9=null
		call TimerStart(CreateTimer(), 1.0, true, function s__SpawnCreeps_check)
 endfunction 
	

