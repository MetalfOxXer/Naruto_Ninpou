 function s__ObitoSemiSemi_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local unit u
		set s__ObitoSemiSemi_count[this]=s__ObitoSemiSemi_count[this] + 1
		if ModuloInteger(s__ObitoSemiSemi_count[this], 5) == 1 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ObitoSemiSemi_caster[this]), 'e015', GetUnitX(s__ObitoSemiSemi_gedo[this]), GetUnitY(s__ObitoSemiSemi_gedo[this]), GetRandomReal(0, 360))
			call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__ObitoSemiSemi_gedo[this]))
        		call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__ObitoSemiSemi_gedo[this]))
        		call SetUnitTimeScale(bj_lastCreatedUnit, 1.5)
        		call SetUnitScale(bj_lastCreatedUnit, 3.0, 0, 0)
        		call KillUnit(bj_lastCreatedUnit)
		endif
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ObitoSemiSemi_gedo[this]), GetUnitY(s__ObitoSemiSemi_gedo[this]), 600, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoSemiSemi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				call UnitDamageTarget(s__ObitoSemiSemi_caster[this], bj_lastCreatedUnit, ( 800 * GetUnitAbilityLevel(s__ObitoSemiSemi_caster[this], s__ObitoSemiSemi_SPELL_ID) + 2 * GetHeroInt(s__ObitoSemiSemi_caster[this], true) ) / 20.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				if not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoSemiSemi_damaged[this]) then
                    call GroupAddUnit(s__ObitoSemiSemi_damaged[this], bj_lastCreatedUnit)
                    set u=CreateAbilityDummy(s__ObitoSemiSemi_caster[this] , 'A13Q')
					call SetUnitAbilityLevel(u, 'A13Q', s__ObitoSemiSemi_count[this])
                    call IssuePointOrder(u, "silence", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
            	    call UnitApplyTimedLife(u, 'BTLF', 1.0)
                    set u=null
                endif
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		if s__ObitoSemiSemi_count[this] > 20 then
			set bj_lastCreatedEffect=AddSpecialEffect("s_Shadow_Smoke.mdl", GetUnitX(s__ObitoSemiSemi_gedo[this]), GetUnitY(s__ObitoSemiSemi_gedo[this]))
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
			call DestroyEffect(bj_lastCreatedEffect)
			call KillUnit(s__ObitoSemiSemi_gedo[this])
			call ShowUnit(s__ObitoSemiSemi_gedo[this], false)
			set s__ObitoSemiSemi_gedo[this]=null
			call DestroyGroup(s__ObitoSemiSemi_damaged[this])
            set s__ObitoSemiSemi_damaged[this]=null
			call s__ObitoSemiSemi_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__ObitoSemiSemi_pause takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call TimerStart(NewTimerEx(this), 0.1, true, function s__ObitoSemiSemi_periodic)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

