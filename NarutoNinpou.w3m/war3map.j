    function s__Barrier_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        set s__Barrier_count[this]=s__Barrier_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__Barrier_barrierx[this], s__Barrier_barriery[this], 800.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__Barrier_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
            	call UnitDamageTarget(s__Barrier_caster[this], bj_lastCreatedUnit, 8.0 * GetHeroStr(s__Barrier_caster[this], true) / 600, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                if not IsUnitInGroup(bj_lastCreatedUnit, s__Barrier_damaged[this]) then
                    call GroupAddUnit(s__Barrier_damaged[this], bj_lastCreatedUnit)
                    set u=CreateAbilityDummy(s__Barrier_caster[this] , 'A02M')
                    call IssuePointOrder(u, "silence", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
            	    call UnitApplyTimedLife(u, 'BTLF', 1.5)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__Barrier_count[this] > 600 or GetWidgetLife(s__Barrier_caster[this]) < 0.405 then
            call KillUnit(s__Barrier_barrier[this])
            call ShowUnit(s__Barrier_barrier[this], false)
            set s__Barrier_barrier[this]=null
            call DestroyGroup(s__Barrier_damaged[this])
            set s__Barrier_damaged[this]=null
            call s__Barrier_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    
    function s__Barrier_actions takes nothing returns nothing
        local integer this= s__Barrier_allocate()
        set s__Barrier_caster[this]=GetTriggerUnit()
        set s__Barrier_count[this]=0
        set s__Barrier_barrier[this]=(CreateUnit((GetOwningPlayer(s__Barrier_caster[this]) ), ( 'nbda' ), (( GetUnitX(s__Barrier_caster[this]) )*1.0), (( GetUnitY(s__Barrier_caster[this]) )*1.0), (( 270.0)*1.0))) // INLINED!!
	call SlowAura(s__Barrier_barrier[this] , 0.5 , 800)
        set s__Barrier_barrierx[this]=GetUnitX(s__Barrier_barrier[this])
        set s__Barrier_barriery[this]=GetUnitY(s__Barrier_barrier[this])
        set s__Barrier_damaged[this]=CreateGroup()
        call SetUnitX(s__Barrier_barrier[this], GetUnitX(s__Barrier_caster[this]))
        call SetUnitY(s__Barrier_barrier[this], GetUnitY(s__Barrier_caster[this]))
        call TimerStartEx(NewTimerEx(this) , 0.01 , true , function s__Barrier_periodic , "Barrier_periodic")
    endfunction 
    
    function s__Barrier_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(24 , s__Barrier_SPELL_ID , function s__Barrier_actions)
    endfunction 
    
