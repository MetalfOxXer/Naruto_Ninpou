    function s__MitsukiNewSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MitsukiNewSemi_dummy[this])
        local real y= GetUnitY(s__MitsukiNewSemi_dummy[this])
        local real angle= Atan3(x , y , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real snake1_x= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(s__MitsukiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real snake1_y= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(s__MitsukiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real snake2_x= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + s__MitsukiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real snake2_y= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + s__MitsukiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real offset
        local integer i
        call SetUnitX(s__MitsukiNewSemi_dummy[this], new_x)
        call SetUnitY(s__MitsukiNewSemi_dummy[this], new_y)
        if s__MitsukiNewSemi_attack[this] then
            set angle=Atan3(GetUnitX(s__MitsukiNewSemi_snake1[this]) , GetUnitY(s__MitsukiNewSemi_snake1[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])
            set snake1_x=(((GetUnitX(s__MitsukiNewSemi_snake1[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            set snake1_y=(((GetUnitY(s__MitsukiNewSemi_snake1[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        endif
        call SetUnitX(s__MitsukiNewSemi_snake1[this], snake1_x)
        call SetUnitY(s__MitsukiNewSemi_snake1[this], snake1_y)
        call SetUnitFacing(s__MitsukiNewSemi_snake1[this], Rad2Deg(Atan3(GetUnitX(s__MitsukiNewSemi_snake1[this]) , GetUnitY(s__MitsukiNewSemi_snake1[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])))
        if s__MitsukiNewSemi_attack[this] then
            set angle=Atan3(GetUnitX(s__MitsukiNewSemi_snake2[this]) , GetUnitY(s__MitsukiNewSemi_snake2[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])
            set snake2_x=(((GetUnitX(s__MitsukiNewSemi_snake2[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            set snake2_y=(((GetUnitY(s__MitsukiNewSemi_snake2[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        endif
        call SetUnitX(s__MitsukiNewSemi_snake2[this], snake2_x)
        call SetUnitY(s__MitsukiNewSemi_snake2[this], snake2_y)
        call SetUnitFacing(s__MitsukiNewSemi_snake2[this], Rad2Deg(Atan3(GetUnitX(s__MitsukiNewSemi_snake2[this]) , GetUnitY(s__MitsukiNewSemi_snake2[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])))
        

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, snake1_x, snake1_y, 220.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MitsukiNewSemi_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
 		set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 24)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 24)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetUnitTypeId(bj_lastCreatedUnit) != 'e03B' then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                endif
		if not IsUnitInGroup(bj_lastCreatedUnit, s__MitsukiNewSemi_damaged[this]) then
			call StunUnitTimed(s__MitsukiNewSemi_caster[this] , bj_lastCreatedUnit , 1.5)
        		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                	call UnitDamageTarget(s__MitsukiNewSemi_caster[this], bj_lastCreatedUnit, ( 600 + 2 * GetHeroInt(s__MitsukiNewSemi_caster[this], true) ) * GetUnitAbilityLevel(s__MitsukiNewSemi_caster[this], s__MitsukiNewSemi_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                	call GroupAddUnit(s__MitsukiNewSemi_damaged[this], bj_lastCreatedUnit)
		endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)


        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, snake2_x, snake2_y, 220.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MitsukiNewSemi_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
 		set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 24)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 24)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetUnitTypeId(bj_lastCreatedUnit) != 'e03B' then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                endif
		if not IsUnitInGroup(bj_lastCreatedUnit, s__MitsukiNewSemi_damaged[this]) then
			call StunUnitTimed(s__MitsukiNewSemi_caster[this] , bj_lastCreatedUnit , 1.5)
        		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                	call UnitDamageTarget(s__MitsukiNewSemi_caster[this], bj_lastCreatedUnit, ( 600 + 2 * GetHeroInt(s__MitsukiNewSemi_caster[this], true) ) * GetUnitAbilityLevel(s__MitsukiNewSemi_caster[this], s__MitsukiNewSemi_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                	call GroupAddUnit(s__MitsukiNewSemi_damaged[this], bj_lastCreatedUnit)
		endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        set s__MitsukiNewSemi_count[this]=s__MitsukiNewSemi_count[this] + 1
        if GetDistance(new_x , new_y , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this]) < 200 then
            if not s__MitsukiNewSemi_attack[this] then
                call SetUnitFacing(s__MitsukiNewSemi_snake1[this], Rad2Deg(Atan3(GetUnitX(s__MitsukiNewSemi_snake1[this]) , GetUnitY(s__MitsukiNewSemi_snake1[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])))
                call SetUnitFacing(s__MitsukiNewSemi_snake2[this], Rad2Deg(Atan3(GetUnitX(s__MitsukiNewSemi_snake2[this]) , GetUnitY(s__MitsukiNewSemi_snake2[this]) , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this])))
                set s__MitsukiNewSemi_attack[this]=true
            endif
	endif
        if GetDistance(snake1_x , snake1_y , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this]) < 100 and GetDistance(snake2_x , snake2_y , s__MitsukiNewSemi_target_x[this] , s__MitsukiNewSemi_target_y[this]) < 100 then
            	call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__MitsukiNewSemi_snake1[this]) )*1.0), (( GetUnitY(s__MitsukiNewSemi_snake1[this]))*1.0))) // INLINED!!
            	call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__MitsukiNewSemi_snake2[this]) )*1.0), (( GetUnitY(s__MitsukiNewSemi_snake2[this]))*1.0))) // INLINED!!
            	call KillUnit(s__MitsukiNewSemi_snake1[this])
            	call ShowUnit(s__MitsukiNewSemi_snake1[this], false)
            	call KillUnit(s__MitsukiNewSemi_snake2[this])
            	call ShowUnit(s__MitsukiNewSemi_snake2[this], false)
            	call KillUnit(s__MitsukiNewSemi_dummy[this])
            	set s__MitsukiNewSemi_snake1[this]=null
            	set s__MitsukiNewSemi_snake2[this]=null
            	set s__MitsukiNewSemi_dummy[this]=null
       	    	call DestroyGroup(s__MitsukiNewSemi_damaged[this])
	    	set s__MitsukiNewSemi_damaged[this]=null
            	call s__MitsukiNewSemi_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
         endif
    endfunction 
    
    function s__MitsukiNewSemi_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitAnimationByIndex(s__MitsukiNewSemi_snake1[this], 0)
        call SetUnitAnimationByIndex(s__MitsukiNewSemi_snake2[this], 0)
        call SetUnitTimeScale(s__MitsukiNewSemi_snake1[this], 2.0)
        call SetUnitTimeScale(s__MitsukiNewSemi_snake2[this], 2.0)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__MitsukiNewSemi_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__MitsukiNewSemi_actions takes nothing returns nothing
        local integer this= s__MitsukiNewSemi_allocate()
        local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
 local real angle1
 local real angle2
        local real x3= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle )*1.0)) * (( 1200.0)*1.0)) // INLINED!!
        local real y3= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle )*1.0)) * (( 1200.0)*1.0)) // INLINED!!
        local real x1= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
        local real y1= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
        local real x2= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( - 200.0)*1.0)) // INLINED!!
        local real y2= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( - 200.0)*1.0)) // INLINED!!
        set s__MitsukiNewSemi_damaged[this]=CreateGroup()
        set s__MitsukiNewSemi_caster[this]=GetTriggerUnit()
        set s__MitsukiNewSemi_target_x[this]=x3
        set s__MitsukiNewSemi_target_y[this]=y3
        set s__MitsukiNewSemi_snake1[this]=CreateUnit(GetTriggerPlayer(), 'e00I', x1, y1, Rad2Deg(angle))
	set angle1=Atan3(GetUnitX(s__MitsukiNewSemi_snake1[this]) , GetUnitY(s__MitsukiNewSemi_snake1[this]) , x3 , y3)
	call SetUnitFacing(s__MitsukiNewSemi_snake1[this], Rad2Deg(angle1))
        set s__MitsukiNewSemi_snake2[this]=CreateUnit(GetTriggerPlayer(), 'e00I', x2, y2, Rad2Deg(angle))
	set angle2=Atan3(GetUnitX(s__MitsukiNewSemi_snake2[this]) , GetUnitY(s__MitsukiNewSemi_snake2[this]) , x3 , y3)
	call SetUnitFacing(s__MitsukiNewSemi_snake1[this], Rad2Deg(angle2))
        set s__MitsukiNewSemi_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0)
        set s__MitsukiNewSemi_count[this]=0
        set s__MitsukiNewSemi_attack[this]=false
        call SetUnitAnimationByIndex(s__MitsukiNewSemi_snake1[this], 0)
        call SetUnitAnimationByIndex(s__MitsukiNewSemi_snake2[this], 0)
        call TimerStart(NewTimerEx(this), 0.25, false, function s__MitsukiNewSemi_delay)
    endfunction 
    
    function s__MitsukiNewSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(91 , s__MitsukiNewSemi_SPELL_ID , function s__MitsukiNewSemi_actions)
    endfunction 
    
