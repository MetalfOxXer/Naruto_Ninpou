        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__TobiramaHiraishin_actions takes nothing returns nothing
        set s__TobiramaHiraishin_tobirama=GetTriggerUnit()
        if GetSpellTargetUnit() != null then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetSpellTargetUnit()), 'e007', GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), 0)
            call UnitAddAbility(bj_lastCreatedUnit, 'A0UQ')
            call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", GetSpellTargetUnit())
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            set s__TobiramaHiraishin_hiraishinTarget=GetSpellTargetUnit()
        else
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h09L', GetSpellTargetX(), GetSpellTargetY(), 0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 40.0)
            set s__TobiramaHiraishin_hiraishinMark=bj_lastCreatedUnit
        endif
        call TimerStart((NewTimerEx(0)), 0.1, false, function s__TobiramaHiraishin_delay) // INLINED!!
    endfunction
    
