//===========================================================================

function Trig__Satetsu_Kesshu_Actions takes nothing returns nothing
    local real angle= Rad2Deg(Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY()))
    set udg_SK_U[0]=GetTriggerUnit()
    //set udg_SK_U[1] = GetSpellTargetUnit()
    set udg_SK_P[0]=GetUnitLoc(GetTriggerUnit())
    set udg_SK_P[1]=PolarProjectionBJ(udg_SK_P[0], 800.0, angle)
    set udg_SK_R[0]=angle //AngleBetweenPoints(udg_SK_P[0], udg_SK_P[1])
    set udg_SK_R[1]=0.00
    set udg_SK_I[0]=0
    //call PauseUnitBJ( true, udg_SK_U[0] )
    //call PauseUnitBJ( true, udg_SK_U[1] )
    call CreateNUnitsAtLoc(1, 'h09Q', GetOwningPlayer(udg_SK_U[0]), udg_SK_P[0], udg_SK_R[0])
    set udg_SK_U[2]=GetLastCreatedUnit()
    call SetUnitFlyHeightBJ(udg_SK_U[2], 400.00, 15555.00)
    call GroupClear(udg_SasoriSpearGroup)
    call StartTimerBJ(udg_SK_T[0], true, 0.03)
endfunction

//===========================================================================
function InitTrig__Satetsu_Kesshu takes nothing returns nothing
	call RegisterSpellEffectEvent2(('A00S' ) , Filter(( function Trig__Satetsu_Kesshu_Actions))) // INLINED!!
endfunction


//===========================================================================
// Trigger: SK loop
//===========================================================================
function Trig_SK_loop_Func001Func006C takes nothing returns boolean
    if ( not ( udg_SK_R[1] >= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SK_loop_Func001Func007C takes nothing returns boolean
    if ( not ( udg_SK_I[0] > 200 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SK_loop_Func001C takes nothing returns boolean
    if ( not ( udg_SK_I[0] > 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SK_loop_Actions takes nothing returns nothing
    if ( Trig_SK_loop_Func001C() ) then
        set udg_SK_I[0]=( udg_SK_I[0] + 1 )
        set udg_SK_P[2]=GetUnitLoc(udg_SK_U[2])
        set udg_SK_R[0]=GetUnitFacing(udg_SK_U[2])
        set udg_SK_R[1]=DistanceBetweenPoints(udg_SK_P[2], udg_SK_P[1])
        set udg_SK_P[3]=PolarProjectionBJ(udg_SK_P[2], 25.00, udg_SK_R[0])
        if ( Trig_SK_loop_Func001Func006C() ) then
            call SetUnitFlyHeightBJ(udg_SK_U[2], 100.00, 700.00)
            call SetUnitPositionLocFacingBJ(udg_SK_U[2], udg_SK_P[3], udg_SK_R[0])
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetLocationX(udg_SK_P[3]), GetLocationY(udg_SK_P[3]), 300.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(udg_SK_U[0])) and not IsUnitInGroup(bj_lastCreatedUnit, udg_SasoriSpearGroup) then
                    call UnitDamageTarget(udg_SK_U[0], bj_lastCreatedUnit, GetHeroStr(udg_SK_U[0], true) * s__SasoriLevelSpells_sasori_level, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(udg_SasoriSpearGroup, bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            call RemoveLocation(udg_SK_P[2])
            call RemoveLocation(udg_SK_P[3])
        else
            set udg_SK_I[0]=0
            call AddSpecialEffectLocBJ(udg_SK_P[1], "war3mapImported\\Ground Crack.mdx")
            call DestroyEffectBJ(GetLastCreatedEffectBJ())
            //call CreateNUnitsAtLoc( 1, 'e007', GetOwningPlayer(udg_SK_U[0]), udg_SK_P[1], udg_SK_R[0] )
            //call UnitApplyTimedLifeBJ( 0.30, 'BTLF', GetLastCreatedUnit() )
            //call RemoveUnit( udg_SK_U[2] )
            //call RemoveLocation(udg_SK_P[1])
            call RemoveLocation(udg_SK_P[2])
            call RemoveLocation(udg_SK_P[3])
            call ShowUnit(udg_SK_U[2], false)
            //call UnitDamageTargetBJ( udg_SK_U[0], udg_SK_U[1], ( I2R(GetHeroStatBJ(bj_HEROSTAT_INT, udg_SK_U[0], true)) * 10.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
            call PauseTimerBJ(true, udg_SK_T[0])
            call StartTimerBJ(udg_SK_T[1], true, 0.03)
        endif
        if ( Trig_SK_loop_Func001Func007C() ) then
            call PauseTimerBJ(true, udg_SK_T[0])
        else
        endif
    else
        call CreateNUnitsAtLoc(1, 'h09S', GetOwningPlayer(udg_SK_U[0]), udg_SK_P[0], bj_UNIT_FACING)
        call h__SetUnitScalePercent(GetLastCreatedUnit(), 100.00, 100.00, 100.00)
        call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 400.00, 1500.00)
        call UnitApplyTimedLifeBJ(0.30, 'BTLF', GetLastCreatedUnit())
        set udg_SK_I[0]=( udg_SK_I[0] + 1 )
        set udg_SK_R[1]=( udg_SK_R[1] + 36.00 )
        call h__SetUnitScalePercent(udg_SK_U[2], udg_SK_R[1], udg_SK_R[1], udg_SK_R[1])
    endif
endfunction

//===========================================================================
function InitTrig_SK_loop takes nothing returns nothing
    set gg_trg_SK_loop=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SK_loop, udg_SK_T[0])
    call TriggerAddAction(gg_trg_SK_loop, function Trig_SK_loop_Actions)
endfunction


//===========================================================================
// Trigger: SK loop 2
//===========================================================================
function Trig_SK_loop_2_Func001Func013002003001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_SK_loop_2_Func001Func013002003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_SK_U[0])) == true )
endfunction

function Trig_SK_loop_2_Func001Func013002003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_SK_U[0])) == true)) // INLINED!!
endfunction

function Trig_SK_loop_2_Func001Func014002 takes nothing returns nothing
    call UnitDamageTargetBJ(udg_SK_U[0], GetEnumUnit(), GetHeroStr(udg_SK_U[0], true) / 2 * s__SasoriLevelSpells_sasori_level, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_SK_loop_2_Func001C takes nothing returns boolean
    if ( not ( udg_SK_I[0] > 25 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SK_loop_2_Actions takes nothing returns nothing
    //if ( Trig_SK_loop_2_Func001C() ) then
        set udg_SK_I[0]=( udg_SK_I[0] + 1 )
        if udg_SK_I[0] == 1 then
            //set udg_SK_P[1] = GetUnitLoc(udg_SK_U[2])
            call CreateNUnitsAtLoc(1, 'h09T', GetOwningPlayer(udg_SK_U[0]), udg_SK_P[1], udg_SK_R[0])
            call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
            call SetUnitFlyHeightBJ(GetLastCreatedUnit(), 0.00, 3000.00)
        endif
        if udg_SK_I[0] == 20 then
            //call CreateNUnitsAtLoc( 1, 'e007', GetOwningPlayer(udg_SK_U[0]), udg_SK_P[1], udg_SK_R[0] )
            //call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
            set bj_forLoopAIndex=1
            set bj_forLoopAIndexEnd=12
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                set udg_SK_P[2]=PolarProjectionBJ(udg_SK_P[1], 100.00, ( I2R(GetForLoopIndexA()) * 30.00 ))
                call AddSpecialEffectLocBJ(udg_SK_P[2], "war3mapImported\\Ground Crack.mdx")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                call RemoveLocation(udg_SK_P[2])
                set bj_forLoopAIndex=bj_forLoopAIndex + 1
            endloop
            set udg_SK_G[0]=GetUnitsInRangeOfLocMatching(300.00, udg_SK_P[1], Condition(function Trig_SK_loop_2_Func001Func013002003))
            call ForGroupBJ(udg_SK_G[0], function Trig_SK_loop_2_Func001Func014002)
            call RemoveLocation(udg_SK_P[0])
            call RemoveLocation(udg_SK_P[1])
            call DestroyGroup(udg_SK_G[0])
            //call PauseUnitBJ( false, udg_SK_U[0] )
            //call PauseUnitBJ( false, udg_SK_U[1] )
            //call IssueImmediateOrderBJ( udg_SK_U[0], "stop" )
            call KillUnit(udg_SK_U[2])
            set udg_SK_U[0]=null
            set udg_SK_U[1]=null
            call PauseTimerBJ(true, udg_SK_T[1])
        endif
    
endfunction

//===========================================================================
function InitTrig_SK_loop_2 takes nothing returns nothing
    set gg_trg_SK_loop_2=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_SK_loop_2, udg_SK_T[1])
    call TriggerAddAction(gg_trg_SK_loop_2, function Trig_SK_loop_2_Actions)
endfunction


