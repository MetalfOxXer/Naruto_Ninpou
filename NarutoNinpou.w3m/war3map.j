        function s__HagoromoWE_dealDamage takes integer this returns nothing
            local unit u
            local real x= GetUnitX(s__HagoromoWE_mist[this])
            local real y= GetUnitY(s__HagoromoWE_mist[this])
            local real distance

            // Enumerate units in the mist's radius
            call GroupEnumUnitsInRange(HagoromoBoilingMist___tempGroup, x, y, HagoromoBoilingMist___DAMAGE_RADIUS, null)
            loop
                set u=FirstOfGroup(HagoromoBoilingMist___tempGroup)
                exitwhen u == null

                if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoWE_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__HagoromoWE_caster[this], u, s__HagoromoWE_damage[this] / s__HagoromoWE_maxcount[this], true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                endif
                call GroupRemoveUnit(HagoromoBoilingMist___tempGroup, u)
            endloop
        endfunction

        // Method to handle mist movement and logic
        function s__HagoromoWE_move takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x= GetUnitX(s__HagoromoWE_mist[this])
            local real y= GetUnitY(s__HagoromoWE_mist[this])
            local real mouse_x= (s__UserMouse_mouseX[s__UserMouse__staticgetindex((Player(s__HagoromoWE_pid[this])))]) // INLINED!!
            local real mouse_y= (s__UserMouse_mouseY[s__UserMouse__staticgetindex((Player(s__HagoromoWE_pid[this])))]) // INLINED!!
            local real angle= Atan2(mouse_y - y, mouse_x - x)
            local real distance= SquareRoot(( mouse_x - x ) * ( mouse_x - x ) + ( mouse_y - y ) * ( mouse_y - y ))
            local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( HagoromoBoilingMist___MOVE_SPEED)*1.0)) // INLINED!!
            local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( HagoromoBoilingMist___MOVE_SPEED)*1.0)) // INLINED!!
            local unit u

            // If within distance threshold, stop moving
            if distance <= HagoromoBoilingMist___MIN_DISTANCE_THRESHOLD then
                set new_x=x
                set new_y=y
            endif

            // Move the mist
            call SetUnitFacingTimed(s__HagoromoWE_mist[this], Rad2Deg(angle), 0)
            call SetUnitFacingTimed(s__HagoromoWE_caster[this], Rad2Deg(angle), 0)
            call SetUnitX(s__HagoromoWE_caster[this], new_x)
            call SetUnitY(s__HagoromoWE_caster[this], new_y)
            call SetUnitX(s__HagoromoWE_mist[this], new_x)
            call SetUnitY(s__HagoromoWE_mist[this], new_y)

            // Deal damage to enemies inside the mist
            call s__HagoromoWE_dealDamage(this)

            if s__HagoromoWE_count[this] < s__HagoromoWE_maxcount[this] then
                set s__HagoromoWE_count[this]=s__HagoromoWE_count[this] + 1
            else
                call SetUnitX(s__HagoromoWE_caster[this], new_x)
                call SetUnitY(s__HagoromoWE_caster[this], new_y)
                call ShowUnit(s__HagoromoWE_caster[this], true)
                call BlzSetUnitFacingEx(s__HagoromoWE_caster[this], Rad2Deg(angle))
                call RemoveUnit(s__HagoromoWE_mist[this])
		        //call SetUnitInvulnerable(caster, false)
                call SelectUnitForPlayerSingle(s__HagoromoWE_caster[this], Player(s__HagoromoWE_pid[this]))
                set u=CreateAbilityDummy(s__HagoromoD_Hagoromo , 'A0RF')
                call SetUnitX(u, GetUnitX(s__HagoromoD_Hagoromo))
                call SetUnitY(u, GetUnitY(s__HagoromoD_Hagoromo))
                call IssueTargetOrder(u, "acidbomb", s__HagoromoD_Hagoromo)
                set u=null
                set s__HagoromoWE_mist[this]=null
                call TimerStart(NewTimerEx(this), 0.03, false, function sc__HagoromoWE_fixDebuffs) //NewTimerEx(
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction

function s__HagoromoWE_fixDebuffs takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((t)))) // INLINED!!
    local integer hd= s__HagoromoD_allocate()

    call s__HagoromoD_applyDebuffFromHistory(hd)

    call s__HagoromoD_deallocate(hd)
    call s__HagoromoWE_deallocate(this)
    call ReleaseTimer(t)
    set t=null
endfunction

        function s__HagoromoWE_actions takes nothing returns nothing
            local integer this= s__HagoromoWE_allocate()
            local unit caster= s__HagoromoD_Hagoromo
            local real caster_x= GetUnitX(caster)
            local real caster_y= GetUnitY(caster)

            set s__HagoromoWE_pid[this]=GetPlayerId(GetOwningPlayer(caster))
            set s__HagoromoWE_caster[this]=caster
            set s__HagoromoWE_mouse_x[this]=(s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(caster)))]) // INLINED!!
            set s__HagoromoWE_mouse_y[this]=(s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(caster)))]) // INLINED!!
            set s__HagoromoWE_count[this]=0
            set s__HagoromoWE_maxcount[this]=HagoromoBoilingMist___DURATION
            set s__HagoromoWE_damage[this]=HagoromoBoilingMist___DAMAGE_AMOUNT * ( GetHeroLevel(caster) / 5 )
	        //call UnitRemoveBuffs(caster, false, true)
            call ShowUnit(caster, false)
	        //call SetUnitInvulnerable(caster, true)

            set s__HagoromoWE_mist[this]=CreateUnit(GetOwningPlayer(s__HagoromoWE_caster[this]), 'h08I', caster_x, caster_y, 270)

            call TimerStart(NewTimerEx(this), HagoromoBoilingMist___TIMER_INTERVAL, true, function s__HagoromoWE_move)
        endfunction


