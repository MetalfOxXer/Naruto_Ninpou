			call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.3)*1.0) , false) // INLINED!!
			//call AddSpecialEffect("Effects\\s_Blue_Fire.mdx", GetUnitX(this.target), GetUnitY(this.target))
			set max_count=R2I(Pow(2, s__YugitoRat_bounce[this] + 1))
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__YugitoRat_target[this]), GetUnitY(s__YugitoRat_target[this]), 300, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__YugitoRat_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and count < max_count and CountUnitsInGroup(s__YugitoRat_damaged[this]) < s__YugitoRat_maxbounces[this] and not IsUnitInGroup(bj_lastCreatedUnit, s__YugitoRat_damaged[this]) then
					set count=count + 1
					call GroupAddUnit(s__YugitoRat_damaged[this], bj_lastCreatedUnit)
					call sc__YugitoRat_create(s__YugitoRat_caster[this] , bj_lastCreatedUnit , s__YugitoRat_bounce[this] + 1 , GetUnitX(s__YugitoRat_target[this]) , GetUnitY(s__YugitoRat_target[this]) , s__YugitoRat_damaged[this] , s__YugitoRat_maxbounces[this] , s__YugitoRat_damage[this])
				endif
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			call ShowUnit(s__YugitoRat_rat[this], false)
			call KillUnit(s__YugitoRat_rat[this])
			set s__YugitoRat_rat[this]=null
			call KillUnit(s__YugitoRat_flame[this])
			call ShowUnit(s__YugitoRat_flame[this], false)
			set s__YugitoRat_flame[this]=null
			call s__YugitoRat_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__YugitoRat_create takes unit caster,unit target,integer bounce,real x,real y,group damaged,integer maxbounces,real damage returns integer
  local integer this= s__YugitoRat_allocate()
  local real angle= Atan3(x , y , GetUnitX(target) , GetUnitY(target))
		set s__YugitoRat_caster[this]=caster
		set s__YugitoRat_target[this]=target
		set s__YugitoRat_bounce[this]=bounce
		set s__YugitoRat_rat[this]=CreateUnit(GetOwningPlayer(s__YugitoRat_caster[this]), 'u018', x, y, Rad2Deg(angle))
		set s__YugitoRat_flame[this]=CreateUnit(GetOwningPlayer(s__YugitoRat_caster[this]), 'u019', x, y, Rad2Deg(angle))
		call SetUnitVertexColor(s__YugitoRat_flame[this], 255, 255, 255, 150)
		set s__YugitoRat_damaged[this]=damaged
		set s__YugitoRat_maxbounces[this]=maxbounces
		set s__YugitoRat_damage[this]=damage
                call GroupAddUnit(s__YugitoRat_damaged[this], s__YugitoRat_target[this])
		call TimerStart(NewTimerEx(this), 0.03, true, function s__YugitoRat_periodic)
		return this
 endfunction 

 function s__YugitoRat_cooldownoff takes nothing returns nothing
		set s__YugitoRat_cooldown=false
 endfunction 

 function s__YugitoRat_attack takes nothing returns nothing
		if GetUnitTypeId(GetAttacker()) == 'H0B4' then
			if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) then
				call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), GetHeroAgi(GetAttacker(), true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				set bj_lastCreatedEffect=AddSpecialEffect("YugitoBlueFire.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
				call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.5)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.3)*1.0) , false) // INLINED!!
				//call AddSpecialEffectEx("Effects\\s_Blue_Fire.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
			endif
		elseif GetUnitTypeId(GetAttacker()) == 'H0B2' and not s__YugitoRat_cooldown then
			set s__YugitoRat_cooldown=true
			call TimerStart((NewTimerEx(0)), 0.75, false, function s__YugitoRat_cooldownoff) // INLINED!!
			call s__YugitoRat_create(GetAttacker() , GetTriggerUnit() , 0 , GetUnitX(GetAttacker()) , GetUnitY(GetAttacker()) , CreateGroup() , 5 , 25 + GetHeroAgi(GetAttacker(), true))
		endif
 endfunction 

 function s__YugitoRat_onInit takes nothing returns nothing
		set s__YugitoRat_cooldown=false
		call RegisterPlayerUnitEventForId(79 , EVENT_PLAYER_UNIT_ATTACKED , function s__YugitoRat_attack)
 endfunction 


