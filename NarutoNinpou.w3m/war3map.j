//Implemented from module Alloc:
    
        function s__InoMindDistraction_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__InoMindDistraction_Alloc___recycle[(0)] == 0 ) then
                set s__InoMindDistraction_Alloc___instanceCount=s__InoMindDistraction_Alloc___instanceCount + 1
                set this=s__InoMindDistraction_Alloc___instanceCount
            else
                set this=s__InoMindDistraction_Alloc___recycle[(0)]
                set s__InoMindDistraction_Alloc___recycle[(0)]=s__InoMindDistraction_Alloc___recycle[s__InoMindDistraction_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__InoMindDistraction_deallocate takes integer this returns nothing
            set s__InoMindDistraction_Alloc___recycle[this]=s__InoMindDistraction_Alloc___recycle[(0)]
            set s__InoMindDistraction_Alloc___recycle[(0)]=this
        endfunction
    
    function s__InoMindDistraction_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        set angle=Atan3(GetUnitX(s__InoMindDistraction_target[this]) , GetUnitY(s__InoMindDistraction_target[this]) , GetUnitX(s__InoMindDistraction_bomb[this]) , GetUnitY(s__InoMindDistraction_bomb[this]))
        set x=(((GetUnitX(s__InoMindDistraction_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__InoMindDistraction_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
        if IsUnitType(s__InoMindDistraction_target[this], UNIT_TYPE_STRUCTURE) == false and GetDistanceUnits(s__InoMindDistraction_bomb[this] , s__InoMindDistraction_target[this]) < 1000 and not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__InoMindDistraction_target[this], x)
            call SetUnitY(s__InoMindDistraction_target[this], y)
        endif
        set s__InoMindDistraction_count[this]=s__InoMindDistraction_count[this] + 1
        call UnitDamageTarget(s__InoMindDistraction_caster[this], s__InoMindDistraction_target[this], ( GetHeroInt(s__InoMindDistraction_caster[this], true) * GetUnitAbilityLevel(s__InoMindDistraction_caster[this], s__InoMindDistraction_SPELL_ID) ) / 33, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        if s__InoMindDistraction_count[this] >= 33 then
            set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", s__InoMindDistraction_target_x[this], s__InoMindDistraction_target_y[this])
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
            call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.7)
            call DestroyEffect(bj_lastCreatedEffect)
            call s__Lightning_release(s__InoMindDistraction_flower[this],0.5)
            call KillUnit(s__InoMindDistraction_bomb[this])
            call ShowUnit(s__InoMindDistraction_bomb[this], false)
            set s__InoMindDistraction_bomb[this]=null
            set s__InoMindDistraction_target[this]=null
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    

    function s__InoMindDistraction_actions takes nothing returns nothing
        local integer this
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetSpellTargetX(), GetSpellTargetY(), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                set this=s__InoMindDistraction_allocate()
                set s__InoMindDistraction_caster[this]=GetTriggerUnit()
                set s__InoMindDistraction_target[this]=bj_lastCreatedUnit
                set s__InoMindDistraction_count[this]=0
                set s__InoMindDistraction_target_x[this]=GetSpellTargetX()
                set s__InoMindDistraction_target_y[this]=GetSpellTargetY()
                set s__InoMindDistraction_bomb[this]=CreateUnit(GetTriggerPlayer(), 'h00I', s__InoMindDistraction_target_x[this], s__InoMindDistraction_target_y[this], 270)
                call SetUnitScale(s__InoMindDistraction_bomb[this], 1.5, 1.5, 1.5)
                set s__InoMindDistraction_flower[this]=s__Lightning_create("MYNL" , true , 0.5)
                call s__Lightning_attachToUnit(s__InoMindDistraction_flower[this],false , s__InoMindDistraction_bomb[this] , 60)
                call s__Lightning_attachToUnit(s__InoMindDistraction_flower[this],true , s__InoMindDistraction_target[this] , 60)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__InoMindDistraction_periodic)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction
    
    function s__InoMindDistraction_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__InoMindDistraction_SPELL_ID ) , Filter(( function s__InoMindDistraction_actions))) // INLINED!!
    endfunction
    
