    function s__IrukaFuumaShuriken_dealDamage takes nothing returns boolean
                local unit u
				if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                    if s__IrukaFuumaShuriken_wind[s__IrukaFuumaShuriken_instance] then
                        call UnitDamageTarget(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], GetFilterUnit(), GetHeroAgi(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], true) * 1.2 * GetUnitAbilityLevel(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], s__IrukaFuumaShuriken_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    else
                        call UnitDamageTarget(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], GetFilterUnit(), GetHeroAgi(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], true) * 1.1 * GetUnitAbilityLevel(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance], s__IrukaFuumaShuriken_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                    if s__IrukaFuumaShuriken_earth[s__IrukaFuumaShuriken_instance] then
                        call StunUnitTimed(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance] , GetFilterUnit() , 0.5)
                    elseif s__IrukaFuumaShuriken_water[s__IrukaFuumaShuriken_instance] then
                        call SlowedUnit(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance] , GetFilterUnit() , 3.0)
                    elseif s__IrukaFuumaShuriken_lightning[s__IrukaFuumaShuriken_instance] then
                        call EsnareUnitTimed(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance] , GetFilterUnit() , 1.0)
                    elseif s__IrukaFuumaShuriken_light[s__IrukaFuumaShuriken_instance] then
                        call SilenceUnitLight4(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance] , GetFilterUnit())
                    elseif s__IrukaFuumaShuriken_darkness[s__IrukaFuumaShuriken_instance] then
                        set u=CreateAbilityDummy(s__IrukaFuumaShuriken_caster[s__IrukaFuumaShuriken_instance] , 'A0UR')
                        call IssueTargetOrder(u, "faeriefire", GetFilterUnit())
                        call UnitApplyTimedLife(u, 'BTLF', 1.0)
                    endif
				endif
	    return false
 endfunction


    function s__IrukaFuumaShuriken_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__IrukaFuumaShuriken_shuriken[this])
