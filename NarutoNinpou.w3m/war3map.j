            set s__KabutoEdoTensei___Spell_dummy_3[this]=CreateUnit(GetOwningPlayer(s__KabutoEdoTensei___Spell_caster[this]), 'e007', deidara_x, deidara_y, GetUnitFacing(s__KabutoEdoTensei___Spell_deidara[this]))
