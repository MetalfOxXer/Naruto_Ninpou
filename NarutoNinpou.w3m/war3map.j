    function s__IchigoENew_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if not s__IchigoENew_charges then
		call BlzEndUnitAbilityCooldown(s__IchigoENew_caster[this], s__IchigoENew_SPELL_ID)
		set s__IchigoENew_charges=true
		call TimerStart(NewTimerEx((GetUnitUserData((s__IchigoENew_caster[this])))), 25.0, false, function s__IchigoENew_removeIchigoCharges) // INLINED!!
	else
		set s__IchigoENew_charges=false
	endif
        call s__IchigoENew_deallocate(this)
