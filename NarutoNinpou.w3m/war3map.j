  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetDistanceUnits(s__ItachiTotsuka_caster[this] , s__ItachiTotsuka_target[this]) > 150 then
			call SetUnitX(s__ItachiTotsuka_target[this], new_x)
			call SetUnitY(s__ItachiTotsuka_target[this], new_y)
		endif
		call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("Ember.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // AnimeFireEffectJiraiya.mdx // INLINED!!
		call UnitDamageTarget(s__ItachiTotsuka_caster[this], s__ItachiTotsuka_target[this], 5 * GetHeroInt(s__ItachiTotsuka_caster[this], true) / 99.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		set s__ItachiTotsuka_count[this]=s__ItachiTotsuka_count[this] + 1
		if s__ItachiTotsuka_count[this] == 15 then
			call SetUnitTimeScale(udg_unit24, 0.1)
		endif
		if s__ItachiTotsuka_count[this] >= 99 then
			call UnitRemoveAbility(s__ItachiTotsuka_target[this], 'A0IV')
			call SetUnitTimeScale(itachi_susanoo, 1.0)
			call s__ItachiTotsuka_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

