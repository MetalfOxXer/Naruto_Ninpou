    function s__MinatoInstantLight_periodic2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MinatoInstantLight_target[this])
        local real y= GetUnitY(s__MinatoInstantLight_target[this])
        local real angle= Atan3(x , y , s__MinatoInstantLight_caster_x[this] , s__MinatoInstantLight_caster_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        call SetUnitFlyHeight(s__MinatoInstantLight_target[this], GetUnitFlyHeight(s__MinatoInstantLight_target[this]) - 75, 0)
        call SetUnitFlyHeight(s__MinatoInstantLight_caster[this], GetUnitFlyHeight(s__MinatoInstantLight_caster[this]) - 75, 0)
        call SetUnitX(s__MinatoInstantLight_target[this], new_x)
        call SetUnitY(s__MinatoInstantLight_target[this], new_y)
	set s__MinatoInstantLight_count[this]=s__MinatoInstantLight_count[this] + 1
        if ( GetDistance(x , y , s__MinatoInstantLight_caster_x[this] , s__MinatoInstantLight_caster_y[this]) <= 50 or GetDistance(x , y , GetUnitX(s__MinatoInstantLight_caster[this]) , GetUnitY(s__MinatoInstantLight_caster[this])) >= 600 or s__MinatoInstantLight_count[this] >= 20 ) then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( GetUnitX(s__MinatoInstantLight_target[this]) )*1.0), (( GetUnitY(s__MinatoInstantLight_target[this]))*1.0))) // INLINED!!
		if IsTerrainPathable(GetUnitX(s__MinatoInstantLight_caster[this]), GetUnitY(s__MinatoInstantLight_caster[this]), PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__MinatoInstantLight_caster[this], GetUnitX(s__MinatoInstantLight_target[this]))
			call SetUnitY(s__MinatoInstantLight_caster[this], GetUnitY(s__MinatoInstantLight_target[this]))
		endif
            call SetUnitX(s__MinatoInstantLight_target[this], s__MinatoInstantLight_target_x[this])
            call SetUnitY(s__MinatoInstantLight_target[this], s__MinatoInstantLight_target_y[this])
            call SetUnitFlyHeight(s__MinatoInstantLight_caster[this], 0, 0)
            call SetUnitFlyHeight(s__MinatoInstantLight_target[this], 0, 0)
            call PauseUnit(s__MinatoInstantLight_caster[this], false)
            call PauseUnit(s__MinatoInstantLight_target[this], false)
	    call SetUnitTimeScale(s__MinatoInstantLight_caster[this], 1.0)
            call IssueImmediateOrder(s__MinatoInstantLight_target[this], "stop")
            call SetUnitAnimation(s__MinatoInstantLight_target[this], "death")
            call s__MinatoInstantLight_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__MinatoInstantLight_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MinatoInstantLight_target[this])
        local real y= GetUnitY(s__MinatoInstantLight_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__MinatoInstantLight_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__MinatoInstantLight_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        call SetUnitFlyHeight(s__MinatoInstantLight_target[this], GetUnitFlyHeight(s__MinatoInstantLight_target[this]) + 35, 0)
        call SetUnitX(s__MinatoInstantLight_target[this], new_x)
        call SetUnitY(s__MinatoInstantLight_target[this], new_y)
        set s__MinatoInstantLight_count[this]=s__MinatoInstantLight_count[this] + 1
        if GetDistance(x , y , s__MinatoInstantLight_caster_x[this] , s__MinatoInstantLight_caster_y[this]) >= 500 or s__MinatoInstantLight_count[this] >= 20 then
            call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(s__MinatoInstantLight_caster[this]) )*1.0), (( GetUnitY(s__MinatoInstantLight_caster[this]))*1.0))) // INLINED!!
            call SetUnitFacing(s__MinatoInstantLight_caster[this], GetUnitFacing(s__MinatoInstantLight_target[this]))
            set new_x=(((x )*1.0) + Cos((( s__MinatoInstantLight_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( s__MinatoInstantLight_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
            call SetUnitX(s__MinatoInstantLight_caster[this], new_x)
	    call SetUnitY(s__MinatoInstantLight_caster[this], new_y)
            call UnitAddAbility(s__MinatoInstantLight_caster[this], 'Arav')
