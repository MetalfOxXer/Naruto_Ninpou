//===========================================================================

//Implemented from module Alloc:
    
        function s__YamanakaControl_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__YamanakaControl_Alloc___recycle[(0)] == 0 ) then
                set s__YamanakaControl_Alloc___instanceCount=s__YamanakaControl_Alloc___instanceCount + 1
                set this=s__YamanakaControl_Alloc___instanceCount
            else
                set this=s__YamanakaControl_Alloc___recycle[(0)]
                set s__YamanakaControl_Alloc___recycle[(0)]=s__YamanakaControl_Alloc___recycle[s__YamanakaControl_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__YamanakaControl_deallocate takes integer this returns nothing
            set s__YamanakaControl_Alloc___recycle[this]=s__YamanakaControl_Alloc___recycle[(0)]
            set s__YamanakaControl_Alloc___recycle[(0)]=this
        endfunction

 function s__YamanakaControl_finish takes nothing returns nothing
		call UnitRemoveAbility(s__YamanakaControl_caster, 'A13I')
		call SetPlayerAbilityAvailable(GetOwningPlayer(s__YamanakaControl_caster), 'A12Z', true)
		call ReleaseTimer(GetExpiredTimer())
 endfunction

 function s__YamanakaControl_swap takes nothing returns nothing
  local real x1= GetUnitX(s__YamanakaControl_caster)
  local real y1= GetUnitY(s__YamanakaControl_caster)
  local real x2= GetUnitX(s__YamanakaControl_target)
  local real y2= GetUnitY(s__YamanakaControl_target)
  local integer i= GetRandomInt(0, 4)
		call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( x2 )*1.0), (( y2)*1.0))) // INLINED!!
		if ( RectContainsCoords(gg_rct_Base_Otogakure, x1, y1) or RectContainsCoords(gg_rct_Base_Akatsuki, x1, y1) or RectContainsCoords(gg_rct_Base_Konohagakure, x1, y1) ) or ( RectContainsCoords(gg_rct_Base_Otogakure, x2, y2) or RectContainsCoords(gg_rct_Base_Akatsuki, x2, y2) or RectContainsCoords(gg_rct_Base_Konohagakure, x2, y2) ) then
			if i == 1 then
					set x1=GetRectCenterX(gg_rct_lane_1)
					set y1=GetRectCenterY(gg_rct_lane_1)
					set x2=x1
					set y2=y1
			elseif i == 2 then
					set x1=GetRectCenterX(gg_rct_lane_2)
					set y1=GetRectCenterY(gg_rct_lane_2)
					set x2=x1
					set y2=y1
			elseif i == 3 then
					set x1=GetRectCenterX(gg_rct_lane_3)
					set y1=GetRectCenterY(gg_rct_lane_3)
					set x2=x1
					set y2=y1
			elseif i == 4 then
					set x1=GetRectCenterX(gg_rct_game_middle)
					set y1=GetRectCenterY(gg_rct_game_middle)
					set x2=x1
					set y2=y1
			endif
		endif
		if GetWidgetLife(s__YamanakaControl_target) > 0.405 then
			call SetUnitX(s__YamanakaControl_caster, x2)
			call SetUnitY(s__YamanakaControl_caster, y2)
			if GetUnitTypeId(s__YamanakaControl_target) != 'n00Q' then
				call SetUnitX(s__YamanakaControl_target, x1)
				call SetUnitY(s__YamanakaControl_target, y1)
			endif
		endif
		set s__YamanakaControl_count=s__YamanakaControl_count + 1
		call UnitDamageTarget(s__YamanakaControl_caster, s__YamanakaControl_target, 4 * GetHeroInt(s__YamanakaControl_caster, true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                //call StunUnitTimed(caster, target, 0.5)
		if s__YamanakaControl_count >= 3 then
			call TimerStart((NewTimerEx(0)), 0.1, false, function s__YamanakaControl_finish) // INLINED!!
		endif
 endfunction 

 function s__YamanakaControl_disable takes nothing returns nothing
		call SetPlayerAbilityAvailable(GetOwningPlayer(s__YamanakaControl_caster), 'A12Z', false)
		call UnitAddAbility(s__YamanakaControl_caster, 'A13I')
		call TimerStart((NewTimerEx(0)), 15.0, false, function s__YamanakaControl_finish) // INLINED!!
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__YamanakaControl_actions takes nothing returns nothing
		set s__YamanakaControl_caster=GetTriggerUnit()
		set s__YamanakaControl_target=GetSpellTargetUnit()
		set s__YamanakaControl_count=0
		call TimerStart((NewTimerEx(0)), 0.1, false, function s__YamanakaControl_disable) // INLINED!!
 endfunction 

 function s__YamanakaControl_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2(('A12Z' ) , Filter(( function s__YamanakaControl_actions))) // INLINED!!
		call RegisterSpellEffectEvent2(('A13I' ) , Filter(( function s__YamanakaControl_swap))) // INLINED!!
 endfunction 

//===========================================================================
// Trigger: YamatoCage
//===========================================================================

function Trig_YamatoCage_Conditions takes nothing returns boolean
	return ( ( GetSpellAbilityId() == 'A04J' ) )
endfunction

function Trig_YamatoCage_Func007001003001 takes nothing returns boolean
	return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_YamatoCage_Func007001003002 takes nothing returns boolean
	return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) )
endfunction

function Trig_YamatoCage_Func007001003 takes nothing returns boolean
	return GetBooleanAnd(( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false ), ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) ))
endfunction

function Trig_YamatoCage_Func007A takes nothing returns nothing
	//call GroupAddUnit(udg_YamatoCageUnits, GetEnumUnit()) 
	call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), ( ( 30.00 * I2R(GetUnitAbilityLevel(GetTriggerUnit(), 'A04J')) ) + ( ( 1 + ( 0.20 * I2R(GetUnitAbilityLevel(GetTriggerUnit(), 'A04J')) ) ) * I2R(GetHeroInt(GetTriggerUnit(), true)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_YamatoCage_Cage takes nothing returns nothing
 local real x
 local real y
 local real angle
	set bj_lastCreatedGroup=CreateGroup()
	call GroupAddGroup(udg_YamatoCageUnits, bj_lastCreatedGroup)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		if GetDistance(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , GetLocationX(udg_location03) , GetLocationY(udg_location03)) > 300 then
			if not IsUnitPaused(bj_lastCreatedUnit) and not IsUnitHidden(bj_lastCreatedUnit) then
				set angle=Atan3(GetLocationX(udg_location03) , GetLocationY(udg_location03) , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit))
				set x=(((GetLocationX(udg_location03) )*1.0) + Cos((( angle )*1.0)) * (( 350)*1.0)) // INLINED!!
				set y=(((GetLocationY(udg_location03) )*1.0) + Sin((( angle )*1.0)) * (( 350)*1.0)) // INLINED!!
				call SetUnitX(bj_lastCreatedUnit, x)
				call SetUnitY(bj_lastCreatedUnit, y)
			else
				call GroupRemoveUnit(udg_YamatoCageUnits, bj_lastCreatedUnit)
			endif
		endif
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
endfunction 

function Trig_YamatoCage_Actions takes nothing returns nothing
	set udg_location03=GetSpellTargetLoc()
	call CreateNUnitsAtLoc(1, 'nbal', GetOwningPlayer(GetTriggerUnit()), udg_location03, GetUnitFacing(GetTriggerUnit()))
	call UnitApplyTimedLifeBJ(1.50, 'BTLF', bj_lastCreatedUnit)
	set udg_YamatoCage=bj_lastCreatedUnit
	set udg_Yamato=GetTriggerUnit()
        call SetUnitPathing(udg_Yamato, false)
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=10
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations07[1994]=PolarProjectionBJ(udg_location03, 200.00, GetUnitFacing(GetTriggerUnit()))
		set udg_locations07[1995]=PolarProjectionBJ(udg_locations07[1994], ( - 300.00 + ( 50.00 * I2R(bj_forLoopAIndex) ) ), ( GetUnitFacing(GetTriggerUnit()) + 90.00 ))
		set udg_destructables01[bj_forLoopAIndex]=CreateDestructableLoc('YTfb', udg_locations07[1995], 270.00, 1.00, 0)
call AddSpecialEffectLocBJ((udg_locations07[1995] ), ( "Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations07[1994])
		call RemoveLocation(udg_locations07[1995])
		set udg_locations07[1994]=PolarProjectionBJ(udg_location03, 200.00, ( GetUnitFacing(GetTriggerUnit()) - 180.00 ))
		set udg_locations07[1995]=PolarProjectionBJ(udg_locations07[1994], ( - 300.00 + ( 50.00 * I2R(bj_forLoopAIndex) ) ), ( GetUnitFacing(GetTriggerUnit()) - 90.00 ))
		set udg_destructables03[bj_forLoopAIndex]=CreateDestructableLoc('YTfb', udg_locations07[1995], 270.00, 1.00, 0)
call AddSpecialEffectLocBJ((udg_locations07[1995] ), ( "Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations07[1994])
		call RemoveLocation(udg_locations07[1995])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=8
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations07[1994]=PolarProjectionBJ(udg_location03, 250.00, ( GetUnitFacing(GetTriggerUnit()) + 90.00 ))
		set udg_locations07[1995]=PolarProjectionBJ(udg_locations07[1994], ( - 250.00 + ( 50.00 * I2R(bj_forLoopAIndex) ) ), GetUnitFacing(GetTriggerUnit()))
		set udg_destructables04[bj_forLoopAIndex]=CreateDestructableLoc('YTfb', udg_locations07[1995], 270.00, 1.00, 0)
call AddSpecialEffectLocBJ((udg_locations07[1995] ), ( "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations07[1994])
		call RemoveLocation(udg_locations07[1995])
		set udg_locations07[1994]=PolarProjectionBJ(udg_location03, 250.00, ( GetUnitFacing(GetTriggerUnit()) - 90.00 ))
		set udg_locations07[1995]=PolarProjectionBJ(udg_locations07[1994], ( - 250.00 + ( 50.00 * I2R(bj_forLoopAIndex) ) ), ( GetUnitFacing(GetTriggerUnit()) - 180.00 ))
		set udg_destructables02[bj_forLoopAIndex]=CreateDestructableLoc('YTfb', udg_locations07[1995], 270.00, 1.00, 0)
call AddSpecialEffectLocBJ((udg_locations07[1995] ), ( "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations07[1994])
		call RemoveLocation(udg_locations07[1995])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	set bj_wantDestroyGroup=true
	call ForGroupBJ(GetUnitsInRangeOfLocMatching(300.00, udg_location03, Condition(function Trig_YamatoCage_Func007001003)), function Trig_YamatoCage_Func007A)
	call TriggerSleepAction(0.01)
	set udg_YamatoCageTimer=(NewTimerEx(0)) // INLINED!!
	//call TimerStart(udg_YamatoCageTimer, 0.03, true, function Trig_YamatoCage_Cage)
	//call SetPlayerAbilityAvailable(GetOwningPlayer(udg_Yamato), 'A04J', false)
	//call UnitAddAbility(udg_Yamato, 'A0TQ')
	call TriggerSleepAction(1.5)
	if not udg_YamatoRemoved then
		set bj_forLoopAIndex=1
		set bj_forLoopAIndexEnd=10
		loop
			exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
			call RemoveDestructable(udg_destructables01[bj_forLoopAIndex])
			call RemoveDestructable(udg_destructables03[bj_forLoopAIndex])
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set bj_forLoopAIndex=1
		set bj_forLoopAIndexEnd=8
