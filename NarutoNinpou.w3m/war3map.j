				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KimimaroKaramatsu_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
					call UnitDamageTarget(s__KimimaroKaramatsu_caster[this], bj_lastCreatedUnit, ( 50 + GetHeroStr(s__KimimaroKaramatsu_caster[this], true) / 2 ) * GetUnitAbilityLevel(s__KimimaroKaramatsu_caster[this], s__KimimaroKaramatsu_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
