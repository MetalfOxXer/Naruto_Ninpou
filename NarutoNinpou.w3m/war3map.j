// Trigger: MissionBRank
//===========================================================================
function GetHighestPlayerHeroLevel takes nothing returns integer
    local integer i= 0
    local integer maxLv= 1
    local unit h

    loop
        exitwhen i > 11
        set h=udg_units33[i + 1]
        if h != null and IsUnitType(h, UNIT_TYPE_HERO) then
            if GetHeroLevel(h) > maxLv then
                set maxLv=GetHeroLevel(h)
            endif
        endif
        set i=i + 1
    endloop

    set h=null
    return maxLv
endfunction

function NeedXPForLevel takes integer L returns integer
    return 200 + ( L * L ) + ( 100 * L )
endfunction

function TotalXPToReachLevel takes integer level returns integer
    local integer i= 1
    local integer sum= 0

    if level <= 1 then
        return 0
    endif

    loop
        exitwhen i >= level
        set sum=sum + NeedXPForLevel(i)
        set i=i + 1
    endloop

    return sum
endfunction

function ComputeAllowedXPToCapLevel takes unit h,integer capLv,integer xpAward returns integer
    local integer curXP
    local integer capXP
    local integer remaining

    if capLv <= 1 then
        return 0
    endif

    if GetHeroLevel(h) >= capLv then
        return 0
    endif

    set curXP=GetHeroXP(h)
    set capXP=TotalXPToReachLevel(capLv)
    set remaining=capXP - curXP

    if remaining <= 0 then
        return 0
    endif

    if xpAward > remaining then
        return remaining
    endif

    return xpAward
endfunction

function AddHeroXPSwappedCappedToMax takes integer xp,unit h,boolean show returns nothing
    local integer capLv
    local integer allowed

    if h == null or not IsUnitType(h, UNIT_TYPE_HERO) then
        return
    endif

    set capLv=GetHighestPlayerHeroLevel()
    set allowed=ComputeAllowedXPToCapLevel(h , capLv , xp)

    if allowed > 0 then
        call AddHeroXPSwapped(allowed, h, show)
    endif
endfunction

function Debug_XPTest takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer pid= GetPlayerId(p)
    local unit h= udg_units33[pid + 1]

    local integer capLv
    local integer curLv
    local integer curXP
    local integer capXP
    local integer remaining
    local integer allowed
    local integer award= 12500

    if h == null or not IsUnitType(h, UNIT_TYPE_HERO) then
        call DisplayTextToPlayer(p, 0, 0, "|cffff0000No hero found for this player.|r")
        return
    endif

    call DisplayTextToPlayer(p, 0, 0, "|cff00ff00=== SETTING VALUES ===|r")

    set capLv=20 //GetHighestPlayerHeroLevel()
    set curLv=GetHeroLevel(h)
    set curXP=GetHeroXP(h)
    set capXP=TotalXPToReachLevel(capLv)
    set remaining=capXP - curXP
    set allowed=ComputeAllowedXPToCapLevel(h , capLv , award)

    call DisplayTextToPlayer(p, 0, 0, "|cff00ff00=== XP TEST START ===|r")
    call DisplayTextToPlayer(p, 0, 0, "Current Lv: " + I2S(curLv))
    call DisplayTextToPlayer(p, 0, 0, "Current XP: " + I2S(curXP))
    call DisplayTextToPlayer(p, 0, 0, "Cap Lv: " + I2S(capLv))
    call DisplayTextToPlayer(p, 0, 0, "XP to Cap Lv: " + I2S(capXP))
    call DisplayTextToPlayer(p, 0, 0, "Remaining XP to Cap: " + I2S(remaining))
    call DisplayTextToPlayer(p, 0, 0, "XP Award Attempted: " + I2S(award))
    call DisplayTextToPlayer(p, 0, 0, "XP Allowed: " + I2S(allowed))

    if allowed > 0 then
        call AddHeroXPSwapped(allowed, h, true)
    endif

    call DisplayTextToPlayer(p, 0, 0, "New Lv: " + I2S(GetHeroLevel(h)))
    call DisplayTextToPlayer(p, 0, 0, "New XP: " + I2S(GetHeroXP(h)))
    call DisplayTextToPlayer(p, 0, 0, "|cff00ff00=== XP TEST END ===|r")

    set h=null
    set p=null
endfunction

function Init_Debug_XPTest takes nothing returns nothing
    local trigger t= CreateTrigger()
    local integer i= 0
    loop
        exitwhen i > 11
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-brank", true)
        set i=i + 1
    endloop
    call TriggerAddAction(t, function Debug_XPTest)
    set t=null
endfunction

