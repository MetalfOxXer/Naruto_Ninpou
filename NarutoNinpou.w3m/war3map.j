    function s__UtakataD_fade takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__UtakataD_count[this]=s__UtakataD_count[this] + 1
        call SetUnitVertexColor(s__UtakataD_bubble[this], 120, 200, 240, 200 - s__UtakataD_count[this] * 40)
        if s__UtakataD_count[this] == 5 then
            call KillUnit(s__UtakataD_bubble[this])
            set s__UtakataD_bubble[this]=null
            call s__UtakataD_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
