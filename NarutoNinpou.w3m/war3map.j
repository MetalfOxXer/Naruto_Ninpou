                call SetUnitVertexColor(s__KakashiNewSusanoo___Spell_caster[this], 255, 255, 255, 255)
            endif
            if s__KakashiNewSusanoo___Spell_count2[this] >= 25 * 33 or GetWidgetLife(s__KakashiNewSusanoo___Spell_caster[this]) < 0.405 then
                set kakashi_susanoo_active=false
