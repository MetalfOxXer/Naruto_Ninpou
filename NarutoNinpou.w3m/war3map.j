                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                set s__KabutoDoton___blocks[(this)*(1)+i]= CreateDestructable('YTpb', new_x, new_y, 0, 1.0, 1)
            endloop
            set bj_lastCreatedGroup=CreateGroup()
			set s__KabutoDoton___Spell_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KabutoDoton___Spell_target_x[this], s__KabutoDoton___Spell_target_y[this], 400, Filter(function s__KabutoDoton___Spell_dealDamage))
