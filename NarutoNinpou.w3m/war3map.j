            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SakuraGetLost_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__SakuraGetLost_damaged[this]) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and bj_lastCreatedUnit != s__SakuraGetLost_target[this] then
                call UnitDamageTarget(s__SakuraGetLost_caster[this], bj_lastCreatedUnit, GetHeroStr(s__SakuraGetLost_caster[this], true) * GetUnitAbilityLevel(s__SakuraGetLost_caster[this], s__SakuraGetLost_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__SakuraGetLost_damaged[this], bj_lastCreatedUnit)
