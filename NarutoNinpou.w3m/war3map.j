//Implemented from module Alloc:
    
        function s__KurenaiFlowerEscape_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KurenaiFlowerEscape_Alloc___recycle[(0)] == 0 ) then
                set s__KurenaiFlowerEscape_Alloc___instanceCount=s__KurenaiFlowerEscape_Alloc___instanceCount + 1
                set this=s__KurenaiFlowerEscape_Alloc___instanceCount
            else
                set this=s__KurenaiFlowerEscape_Alloc___recycle[(0)]
                set s__KurenaiFlowerEscape_Alloc___recycle[(0)]=s__KurenaiFlowerEscape_Alloc___recycle[s__KurenaiFlowerEscape_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KurenaiFlowerEscape_deallocate takes integer this returns nothing
            set s__KurenaiFlowerEscape_Alloc___recycle[this]=s__KurenaiFlowerEscape_Alloc___recycle[(0)]
            set s__KurenaiFlowerEscape_Alloc___recycle[(0)]=this
        endfunction
    
    function s__KurenaiFlowerEscape_destroy takes integer this returns nothing
        call PauseUnit(s__KurenaiFlowerEscape_caster[this], false)
        call ShowUnit(s__KurenaiFlowerEscape_caster[this], true)
        call SelectUnitForPlayerSingle(s__KurenaiFlowerEscape_caster[this], GetOwningPlayer(s__KurenaiFlowerEscape_caster[this]))
        call DestroyGroup(s__KurenaiFlowerEscape_damaged[this])
        call KillUnit(s__KurenaiFlowerEscape_dummy[this])
        set s__KurenaiFlowerEscape_dummy[this]=null
        set s__KurenaiFlowerEscape_caster[this]=null
        set s__KurenaiFlowerEscape_damaged[this]=null
        call s__KurenaiFlowerEscape_deallocate(this)
    endfunction
    
    function s__KurenaiFlowerEscape_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KurenaiFlowerEscape_caster[this])
        local real y= GetUnitY(s__KurenaiFlowerEscape_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__KurenaiFlowerEscape_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KurenaiFlowerEscape_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__KurenaiFlowerEscape_count[this]=s__KurenaiFlowerEscape_count[this] + 1
        call SetUnitX(s__KurenaiFlowerEscape_caster[this], new_x)
        call SetUnitY(s__KurenaiFlowerEscape_caster[this], new_y)
        call SetUnitX(s__KurenaiFlowerEscape_dummy[this], new_x)
        call SetUnitY(s__KurenaiFlowerEscape_dummy[this], new_y)

        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Senbonzakura.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KurenaiFlowerEscape_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__KurenaiFlowerEscape_damaged[this]) then
                call UnitDamageTarget(s__KurenaiFlowerEscape_caster[this], bj_lastCreatedUnit, GetHeroInt(s__KurenaiFlowerEscape_caster[this], true) * GetUnitAbilityLevel(s__KurenaiFlowerEscape_caster[this], s__KurenaiFlowerEscape_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__KurenaiFlowerEscape_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KurenaiFlowerEscape_count[this] >= s__KurenaiFlowerEscape_max_count[this] then
            call s__KurenaiFlowerEscape_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KurenaiFlowerEscape_actions takes nothing returns nothing
        local integer this= s__KurenaiFlowerEscape_allocate()
        set s__KurenaiFlowerEscape_caster[this]=GetTriggerUnit()
        set s__KurenaiFlowerEscape_damaged[this]=CreateGroup()
        set s__KurenaiFlowerEscape_count[this]=0
        set s__KurenaiFlowerEscape_angle[this]=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
        set s__KurenaiFlowerEscape_dummy[this]=CreateUnit(GetTriggerPlayer(), 'h00K', GetUnitX(s__KurenaiFlowerEscape_caster[this]), GetUnitY(s__KurenaiFlowerEscape_caster[this]), Rad2Deg(s__KurenaiFlowerEscape_angle[this]))
	set s__KurenaiFlowerEscape_max_count[this]=R2I(GetDistance(GetUnitX(s__KurenaiFlowerEscape_caster[this]) , GetUnitY(s__KurenaiFlowerEscape_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) / 25)
        call PauseUnit(s__KurenaiFlowerEscape_caster[this], true)
        call ShowUnit(s__KurenaiFlowerEscape_caster[this], false)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KurenaiFlowerEscape_periodic)
    endfunction
    
    function s__KurenaiFlowerEscape_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(63 , s__KurenaiFlowerEscape_SPELL_ID , function s__KurenaiFlowerEscape_actions)
    endfunction
    
