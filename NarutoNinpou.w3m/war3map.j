//Implemented from module Alloc:
    
        function s__ToruneSemi__Item_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ToruneSemi__Item_Alloc___recycle[(0)] == 0 ) then
