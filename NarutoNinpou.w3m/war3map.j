    function s__KurenaiUltimate_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KurenaiUltimate_caster[s__KurenaiUltimate_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            call UnitDamageTarget(s__KurenaiUltimate_caster[s__KurenaiUltimate_instance], GetFilterUnit(), 1000, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
    endfunction 

    function s__KurenaiUltimate_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real x
 local real y
        local integer i
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KurenaiUltimate_caster_x[this], s__KurenaiUltimate_caster_y[this], 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KurenaiUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call UnitDamageTarget(s__KurenaiUltimate_caster[this], bj_lastCreatedUnit, 8.0 * GetHeroInt(s__KurenaiUltimate_caster[this], true) / 80, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KurenaiUltimate_count[this]=s__KurenaiUltimate_count[this] + 1
        if s__KurenaiUltimate_count[this] > 80 then
            call SetUnitX(s__KurenaiUltimate_dummy[this], 11705)
            call SetUnitY(s__KurenaiUltimate_dummy[this], 8008)
            call BlzSetSpecialEffectX(s__KurenaiUltimate_KurenaiFlower[this], GetUnitX(s__KurenaiUltimate_dummy[this]))
            call BlzSetSpecialEffectY(s__KurenaiUltimate_KurenaiFlower[this], GetUnitY(s__KurenaiUltimate_dummy[this]))
			call BlzSetSpecialEffectX(s__KurenaiUltimate_pinkflowers[this], GetUnitX(s__KurenaiUltimate_dummy[this]))
            call BlzSetSpecialEffectY(s__KurenaiUltimate_pinkflowers[this], GetUnitY(s__KurenaiUltimate_dummy[this]))
            set bj_lastCreatedEffect=AddSpecialEffect("LW10.mdl", s__KurenaiUltimate_caster_x[this], s__KurenaiUltimate_caster_y[this])
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.5)
            call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
            call DestroyEffect(bj_lastCreatedEffect)

            set bj_lastCreatedGroup=CreateGroup()
            set s__KurenaiUltimate_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KurenaiUltimate_caster_x[this], s__KurenaiUltimate_caster_y[this], 400, Filter(function s__KurenaiUltimate_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            call BlzSetSpecialEffectTimeScale(s__KurenaiUltimate_KurenaiFlower[this], 0.6)
            call DestroyEffect(s__KurenaiUltimate_KurenaiFlower[this])
            set s__KurenaiUltimate_KurenaiFlower[this]=null
			call DestroyEffect(s__KurenaiUltimate_pinkflowers[this])
            set s__KurenaiUltimate_pinkflowers[this]=null
            set i=0
            loop
                exitwhen i > 5
            	call BlzSetSpecialEffectX(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], GetUnitX(s__KurenaiUltimate_dummy[this]))
            	call BlzSetSpecialEffectY(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], GetUnitY(s__KurenaiUltimate_dummy[this]))
                call DestroyEffect(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i])
                set s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i]=null
                set i=i + 1
            endloop
            //call SetUnitInvulnerable(this.caster, false)
            call KillUnit(s__KurenaiUltimate_dummy[this])
            set s__KurenaiUltimate_dummy[this]=null
            call s__KurenaiUltimate_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KurenaiUltimate_actions takes nothing returns nothing
        local integer this= s__KurenaiUltimate__allocate()
        local integer i
        local real x
        local real y
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Kurenai_R, 100.0, GetTriggerUnit())
        endif
        set s__KurenaiUltimate_caster[this]=GetTriggerUnit()
        set s__KurenaiUltimate_caster_x[this]=GetUnitX(s__KurenaiUltimate_caster[this])
        set s__KurenaiUltimate_caster_y[this]=GetUnitY(s__KurenaiUltimate_caster[this])
        set s__KurenaiUltimate_count[this]=0
        set s__KurenaiUltimate_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__KurenaiUltimate_caster[this]), GetUnitY(s__KurenaiUltimate_caster[this]), 270)
        call SlowAura(s__KurenaiUltimate_dummy[this] , 0.3 , 400)
        set s__KurenaiUltimate_KurenaiFlower[this]=AddSpecialEffect("jn_zx_lianhua.mdl", GetUnitX(s__KurenaiUltimate_caster[this]), GetUnitY(s__KurenaiUltimate_caster[this]))
        call BlzSetSpecialEffectScale(s__KurenaiUltimate_KurenaiFlower[this], 2.0)
        call BlzSetSpecialEffectHeight(s__KurenaiUltimate_KurenaiFlower[this], 100 + GetPointZ(GetUnitX(s__KurenaiUltimate_caster[this]) , GetUnitY(s__KurenaiUltimate_caster[this])))
        //call BlzSetSpecialEffectPitch(this.KurenaiFlower, 1.57)
        call BlzSetSpecialEffectTimeScale(s__KurenaiUltimate_KurenaiFlower[this], 2.0)
        call BlzPlaySpecialEffect(s__KurenaiUltimate_KurenaiFlower[this], ANIM_TYPE_BIRTH)
        set i=0
        loop
            exitwhen i > 5
            set x=(((GetUnitX(s__KurenaiUltimate_caster[this]) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 250)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__KurenaiUltimate_caster[this]) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 250)*1.0)) // INLINED!!
            set s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i]=AddSpecialEffect("jn_zx_lianhua.mdl", x, y)
            call BlzSetSpecialEffectScale(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], 1.2)
            call BlzSetSpecialEffectHeight(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], 70 + GetPointZ(GetUnitX(s__KurenaiUltimate_caster[this]) , GetUnitY(s__KurenaiUltimate_caster[this])))
            //call BlzSetSpecialEffectPitch(flowers[i], 1.57)
            call BlzSetSpecialEffectTimeScale(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], 3.0)
            call BlzPlaySpecialEffect(s___KurenaiUltimate_flowers[s__KurenaiUltimate_flowers[this]+i], ANIM_TYPE_BIRTH)
            set i=i + 1
        endloop
            //call SetUnitInvulnerable(this.caster, true)
		set x=(((s__KurenaiUltimate_caster_x[this] )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 150))*1.0)) // INLINED!!
		set y=(((s__KurenaiUltimate_caster_y[this] )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 150))*1.0)) // INLINED!!
		set s__KurenaiUltimate_pinkflowers[this]=AddSpecialEffect("PinkLeaves.mdx", s__KurenaiUltimate_caster_x[this], s__KurenaiUltimate_caster_y[this])
		call BlzSetSpecialEffectHeight(s__KurenaiUltimate_pinkflowers[this], - 250)
		call BlzSetSpecialEffectScale(s__KurenaiUltimate_pinkflowers[this], 0.7)
		call BlzSetSpecialEffectTimeScale(s__KurenaiUltimate_pinkflowers[this], 3.0)

        call TimerStart(NewTimerEx(this), 0.02, true, function s__KurenaiUltimate_damage)
    endfunction
    
    function s__KurenaiUltimate_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(63 , s__KurenaiUltimate_SPELL_ID , function s__KurenaiUltimate_actions)
    endfunction

