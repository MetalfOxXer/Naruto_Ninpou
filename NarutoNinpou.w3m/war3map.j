            endif

    
            return this
        endfunction
    
        function s__NagatoShuradou_deallocate takes integer this returns nothing
            set s__NagatoShuradou_Alloc___recycle[this]=s__NagatoShuradou_Alloc___recycle[(0)]
            set s__NagatoShuradou_Alloc___recycle[(0)]=this
        endfunction
    
    function s__NagatoShuradou_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local group damaged= CreateGroup()
        local real caster_x= GetUnitX(s__NagatoShuradou_caster[this])
        local real caster_y= GetUnitY(s__NagatoShuradou_caster[this])
        local real angle= Deg2Rad(GetUnitFacing(s__NagatoShuradou_caster[this]))
        local real new_x= caster_x + Cos(angle) * 100
        local real new_y= caster_y + Sin(angle) * 100
        local real new_x_2
        local real new_y_2
        local integer i
        set i=1
        loop
            exitwhen i > 10
            set new_x_2=new_x + Cos(angle) * ( 100 * i )
            set new_y_2=new_y + Sin(angle) * ( 100 * i )
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x_2, new_y_2, 220.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NagatoShuradou_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                    call UnitDamageTarget(s__NagatoShuradou_caster[this], bj_lastCreatedUnit, 4 * GetHeroInt(s__NagatoShuradou_caster[this], true) + 600 * GetUnitAbilityLevel(s__NagatoShuradou_caster[this], s__NagatoShuradou_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    call GroupAddUnit(damaged, bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=i + 1
        endloop
        call DestroyGroup(damaged)
        call PauseUnit(s__NagatoShuradou_caster[this], false)
	call SetUnitTimeScale(s__NagatoShuradou_caster[this], 1.0)
        set damaged=null
        set s__NagatoShuradou_caster[this]=null
        call s__NagatoShuradou_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__NagatoShuradou_actions takes nothing returns nothing
        local integer this= s__NagatoShuradou_allocate()
        local real caster_x= GetUnitX(GetTriggerUnit())
        local real caster_y= GetUnitY(GetTriggerUnit())
        local real target_x= GetSpellTargetX()
        local real target_y= GetSpellTargetY()
        local real angle= Atan2(( target_y - caster_y ), ( target_x - caster_x ))
        local real new_x= caster_x + Cos(angle) * 100
        local real new_y= caster_y + Sin(angle) * 100
        set s__NagatoShuradou_caster[this]=GetTriggerUnit()
        call PauseUnit(s__NagatoShuradou_caster[this], true)
	call SetUnitTimeScale(s__NagatoShuradou_caster[this], 2.5)
        call SetUnitAnimation(s__NagatoShuradou_caster[this], "spell three")
        call SetUnitFacing(s__NagatoShuradou_caster[this], Rad2Deg(angle))
	set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Ion_Cannon.mdl", new_x, new_y)
	call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
	call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 150 + GetPointZ(new_x , new_y))
	call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 6.3)
	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.75)*1.0) , false) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.75, false, function s__NagatoShuradou_damage)
    endfunction
    
    function s__NagatoShuradou_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(10 , s__NagatoShuradou_SPELL_ID , function s__NagatoShuradou_actions)
    endfunction
    
