            call UnitDamageTarget(HiruzenCore_Hiruzen, GetFilterUnit(), ( ( GetHeroStr(HiruzenCore_Hiruzen, true) ) + 800 ) * GetUnitAbilityLevel(HiruzenCore_Hiruzen, s__HiruzenShurikenKageBunshin_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(GetFilterUnit()) )*1.0), (( GetUnitY(GetFilterUnit()))*1.0))) // INLINED!!
