        call SetUnitScale(s__HagoromoE_instanceFireball[this], 0.01, 0.01, 0.01)
        call SetUnitAnimationByIndex(s__HagoromoE_caster[this], 16)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoE_periodic)
    endfunction 
