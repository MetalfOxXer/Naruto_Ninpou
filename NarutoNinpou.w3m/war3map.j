            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__AsumaAssault_count[this]=s__AsumaAssault_count[this] + 1
            if s__AsumaAssault_count[this] >= 20 then
            	call UnitRemoveAbility(s__AsumaAssault_caster[this], 'A032')
                call KillUnit(s__AsumaAssault_effect1[this])
                call KillUnit(s__AsumaAssault_effect2[this])
                call ShowUnit(s__AsumaAssault_effect1[this], false)
                call ShowUnit(s__AsumaAssault_effect2[this], false)
                set s__AsumaAssault_effect1[this]=null
                set s__AsumaAssault_effect2[this]=null
                call DestroyGroup(s__AsumaAssault_damaged[this])
                set s__AsumaAssault_damaged[this]=null
                call s__AsumaAssault_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
