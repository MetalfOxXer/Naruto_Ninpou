function IsSafe2 takes real x,real y,real range returns boolean
    local integer i
    local integer j
    local real new_x
    local real new_y
    if IsVisibleToPlayer(x, y, GetLocalPlayer()) then
        return false
    endif
    return true
endfunction

function IsSafe takes real x,real y,real range returns boolean
    local integer i
    local integer j
    local real new_x
    local real new_y
    if IsVisibleToPlayer(x, y, GetLocalPlayer()) then
        return false
    endif
    return true
endfunction

