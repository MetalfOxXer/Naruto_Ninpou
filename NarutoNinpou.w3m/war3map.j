//===========================================================================
function InitTrig_SuperBootsSpeedBuff takes nothing returns nothing
    local trigger t1= CreateTrigger()
    local trigger t2= CreateTrigger()
    local trigger t3= CreateTrigger()
    local trigger t4= CreateTrigger()
    local trigger t5= CreateTrigger()
    local trigger t6= CreateTrigger()

    call TriggerRegisterLeaveRectSimple(t1, gg_rct_MainBaseKonohagakure)
    call TriggerAddCondition(t1, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Konoha))
    call TriggerAddAction(t1, function Trig_SuperBootsSpeedBuff_Actions)

    call TriggerRegisterLeaveRectSimple(t2, gg_rct_MainBaseOtogakure)
    call TriggerAddCondition(t2, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Evil))
    call TriggerAddAction(t2, function Trig_SuperBootsSpeedBuff_Actions)

    call TriggerRegisterLeaveRectSimple(t3, gg_rct_MainBaseAkatsuki)
    call TriggerAddCondition(t3, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Akatsuki))
    call TriggerAddAction(t3, function Trig_SuperBootsSpeedBuff_Actions)

    call TriggerRegisterLeaveRectSimple(t4, gg_rct_Base_Konohagakure)
    call TriggerAddCondition(t4, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Konoha2))
    call TriggerAddAction(t4, function Trig_SuperBootsSpeedBuff_Actions)

    call TriggerRegisterLeaveRectSimple(t5, gg_rct_Base_Akatsuki)
    call TriggerAddCondition(t5, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Akatsuki2))
    call TriggerAddAction(t5, function Trig_SuperBootsSpeedBuff_Actions)

    call TriggerRegisterLeaveRectSimple(t6, gg_rct_Base_Otogakure)
    call TriggerAddCondition(t6, Condition(function Trig_SuperBootsSpeedBuff_Conditions_Evil2))
    call TriggerAddAction(t6, function Trig_SuperBootsSpeedBuff_Actions)
endfunction


