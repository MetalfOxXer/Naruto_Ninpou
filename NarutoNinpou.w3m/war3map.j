    function s__TobiramaNewR_hide takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__TobiramaNewR_count[this]=s__TobiramaNewR_count[this] + 1
        call SetUnitVertexColor(s__TobiramaNewR_domo[this], 255, 255, 255, 255 - 13 * s__TobiramaNewR_count[this])
        if s__TobiramaNewR_count[this] >= 20 then
            call RecycleUnit(s__TobiramaNewR_domo[this])
            set s__TobiramaNewR_domo[this]=null
            call s__TobiramaNewR_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
	
    
    function s__TobiramaNewR_damagenumunits takes nothing returns boolean
	    if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__TobiramaNewR_caster[s__TobiramaNewR_instance])) then
                call UnitDamageTarget(s__TobiramaNewR_caster[s__TobiramaNewR_instance], GetFilterUnit(), 800 * GetUnitAbilityLevel(s__TobiramaNewR_caster[s__TobiramaNewR_instance], s__TobiramaNewR_SPELL_ID) + GetHeroAgi(s__TobiramaNewR_caster[s__TobiramaNewR_instance], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
	    return false
    endfunction
    

    function s__TobiramaNewR_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
	set s__TobiramaNewR_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__TobiramaNewR_domo[this]), GetUnitY(s__TobiramaNewR_domo[this]), 700, Filter(function s__TobiramaNewR_damagenumunits))
        call DestroyGroup(bj_lastCreatedGroup)
        set s__TobiramaNewR_count[this]=0
        call ShowUnit(s__TobiramaNewR_caster[this], true)
        call SelectUnitForPlayerSingle(s__TobiramaNewR_caster[this], GetOwningPlayer(s__TobiramaNewR_caster[this]))
        call TimerStart(NewTimerEx(this), 0.03, true, function s__TobiramaNewR_hide)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__TobiramaNewR_grow takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real alpha
        local integer i= 0
        set s__TobiramaNewR_count[this]=s__TobiramaNewR_count[this] + 1
        if s__TobiramaNewR_count[this] < 20 then
            call SetUnitScale(s__TobiramaNewR_domo[this], 0.65 * s__TobiramaNewR_count[this], 0.65 * s__TobiramaNewR_count[this], 0.65 * s__TobiramaNewR_count[this])
            call SetUnitVertexColor(s__TobiramaNewR_domo[this], 0, 0, 0, 13 * s__TobiramaNewR_count[this])
        endif
        if s__TobiramaNewR_count[this] == 30 then
            call CreateTextTagUnitBJ("!", s__TobiramaNewR_caster[this], 0, 10, 100, 100, 100, 0)
            call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
            call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 3.00)
            call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 1.50)
            call SetTextTagAgeBJ(GetLastCreatedTextTag(), 3.00)
            if not IsUnitVisible(s__TobiramaNewR_caster[this], GetLocalPlayer()) then
                call SetTextTagVisibility(GetLastCreatedTextTag(), false)
            endif
            call ShowUnit(s__TobiramaNewR_caster[this], false)
        endif
        if s__TobiramaNewR_count[this] > 40 then
            loop
                exitwhen i > 11
                if IsPlayerEnemy(Player(i), GetOwningPlayer(s__TobiramaNewR_caster[this])) and GetDistanceUnits(udg_units33[i + 1] , s__TobiramaNewR_caster[this]) < 300 then
                    set s__TobiramaDarkness__show[i]= true
                else
                    set s__TobiramaDarkness__show[i]= false
                endif
                set i=i + 1
            endloop
            set alpha=100
            if s__TobiramaDarkness__show[GetPlayerId(GetLocalPlayer())] then
                set alpha=0
            endif
            //call CinematicFadeBJ(2,3.00,"ReplaceableTextures\\CameraMasks\\White_mask.blp",0,0,0,alpha)
            call TimerStart(NewTimerEx(this), 0.05, false, function s__TobiramaNewR_damage)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__TobiramaNewR_actions takes nothing returns nothing
        local integer this= s__TobiramaNewR_allocate()
        local integer i= 0
        loop
            exitwhen i > 11
            set s__TobiramaDarkness__show[i]= false
            set i=i + 1
        endloop
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Tobirama_R, 100, GetTriggerUnit())
        endif
        set s__TobiramaNewR_caster[this]=GetTriggerUnit()
        set s__TobiramaNewR_count[this]=0
        set s__TobiramaNewR_domo[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h02X' ), (( GetUnitX(s__TobiramaNewR_caster[this]) )*1.0), (( GetUnitY(s__TobiramaNewR_caster[this]) )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(s__TobiramaNewR_domo[this], 0, 0, 0)
        call SetUnitVertexColor(s__TobiramaNewR_domo[this], 0, 0, 0, 0)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__TobiramaNewR_grow)
    endfunction 
    
    function s__TobiramaNewR_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(34 , s__TobiramaNewR_SPELL_ID , function s__TobiramaNewR_actions)
    endfunction 
    

