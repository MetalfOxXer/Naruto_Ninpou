    function s__GaaraShukakuClaws_fall takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        call SetUnitFlyHeight(u, 0, 2100)
