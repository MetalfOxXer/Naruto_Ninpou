    //private static boolean picked = false 
    
    function s__KaguyaUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__KaguyaUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KaguyaUltimateChoice_caster[this]), 'A0TW', false)
        else
            call s__KaguyaUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KaguyaUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__KaguyaUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__KaguyaUltimateChoice_u, s__KaguyaUltimateChoice_GUDODAMA)
            call UnitMakeAbilityPermanent(s__KaguyaUltimateChoice_u, true, s__KaguyaUltimateChoice_GUDODAMA)
        else
            call UnitAddAbility(s__KaguyaUltimateChoice_u, s__KaguyaUltimateChoice_DIMENSIONTRAVEL)
            call UnitMakeAbilityPermanent(s__KaguyaUltimateChoice_u, true, s__KaguyaUltimateChoice_DIMENSIONTRAVEL)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0TW', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0TW', false)
        set s__s__KaguyaUltimateChoice_b[0]= null
        set s__s__KaguyaUltimateChoice_b[1]= null
        set s__KaguyaUltimateChoice_u=null
        call s__Dialog_destroy(s__KaguyaUltimateChoice_d)
        call DestroyBoolExpr(s__KaguyaUltimateChoice_pick)
        set s__KaguyaUltimateChoice_pick=null
        set this=s__KaguyaUltimateChoice_allocate()
        set s__KaguyaUltimateChoice_caster[this]=s__KaguyaUltimateChoice_u
        set s__KaguyaUltimateChoice_pp[this]=GetOwningPlayer(s__KaguyaUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__KaguyaUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__KaguyaUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__KaguyaUltimateChoice_GUDODAMA) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__KaguyaUltimateChoice_DIMENSIONTRAVEL) == 0 then
            set s__KaguyaUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__KaguyaUltimateChoice_d,"Pick a skill")
            set s__s__KaguyaUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__KaguyaUltimateChoice_d)], ("Bocho Gudodama" ), ( 0))) // INLINED!!
            set s__s__KaguyaUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__KaguyaUltimateChoice_d)], ("Dimension Travel" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__KaguyaUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__KaguyaUltimateChoice_d,s__KaguyaUltimateChoice_pick)
            set s__KaguyaUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__KaguyaUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0TW' then
            set s__KaguyaUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__KaguyaUltimateChoice_onInit takes nothing returns nothing
        set s__KaguyaUltimateChoice_pick=Condition(function s__KaguyaUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__KaguyaUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0TW' ) , Filter(( function s__KaguyaUltimateChoice_actions))) // INLINED!!
    endfunction 
    
