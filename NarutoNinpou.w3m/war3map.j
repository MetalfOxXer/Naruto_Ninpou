//Implemented from module Alloc:
    
        function s__KidomaruUltimate_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KidomaruUltimate_Alloc___recycle[(0)] == 0 ) then
                set s__KidomaruUltimate_Alloc___instanceCount=s__KidomaruUltimate_Alloc___instanceCount + 1
                set this=s__KidomaruUltimate_Alloc___instanceCount
            else
                set this=s__KidomaruUltimate_Alloc___recycle[(0)]
                set s__KidomaruUltimate_Alloc___recycle[(0)]=s__KidomaruUltimate_Alloc___recycle[s__KidomaruUltimate_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KidomaruUltimate_deallocate takes integer this returns nothing
            set s__KidomaruUltimate_Alloc___recycle[this]=s__KidomaruUltimate_Alloc___recycle[(0)]
            set s__KidomaruUltimate_Alloc___recycle[(0)]=this
        endfunction

    function s__KidomaruUltimate_destroy takes integer this returns nothing
        call KillUnit(s__KidomaruUltimate_arrow[this])
        call ShowUnit(s__KidomaruUltimate_arrow[this], false)
        set s__KidomaruUltimate_arrow[this]=null
        call DestroyGroup(s__KidomaruUltimate_damaged[this])
        set s__KidomaruUltimate_damaged[this]=null
        call s__KidomaruUltimate_deallocate(this)
    endfunction 

    function s__KidomaruUltimate_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KidomaruUltimate_arrow[this])
        local real y= GetUnitY(s__KidomaruUltimate_arrow[this])
        local real new_x= (((x )*1.0) + Cos((( s__KidomaruUltimate_angle[this] )*1.0)) * (( RMinBJ(100, 30 + 2 * s__KidomaruUltimate_count[this]))*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KidomaruUltimate_angle[this] )*1.0)) * (( RMinBJ(100, 30 + 2 * s__KidomaruUltimate_count[this]))*1.0)) // INLINED!!
        call SetUnitX(s__KidomaruUltimate_arrow[this], new_x)
        call SetUnitY(s__KidomaruUltimate_arrow[this], new_y)
        set s__KidomaruUltimate_count[this]=s__KidomaruUltimate_count[this] + 1
        set s__KidomaruUltimate_distance[this]=s__KidomaruUltimate_distance[this] + RMinBJ(100, 30 + 2 * s__KidomaruUltimate_count[this])
        if ModuloInteger(s__KidomaruUltimate_count[this], 3) == 0 then
            set bj_lastCreatedEffect=AddSpecialEffect("DustWaveGeneric.mdx", new_x, new_y)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__KidomaruUltimate_angle[this])
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 100 + GetPointZ(new_x , new_y))
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        if not RectContainsUnit(gg_rct_NinpouArea, s__KidomaruUltimate_arrow[this]) or s__KidomaruUltimate_count[this] > 220 then
            call s__KidomaruUltimate_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        else
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if not IsUnitIllusion(bj_lastCreatedUnit) and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KidomaruUltimate_caster[this])) and UnitAlive(bj_lastCreatedUnit) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and not IsUnitInGroup(bj_lastCreatedUnit, s__KidomaruUltimate_damaged[this]) then
                call GroupAddUnit(s__KidomaruUltimate_damaged[this], bj_lastCreatedUnit)
                	if RectContainsUnit(gg_rct_DuelArena, bj_lastCreatedUnit) and not RectContainsUnit(gg_rct_DuelArena, s__KidomaruUltimate_caster[this]) then
                        elseif RectContainsUnit(gg_rct_MissionB, bj_lastCreatedUnit) and ( s__KidomaruUltimate_caster[this] != udg_MissionBUnit ) then
			elseif RectContainsUnit(gg_rct_MissionA, bj_lastCreatedUnit) and ( s__KidomaruUltimate_caster[this] != udg_MissionAUnit ) then
			elseif RectContainsUnit(gg_rct_MissionS, bj_lastCreatedUnit) and ( s__KidomaruUltimate_caster[this] != udg_MissionSUnit ) then
                    else
                    	call UnitDamageTarget(s__KidomaruUltimate_caster[this], bj_lastCreatedUnit, ( ( 8 - 4 * s__KidomaruUltimate_hits[this] ) + RMinBJ(5000, s__KidomaruUltimate_distance[this]) / 1000 ) * GetHeroAgi(s__KidomaruUltimate_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			call StunUnitTimed(s__KidomaruUltimate_arrow[this] , bj_lastCreatedUnit , IMaxBJ(R2I(RMinBJ(5000, s__KidomaruUltimate_distance[this]) / 1250), 1))
			set s__KidomaruUltimate_hits[this]=s__KidomaruUltimate_hits[this] + 1
		    	set bj_lastCreatedEffect=AddSpecialEffect("DustWave.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
                    	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
                    	call DestroyEffect(bj_lastCreatedEffect)
                    	call DestroyEffect(AddSpecialEffect(("war3mapImported\\WarStompCaster.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    endif
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
    endfunction 

    function s__KidomaruUltimate_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitTimeScale(s__KidomaruUltimate_caster[this], 1.0)
        call PauseUnit(s__KidomaruUltimate_caster[this], false)
        set s__KidomaruUltimate_arrow[this]=CreateUnit(GetOwningPlayer(s__KidomaruUltimate_caster[this]), 'h04O', GetUnitX(s__KidomaruUltimate_caster[this]), GetUnitY(s__KidomaruUltimate_caster[this]), Rad2Deg(s__KidomaruUltimate_angle[this]))
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KidomaruUltimate_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__KidomaruUltimate_actions takes nothing returns nothing
        local integer this= s__KidomaruUltimate_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Kidomaru_T, 100, GetTriggerUnit())
        endif
        set s__KidomaruUltimate_caster[this]=GetTriggerUnit()
        set s__KidomaruUltimate_damaged[this]=CreateGroup()
	set s__KidomaruUltimate_hits[this]=0
        set s__KidomaruUltimate_angle[this]=Atan3(GetUnitX(s__KidomaruUltimate_caster[this]) , GetUnitY(s__KidomaruUltimate_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__KidomaruUltimate_count[this]=0
        set s__KidomaruUltimate_distance[this]=0
        call PauseUnit(s__KidomaruUltimate_caster[this], true)
        call SetUnitTimeScale(s__KidomaruUltimate_caster[this], 2.0)
        call SetUnitAnimation(s__KidomaruUltimate_caster[this], "spell five")
        call TimerStart(NewTimerEx(this), 0.3, false, function s__KidomaruUltimate_delay)
    endfunction 

    function s__KidomaruUltimate_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(88 , s__KidomaruUltimate_SPELL_ID , function s__KidomaruUltimate_actions)
    endfunction

//===========================================================================
// Trigger: KidomaruCursedSealLevel
//===========================================================================

    function s__KidomaruCursedSealLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A1A0') == 0 and GetUnitTypeId(u) != 'H053' and GetUnitAbilityLevel(u, 'A19T') == 10 and GetUnitAbilityLevel(u, 'A19U') == 10 and GetUnitAbilityLevel(u, 'A19V') == 10 and GetUnitAbilityLevel(u, 'A0OI') == 1 then
                call UnitRemoveAbility(u, 'A19X')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A19X', false)
                call UnitAddAbility(u, 'A1A0')
		call UnitAddAbility(u, 'A169')
		call BlzSetUnitWeaponIntegerFieldBJ(u, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__KidomaruCursedSealLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H044' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__KidomaruCursedSealLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__KidomaruCursedSealLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'H053' or GetUnitTypeId(GetTriggerUnit()) == 'H044' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A19X', true)
        endif
    endfunction

    function s__KidomaruCursedSealLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__KidomaruCursedSealLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__KidomaruCursedSealLevel_death))) // INLINED!!
    endfunction 

