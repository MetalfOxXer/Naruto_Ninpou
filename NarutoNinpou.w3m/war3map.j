        set i=1
        loop
            exitwhen i > 12
		    call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, udg_Repick_Names[i])
            set i=i + 1
        endloop
    endfunction 


    function s__DisplayRepickName_onInit takes nothing returns nothing
        local trigger t= CreateTrigger()
        local integer i= 0
        loop
            exitwhen i > 11
            if i != 3 and i != 7 and i != 11 then
                call TriggerRegisterPlayerChatEvent(t, Player(i), "-NameDisplay", true)
