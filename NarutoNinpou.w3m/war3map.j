    function s__JiroboCursedSealLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A0IK') == 0 and GetUnitTypeId(u) != 'H05F' and GetUnitAbilityLevel(u, 'A1AL') == 10 and GetUnitAbilityLevel(u, 'A1AM') == 10 and GetUnitAbilityLevel(u, 'A1AN') == 10 and GetUnitAbilityLevel(u, 'A0G0') == 1 then
                call UnitRemoveAbility(u, 'A1AO')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A1AO', false)
                call UnitAddAbility(u, 'A0IK')
		call UnitAddAbility(u, 'A15Q')
		call BlzSetUnitWeaponIntegerFieldBJ(u, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__JiroboCursedSealLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H05E' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__JiroboCursedSealLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__JiroboCursedSealLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'H05F' or GetUnitTypeId(GetTriggerUnit()) == 'H05E' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A1AO', true)
        endif
    endfunction

    function s__JiroboCursedSealLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__JiroboCursedSealLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__JiroboCursedSealLevel_death))) // INLINED!!
    endfunction 

