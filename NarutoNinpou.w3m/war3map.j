    function s__NejiCounterattack_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__NejiCounterattack_target[this]=null
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NejiCounterattack_domo[this]), GetUnitY(s__NejiCounterattack_domo[this]), 600, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NejiCounterattack_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                if s__NejiCounterattack_target[this] == null or GetWidgetLife(bj_lastCreatedUnit) < GetWidgetLife(s__NejiCounterattack_target[this]) then
                    set s__NejiCounterattack_target[this]=bj_lastCreatedUnit
                endif
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__NejiCounterattack_target[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NejiCounterattack_caster[this]), s__NejiCounterattack_SPELL_ID, false)
            call UnitAddAbility(s__NejiCounterattack_caster[this], s__NejiCounterattack_SPELL_ID_2)
        else
            call UnitRemoveAbility(s__NejiCounterattack_caster[this], s__NejiCounterattack_SPELL_ID_2)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NejiCounterattack_caster[this]), s__NejiCounterattack_SPELL_ID, true)
        endif
        set s__NejiCounterattack_count[this]=s__NejiCounterattack_count[this] + 1
        if s__NejiCounterattack_count[this] >= 50 + 5 * GetUnitAbilityLevel(s__NejiCounterattack_caster[this], s__NejiCounterattack_SPELL_ID) then
            call UnitRemoveAbility(s__NejiCounterattack_caster[this], s__NejiCounterattack_SPELL_ID_2)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NejiCounterattack_caster[this]), s__NejiCounterattack_SPELL_ID, true)
            call KillUnit(s__NejiCounterattack_domo[this])
            call ShowUnit(s__NejiCounterattack_domo[this], false)
            call s__NejiCounterattack_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__NejiCounterattack_actions takes nothing returns nothing
        local integer this= s__NejiCounterattack_allocate()
        set s__NejiCounterattack_caster[this]=GetTriggerUnit()
        set s__NejiCounterattack_count[this]=0
        set s__NejiCounterattack_target[this]=null
        set s__NejiCounterattack_instance=this
        set s__NejiCounterattack_domo[this]=CreateUnit(GetOwningPlayer(s__NejiCounterattack_caster[this]), 'h016', GetUnitX(s__NejiCounterattack_caster[this]), GetUnitY(s__NejiCounterattack_caster[this]), 270)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__NejiCounterattack_periodic)
    endfunction 

    function s__NejiCounterattack_backstab takes nothing returns nothing
        local real angle= Deg2Rad(GetUnitFacing(s__NejiCounterattack_target[s__NejiCounterattack_instance]) + 180)
        local real new_x= (((GetUnitX(s__NejiCounterattack_target[s__NejiCounterattack_instance]) )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__NejiCounterattack_target[s__NejiCounterattack_instance]) )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
        set s__NejiCounterattack_count[s__NejiCounterattack_instance]=1000
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__NejiCounterattack_caster[s__NejiCounterattack_instance]) )*1.0), (( GetUnitY(s__NejiCounterattack_caster[s__NejiCounterattack_instance]))*1.0))) // INLINED!!
        call SetUnitX(s__NejiCounterattack_caster[s__NejiCounterattack_instance], new_x)
        call SetUnitY(s__NejiCounterattack_caster[s__NejiCounterattack_instance], new_y)
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__NejiCounterattack_caster[s__NejiCounterattack_instance]) )*1.0), (( GetUnitY(s__NejiCounterattack_caster[s__NejiCounterattack_instance]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(s__NejiCounterattack_target[s__NejiCounterattack_instance]) )*1.0), (( GetUnitY(s__NejiCounterattack_target[s__NejiCounterattack_instance]))*1.0))) // INLINED!!
        call SetUnitFacing(s__NejiCounterattack_caster[s__NejiCounterattack_instance], GetUnitFacing(s__NejiCounterattack_target[s__NejiCounterattack_instance]))
        call SetUnitAnimation(s__NejiCounterattack_caster[s__NejiCounterattack_instance], "attack")
        //call StunUnitTimed(instance.caster, instance.target, 1.0)

	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__NejiCounterattack_caster[s__NejiCounterattack_instance]), 'n03F', GetUnitX(s__NejiCounterattack_caster[s__NejiCounterattack_instance]), GetUnitY(s__NejiCounterattack_caster[s__NejiCounterattack_instance]), GetUnitFacing(s__NejiCounterattack_caster[s__NejiCounterattack_instance]))
	call UnitAddAbility(bj_lastCreatedUnit, 'A04V')
	call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", s__NejiCounterattack_target[s__NejiCounterattack_instance])
	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
	call IssueTargetOrder(s__NejiCounterattack_target[s__NejiCounterattack_instance], "attack", s__NejiCounterattack_caster[s__NejiCounterattack_instance])

        call SetUnitAnimation(s__NejiCounterattack_target[s__NejiCounterattack_instance], "death")
        call IssueTargetOrder(s__NejiCounterattack_caster[s__NejiCounterattack_instance], "attack", s__NejiCounterattack_target[s__NejiCounterattack_instance])
        call UnitDamageTarget(s__NejiCounterattack_caster[s__NejiCounterattack_instance], s__NejiCounterattack_target[s__NejiCounterattack_instance], ( 50 + ( 0.1 * GetHeroAgi(s__NejiCounterattack_caster[s__NejiCounterattack_instance], true) ) ) * GetUnitAbilityLevel(s__NejiCounterattack_caster[s__NejiCounterattack_instance], s__NejiCounterattack_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
    endfunction 

    function s__NejiCounterattack_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__NejiCounterattack_SPELL_ID ) , Filter(( function s__NejiCounterattack_actions))) // INLINED!!
        call RegisterSpellEffectEvent2((s__NejiCounterattack_SPELL_ID_2 ) , Filter(( function s__NejiCounterattack_backstab))) // INLINED!!
    endfunction 

