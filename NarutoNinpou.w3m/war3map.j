  function s__KisameDaikoudan__Spell_dealDamage takes nothing returns boolean
                    if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KisameDaikoudan__Spell_caster[s__KisameDaikoudan__Spell_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and not IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) then
                        call UnitDamageTarget(s__KisameDaikoudan__Spell_caster[s__KisameDaikoudan__Spell_instance], GetFilterUnit(), 5.0 * GetHeroStr(s__KisameDaikoudan__Spell_caster[s__KisameDaikoudan__Spell_instance], true) + GetUnitState(GetFilterUnit(), UNIT_STATE_MAX_MANA), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
