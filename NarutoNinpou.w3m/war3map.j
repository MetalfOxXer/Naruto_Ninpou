//===========================================================================
function Trig_StaticField_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0MD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_StaticField_Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped(( 'B037' ), GetEnumUnit()) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_StaticField_Func002A takes nothing returns nothing
    if ( Trig_StaticField_Func002Func001C() ) then
        call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), GetHeroAgi(GetTriggerUnit(), true) * GetStacks(GetEnumUnit()), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
        call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx" ), (( GetUnitX(GetEnumUnit()) )*1.0), (( GetUnitY(GetEnumUnit()))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_luolei.mdx" ), (( GetUnitX(GetEnumUnit()) )*1.0), (( GetUnitY(GetEnumUnit()))*1.0))) // INLINED!!
        //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(GetTriggerUnit()), 'n02D', GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit()), GetRandomReal(0, 360))
        //call KillUnit(bj_lastCreatedUnit)

        set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Lightning_Cloud_Strike_2.mdl", GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit()))
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.45)
        call DestroyEffect(bj_lastCreatedEffect)

        if GetStacks(GetEnumUnit()) >= 5 then
            //call StunUnitTimed(GetTriggerUnit(), GetEnumUnit(), 2.0)
        endif
        call UnitRemoveAbility(GetEnumUnit(), 'B037')
    else
    endif
endfunction

function Trig_StaticField_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function Trig_StaticField_Func002A)
endfunction

//===========================================================================
function InitTrig_StaticField takes nothing returns nothing
    set gg_trg_StaticField=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_StaticField, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_StaticField, Condition(function Trig_StaticField_Conditions))
    call TriggerAddAction(gg_trg_StaticField, function Trig_StaticField_Actions)
    call EnableTriggerForId(59 , gg_trg_StaticField)
endfunction


