            call UnitRemoveAbility(s__SakuraGetLost_caster[this], 'Arav')
            call SetUnitFlyHeight(s__SakuraGetLost_caster[this], 300, 0)
            call SetUnitAnimation(s__SakuraGetLost_caster[this], "spell slam")
            call TimerStart(NewTimerEx(this), 0.03, true, function s__SakuraGetLost_periodic2)
            call ReleaseTimer(GetExpiredTimer())
