function s__KinkakuAbilities_periodic takes nothing returns nothing
    local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

    if IsUnitAliveBJ(s__KinkakuAbilities_caster[this]) then
        if GetUnitTypeId(s__KinkakuAbilities_caster[this]) == 'H05Q' then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KinkakuAbilities_caster[this]), 'A0NK', true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KinkakuAbilities_caster[this]), 'A0PV', true)
        else
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KinkakuAbilities_caster[this]), 'A0NK', false)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KinkakuAbilities_caster[this]), 'A0PV', false)
            call SetUnitAbilityLevel(s__KinkakuAbilities_caster[this], 'A0OF', s__KinkakuAbilities_spellQ)
            call SetUnitAbilityLevel(s__KinkakuAbilities_caster[this], 'A0OE', s__KinkakuAbilities_spellE)
        endif
    endif

    call s__KinkakuAbilities_deallocate(this)
    call ReleaseTimer(GetExpiredTimer())
endfunction

function s__KinkakuAbilities_action takes nothing returns nothing
    local integer this= s__KinkakuAbilities_allocate()
    local real x= GetUnitX(GetTriggerUnit())
    local real y= GetUnitY(GetTriggerUnit())
    set s__KinkakuAbilities_caster[this]=GetTriggerUnit()

    if IsUnitAliveBJ(s__KinkakuAbilities_caster[this]) then
        set s__KinkakuAbilities_spellQ=GetUnitAbilityLevel(s__KinkakuAbilities_caster[this], 'A0NK')
        set s__KinkakuAbilities_spellE=GetUnitAbilityLevel(s__KinkakuAbilities_caster[this], 'A0PV')
    endif

    set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h07K', x, y, GetRandomReal(0, 360))
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.4)
    call TimerStart(NewTimerEx(this), 0.1, false, function s__KinkakuAbilities_periodic)
endfunction

function s__KinkakuAbilities_onDeath takes nothing returns nothing
    local integer this= s__KinkakuAbilities_allocate()
    local unit dyingUnit= GetDyingUnit()

    if dyingUnit == s__KinkakuAbilities_caster[this] then
        call SetPlayerAbilityAvailable(GetOwningPlayer(dyingUnit), 'A0NK', false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(dyingUnit), 'A0PV', false)
    endif

    call s__KinkakuAbilities_deallocate(this)
endfunction

function s__KinkakuAbilities_onInit takes nothing returns nothing
    local trigger deathTrigger= CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(deathTrigger, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(deathTrigger, function s__KinkakuAbilities_onDeath)

    call RegisterSpellEffectEvent2(('A02E' ) , Filter(( function s__KinkakuAbilities_action))) // INLINED!!
endfunction

        
