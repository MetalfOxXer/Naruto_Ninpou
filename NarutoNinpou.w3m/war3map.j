//===========================================================================
// Trigger: DaruiBlackLightning
//===========================================================================

//Implemented from module Alloc:
    
        function s__DaruiBlackLightning_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__DaruiBlackLightning_Alloc___recycle[(0)] == 0 ) then
                set s__DaruiBlackLightning_Alloc___instanceCount=s__DaruiBlackLightning_Alloc___instanceCount + 1
                set this=s__DaruiBlackLightning_Alloc___instanceCount
            else
                set this=s__DaruiBlackLightning_Alloc___recycle[(0)]
                set s__DaruiBlackLightning_Alloc___recycle[(0)]=s__DaruiBlackLightning_Alloc___recycle[s__DaruiBlackLightning_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__DaruiBlackLightning_deallocate takes integer this returns nothing
            set s__DaruiBlackLightning_Alloc___recycle[this]=s__DaruiBlackLightning_Alloc___recycle[(0)]
            set s__DaruiBlackLightning_Alloc___recycle[(0)]=this
        endfunction

    function s__DaruiBlackLightning_actions takes nothing returns nothing
        local integer i
        local integer j
        local real x
        local real y
        local real angle
        local real offset
        local unit u
        set i=0
        loop
            set i=i + 1
            exitwhen i == 5
            set j=0
            loop
                set j=j + 1
                exitwhen j > 12
                set angle=360 / 12 * j + 5 * i
                set offset=100 * i
                set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
                set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Effects\\s_Black_BoltImpact.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            endloop
        endloop
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Black_ThunderclapCaster.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        call SlowArea(GetTriggerUnit() , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 600)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 600, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                //call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 300 * GetUnitAbilityLevel(GetTriggerUnit(), SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                //call AddSpecialEffectEx("Effects\\s_Black_BoltImpact.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
                //call AddSpecialEffectEx("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
                //call AddSpecialEffectEx("by_wood_effect_yubanmeiqin_lightning_luolei.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
            elseif not IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set u=CreateAbilityDummy(GetTriggerUnit() , 'A1C1')
               call IssueTargetOrder(u, "bloodlust", bj_lastCreatedUnit)
               call UnitRemoveBuffs(bj_lastCreatedUnit, false, true)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction

    function s__DaruiBlackLightning_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(40 , s__DaruiBlackLightning_SPELL_ID , function s__DaruiBlackLightning_actions)
    endfunction 

//===========================================================================
// Trigger: DeidaraSetGlobals
//===========================================================================
function Trig_DeidaraSetGlobals_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H00D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DeidaraSetGlobals_Actions takes nothing returns nothing
    set deidara=GetTriggerUnit()
    set deidaraMouseX=GetUnitX(deidara)
    set deidaraMouseY=GetUnitY(deidara)
    call DisableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_DeidaraSetGlobals takes nothing returns nothing
    set gg_trg_DeidaraSetGlobals=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_DeidaraSetGlobals, GetPlayableMapRect())
    call TriggerAddCondition(gg_trg_DeidaraSetGlobals, Condition(function Trig_DeidaraSetGlobals_Conditions))
    call TriggerAddAction(gg_trg_DeidaraSetGlobals, function Trig_DeidaraSetGlobals_Actions)
endfunction

//===========================================================================
// Trigger: DeidaraCommandMoveSummon
//===========================================================================

function updateDeidara takes nothing returns nothing
    local location tempLoc= Location(deidaraMouseX, deidaraMouseY)
    if GetUnitCurrentOrder(deidara) == 0 and metaCtrlDownDeidara and IsUnitAliveBJ(deidaraSummon) then
        call IssueImmediateOrder(deidara, "stop")
    elseif GetUnitCurrentOrder(deidara) == 851971 and metaCtrlDownDeidara and IsUnitAliveBJ(deidaraSummon) then
        call IssuePointOrderLoc(deidara, "move", tempLoc)
    endif
    call RemoveLocation(tempLoc)
    set tempLoc=null
    call DestroyTimer(GetExpiredTimer())
endfunction

function isRMBPressDeidara takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(deidara) and IsUnitAliveBJ(deidaraSummon) then
        set deidaraMoveTimer=CreateTimer()
        if not metaCtrlDownDeidara then
            set deidaraMouseX=BlzGetTriggerPlayerMouseX()
            set deidaraMouseY=BlzGetTriggerPlayerMouseY()
        endif
        call TimerStart(deidaraMoveTimer, 0.01, true, function updateDeidara)
        if metaCtrlDownDeidara then
            return true
        endif
    endif
    return false
endfunction

function isRMBReleaseDeidara takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(deidara) and IsUnitAliveBJ(deidaraSummon) then
        set deidaraMoveTimer=CreateTimer()
        call TimerStart(deidaraMoveTimer, 0.01, true, function updateDeidara)
        if metaCtrlDownDeidara then
            return true
        endif
    endif
    return false
endfunction

function actionsDeidara takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(deidara) then
        call IssuePointOrderLocBJ(deidaraSummon, "move", BlzGetTriggerPlayerMousePosition())
    endif
endfunction

function pressCTRLDeidara takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(deidara) then
        set metaCtrlDownDeidara=true
    endif
endfunction  

function releaseCTRLDeidara takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(deidara) then
        set metaCtrlDownDeidara=false
    endif
endfunction

//===========================================================================
function InitTrig_DeidaraCommandMoveSummon takes nothing returns nothing
    local integer i= 0
    
    loop
    exitwhen ( i > 24 )
        call TriggerRegisterPlayerMouseEventBJ(rmbClickTriggerDeidara, Player(i), bj_MOUSEEVENTTYPE_DOWN)
        call TriggerRegisterPlayerMouseEventBJ(rmbReleaseTriggerDeidara, Player(i), bj_MOUSEEVENTTYPE_UP)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlDownTriggerDeidara, Player(i), OSKEY_LCONTROL, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlUpTriggerDeidara, Player(i), OSKEY_LCONTROL, 0, false)
        set i=i + 1
    endloop
    
    call TriggerAddCondition(rmbClickTriggerDeidara, Condition(function isRMBPressDeidara))
    call TriggerAddCondition(rmbReleaseTriggerDeidara, Condition(function isRMBReleaseDeidara))
    call TriggerAddAction(rmbClickTriggerDeidara, function actionsDeidara)
    call TriggerAddAction(rmbReleaseTriggerDeidara, function actionsDeidara)
    call TriggerAddAction(metaCtrlDownTriggerDeidara, function pressCTRLDeidara)
    call TriggerAddAction(metaCtrlUpTriggerDeidara, function releaseCTRLDeidara)
endfunction

