function Trig_TemariKiriKiriMai_Actions takes nothing returns nothing
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
		call PlaySoundOnUnitBJ(gg_snd_Temari_T, 90.0, GetTriggerUnit())
		call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Temari: Go, Kamatari!!|r")
	endif
	//set udg_reals01[91]=GetUnitFacing(GetSpellAbilityUnit())
