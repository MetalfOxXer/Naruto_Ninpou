    function s__KakashiKamuiDimension_actions takes nothing returns nothing
        local integer id= (GetUnitUserData((GetTriggerUnit()))) // INLINED!!
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            if BlzGetUnitSkin(GetTriggerUnit()) == 'h0AS' then
                call PlaySoundOnUnitBJ(gg_snd_FemKakashi_Jounin_Kamui, 100, GetTriggerUnit())
            else
                call PlaySoundOnUnitBJ(gg_snd_Kakashi_Jounin_Dimension_D, 100, GetTriggerUnit())
            endif
        endif
        if not RectContainsUnit(gg_rct_DuelArena, GetTriggerUnit()) and not RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) then
            set s__s__KakashiKamuiDimension_xx[id]= GetUnitX(GetTriggerUnit())
            set s__s__KakashiKamuiDimension_yy[id]= GetUnitY(GetTriggerUnit())
            set s__s__KakashiKamuiDimension_u[id]= GetTriggerUnit()
            set s__s__KakashiKamuiDimension_t[id]= NewTimerEx(id)
            set s__KakashiKamuiDimension_KamuiDimension=CreateGroup()
            call CreateFogModifierRectBJ(true, GetTriggerPlayer(), FOG_OF_WAR_VISIBLE, gg_rct_KamuiDimensionObito)
            call SetPlayerAbilityAvailable(GetTriggerPlayer(), s__KakashiKamuiDimension_SPELL_ID, false)
            call UnitAddAbility(s__s__KakashiKamuiDimension_u[id], s__KakashiKamuiDimension_SPELL_ID_BACK)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__KakashiKamuiDimension_u[id]) ), ( 'h03U' ), (( GetUnitX(s__s__KakashiKamuiDimension_u[id]) )*1.0), (( GetUnitY(s__s__KakashiKamuiDimension_u[id]) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__KakashiKamuiDimension_u[id]) ), ( 'h03U' ), (( GetRectCenterX(gg_rct_KamuiDimensionObito) )*1.0), (( GetRectCenterY(gg_rct_KamuiDimensionObito) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__s__KakashiKamuiDimension_u[id]), GetUnitY(s__s__KakashiKamuiDimension_u[id]), 400.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call SetUnitPosition(bj_lastCreatedUnit, GetRectCenterX(gg_rct_KamuiDimensionObito), GetRectCenterY(gg_rct_KamuiDimensionObito))
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                        call PanCameraToTimedForPlayer(GetOwningPlayer(bj_lastCreatedUnit), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
                    endif
                    call GroupAddUnit(s__KakashiKamuiDimension_KamuiDimension, bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__s__KakashiKamuiDimension_isActive[id]= true
            call TimerStart(s__s__KakashiKamuiDimension_t[id], 10.0, false, function s__KakashiKamuiDimension_finish)
        endif
    endfunction
    
    function s__KakashiKamuiDimension_actions_back takes nothing returns nothing
        call s__KakashiKamuiDimension_finish2((GetUnitUserData((GetTriggerUnit())))) // INLINED!!
    endfunction
    
    function s__KakashiKamuiDimension_dies takes nothing returns nothing
        if s__s__KakashiKamuiDimension_isActive[(GetUnitUserData((GetTriggerUnit())))] then // INLINED!!
            call s__KakashiKamuiDimension_finish2((GetUnitUserData((GetTriggerUnit())))) // INLINED!!
        endif
    endfunction
    
    
    function s__KakashiKamuiDimension_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__KakashiKamuiDimension_dies))) // INLINED!!
