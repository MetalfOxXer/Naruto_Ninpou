function YokaiSpray_HardenBlob takes integer inst,integer blobIndex returns nothing
    local integer state= LoadInteger(KurotsuchiHash, inst, blobIndex * 20 + 9)
    local effect fx
    
    if state != 2 then
        call SaveInteger(KurotsuchiHash, inst, blobIndex * 20 + 9, 2)
        set fx=LoadEffectHandle(KurotsuchiHash, inst, blobIndex * 20 + 10)
        if fx != null then
            call BlzSetSpecialEffectColor(fx, 100, 100, 100)
            call BlzPlaySpecialEffect(fx, ANIM_TYPE_SLEEP)
        endif
    endif
endfunction
