            call PauseUnit(s__HinataShotei_target[this], false)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HinataShotei_caster[this]), 'n03F', GetUnitX(s__HinataShotei_caster[this]), GetUnitY(s__HinataShotei_caster[this]), GetUnitFacing(s__HinataShotei_caster[this]))
            call UnitAddAbility(bj_lastCreatedUnit, 'AIob')
            call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", s__HinataShotei_target[this])
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
	    call IssueTargetOrder(s__HinataShotei_target[this], "attack", s__HinataShotei_caster[this])
            call SetUnitAnimation(s__HinataShotei_target[this], "death")
            call SetUnitTimeScale(s__HinataShotei_caster[this], 1.00)
            call DestroyEffect(s__HinataShotei_e1[this])
            call DestroyEffect(s__HinataShotei_e2[this])
            set s__HinataShotei_e1[this]=null
            set s__HinataShotei_e2[this]=null
            call s__HinataShotei_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__HinataShotei_actions takes nothing returns nothing
        local integer this= s__HinataShotei_allocate()
        local real x
        local real y
        local real angle
        set s__HinataShotei_caster[this]=GetTriggerUnit()
        set s__HinataShotei_target[this]=GetSpellTargetUnit()
        set s__HinataShotei_count[this]=0
        if GetUnitAbilityLevel(s__HinataShotei_caster[this], 'B00F') > 0 then
            call SetUnitState(s__HinataShotei_target[this], UNIT_STATE_MANA, GetUnitState(s__HinataShotei_target[this], UNIT_STATE_MANA) - GetUnitState(s__HinataShotei_target[this], UNIT_STATE_MANA) * 0.02 * GetUnitAbilityLevel(s__HinataShotei_caster[this], s__HinataShotei_SPELL_ID))
        endif
        call PauseUnit(s__HinataShotei_caster[this], true)
        call PauseUnit(s__HinataShotei_target[this], true)
        call UnitAddAbility(s__HinataShotei_caster[this], 'A02Q')
        set angle=Atan3(GetUnitX(s__HinataShotei_target[this]) , GetUnitY(s__HinataShotei_target[this]) , GetUnitX(s__HinataShotei_caster[this]) , GetUnitY(s__HinataShotei_caster[this]))
        set x=(((GetUnitX(s__HinataShotei_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 90)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__HinataShotei_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 90)*1.0)) // INLINED!!
        call SetUnitX(s__HinataShotei_caster[this], x)
        call SetUnitY(s__HinataShotei_caster[this], y)
        //call SetUnitFacing(this.caster, Rad2Deg(angle) - 180)
        call SetUnitTimeScale(s__HinataShotei_caster[this], 5.0)
        set s__HinataShotei_e1[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", s__HinataShotei_caster[this], "right hand")
        set s__HinataShotei_e2[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", s__HinataShotei_caster[this], "right hand")
        call TimerStart(NewTimerEx(this), 0.05, true, function s__HinataShotei_periodic)
    endfunction 

    function s__HinataShotei_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(8 , s__HinataShotei_SPELL_ID , function s__HinataShotei_actions)
    endfunction 

