 endfunction
	
    function s__KonohamaruShuriken_destroy takes integer this returns nothing
        call KillUnit(s__KonohamaruShuriken_missile[this])
        call ShowUnit(s__KonohamaruShuriken_missile[this], false)
        set s__KonohamaruShuriken_caster[this]=null
        set s__KonohamaruShuriken_target[this]=null
        set s__KonohamaruShuriken_missile[this]=null
    endfunction
    
    function s__KonohamaruShuriken_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KonohamaruShuriken_missile[this])
        local real y= GetUnitY(s__KonohamaruShuriken_missile[this])
        local real angle= Atan3(x , y , GetUnitX(s__KonohamaruShuriken_target[this]) , GetUnitY(s__KonohamaruShuriken_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real dist= GetDistanceUnits(s__KonohamaruShuriken_missile[this] , s__KonohamaruShuriken_target[this])
        local integer i
        call SetUnitX(s__KonohamaruShuriken_missile[this], new_x)
        call SetUnitY(s__KonohamaruShuriken_missile[this], new_y)
        if dist <= 50 then
           if GetUnitAbilityLevel(s__KonohamaruShuriken_caster[this], 'B00U') > 0 then
                call SetUnitPosition(s__KonohamaruShuriken_caster[this], GetUnitX(s__KonohamaruShuriken_target[this]), GetUnitY(s__KonohamaruShuriken_target[this]))
                call IssueTargetOrder(s__KonohamaruShuriken_caster[this], "attack", s__KonohamaruShuriken_target[this])
            endif
	    call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__KonohamaruShuriken_missile[this]) )*1.0), (( GetUnitY(s__KonohamaruShuriken_missile[this]))*1.0))) // INLINED!!
            set i=0
            loop
                exitwhen i > 5
                set new_x=GetRandomReal(x - 100, x + 100)
                set new_y=GetRandomReal(y - 100, y + 100)
                set angle=Atan3(GetUnitX(s__KonohamaruShuriken_target[this]) , GetUnitY(s__KonohamaruShuriken_target[this]) , new_x , new_y)
                //call AddSpecialEffectEx("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.md", new_x, new_y)
                //call AddSpecialEffectEx("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl", new_x, new_y)
                //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'h07W', new_x, new_y, Rad2Deg(angle)) 
                //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
                set bj_lastCreatedUnit=CreateAbilityDummy(s__KonohamaruShuriken_caster[this] , 'A155')
                call SetUnitX(bj_lastCreatedUnit, new_x)
                call SetUnitY(bj_lastCreatedUnit, new_y)
                call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", new_x, new_y)
                set i=i + 1
            endloop
            //if GetHeroLevel(this.caster) < 35 then
            //    call StunUnitTimed(this.caster, this.target, 2.0)
            //endif
            set bj_lastCreatedGroup=CreateGroup()
			set s__KonohamaruShuriken_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 450.0, Filter(function s__KonohamaruShuriken_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            call s__KonohamaruShuriken_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KonohamaruShuriken_actions takes nothing returns nothing
        local integer this= s__KonohamaruShuriken_allocate()
        set s__KonohamaruShuriken_caster[this]=GetTriggerUnit()
        set s__KonohamaruShuriken_target[this]=GetSpellTargetUnit()
        set s__KonohamaruShuriken_missile[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h07V', GetUnitX(s__KonohamaruShuriken_caster[this]), GetUnitY(s__KonohamaruShuriken_caster[this]), GetUnitFacing(s__KonohamaruShuriken_caster[this]))
        call TimerStartEx(NewTimerEx(this) , 0.025 , true , function s__KonohamaruShuriken_periodic , "KonohamaruShuriken_periodic")
    endfunction
    
    function s__KonohamaruShuriken_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(66 , s__KonohamaruShuriken_SPELL_ID , function s__KonohamaruShuriken_actions)
    endfunction
    
//===========================================================================
// Trigger: KonohamaruKatonHaisekisho
//===========================================================================
function Trig_KonohamaruKatonHaisenkisho_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0T5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_KonohamaruKatonHaisenkisho_Func012A takes nothing returns nothing
    if IsUnitVisible(udg_KonohamaruFIre_Caster, GetEnumPlayer()) then
        call CameraSetEQNoiseForPlayer(GetEnumPlayer(), 3)
    endif
endfunction

function Trig_KonohamaruKatonHaisenkisho_Func014002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_KonohamaruFIre_Caster)) == true )
endfunction

function Trig_KonohamaruKatonHaisenkisho_Func015A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_KonohamaruFIre_Caster, GetEnumUnit(), 2 * GetHeroStr(udg_KonohamaruFIre_Caster, true) + ( 800.00 * GetUnitAbilityLevel(udg_KonohamaruFIre_Caster, 'A0T5') ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
    set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit()))
    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 40 + GetPointZ(GetUnitX(GetEnumUnit()) , GetUnitY(GetEnumUnit())))
    call DestroyEffect(bj_lastCreatedEffect)
endfunction

function Trig_KonohamaruKatonHaisenkisho_Func022A takes nothing returns nothing
    call CameraClearNoiseForPlayer(GetEnumPlayer())
endfunction

function Trig_KonohamaruKatonHaisenkisho_Actions takes nothing returns nothing
    local real scale
    local real offset
    local real angle
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Konohamaru_R, 80, GetTriggerUnit())
    endif
    set udg_KonohamaruFIre_Caster=GetTriggerUnit()
    set udg_KonohamaruFire_Point[1]=GetSpellTargetLoc()
    set udg_KonohamaruFire_Point[2]=GetUnitLoc(GetTriggerUnit())
    set udg_KonohamaruFire_Point[4]=PolarProjectionBJ(udg_KonohamaruFire_Point[2], 100.00, GetUnitFacing(GetTriggerUnit()))
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=5
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc(1, 'h054', GetTriggerPlayer(), udg_KonohamaruFire_Point[4], bj_UNIT_FACING)
        call IssuePointOrderLoc(GetLastCreatedUnit(), "clusterrockets", udg_KonohamaruFire_Point[1])
        call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction(0.50)
    call PauseUnitBJ(true, GetTriggerUnit())
    call SetUnitAnimation(GetTriggerUnit(), "spell")
    call TriggerSleepAction(0.20)
    call SetUnitAnimation(udg_KonohamaruFIre_Caster, "spell")
    call TriggerSleepAction(0.20)
    call ForForce(GetPlayersAll(), function Trig_KonohamaruKatonHaisenkisho_Func012A)
    call PauseUnitBJ(false, udg_KonohamaruFIre_Caster)
    set udg_KonohamaruFire_Group=GetUnitsInRangeOfLocMatching(400.00, udg_KonohamaruFire_Point[1], Condition(function Trig_KonohamaruKatonHaisenkisho_Func014002003))
    call ForGroupBJ(udg_KonohamaruFire_Group, function Trig_KonohamaruKatonHaisenkisho_Func015A)
    call DestroyGroup(udg_KonohamaruFire_Group)
    set bj_lastCreatedEffect=AddSpecialEffect("AnimeFireEffectJiraiya.mdl", GetLocationX(udg_KonohamaruFire_Point[1]), GetLocationY(udg_KonohamaruFire_Point[1]))
    call DestroyEffect(bj_lastCreatedEffect)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=30
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set offset=GetRandomReal(50.0, 300.0)
        set angle=GetRandomReal(0, 360.0)
        set udg_KonohamaruFire_Point[3]=PolarProjectionBJ(udg_KonohamaruFire_Point[1], offset, angle)
        call CreateNUnitsAtLoc(1, 'n02R', GetOwningPlayer(udg_KonohamaruFIre_Caster), udg_KonohamaruFire_Point[3], GetRandomDirectionDeg())
        set scale=GetRandomReal(80.0, 130.0)
        call h__SetUnitScalePercent(GetLastCreatedUnit(), scale, scale, scale)
        call UnitApplyTimedLife(GetLastCreatedUnit(), 'BTLF', 7.0)
        call RemoveLocation(udg_KonohamaruFire_Point[3])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call RemoveLocation(udg_KonohamaruFire_Point[1])
    call RemoveLocation(udg_KonohamaruFire_Point[2])
    call RemoveLocation(udg_KonohamaruFire_Point[4])
    call TriggerSleepAction(0.50)
    call ForForce(GetPlayersAll(), function Trig_KonohamaruKatonHaisenkisho_Func022A)
endfunction

//===========================================================================
function InitTrig_KonohamaruKatonHaisekisho takes nothing returns nothing
    set gg_trg_KonohamaruKatonHaisekisho=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KonohamaruKatonHaisekisho, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_KonohamaruKatonHaisekisho, Condition(function Trig_KonohamaruKatonHaisenkisho_Conditions))
    call TriggerAddAction(gg_trg_KonohamaruKatonHaisekisho, function Trig_KonohamaruKatonHaisenkisho_Actions)
    call EnableTriggerForId(66 , gg_trg_KonohamaruKatonHaisekisho)
endfunction


