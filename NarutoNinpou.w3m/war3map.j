        function s__KaguyaTeleport_teleport takes nothing returns nothing
            local real x1
            local real y1
            local real x2
            local real y2
            local real new_x
            local real new_y
            local integer i= 0
            local integer id
            loop
                exitwhen i > 11
                if udg_units33[i + 1] != null and udg_KaguyaTeleport1[(GetUnitUserData((udg_units33[i + 1])))] != null then // INLINED!!
                    set id=(GetUnitUserData((udg_units33[i + 1]))) // INLINED!!
