 function s__YugitoT_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__YugitoT_fireball[this])
  local real y= GetUnitY(s__YugitoT_fireball[this])
  local real new_x= (((x )*1.0) + Cos((( s__YugitoT_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__YugitoT_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
  local integer i= 0
  local integer j= 0
  local integer k= 0
		call SetUnitX(s__YugitoT_fireball[this], new_x)
		call SetUnitY(s__YugitoT_fireball[this], new_y)
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 400, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__YugitoT_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__YugitoT_damaged[this]) then
				call UnitDamageTarget(s__YugitoT_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__YugitoT_caster[this], true) * 10, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				call GroupAddUnit(s__YugitoT_damaged[this], bj_lastCreatedUnit)
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		set s__YugitoT_count[this]=s__YugitoT_count[this] + 1
		if s__YugitoT_count[this] == 20 then
			call KillUnit(s__YugitoT_bijuu[this])
			call ShowUnit(s__YugitoT_bijuu[this], false)
			call PauseUnit(s__YugitoT_caster[this], false)
			call ShowUnit(s__YugitoT_caster[this], true)
			call SelectUnitForPlayerSingle(s__YugitoT_caster[this], GetOwningPlayer(s__YugitoT_caster[this]))
			loop
				exitwhen i > 2
				set j=0
				loop
					exitwhen j > 12
					set x=(((GetUnitX(s__YugitoT_caster[this]) )*1.0) + Cos((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					set y=(((GetUnitY(s__YugitoT_caster[this]) )*1.0) + Sin((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Pillar of Flame Blue.mdx", x, y)
					call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
					call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
					set j=j + 1
				endloop
				set i=i + 1
			endloop
		endif
		if s__YugitoT_count[this] > 40 then
			call KillUnit(CreateUnit(GetOwningPlayer(s__YugitoT_fireball[this]), 'e05X', GetUnitX(s__YugitoT_fireball[this]), GetUnitY(s__YugitoT_fireball[this]), 270))
			call SetUnitTimeScale(s__YugitoT_fireball[this], 1.0)
			call KillUnit(s__YugitoT_fireball[this])
			call ShowUnit(s__YugitoT_fireball[this], false)
			set s__YugitoT_fireball[this]=null
			set s__YugitoT_bijuu[this]=null
			call DestroyGroup(s__YugitoT_damaged[this])
			set s__YugitoT_damaged[this]=null
			call s__YugitoT_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__YugitoT_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__YugitoT_bijuu[this])
  local real y= GetUnitY(s__YugitoT_bijuu[this])
