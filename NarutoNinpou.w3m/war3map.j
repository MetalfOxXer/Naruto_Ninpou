            //call SetUnitPropWindow(this.caster, 0)
            call SetUnitAnimation(s__KaguyaPunch___Spell_caster[this], "spell two")
            call AddLoadingBar(s__KaguyaPunch___Spell_caster[this] , 2.0)
            call TimerStart(NewTimerEx(this), 0.2, true, function s__KaguyaPunch___Spell_periodic)
            call GroupClear(s__KaguyaPunch___Spell_damaged)
        endfunction
        
