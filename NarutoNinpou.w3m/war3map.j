        //--------------------------------------------------------
        // END OF CONFIGURATIONS
        //--------------------------------------------------------
        function s__AHSS_Configurations_onInit takes nothing returns nothing
            set s__AHSS_Configurations_teams=sc__AHSS_Teams_create()
            set s__AHSS_Configurations_heroes=sc__AHSS_Heroes_create()
            set s__AHSS_Configurations_options=s__AHSS_Options__allocate()
            set s__AHSS_Configurations_paths=s__AHSS_Paths__allocate()
            set s__AHSS_Configurations_graphics=sc__AHSS_Graphics_create(s__AHSS_Configurations_teams , s__AHSS_Configurations_heroes , s__AHSS_Configurations_options , s__AHSS_Configurations_paths)
            set s__AHSS_Configurations_HERO_BY_ID=s__Table_create()
            call s__AHSS_Configurations_init()
        endfunction
        function s__AHSS_Configurations_start takes boolean allRandom returns nothing
            call sc__AHSS_Graphics_draw(s__AHSS_Configurations_graphics,allRandom)
        endfunction
    
    
        function s__AHSS__Team_create takes string name returns integer
            local integer this= s__AHSS__Team__allocate()
            set s__AHSS__Team_name[this]=name
            set s__AHSS__Team_count[this]=0
            return this
        endfunction 
        function s__AHSS__Team_addPlayer takes integer this,integer whichPlayer returns nothing
            set s___AHSS__Team_players[s__AHSS__Team_players[this]+s__AHSS__Team_count[this]]=whichPlayer
            set s__AHSS__Team_count[this]=s__AHSS__Team_count[this] + 1
        endfunction 
        function s__AHSS__Team_setSpawningSpot takes integer this,rect whichRect returns nothing
            set s__AHSS__Team_spawningSpot[this]=whichRect
        endfunction
        function s__AHSS__Team_getName takes integer this returns string
            return s__AHSS__Team_name[this]
        endfunction
        function s__AHSS__Team_getPlayer takes integer this,integer index returns integer
            return s___AHSS__Team_players[s__AHSS__Team_players[this]+index]
        endfunction
        function s__AHSS__Team_getSpawningSpot takes integer this returns rect
            return s__AHSS__Team_spawningSpot[this]
        endfunction
        
        function s__AHSS__Team_getSize takes integer this returns integer
            return s__AHSS__Team_count[this]
        endfunction
      
    
        function s__AHSS_MinimapIcon_createMinimapIcons takes nothing returns nothing
            local integer c= s__AHSS_Configurations__allocate()
            local integer i= 0
            local integer id
            loop
                exitwhen i >= 14
                if ( GetPlayerSlotState(GetOwningPlayer(udg_units33[i + 1])) == PLAYER_SLOT_STATE_PLAYING ) then
                    set id=GetUnitTypeId(udg_units33[i + 1])
                    if id != 'N017' and id != 'N00M' then
                        set udg_MinimapIcons[i]=CreateMinimapIconOnUnit(udg_units33[i + 1], 255, 255, 255, LoadStr(udg_MinimapIconPaths, id, id), FOG_OF_WAR_VISIBLE)
                        if GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 0 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 1 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 2 then
                            set udg_MinimapIcons[i + 14]=CreateMinimapIconOnUnit(udg_units33[i + 1], 255, 255, 255, "war3mapImported\\MiniMap_T1_Border.mdx", FOG_OF_WAR_VISIBLE)
                        elseif GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 4 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 5 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 6 then
                            set udg_MinimapIcons[i + 14]=CreateMinimapIconOnUnit(udg_units33[i + 1], 255, 255, 255, "war3mapImported\\MiniMap_T2_Border.mdx", FOG_OF_WAR_VISIBLE)
                        elseif GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 8 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 9 or GetPlayerId(GetOwningPlayer(udg_units33[i + 1])) == 10 then
                            set udg_MinimapIcons[i + 14]=CreateMinimapIconOnUnit(udg_units33[i + 1], 255, 255, 255, "war3mapImported\\MiniMap_T3_Border.mdx", FOG_OF_WAR_VISIBLE)
                        endif
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

function s__AHSS_MinimapIcon_updateMinimapIconVisibility takes nothing returns nothing
    local integer c= s__AHSS_Configurations__allocate()
    local integer i= 0
    local integer j= 0
    loop
        exitwhen i >= 14
        if Player(i) == GetLocalPlayer() and udg_MinimapToggleBoolean[i] == false then
            loop
                exitwhen j >= 14
                if ( not IsUnitAliveBJ(udg_units33[j + 1]) ) or IsUnitFogged(udg_units33[j + 1], GetLocalPlayer()) or not IsUnitVisible(udg_units33[j + 1], GetLocalPlayer()) or GetWidgetLife(udg_units33[j + 1]) < 0.405 then // or IsUnitHidden(udg_units33[i + 1]) 
                    call SetMinimapIconVisible(udg_MinimapIcons[j], false)
                    call SetMinimapIconVisible(udg_MinimapIcons[j + 14], false)
                else
                    call SetMinimapIconVisible(udg_MinimapIcons[j], true)
                    call SetMinimapIconVisible(udg_MinimapIcons[j + 14], true)
                endif
                set j=j + 1
            endloop
        elseif Player(i) == GetLocalPlayer() and udg_MinimapToggleBoolean[i] == true then
            loop
                exitwhen j >= 14
                call SetMinimapIconVisible(udg_MinimapIcons[j], false)
                call SetMinimapIconVisible(udg_MinimapIcons[j + 14], false)
                set j=j + 1
            endloop
        endif
        set i=i + 1
        set j=0
    endloop
endfunction         
                     
        function s__AHSS_MinimapIcon_startUpdateIcons takes nothing returns nothing
            local integer c= s__AHSS_Configurations__allocate()
            call s__AHSS_MinimapIcon_createMinimapIcons()
            set udg_MinimapUpdateTimer=CreateTimer()
            call TimerStart(udg_MinimapUpdateTimer, 0.5, true, function s__AHSS_MinimapIcon_updateMinimapIconVisibility)
        endfunction 
    
    
        function s__AHSS_Teams_create takes nothing returns integer
            local integer this= s__AHSS_Teams__allocate()
            set s__AHSS_Teams_count[this]=0
            return this
        endfunction
        
        function s__AHSS_Teams_createTeam takes integer this,string name returns nothing
            set s___AHSS_Teams_teams[s__AHSS_Teams_teams[this]+s__AHSS_Teams_count[this]]=s__AHSS__Team_create(name)
            set s__AHSS_Teams_count[this]=s__AHSS_Teams_count[this] + 1
