//===========================================================================
// Trigger: ChidoriNagashiINIT
//===========================================================================
function Trig_ChidoriNagashiINIT_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nagashi_INIT_Func004Func010002002001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Nagashi_Caster)) == true )
endfunction

function Trig_Nagashi_INIT_Func004Func010002002002 takes nothing returns boolean
    return ( IsUnitInGroup(GetFilterUnit(), udg_Nagashi_DamagedGroup) == false )
endfunction

function Trig_Nagashi_INIT_Func004Func010002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Nagashi_Caster)) == true), (IsUnitInGroup(GetFilterUnit(), udg_Nagashi_DamagedGroup) == false)) // INLINED!!
endfunction

function Trig_Nagashi_INIT_Func004Func011A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Nagashi_Caster, GetEnumUnit(), udg_Nagashi_Damage, ATTACK_TYPE_MELEE, DAMAGE_TYPE_MAGIC)
    call GroupAddUnitSimple(GetEnumUnit(), udg_Nagashi_DamagedGroup)
endfunction

function Trig_ChidoriNagashiINIT_Actions takes nothing returns nothing
    set udg_Nagashi_Caster=GetTriggerUnit()
    set udg_Nagashi_Damage=( 80.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), udg_Nagashi_Caster)) )
    set udg_Nagashi_Point[1]=GetUnitLoc(udg_Nagashi_Caster)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Nagashi_Point[4]=PolarProjectionBJ(udg_Nagashi_Point[1], 0.00, ( 30.00 * I2R(GetForLoopIndexA()) ))
        call CreateNUnitsAtLoc(1, 'h01E', GetOwningPlayer(udg_Nagashi_Caster), udg_Nagashi_Point[4], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(5.00, 'BTLF', GetLastCreatedUnit())
        set udg_Nagashi_Dummies[GetForLoopIndexA()]=GetLastCreatedUnit()
        call CreateNUnitsAtLoc(1, 'h01F', GetOwningPlayer(udg_Nagashi_Caster), udg_Nagashi_Point[4], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(5.00, 'BTLF', GetLastCreatedUnit())
        set udg_Nagashi_Dummies2[GetForLoopIndexA()]=GetLastCreatedUnit()
        set udg_Nagashi_Point[5]=GetUnitLoc(udg_Nagashi_Dummies[GetForLoopIndexA()])
        set udg_Nagashi_Rect[2]=RectFromCenterSizeBJ(udg_Nagashi_Point[5], 200.00, 200.00)
        set udg_Nagashi_Group=GetUnitsInRectMatching(udg_Nagashi_Rect[2], Condition(function Trig_Nagashi_INIT_Func004Func010002002))
        call ForGroupBJ(udg_Nagashi_Group, function Trig_Nagashi_INIT_Func004Func011A)
        call RemoveRect(udg_Nagashi_Rect[2])
        call RemoveLocation(udg_Nagashi_Point[4])
        call RemoveLocation(udg_Nagashi_Point[5])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call EnableTrigger(gg_trg_ChidoriNagashiLOOP)
    call TriggerSleepAction(1.00)
endfunction

//===========================================================================
function InitTrig_ChidoriNagashiINIT takes nothing returns nothing
    set gg_trg_ChidoriNagashiINIT=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_ChidoriNagashiINIT, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_ChidoriNagashiINIT, Condition(function Trig_ChidoriNagashiINIT_Conditions))
    call TriggerAddAction(gg_trg_ChidoriNagashiINIT, function Trig_ChidoriNagashiINIT_Actions)
endfunction


//===========================================================================
// Trigger: ChidoriNagashiLOOP
//===========================================================================
function Trig_Nagashi_Loop_Func001Func006002002001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Nagashi_Caster)) == true )
endfunction

function Trig_Nagashi_Loop_Func001Func006002002002 takes nothing returns boolean
    return ( IsUnitInGroup(GetFilterUnit(), udg_Nagashi_DamagedGroup) == false )
endfunction

function Trig_Nagashi_Loop_Func001Func006002002 takes nothing returns boolean
    return GetBooleanAnd((IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Nagashi_Caster)) == true), (IsUnitInGroup(GetFilterUnit(), udg_Nagashi_DamagedGroup) == false)) // INLINED!!
endfunction

function Trig_Nagashi_Loop_Func001Func007A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Nagashi_Caster, GetEnumUnit(), udg_Nagashi_Damage, ATTACK_TYPE_MELEE, DAMAGE_TYPE_MAGIC)
    call GroupAddUnitSimple(GetEnumUnit(), udg_Nagashi_DamagedGroup)
endfunction

function Trig_Nagashi_Loop_Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Nagashi_Point[1], GetUnitLoc(udg_Nagashi_Dummies[1])) >= 500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChidoriNagashiLOOP_Actions takes nothing returns nothing
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Nagashi_Point[2]=PolarProjectionBJ(udg_Nagashi_Point[1], ( DistanceBetweenPoints(udg_Nagashi_Point[1], GetUnitLoc(udg_Nagashi_Dummies[GetForLoopIndexA()])) + 50.00 ), ( 30.00 * I2R(GetForLoopIndexA()) ))
        call SetUnitPositionLoc(udg_Nagashi_Dummies[GetForLoopIndexA()], udg_Nagashi_Point[2])
        call SetUnitPositionLoc(udg_Nagashi_Dummies2[GetForLoopIndexA()], udg_Nagashi_Point[2])
        set udg_Nagashi_Point[6]=GetUnitLoc(udg_Nagashi_Dummies[GetForLoopIndexA()])
        set udg_Nagashi_Rect[3]=RectFromCenterSizeBJ(udg_Nagashi_Point[6], 200.00, 200.00)
        set udg_Nagashi_Group=GetUnitsInRectMatching(udg_Nagashi_Rect[3], Condition(function Trig_Nagashi_Loop_Func001Func006002002))
        call ForGroupBJ(udg_Nagashi_Group, function Trig_Nagashi_Loop_Func001Func007A)
        call RemoveRect(udg_Nagashi_Rect[3])
        call RemoveLocation(udg_Nagashi_Point[2])
        call RemoveLocation(udg_Nagashi_Point[6])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    if ( Trig_Nagashi_Loop_Func002C() ) then
        call GroupClear(udg_Nagashi_Group)
        call GroupClear(udg_Nagashi_DamagedGroup)
        call RemoveLocation(udg_Nagashi_Point[1])
        set udg_Nagashi_Point[1]=GetUnitLoc(udg_Nagashi_Caster)
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetUnitPositionLoc(udg_Nagashi_Dummies[GetForLoopIndexA()], udg_Nagashi_Point[1])
            call UnitApplyTimedLifeBJ(1.00, 'BTLF', udg_Nagashi_Dummies[GetForLoopIndexA()])
            call RemoveUnit(udg_Nagashi_Dummies2[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call RemoveLocation(udg_Nagashi_Point[1])
        call DisableTrigger(GetTriggeringTrigger())
    else
    endif
endfunction

//===========================================================================
function InitTrig_ChidoriNagashiLOOP takes nothing returns nothing
    set gg_trg_ChidoriNagashiLOOP=CreateTrigger()
    call DisableTrigger(gg_trg_ChidoriNagashiLOOP)
    call TriggerRegisterTimerEventPeriodic(gg_trg_ChidoriNagashiLOOP, 0.12)
    call TriggerAddAction(gg_trg_ChidoriNagashiLOOP, function Trig_ChidoriNagashiLOOP_Actions)
endfunction


