        call s__ObitoKamuiDimension_finish2(id)
    endfunction 
        
    function s__ObitoKamuiDimension_actions takes nothing returns nothing
        local integer id= (GetUnitUserData((GetTriggerUnit()))) // INLINED!!
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Obito_Dimension_D, 100, GetTriggerUnit())
        endif
        if not RectContainsUnit(gg_rct_DuelArena, GetTriggerUnit()) and not RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) then
            set s__s__ObitoKamuiDimension_xx[id]= GetUnitX(GetTriggerUnit())
            set s__s__ObitoKamuiDimension_yy[id]= GetUnitY(GetTriggerUnit())
            set s__s__ObitoKamuiDimension_u[id]= GetTriggerUnit()
            set s__s__ObitoKamuiDimension_t[id]= NewTimerEx(id)
            set s__ObitoKamuiDimension_ObitoDimension=CreateGroup()
            call CreateFogModifierRectBJ(true, GetTriggerPlayer(), FOG_OF_WAR_VISIBLE, gg_rct_KamuiDimensionObito)
            call SetPlayerAbilityAvailable(GetTriggerPlayer(), s__ObitoKamuiDimension_SPELL_ID, false)
            call UnitAddAbility(s__s__ObitoKamuiDimension_u[id], s__ObitoKamuiDimension_SPELL_ID_BACK)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__ObitoKamuiDimension_u[id]) ), ( 'h03U' ), (( GetUnitX(s__s__ObitoKamuiDimension_u[id]) )*1.0), (( GetUnitY(s__s__ObitoKamuiDimension_u[id]) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__ObitoKamuiDimension_u[id]) ), ( 'h03U' ), (( GetRectCenterX(gg_rct_KamuiDimensionObito) )*1.0), (( GetRectCenterY(gg_rct_KamuiDimensionObito) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__s__ObitoKamuiDimension_u[id]), GetUnitY(s__s__ObitoKamuiDimension_u[id]), 400.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call SetUnitPosition(bj_lastCreatedUnit, GetRectCenterX(gg_rct_KamuiDimensionObito), GetRectCenterY(gg_rct_KamuiDimensionObito))
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                        call PanCameraToTimedForPlayer(GetOwningPlayer(bj_lastCreatedUnit), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
                    endif
                    call GroupAddUnit(s__ObitoKamuiDimension_ObitoDimension, bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__s__ObitoKamuiDimension_isActive[id]= true
            call TimerStart(s__s__ObitoKamuiDimension_t[id], 10.0, false, function s__ObitoKamuiDimension_finish)
        endif
    endfunction
    
    function s__ObitoKamuiDimension_actions_back takes nothing returns nothing
        call s__ObitoKamuiDimension_finish2((GetUnitUserData((GetTriggerUnit())))) // INLINED!!
    endfunction
    
    function s__ObitoKamuiDimension_dies takes nothing returns nothing
        if s__s__ObitoKamuiDimension_isActive[(GetUnitUserData((GetTriggerUnit())))] then // INLINED!!
            call s__ObitoKamuiDimension_finish2((GetUnitUserData((GetTriggerUnit())))) // INLINED!!
        endif
    endfunction
    
    
    function s__ObitoKamuiDimension_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__ObitoKamuiDimension_dies))) // INLINED!!
        call RegisterSpellEffectEvent2((s__ObitoKamuiDimension_SPELL_ID ) , Filter(( function s__ObitoKamuiDimension_actions))) // INLINED!!
        call RegisterSpellEffectEvent2((s__ObitoKamuiDimension_SPELL_ID_BACK ) , Filter(( function s__ObitoKamuiDimension_actions_back))) // INLINED!!
    endfunction

