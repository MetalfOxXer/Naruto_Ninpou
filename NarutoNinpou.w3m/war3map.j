    function s__KillerBeeThrowInk_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= s__KillerBeeThrowInk_current_x[this]
        local real y= s__KillerBeeThrowInk_current_y[this]
        local real angle= Atan3(x , y , s__KillerBeeThrowInk_target_x[this] , s__KillerBeeThrowInk_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_z= 60 + ParabolaZ(300 , s__KillerBeeThrowInk_distance[this] , GetDistance(new_x , new_y , s__KillerBeeThrowInk_target_x[this] , s__KillerBeeThrowInk_target_y[this]))
        call BlzSetSpecialEffectX(s__KillerBeeThrowInk_missile[this], new_x)
        call BlzSetSpecialEffectY(s__KillerBeeThrowInk_missile[this], new_y)
        call BlzSetSpecialEffectHeight(s__KillerBeeThrowInk_missile[this], new_z)
        set s__KillerBeeThrowInk_current_x[this]=new_x
        set s__KillerBeeThrowInk_current_y[this]=new_y
        if GetDistance(new_x , new_y , s__KillerBeeThrowInk_target_x[this] , s__KillerBeeThrowInk_target_y[this]) < 50 then
            call DestroyEffect(s__KillerBeeThrowInk_missile[this])
