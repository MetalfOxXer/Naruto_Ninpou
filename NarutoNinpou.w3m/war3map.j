 endfunction 

 function s__KisameNewD_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer this2
  local real x
  local real y
  local real angle2
  local integer i
  local boolean close= true
  local unit u
		set bj_lastCreatedGroup=CreateGroup()
		call GroupAddGroup(s__KisameNewD_shark[this], bj_lastCreatedGroup)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			set angle2=Atan3(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , GetUnitX(s__KisameNewD_caster[this]) , GetUnitY(s__KisameNewD_caster[this]))
			set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( angle2 )*1.0)) * (( 25)*1.0)) // INLINED!!
			set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( angle2 )*1.0)) * (( 25)*1.0)) // INLINED!!
			call SetUnitX(bj_lastCreatedUnit, x)
			call SetUnitY(bj_lastCreatedUnit, y)
			//call SetUnitFacing(bj_lastCreatedUnit, Rad2Deg(angle2))
			if GetDistanceUnits(bj_lastCreatedUnit , s__KisameNewD_caster[this]) > 50 then
				set close=false
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if close then
			set i=0
			loop
				exitwhen i > 5
				set x=(((GetUnitX(s__KisameNewD_caster[this]) )*1.0) + Cos((( Deg2Rad(360 / 6 * i) )*1.0)) * (( 50)*1.0)) // INLINED!!
				set y=(((GetUnitY(s__KisameNewD_caster[this]) )*1.0) + Sin((( Deg2Rad(360 / 6 * i) )*1.0)) * (( 50)*1.0)) // INLINED!!
				call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
				set i=i + 1
			endloop
			call PauseUnit(s__KisameNewD_caster[this], false)
			call SetUnitAnimation(s__KisameNewD_caster[this], "death")
			set s__KisameNewD_damage[this]=GetUnitState(s__KisameNewD_caster[this], UNIT_STATE_MAX_LIFE) * 0.2
			call UnitDamageTarget(s__KisameNewD_caster[this], s__KisameNewD_caster[this], s__KisameNewD_damage[this], true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KisameNewD_caster[this]), GetUnitY(s__KisameNewD_caster[this]), 800, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KisameNewD_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
					set u=FirstOfGroup(s__KisameNewD_shark[this])
					if u != null then
						call GroupRemoveUnit(s__KisameNewD_shark[this], u)
						set this2=s__KisameNewD_allocate()
						set s__KisameNewD_caster[this2]=s__KisameNewD_caster[this]
						set s__KisameNewD_missile[this2]=u
						set s__KisameNewD_target[this2]=bj_lastCreatedUnit
						set s__KisameNewD_damage[this2]=s__KisameNewD_damage[this]
						call TimerStart(NewTimerEx(this2), 0.03, true, function s__KisameNewD_attack)
					endif
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__KisameNewD_shark[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__KisameNewD_shark[this], bj_lastCreatedUnit)
				call KillUnit(bj_lastCreatedUnit)
			endloop
			call DestroyGroup(s__KisameNewD_shark[this])
			set s__KisameNewD_shark[this]=null
			call KillUnit(s__KisameNewD_dome[this])
			set s__KisameNewD_dome[this]=null
			call s__KisameNewD_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

