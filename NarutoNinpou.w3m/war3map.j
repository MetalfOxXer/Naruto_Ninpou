        call UnitDamageTarget(s__ShisuiSilentKill_caster[this], s__ShisuiSilentKill_target[this], GetHeroAgi(s__ShisuiSilentKill_caster[this], true) * GetUnitAbilityLevel(s__ShisuiSilentKill_caster[this], 'A10Z'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
