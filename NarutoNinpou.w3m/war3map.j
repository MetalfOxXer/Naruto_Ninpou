            loop
                set angle=s__ShisuiCross_angle[this]
                call SetUnitFacing(s__ShisuiCross_caster[this], angle + 180)
                set x=(((s__ShisuiCross_target_x[this] )*1.0) + Cos((( Deg2Rad(angle + 45) )*1.0)) * (( ( - 350 + 75 * i ))*1.0)) // INLINED!!
                set y=(((s__ShisuiCross_target_y[this] )*1.0) + Sin((( Deg2Rad(angle + 45) )*1.0)) * (( ( - 350 + 75 * i ))*1.0)) // INLINED!!

                if GetUnitAbilityLevel(s__ShisuiCross_caster[this], 'A0S7') > 0 then
                    set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Grass_Explosion.mdl", x, y)
                    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
                    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
                    call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.6)*1.0) , false) // INLINED!!
                else
                    set bj_lastCreatedEffect=AddSpecialEffect("Ember.mdl", x, y)
                    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
                    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
                    call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.6)*1.0) , false) // INLINED!!
                endif

                call KillUnit(CreateUnit(GetOwningPlayer(s__ShisuiCross_caster[this]), 'e05W', x, y, GetRandomReal(0, 360)))
                set x2=(((s__ShisuiCross_target_x[this] )*1.0) + Cos((( Deg2Rad(angle - 45) )*1.0)) * (( ( - 350 + 75 * j ))*1.0)) // INLINED!!
                set y2=(((s__ShisuiCross_target_y[this] )*1.0) + Sin((( Deg2Rad(angle - 45) )*1.0)) * (( ( - 350 + 75 * j ))*1.0)) // INLINED!!

                if GetUnitAbilityLevel(s__ShisuiCross_caster[this], 'A0S7') > 0 then
                    set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Grass_Explosion.mdl", x2, y2)
                    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
                    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
                    call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.6)*1.0) , false) // INLINED!!
                else
                    set bj_lastCreatedEffect=AddSpecialEffect("Ember.mdl", x2, y2)
                    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 5.0)
                    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
                    call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.6)*1.0) , false) // INLINED!!
                endif

                call KillUnit(CreateUnit(GetOwningPlayer(s__ShisuiCross_caster[this]), 'e05W', x2, y2, GetRandomReal(0, 360)))
                set j=j + 1
                set i=i + 1
                exitwhen i > 10
            endloop
            //set bj_lastCreatedEffect = AddSpecialEffect("AnimationExplosion.mdx", this.target_x, this.target_y)
            //call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 40 + GetPointZ(this.target_x, this.target_y))
            //call DestroyEffect(bj_lastCreatedEffect)

            set bj_lastCreatedGroup=CreateGroup()
            set s__ShisuiCross_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ShisuiCross_target_x[this], s__ShisuiCross_target_y[this], 350.0, Filter(function s__ShisuiCross_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)

            if IsUnitVisible(s__ShisuiCross_caster[this], GetOwningPlayer(s__ShisuiCross_caster[this])) then
                call PlaySoundOnUnitBJ(gg_snd_Incinerate1, 80, GetTriggerUnit())
            endif
            call SetUnitVertexColor(s__ShisuiCross_caster[this], 255, 255, 255, 255)
            call ShowUnit(s__ShisuiCross_domo2[this], false)
            call KillUnit(s__ShisuiCross_domo2[this])
            set s__ShisuiCross_domo2[this]=null
            call s__ShisuiCross_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__ShisuiCross_actions takes nothing returns nothing
        local integer this= s__ShisuiCross_allocate()
        set s__ShisuiCross_caster[this]=GetTriggerUnit()
        set s__ShisuiCross_target_x[this]=GetSpellTargetX()
        set s__ShisuiCross_target_y[this]=GetSpellTargetY()
        set s__ShisuiCross_count[this]=0
        set s__ShisuiCross_domo2[this]=CreateUnit(GetTriggerPlayer(), 'h025', s__ShisuiCross_target_x[this], s__ShisuiCross_target_y[this], 270)
        set s__ShisuiCross_angle[this]=Atan3(GetUnitX(s__ShisuiCross_caster[this]) , GetUnitY(s__ShisuiCross_caster[this]) , s__ShisuiCross_target_x[this] , s__ShisuiCross_target_y[this])
        call SetUnitScale(s__ShisuiCross_domo2[this], 1, 1, 1)
        call SetUnitTimeScale(s__ShisuiCross_domo2[this], 2.0)
        call TimerStart(NewTimerEx(this), 0.025, true, function s__ShisuiCross_delay)
    endfunction
    
    function s__ShisuiCross_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(65 , s__ShisuiCross_SPELL_ID , function s__ShisuiCross_actions)
    endfunction
    
//===========================================================================
// Trigger: Kotoamatsukami
//
// Spell by : Vegagaruru
// (not finished)
//===========================================================================
function Trig_Kotoamatsukami_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == ( 'A13N' ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kotoamatsukami_Actions takes nothing returns nothing
    local integer i= 0
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Shisui_R, 80, GetTriggerUnit())
    endif
    set udg_komat_caster=GetTriggerUnit()
    set udg_komat_group=CreateGroup()
    //set udg_komat_target = GetSpellTargetUnit()
    set udg_komat_location=GetSpellTargetLoc() //GetUnitLoc(GetSpellTargetUnit())
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h068' ), GetOwningPlayer(udg_komat_caster), OffsetLocation(udg_komat_location, 0.00, 0.00), udg_komat_location)
    set udg_komat_dummy[7]=GetLastCreatedUnit()
    loop
	exitwhen i > 5
        call SetUnitVertexColor(udg_komat_dummy[7], 255, 255, 255, 20 * i)
        call TriggerSleepAction(0.005)
	set i=i + 1
    endloop
    call TriggerSleepAction(0.4)
    set bj_lastCreatedGroup=CreateGroup()
    call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetLocationX(udg_komat_location), GetLocationY(udg_komat_location), 350, null)
    loop
       set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
       exitwhen bj_lastCreatedUnit == null
       if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(udg_komat_caster)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
          call PauseUnit(bj_lastCreatedUnit, true)
          call GroupAddUnit(udg_komat_group, bj_lastCreatedUnit)
          call SetUnitVertexColor(bj_lastCreatedUnit, 100, 100, 100, 255)
       endif
       call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
    endloop
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h08J' ), GetOwningPlayer(udg_komat_caster), OffsetLocation(udg_komat_location, 0.00, 0.00), udg_komat_location)
    set udg_komat_dummy[1]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h08H' ), GetOwningPlayer(udg_komat_caster), PolarProjectionBJ(udg_komat_location, 300.00, ( 90.00 )), udg_komat_location)
    set udg_komat_dummy[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h08H' ), GetOwningPlayer(udg_komat_caster), PolarProjectionBJ(udg_komat_location, 300.00, ( 180.00 )), udg_komat_location)
    set udg_komat_dummy[4]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h08H' ), GetOwningPlayer(udg_komat_caster), PolarProjectionBJ(udg_komat_location, 300.00, ( 360.00 )), udg_komat_location)
    set udg_komat_dummy[5]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'h08H' ), GetOwningPlayer(udg_komat_caster), PolarProjectionBJ(udg_komat_location, 300.00, ( 640.00 )), udg_komat_location)
    set udg_komat_dummy[6]=GetLastCreatedUnit()
    call CreateNUnitsAtLocFacingLocBJ(1, ( 'e007' ), GetOwningPlayer(udg_komat_caster), OffsetLocation(udg_komat_location, 0.00, 0.00), udg_komat_location)
    set udg_komat_dummy[3]=GetLastCreatedUnit()
    //call PauseUnitBJ( true, udg_komat_target )
    call h__SetUnitVertexColorBJ(udg_komat_dummy[7], 100, 100, 100, 60.00)
    call h__SetUnitVertexColorBJ(udg_komat_dummy[6], 100, 50.00, 50.00, 60.00)
    call h__SetUnitVertexColorBJ(udg_komat_dummy[5], 100, 50.00, 50.00, 60.00)
    call h__SetUnitVertexColorBJ(udg_komat_dummy[4], 100, 50.00, 50.00, 60.00)
    call h__SetUnitVertexColorBJ(udg_komat_dummy[2], 100, 50.00, 50.00, 60.00)
    call EnableTrigger(gg_trg_Kamat_Loop)
    call EnableTrigger(gg_trg_Kamat_Loop_death_sentence)
    call EnableTrigger(gg_trg_Kamat_loop_2_Copy)
    call TriggerSleepAction(3.00)
    loop
	set bj_lastCreatedUnit=FirstOfGroup(udg_komat_group)
	exitwhen bj_lastCreatedUnit == null
	call PauseUnit(bj_lastCreatedUnit, false)
	call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
	call GroupRemoveUnit(udg_komat_group, bj_lastCreatedUnit)
    endloop
    call DestroyGroup(udg_komat_group)
    call RemoveUnit(udg_komat_dummy[1])
    call RemoveUnit(udg_komat_dummy[3])
    call RemoveUnit(udg_komat_dummy[4])
    call RemoveUnit(udg_komat_dummy[5])
    call RemoveUnit(udg_komat_dummy[6])
    call RemoveUnit(udg_komat_dummy[2])
    call RemoveUnit(udg_komat_dummy[7])
    call DisableTrigger(gg_trg_Kamat_Loop_death_sentence)
    call DisableTrigger(gg_trg_Kamat_loop_2_Copy)
    call DisableTrigger(gg_trg_Kamat_Loop)
    //call PauseUnitBJ( false, udg_komat_target )
    call RemoveLocation(udg_komat_location)
endfunction

//===========================================================================
function InitTrig_Kotoamatsukami takes nothing returns nothing
    set gg_trg_Kotoamatsukami=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Kotoamatsukami, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Kotoamatsukami, Condition(function Trig_Kotoamatsukami_Conditions))
    call TriggerAddAction(gg_trg_Kotoamatsukami, function Trig_Kotoamatsukami_Actions)
    call EnableTriggerForId(65 , gg_trg_Kotoamatsukami)
endfunction


//===========================================================================
// Trigger: Kamat Loop
//===========================================================================
function Trig_Kamat_Loop_Func001Func001C takes nothing returns boolean
    if ( not ( GetForLoopIndexA() != 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kamat_Loop_Actions takes nothing returns nothing
    set bj_forLoopAIndex=2
    set bj_forLoopAIndexEnd=6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Kamat_Loop_Func001Func001C() ) then
            call SetUnitTimeScalePercent(udg_komat_dummy[GetForLoopIndexA()], 200.00)
        else
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call SetUnitAnimation(udg_komat_dummy[2], "spell one")
    call SetUnitAnimation(udg_komat_dummy[4], "spell one")
    call SetUnitAnimation(udg_komat_dummy[5], "spell one")
    call SetUnitAnimation(udg_komat_dummy[6], "spell one")
endfunction

//===========================================================================
function InitTrig_Kamat_Loop takes nothing returns nothing
    set gg_trg_Kamat_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Kamat_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Kamat_Loop, 0.50)
    call TriggerAddAction(gg_trg_Kamat_Loop, function Trig_Kamat_Loop_Actions)
endfunction


//===========================================================================
// Trigger: Kamat Loop death sentence
//===========================================================================
function Trig_Kamat_Loop_death_sentence_DealDamage takes nothing returns boolean
    call UnitDamageTargetBJ(udg_komat_caster, GetEnumUnit(), ( ( 50.00 + ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_komat_caster, true)) / 4.00 ) ) * I2R(GetUnitAbilityLevelSwapped(( 'A13N' ), udg_komat_caster)) ), ATTACK_TYPE_MELEE, DAMAGE_TYPE_MAGIC)
    call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl")
    set udg_komat_thn[1]=GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ(GetUnitLoc(GetEnumUnit()), "Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl")
    set udg_komat_thn[2]=GetLastCreatedEffectBJ()
    return false
endfunction 

function Trig_Kamat_Loop_death_sentence_Actions takes nothing returns nothing
    set bj_lastCreatedGroup=CreateGroup()
    call GroupAddGroup(udg_komat_group, bj_lastCreatedGroup)
    call ForGroupBJ(bj_lastCreatedGroup, function Trig_Kamat_Loop_death_sentence_DealDamage)
    call DestroyGroup(bj_lastCreatedGroup)
endfunction

//===========================================================================
function InitTrig_Kamat_Loop_death_sentence takes nothing returns nothing
    set gg_trg_Kamat_Loop_death_sentence=CreateTrigger()
    call DisableTrigger(gg_trg_Kamat_Loop_death_sentence)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Kamat_Loop_death_sentence, 0.25)
    call TriggerAddAction(gg_trg_Kamat_Loop_death_sentence, function Trig_Kamat_Loop_death_sentence_Actions)
endfunction


//===========================================================================
// Trigger: Kamat loop 2 Copy
//===========================================================================
function Trig_Kamat_loop_2_Copy_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == ( 'A13N' ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kamat_loop_2_Copy_Actions takes nothing returns nothing
    call TriggerSleepAction(2.75)
    set udg_shushadow_direct=R2I(AngleBetweenPoints(GetUnitLoc(udg_komat_dummy[5]), udg_komat_location))
    call SetUnitPositionLoc(udg_komat_dummy[5], PolarProjectionBJ(udg_komat_location, 90.00, I2R(udg_shushadow_direct)))
    call AddSpecialEffectLocBJ(udg_komat_location, "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl")
    call AddSpecialEffectLocBJ(udg_komat_location, "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
    //call SetUnitAnimation( udg_komat_target, "death" )
    call DisableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_Kamat_loop_2_Copy takes nothing returns nothing
    set gg_trg_Kamat_loop_2_Copy=CreateTrigger()
    call DisableTrigger(gg_trg_Kamat_loop_2_Copy)
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Kamat_loop_2_Copy, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Kamat_loop_2_Copy, Condition(function Trig_Kamat_loop_2_Copy_Conditions))
    call TriggerAddAction(gg_trg_Kamat_loop_2_Copy, function Trig_Kamat_loop_2_Copy_Actions)
endfunction


//===========================================================================
// Trigger: ShisuiBonesPassive
//===========================================================================

    function s__ShisuiBonesPassive_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if GetUnitAbilityLevel(u, 'A0S7') > 0 then
            call UnitAddAbility(u, 'A0B1')
            call ReleaseTimer(GetExpiredTimer())
        elseif GetUnitAbilityLevel(u, 'A0RI') > 0 then
            call ReleaseTimer(GetExpiredTimer())
        endif
        set u=null
    endfunction 

    function s__ShisuiBonesPassive_actions takes nothing returns nothing
        call TimerStartEx(NewTimerEx((GetUnitUserData((GetTriggerUnit())))) , 1.0 , true , function s__ShisuiBonesPassive_periodic , "ShisuiBones_periodic") // INLINED!!
    endfunction 

    function s__ShisuiBonesPassive_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(65 , 'A0SJ' , function s__ShisuiBonesPassive_actions)
    endfunction 

//===========================================================================
// Trigger: ShisuiSusanoo
//===========================================================================

//Implemented from module Alloc:
    
        function s__ShisuiSusanoo_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShisuiSusanoo_Alloc___recycle[(0)] == 0 ) then
                set s__ShisuiSusanoo_Alloc___instanceCount=s__ShisuiSusanoo_Alloc___instanceCount + 1
                set this=s__ShisuiSusanoo_Alloc___instanceCount
            else
                set this=s__ShisuiSusanoo_Alloc___recycle[(0)]
                set s__ShisuiSusanoo_Alloc___recycle[(0)]=s__ShisuiSusanoo_Alloc___recycle[s__ShisuiSusanoo_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShisuiSusanoo_deallocate takes integer this returns nothing
            set s__ShisuiSusanoo_Alloc___recycle[this]=s__ShisuiSusanoo_Alloc___recycle[(0)]
            set s__ShisuiSusanoo_Alloc___recycle[(0)]=this
        endfunction
    
    function s__ShisuiSusanoo_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ShisuiSusanoo_caster[this])
        local real y= GetUnitY(s__ShisuiSusanoo_caster[this])
        local real offset= GetRandomReal(0, 1000)
        local real angle= s__ShisuiSusanoo_angle[this] + GetRandomReal(Deg2Rad(- 45), Deg2Rad(45))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local group g
        local group damaged
        local unit needle
        local integer i
        set new_x=(((new_x )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 150)*1.0)) // INLINED!!
        set new_y=(((new_y )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 150)*1.0)) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ShisuiSusanoo_caster[this]), 'h08M', new_x, new_y, Rad2Deg(s__ShisuiSusanoo_angle[this]))
        call GroupAddUnit(s__ShisuiSusanoo_needles[this], bj_lastCreatedUnit)
        set offset=GetRandomReal(0, 1000)
        set angle=s__ShisuiSusanoo_angle[this] + GetRandomReal(Deg2Rad(- 45), Deg2Rad(45))
        set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set new_x=(((new_x )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 150)*1.0)) // INLINED!!
        set new_y=(((new_y )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 150)*1.0)) // INLINED!!
        if IsUnitPaused(s__ShisuiSusanoo_caster[this]) == false then
            call PauseUnit(s__ShisuiSusanoo_caster[this], true)
        endif
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ShisuiSusanoo_caster[this]), 'h08M', new_x, new_y, Rad2Deg(s__ShisuiSusanoo_angle[this]))
        call GroupAddUnit(s__ShisuiSusanoo_needles[this], bj_lastCreatedUnit)
        set damaged=CreateGroup()
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ShisuiSusanoo_needles[this], bj_lastCreatedGroup)
        loop
            set needle=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen needle == null
            set new_x=(((GetUnitX(needle) )*1.0) + Cos((( s__ShisuiSusanoo_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            set new_y=(((GetUnitY(needle) )*1.0) + Sin((( s__ShisuiSusanoo_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            call SetUnitX(needle, new_x)
            call SetUnitY(needle, new_y)
            if GetDistance(GetUnitX(s__ShisuiSusanoo_caster[this]) , GetUnitY(s__ShisuiSusanoo_caster[this]) , new_x , new_y) > 800 then
                call KillUnit(needle)
                call ShowUnit(needle, false)
                call GroupRemoveUnit(s__ShisuiSusanoo_needles[this], needle)
            else
                set g=CreateGroup()
                call GroupEnumUnitsInRange(g, new_x, new_y, 220.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(g)
                    exitwhen bj_lastCreatedUnit == null
                    if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ShisuiSusanoo_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                        call GroupAddUnit(damaged, bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(g, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(g)
                set g=null
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, needle)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(damaged)
            exitwhen bj_lastCreatedUnit == null
            if ModuloInteger(s__ShisuiSusanoo_count[this], 5) == 0 then
                call KillUnit(CreateUnit(GetOwningPlayer(s__ShisuiSusanoo_caster[this]), 'h08N', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), GetRandomReal(0, 360)))
                call DestroyEffect(AddSpecialEffect(("war3mapImported\\wanhuajing.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
            endif
            call UnitDamageTarget(s__ShisuiSusanoo_caster[this], bj_lastCreatedUnit, 13.0 / 100.0 * GetHeroAgi(s__ShisuiSusanoo_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            call GroupRemoveUnit(damaged, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(damaged)
        set damaged=null
        set s__ShisuiSusanoo_count[this]=s__ShisuiSusanoo_count[this] + 1
        if s__ShisuiSusanoo_count[this] >= 100 then
            call KillUnit(s__ShisuiSusanoo_susanoo[this])
            set s__ShisuiSusanoo_susanoo[this]=null
            call PauseUnit(s__ShisuiSusanoo_caster[this], false)
            call SetUnitInvulnerable(s__ShisuiSusanoo_caster[this], false)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__ShisuiSusanoo_needles[this])
                exitwhen bj_lastCreatedUnit == null
                call KillUnit(bj_lastCreatedUnit)
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__ShisuiSusanoo_needles[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__ShisuiSusanoo_needles[this])
            set s__ShisuiSusanoo_needles[this]=null
            call s__ShisuiSusanoo_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__ShisuiSusanoo_fadeIn takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__ShisuiSusanoo_count[this]=s__ShisuiSusanoo_count[this] + 1
        call SetUnitVertexColor((s__ShisuiSusanoo_susanoo[this] ), ( 255 ), ( 255 ), ( 255 ), ( R2I(200 / 15.0 * s__ShisuiSusanoo_count[this]))) // INLINED!!
        if s__ShisuiSusanoo_count[this] > 15 then
            call SetUnitAnimation(s__ShisuiSusanoo_susanoo[this], "spell throw")
            set s__ShisuiSusanoo_count[this]=0
            call AddLoadingBar(s__ShisuiSusanoo_caster[this] , 3.0)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__ShisuiSusanoo_periodic)
            call ReleaseTimer(GetExpiredTimer())
        endif
