    function s__KidomaruNet_periodic2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle=  Atan3(GetUnitX(s__KidomaruNet_target[this]) , GetUnitY(s__KidomaruNet_target[this]) , GetUnitX(s__KidomaruNet_spider[this]) , GetUnitY(s__KidomaruNet_spider[this]))
        local real new_x= (((GetUnitX(s__KidomaruNet_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__KidomaruNet_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__KidomaruNet_count[this]=s__KidomaruNet_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetUnitAbilityLevel(s__KidomaruNet_target[this], 'B017') < 1 then
            if GetDistance(GetUnitX(s__KidomaruNet_spider[this]) , GetUnitY(s__KidomaruNet_spider[this]) , new_x , new_y) >= 50 then
                call SetUnitX(s__KidomaruNet_target[this], new_x)
                call SetUnitY(s__KidomaruNet_target[this], new_y)
            endif
        endif
        if s__KidomaruNet_count[this] > 33 + 5 * GetUnitAbilityLevel(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID) or GetWidgetLife(s__KidomaruNet_target[this]) < 0.405 or GetWidgetLife(s__KidomaruNet_caster[this]) < 0.405 or not UnitAlive(s__KidomaruNet_caster[this]) or GetDistance(GetUnitX(s__KidomaruNet_spider[this]) , GetUnitY(s__KidomaruNet_spider[this]) , GetUnitX(s__KidomaruNet_target[this]) , GetUnitY(s__KidomaruNet_target[this])) >= 1200 then
            call KillUnit(s__KidomaruNet_missile[this])
            call KillUnit(s__KidomaruNet_spider[this])
            call ShowUnit(s__KidomaruNet_spider[this], false)
            set s__KidomaruNet_spider[this]=null
            set s__KidomaruNet_secondspell=false
            call BlzEndUnitAbilityCooldown(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID)
            call BlzStartUnitAbilityCooldown(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID, 15 + 0.5 * GetUnitAbilityLevel(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID))
            call s__KidomaruNet_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
        call SetUnitX(s__KidomaruNet_missile[this], GetUnitX(s__KidomaruNet_target[this]))
        call SetUnitY(s__KidomaruNet_missile[this], GetUnitY(s__KidomaruNet_target[this]))
    endfunction 

    function s__KidomaruNet_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KidomaruNet_missile[this])
        local real y= GetUnitY(s__KidomaruNet_missile[this])
        local real new_x= (((x )*1.0) + Cos((( s__KidomaruNet_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KidomaruNet_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
        call SetUnitX(s__KidomaruNet_missile[this], new_x)
        call SetUnitY(s__KidomaruNet_missile[this], new_y)
        set s__KidomaruNet_count[this]=s__KidomaruNet_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 130, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KidomaruNet_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                set s__KidomaruNet_target[this]=bj_lastCreatedUnit
                call UnitDamageTarget(s__KidomaruNet_caster[this], s__KidomaruNet_target[this], 30 * GetUnitAbilityLevel(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                if GetUnitAbilityLevel(s__KidomaruNet_caster[this], s__KidomaruNet_SPELL_ID) == 10 then
                    call BlzEndUnitAbilityCooldown(s__KidomaruNet_caster[this], 'A19V')
                    set s__KidomaruNet_secondspell=true
                endif
                call TimerStart(NewTimerEx(this), 0.03, true, function s__KidomaruNet_periodic2)
                set s__KidomaruNet_count[this]=0
                exitwhen true
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KidomaruNet_target[this] == null then
            if s__KidomaruNet_count[this] > 18.5 then
                call KillUnit(s__KidomaruNet_spider[this])
                call ShowUnit(s__KidomaruNet_spider[this], false)
                set s__KidomaruNet_spider[this]=null
                call KillUnit(s__KidomaruNet_missile[this])
                call ReleaseTimer(GetExpiredTimer())
            endif
        else
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__KidomaruNet_periodicChains takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle
        local real new_x
        local real new_y
        local real dx
        local real dy
        local real dz
        local real height
        local real distance
     local real offset
        if GetWidgetLife(s__KidomaruNet_missile[this]) < 0.405 then
            loop
                set s__KidomaruNet_count_chain[this]=s__KidomaruNet_count_chain[this] - 1
                if s__KidomaruNet_count_chain[this] < 0 then
                    exitwhen true
                else
                    call DestroyEffect(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]])
                    set s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]]= null
                endif
            endloop
            set s__KidomaruNet_missile[this]=null
            call s__KidomaruNet_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        else
            set angle=Atan3(GetUnitX(s__KidomaruNet_spider[this]) , GetUnitY(s__KidomaruNet_spider[this]) , GetUnitX(s__KidomaruNet_missile[this]) , GetUnitY(s__KidomaruNet_missile[this]))
            loop
                set s__KidomaruNet_count_chain[this]=s__KidomaruNet_count_chain[this] - 1
                if s__KidomaruNet_count_chain[this] < 0 then
                    exitwhen true
                else
                    call BlzSetSpecialEffectX(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]], 5180)
                    call BlzSetSpecialEffectY(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]], - 6940)
                    call BlzSetSpecialEffectScale(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]], 0)
                    call DestroyEffect(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]])
                    set s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]]= null
                endif
            endloop
            set s__KidomaruNet_count_chain[this]=0
            set distance=GetDistanceUnits(s__KidomaruNet_spider[this] , s__KidomaruNet_missile[this])
            loop
                set offset=50
                set new_x=(((GetUnitX(s__KidomaruNet_spider[this]) )*1.0) + Cos((( angle )*1.0)) * (( offset * s__KidomaruNet_count_chain[this])*1.0)) // INLINED!!
                set new_y=(((GetUnitY(s__KidomaruNet_spider[this]) )*1.0) + Sin((( angle )*1.0)) * (( offset * s__KidomaruNet_count_chain[this])*1.0)) // INLINED!!
                if GetDistance(new_x , new_y , GetUnitX(s__KidomaruNet_missile[this]) , GetUnitY(s__KidomaruNet_missile[this])) < 50 then
                    exitwhen true
                else
                    set s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]]= AddSpecialEffect("war3mapImported\\Webmissile.mdx", new_x, new_y)
                    call BlzSetSpecialEffectYaw(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count_chain[this]], angle + bj_PI / 2)
                    //call BlzSetSpecialEffectPitch(chains[this][this.count_chain], Deg2Rad(-45.0))
                    call BlzSetSpecialEffectScale(s__s__KidomaruNet_chains[(this)*(1)+s__KidomaruNet_count[this]], 0.5)
                    //call BlzSetSpecialEffectHeight(chains[this][this.count_chain], 100 + GetPointZ(new_x, new_y))
                    set s__s__KidomaruNet_chains_x[(this)*(1)+s__KidomaruNet_count_chain[this]]= new_x
                    set s__s__KidomaruNet_chains_y[(this)*(1)+s__KidomaruNet_count_chain[this]]= new_y
                    set s__KidomaruNet_count_chain[this]=s__KidomaruNet_count_chain[this] + 1
                endif
            endloop
        endif
    endfunction 

    function s__KidomaruNet_actions takes nothing returns nothing
        local integer this= s__KidomaruNet_allocate()
        local real x
        local real y
        local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
        if not s__KidomaruNet_secondspell then
            set s__KidomaruNet_caster[this]=GetTriggerUnit()
            set s__KidomaruNet_target[this]=null
            set s__KidomaruNet_angle[this]=Atan3(GetUnitX(s__KidomaruNet_caster[this]) , GetUnitY(s__KidomaruNet_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
            set x=(((GetUnitX(s__KidomaruNet_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__KidomaruNet_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
            set s__KidomaruNet_spider[this]=CreateUnit(GetTriggerPlayer(), 'h04U', x, y, 270)
            call SetUnitFacing(s__KidomaruNet_spider[this], Rad2Deg(s__KidomaruNet_angle[this]))
            set s__KidomaruNet_missile[this]=CreateUnit(GetTriggerPlayer(), 'e007', x, y, 270)
            call SetUnitScale(s__KidomaruNet_spider[this], 0.75, 0.75, 0.75)
            call SetUnitFlyHeight(s__KidomaruNet_spider[this], 0, 0)
            set s__KidomaruNet_count[this]=0
            set s__KidomaruNet_count_chain[this]=0
            call TimerStart(NewTimerEx(this), 0.04, true, function s__KidomaruNet_periodic)
            call TimerStart(NewTimerEx(this), 0.05, true, function s__KidomaruNet_periodicChains)
        else
            call sc__KidomaruTripleArrow_actions(GetTriggerUnit() , angle)
            set s__KidomaruNet_secondspell=false
        endif
    endfunction 

    function s__KidomaruNet_onInit takes nothing returns nothing
        set s__KidomaruNet_secondspell=false
        call RegisterSpellEffectEventForId(88 , s__KidomaruNet_SPELL_ID , function s__KidomaruNet_actions)
    endfunction 

