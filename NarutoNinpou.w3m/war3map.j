// Trigger: NagatoDevaArea
//===========================================================================

//Implemented from module Alloc:
    
        function s__NagatoDevaArea_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__NagatoDevaArea_Alloc___recycle[(0)] == 0 ) then
                set s__NagatoDevaArea_Alloc___instanceCount=s__NagatoDevaArea_Alloc___instanceCount + 1
                set this=s__NagatoDevaArea_Alloc___instanceCount
            else
                set this=s__NagatoDevaArea_Alloc___recycle[(0)]
                set s__NagatoDevaArea_Alloc___recycle[(0)]=s__NagatoDevaArea_Alloc___recycle[s__NagatoDevaArea_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__NagatoDevaArea_deallocate takes integer this returns nothing
            set s__NagatoDevaArea_Alloc___recycle[this]=s__NagatoDevaArea_Alloc___recycle[(0)]
            set s__NagatoDevaArea_Alloc___recycle[(0)]=this
        endfunction
    
    
    function s__NagatoDevaArea_removeInvulnerability takes nothing returns nothing
        call SetUnitInvulnerable((s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]), false) // INLINED!!
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__NagatoDevaArea_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        set s__NagatoDevaArea_count[this]=s__NagatoDevaArea_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__NagatoDevaArea_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            set x=GetUnitX(bj_lastCreatedUnit)
            set y=GetUnitY(bj_lastCreatedUnit)
            set angle=Atan3(s__NagatoDevaArea_origin_x[this] , s__NagatoDevaArea_origin_y[this] , x , y)
            set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            call UnitAddAbility(bj_lastCreatedUnit, 'Arav')
            call UnitRemoveAbility(bj_lastCreatedUnit, 'Arav')
            call SetUnitFlyHeight(bj_lastCreatedUnit, ParabolaZ(500 , 20 , s__NagatoDevaArea_count[this]), 0)
            if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                call SetUnitX(bj_lastCreatedUnit, new_x)
                call SetUnitY(bj_lastCreatedUnit, new_y)
                call SetUnitFacing(bj_lastCreatedUnit, Rad2Deg(angle))
                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__NagatoDevaArea_count[this] > 20 then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__NagatoDevaArea_damaged[this])
                exitwhen bj_lastCreatedUnit == null
                call PauseUnit(bj_lastCreatedUnit, false)
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 0)
                call SetUnitAnimation(bj_lastCreatedUnit, "death")
                call GroupRemoveUnit(s__NagatoDevaArea_damaged[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__NagatoDevaArea_damaged[this])
            set s__NagatoDevaArea_damaged[this]=null
            call s__NagatoDevaArea_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NagatoDevaArea_actions takes unit caster returns nothing
        local integer this
        //local integer i  
        set this=s__NagatoDevaArea_allocate()
        set s__NagatoDevaArea_caster[this]=caster
        set bj_lastCreatedUnit=CreateAbilityDummy(caster , 'A02A')
        call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", caster)
        
	
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(caster) ), ( 'n01P' ), (( GetUnitX(caster) )*1.0), (( GetUnitY(caster) )*1.0), (( 270)*1.0))) // INLINED!!
            call SetUnitX(bj_lastCreatedUnit, GetUnitX(caster))
