	    else
            	set s__s__KaguyaDimensionTravel___Spell_teleport1[id]= CreateUnit(GetTriggerPlayer(), 'h09E', new_x, new_y, GetUnitFacing(GetTriggerUnit()))
            	call UnitApplyTimedLife(s__s__KaguyaDimensionTravel___Spell_teleport1[id], 'BTLF', 20.0)
            	call UnitApplyTimedLife(CreateUnit(GetTriggerPlayer(), 'h03U', new_x, new_y, GetUnitFacing(GetTriggerUnit())), 'BTLF', 20.0)
            	set s__s__KaguyaDimensionTravel___Spell_teleport2[id]= CreateUnit(GetTriggerPlayer(), 'h09E', target_x, target_y, GetUnitFacing(GetTriggerUnit()))
            	call UnitApplyTimedLife(CreateUnit(GetTriggerPlayer(), 'h03U', target_x, target_y, GetUnitFacing(GetTriggerUnit())), 'BTLF', 20.0)
            	call UnitApplyTimedLife(s__s__KaguyaDimensionTravel___Spell_teleport2[id], 'BTLF', 20.0)
	    	set new_x=(((target_x )*1.0) + Cos((( Atan3(caster_x , caster_y , target_x , target_y) )*1.0)) * (( 400)*1.0)) // INLINED!!
	    	set new_y=(((target_y )*1.0) + Sin((( Atan3(caster_x , caster_y , target_x , target_y) )*1.0)) * (( 400)*1.0)) // INLINED!!
