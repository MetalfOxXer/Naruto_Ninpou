        if GetUnitTypeId(GetTriggerUnit()) == 'O006' then
			call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A04Y', false)
			call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 0.01, false, function s__SaiBirdForm_delay) // INLINED!!
