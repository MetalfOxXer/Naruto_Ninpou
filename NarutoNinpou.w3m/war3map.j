		set s__KimimaroKaramatsu_count2[this]=s__KimimaroKaramatsu_count2[this] + 1
		if new_dist < 50 or s__KimimaroKaramatsu_count2[this] >= 30 then
			call SlowArea(s__KimimaroKaramatsu_caster[this] , s__KimimaroKaramatsu_target_x[this] , s__KimimaroKaramatsu_target_y[this] , 300)
			
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KimimaroKaramatsu_target_x[this], s__KimimaroKaramatsu_target_y[this], 300, null)
