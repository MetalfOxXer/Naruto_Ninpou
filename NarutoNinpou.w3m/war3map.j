		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Pillar of Flame Orange.mdl" ), (( GetUnitX(s__SubjugationOfEarth_target[this]) )*1.0), (( GetUnitY(s__SubjugationOfEarth_target[this]))*1.0))) // INLINED!!
