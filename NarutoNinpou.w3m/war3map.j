    function s__SasoriSenbons_destroy takes integer this returns nothing
        local integer i
        set i=0
        loop
            exitwhen i > 8
            call KillUnit(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i])
            call ShowUnit(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i], false)
            set s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]=null
            set i=i + 1
        endloop
        call DestroyGroup(s__SasoriSenbons_damaged[this])
        set s__SasoriSenbons_caster[this]=null
        set s__SasoriSenbons_damaged[this]=null
        call s__SasoriSenbons_deallocate(this)
    endfunction
    
    function s__SasoriSenbons_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x
        local real y
        set i=0
        loop
            exitwhen i > 8
            set x=(((GetUnitX(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i])) )*1.0)) * (( 25.0)*1.0)) // INLINED!!
            set y=(((GetUnitY(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i])) )*1.0)) * (( 25.0)*1.0)) // INLINED!!
            //if ModuloInteger(this.count, 3) == 0 then
            //    call AddSpecialEffectEx("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", GetUnitX(this.senbons[i]), GetUnitY(this.senbons[i]))
            //endif
            call SetUnitX(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i], x)
            call SetUnitY(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i], y)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 110.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriSenbons_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__SasoriSenbons_damaged[this]) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__SasoriSenbons_caster[this], bj_lastCreatedUnit, GetHeroStr(s__SasoriSenbons_caster[this], true) * GetUnitAbilityLevel(s__SasoriSenbons_caster[this], s__SasoriSenbons_SPELL_ID) / 3.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\wanhuajing.mdx" ), (( GetUnitX(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]) )*1.0), (( GetUnitY(s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]))*1.0))) // INLINED!!
                    call GroupAddUnit(s__SasoriSenbons_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=i + 1
        endloop
        set s__SasoriSenbons_count[this]=s__SasoriSenbons_count[this] + 1
        if s__SasoriSenbons_count[this] > 40 then
