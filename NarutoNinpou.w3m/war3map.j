    function s__TobiramaWaveUlt_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                if RectContainsUnit(gg_rct_DuelArena, GetFilterUnit()) and not RectContainsUnit(gg_rct_DuelArena, s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance]) then
                elseif RectContainsUnit(gg_rct_MissionB, GetFilterUnit()) and ( s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance] != udg_MissionBUnit ) then
		elseif RectContainsUnit(gg_rct_MissionA, GetFilterUnit()) and ( s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance] != udg_MissionAUnit ) then
		elseif RectContainsUnit(gg_rct_MissionS, GetFilterUnit()) and ( s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance] != udg_MissionSUnit ) then
	    	else
            		call UnitDamageTarget(s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance], GetFilterUnit(), 500 + ( ( 7 + RMinBJ(5000, s__TobiramaWaveUlt_range[s__TobiramaWaveUlt_instance]) / 1000 ) * GetHeroAgi(s__TobiramaWaveUlt_caster[s__TobiramaWaveUlt_instance], true) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	    	endif
        endif
        return false
    endfunction 

 function s__TobiramaWaveUlt_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__TobiramaWaveUlt_dummy[this])
  local real y= GetUnitY(s__TobiramaWaveUlt_dummy[this])
  local real angle= Atan3(x , y , s__TobiramaWaveUlt_target_x[this] , s__TobiramaWaveUlt_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
        local integer i= 0
        local integer j
        local real x1
        local real y1
		call SetUnitX(s__TobiramaWaveUlt_dummy[this], new_x)
		call SetUnitY(s__TobiramaWaveUlt_dummy[this], new_y)
		call SetUnitX(s__TobiramaWaveUlt_caster[this], new_x)
		call SetUnitY(s__TobiramaWaveUlt_caster[this], new_y)
		call SetUnitFacing(s__TobiramaWaveUlt_dummy[this], Rad2Deg(angle))
		call SetUnitFacing(s__TobiramaWaveUlt_caster[this], Rad2Deg(angle))
		set s__TobiramaWaveUlt_count[this]=s__TobiramaWaveUlt_count[this] + 1
        set s__TobiramaWaveUlt_range[this]=s__TobiramaWaveUlt_range[this] + 50
		if ModuloInteger(s__TobiramaWaveUlt_count[this], 5) == 0 then
			//set bj_lastCreatedEffect = AddSpecialEffect("DustWaveGeneric.mdx", new_x, new_y)
			//call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
			//call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 100 + GetPointZ(new_x, new_y))
			//call DestroyEffect(bj_lastCreatedEffect)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TobiramaWaveUlt_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                set s__TobiramaWaveUlt_target_x[this]=GetUnitX(bj_lastCreatedUnit)
                set s__TobiramaWaveUlt_target_y[this]=GetUnitY(bj_lastCreatedUnit)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
		if GetDistance(new_x , new_y , s__TobiramaWaveUlt_target_x[this] , s__TobiramaWaveUlt_target_y[this]) < 100 then
			set bj_lastCreatedGroup=CreateGroup()
            set s__TobiramaWaveUlt_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__TobiramaWaveUlt_target_x[this], s__TobiramaWaveUlt_target_y[this], 400.0, Filter(function s__TobiramaWaveUlt_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
        loop
            exitwhen i > 5
            set j=0
            loop
                set j=j + 1
                exitwhen j > 6
                set x=(((GetUnitX(s__TobiramaWaveUlt_caster[this]) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( i + 1 ))*1.0)) // INLINED!!
                set y=(((GetUnitY(s__TobiramaWaveUlt_caster[this]) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( i + 1 ))*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("s_WaterNovaTarget.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            endloop
            set i=i + 1
        endloop
			set bj_lastCreatedEffect=AddSpecialEffect("s_WaterNovaTarget.mdx", s__TobiramaWaveUlt_target_x[this], s__TobiramaWaveUlt_target_y[this])
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
			call DestroyEffect(bj_lastCreatedEffect)
			call SlowArea(s__TobiramaWaveUlt_caster[this] , s__TobiramaWaveUlt_target_x[this] , s__TobiramaWaveUlt_target_y[this] , 400)
	    		call DestroyEffect(AddSpecialEffect(("s_WaterNovaTarget.mdx" ), (( s__TobiramaWaveUlt_target_x[this] )*1.0), (( s__TobiramaWaveUlt_target_y[this])*1.0))) // INLINED!!
			call KillUnit(s__TobiramaWaveUlt_dummy[this])
			call ShowUnit(s__TobiramaWaveUlt_dummy[this], false)
			set s__TobiramaWaveUlt_dummy[this]=null
			call s__TobiramaWaveUlt_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction

 function s__TobiramaWaveUlt_actions takes nothing returns nothing
  local integer this= s__TobiramaWaveUlt_allocate()
		set s__TobiramaWaveUlt_caster[this]=GetTriggerUnit()
		set s__TobiramaWaveUlt_target_x[this]=GetSpellTargetX()
		set s__TobiramaWaveUlt_target_y[this]=GetSpellTargetY()
		set s__TobiramaWaveUlt_count[this]=0
        	if IsUnitVisible(s__TobiramaWaveUlt_caster[this], GetLocalPlayer()) then
	    		call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Tobirama: This is the power of the Hokage!")
