		call UnitRemoveAbility((s__UnitDex_Unit[(i)]), 'Arav') // INLINED!!
		call TimerStart(NewTimerEx(i), 0.1, true, function s__SaiBirdForm_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

