        set s__YaguraSemiNew_bijuu[this]=CreateUnit(GetTriggerPlayer(), 'h09C', GetUnitX(s__YaguraSemiNew_caster[this]), GetUnitY(s__YaguraSemiNew_caster[this]), GetUnitFacing(s__YaguraSemiNew_caster[this]))
	call SetUnitScale(s__YaguraSemiNew_bijuu[this], 0.4, 0, 0)
        call SetUnitAnimation(s__YaguraSemiNew_bijuu[this], "spell slam")
	call SetUnitTimeScale(s__YaguraSemiNew_bijuu[this], 1.0)
        call PauseUnit(s__YaguraSemiNew_caster[this], true)
        call SetUnitVertexColor((s__YaguraSemiNew_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 0)) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.2, false, function s__YaguraSemiNew_delay)
    endfunction 
    
