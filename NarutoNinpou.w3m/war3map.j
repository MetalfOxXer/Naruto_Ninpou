        function s__TayuyaT_MoveProjectile takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local unit projectile
            local unit target
            local location loc
            local location loc2
            local real dmg
            local real dx
            local real dy
            local real distance
            local real speed= 16.0
            local integer i= 0
            loop
                set i=i + 1
                exitwhen i > 3
                if IsUnitAliveBJ(s__TayuyaTAbility__projectileUnits[i - 1]) then
                    set projectile=s__TayuyaTAbility__projectileUnits[i - 1]
                    set target=s__TayuyaTAbility__projectileTargets[i - 1]
                    set loc=GetUnitLoc(s__TayuyaTAbility__projectileUnits[i - 1])
                    set loc2=GetUnitLoc(s__TayuyaTAbility__projectileTargets[i - 1])
                    set dx=GetUnitX(target) - GetUnitX(projectile)
                    set dy=GetUnitY(target) - GetUnitY(projectile)
                    set distance=SquareRoot(dx * dx + dy * dy)
                    if distance < 20.0 then
                        // Apply damage or mana reduction
                        set dmg=GetUnitState(target, UNIT_STATE_MAX_MANA) * 0.05
                        if dmg >= 350 then
                            set dmg=350
                        elseif dmg <= 200 then
                            set dmg=200
                        endif

                        call UnitDamageTarget(TayuyaCore_Tayuya, target, dmg + ( GetHeroInt(TayuyaCore_Tayuya, true) + GetHeroStr(TayuyaCore_Tayuya, true) + GetHeroAgi(TayuyaCore_Tayuya, true) ) / 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        if not (UnitHasItemOfTypeBJ((target ), ( 'I04T'))) and BlzGetUnitRealField(target, UNIT_RF_MANA) >= BlzGetUnitMaxMana(target) * 0.20 then // INLINED!!
                            call SetUnitManaBJ(target, RMaxBJ(BlzGetUnitMaxMana(target) * 0.20, BlzGetUnitRealField(target, UNIT_RF_MANA) * 0.80))
                        endif
                        
                        call KillUnit((CreateUnit((GetOwningPlayer(target) ), ( 'h05L' ), (( GetUnitX(target) )*1.0), (( GetUnitY(target) )*1.0), (( GetRandomReal(0, 360))*1.0)))) // INLINED!!
                        set s__TayuyaTAbility__projectileTargets[i - 1]= null
                        call RemoveUnit(s__TayuyaTAbility__projectileUnits[i - 1])
                        call s__TayuyaT_deallocate(this)
                        call ReleaseTimer(GetExpiredTimer())
                        call RemoveLocation(loc)
                        call RemoveLocation(loc2)
                    else
                        call SetUnitFacing(s__TayuyaTAbility__projectileUnits[i - 1], AngleBetweenPoints(loc, loc2))
                        call SetUnitX(projectile, GetUnitX(projectile) + ( dx / distance ) * speed)
                        call SetUnitY(projectile, GetUnitY(projectile) + ( dy / distance ) * speed)
                        call RemoveLocation(loc)
                        call RemoveLocation(loc2)
                    endif
                endif
            endloop
        endfunction

