	call ShowUnit(s__HiruzenEdoKongoRoheki_cage[this], false)
        set s__HiruzenEdoKongoRoheki_caster[this]=null
        set s__HiruzenEdoKongoRoheki_target[this]=null
        set s__HiruzenEdoKongoRoheki_cage[this]=null
        call s__HiruzenEdoKongoRoheki_deallocate(this)
    endfunction


    function s__HiruzenEdoKongoRoheki_shake takes nothing returns nothing
        local integer i= 0
        loop
            exitwhen i > 11
                call CameraClearNoiseForPlayer(Player(i))
            set i=i + 1
        endloop
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__HiruzenEdoKongoRoheki_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real offset
        local integer i= 0
        loop
            exitwhen i > 10
            set angle=GetRandomReal(0, 2 * bj_PI)
            set offset=150
            set x=(((GetUnitX(s__HiruzenEdoKongoRoheki_cage[this]) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__HiruzenEdoKongoRoheki_cage[this]) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("Boom.mdx", x, y)
            call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, GetRandomReal(0, 2 * bj_PI))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(0, 300))
            call DestroyEffect(bj_lastCreatedEffect)
            set i=i + 1
        endloop
        set bj_lastCreatedEffect=AddSpecialEffect("DustWave.mdx", GetUnitX(s__HiruzenEdoKongoRoheki_cage[this]), GetUnitY(s__HiruzenEdoKongoRoheki_cage[this]))
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
        call DestroyEffect(bj_lastCreatedEffect)
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HiruzenEdoKongoRoheki_caster[this]), 'h058', GetUnitX(s__HiruzenEdoKongoRoheki_cage[this]), GetUnitY(s__HiruzenEdoKongoRoheki_cage[this]), 270.0)
        call SetUnitScale(bj_lastCreatedUnit, 4.0, 4.0, 4.0)
        call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 200)
        call KillUnit(bj_lastCreatedUnit)
        call DestroyEffect(AddSpecialEffect(("LW10.mdx" ), (( GetUnitX(s__HiruzenEdoKongoRoheki_cage[this]) )*1.0), (( GetUnitY(s__HiruzenEdoKongoRoheki_cage[this]))*1.0))) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HiruzenEdoKongoRoheki_caster[this]), 'h02Z', GetUnitX(s__HiruzenEdoKongoRoheki_cage[this]), GetUnitY(s__HiruzenEdoKongoRoheki_cage[this]), GetRandomReal(0, 360))
        call SetUnitScale(bj_lastCreatedUnit, 3.0, 0, 0)
        call SetUnitTimeScale(bj_lastCreatedUnit, 0.5)
        call KillUnit(bj_lastCreatedUnit)
        if IsUnitVisible(s__HiruzenEdoKongoRoheki_caster[this], GetLocalPlayer()) then
            call CameraSetEQNoiseForPlayer(GetLocalPlayer(), 10.00)
        endif
        call TimerStart(CreateTimer(), 1.5, false, function s__HiruzenEdoKongoRoheki_shake)

 	set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HiruzenEdoKongoRoheki_target_x[this], s__HiruzenEdoKongoRoheki_target_y[this], 300, null)
        loop
             set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
             exitwhen bj_lastCreatedUnit == null
	     if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HiruzenEdoKongoRoheki_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
	   		call UnitDamageTarget(s__HiruzenEdoKongoRoheki_caster[this], bj_lastCreatedUnit, 1600, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	     endif
             call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
         endloop
         call DestroyGroup(bj_lastCreatedGroup)


	if ( GetUnitTypeId(s__HiruzenEdoKongoRoheki_caster[this]) == 'h04T' or GetUnitTypeId(s__HiruzenEdoKongoRoheki_caster[this]) == 'h018' or GetUnitTypeId(s__HiruzenEdoKongoRoheki_caster[this]) == 'h04R' ) then
		call ShowUnit(s__HiruzenEdoKongoRoheki_caster[this], true)
	endif
	call SelectUnitForPlayerSingle(s__HiruzenEdoKongoRoheki_caster[this], GetOwningPlayer(s__HiruzenEdoKongoRoheki_caster[this]))



        call s__HiruzenEdoKongoRoheki_destroy(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__HiruzenEdoKongoRoheki_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitFlyHeight(s__HiruzenEdoKongoRoheki_cage[this], 0, 800 * 8)
	call SetUnitFlyHeight(s__HiruzenEdoKongoRoheki_target[this], 0, 800 * 8)
        call TimerStart(NewTimerEx(this), 0.125, false, function s__HiruzenEdoKongoRoheki_finish)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__HiruzenEdoKongoRoheki_actions2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	
	call SetUnitX(s__HiruzenEdoKongoRoheki_cage[this], s__HiruzenEdoKongoRoheki_target_x[this])
	call SetUnitY(s__HiruzenEdoKongoRoheki_cage[this], s__HiruzenEdoKongoRoheki_target_y[this])
        call SetUnitAnimationByIndex(s__HiruzenEdoKongoRoheki_cage[this], 2)
	call SetUnitScale(s__HiruzenEdoKongoRoheki_cage[this], 1.50, 0, 0)
        call SetUnitFlyHeight(s__HiruzenEdoKongoRoheki_cage[this], 800, 800)
	if GetUnitAbilityLevel(s__HiruzenEdoKongoRoheki_target[this], 'BPSE') > 0 then
		call SetUnitFlyHeight(s__HiruzenEdoKongoRoheki_target[this], 800, 800)
	endif
        set bj_lastCreatedEffect=AddSpecialEffect("s_Shadow_Smoke.mdl", s__HiruzenEdoKongoRoheki_target_x[this], s__HiruzenEdoKongoRoheki_target_y[this])
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 8.0)
        call DestroyEffect(bj_lastCreatedEffect)
        call TimerStart(NewTimerEx(this), 1.0, false, function s__HiruzenEdoKongoRoheki_delay)
    endfunction 



  function s__HiruzenEdoKongoRoheki_throw takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HiruzenEdoKongoRoheki_cage[this])
        local real y= GetUnitY(s__HiruzenEdoKongoRoheki_cage[this])
        local real new_x= (((x )*1.0) + Cos((( s__HiruzenEdoKongoRoheki_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__HiruzenEdoKongoRoheki_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__HiruzenEdoKongoRoheki_count[this]=s__HiruzenEdoKongoRoheki_count[this] + 1
