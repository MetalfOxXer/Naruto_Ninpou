    call LeaderboardAddItemBJ(Player(11), GetLastCreatedLeaderboard(), GetPlayerName(Player(11)), 0)
    call LeaderboardDisplayBJ(false, GetLastCreatedLeaderboard())
    set udg_Leaderbox=GetLastCreatedLeaderboard()
endfunction

