   function s__KakuzuRess_invuloff takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	call SetUnitInvulnerable(s__KakuzuRess_caster[this], false)
	set s__KakuzuRess_caster[this]=null
        call s__KakuzuRess_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
   endfunction
    
    function s__KakuzuRess_damage takes nothing returns nothing
        local integer this= s__KakuzuRess_allocate()
        local integer i
        if GetEventDamage() >= GetWidgetLife(GetTriggerUnit()) then
            set s__KakuzuRess_caster[this]=GetTriggerUnit()
            set i=0
	        set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 3000, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if ( GetUnitTypeId(bj_lastCreatedUnit) == 'h097' or GetUnitTypeId(bj_lastCreatedUnit) == 'h098' or GetUnitTypeId(bj_lastCreatedUnit) == 'h099' ) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
