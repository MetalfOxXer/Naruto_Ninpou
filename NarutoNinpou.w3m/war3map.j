            set s__NagatoUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__NagatoUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__NagatoUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NagatoUltimateChoice_caster[this]), 'A0I0', false)
        else
            call s__NagatoUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NagatoUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__NagatoUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__NagatoUltimateChoice_u, s__NagatoUltimateChoice_CHIBAKU_TENSEI)
            call UnitMakeAbilityPermanent(s__NagatoUltimateChoice_u, true, s__NagatoUltimateChoice_CHIBAKU_TENSEI)
        else
            call UnitAddAbility(s__NagatoUltimateChoice_u, s__NagatoUltimateChoice_SHINRA_TENSEI)
            call UnitMakeAbilityPermanent(s__NagatoUltimateChoice_u, true, s__NagatoUltimateChoice_SHINRA_TENSEI)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0I0', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0I0', false)
        set s__s__NagatoUltimateChoice_b[0]= null
        set s__s__NagatoUltimateChoice_b[1]= null
        set s__NagatoUltimateChoice_u=null
        call s__Dialog_destroy(s__NagatoUltimateChoice_d)
        call DestroyBoolExpr(s__NagatoUltimateChoice_pick)
        set s__NagatoUltimateChoice_pick=null
        set this=s__NagatoUltimateChoice_allocate()
        set s__NagatoUltimateChoice_caster[this]=s__NagatoUltimateChoice_u
        set s__NagatoUltimateChoice_pp[this]=GetOwningPlayer(s__NagatoUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__NagatoUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__NagatoUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__NagatoUltimateChoice_CHIBAKU_TENSEI) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__NagatoUltimateChoice_SHINRA_TENSEI) == 0 then
            set s__NagatoUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__NagatoUltimateChoice_d,"Pick a skill")
            set s__s__NagatoUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__NagatoUltimateChoice_d)], ("Chibaku Tensei" ), ( 0))) // INLINED!!
            set s__s__NagatoUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__NagatoUltimateChoice_d)], ("Shinra Giga Tensei" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__NagatoUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__NagatoUltimateChoice_d,s__NagatoUltimateChoice_pick)
            set s__NagatoUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__NagatoUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0I0' then
            set s__NagatoUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__NagatoUltimateChoice_onInit takes nothing returns nothing
        set s__NagatoUltimateChoice_pick=Condition(function s__NagatoUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__NagatoUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0I0' ) , Filter(( function s__NagatoUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Nagato", "A0I0", "A099", "CHIBAKU_TENSEI", "Chibaku Tensei", "A09B", "SHINRA_TENSEI", "Shinra Giga Tensei")

