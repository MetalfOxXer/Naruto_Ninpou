        endfunction
    
    function s__ToruneUltimate_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ToruneUltimate_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call UnitDamageTarget(s__ToruneUltimate_caster[this], bj_lastCreatedUnit, 6 * GetHeroInt(s__ToruneUltimate_caster[this], true) / ( 33 * 3.0 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__ToruneUltimate_count[this]=s__ToruneUltimate_count[this] + 1
        if s__ToruneUltimate_count[this] > 33 * 3 then
            call DestroyGroup(s__ToruneUltimate_damaged[this])
            set s__ToruneUltimate_damaged[this]=null
            call s__ToruneUltimate_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToruneUltimate_grow takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x
        local real y
        set s__ToruneUltimate_count[this]=s__ToruneUltimate_count[this] + 1
        call SetUnitScale(s__ToruneUltimate_dome[this], 6.0 / 50.0 * s__ToruneUltimate_count[this], 0, 0)
        call SetUnitScale(s__ToruneUltimate_dome2[this], 5.5 / 50.0 * s__ToruneUltimate_count[this], 0, 0)
        if ModuloInteger(s__ToruneUltimate_count[this], 10) == 0 then
            set i=0
            loop
                exitwhen i > 6
                set x=(((s__ToruneUltimate_target_x[this] )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 800 / 50.0 * s__ToruneUltimate_count[this])*1.0)) // INLINED!!
                set y=(((s__ToruneUltimate_target_y[this] )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 800 / 50.0 * s__ToruneUltimate_count[this])*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ToruneUltimate_caster[this]), 'ntkt', x, y, 60 * i)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.1 - ( s__ToruneUltimate_count[this] * 0.06 ))
                call IssuePointOrder(bj_lastCreatedUnit, "move", s__ToruneUltimate_target_x[this], s__ToruneUltimate_target_y[this])
               set i=i + 1
            endloop
        endif
        if s__ToruneUltimate_count[this] > 50 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ToruneUltimate_caster[this]), 'h00M', s__ToruneUltimate_target_x[this], s__ToruneUltimate_target_y[this], 270)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 4.0)
            set s__ToruneUltimate_damaged[this]=CreateGroup()
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ToruneUltimate_target_x[this], s__ToruneUltimate_target_y[this], 800, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToruneUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call GroupAddUnit(s__ToruneUltimate_damaged[this], bj_lastCreatedUnit)
                    call UnitDamageTarget(s__ToruneUltimate_caster[this], bj_lastCreatedUnit, 6 * GetHeroInt(s__ToruneUltimate_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__ToruneUltimate_count[this]=0
            set s__ToruneUltimate_dome[this]=null
            set s__ToruneUltimate_dome2[this]=null
            call TimerStart(NewTimerEx(this), 0.03, true, function s__ToruneUltimate_damage)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToruneUltimate_actions takes nothing returns nothing
        local integer this= s__ToruneUltimate_allocate()
        local real x
        local real y
        local integer i
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Torune_T, 100, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Torune: I must follow Lord Danzo's orders.|r")
        endif
        set s__ToruneUltimate_caster[this]=GetTriggerUnit()
        set s__ToruneUltimate_target_x[this]=GetSpellTargetX()
        set s__ToruneUltimate_target_y[this]=GetSpellTargetY()
        set s__ToruneUltimate_count[this]=0
        set s__ToruneUltimate_dome[this]=CreateUnit(GetTriggerPlayer(), 'h0AO', s__ToruneUltimate_target_x[this], s__ToruneUltimate_target_y[this], 270)
        call SetUnitScale(s__ToruneUltimate_dome[this], 0, 0, 0)
        call SetUnitTimeScale(s__ToruneUltimate_dome[this], 0.9)
        call UnitApplyTimedLife(s__ToruneUltimate_dome[this], 'BTLF', 3.0)
        set s__ToruneUltimate_dome2[this]=CreateUnit(GetTriggerPlayer(), 'h0AP', s__ToruneUltimate_target_x[this], s__ToruneUltimate_target_y[this], 270)
        call SetUnitScale(s__ToruneUltimate_dome2[this], 0, 0, 0)
        call UnitApplyTimedLife(s__ToruneUltimate_dome2[this], 'BTLF', 3.0)
		if IsUnitVisible(s__ToruneUltimate_caster[this], GetLocalPlayer()) then
			call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Torune: I will fullfil my orders, no matter what...|r")
		endif
        set i=0
        loop
            exitwhen i > 11
            set x=(((s__ToruneUltimate_target_x[this] )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 800)*1.0)) // INLINED!!
            set y=(((s__ToruneUltimate_target_y[this] )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 800)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\congbi.mdl", x, y)
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.8)
            call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.0)*1.0) , false) // INLINED!!
            set i=i + 1
        endloop
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ToruneUltimate_grow)
    endfunction 
    
    function s__ToruneUltimate_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(72 , s__ToruneUltimate_SPELL_ID , function s__ToruneUltimate_actions)
    endfunction 
    
