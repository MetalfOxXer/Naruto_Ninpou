    //private static boolean picked = false 
    
    function s__NarutoSemiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__NarutoSemiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NarutoSemiUltimateChoice_caster[this]), 'A14V', false)
        else
            call s__NarutoSemiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NarutoSemiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__NarutoSemiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__NarutoSemiUltimateChoice_u, s__NarutoSemiUltimateChoice_RASENSHURIKEN)
            call UnitMakeAbilityPermanent(s__NarutoSemiUltimateChoice_u, true, s__NarutoSemiUltimateChoice_RASENSHURIKEN)
        else
            call UnitAddAbility(s__NarutoSemiUltimateChoice_u, s__NarutoSemiUltimateChoice_GUDOUDAMA)
            call UnitMakeAbilityPermanent(s__NarutoSemiUltimateChoice_u, true, s__NarutoSemiUltimateChoice_GUDOUDAMA)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A14V', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A14V', false)
        set s__s__NarutoSemiUltimateChoice_b[0]= null
        set s__s__NarutoSemiUltimateChoice_b[1]= null
        set s__NarutoSemiUltimateChoice_u=null
        call s__Dialog_destroy(s__NarutoSemiUltimateChoice_d)
        call DestroyBoolExpr(s__NarutoSemiUltimateChoice_pick)
        set s__NarutoSemiUltimateChoice_pick=null
        set this=s__NarutoSemiUltimateChoice_allocate()
        set s__NarutoSemiUltimateChoice_caster[this]=s__NarutoSemiUltimateChoice_u
        set s__NarutoSemiUltimateChoice_pp[this]=GetOwningPlayer(s__NarutoSemiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__NarutoSemiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__NarutoSemiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__NarutoSemiUltimateChoice_RASENSHURIKEN) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__NarutoSemiUltimateChoice_GUDOUDAMA) == 0 then
            set s__NarutoSemiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__NarutoSemiUltimateChoice_d,"Pick a skill")
            set s__s__NarutoSemiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__NarutoSemiUltimateChoice_d)], ("Yoton: Rasenshuriken" ), ( 0))) // INLINED!!
            set s__s__NarutoSemiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__NarutoSemiUltimateChoice_d)], ("Serial Gudoudama" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__NarutoSemiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__NarutoSemiUltimateChoice_d,s__NarutoSemiUltimateChoice_pick)
            set s__NarutoSemiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__NarutoSemiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A14V' then
            set s__NarutoSemiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__NarutoSemiUltimateChoice_onInit takes nothing returns nothing
        set s__NarutoSemiUltimateChoice_pick=Condition(function s__NarutoSemiUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__NarutoSemiUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A14V' ) , Filter(( function s__NarutoSemiUltimateChoice_actions))) // INLINED!!
    endfunction 
    
