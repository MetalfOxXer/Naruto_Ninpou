 function s__YugitoClawsStorm_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

		set bj_lastCreatedEffect=AddSpecialEffect("Yugito_Claws.mdl", GetUnitX(s__YugitoClawsStorm_caster[this]), GetUnitY(s__YugitoClawsStorm_caster[this]))
