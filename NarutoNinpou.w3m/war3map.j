 function s__YugitoT_actions takes nothing returns nothing
  local integer this= s__YugitoT_allocate()
  local integer i= 0
  local integer j= 0
  local real x
  local real y
		set s__YugitoT_caster[this]=GetTriggerUnit()
		loop
			exitwhen i > 2
			set j=0
			loop
				exitwhen j > 12
				set x=(((GetUnitX(s__YugitoT_caster[this]) )*1.0) + Cos((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
				set y=(((GetUnitY(s__YugitoT_caster[this]) )*1.0) + Sin((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Pillar of Flame Blue.mdx", x, y)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
				set j=j + 1
