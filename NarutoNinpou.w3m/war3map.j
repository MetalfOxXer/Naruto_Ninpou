    function s__NagatoHumanArea_actions takes unit caster returns nothing
        call SetUnitManaBJ(caster, GetUnitState(caster, UNIT_STATE_MANA) + ( 45 * GetUnitAbilityLevel(caster, s__NagatoHumanArea_SPELL_ID) * udg_ShinraChannelings[(GetUnitUserData((caster)))] )) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl" ), (( GetUnitX(caster) )*1.0), (( GetUnitY(caster))*1.0))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(caster), GetUnitY(caster), 300.0 + 120.0 * udg_ShinraChannelings[(GetUnitUserData((caster)))], null) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(caster)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                call UnitDamageTarget(caster, bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(caster, s__NagatoHumanArea_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call SetUnitManaBJ(bj_lastCreatedUnit, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) - ( 15 * GetUnitAbilityLevel(caster, s__NagatoHumanArea_SPELL_ID) * udg_ShinraChannelings[(GetUnitUserData((caster)))] )) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction
    
