        set s__HidanTakeBlood_angle[this]=Atan3(GetUnitX(s__HidanTakeBlood_caster[this]) , GetUnitY(s__HidanTakeBlood_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__HidanTakeBlood_count[this]=0
