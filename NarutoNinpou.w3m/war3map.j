		set s__YugitoT_bijuu[this]=CreateUnit(GetTriggerPlayer(), 'u01A', GetUnitX(s__YugitoT_caster[this]), GetUnitY(s__YugitoT_caster[this]), Rad2Deg(s__YugitoT_angle[this]))
		call SetUnitTimeScale(s__YugitoT_bijuu[this], 3.0)
		call SetUnitAnimation(s__YugitoT_bijuu[this], "spell")
		set s__YugitoT_count[this]=0
		set s__YugitoT_damaged[this]=CreateGroup()
		call PauseUnit(s__YugitoT_caster[this], true)
		call ShowUnit(s__YugitoT_caster[this], false)
		if IsUnitVisible(s__YugitoT_caster[this], GetLocalPlayer()) then
            		call PlaySoundOnUnitBJ(gg_snd_Yugito_T, 100, GetTriggerUnit())
			call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Yugito: You fools. You think you have me trapped, don't you? Well, you haven't. In fact, I'm the one who's trapped you!|r")
		endif
		call TimerStart(NewTimerEx(this), 0.25, false, function s__YugitoT_delay)
 endfunction 

