 function s__NejiNewSemi_knockback takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real new_x= (((GetUnitX(s__NejiNewSemi_target[this]) )*1.0) + Cos((( s__NejiNewSemi_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real new_y= (((GetUnitY(s__NejiNewSemi_target[this]) )*1.0) + Sin((( s__NejiNewSemi_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__NejiNewSemi_target[this], new_x)
			call SetUnitY(s__NejiNewSemi_target[this], new_y)
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
			set s__NejiNewSemi_count[this]=16
		else
			set s__NejiNewSemi_count[this]=s__NejiNewSemi_count[this] + 1
		endif
		if s__NejiNewSemi_count[this] > 15 then
			call TimerStart(NewTimerEx(this), 1.0, false, function s__NejiNewSemi_finish)
			call PauseUnit(s__NejiNewSemi_target[this], false)
			call KillUnit(s__NejiNewSemi_domo[this])
                        call ShowUnit(s__NejiNewSemi_domo[this], false)
                        call KillUnit(s__NejiNewSemi_domo3[this])
                        call ShowUnit(s__NejiNewSemi_domo3[this], false)
			call SetUnitTimeScale(s__NejiNewSemi_domo2[this], 1.0)
                        call KillUnit(s__NejiNewSemi_domo2[this])
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__NejiNewSemi_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real new_x
  local real new_y
  local real angle

		if s__NejiNewSemi_count[this] > 64 then
			call PauseUnit(s__NejiNewSemi_caster[this], false)
			call SetUnitTimeScale(s__NejiNewSemi_caster[this], 1.0)
			call UnitRemoveAbility(s__NejiNewSemi_caster[this], 'A02Q')
			set s__NejiNewSemi_count[this]=0
			call SetUnitInvulnerable(s__NejiNewSemi_target[this], false)
			call UnitDamageTarget(s__NejiNewSemi_caster[this], s__NejiNewSemi_target[this], ( 900 + GetHeroAgi(s__NejiNewSemi_caster[this], true) ) * GetUnitAbilityLevel(s__NejiNewSemi_caster[this], s__NejiNewSemi_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			if GetUnitAbilityLevel(s__NejiNewSemi_caster[this], 'B00F') > 0 then
                		set bj_lastCreatedUnit=CreateAbilityDummy(s__NejiNewSemi_caster[this] , 'A0VR')
            			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
                		call IssueTargetOrder(bj_lastCreatedUnit, "soulburn", s__NejiNewSemi_target[this])
				call SetUnitManaBJ(s__NejiNewSemi_target[this], GetUnitStateSwap(UNIT_STATE_MANA, s__NejiNewSemi_target[this]) - 300 * GetUnitAbilityLevel(s__NejiNewSemi_caster[this], 'A04C'))
			endif
			set s__NejiNewSemi_angle[this]=Atan3(GetUnitX(s__NejiNewSemi_caster[this]) , GetUnitY(s__NejiNewSemi_caster[this]) , GetUnitX(s__NejiNewSemi_target[this]) , GetUnitY(s__NejiNewSemi_target[this])) + bj_PI
			call TimerStart(NewTimerEx(this), 0.03, true, function s__NejiNewSemi_knockback)
			call ReleaseTimer(GetExpiredTimer())
		else
			set s__NejiNewSemi_count2[this]=s__NejiNewSemi_count2[this] + 1
			if ( s__NejiNewSemi_count2[this] == 2 or s__NejiNewSemi_count2[this] == 4 or s__NejiNewSemi_count2[this] == 8 or s__NejiNewSemi_count2[this] == 16 or s__NejiNewSemi_count2[this] == 32 or s__NejiNewSemi_count2[this] == 64 or s__NejiNewSemi_count2[this] == 128 ) then
				call sc__NejiNewSemi_start(this)
			endif
			set angle=Atan3(GetUnitX(s__NejiNewSemi_target[this]) , GetUnitY(s__NejiNewSemi_target[this]) , GetUnitX(s__NejiNewSemi_caster[this]) , GetUnitY(s__NejiNewSemi_caster[this])) + Deg2Rad(3)
			set new_x=(((GetUnitX(s__NejiNewSemi_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
			set new_y=(((GetUnitY(s__NejiNewSemi_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
			call UnitRemoveBuffs(s__NejiNewSemi_caster[this], false, true)
			if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
				call SetUnitX(s__NejiNewSemi_caster[this], new_x)
			 	call SetUnitY(s__NejiNewSemi_caster[this], new_y)
			endif
			set angle=Atan3(new_x , new_y , GetUnitX(s__NejiNewSemi_domo[this]) , GetUnitY(s__NejiNewSemi_domo[this]))
			call SetUnitFacing(s__NejiNewSemi_caster[this], Rad2Deg(angle))
		endif
 endfunction 

 function s__NejiNewSemi_showText takes integer this returns nothing
		call PauseUnit(s__NejiNewSemi_caster[this], true)
		call PauseUnit(s__NejiNewSemi_target[this], true)
		call SetUnitX(s__NejiNewSemi_target[this], GetUnitX(s__NejiNewSemi_domo[this]))
		call SetUnitY(s__NejiNewSemi_target[this], GetUnitY(s__NejiNewSemi_domo[this]))
		if s__NejiNewSemi_tt[this] == null then
			set s__NejiNewSemi_tt[this]=CreateTextTagUnitBJ(I2S(s__NejiNewSemi_count[this]), s__NejiNewSemi_domo[this], 0, 10, 100, 100, 100, 0)
		else
			call SetTextTagTextBJ(s__NejiNewSemi_tt[this], I2S(s__NejiNewSemi_count[this]), 10)
		endif
		if not IsUnitVisible(s__NejiNewSemi_domo[this], GetLocalPlayer()) then
			call SetTextTagVisibility(s__NejiNewSemi_tt[this], false)
		endif
 endfunction 

 function s__NejiNewSemi_decreaseTime takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
