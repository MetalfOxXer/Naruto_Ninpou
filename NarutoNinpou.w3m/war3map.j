		call BlzSetSpecialEffectX(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], GetUnitX(s__KabutoPull_dummy[this]))
		call BlzSetSpecialEffectY(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], GetUnitY(s__KabutoPull_dummy[this]))
