    function s__NagatoAsuraArea_actions takes unit caster returns nothing
        local integer i
        local real x
        local real y
        local real angle
        local real offset
        set i=0
        loop
            exitwhen i > 5
            set angle=GetRandomReal(0, 2 * bj_PI)
            set offset=GetRandomReal(50.0, 150.0)
            set x=(((GetUnitX(caster) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set y=(((GetUnitY(caster) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set bj_lastCreatedUnit=CreateAbilityDummy(caster , 'A0T0')
            call SetUnitX(bj_lastCreatedUnit, x)
            call SetUnitY(bj_lastCreatedUnit, y)
            call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(30.0, 70.0), 0)
            call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0T0', 1 + R2I(udg_ShinraChannelings[(GetUnitUserData((caster)))])) // INLINED!!
            call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", GetUnitX(caster), GetUnitY(caster))
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
            set i=i + 1
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(caster), GetUnitY(caster), 300.0 + 120.0 * udg_ShinraChannelings[(GetUnitUserData((caster)))], null) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(caster)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                call UnitDamageTarget(caster, bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(caster, s__NagatoAsuraArea_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
		call StunUnitTimed(caster , bj_lastCreatedUnit , udg_ShinraChannelings[(GetUnitUserData((caster)))]) // INLINED!!
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction
    
