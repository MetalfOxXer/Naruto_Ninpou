            		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToneriT_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__ToneriT_damagedtwo[this]) then
