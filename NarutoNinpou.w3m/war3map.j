            call StunUnitTimed(s__SakuraGetLost_caster[this] , s__SakuraGetLost_target[this] , 1.0)
            call PauseUnit(s__SakuraGetLost_caster[this], false)
            call PauseUnit(s__SakuraGetLost_target[this], false)
            call SetUnitFlyHeight(s__SakuraGetLost_caster[this], 0, 0)
