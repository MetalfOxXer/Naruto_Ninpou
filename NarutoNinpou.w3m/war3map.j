                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MinatoHiraishin_caster[this]), 'e007', s__MinatoHiraishin_caster_x[this], s__MinatoHiraishin_caster_y[this], 270.0)
                call SetUnitX(bj_lastCreatedUnit, s__MinatoHiraishin_caster_x[this])
                call SetUnitY(bj_lastCreatedUnit, s__MinatoHiraishin_caster_y[this])
                call SetUnitScale(bj_lastCreatedUnit, 5.0, 5.0, 5.0)
                call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 200)
                call KillUnit(bj_lastCreatedUnit)
                call SetUnitAnimation(bj_lastCreatedUnit, "death")
                call ShowUnit(s__MinatoHiraishin_caster[this], true)
                call PauseUnit(s__MinatoHiraishin_caster[this], false)
                call PauseUnit(s__MinatoHiraishin_target[this], false)
                call SelectUnitForPlayerSingle(s__MinatoHiraishin_caster[this], GetOwningPlayer(s__MinatoHiraishin_caster[this]))
                call s__MinatoHiraishin_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction 
       
        function s__MinatoHiraishin_ally takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real new_x
            local real new_y
            set new_x=s__MinatoHiraishin_caster_x[this] + Cos(s__MinatoHiraishin_angle[this]) * 100
            set new_y=s__MinatoHiraishin_caster_y[this] + Sin(s__MinatoHiraishin_angle[this]) * 100
            call SetUnitX(s__MinatoHiraishin_caster[this], s__MinatoHiraishin_caster_x[this])
            call SetUnitY(s__MinatoHiraishin_caster[this], s__MinatoHiraishin_caster_y[this])
	    if IsUnitType(s__MinatoHiraishin_target[this], UNIT_TYPE_STRUCTURE) == false then
            	call SetUnitX(s__MinatoHiraishin_target[this], new_x)
            	call SetUnitY(s__MinatoHiraishin_target[this], new_y)
	    endif
            call PauseUnit(s__MinatoHiraishin_caster[this], false)
            call PauseUnit(s__MinatoHiraishin_target[this], false)
            call s__MinatoHiraishin_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction
      
        function s__MinatoHiraishin_teleport takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real caster_x
            local real caster_y
            local real target_x
            local real target_y
            local real new_x
            local real new_y
            local real angle
            local integer i= 0
            set caster_x=GetUnitX(s__MinatoHiraishin_caster[this])
            set caster_y=GetUnitY(s__MinatoHiraishin_caster[this])
            set target_x=GetUnitX(s__MinatoHiraishin_target[this])
            set target_y=GetUnitY(s__MinatoHiraishin_target[this])
            set angle=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            set new_x=target_x + Cos(angle) * 150
            set new_y=target_y + Sin(angle) * 150
            call DestroyEffect(AddSpecialEffect(("DivineRage.mdx" ), (( caster_x )*1.0), (( caster_y)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("DivineRage.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            call SetUnitX(s__MinatoHiraishin_caster[this], new_x)
            call SetUnitY(s__MinatoHiraishin_caster[this], new_y)
            call SetUnitFacing(s__MinatoHiraishin_caster[this], Rad2Deg(angle + bj_PI))
            call PauseUnit(s__MinatoHiraishin_target[this], true)
            loop
                set i=i + 1
                exitwhen i > 10
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MinatoHiraishin_caster[this]), 'e01T', new_x, new_y, GetRandomReal(0, 360))
                call SetUnitX(bj_lastCreatedUnit, new_x)
                call SetUnitY(bj_lastCreatedUnit, new_y)
                call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
                call SetUnitTimeScale(bj_lastCreatedUnit, GetRandomReal(1.0, 3.0))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', GetRandomReal(0.2, 0.5))
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MinatoHiraishin_caster[this]), 'e01T', caster_x, caster_y, GetRandomReal(0, 360))
                call SetUnitX(bj_lastCreatedUnit, caster_x)
                call SetUnitY(bj_lastCreatedUnit, caster_y)
                call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
                call SetUnitTimeScale(bj_lastCreatedUnit, 2.0) //GetRandomReal(1.0, 3.0))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5) // GetRandomReal(0.2, 0.5))
            endloop
            call TerrainDeformRipple(caster_x, caster_y, 200, 600, 700, 1, 400, 1, 1.0, false)
            call TerrainDeformRipple(new_x, new_y, 200, 600, 700, 1, 400, 1, 1.0, false)
            set s__MinatoHiraishin_angle[this]=angle
            call TimerStart(NewTimerEx(this), 0.5, false, function s__MinatoHiraishin_ally)
            call ReleaseTimer(GetExpiredTimer())
        endfunction
          
        function s__MinatoHiraishin_throw22 takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real kunai_x
            local real kunai_y
            local real target_x
            local real target_y
            local real new_x
            local real new_y
            local real angle
            local integer i
            set kunai_x=GetUnitX(s__MinatoHiraishin_kunai[this])
            set kunai_y=GetUnitY(s__MinatoHiraishin_kunai[this])
            if s__MinatoHiraishin_target[this] == null then
                set target_x=s__MinatoHiraishin_target_x[this]
                set target_y=s__MinatoHiraishin_target_y[this]
            else
                set target_x=GetUnitX(s__MinatoHiraishin_target[this])
                set target_y=GetUnitY(s__MinatoHiraishin_target[this])
            endif
            set angle=Atan2(target_y - kunai_y, target_x - kunai_x)
            set new_x=kunai_x + Cos(angle) * 50
            set new_y=kunai_y + Sin(angle) * 50
            call SetUnitX(s__MinatoHiraishin_kunai[this], new_x)
            call SetUnitY(s__MinatoHiraishin_kunai[this], new_y)
            call SetUnitFacing(s__MinatoHiraishin_kunai[this], angle * bj_RADTODEG)
            if GetDistance(new_x , new_y , target_x , target_y) <= 50 then
                call RemoveUnit(s__MinatoHiraishin_kunai[this])
                if s__MinatoHiraishin_target[this] == null then
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(s__MinatoHiraishin_caster[this]) )*1.0), (( GetUnitY(s__MinatoHiraishin_caster[this]))*1.0))) // INLINED!!
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( s__MinatoHiraishin_target_x[this] )*1.0), (( s__MinatoHiraishin_target_y[this])*1.0))) // INLINED!!
                    //call DestroyEffect(AddSpecialEffectEx("Effects\\s_Wind.mdx", GetUnitX(this.caster), GetUnitY(this.caster)))
                    //call DestroyEffect(AddSpecialEffectEx("Effects\\s_Wind.mdx", this.target_x, this.target_y))
                    call SetUnitX(s__MinatoHiraishin_caster[this], s__MinatoHiraishin_target_x[this])
                    call SetUnitY(s__MinatoHiraishin_caster[this], s__MinatoHiraishin_target_y[this])
                    call s__MinatoHiraishin_destroy(this)
                else
                    if IsUnitAlly(s__MinatoHiraishin_target[this], GetOwningPlayer(s__MinatoHiraishin_caster[this])) then
                        set s__MinatoHiraishin_caster_x[this]=GetUnitX(s__MinatoHiraishin_caster[this])
                        set s__MinatoHiraishin_caster_y[this]=GetUnitY(s__MinatoHiraishin_caster[this])
                        call TimerStart(NewTimerEx(this), 0.1, false, function s__MinatoHiraishin_teleport)
                    else
                        set s__MinatoHiraishin_count[this]=25
                        call ShowUnit(s__MinatoHiraishin_caster[this], false)
                        call PauseUnit(s__MinatoHiraishin_caster[this], true)
                        call PauseUnit(s__MinatoHiraishin_target[this], true)
                        call TimerStart(NewTimerEx(this), 0.03, true, function s__MinatoHiraishin_hiraishin)
                    endif
                endif
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
        
        function s__MinatoHiraishin_actions takes nothing returns nothing
            local integer this= s__MinatoHiraishin_allocate()
            local real caster_x= GetUnitX(GetTriggerUnit())
            local real caster_y= GetUnitY(GetTriggerUnit())
            set s__MinatoHiraishin_caster[this]=GetTriggerUnit()
            if GetSpellTargetUnit() == null then
                set s__MinatoHiraishin_target_x[this]=GetSpellTargetX()
                set s__MinatoHiraishin_target_y[this]=GetSpellTargetY()
            else
                set s__MinatoHiraishin_target[this]=GetSpellTargetUnit()
            endif
            set s__MinatoHiraishin_kunai[this]=CreateUnit(GetTriggerPlayer(), 'h07Y', caster_x, caster_y, GetUnitFacing(s__MinatoHiraishin_caster[this]))
            call SetUnitX(s__MinatoHiraishin_kunai[this], caster_x)
            call SetUnitY(s__MinatoHiraishin_kunai[this], caster_y)
call AddSpecialEffectTarget(("Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl" ), ( s__MinatoHiraishin_kunai[this] ), ( "origin")) // INLINED!!
            call TimerStart(NewTimerEx(this), 0.03, true, function s__MinatoHiraishin_throw22)
        endfunction 
        
        function s__MinatoHiraishin_onInit takes nothing returns nothing
            call RegisterSpellEffectEvent2((s__MinatoHiraishin_SPELL_ID ) , Filter(( function s__MinatoHiraishin_actions))) // INLINED!!
            call RegisterSpellEffectEvent2(('A14F' ) , Filter(( function s__MinatoHiraishin_actions))) // INLINED!!
        endfunction 
        
//===========================================================================
// Trigger: MinatoSemi
//===========================================================================

//Implemented from module Alloc:
    
        function s__MinatoSemi_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MinatoSemi_Alloc___recycle[(0)] == 0 ) then
                set s__MinatoSemi_Alloc___instanceCount=s__MinatoSemi_Alloc___instanceCount + 1
                set this=s__MinatoSemi_Alloc___instanceCount
            else
                set this=s__MinatoSemi_Alloc___recycle[(0)]
                set s__MinatoSemi_Alloc___recycle[(0)]=s__MinatoSemi_Alloc___recycle[s__MinatoSemi_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MinatoSemi_deallocate takes integer this returns nothing
            set s__MinatoSemi_Alloc___recycle[this]=s__MinatoSemi_Alloc___recycle[(0)]
            set s__MinatoSemi_Alloc___recycle[(0)]=this
        endfunction

    function s__MinatoSemi_teleport takes nothing returns nothing
 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	set bj_lastCreatedUnit=FirstOfGroup(s__MinatoSemi_missiles[this])
	if bj_lastCreatedUnit == null then
		call PauseUnit(s__MinatoSemi_caster[this], false)
		call SetUnitAnimation(s__MinatoSemi_caster[this], "stand")
		call DestroyGroup(s__MinatoSemi_missiles[this])
		set s__MinatoSemi_missiles[this]=null
		call DestroyGroup(s__MinatoSemi_damaged[this])
		set s__MinatoSemi_damaged[this]=null
		call s__MinatoSemi_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
	else
		call KillUnit(bj_lastCreatedUnit)
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
		call GroupRemoveUnit(s__MinatoSemi_missiles[this], bj_lastCreatedUnit)
		call BlzSetSpecialEffectX(s__s__MinatoSemi_effects[(GetUnitUserData((bj_lastCreatedUnit)))], 5000) // INLINED!!
		call BlzSetSpecialEffectY(s__s__MinatoSemi_effects[(GetUnitUserData((bj_lastCreatedUnit)))], - 7000) // INLINED!!
		call DestroyEffect(s__s__MinatoSemi_effects[(GetUnitUserData((bj_lastCreatedUnit)))]) // INLINED!!

		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 250, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MinatoSemi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__MinatoSemi_damaged[this]) then
				call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
				call UnitDamageTargetBJ(s__MinatoSemi_caster[this], bj_lastCreatedUnit, ( ( 600.00 * I2R(GetUnitAbilityLevelSwapped(s__MinatoSemi_SPELL_ID, s__MinatoSemi_caster[this])) ) + ( 6.00 * ( I2R(GetUnitAbilityLevelSwapped(s__MinatoSemi_SPELL_ID, s__MinatoSemi_caster[this])) * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, s__MinatoSemi_caster[this], true)) ) ) ), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC)
				call GroupAddUnit(s__MinatoSemi_damaged[this], bj_lastCreatedUnit)
				call StunUnitTimed(s__MinatoSemi_caster[this] , bj_lastCreatedUnit , 2.0)
				call SetUnitAnimation(bj_lastCreatedUnit, "death")
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
	endif
    endfunction

    function s__MinatoSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real x
 local real y
 local real new_x
 local real new_y
        local unit u
	set bj_lastCreatedGroup=CreateGroup()
	call GroupAddGroup(s__MinatoSemi_missiles[this], bj_lastCreatedGroup)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		set x=GetUnitX(bj_lastCreatedUnit)
		set y=GetUnitY(bj_lastCreatedUnit)
		set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 35)*1.0)) // INLINED!!
		set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 35)*1.0)) // INLINED!!
		call SetUnitX(bj_lastCreatedUnit, new_x)
		call SetUnitY(bj_lastCreatedUnit, new_y)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
	set s__MinatoSemi_count[this]=s__MinatoSemi_count[this] - 1
	if s__MinatoSemi_count[this] <= 0 then
		set bj_lastCreatedGroup=CreateGroup()
		loop
			set bj_lastCreatedUnit=FirstOfGroup(s__MinatoSemi_missiles[this])
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(s__MinatoSemi_missiles[this], bj_lastCreatedUnit)

			set u=CreateUnit(GetOwningPlayer(s__MinatoSemi_caster[this]), 'e007', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), GetUnitFacing(bj_lastCreatedUnit))
	    		set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Flying_Thunder_God_Kunai.mdl", GetUnitX(u), GetUnitY(u))
	    		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(u)))
            		call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, 1.57)
	    		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
	    		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(u) , GetUnitY(u)))
			set s__s__MinatoSemi_effects[(GetUnitUserData((u)))]= bj_lastCreatedEffect // INLINED!!
			call GroupAddUnit(bj_lastCreatedGroup, u)

			call SetUnitFacing(s__MinatoSemi_caster[this], GetUnitFacing(bj_lastCreatedUnit) + 180)

			call KillUnit(bj_lastCreatedUnit)
			call ShowUnit(bj_lastCreatedUnit, false)
		endloop

		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(s__MinatoSemi_caster[this]) )*1.0), (( GetUnitY(s__MinatoSemi_caster[this]))*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("Effects\\s_Wind.mdx" ), (( GetUnitX(s__MinatoSemi_caster[this]) )*1.0), (( GetUnitY(s__MinatoSemi_caster[this]))*1.0))) // INLINED!!
                call TerrainDeformationRippleBJ(1.00, false, Location(GetUnitX(s__MinatoSemi_caster[this]), GetUnitY(s__MinatoSemi_caster[this])), 200.00, 200.00, 64.00, 1, 200.00)
                call TerrainDeformationRippleBJ(1.00, false, Location(s__MinatoSemi_target_x[this], s__MinatoSemi_target_y[this]), 200.00, 200.00, 64.00, 1, 200.00)

		call PauseUnit(s__MinatoSemi_caster[this], true)
		call SetUnitX(s__MinatoSemi_caster[this], s__MinatoSemi_target_x[this])
		call SetUnitY(s__MinatoSemi_caster[this], s__MinatoSemi_target_y[this])
		call SetUnitAnimation(s__MinatoSemi_caster[this], "spell channel")
		call DestroyGroup(s__MinatoSemi_missiles[this])
		set s__MinatoSemi_missiles[this]=bj_lastCreatedGroup
        	if IsUnitVisible(s__MinatoSemi_caster[this], GetLocalPlayer()) then
            		call PlaySoundOnUnitBJ(gg_snd_Minato_Hokage_R, 80, s__MinatoSemi_caster[this])
        	endif
		call TimerStart(NewTimerEx(this), 0.05, true, function s__MinatoSemi_teleport)
		call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction 

    function s__MinatoSemi_actions takes nothing returns nothing
        local integer this= s__MinatoSemi_allocate()
        local integer i= 0
 local real new_angle
        set s__MinatoSemi_caster[this]=GetTriggerUnit()
	set s__MinatoSemi_target[this]=GetSpellTargetUnit()
        set s__MinatoSemi_angle[this]=Atan3(GetUnitX(s__MinatoSemi_caster[this]) , GetUnitY(s__MinatoSemi_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__MinatoSemi_count[this]=R2I(GetDistance(GetUnitX(s__MinatoSemi_caster[this]) , GetUnitY(s__MinatoSemi_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) / 35)
        set s__MinatoSemi_missiles[this]=CreateGroup()
	set s__MinatoSemi_damaged[this]=CreateGroup()
	set s__MinatoSemi_target_x[this]=GetSpellTargetX()
	set s__MinatoSemi_target_y[this]=GetSpellTargetY()
        loop
		set i=i + 1
		exitwhen i > 5
		set new_angle=s__MinatoSemi_angle[this] + Deg2Rad(- 30 + 10 * i)
		set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h07Y', GetUnitX(s__MinatoSemi_caster[this]), GetUnitY(s__MinatoSemi_caster[this]), Rad2Deg(new_angle))
		call AddSpecialEffectTarget("Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl", bj_lastCreatedUnit, "origin")
		call GroupAddUnit(s__MinatoSemi_missiles[this], bj_lastCreatedUnit)
        endloop
        call TimerStart(NewTimerEx(this), 0.03, true, function s__MinatoSemi_periodic)
    endfunction 

    function s__MinatoSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__MinatoSemi_SPELL_ID ) , Filter(( function s__MinatoSemi_actions))) // INLINED!!
    endfunction



//===========================================================================
// Trigger: MinatoUltimateChoice
//===========================================================================
//textmacro instance: UltimateChoice("Minato", "A0BD", "A0BC", "SPACE_TIME_JUTSU", "Space-Time Jutsu", "A0SB", "SHIKI_FUUJIN", "Shiki Fuujin")

//Implemented from module Alloc:
    
        function s__MinatoUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MinatoUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__MinatoUltimateChoice_Alloc___instanceCount=s__MinatoUltimateChoice_Alloc___instanceCount + 1
                set this=s__MinatoUltimateChoice_Alloc___instanceCount
            else
                set this=s__MinatoUltimateChoice_Alloc___recycle[(0)]
                set s__MinatoUltimateChoice_Alloc___recycle[(0)]=s__MinatoUltimateChoice_Alloc___recycle[s__MinatoUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MinatoUltimateChoice_deallocate takes integer this returns nothing
            set s__MinatoUltimateChoice_Alloc___recycle[this]=s__MinatoUltimateChoice_Alloc___recycle[(0)]
            set s__MinatoUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__MinatoUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__MinatoUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__MinatoUltimateChoice_caster[this]), 'A0BD', false)
        else
            call s__MinatoUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__MinatoUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__MinatoUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__MinatoUltimateChoice_u, s__MinatoUltimateChoice_SPACE_TIME_JUTSU)
            call UnitMakeAbilityPermanent(s__MinatoUltimateChoice_u, true, s__MinatoUltimateChoice_SPACE_TIME_JUTSU)
        else
            call UnitAddAbility(s__MinatoUltimateChoice_u, s__MinatoUltimateChoice_SHIKI_FUUJIN)
            call UnitMakeAbilityPermanent(s__MinatoUltimateChoice_u, true, s__MinatoUltimateChoice_SHIKI_FUUJIN)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0BD', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0BD', false)
        set s__s__MinatoUltimateChoice_b[0]= null
        set s__s__MinatoUltimateChoice_b[1]= null
        set s__MinatoUltimateChoice_u=null
        call s__Dialog_destroy(s__MinatoUltimateChoice_d)
        call DestroyBoolExpr(s__MinatoUltimateChoice_pick)
        set s__MinatoUltimateChoice_pick=null
        set this=s__MinatoUltimateChoice_allocate()
        set s__MinatoUltimateChoice_caster[this]=s__MinatoUltimateChoice_u
        set s__MinatoUltimateChoice_pp[this]=GetOwningPlayer(s__MinatoUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__MinatoUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__MinatoUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__MinatoUltimateChoice_SPACE_TIME_JUTSU) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__MinatoUltimateChoice_SHIKI_FUUJIN) == 0 then
            set s__MinatoUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__MinatoUltimateChoice_d,"Pick a skill")
            set s__s__MinatoUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__MinatoUltimateChoice_d)], ("Space-Time Jutsu" ), ( 0))) // INLINED!!
            set s__s__MinatoUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__MinatoUltimateChoice_d)], ("Shiki Fuujin" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__MinatoUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__MinatoUltimateChoice_d,s__MinatoUltimateChoice_pick)
            set s__MinatoUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__MinatoUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0BD' then
            set s__MinatoUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__MinatoUltimateChoice_onInit takes nothing returns nothing
        set s__MinatoUltimateChoice_pick=Condition(function s__MinatoUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__MinatoUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0BD' ) , Filter(( function s__MinatoUltimateChoice_actions))) // INLINED!!
    endfunction 
    
