		endif
		call DestroyGroup(bj_lastCreatedGroup)
		if GetHeroLevel(s__DanzoSuicide_caster[this]) >= 35 and s__DanzoSuicide_ultimate[this] then
			call BlzStartUnitAbilityCooldown(s__DanzoSuicide_caster[this], s__DanzoSuicide_SPELL_ID, 120)
		endif
		call KillUnit(s__DanzoSuicide_sphere[this])
		call ShowUnit(s__DanzoSuicide_sphere[this], false)
		set s__DanzoSuicide_sphere[this]=null
		call KillUnit(s__DanzoSuicide_domo[this])
		call ShowUnit(s__DanzoSuicide_domo[this], false)
		set s__DanzoSuicide_domo[this]=null
		set s__DanzoSuicide_ultimate[this]=false
