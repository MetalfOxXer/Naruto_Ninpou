// Trigger: SasoriIronShield
//===========================================================================

//Implemented from module Alloc:
    
        function s__SasoriIronShield_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasoriIronShield_Alloc___recycle[(0)] == 0 ) then
                set s__SasoriIronShield_Alloc___instanceCount=s__SasoriIronShield_Alloc___instanceCount + 1
                set this=s__SasoriIronShield_Alloc___instanceCount
            else
                set this=s__SasoriIronShield_Alloc___recycle[(0)]
                set s__SasoriIronShield_Alloc___recycle[(0)]=s__SasoriIronShield_Alloc___recycle[s__SasoriIronShield_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SasoriIronShield_deallocate takes integer this returns nothing
            set s__SasoriIronShield_Alloc___recycle[this]=s__SasoriIronShield_Alloc___recycle[(0)]
            set s__SasoriIronShield_Alloc___recycle[(0)]=this
        endfunction
    
    function s__SasoriIronShield_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__SasoriIronShield_units[this])
            exitwhen bj_lastCreatedUnit == null
            call SetUnitInvulnerable(bj_lastCreatedUnit, false)
            call PauseUnit(bj_lastCreatedUnit, false)
            call GroupRemoveUnit(s__SasoriIronShield_units[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__SasoriIronShield_units[this])
        set s__SasoriIronShield_units[this]=null
        call s__SasoriIronShield_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__SasoriIronShield_actions takes nothing returns nothing
        local integer this= s__SasoriIronShield_allocate()
        set s__SasoriIronShield_caster[this]=GetTriggerUnit()
        set s__SasoriIronShield_units[this]=CreateGroup()
        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'onzg', GetUnitX(s__SasoriIronShield_caster[this]), GetUnitY(s__SasoriIronShield_caster[this]), 270)
        call SetUnitTimeScalePercent(bj_lastCreatedUnit, 50.00)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SasoriIronShield_caster[this]), GetUnitY(s__SasoriIronShield_caster[this]), 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if not IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriIronShield_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call SetUnitInvulnerable(bj_lastCreatedUnit, true)
                    call GroupAddUnit(s__SasoriIronShield_units[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop

        call TimerStart(NewTimerEx(this), 2.0, false, function s__SasoriIronShield_finish)
    endfunction
    
    function s__SasoriIronShield_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__SasoriIronShield_SPELL_ID ) , Filter(( function s__SasoriIronShield_actions))) // INLINED!!
    endfunction
    
