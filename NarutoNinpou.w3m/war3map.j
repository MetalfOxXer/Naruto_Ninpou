            call PlaySoundOnUnitBJ(gg_snd_Neji_W, 100, GetTriggerUnit())
        endif
        set s__NejiNewW_caster[this]=GetTriggerUnit()
	set s__NejiNewW_kaiten[this]=CreateUnit(GetTriggerPlayer(), 'e02I', GetUnitX(s__NejiNewW_caster[this]), GetUnitY(s__NejiNewW_caster[this]), 270)
        set s__NejiNewW_dummy[this]=CreateUnit(GetTriggerPlayer(), 'hgry', GetUnitX(s__NejiNewW_caster[this]), GetUnitY(s__NejiNewW_caster[this]), GetUnitFacing(s__NejiNewW_caster[this]))
        call SetUnitX(s__NejiNewW_dummy[this], GetUnitX(s__NejiNewW_caster[this]))
