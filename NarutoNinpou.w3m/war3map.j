                    loop
                        exitwhen i >= 8
                        //call SetUnitVertexColor(orbs[i], 255, 255, 255, 255)
                        set i=i + 1
                    endloop
                endif
                call TimerStart(NewTimerEx(this), 0.03, false, function s__HagoromoD_removeAbility)
            elseif s__HagoromoD_removeTriggers and GetOwningPlayer(GetTriggerUnit()) != GetOwningPlayer(s__HagoromoD_Hagoromo) then
                //call BJDebugMsg("Removing Trigger action from: " + GetUnitName(GetTriggerUnit()) + " owned by - " + I2S(GetPlayerId(GetOwningPlayer(GetTriggerUnit()))))
                call DisableTrigger(GetTriggeringTrigger())
            //elseif removeTriggers then
                //call BJDebugMsg("Report Message - Exception out of bounds, Hagoromo D: " + GetUnitName(GetTriggerUnit()) + " owned by - " + I2S(GetPlayerId(GetOwningPlayer(GetTriggerUnit()))))
            endif
        endfunction

        function s__HagoromoD_initHero takes nothing returns nothing
            local integer this
            local integer this2
            local trigger t
            local integer i= 0
            if GetUnitTypeId(GetTriggerUnit()) == 'N02G' then
                set this=s__HagoromoD_allocate()
                set this2=s__HagoromoD_allocate()
                set s__HagoromoD_Hagoromo=GetTriggerUnit()
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0OK')
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0OL')
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0OM')
                call SetPlayerTechResearchedSwap('Rhri', 1, GetOwningPlayer(GetTriggerUnit()))
                loop
                    exitwhen i >= 11
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_ESCAPE, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_ESCAPE, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_ESCAPE, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_cheats)
                    call TriggerAddAction(t, function s__HagoromoD_resetReleases)
                
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_Q, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_Q, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_Q, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_earth)
                
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_W, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_W, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_W, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_water)
                
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_E, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_E, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_E, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_fire)
                
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_R, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_R, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_R, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_wind)
                
                    set t=CreateTrigger()
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_T, 0, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_T, 1, true)
                    call BlzTriggerRegisterPlayerKeyEvent(t, Player(i), OSKEY_T, 2, true)
                    call TriggerAddAction(t, function s__HagoromoD_lightning)
                
                    set t=CreateTrigger()
                    call TriggerRegisterPlayerUnitEventSimple(t, Player(i), EVENT_PLAYER_UNIT_SPELL_CAST)
                    call TriggerAddAction(t, function s__HagoromoD_actions)
                    set i=i + 1
                endloop

                set i=0
                loop
                    set s__HagoromoChargesD_orbs[i]= CreateUnit(GetOwningPlayer(s__HagoromoD_Hagoromo), 'h05V', 0, 0, 0)
                    call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                    call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                    set i=i + 1
                    exitwhen i >= 8
                endloop

                call TriggerEvaluate(st__HagoromoQ_actions) // INLINED!!
                call TriggerEvaluate(st__HagoromoW_actions) // INLINED!!
                call TriggerEvaluate(st__HagoromoE_actions) // INLINED!!
                call DisableTrigger(GetTriggeringTrigger())
                call TimerStart(NewTimerEx(this), 1, false, function sc__HagoromoD_updateDelay)
                call TimerStart(NewTimerEx(this2), 20, false, function sc__HagoromoD_updateDelayRemoveTriggers)
            endif
        endfunction

        function s__HagoromoD_updateDelayRemoveTriggers takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
                set s__HagoromoD_removeTriggers=true
            call s__HagoromoD_deallocate(this)
        endfunction

        function s__HagoromoD_updateDelay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer this2= s__HagoromoD_allocate()
            call TimerStart(NewTimerEx(this2), 0.03, true, function sc__HagoromoD_updateOrbs)
            call ReleaseTimer(GetExpiredTimer())
            call s__HagoromoD_deallocate(this)
        endfunction

        function s__HagoromoD_updateOrbs takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer i= 0
            local real distance= 150
            local real height= 75
            local real angleOffset= 360 / s__HagoromoD_HagoromoMaxCharges
            local real angle= - 90
            local real x= GetUnitX(s__HagoromoD_Hagoromo)
            local real y= GetUnitY(s__HagoromoD_Hagoromo)
            local real currentAngle
            local real orbX
            local real orbY
            local real orbZ
            local real new_x
            local real new_y
            local real start_x
            local real start_y
            local real target_x
            local real target_y
            local real lerpFactor= 0.2
         local real maxMana= BlzGetUnitMaxMana(s__HagoromoD_Hagoromo)
         local real manaOffset= I2R(s__HagoromoD_HagoromoCurrentCharges) / I2R(s__HagoromoD_HagoromoMaxCharges)
         local real manaCur= maxMana * manaOffset
        
            set target_x=x
            set target_y=y
            //call BJDebugMsg("Max Mana : " + R2S(maxMana))
            //call BJDebugMsg("Offset Mana : " + R2S(manaOffset))
            //call BJDebugMsg("Cur Mana : " + R2S(manaCur))
            //call BlzSetUnitMaxMana(this.Hagoromo, this.HagoromoMaxCharges)
            call BlzSetUnitRealField(s__HagoromoD_Hagoromo, UNIT_RF_MANA, manaCur)
            //call BlzSetUnitRealField(this.Hagoromo, UNIT_RF_MANA_REGENERATION, 0)
        
            set currentAngle=angle
            if s__HagoromoD_HagoromoCurrentCharges == 0 and IsUnitHidden(s__HagoromoChargesD_orbs[0]) then
                set s__HagoromoD_HagoromoSpellAntepenultimate=0
                set s__HagoromoD_HagoromoSpellPenultimate=0
                set s__HagoromoD_HagoromoSpellPrevious=0
                set s__HagoromoD_lastDebuff1=0
                set s__HagoromoD_lastDebuff2=0
                set s__HagoromoD_lastDebuff3=0
                call s__HagoromoD_removeAllDebuffs(this)
            else
                loop
                    if i < s__HagoromoD_HagoromoCurrentCharges then
                        if s__HagoromoChargesD_orbs[i] == null then
                            set s__HagoromoChargesD_orbs[i]= CreateUnit(GetOwningPlayer(s__HagoromoD_Hagoromo), 'h009', 0, 0, 0)
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        endif
                        set orbX=x + distance * Cos(currentAngle * bj_DEGTORAD)
                        set orbY=y + distance * Sin(currentAngle * bj_DEGTORAD)
                        set orbZ=height // for horizontal UX
                        if IsUnitHidden(s__HagoromoD_Hagoromo) or not IsUnitAliveBJ(s__HagoromoD_Hagoromo) then //or (IsUnitInvisible(this.Hagoromo, Player(3))) or (IsUnitInvisible(this.Hagoromo, Player(7))) or (IsUnitInvisible(this.Hagoromo, Player(11))) then 
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        else
                            call SetUnitX(s__HagoromoChargesD_orbs[i], orbX)
                            call SetUnitY(s__HagoromoChargesD_orbs[i], orbY)
                            call SetUnitFlyHeight(s__HagoromoChargesD_orbs[i], orbZ, 0)
                            call ShowUnit(s__HagoromoChargesD_orbs[i], true)
                            call UnitAddAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                        endif
                    else
                        set start_x=GetUnitX(s__HagoromoChargesD_orbs[i])
                        set start_y=GetUnitY(s__HagoromoChargesD_orbs[i])
                    
                        // Lerp the orb toward the fixed target point progressively
                        set new_x=start_x + lerpFactor * ( target_x - start_x )
                        set new_y=start_y + lerpFactor * ( target_y - start_y )
                    
                        call SetUnitX(s__HagoromoChargesD_orbs[i], new_x)
                        call SetUnitY(s__HagoromoChargesD_orbs[i], new_y)

                        // Once the orb reaches near the target, hide and reset it
                        if IsUnitHidden(s__HagoromoD_Hagoromo) or not IsUnitAliveBJ(s__HagoromoD_Hagoromo) or GetDistance(start_x , start_y , target_x , target_y) <= 44 then // (IsUnitInvisible(this.Hagoromo, Player(0)) or IsUnitInvisible(this.Hagoromo, Player(4)) or IsUnitInvisible(this.Hagoromo, Player(8)))
                            call SetUnitVertexColor(s__HagoromoChargesD_orbs[i], 255, 255, 255, 255)
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        endif
                    endif
                
                    set currentAngle=currentAngle + angleOffset
                    set i=i + 1
                    exitwhen i >= s__HagoromoD_HagoromoMaxCharges
                endloop
            endif
            if GetUnitLevel(s__HagoromoD_Hagoromo) >= 10 and s__HagoromoD_HagoromoMaxCharges < 4 then
                set s__HagoromoD_HagoromoMaxCharges=4
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0ON')
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 15 and s__HagoromoD_HagoromoMaxCharges < 5 then
                set s__HagoromoD_HagoromoMaxCharges=5
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 35 and s__HagoromoD_HagoromoMaxCharges < 6 then
                set s__HagoromoD_HagoromoMaxCharges=6
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0OO')
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 50 and s__HagoromoD_HagoromoMaxCharges < 8 then
                set s__HagoromoD_HagoromoMaxCharges=8
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 2
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            endif
        endfunction        

        function s__HagoromoD_onInit takes nothing returns nothing

            local trigger t
            local trigger t2
            local trigger t3
            local trigger t4
            local trigger t5
            local trigger t6
            local trigger t7
            local trigger t8
            local trigger t9
            local integer i= 0

            set t8=CreateTrigger()
            call TriggerRegisterEnterRectSimple(t8, GetPlayableMapRect())
            call TriggerAddAction(t8, function s__HagoromoD_initHero)

            set t9=CreateTrigger()
            call TriggerRegisterAnyUnitEventBJ(t9, EVENT_PLAYER_UNIT_DEATH)
            call TriggerAddAction(t9, function s__HagoromoD_unitDeath)
            set s__HagoromoD_ReleaseEarth=false
            set s__HagoromoD_ReleaseWater=false
            set s__HagoromoD_ReleaseFire=false
            set s__HagoromoD_ReleaseWind=false
            set s__HagoromoD_ReleaseLightning=false
            set s__HagoromoD_HagoromoRecharging=false
            set s__HagoromoD_HagoromoCasting=false
            set s__HagoromoD_combineRelease=false
            set s__HagoromoD_lastDebuff1=0
            set s__HagoromoD_lastDebuff2=0
            set s__HagoromoD_lastDebuff3=0
            set i=0
            loop
                exitwhen i >= 8
                set s__s__HagoromoD_R[i]= 255
                set s__s__HagoromoD_G[i]= 255
                set s__s__HagoromoD_B[i]= 255
                set i=i + 1
            endloop

            call SaveInteger(HagoromoChargesD_DebuffTable, 1, 0, s__HagoromoD_DEBUFF_EARTH) // Earth
            call SaveInteger(HagoromoChargesD_DebuffTable, 2, 0, s__HagoromoD_DEBUFF_WATER) // Water
            call SaveInteger(HagoromoChargesD_DebuffTable, 3, 0, s__HagoromoD_DEBUFF_FIRE) // Fire
            call SaveInteger(HagoromoChargesD_DebuffTable, 4, 0, s__HagoromoD_DEBUFF_WIND) // Wind
            call SaveInteger(HagoromoChargesD_DebuffTable, 5, 0, s__HagoromoD_DEBUFF_LIGHTNING) // Lightning

            call SaveInteger(HagoromoChargesD_DebuffTable, 6, 0, s__HagoromoD_DEBUFF_WOOD) // Wood
            call SaveInteger(HagoromoChargesD_DebuffTable, 7, 0, s__HagoromoD_DEBUFF_BOIL) // WE -> Boil
            call SaveInteger(HagoromoChargesD_DebuffTable, 8, 0, s__HagoromoD_DEBUFF_LAVA) // Lava

            call SaveInteger(HagoromoChargesD_DebuffTable, 9, 0, s__HagoromoD_DEBUFF_ICE) // Ice
            call SaveInteger(HagoromoChargesD_DebuffTable, 10, 0, s__HagoromoD_DEBUFF_SCORCH) // Scorch
            call SaveInteger(HagoromoChargesD_DebuffTable, 11, 0, s__HagoromoD_DEBUFF_MAGNET) // Magnet

            call SaveInteger(HagoromoChargesD_DebuffTable, 12, 0, s__HagoromoD_DEBUFF_STORM) // Storm
            call SaveInteger(HagoromoChargesD_DebuffTable, 13, 0, s__HagoromoD_DEBUFF_SWIFT) // Swift
            call SaveInteger(HagoromoChargesD_DebuffTable, 14, 0, s__HagoromoD_DEBUFF_EXPLOSION) // Explosion
            call SaveInteger(HagoromoChargesD_DebuffTable, 15, 0, s__HagoromoD_DEBUFF_BLAZE) // Blaze

        endfunction

// scope HagoromoChargesD ends

//***************************************************************************
//*  HagoromoQ


//Implemented from module Alloc:
    
        function s__HagoromoQ_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__HagoromoQ_Alloc___recycle[(0)] == 0 ) then
                set s__HagoromoQ_Alloc___instanceCount=s__HagoromoQ_Alloc___instanceCount + 1
                set this=s__HagoromoQ_Alloc___instanceCount
            else
                set this=s__HagoromoQ_Alloc___recycle[(0)]
                set s__HagoromoQ_Alloc___recycle[(0)]=s__HagoromoQ_Alloc___recycle[s__HagoromoQ_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__HagoromoQ_deallocate takes integer this returns nothing
            set s__HagoromoQ_Alloc___recycle[this]=s__HagoromoQ_Alloc___recycle[(0)]
            set s__HagoromoQ_Alloc___recycle[(0)]=this
        endfunction


    // Constants for knockback


    function s__HagoromoQ_applyKnockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real baseX= GetUnitX(s__HagoromoQ_wall)
        local real baseY= GetUnitY(s__HagoromoQ_wall)
        local real centerX
        local real centerY
        local integer row
        local integer col
        local real knockbackForce
        local unit u
        local real angleOffset
        local real diagonalAngle
        local boolean firstIteration= ( s__HagoromoQ_count[this] == 0 )

        // Adjust angle offset for the knockback
        set angleOffset=s__HagoromoQ_angle[this] + 90.0

        // Centering the baseX and baseY in relation to both rows and columns, with additional offset
        set baseX=baseX - ( s__HagoromoQ_COLS[this] - 1 ) * 0.5 * s__HagoromoQ_CIRCLE_DISTANCE[this] * Cos(angleOffset * bj_DEGTORAD) - ( s__HagoromoQ_ROWS[this] - 1 ) * 0.5 * s__HagoromoQ_CIRCLE_DISTANCE[this] * Cos(s__HagoromoQ_angle[this] * bj_DEGTORAD) - s__HagoromoQ_CENTER_OFFSET[this] * Cos(s__HagoromoQ_angle[this] * bj_DEGTORAD)
        set baseY=baseY - ( s__HagoromoQ_COLS[this] - 1 ) * 0.5 * s__HagoromoQ_CIRCLE_DISTANCE[this] * Sin(angleOffset * bj_DEGTORAD) - ( s__HagoromoQ_ROWS[this] - 1 ) * 0.5 * s__HagoromoQ_CIRCLE_DISTANCE[this] * Sin(s__HagoromoQ_angle[this] * bj_DEGTORAD) - s__HagoromoQ_CENTER_OFFSET[this] * Sin(s__HagoromoQ_angle[this] * bj_DEGTORAD)

        // Apply SIDE_OFFSET for lateral adjustment
        set baseX=baseX + s__HagoromoQ_SIDE_OFFSET[this] * Cos(angleOffset * bj_DEGTORAD)
        set baseY=baseY + s__HagoromoQ_SIDE_OFFSET[this] * Sin(angleOffset * bj_DEGTORAD)

        // Knockback logic for 2 rows, each row knocks in the opposite direction
        set row=0
        loop
            exitwhen row >= s__HagoromoQ_ROWS[this]
            set col=0
            loop
                exitwhen col >= s__HagoromoQ_COLS[this]
                // Calculate the position of each "knockback circle"
                set centerX=baseX + col * s__HagoromoQ_CIRCLE_DISTANCE[this] * Cos(angleOffset * bj_DEGTORAD) + row * s__HagoromoQ_CIRCLE_DISTANCE[this] * Cos(s__HagoromoQ_angle[this] * bj_DEGTORAD)
                set centerY=baseY + col * s__HagoromoQ_CIRCLE_DISTANCE[this] * Sin(angleOffset * bj_DEGTORAD) + row * s__HagoromoQ_CIRCLE_DISTANCE[this] * Sin(s__HagoromoQ_angle[this] * bj_DEGTORAD)

                // Enumerate units in the circle area and apply knockback
                call GroupEnumUnitsInRange(s__HagoromoQ_tempGroup[this], centerX, centerY, s__HagoromoQ_CIRCLE_RADIUS[this], null)
                loop
                    set u=FirstOfGroup(s__HagoromoQ_tempGroup[this])
                    exitwhen u == null

                    // Apply knockback force in the direction away from the wall
                    if IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                        // Apply diagonal knockback at corners
                        if ( col == 0 or col == s__HagoromoQ_COLS[this] - 1 ) and ( row == 0 or row == s__HagoromoQ_ROWS[this] - 1 ) then
                            if col == 0 and row == 0 then
                                set diagonalAngle=s__HagoromoQ_angle[this] - 135.0 // Top-left corner knockback
                            elseif col == s__HagoromoQ_COLS[this] - 1 and row == 0 then
                                set diagonalAngle=s__HagoromoQ_angle[this] + 135.0 // Top-right corner knockback
                            elseif col == 0 and row == s__HagoromoQ_ROWS[this] - 1 then
                                set diagonalAngle=s__HagoromoQ_angle[this] - 45.0 // Bottom-left corner knockback
                            elseif col == s__HagoromoQ_COLS[this] - 1 and row == s__HagoromoQ_ROWS[this] - 1 then
                                set diagonalAngle=s__HagoromoQ_angle[this] + 45.0 // Bottom-right corner knockback
                            endif
                            call SetUnitX(u, GetUnitX(u) + s__HagoromoQ_KNOCKBACK_FORCE[this] * Cos(diagonalAngle * bj_DEGTORAD))
                            call SetUnitY(u, GetUnitY(u) + s__HagoromoQ_KNOCKBACK_FORCE[this] * Sin(diagonalAngle * bj_DEGTORAD))
                        else
                            // Handle normal knockback for rows and columns
                            if row == 0 then
                                set knockbackForce=- s__HagoromoQ_KNOCKBACK_FORCE[this] // Row 0 pushes forward
                            else
                                set knockbackForce=s__HagoromoQ_KNOCKBACK_FORCE[this] // Row 1 pushes backward (opposite direction)
                            endif

                            // Apply knockback force
                            if col == s__HagoromoQ_COLS[this] - 1 or col == 0 then
                                set knockbackForce=knockbackForce * - 1
                                call SetUnitX(u, GetUnitX(u) + knockbackForce * Cos(angleOffset * bj_DEGTORAD))
                                call SetUnitY(u, GetUnitY(u) + knockbackForce * Sin(angleOffset * bj_DEGTORAD))
                            else
                                call SetUnitX(u, GetUnitX(u) + knockbackForce * Cos(s__HagoromoQ_angle[this] * bj_DEGTORAD))
                                call SetUnitY(u, GetUnitY(u) + knockbackForce * Sin(s__HagoromoQ_angle[this] * bj_DEGTORAD))
                            endif
                        endif
                        // Apply damage during the first iteration
                        if firstIteration and not IsUnitInGroup(u, s__HagoromoQ_damageGroup[this]) and IsUnitEnemy(u, GetOwningPlayer(s__HagoromoQ_caster[this])) then
                            call GroupAddUnit(s__HagoromoQ_damageGroup[this], u)
                            call UnitDamageTarget(s__HagoromoQ_caster[this], u, 500 * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) / 2 ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                        endif
                    endif

                    call GroupRemoveUnit(s__HagoromoQ_tempGroup[this], u)
                endloop

                set col=col + 1
            endloop
            set row=row + 1
        endloop
    endfunction

    function s__HagoromoQ_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

        // Apply knockback logic
        call s__HagoromoQ_applyKnockback()

        set s__HagoromoQ_count[this]=s__HagoromoQ_count[this] + 1

        if s__HagoromoQ_count[this] >= 500 or not IsUnitAliveBJ(s__HagoromoQ_wall) then
            call GroupClear(s__HagoromoQ_tempGroup[this])
            call GroupClear(s__HagoromoQ_damageGroup[this])
            call DestroyGroup(s__HagoromoQ_tempGroup[this])
            call DestroyGroup(s__HagoromoQ_damageGroup[this])
            call s__HagoromoQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__HagoromoQ_actions takes nothing returns nothing
        local integer this= s__HagoromoQ_allocate()
        local real caster_x= GetUnitX(s__HagoromoD_Hagoromo)
        local real caster_y= GetUnitY(s__HagoromoD_Hagoromo)
        local real target_x= GetSpellTargetX()
        local real target_y= GetSpellTargetY()

        if BlzGroupGetSize(s__HagoromoQ_tempGroup[this]) > 0 then
            call GroupClear(s__HagoromoQ_tempGroup[this])
            call DestroyGroup(s__HagoromoQ_tempGroup[this])
        endif

        if BlzGroupGetSize(s__HagoromoQ_damageGroup[this]) > 0 then
            call GroupClear(s__HagoromoQ_damageGroup[this])
            call DestroyGroup(s__HagoromoQ_damageGroup[this])
        endif

        set s__HagoromoQ_ROWS[this]=2
        set s__HagoromoQ_COLS[this]=4
        set s__HagoromoQ_KNOCKBACK_FORCE[this]=10.0
        set s__HagoromoQ_CIRCLE_RADIUS[this]=75.0
        set s__HagoromoQ_CIRCLE_DISTANCE[this]=150.0
        set s__HagoromoQ_CENTER_OFFSET[this]=32.0

        set s__HagoromoQ_SIDE_OFFSET[this]=10.0
        set s__HagoromoQ_tempGroup[this]=CreateGroup()
        set s__HagoromoQ_damageGroup[this]=CreateGroup()

        set s__HagoromoQ_angle[this]=Atan2(target_y - caster_y, target_x - caster_x) * bj_RADTODEG
        set s__HagoromoQ_caster[this]=s__HagoromoD_Hagoromo
        set s__HagoromoQ_target_x[this]=target_x
        set s__HagoromoQ_target_y[this]=target_y
        set s__HagoromoQ_count[this]=0

	call SetUnitAnimationByIndex(s__HagoromoQ_caster[this], 13)
        // Create the wall unit at the specified target location
        set s__HagoromoQ_wall=CreateUnit(GetOwningPlayer(s__HagoromoQ_caster[this]), 'h061', s__HagoromoQ_target_x[this], s__HagoromoQ_target_y[this], s__HagoromoQ_angle[this])
        call UnitAddAbility(s__HagoromoQ_wall, 'Aloc')
        call SetUnitX(s__HagoromoQ_wall, s__HagoromoQ_target_x[this])
        call SetUnitY(s__HagoromoQ_wall, s__HagoromoQ_target_y[this])
        call UnitApplyTimedLife(s__HagoromoQ_wall, 'BTLF', 5.0)

        call TimerStart(NewTimerEx(this), 0.01, true, function s__HagoromoQ_periodic)
    endfunction 

    function s__HagoromoQ_onInit takes nothing returns nothing
        //set wall = CreateUnit(Player(0), 'hfoo', 0, 0, 0)
        //call RemoveUnit(wall)
    endfunction

//***************************************************************************
//*  HagoromoW
// scope HagoromoWaterW begins

    
    
//Implemented from module Alloc:
    
        function s__HagoromoW_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__HagoromoW_Alloc___recycle[(0)] == 0 ) then
                set s__HagoromoW_Alloc___instanceCount=s__HagoromoW_Alloc___instanceCount + 1
                set this=s__HagoromoW_Alloc___instanceCount
            else
                set this=s__HagoromoW_Alloc___recycle[(0)]
                set s__HagoromoW_Alloc___recycle[(0)]=s__HagoromoW_Alloc___recycle[s__HagoromoW_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__HagoromoW_deallocate takes integer this returns nothing
            set s__HagoromoW_Alloc___recycle[this]=s__HagoromoW_Alloc___recycle[(0)]
            set s__HagoromoW_Alloc___recycle[(0)]=this
        endfunction

        // Checking the units within the basin's radius
        function s__HagoromoW_isWithinBasinRadius takes unit u returns boolean
            local real unit_x= GetUnitX(u)
            local real unit_y= GetUnitY(u)
            local real basin_x= GetUnitX(s__HagoromoW_basin)
            local real basin_y= GetUnitY(s__HagoromoW_basin)
            local real distance= GetDistance(unit_x , unit_y , basin_x , basin_y)
            set s__HagoromoW_freezeDirection[s__HagoromoW_instance]=GetUnitFacing(s__HagoromoW_caster[s__HagoromoW_instance]) - 180
            return distance <= HagoromoWaterW___MAX_BASIN_RADIUS * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE )
        endfunction

        function s__HagoromoW_freezeunits takes nothing returns nothing
            if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HagoromoD_Hagoromo)) and GetWidgetLife(GetFilterUnit()) > 0.405 and not IsUnitInGroup(GetFilterUnit(), s__HagoromoW_damaged[s__HagoromoW_instance]) then
                if s__HagoromoW_empowered then
                    call UnitDamageTarget(s__HagoromoD_Hagoromo, GetFilterUnit(), 500 + GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10 ) * 0.75 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__HagoromoW_damaged[s__HagoromoW_instance], GetFilterUnit())
                    call EsnareUnitTimed(GetTriggerUnit() , GetFilterUnit() , 1.0)
                endif
            endif
        endfunction

        function s__HagoromoW_puddleunits takes nothing returns nothing
            if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HagoromoD_Hagoromo)) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                if s__HagoromoW_isWithinBasinRadius(GetFilterUnit()) then
                    call UnitDamageTarget(s__HagoromoD_Hagoromo, GetFilterUnit(), ( 400 + GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 5 ) / 2 ) ) / 90, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                endif
            endif
        endfunction

        function s__HagoromoW_enableEmpowered takes nothing returns nothing
            if s__HagoromoW_empowered == false then
                set s__HagoromoW_empowered=true
            endif
        endfunction

        function s__HagoromoW_destroy takes integer this returns nothing
            local integer i= 0
            loop
                exitwhen i > 13
                if s__HagoromoWaterW___puddle[(this)*(13)+i] != null then
                    call RemoveUnit(s__HagoromoWaterW___puddle[(this)*(13)+i])
                    call ShowUnit(s__HagoromoWaterW___puddle[(this)*(13)+i], false)
                    set s__HagoromoWaterW___puddle[(this)*(13)+i]= null
                endif
                set i=i + 1
            endloop
            call DestroyGroup(s__HagoromoW_damaged[this])
            set s__HagoromoW_basin=null
            set s__HagoromoW_damaged[this]=null
            set s__HagoromoW_caster[this]=null
            set s__HagoromoW_shrink[this]=false
            set s__HagoromoW_empowered=false
            call s__HagoromoW_deallocate(this)
        endfunction

        // Delay function for periodic updates
        function s__HagoromoW_delay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            call TimerStart(NewTimerEx(this), 0.03, true, function sc__HagoromoW_periodic)
            call ReleaseTimer(GetExpiredTimer())
        endfunction
    
        // Method to expand and shrink the basin
        function s__HagoromoW_expandBasin takes nothing returns nothing
            if HagoromoWaterW___basinScale < HagoromoWaterW___MAX_BASIN_SCALE and not s__HagoromoW_shrink[s__HagoromoW_instance] then
                set HagoromoWaterW___basinScale=HagoromoWaterW___basinScale + HagoromoWaterW___GROWTH_RATE
                call SetUnitScale(s__HagoromoW_basin, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale)
            elseif s__HagoromoW_shrink[s__HagoromoW_instance] then
                set HagoromoWaterW___basinScale=HagoromoWaterW___basinScale - HagoromoWaterW___GROWTH_RATE
                call SetUnitScale(s__HagoromoW_basin, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale)
            endif
        endfunction

        function s__HagoromoW_removeFrozen takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            
            call DestroyGroup(s__HagoromoW_damaged[this])
            call DestroyEffect(s__HagoromoW_frozen[this])
            call RemoveUnit(s__HagoromoW_basin)
            call ShowUnit(s__HagoromoW_basin, false)
            set s__HagoromoW_basin=null
            set s__HagoromoW_empowered=false
            set s__HagoromoW_basin=null
            set s__HagoromoW_damaged[this]=null
            set s__HagoromoW_caster[this]=null
            set s__HagoromoW_shrink[this]=false
            call s__HagoromoW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        // Grow and shrink the basin
        function s__HagoromoW_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real splashDistance= HagoromoWaterW___MAX_BASIN_RADIUS
            local real x1
            local real y1
            local integer i

            set s__HagoromoW_instance=this
            if s__HagoromoW_empowered and not s__HagoromoW_activated[this] then
                set s__HagoromoW_activated[this]=true
                call SetUnitScale(s__HagoromoW_basin, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale, HagoromoWaterW___basinScale)
                call SetUnitTimeScale(s__HagoromoW_basin, 0.01)
                set s__HagoromoW_frozen[this]=AddSpecialEffect("war3mapImported\\IceAge.mdl", GetUnitX(s__HagoromoW_basin), GetUnitY(s__HagoromoW_basin))
                call BlzPlaySpecialEffectWithTimeScale(s__HagoromoW_frozen[this], ANIM_TYPE_BIRTH, 1.0)
                call BlzSetSpecialEffectScale(s__HagoromoW_frozen[this], 0.5 * ( ( HagoromoWaterW___basinScale + 0.1 ) / HagoromoWaterW___MAX_BASIN_SCALE ))
                call BlzSetSpecialEffectYaw(s__HagoromoW_frozen[this], Deg2Rad(s__HagoromoW_freezeDirection[this]))
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HagoromoW_target_x[this], s__HagoromoW_target_y[this], splashDistance, Filter(function s__HagoromoW_freezeunits))
                call DestroyGroup(bj_lastCreatedGroup)
                
                set i=0
                loop
                    exitwhen i > 12
                    if s__HagoromoWaterW___puddle[(this)*(13)+i] != null then
                        call RemoveUnit(s__HagoromoWaterW___puddle[(this)*(13)+i])
                        call ShowUnit(s__HagoromoWaterW___puddle[(this)*(13)+i], false)
                        set s__HagoromoWaterW___puddle[(this)*(13)+i]= null
                    endif
                    set i=i + 1
                endloop
            
                call TimerStart(NewTimerEx(this), 2.0, false, function s__HagoromoW_removeFrozen)
                call ReleaseTimer(GetExpiredTimer())
            elseif not s__HagoromoW_activated[this] then
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HagoromoW_target_x[this], s__HagoromoW_target_y[this], splashDistance, Filter(function s__HagoromoW_puddleunits))
                call DestroyGroup(bj_lastCreatedGroup)
            
                call s__HagoromoW_expandBasin()

                // Splash effects which occur every time this.count is divisible by 5
                if HagoromoWaterW___basinScale <= HagoromoWaterW___MAX_BASIN_SCALE and ModuloInteger(s__HagoromoW_count[this], 5) == 0 and HagoromoWaterW___basinScale > 0.1 then
                    if s__HagoromoW_shrink[this] then
                        set splashDistance=175
                    endif
                    set i=0
                    loop
                        exitwhen i > 12
                        if s__HagoromoWaterW___puddle[(this)*(13)+i] != null then
                            call RemoveUnit(s__HagoromoWaterW___puddle[(this)*(13)+i])
                            call ShowUnit(s__HagoromoWaterW___puddle[(this)*(13)+i], false)
                            set s__HagoromoWaterW___puddle[(this)*(13)+i]= null
                        endif
                        set s__HagoromoWaterW___puddle[(this)*(13)+i]= CreateUnit(GetOwningPlayer(s__HagoromoW_caster[this]), 'h085', s__HagoromoW_target_x[this], s__HagoromoW_target_y[this], Rad2Deg(GetUnitFacing(s__HagoromoW_caster[this])) + 30 * ( i + 1 ))
                        call SetUnitScale(s__HagoromoWaterW___puddle[(this)*(13)+i], 1.0 * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE ), 1.0 * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE ), 1.0 * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE ))
                        call UnitApplyTimedLife(s__HagoromoWaterW___puddle[(this)*(13)+i], 'BTLF', 0.5)
                        set x1=(((s__HagoromoW_target_x[this] )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__HagoromoWaterW___puddle[(this)*(13)+i])) )*1.0)) * (( splashDistance * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE ))*1.0)) // INLINED!!
                        set y1=(((s__HagoromoW_target_y[this] )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__HagoromoWaterW___puddle[(this)*(13)+i])) )*1.0)) * (( splashDistance * ( HagoromoWaterW___basinScale / HagoromoWaterW___MAX_BASIN_SCALE ))*1.0)) // INLINED!!
                        call SetUnitX(s__HagoromoWaterW___puddle[(this)*(13)+i], x1)
                        call SetUnitY(s__HagoromoWaterW___puddle[(this)*(13)+i], y1)
                        set i=i + 1
                    endloop
                endif
            endif

            set s__HagoromoW_count[this]=s__HagoromoW_count[this] + 1
            if ( s__HagoromoW_count[this] >= 90 and HagoromoWaterW___basinScale <= 0.1 ) and ( s__HagoromoW_shrink[this] or s__HagoromoW_activated[this] ) then
                call ReleaseTimer(GetExpiredTimer())
                set i=0
                loop
                    exitwhen i > 13
                    if s__HagoromoWaterW___puddle[(this)*(13)+i] != null then
                        call RemoveUnit(s__HagoromoWaterW___puddle[(this)*(13)+i])
                        call ShowUnit(s__HagoromoWaterW___puddle[(this)*(13)+i], false)
                        set s__HagoromoWaterW___puddle[(this)*(13)+i]= null
                    endif
                    set i=i + 1
                endloop
                call DestroyGroup(s__HagoromoW_damaged[this])
                call RemoveUnit(s__HagoromoW_basin)
                set s__HagoromoW_basin=null
                set s__HagoromoW_damaged[this]=null
                set s__HagoromoW_caster[this]=null
                set s__HagoromoW_shrink[this]=false
                set s__HagoromoW_empowered=false
                call s__HagoromoW_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            elseif s__HagoromoW_count[this] >= 120 and not s__HagoromoW_shrink[this] then
                set s__HagoromoW_count[this]=0
                set s__HagoromoW_shrink[this]=true
            endif
        endfunction
    
        function s__HagoromoW_throw takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real progress= s__HagoromoW_count[this] / 9.0
            local real start_x= GetUnitX(s__HagoromoW_caster[this])
            local real start_y= GetUnitY(s__HagoromoW_caster[this])
            local real new_x
            local real new_y
            local real new_z
            local real lerpX
            local real lerpY
            local real lerpZ
            local real startHeight= 95.0
            local real targetHeight= 0.0
            local real terrainZ
            local location loc
        
            set s__HagoromoW_count[this]=s__HagoromoW_count[this] + 1
        
            if s__HagoromoW_count[this] <= 8 then // Ensure the projectile moves within ~0.25 seconds
                // Get terrain Z height at current storm position
                set loc=Location(s__HagoromoW_target_x[this], s__HagoromoW_target_y[this])
                set terrainZ=GetLocationZ(loc)
                call RemoveLocation(loc)
                // Lerp approach for X, Y coordinates and height (Z axis)
                set lerpX=start_x + progress * ( s__HagoromoW_target_x[this] - start_x ) // Correct lerpX calculation
                set lerpY=start_y + progress * ( s__HagoromoW_target_y[this] - start_y ) // Correct lerpY calculation
                set lerpZ=terrainZ + startHeight * ( 1.0 - progress ) // Linear interpolation from startHeight to targetHeight
        
                call BlzSetSpecialEffectPosition(s__HagoromoW_frozen[this], lerpX, lerpY, lerpZ + 5)
            else
                set s__HagoromoW_count[this]=0
                call DestroyEffect(s__HagoromoW_frozen[this])
                set s__HagoromoW_basin=CreateUnit(GetOwningPlayer(s__HagoromoW_caster[this]), 'h089', s__HagoromoW_target_x[this], s__HagoromoW_target_y[this], 0)
                call SetUnitScale(s__HagoromoW_basin, 0.1, 0.1, 0.1)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoW_periodic)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
        
        function s__HagoromoW_actions takes nothing returns nothing
            local integer this= s__HagoromoW_allocate()
            local real new_x
            local real new_y
            local real distanceXY
            local real heightDifference= 100.0
            local real pitch
            local real angle
            local integer i= 0
            local effect e
        
            // Set up initial values
            set s__HagoromoW_caster[this]=s__HagoromoD_Hagoromo
            set s__HagoromoW_damaged[this]=CreateGroup()
            set s__HagoromoW_target_x[this]=GetSpellTargetX()
            set s__HagoromoW_target_y[this]=GetSpellTargetY()
            set s__HagoromoW_count[this]=0
            set s__HagoromoW_activated[this]=false
            set s__HagoromoW_shrink[this]=false
            
            set s__HagoromoW_empowered=false
            set HagoromoWaterW___basinScale=0.1

            set angle=Atan2(s__HagoromoW_target_y[this] - GetUnitY(s__HagoromoW_caster[this]), s__HagoromoW_target_x[this] - GetUnitX(s__HagoromoW_caster[this]))
            set s__HagoromoW_freezeDirection[this]=( angle * bj_RADTODEG ) - 180
            set new_x=GetUnitX(s__HagoromoW_caster[this]) + 32 * Cos(angle)
            set new_y=GetUnitY(s__HagoromoW_caster[this]) + 32 * Sin(angle)
        
            set distanceXY=SquareRoot(( s__HagoromoW_target_x[this] - GetUnitX(s__HagoromoW_caster[this]) ) * ( s__HagoromoW_target_x[this] - GetUnitX(s__HagoromoW_caster[this]) ) + ( s__HagoromoW_target_y[this] - GetUnitY(s__HagoromoW_caster[this]) ) * ( s__HagoromoW_target_y[this] - GetUnitY(s__HagoromoW_caster[this]) ))
        
            set pitch=Atan2(heightDifference, distanceXY) // Arctangent of (Height Difference / Distance)
        
            set s__HagoromoW_frozen[this]=AddSpecialEffect("war3mapImported\\BlueArrow.mdl", new_x, new_y)
            call BlzSetSpecialEffectHeight(s__HagoromoW_frozen[this], heightDifference)
            call BlzSetSpecialEffectYaw(s__HagoromoW_frozen[this], angle)
            call BlzSetSpecialEffectPitch(s__HagoromoW_frozen[this], pitch)
        
            if s__HagoromoW_basin != null then
                call RemoveUnit(s__HagoromoW_basin)
                call ShowUnit(s__HagoromoW_basin, false)
