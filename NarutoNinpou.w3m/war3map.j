    function s__SasukeChidori_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x= GetUnitX(s__SasukeChidori_target[this])
        local real y= GetUnitY(s__SasukeChidori_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__SasukeChidori_angle[this] )*1.0)) * (( 42)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__SasukeChidori_angle[this] )*1.0)) * (( 42)*1.0)) // INLINED!!
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__SasukeChidori_target[this], new_x)
            call SetUnitY(s__SasukeChidori_target[this], new_y)
        endif
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 120, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasukeChidori_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__SasukeChidori_damaged[this]) then
                if s__SasukeChidori_extradmg[this] then
                    call UnitDamageTarget(s__SasukeChidori_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__SasukeChidori_caster[this], true) * 12, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                else
                    call UnitDamageTarget(s__SasukeChidori_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__SasukeChidori_caster[this], true) * GetUnitAbilityLevel(s__SasukeChidori_caster[this], s__SasukeChidori_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupAddUnit(s__SasukeChidori_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        set s__SasukeChidori_count[this]=s__SasukeChidori_count[this] + 1
        if s__SasukeChidori_count[this] >= 5 then
            set i=0
            loop
                exitwhen i > 8
                set x=GetUnitX(s__SasukeChidori_target[this])
                set y=GetUnitY(s__SasukeChidori_target[this])
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 250))*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 250))*1.0)) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", new_x, new_y)
                call DestroyEffect(bj_lastCreatedEffect)
                set i=i + 1
            endloop
            call PauseUnit(s__SasukeChidori_target[this], false)
            call DestroyGroup(s__SasukeChidori_damaged[this])
            set s__SasukeChidori_damaged[this]=null
            set s__SasukeChidori_extradmg[this]=false
            call s__SasukeChidori_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__SasukeChidori_removechidori takes nothing returns nothing
        local integer id= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitRemoveAbility((s__UnitDex_Unit[(id)]), 'B00T') // INLINED!!
        call ReleaseTimer(GetExpiredTimer())
    endfunction


    function s__SasukeChidori_chidorifalse takes nothing returns nothing
        local integer id= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call DestroyEffect(s__SasukeChidori_e4)
        set s__SasukeChidori_e4=null
        set s__SasukeChidori_blackchidori=false
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__SasukeChidori_actions takes nothing returns nothing
 local integer i
 local real x
 local real y
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
           call PlaySoundOnUnitBJ(gg_snd_Sasuke_Q, 100.0, GetTriggerUnit())
        endif
        if GetUnitAbilityLevel(GetTriggerUnit(), 'A0KU') > 0 then
            set s__SasukeChidori_blackchidori=true
            set s__SasukeChidori_e4=AddSpecialEffectTarget("Black_Chidori.mdl", GetTriggerUnit(), "right hand")
            set i=0
            loop
                exitwhen i > 5
                set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Black_BoltImpact.mdx", x, y)
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.4)
                call DestroyEffect(bj_lastCreatedEffect)
                set i=i + 1
            endloop
            call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 0.4, false, function s__SasukeChidori_removechidori) // INLINED!!
            call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 6.0, false, function s__SasukeChidori_chidorifalse) // INLINED!!
        else
            set i=1
            loop
                exitwhen i > 5
                set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", x, y)
                call DestroyEffect(bj_lastCreatedEffect)
                set i=i + 1
            endloop
        endif
    endfunction

    function s__SasukeChidori_rasengan takes nothing returns nothing
        local integer this
	if ( GetUnitAbilityLevel(GetAttacker(), 'B00T') > 0 or s__SasukeChidori_blackchidori ) and GetUnitTypeId(GetAttacker()) == 'U00J' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false then
            set this=s__SasukeChidori_allocate()
            set s__SasukeChidori_caster[this]=GetAttacker()
            set s__SasukeChidori_target[this]=GetTriggerUnit()
            set s__SasukeChidori_count[this]=0
            set s__SasukeChidori_damaged[this]=CreateGroup()
            set s__SasukeChidori_angle[this]=Atan3(GetUnitX(s__SasukeChidori_caster[this]) , GetUnitY(s__SasukeChidori_caster[this]) , GetUnitX(s__SasukeChidori_target[this]) , GetUnitY(s__SasukeChidori_target[this]))
            if GetUnitAbilityLevel(GetAttacker(), 'B00T') > 0 then
                set bj_lastCreatedEffect=AddSpecialEffect("s_FreezingRing.mdl", GetUnitX(s__SasukeChidori_caster[this]), GetUnitY(s__SasukeChidori_caster[this]))
                call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
                call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__SasukeChidori_caster[this]) + 180))
                call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__SasukeChidori_caster[this]) , GetUnitY(s__SasukeChidori_caster[this])))
                call DestroyEffect(bj_lastCreatedEffect)
            else
                call DestroyEffect(AddSpecialEffect(("Effects\\s_Black_ThunderclapCaster.mdx" ), (( GetUnitX(s__SasukeChidori_target[this]) )*1.0), (( GetUnitY(s__SasukeChidori_target[this]))*1.0))) // INLINED!!
                call DestroyEffect(s__SasukeChidori_e4)
            	set s__SasukeChidori_e4=null
                set s__SasukeChidori_extradmg[this]=true
            endif
            set s__SasukeChidori_blackchidori=false
            call PauseUnit(s__SasukeChidori_target[this], true)
            call UnitRemoveAbility(GetAttacker(), 'B00T')
            call TimerStart(NewTimerEx(this), 0.03, true, function s__SasukeChidori_move)
	 endif
    endfunction

    function s__SasukeChidori_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__SasukeChidori_SPELL_ID ) , Filter(( function s__SasukeChidori_actions))) // INLINED!!
	    call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__SasukeChidori_rasengan))) // INLINED!!
    endfunction
    
