	    	set y=(((s__HiruzenQ_caster_y[this] )*1.0) + Sin((( s__HiruzenQ_angle[this] )*1.0)) * (( 30 * i)*1.0)) // INLINED!!
            	set bj_lastCreatedGroup=CreateGroup()
            	call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 180.0, null)
            	loop
                	set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                	exitwhen bj_lastCreatedUnit == null
	    		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HiruzenQ_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__HiruzenQ_damaged[this]) then
	    			call UnitDamageTarget(s__HiruzenQ_caster[this], bj_lastCreatedUnit, 4 * GetUnitAbilityLevel(s__HiruzenQ_caster[this], s__HiruzenQ_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				call GroupAddUnit(s__HiruzenQ_damaged[this], bj_lastCreatedUnit)
