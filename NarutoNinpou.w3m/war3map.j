    function s__KurotsuchiDotonDefense_cleanup takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__KurotsuchiDotonDefense_scaleZ[this]=s__KurotsuchiDotonDefense_scaleZ[this] - s__KurotsuchiDotonDefense_SCALE_STEP
        set s__KurotsuchiDotonDefense_scaleX[this]=s__KurotsuchiDotonDefense_scaleX[this] + s__KurotsuchiDotonDefense_SCALE_STEP
        set s__KurotsuchiDotonDefense_scaleY[this]=s__KurotsuchiDotonDefense_scaleY[this] + s__KurotsuchiDotonDefense_SCALE_STEP

        call BlzResetSpecialEffectMatrix(s__KurotsuchiDotonDefense_bubble[this])
        call BlzSetSpecialEffectMatrixScale(s__KurotsuchiDotonDefense_bubble[this], s__KurotsuchiDotonDefense_FINAL_X, s__KurotsuchiDotonDefense_FINAL_Y, s__KurotsuchiDotonDefense_scaleZ[this])

        if s__KurotsuchiDotonDefense_scaleZ[this] <= 0.0 then
            set s__KurotsuchiDotonDefense_caster[this]=null
            call BlzSetSpecialEffectX(s__KurotsuchiDotonDefense_bubble[this], 9844.4)
            call BlzSetSpecialEffectY(s__KurotsuchiDotonDefense_bubble[this], 6663.6)
            call DestroyEffect(s__KurotsuchiDotonDefense_bubble[this])
            call s__KurotsuchiDotonDefense_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__KurotsuchiDotonDefense_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        local group temp= CreateGroup()
        local real cx= GetUnitX(s__KurotsuchiDotonDefense_caster[this])
        local real cy= GetUnitY(s__KurotsuchiDotonDefense_caster[this])
        local real ux
        local real uy
        local real lerp

        if not IsUnitPaused(s__KurotsuchiDotonDefense_caster[this]) then
            call PauseUnit(s__KurotsuchiDotonDefense_caster[this], true)
        endif

        call GroupAddGroup(s__KurotsuchiDotonDefense_allies[this], temp)

        loop
            set u=FirstOfGroup(temp)
            exitwhen u == null
            call GroupRemoveUnit(temp, u)

            if not IsUnitPaused(u) then
                call PauseUnit(u, true)
            endif

            set ux=GetUnitX(u)
            set uy=GetUnitY(u)

            set lerp=1.0 - ( s__KurotsuchiDotonDefense_scaleX[this] / s__KurotsuchiDotonDefense_START_X )
            call SetUnitX(u, ux + ( cx - ux ) * lerp)
            call SetUnitY(u, uy + ( cy - uy ) * lerp)
        endloop
        call DestroyGroup(temp)

        if s__KurotsuchiDotonDefense_scaleZ[this] < s__KurotsuchiDotonDefense_FINAL_Z then
            set s__KurotsuchiDotonDefense_scaleZ[this]=s__KurotsuchiDotonDefense_scaleZ[this] + s__KurotsuchiDotonDefense_SCALE_STEP
        endif
        set s__KurotsuchiDotonDefense_scaleX[this]=s__KurotsuchiDotonDefense_START_X - ( s__KurotsuchiDotonDefense_START_X - s__KurotsuchiDotonDefense_FINAL_X ) * ( s__KurotsuchiDotonDefense_scaleZ[this] / s__KurotsuchiDotonDefense_FINAL_Z )
        set s__KurotsuchiDotonDefense_scaleY[this]=s__KurotsuchiDotonDefense_START_Y - ( s__KurotsuchiDotonDefense_START_Y - s__KurotsuchiDotonDefense_FINAL_Y ) * ( s__KurotsuchiDotonDefense_scaleZ[this] / s__KurotsuchiDotonDefense_FINAL_Z )

        call BlzResetSpecialEffectMatrix(s__KurotsuchiDotonDefense_bubble[this])
        call BlzSetSpecialEffectMatrixScale(s__KurotsuchiDotonDefense_bubble[this], s__KurotsuchiDotonDefense_scaleX[this], s__KurotsuchiDotonDefense_scaleY[this], s__KurotsuchiDotonDefense_scaleZ[this])
        call BlzSetSpecialEffectX(s__KurotsuchiDotonDefense_bubble[this], cx)
        call BlzSetSpecialEffectY(s__KurotsuchiDotonDefense_bubble[this], cy)
        call BlzSetSpecialEffectZ(s__KurotsuchiDotonDefense_bubble[this], GetPointZ(cx , cy))

        set s__KurotsuchiDotonDefense_count[this]=s__KurotsuchiDotonDefense_count[this] + 1

        if s__KurotsuchiDotonDefense_count[this] >= 67 then
            call PauseUnit(s__KurotsuchiDotonDefense_caster[this], false)
            call SetUnitInvulnerable(s__KurotsuchiDotonDefense_caster[this], false)

            loop
                set u=FirstOfGroup(s__KurotsuchiDotonDefense_allies[this])
                exitwhen u == null
                call GroupRemoveUnit(s__KurotsuchiDotonDefense_allies[this], u)
                call PauseUnit(u, false)
                call SetUnitInvulnerable(u, false)
            endloop

            call DestroyGroup(s__KurotsuchiDotonDefense_allies[this])
            call BlzSetSpecialEffectTimeScale(s__KurotsuchiDotonDefense_bubble[this], 100.0)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__KurotsuchiDotonDefense_cleanup)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__KurotsuchiDotonDefense_actions takes nothing returns nothing
        local integer this= s__KurotsuchiDotonDefense_allocate()
        local unit u
        local group g= CreateGroup()
        local real x
        local real y

        set s__KurotsuchiDotonDefense_caster[this]=GetTriggerUnit()
        set x=GetUnitX(s__KurotsuchiDotonDefense_caster[this])
        set y=GetUnitY(s__KurotsuchiDotonDefense_caster[this])
        set s__KurotsuchiDotonDefense_scaleZ[this]=0.0
        set s__KurotsuchiDotonDefense_scaleX[this]=s__KurotsuchiDotonDefense_START_X
        set s__KurotsuchiDotonDefense_scaleY[this]=s__KurotsuchiDotonDefense_START_Y
        set s__KurotsuchiDotonDefense_count[this]=0
        set s__KurotsuchiDotonDefense_allies[this]=CreateGroup()
        set s__KurotsuchiDotonDefense_bubble[this]=AddSpecialEffect(s__KurotsuchiDotonDefense_SFX_BUBBLE, x, y)
        call BlzSetSpecialEffectMatrixScale(s__KurotsuchiDotonDefense_bubble[this], s__KurotsuchiDotonDefense_START_X, s__KurotsuchiDotonDefense_START_Y, 0.0)

        call PauseUnit(s__KurotsuchiDotonDefense_caster[this], true)
        call SetUnitInvulnerable(s__KurotsuchiDotonDefense_caster[this], true)

        call GroupEnumUnitsInRange(g, x, y, s__KurotsuchiDotonDefense_ALLY_RADIUS, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)

            if IsUnitAlly(u, GetOwningPlayer(s__KurotsuchiDotonDefense_caster[this])) and u != s__KurotsuchiDotonDefense_caster[this] and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then //and IsUnitType(u, UNIT_TYPE_HERO)
                call PauseUnit(u, true)
                call SetUnitInvulnerable(u, true)
                call GroupAddUnit(s__KurotsuchiDotonDefense_allies[this], u)
            endif
        endloop
        call DestroyGroup(g)

        call TimerStart(NewTimerEx(this), 0.03, true, function s__KurotsuchiDotonDefense_periodic)
    endfunction

    function s__KurotsuchiDotonDefense_condition takes nothing returns boolean
        return GetSpellAbilityId() == s__KurotsuchiDotonDefense_SPELL_ID
    endfunction

    function s__KurotsuchiDotonDefense_onInit takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
        call TriggerAddCondition(t, Condition(function s__KurotsuchiDotonDefense_condition))
        call TriggerAddAction(t, function s__KurotsuchiDotonDefense_actions)
    endfunction


