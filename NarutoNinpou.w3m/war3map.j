// Trigger: ShikamaruKagemaneNew
//===========================================================================

//Implemented from module Alloc:
    
        function s__ShikamaruKagemaneNew_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShikamaruKagemaneNew_Alloc___recycle[(0)] == 0 ) then
                set s__ShikamaruKagemaneNew_Alloc___instanceCount=s__ShikamaruKagemaneNew_Alloc___instanceCount + 1
                set this=s__ShikamaruKagemaneNew_Alloc___instanceCount
            else
                set this=s__ShikamaruKagemaneNew_Alloc___recycle[(0)]
                set s__ShikamaruKagemaneNew_Alloc___recycle[(0)]=s__ShikamaruKagemaneNew_Alloc___recycle[s__ShikamaruKagemaneNew_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShikamaruKagemaneNew_deallocate takes integer this returns nothing
            set s__ShikamaruKagemaneNew_Alloc___recycle[this]=s__ShikamaruKagemaneNew_Alloc___recycle[(0)]
            set s__ShikamaruKagemaneNew_Alloc___recycle[(0)]=this
        endfunction
    
    function s__ShikamaruKagemaneNew_destroy takes integer this returns nothing
        loop
            exitwhen s__ShikamaruKagemaneNew_count[this] < 0
            set s__ShikamaruKagemaneNew_count[this]=s__ShikamaruKagemaneNew_count[this] - 1
            call BlzSetSpecialEffectScale(s__s__ShikamaruKagemaneNew_shadows[(this)*(1)+s__ShikamaruKagemaneNew_count[this]], 0)
            call DestroyEffect(s__s__ShikamaruKagemaneNew_shadows[(this)*(1)+s__ShikamaruKagemaneNew_count[this]])
            set s__s__ShikamaruKagemaneNew_shadows[(this)*(1)+s__ShikamaruKagemaneNew_count[this]]= null
        endloop
        call KillUnit(s__ShikamaruKagemaneNew_dummy[this])
        call UnitRemoveAbility(s__ShikamaruKagemaneNew_target[this], 'Bmlc')
        call UnitRemoveAbility(s__ShikamaruKagemaneNew_target[this], 'B011')
        set s__ShikamaruKagemaneNew_dummy[this]=null
        call s__ShikamaruKagemaneNew_deallocate(this)
    endfunction 
    
    function s__ShikamaruKagemaneNew_dealDamage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        //call UnitDamageTarget(this.caster, this.target, 80, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        call TimerStartEx(NewTimerEx(this) , 0.4 * GetUnitAbilityLevel(s__ShikamaruKagemaneNew_caster[this], s__ShikamaruKagemaneNew_SPELL_ID) , false , function sc__ShikamaruKagemaneNew_finish , "ShikamaruKagemaneNew_finish")
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__ShikamaruKagemaneNew_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call s__ShikamaruKagemaneNew_destroy(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__ShikamaruKagemaneNew_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ShikamaruKagemaneNew_dummy[this])
        local real y= GetUnitY(s__ShikamaruKagemaneNew_dummy[this])
        local real angle= Atan3(x , y , GetUnitX(s__ShikamaruKagemaneNew_target[this]) , GetUnitY(s__ShikamaruKagemaneNew_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local integer index
        call SetUnitX(s__ShikamaruKagemaneNew_dummy[this], new_x)
        call SetUnitY(s__ShikamaruKagemaneNew_dummy[this], new_y)

        set bj_lastCreatedEffect=AddSpecialEffect("ShadowbindTarget.mdx", new_x, new_y)
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.7)
        call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 1000.0)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 10.0)*1.0) , false) // INLINED!!
        set s__s__ShikamaruKagemaneNew_shadows[(this)*(1)+s__ShikamaruKagemaneNew_count[this]]= bj_lastCreatedEffect
        set s__s__ShikamaruKagemaneNew_shadows_x[(this)*(1)+s__ShikamaruKagemaneNew_count[this]]= new_x
        set s__s__ShikamaruKagemaneNew_shadows_y[(this)*(1)+s__ShikamaruKagemaneNew_count[this]]= new_y
        set s__s__ShikamaruKagemaneNew_shadows_angle[(this)*(1)+s__ShikamaruKagemaneNew_count[this]]= angle

        set s__ShikamaruKagemaneNew_count[this]=s__ShikamaruKagemaneNew_count[this] + 1

        if GetDistanceUnits(s__ShikamaruKagemaneNew_dummy[this] , s__ShikamaruKagemaneNew_target[this]) < 100 or s__ShikamaruKagemaneNew_count[this] > 100 then
            set index=s__ShikamaruKagemaneNew_count[this] - 1
            call TimerStart(NewTimerEx(this), 0.02, false, function s__ShikamaruKagemaneNew_dealDamage)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__ShikamaruKagemaneNew_actions takes nothing returns nothing
        local integer this= s__ShikamaruKagemaneNew_allocate()
        local unit u
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
           call PlaySoundOnUnitBJ(gg_snd_Shikamaru_Q, 100.0, GetTriggerUnit())
        endif
        set s__ShikamaruKagemaneNew_caster[this]=GetTriggerUnit()
        set s__ShikamaruKagemaneNew_target[this]=GetSpellTargetUnit()
        set s__ShikamaruKagemaneNew_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__ShikamaruKagemaneNew_caster[this]), GetUnitY(s__ShikamaruKagemaneNew_caster[this]), 270)
        set s__ShikamaruKagemaneNew_count[this]=0

        set u=CreateAbilityDummy(s__ShikamaruKagemaneNew_caster[this] , 'A00Q')
        call SetUnitAbilityLevel(u, 'A00Q', GetUnitAbilityLevel(s__ShikamaruKagemaneNew_caster[this], s__ShikamaruKagemaneNew_SPELL_ID))
        call IssueTargetOrder(u, "magicleash", s__ShikamaruKagemaneNew_target[this])
        call IssueTargetOrder(u, "magicleash", s__ShikamaruKagemaneNew_caster[this])


        call SetUnitAnimation(s__ShikamaruKagemaneNew_caster[this], "spell channel")
        call TimerStartEx(NewTimerEx(this) , 0.02 , true , function s__ShikamaruKagemaneNew_move , "ShikamaruKagemaneNew_move")
    endfunction
    

    function s__ShikamaruKagemaneNew_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(3 , s__ShikamaruKagemaneNew_SPELL_ID , function s__ShikamaruKagemaneNew_actions)
    endfunction 
    
//===========================================================================
// Trigger: ShikamaruKagemaneExplosion
//===========================================================================

//Implemented from module Alloc:
    
        function s__ShikamaruKagemaneExplosion_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)] == 0 ) then
                set s__ShikamaruKagemaneExplosion_Alloc___instanceCount=s__ShikamaruKagemaneExplosion_Alloc___instanceCount + 1
                set this=s__ShikamaruKagemaneExplosion_Alloc___instanceCount
            else
                set this=s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)]
                set s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)]=s__ShikamaruKagemaneExplosion_Alloc___recycle[s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShikamaruKagemaneExplosion_deallocate takes integer this returns nothing
            set s__ShikamaruKagemaneExplosion_Alloc___recycle[this]=s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)]
            set s__ShikamaruKagemaneExplosion_Alloc___recycle[(0)]=this
        endfunction
    
 function s__ShikamaruKagemaneExplosion_dealDamage takes nothing returns boolean
            local real x
            local real y
            if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__ShikamaruKagemaneExplosion_caster[s__ShikamaruKagemaneExplosion_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(GetFilterUnit())
                set y=GetUnitY(GetFilterUnit())
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                call UnitDamageTarget(s__ShikamaruKagemaneExplosion_caster[s__ShikamaruKagemaneExplosion_instance], GetFilterUnit(), ( 20 + GetHeroInt(s__ShikamaruKagemaneExplosion_caster[s__ShikamaruKagemaneExplosion_instance], true) ) * GetUnitAbilityLevel(s__ShikamaruKagemaneExplosion_caster[s__ShikamaruKagemaneExplosion_instance], s__ShikamaruKagemaneExplosion_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            endif
	    return false
 endfunction

    function s__ShikamaruKagemaneExplosion_destroy takes integer this returns nothing
        call PauseUnit(s__ShikamaruKagemaneExplosion_caster[this], false)
        call PauseUnit(s__ShikamaruKagemaneExplosion_target[this], false)
        loop
            exitwhen s__ShikamaruKagemaneExplosion_count2[this] < 0
            set s__ShikamaruKagemaneExplosion_count2[this]=s__ShikamaruKagemaneExplosion_count2[this] - 1
            //call BlzSetSpecialEffectScale(shadows[this][this.count2], 0)
	    call BlzSetSpecialEffectTimeScale(s__s__ShikamaruKagemaneExplosion_shadows[(this)*(1)+s__ShikamaruKagemaneExplosion_count2[this]], 1.0)
            call DestroyEffect(s__s__ShikamaruKagemaneExplosion_shadows[(this)*(1)+s__ShikamaruKagemaneExplosion_count2[this]])
            set s__s__ShikamaruKagemaneExplosion_shadows[(this)*(1)+s__ShikamaruKagemaneExplosion_count2[this]]= null
        endloop
        call RecycleUnit(s__ShikamaruKagemaneExplosion_missile[this])
        set s__ShikamaruKagemaneExplosion_caster[this]=null
        set s__ShikamaruKagemaneExplosion_target[this]=null
        set s__ShikamaruKagemaneExplosion_missile[this]=null
        call s__ShikamaruKagemaneExplosion_deallocate(this)
    endfunction
     
    function s__ShikamaruKagemaneExplosion_explode takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real offset
        local real angle
        local integer i
        set i=1
        loop
            exitwhen i > 10
