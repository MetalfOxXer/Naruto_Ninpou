    function s__TayuyaWOgre_actions takes nothing returns nothing
        local integer this= s__TayuyaWOgre_allocate()
        local real x
        local real y
        local real angle
        local real dx
        local real dy
        local real distance
        local location loc1
        local location loc2
        set TayuyaCore_IsCasting=true
        if GetUnitTypeId(TayuyaCore_Puppet) == 'h034' then
            set s__TayuyaWOgre_caster[this]=TayuyaCore_Tayuya
            set s__TayuyaWOgre_puppet[this]=TayuyaCore_Puppet
            if GetDistance(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , GetSpellTargetX() , GetSpellTargetY()) <= 800 then
                set s__TayuyaWOgre_x[this]=GetSpellTargetX()
                set s__TayuyaWOgre_y[this]=GetSpellTargetY()
                set TayuyaCore_W2Angle=Atan3(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , s__TayuyaWOgre_x[this] , s__TayuyaWOgre_y[this])
                set s__TayuyaWOgre_angle[this]=Atan3(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , s__TayuyaWOgre_x[this] , s__TayuyaWOgre_y[this])
                set s__TayuyaWOgre_dist[this]=GetDistance(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , s__TayuyaWOgre_x[this] , s__TayuyaWOgre_y[this])
                set s__TayuyaWOgre_count[this]=0
                call IssueImmediateOrder(s__TayuyaWOgre_puppet[this], "stop")
                call SetUnitFacing(s__TayuyaWOgre_puppet[this], Rad2Deg(TayuyaCore_W2Angle))
                call PauseUnit(s__TayuyaWOgre_puppet[this], true)
                call SetUnitAnimation(s__TayuyaWOgre_puppet[this], "attack slam")
                call SetUnitTimeScale(s__TayuyaWOgre_puppet[this], 3.0)
                call SetUnitTimeScalePercent(s__TayuyaWOgre_puppet[this], 60.00)
                call SetUnitAnimation(s__TayuyaWOgre_puppet[this], "attack spell")
                call TimerStart(NewTimerEx(this), 0.03, true, function s__TayuyaWOgre_jumpMovement)
            else
                set TayuyaCore_IsAttacking=true
                call SetUnitManaBJ(s__TayuyaWOgre_caster[this], BlzGetUnitRealField(s__TayuyaWOgre_caster[this], UNIT_RF_MANA) + BlzGetUnitAbilityManaCost(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID, GetUnitAbilityLevel(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID) - 1))
                call IssuePointOrder(s__TayuyaWOgre_puppet[this], "move", GetSpellTargetX(), GetSpellTargetY())
                //call IssueImmediateOrder(this.caster, "stop")
                call TimerStart(NewTimerEx(this), 0.1, false, function s__TayuyaWOgre_resetCD)
            endif
        elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h035' then
            set s__TayuyaWOgre_caster[this]=TayuyaCore_Tayuya
            set s__TayuyaWOgre_puppet[this]=TayuyaCore_Puppet
            if ( GetDistance(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , GetSpellTargetX() , GetSpellTargetY()) <= 1000 ) or ( GetDistance(GetUnitX(s__TayuyaWOgre_caster[this]) , GetUnitY(s__TayuyaWOgre_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) <= 1000 ) then
                set s__TayuyaWOgre_damaged[this]=CreateGroup()
                set s__TayuyaWOgre_count[this]=0
                call IssueImmediateOrder(s__TayuyaWOgre_puppet[this], "stop")
                set TayuyaCore_IsAttacking=false
                set s__TayuyaWOgre_max_count[this]=R2I(GetDistance(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , GetSpellTargetX() , GetSpellTargetY()) / 100)
                set s__TayuyaWOgre_count[this]=0
                set s__TayuyaWOgre_damaged[this]=CreateGroup()

                call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__TayuyaWOgre_puppet[this]) )*1.0), (( GetUnitY(s__TayuyaWOgre_puppet[this]))*1.0))) // INLINED!!
                
                call SetUnitAnimationByIndex(s__TayuyaWOgre_puppet[this], 5)
                call SetUnitTimeScalePercent(s__TayuyaWOgre_puppet[this], 200.00)
                if not TayuyaCore_IsChanneling then
                    if GetUnitAbilityLevel(TayuyaCore_Tayuya, 'A0MI') > 0 then
                        call SetUnitAnimationByIndex(TayuyaCore_Tayuya, 22)
                    else
                        call SetUnitAnimationByIndex(TayuyaCore_Tayuya, 2)
                    endif
                endif
                set TayuyaCore_W2Angle=Atan3(GetUnitX(s__TayuyaWOgre_puppet[this]) , GetUnitY(s__TayuyaWOgre_puppet[this]) , GetSpellTargetX() , GetSpellTargetY())

                set s__TayuyaWOgre_e1[this]=AddSpecialEffect("Heroes\\Doki2_Final.mdl", GetUnitX(s__TayuyaWOgre_puppet[this]), GetUnitY(s__TayuyaWOgre_puppet[this]))
                call BlzSetSpecialEffectYaw(s__TayuyaWOgre_e1[this], TayuyaCore_W2Angle)
                call BlzSetSpecialEffectScale(s__TayuyaWOgre_e1[this], 0.8)
                call BlzSetSpecialEffectAlpha(s__TayuyaWOgre_e1[this], 125)

                set s__TayuyaWOgre_e2[this]=AddSpecialEffect("Heroes\\Doki2_Final.mdl", GetUnitX(s__TayuyaWOgre_puppet[this]), GetUnitY(s__TayuyaWOgre_puppet[this]))
                call BlzSetSpecialEffectYaw(s__TayuyaWOgre_e2[this], TayuyaCore_W2Angle)
                call BlzSetSpecialEffectScale(s__TayuyaWOgre_e2[this], 0.8)
                call BlzSetSpecialEffectAlpha(s__TayuyaWOgre_e2[this], 125)

                call SetUnitFacing(s__TayuyaWOgre_puppet[this], Rad2Deg(TayuyaCore_W2Angle))
                call TimerStart(NewTimerEx(this), 0.1, false, function s__TayuyaWOgre_delayClaw)
            else
                set TayuyaCore_IsAttacking=true
                call SetUnitManaBJ(s__TayuyaWOgre_caster[this], BlzGetUnitRealField(s__TayuyaWOgre_caster[this], UNIT_RF_MANA) + BlzGetUnitAbilityManaCost(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID, GetUnitAbilityLevel(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID) - 1))
                call IssuePointOrder(s__TayuyaWOgre_puppet[this], "move", GetSpellTargetX(), GetSpellTargetY())
                call TimerStart(NewTimerEx(this), 0.1, false, function s__TayuyaWOgre_resetCD)
            endif
        elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h03H' then
            if TayuyaCore_OgreQ then
                set TayuyaCore_OgreQ=false
            endif
            set TayuyaCore_IsChanneling=true
            set s__TayuyaWOgre_caster[this]=GetTriggerUnit()
            set s__TayuyaWOgre_oxen[this]=TayuyaCore_Puppet
            set s__TayuyaWOgre_speed[this]=25
            set s__TayuyaWOgre_damaged[this]=CreateGroup()
            set TayuyaCore_WDamage=0
            set s__TayuyaWOgre_angle[this]=Atan3(GetUnitX(s__TayuyaWOgre_oxen[this]) , GetUnitY(s__TayuyaWOgre_oxen[this]) , GetSpellTargetX() , GetSpellTargetY())
            set TayuyaCore_W2Angle=Atan3(GetUnitX(s__TayuyaWOgre_oxen[this]) , GetUnitY(s__TayuyaWOgre_oxen[this]) , GetSpellTargetX() , GetSpellTargetY())
            call SetUnitFacing(s__TayuyaWOgre_oxen[this], Rad2Deg(TayuyaCore_W2Angle))
            call SetUnitAnimationByIndex(s__TayuyaWOgre_oxen[this], 4)
            call SetUnitTimeScale(s__TayuyaWOgre_oxen[this], 1.0)
            set s__TayuyaWOgre_count[this]=0
            call PauseUnit(s__TayuyaWOgre_oxen[this], true)
            if not TayuyaCore_IsChanneling then
                if GetUnitAbilityLevel(TayuyaCore_Tayuya, 'A0MI') > 0 then
                    call SetUnitAnimationByIndex(TayuyaCore_Tayuya, 22)
                else
                    call SetUnitAnimationByIndex(TayuyaCore_Tayuya, 2)
                endif
            endif
            call TimerStart(NewTimerEx(this), 0.24, false, function s__TayuyaWOgre_throw)
        endif
    endfunction 
    
