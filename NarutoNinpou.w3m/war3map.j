	set s__ToneriT_firsty[this]=(((GetUnitY(s__ToneriT_caster[this]) )*1.0) + Sin((( s__ToneriT_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
	call SetUnitFlyHeight(s__ToneriT_caster[this], 600, 600)
	call PauseUnit(s__ToneriT_caster[this], true)
	call SetUnitInvulnerable(s__ToneriT_caster[this], true)
	if BlzGetUnitSkin(s__ToneriT_caster[this]) == 'e00Q' then
		call SetUnitAnimation(s__ToneriT_caster[this], "Spell 2")
	else
		call SetUnitAnimation(s__ToneriT_caster[this], "Spell Channel")
	endif
	set x=(((GetUnitX(s__ToneriT_caster[this]) )*1.0) + Cos((( s__ToneriT_angle[this] )*1.0)) * (( 210)*1.0)) // INLINED!!
	set y=(((GetUnitY(s__ToneriT_caster[this]) )*1.0) + Sin((( s__ToneriT_angle[this] )*1.0)) * (( 210)*1.0)) // INLINED!!
	set s__ToneriT_ball[this]=CreateUnit(GetTriggerPlayer(), 'e00O', x, y, 270)
	call SetUnitFlyHeight(s__ToneriT_ball[this], 650, 650)
	call SetUnitScale(s__ToneriT_ball[this], 0.5, 0, 0)
        set s__ToneriT_damaged[this]=CreateGroup()
        set s__ToneriT_damagedtwo[this]=CreateGroup()
        set s__ToneriT_count[this]=0
        if IsUnitVisible(s__ToneriT_caster[this], GetLocalPlayer()) then
	    	call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Toneri: I will end it all with these eyes!!")
            	call PlaySoundOnUnitBJ(gg_snd_Toneri_T, 100, s__ToneriT_caster[this])
        endif
        call TimerStart(NewTimerEx(this), 1.0, false, function s__ToneriT_delay)
    endfunction 

