            endif

    
            return this
        endfunction
    
        function s__GaaraShukakuInfiniteSandstorm_deallocate takes integer this returns nothing
            set s__GaaraShukakuInfiniteSandstorm_Alloc___recycle[this]=s__GaaraShukakuInfiniteSandstorm_Alloc___recycle[(0)]
            set s__GaaraShukakuInfiniteSandstorm_Alloc___recycle[(0)]=this
        endfunction

    function s__GaaraShukakuInfiniteSandstorm_removeVision takes unit u,boolean remove returns nothing
        local integer i= 0
        loop
            exitwhen i > 11
            if i != GetPlayerId(GetOwningPlayer(bj_lastCreatedUnit)) and IsPlayerAlly(Player(i), GetOwningPlayer(bj_lastCreatedUnit)) then
                call SetPlayerAllianceBJ(Player(i), ALLIANCE_SHARED_VISION, not remove, GetOwningPlayer(bj_lastCreatedUnit))
                call SetPlayerAllianceBJ(GetOwningPlayer(bj_lastCreatedUnit), ALLIANCE_SHARED_VISION, not remove, Player(i))
            endif
            set i=i + 1
        endloop
    endfunction 

    function s__GaaraShukakuInfiniteSandstorm_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitX(s__GaaraShukakuInfiniteSandstorm_storm[this], GetUnitX(s__GaaraShukakuInfiniteSandstorm_caster[this]))
        call SetUnitY(s__GaaraShukakuInfiniteSandstorm_storm[this], GetUnitY(s__GaaraShukakuInfiniteSandstorm_caster[this]))
        call SetUnitFacing(s__GaaraShukakuInfiniteSandstorm_storm[this], GetRandomReal(0, 360))
        set s__GaaraShukakuInfiniteSandstorm_count[this]=s__GaaraShukakuInfiniteSandstorm_count[this] + 1
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__GaaraShukakuInfiniteSandstorm_damaged[this])
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(s__GaaraShukakuInfiniteSandstorm_damaged[this], bj_lastCreatedUnit)
            call s__GaaraShukakuInfiniteSandstorm_removeVision(bj_lastCreatedUnit , false)
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__GaaraShukakuInfiniteSandstorm_caster[this]), GetUnitY(s__GaaraShukakuInfiniteSandstorm_caster[this]), 1200, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__GaaraShukakuInfiniteSandstorm_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and not IsUnitInGroup(bj_lastCreatedUnit, s__GaaraShukakuInfiniteSandstorm_damaged[this]) then
                call s__GaaraShukakuInfiniteSandstorm_removeVision(bj_lastCreatedUnit , true)
                call GroupAddUnit(s__GaaraShukakuInfiniteSandstorm_damaged[this], bj_lastCreatedUnit)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__GaaraShukakuInfiniteSandstorm_count[this] > 33 * 10 then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__GaaraShukakuInfiniteSandstorm_damaged[this])
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(s__GaaraShukakuInfiniteSandstorm_damaged[this], bj_lastCreatedUnit)
                call s__GaaraShukakuInfiniteSandstorm_removeVision(bj_lastCreatedUnit , false)
            endloop
            call KillUnit(s__GaaraShukakuInfiniteSandstorm_storm[this])
            call s__GaaraShukakuInfiniteSandstorm_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__GaaraShukakuInfiniteSandstorm_actions takes nothing returns nothing
        local integer this= s__GaaraShukakuInfiniteSandstorm_allocate()
        set s__GaaraShukakuInfiniteSandstorm_caster[this]=GetTriggerUnit()
        set s__GaaraShukakuInfiniteSandstorm_storm[this]=CreateUnit(GetTriggerPlayer(), 'e08K', GetUnitX(s__GaaraShukakuInfiniteSandstorm_caster[this]), GetUnitY(s__GaaraShukakuInfiniteSandstorm_caster[this]), 270)
	call SlowAura(s__GaaraShukakuInfiniteSandstorm_storm[this] , 0.4 , 1000)
        set s__GaaraShukakuInfiniteSandstorm_count[this]=0
        set s__GaaraShukakuInfiniteSandstorm_damaged[this]=CreateGroup()
        call TimerStart(NewTimerEx(this), 0.03, true, function s__GaaraShukakuInfiniteSandstorm_periodic)
    endfunction 

    function s__GaaraShukakuInfiniteSandstorm_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(15 , s__GaaraShukakuInfiniteSandstorm_SPELL_ID , function s__GaaraShukakuInfiniteSandstorm_actions)
    endfunction 

