        local real frontX= (((x )*1.0) + Cos((( facing )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real frontY= (((y )*1.0) + Sin((( facing )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real backX= (((x )*1.0) + Cos((( facing + 180 )*1.0)) * (( 150)*1.0)) // INLINED!!
        local real backY= (((y )*1.0) + Sin((( facing + 180 )*1.0)) * (( 150)*1.0)) // INLINED!!
        local real originalSpeed= 30
