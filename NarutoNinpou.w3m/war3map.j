    function s__KakashiDoton_removeWall takes integer this returns nothing
        local integer i
        set s__KakashiDoton_finished[this]=true
        call KillUnit(s__KakashiDoton_wall[this])
        set s__KakashiDoton_wall[this]=null
        set i=0
        loop
            exitwhen i > 10
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( GetDestructableX(s___KakashiDoton_d[s__KakashiDoton_d[this]+i]) )*1.0), (( GetDestructableY(s___KakashiDoton_d[s__KakashiDoton_d[this]+i]))*1.0))) // INLINED!!
            call RemoveDestructable(s___KakashiDoton_d[s__KakashiDoton_d[this]+i])
            set s___KakashiDoton_d[s__KakashiDoton_d[this]+i]=null
            set i=i + 1
        endloop
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__KakashiDoton_damaged[this])
            exitwhen bj_lastCreatedUnit == null
            call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 600)
            call PauseUnit(bj_lastCreatedUnit, false)
            call IssueImmediateOrder(bj_lastCreatedUnit, "stop")
            call GroupRemoveUnit(s__KakashiDoton_damaged[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__KakashiDoton_damaged[this])
        set s__KakashiDoton_damaged[this]=null
    endfunction 
    
    function s__KakashiDoton_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if not s__KakashiDoton_finished[this] then
            call s__KakashiDoton_removeWall(this)
        endif
        call UnitRemoveAbility(s__KakashiDoton_caster[this], s__KakashiDoton_RELEASE_SPELL_ID)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakashiDoton_caster[this]), s__KakashiDoton_SPELL_ID, true)
        call s__KakashiDoton_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KakashiDoton_removeUnits takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if not s__KakashiDoton_finished[this] then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__KakashiDoton_damaged[this])
                exitwhen bj_lastCreatedUnit == null
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 600)
                call PauseUnit(bj_lastCreatedUnit, false)
                call IssueImmediateOrder(bj_lastCreatedUnit, "stop")
                call GroupRemoveUnit(s__KakashiDoton_damaged[this], bj_lastCreatedUnit)
            endloop
        endif
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KakashiDoton_addSpell takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakashiDoton_caster[this]), s__KakashiDoton_SPELL_ID, false)
        call UnitAddAbility(s__KakashiDoton_caster[this], s__KakashiDoton_RELEASE_SPELL_ID)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KakashiDoton_actions takes nothing returns nothing
        local integer this= s__KakashiDoton__allocate()
        local real x= GetSpellTargetX()
        local real y= GetSpellTargetY()
        local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , x , y)
        local real begin_x= (((x )*1.0) + Cos((( angle - bj_PI / 2 )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real begin_y= (((y )*1.0) + Sin((( angle - bj_PI / 2 )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real new_x
        local real new_y
        local integer i
        set s__KakashiDoton_instance=this
        set s__KakashiDoton_caster[this]=GetTriggerUnit()
        set s__KakashiDoton_damaged[this]=CreateGroup()
        set s__KakashiDoton_wall[this]=CreateUnit(GetTriggerPlayer(), 'e040', x, y, Rad2Deg(angle))
        set s__KakashiDoton_finished[this]=false
        call SetUnitAnimation(s__KakashiDoton_wall[this], "birth")
        set i=0
        loop
            exitwhen i > 10
            set new_x=(((begin_x )*1.0) + Cos((( angle + bj_PI / 2 )*1.0)) * (( i * 60)*1.0)) // INLINED!!
            set new_y=(((begin_y )*1.0) + Sin((( angle + bj_PI / 2 )*1.0)) * (( i * 60)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__KakashiDoton_damaged[this]) then
                    //call PauseUnit(bj_lastCreatedUnit, true)
                    call StunUnitTimed(s__KakashiDoton_caster[this] , bj_lastCreatedUnit , 1.0)
                    call UnitAddAbility(bj_lastCreatedUnit, 'Arav')
                    call UnitRemoveAbility(bj_lastCreatedUnit, 'Arav')
                    call SetUnitFlyHeight(bj_lastCreatedUnit, 300, 600)
                    call SetUnitAnimation(bj_lastCreatedUnit, "death")
                    call UnitDamageTarget(s__KakashiDoton_caster[this], bj_lastCreatedUnit, 85 * GetUnitAbilityLevel(s__KakashiDoton_caster[this], s__KakashiDoton_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__KakashiDoton_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s___KakashiDoton_d[s__KakashiDoton_d[this]+i]=CreateDestructable('YTfc', new_x, new_y, GetRandomReal(0, 360), 1, 0)
            set i=i + 1
        endloop
        call TimerStartEx(NewTimerEx(this) , 0.1 , false , function s__KakashiDoton_addSpell , "KakashiDoton_addSpell")
        call TimerStartEx(NewTimerEx(this) , 1.5 , false , function s__KakashiDoton_removeUnits , "KakashiDoton_removeUnits")
        call TimerStartEx(NewTimerEx(this) , 4.0 , false , function s__KakashiDoton_finish , "KakashiDoton_finish")
    endfunction 
    
    function s__KakashiDoton_release takes nothing returns nothing
        if not s__KakashiDoton_finished[s__KakashiDoton_instance] then
            call s__KakashiDoton_removeWall(s__KakashiDoton_instance)
        endif
    endfunction 
    
    function s__KakashiDoton_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__KakashiDoton_SPELL_ID ) , Filter(( function s__KakashiDoton_actions))) // INLINED!!
        call RegisterSpellEffectEvent2((s__KakashiDoton_RELEASE_SPELL_ID ) , Filter(( function s__KakashiDoton_release))) // INLINED!!
    endfunction 
    
