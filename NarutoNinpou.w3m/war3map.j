//===========================================================================
// Trigger: Kirin INIT
//===========================================================================
function Trig_Kirin_INIT_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0A9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kirin_INIT_Actions takes nothing returns nothing
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Sasuke_Hebi_T, 100, GetTriggerUnit())
    endif
    set udg_Kirin_Caster=GetTriggerUnit()
    set udg_Kirin_Point[1]=GetUnitLoc(udg_Kirin_Caster)
    set udg_Kirin_Point[2]=GetSpellTargetLoc()
    call PauseUnitBJ(true, udg_Kirin_Caster)
    call CreateNUnitsAtLoc(1, 'h014', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[2], bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(3.50, 'BTLF', GetLastCreatedUnit())
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Kirin_Point[3]=GetRandomLocInRect(RectFromCenterSizeBJ(udg_Kirin_Point[2], 800.00, 800.00))
        call CreateNUnitsAtLoc(1, 'h012', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[3], bj_UNIT_FACING)
        call UnitApplyTimedLifeBJ(3.50, 'BTLF', GetLastCreatedUnit())
        call RemoveLocation(udg_Kirin_Point[3])
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call AddWeatherEffectSaveLast(RectFromCenterSizeBJ(udg_Kirin_Point[2], 1000.00, 1000.00), 'RAhr')
    set udg_Kirin_Rain=GetLastCreatedWeatherEffect()
    call EnableWeatherEffect(udg_Kirin_Rain, true)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_Kirin_Point[4]=GetRandomLocInRect(RectFromCenterSizeBJ(udg_Kirin_Point[2], 800.00, 800.00))
call AddSpecialEffectLocBJ((udg_Kirin_Point[4] ), ( "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl")) // INLINED!!
        call DestroyEffect(GetLastCreatedEffectBJ())
        call RemoveLocation(udg_Kirin_Point[4])
        call TriggerSleepAction(0.03)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
call AddSpecialEffectTargetUnitBJ(("right,hand" ), ( udg_Kirin_Caster ), ( "Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl")) // INLINED!!
    set udg_Kirin_Hand=GetLastCreatedEffectBJ()
    call TriggerSleepAction(0.25)
    call PauseUnitBJ(false, udg_Kirin_Caster)
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Sasuke: It's over...|r")
    endif
    call IssueImmediateOrder(udg_Kirin_Caster, "stop")
    call SetUnitTimeScalePercent(udg_Kirin_Caster, 10.00)
    call SetUnitAnimation(udg_Kirin_Caster, "attack")
    call PauseUnitBJ(true, udg_Kirin_Caster)
    call CreateNUnitsAtLoc(1, 'h010', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[2], bj_UNIT_FACING)
    set udg_Kirin_Dummy=GetLastCreatedUnit()
    call TriggerSleepAction(0.35)
    call SetUnitTimeScalePercent(udg_Kirin_Caster, 100.00)
    call EnableTrigger(gg_trg_Kirin_Loop)
endfunction

//===========================================================================
function InitTrig_Kirin_INIT takes nothing returns nothing
    set gg_trg_Kirin_INIT=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Kirin_INIT, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Kirin_INIT, Condition(function Trig_Kirin_INIT_Conditions))
    call TriggerAddAction(gg_trg_Kirin_INIT, function Trig_Kirin_INIT_Actions)
endfunction


//===========================================================================
// Trigger: Kirin Loop
//===========================================================================
function Trig_Kirin_Loop_Func001Func007002003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Kirin_Caster)) == true )
endfunction

function Trig_Kirin_Loop_Func001Func008A takes nothing returns nothing
    call UnitDamageTargetBJ(udg_Kirin_Caster, GetEnumUnit(), ( 12.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Kirin_Caster, true)) ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_Kirin_Loop_Func001C takes nothing returns boolean
    if ( not ( GetUnitFlyHeight(udg_Kirin_Dummy) <= 25.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Kirin_Loop_Actions takes nothing returns nothing
    if ( Trig_Kirin_Loop_Func001C() ) then
        call PauseUnitBJ(false, udg_Kirin_Caster)
	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Kirin_Caster), 'e05R', GetUnitX(udg_Kirin_Dummy), GetUnitY(udg_Kirin_Dummy), 270)
	call KillUnit(bj_lastCreatedUnit)
	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Kirin_Caster), 'e05R', GetUnitX(udg_Kirin_Dummy), GetUnitY(udg_Kirin_Dummy), 270)
	call KillUnit(bj_lastCreatedUnit)
	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_Kirin_Caster), 'e05R', GetUnitX(udg_Kirin_Dummy), GetUnitY(udg_Kirin_Dummy), 270)
	call KillUnit(bj_lastCreatedUnit)
        call KillUnit(udg_Kirin_Dummy)
	call ShowUnit(udg_Kirin_Dummy, false)
        call TerrainDeformationRippleBJ(3.00, false, udg_Kirin_Point[2], 500.00, 500.00, 300.00, 1, 512)
        //call AddSpecialEffectLocBJEX( udg_Kirin_Point[2], "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffect(GetLastCreatedEffectBJ())
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=10
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call CreateNUnitsAtLoc(1, 'h011', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[2], bj_UNIT_FACING)
            call UnitApplyTimedLifeBJ(2.00, 'BTLF', GetLastCreatedUnit())
            call CreateNUnitsAtLoc(1, 'e007', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[2], bj_UNIT_FACING) // h013
            call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
            call CreateNUnitsAtLoc(1, 'e007', GetOwningPlayer(udg_Kirin_Caster), udg_Kirin_Point[2], bj_UNIT_FACING) // h015
            call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set udg_Kirin_Group=GetUnitsInRangeOfLocMatching(800.00, udg_Kirin_Point[2], Condition(function Trig_Kirin_Loop_Func001Func007002003))
        call ForGroupBJ(udg_Kirin_Group, function Trig_Kirin_Loop_Func001Func008A)
        call RemoveWeatherEffect(udg_Kirin_Rain)
        call DestroyEffect(udg_Kirin_Hand)
        call RemoveLocation(udg_Kirin_Point[1])
        call RemoveLocation(udg_Kirin_Point[2])
        call DisableTrigger(GetTriggeringTrigger())
    else
        call SetUnitFlyHeightBJ(udg_Kirin_Dummy, ( GetUnitFlyHeight(udg_Kirin_Dummy) - 50.00 ), 0.00)
    endif
endfunction

//===========================================================================
function InitTrig_Kirin_Loop takes nothing returns nothing
    set gg_trg_Kirin_Loop=CreateTrigger()
    call DisableTrigger(gg_trg_Kirin_Loop)
    call TriggerRegisterTimerEventPeriodic(gg_trg_Kirin_Loop, 0.04)
    call TriggerAddAction(gg_trg_Kirin_Loop, function Trig_Kirin_Loop_Actions)
endfunction


//===========================================================================
// Trigger: SasukeCursedSealLevel
//===========================================================================

 function s__SasukeCursedSealLevel_periodic takes nothing returns nothing
  local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
		if u == null then
			call ReleaseTimer(GetExpiredTimer())
		else
			if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A0LI') == 0 and GetUnitTypeId(u) != 'U00I' and GetUnitAbilityLevel(u, 'A0DS') == 10 and GetUnitAbilityLevel(u, 'A0AQ') == 10 and GetUnitAbilityLevel(u, 'A0DG') == 10 and GetUnitAbilityLevel(u, 'A0A9') == 1 then
				call UnitRemoveAbility(u, 'A0DG')
				call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0DG', false)
				call UnitRemoveAbility(u, 'A0B8')
				call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0B8', false)
				call UnitAddAbility(u, 'A0FV')
				call UnitAddAbility(u, 'A097')
				call SetUnitAbilityLevel(u, 'A097', 10)
				call BlzSetUnitSkin(u, 'U00I')
				call UnitAddAbility(u, 'A0Q5')
				call ReleaseTimer(GetExpiredTimer())
			endif
		endif
 endfunction 

 function s__SasukeCursedSealLevel_leave takes nothing returns nothing
		if GetUnitTypeId(GetLeavingUnit()) == 'U00H' then
			call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__SasukeCursedSealLevel_periodic) // INLINED!!
		endif
 endfunction 

    function s__SasukeCursedSealLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'U00I' or GetUnitTypeId(GetTriggerUnit()) == 'U00H' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0B8', true)
        endif
    endfunction

 function s__SasukeCursedSealLevel_onInit takes nothing returns nothing
		call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__SasukeCursedSealLevel_leave))) // INLINED!!
        	call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__SasukeCursedSealLevel_death))) // INLINED!!
 endfunction 

