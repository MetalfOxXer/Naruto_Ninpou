 function s__SasukeAmenotejikara_throwsword takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__SasukeAmenotejikara_sword[this])
  local real y= GetUnitY(s__SasukeAmenotejikara_sword[this])
  local real angle= Atan3(x , y , s__SasukeAmenotejikara_target_x[this] , s__SasukeAmenotejikara_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local integer i= 0
  local real height= 100 + ParabolaZ(200 , s__SasukeAmenotejikara_distance[this] , s__SasukeAmenotejikara_distance[this] - GetDistance(new_x , new_y , s__SasukeAmenotejikara_target_x[this] , s__SasukeAmenotejikara_target_y[this]))
		call SetUnitX(s__SasukeAmenotejikara_sword[this], new_x)
		call SetUnitY(s__SasukeAmenotejikara_sword[this], new_y)
		call SetUnitFlyHeight(s__SasukeAmenotejikara_sword[this], height, 0)
		if GetDistance(new_x , new_y , s__SasukeAmenotejikara_target_x[this] , s__SasukeAmenotejikara_target_y[this]) < 60 then
            set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinnegan.mdx", GetUnitX(s__SasukeAmenotejikara_caster[this]), GetUnitY(s__SasukeAmenotejikara_caster[this]))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.5)
            call DestroyEffect(bj_lastCreatedEffect)
			set bj_lastCreatedGroup=CreateGroup()
			set s__SasukeAmenotejikara_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SasukeAmenotejikara_sword[this]), GetUnitY(s__SasukeAmenotejikara_sword[this]), 300.0, Filter(function s__SasukeAmenotejikara_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'e007', GetUnitX(this.sword), GetUnitY(this.sword), 0)
	    //call SlowAura(bj_lastCreatedUnit, 0.4, 300)
            //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
			set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinneganEffect.mdx", GetUnitX(s__SasukeAmenotejikara_caster[this]), GetUnitY(s__SasukeAmenotejikara_caster[this]))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(s__SasukeAmenotejikara_caster[this]) , GetUnitY(s__SasukeAmenotejikara_caster[this])))
            call DestroyEffect(bj_lastCreatedEffect)
			set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinneganEffect.mdx", GetUnitX(s__SasukeAmenotejikara_sword[this]), GetUnitY(s__SasukeAmenotejikara_sword[this]))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(s__SasukeAmenotejikara_caster[this]) , GetUnitY(s__SasukeAmenotejikara_caster[this])))
            call DestroyEffect(bj_lastCreatedEffect)
			call SetUnitX(s__SasukeAmenotejikara_caster[this], GetUnitX(s__SasukeAmenotejikara_sword[this]))
			call SetUnitY(s__SasukeAmenotejikara_caster[this], GetUnitY(s__SasukeAmenotejikara_sword[this]))
			set s__SasukeAmenotejikara_another_sword=CreateUnit(GetOwningPlayer(s__SasukeAmenotejikara_caster[this]), 'e05O', GetUnitX(s__SasukeAmenotejikara_sword[this]), GetUnitY(s__SasukeAmenotejikara_sword[this]), GetUnitFacing(s__SasukeAmenotejikara_sword[this]))
			call UnitApplyTimedLife(s__SasukeAmenotejikara_another_sword, 'BTLF', 6.0)
			call KillUnit(s__SasukeAmenotejikara_sword[this])
			set s__SasukeAmenotejikara_sword[this]=null
			call s__SasukeAmenotejikara_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__SasukeAmenotejikara_actions takes nothing returns nothing
  local integer this= s__SasukeAmenotejikara_allocate()
  local real x
  local real y
  local integer i= 0
		set s__SasukeAmenotejikara_caster[this]=GetTriggerUnit()
		if GetSpellTargetUnit() == null then
			set s__SasukeAmenotejikara_target_x[this]=GetSpellTargetX()
			set s__SasukeAmenotejikara_target_y[this]=GetSpellTargetY()
			set s__SasukeAmenotejikara_distance[this]=GetDistance(GetUnitX(s__SasukeAmenotejikara_caster[this]) , GetUnitY(s__SasukeAmenotejikara_caster[this]) , s__SasukeAmenotejikara_target_x[this] , s__SasukeAmenotejikara_target_y[this])
			set s__SasukeAmenotejikara_sword[this]=CreateUnit(GetTriggerPlayer(), 'e05P', GetUnitX(s__SasukeAmenotejikara_caster[this]), GetUnitY(s__SasukeAmenotejikara_caster[this]), Rad2Deg(Atan3(GetUnitX(s__SasukeAmenotejikara_caster[this]) , GetUnitY(s__SasukeAmenotejikara_caster[this]) , s__SasukeAmenotejikara_target_x[this] , s__SasukeAmenotejikara_target_y[this])))
			call TimerStart(NewTimerEx(this), 0.0, true, function s__SasukeAmenotejikara_throwsword)
		else
            set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinneganEffect.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
            call DestroyEffect(bj_lastCreatedEffect)
			set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinneganEffect.mdx", GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(GetSpellTargetUnit()) , GetUnitY(GetSpellTargetUnit())))
            call DestroyEffect(bj_lastCreatedEffect)
			set bj_lastCreatedEffect=AddSpecialEffect("SasukeRinnegan.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.5)
            call DestroyEffect(bj_lastCreatedEffect)
            loop
                exitwhen i > 6
                //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'h09J', GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), GetRandomReal(0, 360))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
                set i=i + 1
            endloop
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), 300.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) then
                        call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 80.0 * GetUnitAbilityLevel(s__SasukeAmenotejikara_caster[this], s__SasukeAmenotejikara_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), 0)
            call UnitAddAbility(bj_lastCreatedUnit, 'A0U5')
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)

			set s__SasukeAmenotejikara_another_sword=CreateUnit(GetTriggerPlayer(), 'e05O', GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), GetUnitFacing(GetTriggerUnit()))
			call UnitApplyTimedLife(s__SasukeAmenotejikara_another_sword, 'BTLF', 6.0)

			set x=GetUnitX(GetSpellTargetUnit())
			set y=GetUnitY(GetSpellTargetUnit())
			call SetUnitX(GetSpellTargetUnit(), GetUnitX(GetTriggerUnit()))
			call SetUnitY(GetSpellTargetUnit(), GetUnitY(GetTriggerUnit()))
			call SetUnitX(GetTriggerUnit(), x)
			call SetUnitY(GetTriggerUnit(), y)

			call s__SasukeAmenotejikara_deallocate(this)
		endif
 endfunction 

 function s__SasukeAmenotejikara_death takes nothing returns nothing
		if GetUnitTypeId(GetTriggerUnit()) == 'e05O' or GetUnitTypeId(GetTriggerUnit()) == 'e05P' then
			if GetUnitTypeId(GetTriggerUnit()) == 'e05O' then
				set s__SasukeAmenotejikara_another_sword=null
			endif
			call ShowUnit(GetTriggerUnit(), false)
		endif
 endfunction 

 function s__SasukeAmenotejikara_onInit takes nothing returns nothing
		set s__SasukeAmenotejikara_another_sword=null
		call RegisterSpellEffectEvent2((s__SasukeAmenotejikara_SPELL_ID ) , Filter(( function s__SasukeAmenotejikara_actions))) // INLINED!!
		call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__SasukeAmenotejikara_death))) // INLINED!!
 endfunction 

