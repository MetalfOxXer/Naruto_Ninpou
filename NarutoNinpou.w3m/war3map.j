            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__Bird_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(s__Bird_caster[this], bj_lastCreatedUnit, 13.0 * GetHeroInt(s__Bird_caster[this], true) / 39, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__Bird_count[this] == 40 then
            set s__Bird_count[this]=0
            call TimerStart(NewTimerEx(this), 0.03, true, function s__Bird_fly2)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

