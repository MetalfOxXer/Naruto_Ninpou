        endfunction
    
    function s__KonohamaruHarem_kageFinish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitRemoveAbility(s__KonohamaruHarem_caster[this], s__KonohamaruHarem_HAREM_SPELL_ID)
        call SetPlayerAbilityAvailableBJ(true, s__KonohamaruHarem_KAGE_SPELL_ID, GetOwningPlayer(s__KonohamaruHarem_caster[this]))
        call s__KonohamaruHarem_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KonohamaruHarem_kageDelay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetPlayerAbilityAvailableBJ(false, s__KonohamaruHarem_KAGE_SPELL_ID, GetOwningPlayer(s__KonohamaruHarem_caster[this]))
        call UnitAddAbility(s__KonohamaruHarem_caster[this], s__KonohamaruHarem_HAREM_SPELL_ID)
        call TimerStart(NewTimerEx(this), 10.0, false, function s__KonohamaruHarem_kageFinish)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KonohamaruHarem_kageActions takes nothing returns nothing
        local integer this= s__KonohamaruHarem_allocate()
        set s__KonohamaruHarem_caster[this]=GetTriggerUnit()
        call TimerStart(NewTimerEx(this), 0.1, false, function s__KonohamaruHarem_kageDelay)
    endfunction 
    
    function s__KonohamaruHarem_haremFinish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__KonohamaruHarem_bunshins[this])
            exitwhen bj_lastCreatedUnit == null
            call PauseUnit(bj_lastCreatedUnit, false)
            //call SetUnitInvulnerable(bj_lastCreatedUnit, false)
            //call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
            call ShowUnit(bj_lastCreatedUnit, true)
            call GroupRemoveUnit(s__KonohamaruHarem_bunshins[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__KonohamaruHarem_bunshins[this])
        set s__KonohamaruHarem_bunshins[this]=null
        call s__KonohamaruHarem_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KonohamaruHarem_haremActions takes nothing returns nothing
        local integer this= s__KonohamaruHarem_allocate()
        local group g
        local group g2
        local unit u
        set g2=CreateGroup()
        set s__KonohamaruHarem_caster[this]=GetTriggerUnit()
        set s__KonohamaruHarem_bunshins[this]=CreateGroup()
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, GetPlayableMapRect(), null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitIllusion(bj_lastCreatedUnit) and GetOwningPlayer(bj_lastCreatedUnit) == GetTriggerPlayer() then
                set g=CreateGroup()
                call GroupEnumUnitsInRange(g, GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 250.0, null)
                loop
                    set u=FirstOfGroup(g)
                    exitwhen u == null
                    if IsUnitEnemy(u, GetOwningPlayer(s__KonohamaruHarem_caster[this])) and GetWidgetLife(u) > 0.405 and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(u, g2) then
			call EsnareUnitTimed(s__KonohamaruHarem_caster[this] , u , 1.0)
                        call GroupAddUnit(g2, u)
                    endif
                    call GroupRemoveUnit(g, u)
                endloop
                call DestroyGroup(g)
                set g=null
                call PauseUnit(bj_lastCreatedUnit, true)
                //call SetUnitInvulnerable(bj_lastCreatedUnit, true)
                //call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 0)
                call ShowUnit(bj_lastCreatedUnit, false)
                set u=CreateUnit(GetTriggerPlayer(), 'h095', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 270.0)
                call SetUnitX(u, GetUnitX(bj_lastCreatedUnit))
                call SetUnitY(u, GetUnitY(bj_lastCreatedUnit))
                call SetUnitAnimation(u, "spell")
                call UnitApplyTimedLife(u, 'BTLF', 2.0)
                call DestroyEffect(AddSpecialEffect(("shadowclone.mdx" ), (( GetUnitX(u) )*1.0), (( GetUnitY(u))*1.0))) // INLINED!!
                call GroupAddUnit(s__KonohamaruHarem_bunshins[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call DestroyGroup(g2)
        set g2=null
        call TimerStartEx(NewTimerEx(this) , 2.0 , false , function s__KonohamaruHarem_haremFinish , "KonohamaruHarem_haremFinish")
    endfunction 
    
    function s__KonohamaruHarem_haremDeath takes nothing returns nothing
        local real x
        local real y
        if GetUnitTypeId(GetTriggerUnit()) == 'h095' then
            set x=GetUnitX(GetTriggerUnit())
            set y=GetUnitY(GetTriggerUnit())
            call DestroyEffect(AddSpecialEffect(("shadowclone.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call ShowUnit(GetTriggerUnit(), false)
        endif
    endfunction 
    
    function s__KonohamaruHarem_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(66 , s__KonohamaruHarem_KAGE_SPELL_ID , function s__KonohamaruHarem_kageActions)
        call RegisterSpellEffectEventForId(66 , s__KonohamaruHarem_HAREM_SPELL_ID , function s__KonohamaruHarem_haremActions)
        call RegisterPlayerUnitEventForId(66 , EVENT_PLAYER_UNIT_DEATH , function s__KonohamaruHarem_haremDeath)
    endfunction
    
