    function s__KakuzuReleaseMaskE_dealDamage takes nothing returns boolean
    local unit u
				if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
					set u=CreateAbilityDummy(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance] , 'A14O')
					call SetUnitAbilityLevel(u, 'A14O', GetUnitAbilityLevel(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance], s__KakuzuReleaseMaskE_SPELL_ID))
					call IssueTargetOrder(u, "unholyfrenzy", GetFilterUnit())
					call UnitDamageTarget(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance], GetFilterUnit(), ( 50 + GetHeroStr(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance], true) / 2 ) * GetUnitAbilityLevel(s__KakuzuReleaseMaskE_caster[s__KakuzuReleaseMaskE_instance], s__KakuzuReleaseMaskE_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				endif
	    return false
 endfunction
	
 function s__KakuzuReleaseMaskE_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i
  local integer j
  local real x= GetUnitX(s__KakuzuReleaseMaskE_caster[this])
  local real y= GetUnitY(s__KakuzuReleaseMaskE_caster[this])
  local real angle= Atan3(x , y , s__KakuzuReleaseMaskE_target_x[this] , s__KakuzuReleaseMaskE_target_y[this])
  local real new_x= GetUnitX(s__KakuzuReleaseMaskE_mask[this])
  local real new_y= GetUnitY(s__KakuzuReleaseMaskE_mask[this])
  local unit u
		if s__KakuzuReleaseMaskE_type[this] == 1 then
			set bj_lastCreatedGroup=CreateGroup()
			set s__KakuzuReleaseMaskE_instance=this
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KakuzuReleaseMaskE_target_x[this], s__KakuzuReleaseMaskE_target_y[this], 400, Filter(function s__KakuzuReleaseMaskE_dealDamage))
			call DestroyGroup(bj_lastCreatedGroup)
			call DestroyEffect(AddSpecialEffect(("FireAnimation.mdl" ), (( s__KakuzuReleaseMaskE_target_x[this] )*1.0), (( s__KakuzuReleaseMaskE_target_y[this])*1.0))) // INLINED!!
		elseif s__KakuzuReleaseMaskE_type[this] == 2 then
			set i=0
			loop
				set i=i + 1
				exitwhen i > 10
				set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this]), 'e056', s__KakuzuReleaseMaskE_target_x[this], s__KakuzuReleaseMaskE_target_y[this], GetRandomReal(0, 360))
				call SetUnitScale(bj_lastCreatedUnit, 1.0, 0, 0)
				call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
			endloop
			call UnitApplyTimedLife(s__KakuzuReleaseMaskE_mask[this], 'BTLF', 2.0)
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KakuzuReleaseMaskE_target_x[this], s__KakuzuReleaseMaskE_target_y[this], 400, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
					call UnitDamageTarget(s__KakuzuReleaseMaskE_caster[this], bj_lastCreatedUnit, ( 50 + GetHeroStr(s__KakuzuReleaseMaskE_caster[this], true) ) * GetUnitAbilityLevel(s__KakuzuReleaseMaskE_caster[this], s__KakuzuReleaseMaskE_SPELL_ID) / 2, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			call SlowArea(s__KakuzuReleaseMaskE_caster[this] , s__KakuzuReleaseMaskE_target_x[this] , s__KakuzuReleaseMaskE_target_y[this] , 400)
		else
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KakuzuReleaseMaskE_target_x[this], s__KakuzuReleaseMaskE_target_y[this], 400, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
					if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
						call EsnareUnitTimed(s__KakuzuReleaseMaskE_caster[this] , bj_lastCreatedUnit , 2.0)
					endif
					call UnitDamageTarget(s__KakuzuReleaseMaskE_caster[this], bj_lastCreatedUnit, ( 50 + GetHeroStr(s__KakuzuReleaseMaskE_caster[this], true) ) * GetUnitAbilityLevel(s__KakuzuReleaseMaskE_caster[this], s__KakuzuReleaseMaskE_SPELL_ID) / 2, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			set i=0
			loop
				set i=i + 1
				exitwhen i > 8
				set j=0
				loop
					exitwhen j > 2
					set j=j + 1
					set x=(((s__KakuzuReleaseMaskE_target_x[this] )*1.0) + Cos((( Deg2Rad(i * 45) )*1.0)) * (( 120 * j)*1.0)) // INLINED!!
					set y=(((s__KakuzuReleaseMaskE_target_y[this] )*1.0) + Sin((( Deg2Rad(i * 45) )*1.0)) * (( 120 * j)*1.0)) // INLINED!!
					//call AddSpecialEffectEx("AnotherLightning.mdx", x, y)
				endloop
				call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_zhenzhengdeluolei.mdx" ), (( s__KakuzuReleaseMaskE_target_x[this] )*1.0), (( s__KakuzuReleaseMaskE_target_y[this])*1.0))) // INLINED!!
			endloop
		endif
		set s__KakuzuReleaseMaskE_mask[this]=null
		call s__KakuzuReleaseMaskE_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__KakuzuReleaseMaskE_actions takes nothing returns nothing
  local integer this= s__KakuzuReleaseMaskE_allocate()
  local integer i= GetRandomInt(1, 3)
  local integer j
  local real x= GetUnitX(GetTriggerUnit())
  local real y= GetUnitY(GetTriggerUnit())
  local real angle= Atan3(x , y , GetSpellTargetX() , GetSpellTargetY())
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
		set s__KakuzuReleaseMaskE_caster[this]=GetTriggerUnit()
		set s__KakuzuReleaseMaskE_target_x[this]=GetSpellTargetX()
		set s__KakuzuReleaseMaskE_target_y[this]=GetSpellTargetY()
		set s__KakuzuReleaseMaskE_type[this]=GetRandomInt(1, 3)
		if s__KakuzuReleaseMaskE_type[this] == 1 then
			set s__KakuzuReleaseMaskE_mask[this]=CreateUnit(GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this]), 'h031', new_x, new_y, Rad2Deg(angle))
		elseif s__KakuzuReleaseMaskE_type[this] == 2 then
			set s__KakuzuReleaseMaskE_mask[this]=CreateUnit(GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this]), 'h02Q', new_x, new_y, Rad2Deg(angle))
		else
			set s__KakuzuReleaseMaskE_mask[this]=CreateUnit(GetOwningPlayer(s__KakuzuReleaseMaskE_caster[this]), 'h02Y', new_x, new_y, Rad2Deg(angle))
		endif
		call SetUnitAnimation(s__KakuzuReleaseMaskE_mask[this], "spell")
		call SetUnitTimeScale(s__KakuzuReleaseMaskE_mask[this], 3.0)
		call UnitApplyTimedLife(s__KakuzuReleaseMaskE_mask[this], 'BTLF', 2.0)
		call TimerStart(NewTimerEx(this), 0.25, false, function s__KakuzuReleaseMaskE_delay)
 endfunction 

 function s__KakuzuReleaseMaskE_death takes nothing returns nothing
		if GetUnitTypeId(GetTriggerUnit()) == 'h031' or GetUnitTypeId(GetTriggerUnit()) == 'h02Q' or GetUnitTypeId(GetTriggerUnit()) == 'h02Y' then
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
			call ShowUnit(GetTriggerUnit(), false)
		endif
 endfunction 

 function s__KakuzuReleaseMaskE_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(5 , s__KakuzuReleaseMaskE_SPELL_ID , function s__KakuzuReleaseMaskE_actions)
		call RegisterPlayerUnitEventForId(5 , EVENT_PLAYER_UNIT_DEATH , function s__KakuzuReleaseMaskE_death)
 endfunction 

