                    call SetUnitFacingTimed(TayuyaTAbility__dummySoulsTayuya, GetUnitFacing(TayuyaTAbility__dummySoulsTayuya) + 60, 0)
                    call SetUnitAnimationByIndex(TayuyaTAbility__dummySoulsTayuya, 10)
                elseif s__TayuyaT_count3[this] == 3 then
