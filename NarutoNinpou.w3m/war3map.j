call AddSpecialEffectLocBJ((GetUnitLoc(udg_units26[101]) ), ( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")) // INLINED!!
	call DestroyEffect(bj_lastCreatedEffect)
