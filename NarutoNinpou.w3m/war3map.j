        function s__HagoromoRW_move takes nothing returns nothing
            local timer t= GetExpiredTimer()
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((t)))) // INLINED!!
            local real icicleX= 0
            local real icicleY= 0
            local real angle
            local real moveSpeed
            local integer i= 0

            set s__HagoromoRW_targetX[this]=GetUnitX(s__HagoromoRW_target[this])
            set s__HagoromoRW_targetY[this]=GetUnitY(s__HagoromoRW_target[this])

            loop
                exitwhen i >= s__HagoromoRW_icicleCount[this]

                if s__HagoromoIceRelease___icicles[i] != null then
                    if s__HagoromoIceRelease___firing[i] == false then
                        set angle=Atan2(s__HagoromoRW_targetY[this] - GetUnitY(s__HagoromoRW_caster[this]), s__HagoromoRW_targetX[this] - GetUnitX(s__HagoromoRW_caster[this]))
                        call BlzSetUnitFacingEx(s__HagoromoIceRelease___icicles[i], angle * bj_RADTODEG)

                        set angle=angle - HagoromoIceRelease___updateAngle + i * 2 * bj_PI / s__HagoromoRW_maxIcicles[this]
                        set icicleX=GetUnitX(s__HagoromoRW_caster[this]) + s__HagoromoIceRelease___offset[i] * Cos(angle)
                        set icicleY=GetUnitY(s__HagoromoRW_caster[this]) + s__HagoromoIceRelease___offset[i] * Sin(angle)
                        call SetUnitX(s__HagoromoIceRelease___icicles[i], icicleX)
                        call SetUnitY(s__HagoromoIceRelease___icicles[i], icicleY)

                    else
                        set moveSpeed=10
                        set angle=Atan2(s__HagoromoRW_targetY[this] - GetUnitY(s__HagoromoIceRelease___icicles[i]), s__HagoromoRW_targetX[this] - GetUnitX(s__HagoromoIceRelease___icicles[i]))

                        call BlzSetUnitFacingEx(s__HagoromoIceRelease___icicles[i], angle * bj_RADTODEG) // + 90

                        set bj_lastCreatedGroup=CreateGroup()
                        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__HagoromoIceRelease___icicles[i]), GetUnitY(s__HagoromoIceRelease___icicles[i]), 50, null)
                        loop
                            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                            exitwhen bj_lastCreatedUnit == null
                            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoRW_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(bj_lastCreatedUnit) >= 0.045 then
                                if bj_lastCreatedUnit == s__HagoromoRW_targetPrevious[this] or s__HagoromoRW_targetPrevious[this] == null then
                                    set s__HagoromoRW_targetPrevious[this]=bj_lastCreatedUnit
                                    set s__HagoromoRW_hitMulti[this]=s__HagoromoRW_hitMulti[this] + 0.1
                                    if i == s__HagoromoRW_icicleCount[this] - 1 then
                                        call EsnareUnitTimed(s__HagoromoRW_caster[this] , bj_lastCreatedUnit , 1.5)
                                    endif
                                else
                                    set s__HagoromoRW_targetPrevious[this]=bj_lastCreatedUnit
                                    set s__HagoromoRW_hitMulti[this]=1.15
                                endif

                                call UnitDamageTarget(s__HagoromoRW_caster[this], bj_lastCreatedUnit, ( ( 500 + ( GetHeroInt(s__HagoromoRW_caster[this], true) * ( GetHeroLevel(s__HagoromoRW_caster[this]) / 10.0 ) ) ) / s__HagoromoRW_maxIcicles[this] ) * s__HagoromoRW_hitMulti[this], true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                                call SlowedUnit(s__HagoromoRW_caster[this] , bj_lastCreatedUnit , 0.5)
                                call KillUnit(s__HagoromoIceRelease___icicles[i])
                                set s__HagoromoIceRelease___icicles[i]= null
                                exitwhen true
                            endif
                            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                        endloop
                        call DestroyGroup(bj_lastCreatedGroup)

                        if s__HagoromoIceRelease___icicles[i] != null then
                            call SetUnitX(s__HagoromoIceRelease___icicles[i], GetUnitX(s__HagoromoIceRelease___icicles[i]) + moveSpeed * Cos(angle))
                            call SetUnitY(s__HagoromoIceRelease___icicles[i], GetUnitY(s__HagoromoIceRelease___icicles[i]) + moveSpeed * Sin(angle))
                        endif
                    endif
                endif

                set i=i + 1
            endloop

            if IsUnitAliveBJ(s__HagoromoIceRelease___icicles[s__HagoromoRW_icicleCount[this] - 1]) == false and s__HagoromoIceRelease___firing[s__HagoromoRW_icicleCount[this] - 1] == true then
                set i=0
                loop
                    exitwhen i >= s__HagoromoRW_icicleCount[this]
                    if s__HagoromoIceRelease___icicles[i] != null then
                        call RemoveUnit(s__HagoromoIceRelease___icicles[i])
                        set s__HagoromoIceRelease___icicles[i]= null
                    endif
                    set i=i + 1
                endloop
                call ReleaseTimer(t)
                call s__HagoromoRW_deallocate(this)
            endif

            set t=null
        endfunction

        function s__HagoromoRW_fire takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

            if s__HagoromoIceRelease___icicles[s__HagoromoRW_count[this]] != null and s__HagoromoIceRelease___firing[s__HagoromoRW_count[this]] == false then
                set HagoromoIceRelease___updateAngle=HagoromoIceRelease___updateAngle + ( 36 * bj_DEGTORAD )
                set s__HagoromoIceRelease___firing[s__HagoromoRW_count[this]]= true
                call UnitApplyTimedLife(s__HagoromoIceRelease___icicles[s__HagoromoRW_count[this]], 'BTLF', 3.0)
                
                if s__HagoromoRW_count[this] >= s__HagoromoRW_maxIcicles[this] then
                    call ReleaseTimer(GetExpiredTimer())
                    call s__HagoromoRW_deallocate(this)
                endif
            endif

            set s__HagoromoRW_count[this]=s__HagoromoRW_count[this] + 1
        endfunction

        // Periodically creates and scales icicles around the caster
        function s__HagoromoRW_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer this2
            local real progress= s__HagoromoRW_count[this] / I2R(s__HagoromoRW_duration[this])
            local real icicleX= GetUnitX(s__HagoromoRW_caster[this])
            local real icicleY= GetUnitY(s__HagoromoRW_caster[this])
            local real icicleHeight= 100 * progress
            local real size
            local real angle= Atan2(GetUnitY(s__HagoromoRW_target[this]) - GetUnitY(s__HagoromoRW_caster[this]), GetUnitX(s__HagoromoRW_target[this]) - GetUnitX(s__HagoromoRW_caster[this]))
            local integer i= 0

            // Loop through all existing icicles and adjust their positions and size
            loop
                exitwhen i >= s__HagoromoRW_icicleCount[this]
                set size=0.05 + s__HagoromoIceRelease___offsetScale[i] * progress
                set icicleX=GetUnitX(s__HagoromoRW_caster[this]) + s__HagoromoIceRelease___offset[i] * Cos(angle + i * 2 * bj_PI / s__HagoromoRW_maxIcicles[this])
                set icicleY=GetUnitY(s__HagoromoRW_caster[this]) + s__HagoromoIceRelease___offset[i] * Sin(angle + i * 2 * bj_PI / s__HagoromoRW_maxIcicles[this])
                if s__HagoromoIceRelease___icicles[i] != null then
                    call SetUnitFacing(s__HagoromoIceRelease___icicles[i], ( angle * bj_RADTODEG ))
                    call SetUnitX(s__HagoromoIceRelease___icicles[i], icicleX)
                    call SetUnitY(s__HagoromoIceRelease___icicles[i], icicleY)
                    call SetUnitFlyHeight(s__HagoromoIceRelease___icicles[i], icicleHeight, 0)
                    call SetUnitScale(s__HagoromoIceRelease___icicles[i], size, size, size)
                endif
                set i=i + 1
            endloop

            // Create a new icicle if the spell is still in progress and the max icicle count is not reached
            if ( s__HagoromoRW_icicleCount[this] < s__HagoromoRW_maxIcicles[this] ) and ( ModuloInteger(s__HagoromoRW_count[this], 3) == 0 ) and ( s__HagoromoRW_count[this] <= s__HagoromoRW_duration[this] ) then
                set size=0.05 + s__HagoromoIceRelease___offsetScale[i] * progress
                set s__HagoromoIceRelease___icicles[s__HagoromoRW_icicleCount[this]]= CreateUnit(GetOwningPlayer(s__HagoromoRW_caster[this]), 'h07M', icicleX, icicleY, Rad2Deg(angle))
                call SetUnitFlyHeight(s__HagoromoIceRelease___icicles[s__HagoromoRW_icicleCount[this]], icicleHeight, 0)
                call SetUnitScale(s__HagoromoIceRelease___icicles[s__HagoromoRW_icicleCount[this]], size, size, size)
                set s__HagoromoRW_icicleCount[this]=s__HagoromoRW_icicleCount[this] + 1
            endif

            set s__HagoromoRW_count[this]=s__HagoromoRW_count[this] + 1

            if s__HagoromoRW_count[this] > s__HagoromoRW_duration[this] then
                set this2=s__HagoromoRW_allocate()
                set s__HagoromoRW_count[this]=0
                set s__HagoromoRW_startX[this]=GetUnitX(s__HagoromoRW_caster[this])
                set s__HagoromoRW_startY[this]=GetUnitY(s__HagoromoRW_caster[this])
                set s__HagoromoRW_targetX[this]=GetUnitX(s__HagoromoRW_target[this])
                set s__HagoromoRW_targetY[this]=GetUnitY(s__HagoromoRW_target[this])
                set s__HagoromoRW_maxIcicles[this2]=s__HagoromoRW_maxIcicles[this]
                set s__HagoromoRW_count[this2]=0
                
                call TimerStart(NewTimerEx(this), 0.01, true, function s__HagoromoRW_move)
                
                call TimerStart(NewTimerEx(this2), 0.05, true, function s__HagoromoRW_fire)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction

        function s__HagoromoRW_actions takes nothing returns nothing
            local integer this= s__HagoromoRW_allocate()
            local integer i= 0

            // Initialize caster, target, and initial values
            set s__HagoromoRW_caster[this]=s__HagoromoD_Hagoromo
            set s__HagoromoRW_target[this]=GetSpellTargetUnit()
            set s__HagoromoRW_startX[this]=GetUnitX(s__HagoromoD_Hagoromo)
            set s__HagoromoRW_startY[this]=GetUnitY(s__HagoromoD_Hagoromo)
            set s__HagoromoRW_targetX[this]=GetUnitX(s__HagoromoRW_target[this])
            set s__HagoromoRW_targetY[this]=GetUnitY(s__HagoromoRW_target[this])
            set s__HagoromoRW_count[this]=0
            set s__HagoromoRW_duration[this]=30 // Spell lasts for 1 second
            set s__HagoromoRW_maxIcicles[this]=10
            set s__HagoromoRW_icicleCount[this]=0
            set s__HagoromoRW_hitMulti[this]=1.15
            set s__HagoromoRW_targetPrevious[this]=null
            set HagoromoIceRelease___updateAngle=0

            call SetUnitAnimationByIndex(s__HagoromoRW_caster[this], 43)
            loop
                exitwhen i >= s__HagoromoRW_maxIcicles[this]
                set s__HagoromoIceRelease___offset[i]= 100
                set s__HagoromoIceRelease___firing[i]= false
                set s__HagoromoIceRelease___offsetScale[i]= GetRandomReal(0.20, 0.95)
                set i=i + 1
            endloop

            call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoRW_periodic)
        endfunction

// scope HagoromoIceRelease ends

//***************************************************************************
//*  HagoromoRE
// scope HagoromoScorchRelease begins



        function s__HagoromoRE_create takes unit caster,real angle returns integer
            local integer this= s__HagoromoRE__allocate()
            local integer j= 0
            local real scale
            local real scaleFactor
            set s__HagoromoRE_caster[this]=caster
            set s__HagoromoRE_casterX[this]=GetUnitX(caster)
            set s__HagoromoRE_casterY[this]=GetUnitY(caster)
            set s__HagoromoRE_angle[this]=angle
            set s__HagoromoRE_distance[this]=0
            set s__HagoromoRE_lifeTime[this]=0
            set s__HagoromoRE_tempGroup[this]=CreateGroup() // Create the temp group per instance
            
            // Initialize effects
            loop
                exitwhen j >= HagoromoScorchRelease___SEGMENT_EFFECT_PIECES
                set s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+j]=AddSpecialEffect(HagoromoScorchRelease___FIRE_EFFECT, s__HagoromoRE_casterX[this], s__HagoromoRE_casterY[this])
                // Linear scaling: start at 3.0 for the bottom piece and scale down to 0.01 for the top
                set scaleFactor=3.0 - ( j * ( 3.0 - 0.01 ) / ( HagoromoScorchRelease___SEGMENT_EFFECT_PIECES - 1 ) ) // Linear interpolation
                set scale=scaleFactor * ( 0.03 + 0.03 * j - 0.03 * ( s__HagoromoRE_lifeTime[this] / HagoromoScorchRelease___SEGMENT_DURATION ) )
                call BlzSetSpecialEffectScale(s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+j], scale)
                set j=j + 1
            endloop
            
            set s__HagoromoRE_segmentTimer[this]=NewTimerEx(this)
            call TimerStart(s__HagoromoRE_segmentTimer[this], HagoromoScorchRelease___TIMER_INTERVAL, true, function sc__HagoromoRE_periodic)
            return this
        endfunction

        function s__HagoromoRE_destroy takes integer this returns nothing
            local integer i= 0
            // Clean up effects and group
            loop
                exitwhen i >= HagoromoScorchRelease___SEGMENT_EFFECT_PIECES
                call DestroyEffect(s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+i])
                set i=i + 1
            endloop
            call DestroyGroup(s__HagoromoRE_tempGroup[this]) // Clean up temp group
            call ReleaseTimer(s__HagoromoRE_segmentTimer[this])
            call s__HagoromoRE_deallocate(this)
        endfunction

        function s__HagoromoRE_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x
            local real y
            local real z
            local real currentAngle
            local real scale
            local real cosCurrentAngle
            local real sinCurrentAngle
            local unit u
            local integer i= 0
            local real dynamicZOffset
            local real scaleFactor
            
            // Update lifetime
            set s__HagoromoRE_lifeTime[this]=s__HagoromoRE_lifeTime[this] + HagoromoScorchRelease___TIMER_INTERVAL
            if s__HagoromoRE_lifeTime[this] >= HagoromoScorchRelease___SEGMENT_DURATION then
                call s__HagoromoRE_destroy(this)
                return
            endif

            // Move segment
            set s__HagoromoRE_distance[this]=s__HagoromoRE_distance[this] + HagoromoScorchRelease___SEGMENT_SPEED * HagoromoScorchRelease___TIMER_INTERVAL
            set s__HagoromoRE_angle[this]=s__HagoromoRE_angle[this] + HagoromoScorchRelease___SEGMENT_ROTATION_SPEED * HagoromoScorchRelease___TIMER_INTERVAL
            
            // Precompute frequently used math outside the loop
            set dynamicZOffset=HagoromoScorchRelease___Z_OFFSET_INCREMENT * ( s__HagoromoRE_lifeTime[this] / HagoromoScorchRelease___SEGMENT_DURATION )

            // Loop to position each effect piece with a spiral Z offset, diagonal lag effect, and visual adjustments
            loop
                exitwhen i >= HagoromoScorchRelease___SEGMENT_EFFECT_PIECES
                set currentAngle=s__HagoromoRE_angle[this] - i * HagoromoScorchRelease___ANGLE_DELAY
                
                // Cache the Cos and Sin values as they are used multiple times
                set cosCurrentAngle=Cos(currentAngle)
                set sinCurrentAngle=Sin(currentAngle)

                // Calculate x and y positions based on expanded distance with incremental diagonal offset
                set x=s__HagoromoRE_casterX[this] + ( s__HagoromoRE_distance[this] + ( i * HagoromoScorchRelease___DIAGONAL_OFFSET ) ) * cosCurrentAngle
                set y=s__HagoromoRE_casterY[this] + ( s__HagoromoRE_distance[this] + ( i * HagoromoScorchRelease___DIAGONAL_OFFSET ) ) * sinCurrentAngle

                // Set z value
                set z=i * dynamicZOffset
                
                // Linear scaling: start at 3.0 for the bottom piece and scale down to 0.01 for the top
                set scaleFactor=3.0 - ( i * ( 3.0 - 0.01 ) / ( HagoromoScorchRelease___SEGMENT_EFFECT_PIECES - 1 ) ) // Linear interpolation
                set scale=scaleFactor * ( 0.03 + 0.03 * i - 0.03 * ( s__HagoromoRE_lifeTime[this] / HagoromoScorchRelease___SEGMENT_DURATION ) )

                // Apply scaling
                call BlzSetSpecialEffectScale(s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+i], scale)

                // Flame flicker effect: apply random slight variations in position
                call BlzSetSpecialEffectPosition(s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+i], x, y, z)
                call BlzSetSpecialEffectYaw(s___HagoromoRE_segmentEffects[s__HagoromoRE_segmentEffects[this]+i], currentAngle)

                set i=i + 1
            endloop

            // Check for collisions every 0.12 seconds to reduce processing
            if ModuloReal(s__HagoromoRE_lifeTime[this], 0.08) < HagoromoScorchRelease___TIMER_INTERVAL then
                call GroupClear(s__HagoromoRE_tempGroup[this]) // Using instance-based tempGroup
                call GroupEnumUnitsInRange(s__HagoromoRE_tempGroup[this], x, y, HagoromoScorchRelease___SEGMENT_RADIUS, null)
                loop
                    set u=FirstOfGroup(s__HagoromoRE_tempGroup[this])
                    exitwhen u == null
                    
                    call GroupRemoveUnit(s__HagoromoRE_tempGroup[this], u) // Remove to prevent infinite loop

                    // Check if the unit has already been damaged by any segment
                    if IsUnitAliveBJ(u) and IsUnitEnemy(u, GetOwningPlayer(s__HagoromoRE_caster[this])) and not IsUnitInGroup(u, HagoromoScorchRelease___damagedUnits) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                        // Damage the unit
                        call UnitDamageTarget(s__HagoromoRE_caster[this], u, 650 + GetHeroInt(s__HagoromoRE_caster[this], true) * ( GetHeroLevel(s__HagoromoRE_caster[this]) / 10.0 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)

                        // Add the unit to the shared damaged group to prevent future collisions
                        call GroupAddUnit(HagoromoScorchRelease___damagedUnits, u)
                    endif
                endloop
            endif
        endfunction

        function s__HagoromoRE_actions takes nothing returns nothing
            local integer i= 0
            local integer segmentInstance
            local real initialAngle
            local real segmentAngle
            local unit caster= s__HagoromoD_Hagoromo
            local player casterPlayer= GetOwningPlayer(caster)
            local real mouseX= (s__UserMouse_mouseX[s__UserMouse__staticgetindex((casterPlayer))]) // INLINED!!
            local real mouseY= (s__UserMouse_mouseY[s__UserMouse__staticgetindex((casterPlayer))]) // INLINED!!
            local real casterX= GetUnitX(caster)
            local real casterY= GetUnitY(caster)

            // Clear the damagedUnits group at the start of a new instance to allow other instances to hit the same target
            call GroupClear(HagoromoScorchRelease___damagedUnits)

            set initialAngle=Atan2(mouseY - casterY, mouseX - casterX)

	    call SetUnitAnimationByIndex(caster, 44)
            loop
                exitwhen i >= HagoromoScorchRelease___SEGMENT_COUNT
                set segmentAngle=initialAngle + i * ( 2 * bj_PI / HagoromoScorchRelease___SEGMENT_COUNT )
                set segmentInstance=s__HagoromoRE_create(caster , segmentAngle)
                set i=i + 1
            endloop
        endfunction

// scope HagoromoScorchRelease ends

//***************************************************************************
//*  HagoromoTQ

// scope ExplodingChargeDetonatingPalm begins

    function Abs takes real x returns real
        if x < 0 then
            return - x
        endif
        return x
    endfunction



        function s__KnockbackData_create takes unit target,real angle,real distance returns integer
            local integer this= s__KnockbackData__allocate()
            set s__KnockbackData_target[this]=target
            set s__KnockbackData_angle[this]=angle
            set s__KnockbackData_distance[this]=distance
            set s__KnockbackData_distanceMoved[this]=0
            set s__KnockbackData_knockbackTimer[this]=NewTimerEx(this)
            call TimerStart(s__KnockbackData_knockbackTimer[this], 0.03, true, function sc__KnockbackData_applyKnockback)
            return this
        endfunction

        function s__KnockbackData_applyKnockback takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real moveX
            local real moveY
            local real progress= s__KnockbackData_distanceMoved[this] / s__KnockbackData_distance[this]
            local real knockbackSpeed= ( ExplodingChargeDetonatingPalm___KNOCKBACK_DISTANCE / ExplodingChargeDetonatingPalm___KNOCKBACK_DURATION ) * ( 1 - progress )

            if s__KnockbackData_distanceMoved[this] < s__KnockbackData_distance[this] then
                set moveX=knockbackSpeed * 0.03 * Cos(s__KnockbackData_angle[this])
                set moveY=knockbackSpeed * 0.03 * Sin(s__KnockbackData_angle[this])
                call SetUnitX(s__KnockbackData_target[this], GetUnitX(s__KnockbackData_target[this]) + moveX)
                call SetUnitY(s__KnockbackData_target[this], GetUnitY(s__KnockbackData_target[this]) + moveY)
                set s__KnockbackData_distanceMoved[this]=s__KnockbackData_distanceMoved[this] + SquareRoot(moveX * moveX + moveY * moveY)
            else
                call sc__KnockbackData_cleanup(this)
            endif
        endfunction

        function s__KnockbackData_cleanup takes integer this returns nothing
            call DestroyTimer(s__KnockbackData_knockbackTimer[this])
            call s__KnockbackData_deallocate(this)
        endfunction


        function s__HagoromoTQ_create takes unit caster,real angle,real startX,real startY returns integer
            local integer this= s__HagoromoTQ__allocate()
            set s__HagoromoTQ_caster[this]=caster
            set s__HagoromoTQ_angle[this]=angle
            set s__HagoromoTQ_startX[this]=startX
            set s__HagoromoTQ_startY[this]=startY
            set s__HagoromoTQ_distanceTravelled[this]=0
            set s__HagoromoTQ_dashTimer[this]=NewTimerEx(this)
            set s__HagoromoTQ_delayTimer[this]=NewTimerEx(this)

            // Start with a 0.03s delay to set the animation
            call TimerStart(s__HagoromoTQ_delayTimer[this], 0.03, false, function sc__HagoromoTQ_onDelayComplete)
            return this
        endfunction

        function s__HagoromoTQ_onDelayComplete takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            
            call SetUnitAnimationByIndex(s__HagoromoTQ_caster[this], 33) // 33 or 34
            call SetUnitTimeScalePercent(s__HagoromoTQ_caster[this], 500.00)
            call DestroyTimer(s__HagoromoTQ_delayTimer[this])
            
            // Now start the dash
            call sc__HagoromoTQ_startDash(this)
        endfunction

        function s__HagoromoTQ_startDash takes integer this returns nothing
            local real spawnX
            local real spawnY
            // Create fire trail effect
            set spawnX=GetUnitX(s__HagoromoTQ_caster[this]) - ( 96 * Cos(s__HagoromoTQ_angle[this]) )
            set spawnY=GetUnitY(s__HagoromoTQ_caster[this]) - ( 96 * Sin(s__HagoromoTQ_angle[this]) )
            set s__HagoromoTQ_fireTrail[this]=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_TRAIL, spawnX, spawnY, Rad2Deg(s__HagoromoTQ_angle[this]))

            call TimerStart(s__HagoromoTQ_dashTimer[this], 0.03, true, function sc__HagoromoTQ_onDash)
        endfunction

        function s__HagoromoTQ_onDash takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real casterX= GetUnitX(s__HagoromoTQ_caster[this])
            local real casterY= GetUnitY(s__HagoromoTQ_caster[this])
            local real moveX
            local real moveY

            // Check if we've travelled the full distance
            if s__HagoromoTQ_distanceTravelled[this] >= ExplodingChargeDetonatingPalm___DASH_DISTANCE then
                call sc__HagoromoTQ_onExplosion(this)
                call sc__HagoromoTQ_cleanup(this)
            else
                // Calculate movement for this tick
                set moveX=ExplodingChargeDetonatingPalm___DASH_SPEED * 0.03 * Cos(s__HagoromoTQ_angle[this])
                set moveY=ExplodingChargeDetonatingPalm___DASH_SPEED * 0.03 * Sin(s__HagoromoTQ_angle[this])
                set s__HagoromoTQ_distanceTravelled[this]=s__HagoromoTQ_distanceTravelled[this] + SquareRoot(moveX * moveX + moveY * moveY)

                // Move the caster
                call SetUnitX(s__HagoromoTQ_caster[this], casterX + moveX)
                call SetUnitY(s__HagoromoTQ_caster[this], casterY + moveY)

                // Drag units along
                call sc__HagoromoTQ_dragUnits(this)
            endif
        endfunction

        function s__HagoromoTQ_dragUnits takes integer this returns nothing
            local unit u
            local real casterX= GetUnitX(s__HagoromoTQ_caster[this])
            local real casterY= GetUnitY(s__HagoromoTQ_caster[this])
            local real positionX
            local real positionY

            call GroupEnumUnitsInRange(tempGroup, casterX, casterY, ExplodingChargeDetonatingPalm___DRAG_RADIUS, null)
            loop
                set u=FirstOfGroup(tempGroup)
                exitwhen u == null

                if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoTQ_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                    // Position units directly in front of the caster at a fixed distance
                    set positionX=casterX + 100 * Cos(s__HagoromoTQ_angle[this])
                    set positionY=casterY + 100 * Sin(s__HagoromoTQ_angle[this])
                    call SetUnitPosition(u, positionX, positionY)
                endif
                call GroupRemoveUnit(tempGroup, u)
            endloop
        endfunction

        function s__HagoromoTQ_onExplosion takes integer this returns nothing
            local unit u
            local real x= GetUnitX(s__HagoromoTQ_caster[this])
            local real y= GetUnitY(s__HagoromoTQ_caster[this])
            local real angleToUnit
            local real knockbackDistance
            local real knockbackX
            local real knockbackY
            local unit explosionDummy
            local unit explosionDummy2
            local unit explosionDummy3
            local unit explosionDummy4
            local unit explosionDummy5
            local unit explosionDummy6
            local unit explosionDummy7
            local unit explosionDummy8
            local unit explosionDummy9
            local timer t

            // Create dummy unit for explosion visual effect
            set explosionDummy=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]))
            set explosionDummy2=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) + 10)
            set explosionDummy3=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) - 10)
            set explosionDummy4=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) + 20)
            set explosionDummy5=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) - 20)
            set explosionDummy6=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) + 30)
            set explosionDummy7=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) - 30)
            set explosionDummy8=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) + 40)
            set explosionDummy9=CreateUnit(GetOwningPlayer(s__HagoromoTQ_caster[this]), ExplodingChargeDetonatingPalm___DUMMY_UNIT_EXPLOSION, x, y, Rad2Deg(s__HagoromoTQ_angle[this]) - 40)

            // Store the dummy unit in the hashtable and link it with a timer
            set t=(NewTimerEx(0)) // INLINED!!
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 0, explosionDummy)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 1, explosionDummy2)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 2, explosionDummy3)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 3, explosionDummy4)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 4, explosionDummy5)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 5, explosionDummy6)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 6, explosionDummy7)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 7, explosionDummy8)
            call SaveUnitHandle(explosionEffectTable, GetHandleId(t), 8, explosionDummy9)
            call TimerStart(t, 1.0, false, function sc__HagoromoTQ_destroyDummyAfterDelay)

            // Damage and knockback units in the explosion area
            call GroupEnumUnitsInRange(tempGroup, x, y, ExplodingChargeDetonatingPalm___FAN_RADIUS, null)
            loop
                set u=FirstOfGroup(tempGroup)
                exitwhen u == null

                if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoTQ_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                    // Calculate the angle between the caster and the unit
                    set angleToUnit=Atan2(GetUnitY(u) - y, GetUnitX(u) - x)

                    // Check if the unit is within the fan angle
                    if Abs(angleToUnit - s__HagoromoTQ_angle[this]) <= ExplodingChargeDetonatingPalm___FAN_ANGLE then
                        // Apply explosion damage
                        call UnitDamageTarget(s__HagoromoTQ_caster[this], u, 550 + ( GetHeroInt(s__HagoromoTQ_caster[this], true) * ( GetHeroLevel(s__HagoromoTQ_caster[this]) / 10.0 ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)

                        // Calculate knockback distance based on proximity (closer = stronger knockback)
                        set knockbackDistance=ExplodingChargeDetonatingPalm___KNOCKBACK_DISTANCE * ( 1 - ( SquareRoot(( GetUnitX(u) - x ) * ( GetUnitX(u) - x ) + ( GetUnitY(u) - y ) * ( GetUnitY(u) - y )) / ExplodingChargeDetonatingPalm___FAN_RADIUS ) )
                        
                        // Create knockback effect
                        call s__KnockbackData_create(u , angleToUnit , knockbackDistance)
                    endif
                endif
                call GroupRemoveUnit(tempGroup, u)
            endloop
        endfunction

        function s__HagoromoTQ_destroyDummyAfterDelay takes nothing returns nothing
            local timer t= GetExpiredTimer()
            local unit explosionDummy

            // Retrieve the dummy unit from the hashtable
            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 0)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 1)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 2)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 3)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 4)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 5)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 6)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 7)
            call RemoveUnit(explosionDummy)

            set explosionDummy=LoadUnitHandle(explosionEffectTable, GetHandleId(t), 8)
            call RemoveUnit(explosionDummy)

            call FlushChildHashtable(explosionEffectTable, GetHandleId(t))

            call ReleaseTimer(t)
        endfunction

        function s__HagoromoTQ_cleanup takes integer this returns nothing
            call RemoveUnit(s__HagoromoTQ_fireTrail[this])
            call SetUnitTimeScalePercent(s__HagoromoTQ_caster[this], 100.00)
            call PauseUnit(s__HagoromoTQ_caster[this], false)
            call DestroyTimer(s__HagoromoTQ_dashTimer[this])
            call s__HagoromoTQ_deallocate(this)
        endfunction

        function s__HagoromoTQ_actions takes nothing returns nothing
            local unit caster= GetTriggerUnit()
            local real casterX= GetUnitX(caster)
            local real casterY= GetUnitY(caster)
            local real targetX= GetSpellTargetX()
            local real targetY= GetSpellTargetY()
            local real angle= Atan2(targetY - casterY, targetX - casterX)
            call PauseUnit(caster, true)
            call s__HagoromoTQ_create(caster , angle , casterX , casterY)
        endfunction

