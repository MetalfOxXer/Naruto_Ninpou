// Trigger: ShinoMushikyu
//===========================================================================

function Trig_ShinoMushikyu_Conditions takes nothing returns boolean
	return ( ( GetSpellAbilityId() == 'A1D2' ) )
endfunction

function Trig_ShinoMushikyu_Func005Func001C takes nothing returns boolean
	return ( ( UnitHasBuffBJ(udg_units31[439], 'B03Y') ) )
endfunction

function Trig_ShinoMushikyu_Func006Func003001003 takes nothing returns boolean
	return ( IsUnitAliveBJ(GetFilterUnit()) )
endfunction

function Trig_ShinoMushikyu_Func006Func003A takes nothing returns nothing
	call UnitDamageTargetBJ(GetTriggerUnit(), GetEnumUnit(), 13.0 * GetHeroInt(GetTriggerUnit(), true), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
endfunction

function Trig_ShinoMushikyu_Func006C takes nothing returns boolean
	return ( ( UnitHasBuffBJ(udg_units31[439], 'BNdh') ) )
endfunction

function Trig_ShinoMushikyu_Actions takes nothing returns nothing
 local real hp
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
		call PlaySoundOnUnitBJ(gg_snd_Shino_T_Mushikui, 100.0, GetTriggerUnit())
	endif
	set udg_units31[439]=GetSpellTargetUnit()
	call CreateTextTagUnitBJ("!", udg_units31[439], 0, 14.00, 100, 20.00, 20.00, 0)
	call ShowTextTagForceBJ(false, GetLastCreatedTextTag(), GetPlayersAll())
	set udg_texttag01=bj_lastCreatedTextTag
	call TriggerSleepAction(0.10)
	set udg_integers02[349]=1
	loop
		exitwhen udg_integers02[349] > 4
		call SetTextTagText(udg_texttag01, ( I2S(( 6 - udg_integers02[349] )) + "!" ), 0.02)
		call SetTextTagPosUnit(udg_texttag01, udg_units31[439], 0)
		call TriggerSleepAction(1.00)
		set udg_integers02[349]=udg_integers02[349] + 1
	endloop
		loop
			set hp=GetUnitState(udg_units31[439], UNIT_STATE_LIFE)
			call UnitDamageTargetBJ(GetTriggerUnit(), udg_units31[439], 13.0 * GetHeroInt(GetTriggerUnit(), true), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
			exitwhen ( hp - GetUnitState(udg_units31[439], UNIT_STATE_LIFE) > 500 or not UnitAlive(udg_units31[439]) )
			call TriggerSleepAction(0.10)
		endloop
		call SetUnitInvulnerable(udg_units31[439], false)
		set udg_locations06[104]=GetUnitLoc(udg_units31[439])
		set bj_forLoopAIndex=1
		set bj_forLoopAIndexEnd=30
		loop
			exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
			set udg_locations06[105]=PolarProjectionBJ(udg_locations06[104], GetRandomReal(0, 150.00), GetRandomReal(0, 360))
			call CreateNUnitsAtLoc(1, 'uskm', GetOwningPlayer(GetTriggerUnit()), udg_locations06[105], GetRandomReal(0, 360))
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
			call SetUnitTimeScale(bj_lastCreatedUnit, 0.30)
			call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(0.00, 120.00), 0.00)
			call RemoveLocation(udg_locations06[105])
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		call RemoveLocation(udg_locations06[104])
	call DestroyTextTag(udg_texttag01)
	call UnitRemoveAbility(udg_units31[439], 'B03Y')
endfunction

function InitTrig_ShinoMushikyu takes nothing returns nothing
	set udg_trigger304=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger304, EVENT_PLAYER_UNIT_SPELL_EFFECT)
	call TriggerAddCondition(udg_trigger304, Condition(function Trig_ShinoMushikyu_Conditions))
	call TriggerAddAction(udg_trigger304, function Trig_ShinoMushikyu_Actions)
        call EnableTriggerForId(17 , udg_trigger304)
endfunction 

//===========================================================================
// Trigger: ShinoUltimateChoice
//===========================================================================
//textmacro instance: UltimateChoice("Shino", "A031", "A01U", "ARARE", "Dai Kikaichuu Arare no Jutsu", "A1D2", "MUSHIKIU", "Kikaichuu: Mushikiu")

//Implemented from module Alloc:
    
        function s__ShinoUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShinoUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__ShinoUltimateChoice_Alloc___instanceCount=s__ShinoUltimateChoice_Alloc___instanceCount + 1
                set this=s__ShinoUltimateChoice_Alloc___instanceCount
            else
                set this=s__ShinoUltimateChoice_Alloc___recycle[(0)]
                set s__ShinoUltimateChoice_Alloc___recycle[(0)]=s__ShinoUltimateChoice_Alloc___recycle[s__ShinoUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShinoUltimateChoice_deallocate takes integer this returns nothing
            set s__ShinoUltimateChoice_Alloc___recycle[this]=s__ShinoUltimateChoice_Alloc___recycle[(0)]
            set s__ShinoUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__ShinoUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__ShinoUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__ShinoUltimateChoice_caster[this]), 'A031', false)
        else
            call s__ShinoUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ShinoUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__ShinoUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__ShinoUltimateChoice_u, s__ShinoUltimateChoice_ARARE)
            call UnitMakeAbilityPermanent(s__ShinoUltimateChoice_u, true, s__ShinoUltimateChoice_ARARE)
        else
            call UnitAddAbility(s__ShinoUltimateChoice_u, s__ShinoUltimateChoice_MUSHIKIU)
            call UnitMakeAbilityPermanent(s__ShinoUltimateChoice_u, true, s__ShinoUltimateChoice_MUSHIKIU)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A031', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A031', false)
        set s__s__ShinoUltimateChoice_b[0]= null
        set s__s__ShinoUltimateChoice_b[1]= null
        set s__ShinoUltimateChoice_u=null
        call s__Dialog_destroy(s__ShinoUltimateChoice_d)
        call DestroyBoolExpr(s__ShinoUltimateChoice_pick)
        set s__ShinoUltimateChoice_pick=null
        set this=s__ShinoUltimateChoice_allocate()
        set s__ShinoUltimateChoice_caster[this]=s__ShinoUltimateChoice_u
        set s__ShinoUltimateChoice_pp[this]=GetOwningPlayer(s__ShinoUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__ShinoUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__ShinoUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__ShinoUltimateChoice_ARARE) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__ShinoUltimateChoice_MUSHIKIU) == 0 then
            set s__ShinoUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__ShinoUltimateChoice_d,"Pick a skill")
            set s__s__ShinoUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__ShinoUltimateChoice_d)], ("Dai Kikaichuu Arare no Jutsu" ), ( 0))) // INLINED!!
            set s__s__ShinoUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__ShinoUltimateChoice_d)], ("Kikaichuu: Mushikiu" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__ShinoUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__ShinoUltimateChoice_d,s__ShinoUltimateChoice_pick)
            set s__ShinoUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__ShinoUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A031' then
            set s__ShinoUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__ShinoUltimateChoice_onInit takes nothing returns nothing
        set s__ShinoUltimateChoice_pick=Condition(function s__ShinoUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__ShinoUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A031' ) , Filter(( function s__ShinoUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Shino", "A031", "A01U", "ARARE", "Dai Kikaichuu Arare no Jutsu", "A1D2", "MUSHIKIU", "Kikaichuu: Mushikiu")

