        set s__ItachiTsukuyomi_ItachiTsukuyomiActive=false
        call RegisterSpellEffectEventForId(27 , s__ItachiTsukuyomi_SPELL_ID , function s__ItachiTsukuyomi_actions)
        call RegisterPlayerUnitEventForId(27 , EVENT_PLAYER_UNIT_DEATH , function s__ItachiTsukuyomi_death)
    endfunction
    
