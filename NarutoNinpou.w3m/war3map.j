    function s__MadaraIntonRaiha_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer id
        set id=0
        loop
            exitwhen id > 9
            call s__Lightning_release(s___MadaraIntonRaiha_light[s__MadaraIntonRaiha_light[this]+id],0.5)
            set id=id + 1
        endloop
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__MadaraIntonRaiha_damaged[this])
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(s__MadaraIntonRaiha_damaged[this], bj_lastCreatedUnit)
        endloop
        call PauseUnit(s__MadaraIntonRaiha_caster[this], false)
        call SetUnitFlyHeight(s__MadaraIntonRaiha_caster[this], 0, 2000)
        call SetUnitAnimation(s__MadaraIntonRaiha_caster[this], "stand")
        call DestroyGroup(s__MadaraIntonRaiha_damaged[this])
        set s__MadaraIntonRaiha_caster[this]=null
        set s__MadaraIntonRaiha_damaged[this]=null
        call s__MadaraIntonRaiha_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__MadaraIntonRaiha_begin takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer id
        local unit u
        local real x
        local real y
        set id=0
        loop
            exitwhen id > 9
            set x=(((s__MadaraIntonRaiha_target_x[this] )*1.0) + Cos((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( GetRandomReal(0, 300))*1.0)) // INLINED!!
            set y=(((s__MadaraIntonRaiha_target_y[this] )*1.0) + Sin((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( GetRandomReal(0, 300))*1.0)) // INLINED!!
            set s___MadaraIntonRaiha_light[s__MadaraIntonRaiha_light[this]+id]=s__Lightning_create("MYNL" , true , 0.5)
            call s__Lightning_attachToUnit(s___MadaraIntonRaiha_light[s__MadaraIntonRaiha_light[this]+id],true , s__MadaraIntonRaiha_caster[this] , 185)
            call s__Lightning_attachToPoint(s___MadaraIntonRaiha_light[s__MadaraIntonRaiha_light[this]+id],false , x , y , 0 , true)
            set id=id + 1
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__MadaraIntonRaiha_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call UnitDamageTarget(s__MadaraIntonRaiha_caster[this], bj_lastCreatedUnit, 1800, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	        call SlowedUnit(s__MadaraIntonRaiha_caster[this] , bj_lastCreatedUnit , 3.0)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" ), (( s__MadaraIntonRaiha_target_x[this] )*1.0), (( s__MadaraIntonRaiha_target_y[this])*1.0))) // INLINED!!
        //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'h096', GetUnitX(this.caster), GetUnitY(this.caster), GetUnitFacing(this.caster)) 
        //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.1)
        call TimerStart(NewTimerEx(this), 0.5, false, function s__MadaraIntonRaiha_finish)
        call ReleaseTimer(GetExpiredTimer())
        set u=null
    endfunction
    
    function s__MadaraIntonRaiha_shoot takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitAnimation(s__MadaraIntonRaiha_caster[this], "spell throw")
        call TimerStart(NewTimerEx(this), 0.1, false, function s__MadaraIntonRaiha_begin)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__MadaraIntonRaiha_actions takes nothing returns nothing
        local integer this= s__MadaraIntonRaiha__allocate()
        set s__MadaraIntonRaiha_caster[this]=GetTriggerUnit()
        set s__MadaraIntonRaiha_damaged[this]=CreateGroup()
        set s__MadaraIntonRaiha_target_x[this]=GetSpellTargetX()
        set s__MadaraIntonRaiha_target_y[this]=GetSpellTargetY()
        call UnitAddAbility(s__MadaraIntonRaiha_caster[this], 'Arav')
        call UnitRemoveAbility(s__MadaraIntonRaiha_caster[this], 'Arav')
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetSpellTargetX(), GetSpellTargetY(), 300.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call GroupAddUnit(s__MadaraIntonRaiha_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call PauseUnit(s__MadaraIntonRaiha_caster[this], true)
        call SetUnitFlyHeight(s__MadaraIntonRaiha_caster[this], 125, 1500)
        call TimerStart(NewTimerEx(this), 0.15, false, function s__MadaraIntonRaiha_shoot)
    endfunction
    
