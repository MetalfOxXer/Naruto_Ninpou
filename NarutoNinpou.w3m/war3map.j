        	call BlzSetSpecialEffectScale(s__s__KankuroSalamander_fire[(this)*(1)+s__KankuroSalamander_count[this]], 0.4 + 0.06 * s__KankuroSalamander_count[this])
		call BlzSetSpecialEffectTimeScale(s__s__KankuroSalamander_fire[(this)*(1)+s__KankuroSalamander_count[this]], 3.0)
