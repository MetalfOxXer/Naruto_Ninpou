    function s__TentenUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__TentenUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TentenUltimateChoice_caster[this]), 'A0T9', false)
        else
            call s__TentenUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__TentenUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__TentenUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__TentenUltimateChoice_u, s__TentenUltimateChoice_TENSASAI)
            call UnitMakeAbilityPermanent(s__TentenUltimateChoice_u, true, s__TentenUltimateChoice_TENSASAI)
        else
            call UnitAddAbility(s__TentenUltimateChoice_u, s__TentenUltimateChoice_BASHOSEN)
            call UnitMakeAbilityPermanent(s__TentenUltimateChoice_u, true, s__TentenUltimateChoice_BASHOSEN)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0T9', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0T9', false)
        set s__s__TentenUltimateChoice_b[0]= null
        set s__s__TentenUltimateChoice_b[1]= null
        set s__TentenUltimateChoice_u=null
        call s__Dialog_destroy(s__TentenUltimateChoice_d)
        call DestroyBoolExpr(s__TentenUltimateChoice_pick)
        set s__TentenUltimateChoice_pick=null
        set this=s__TentenUltimateChoice_allocate()
        set s__TentenUltimateChoice_caster[this]=s__TentenUltimateChoice_u
        set s__TentenUltimateChoice_pp[this]=GetOwningPlayer(s__TentenUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__TentenUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__TentenUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__TentenUltimateChoice_TENSASAI) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__TentenUltimateChoice_BASHOSEN) == 0 then
            set s__TentenUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__TentenUltimateChoice_d,"Pick a skill")
            set s__s__TentenUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__TentenUltimateChoice_d)], ("Sogu: Tensasai" ), ( 0))) // INLINED!!
            set s__s__TentenUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__TentenUltimateChoice_d)], ("Bashosen: Five waves of destruction" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__TentenUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__TentenUltimateChoice_d,s__TentenUltimateChoice_pick)
            set s__TentenUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__TentenUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0T9' then
            set s__TentenUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__TentenUltimateChoice_onInit takes nothing returns nothing
        set s__TentenUltimateChoice_pick=Condition(function s__TentenUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__TentenUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0T9' ) , Filter(( function s__TentenUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Tenten", "A0T9", "A026", "TENSASAI", "Sogu: Tensasai", "A0T8", "BASHOSEN", "Bashosen: Five waves of destruction")

//===========================================================================
// Trigger: TemariPassive
//===========================================================================

    function s__TemariPassive_actions takes nothing returns nothing
        local real damage
        if GetUnitAbilityLevel(GetAttacker(), 'A01A') > 0 then
            set udg_TemariAttack=udg_TemariAttack + 1
            if udg_TemariAttack == 3 or ( UnitHasItemOfTypeBJ(GetAttacker(), 'I06C') and udg_TemariAttack == 2 ) then
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'e02O', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), 0)
                call UnitAddAbility(bj_lastCreatedUnit, 'A0W3')
                call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0W3', GetUnitAbilityLevel(GetAttacker(), 'A01A'))
                call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", GetAttacker())
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
                set udg_TemariAttack=0
            endif
        endif
        if GetUnitAbilityLevel(GetAttacker(), 'B04S') > 0 then
            call UnitRemoveAbility(GetAttacker(), 'B04S')
            set damage=30 * GetUnitAbilityLevel(GetAttacker(), 'A01A') + GetHeroAgi(GetAttacker(), true)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(GetAttacker())) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
			if IsUnitIllusion(GetAttacker()) then
                    		call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, damage / 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			else
                    		call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			endif
                    call DestroyEffect(AddSpecialEffect(("Windcutter.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
    endfunction 

    function s__TemariPassive_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__TemariPassive_actions))) // INLINED!!
    endfunction 
    
