    function s__SasoriBomb_throw takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real dist
 local real angle1
 local real x= GetUnitX(s__SasoriBomb_projectile[this])
 local real y= GetUnitY(s__SasoriBomb_projectile[this])
 local real angle= Atan3(x , y , s__SasoriBomb_target_x[this] , s__SasoriBomb_target_y[this])
 local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
 local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
 local real h= ParabolaZ(400 , s__SasoriBomb_dist_caster[this] , s__SasoriBomb_dist_caster[this] - GetDistance(new_x , new_y , s__SasoriBomb_target_x[this] , s__SasoriBomb_target_y[this]))
	call SetUnitFlyHeight(s__SasoriBomb_projectile[this], h, 0)
	call SetUnitX(s__SasoriBomb_projectile[this], new_x)
	call SetUnitY(s__SasoriBomb_projectile[this], new_y)
	if GetDistance(x , y , s__SasoriBomb_target_x[this] , s__SasoriBomb_target_y[this]) < 50 then
	   call KillUnit(s__SasoriBomb_projectile[this])
	   call ShowUnit(s__SasoriBomb_projectile[this], false)
	   set s__SasoriBomb_projectile[this]=null
       	   set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SasoriBomb_caster[this]), 'ncpn', s__SasoriBomb_target_x[this], s__SasoriBomb_target_y[this], 270)
       	   call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
       	   call TimerStart(NewTimerEx(this), 0.03, true, function s__SasoriBomb_periodic)
           call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction 

