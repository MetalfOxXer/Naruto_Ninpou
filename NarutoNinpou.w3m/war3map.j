 local integer p
	set x=(((GetUnitX(s__KimimaroSawarabiNoMai_dummy[this]) )*1.0) + Cos((( 3.8 * s__KimimaroSawarabiNoMai_count[this] )*1.0)) * (( 10.0 * s__KimimaroSawarabiNoMai_count[this])*1.0)) // INLINED!!
	set y=(((GetUnitY(s__KimimaroSawarabiNoMai_dummy[this]) )*1.0) + Sin((( 3.8 * s__KimimaroSawarabiNoMai_count[this] )*1.0)) * (( 10.0 * s__KimimaroSawarabiNoMai_count[this])*1.0)) // INLINED!!
