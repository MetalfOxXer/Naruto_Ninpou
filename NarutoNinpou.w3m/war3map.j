 function s__HinataFarm_dealDamage takes nothing returns boolean
	    if GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HinataFarm_caster[s__HinataFarm_instance])) and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
                call UnitDamageTarget(s__HinataFarm_caster[s__HinataFarm_instance], GetFilterUnit(), ( 20 * GetUnitAbilityLevel(s__HinataFarm_caster[s__HinataFarm_instance], 'A0VW') ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        	call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\SpellSteal\\SpellStealTarget.mdl" ), (( GetUnitX(GetFilterUnit()) )*1.0), (( GetUnitY(GetFilterUnit()))*1.0))) // INLINED!!
		call IssueTargetOrder(GetFilterUnit(), "attack", s__HinataFarm_caster[s__HinataFarm_instance])
		call SetUnitAnimation(GetFilterUnit(), "death")
            endif
	    return false
 endfunction


 function s__HinataFarm_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call SetUnitTimeScalePercent(s__HinataFarm_caster[this], 300.0)
		if GetUnitTypeId(s__HinataFarm_caster[this]) == 'E07T' then
			call SetUnitAnimation(s__HinataFarm_caster[this], "Spell")
		else
			call SetUnitAnimation(s__HinataFarm_caster[this], "attack")
		endif
		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Shugo Hakke Rokujuuyon Shou.mdl", GetUnitX(s__HinataFarm_caster[this]), GetUnitY(s__HinataFarm_caster[this]))
        	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
        	call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.8)
        	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.3)*1.0) , true) // INLINED!!
		if ModuloInteger(s__HinataFarm_count[this], 2) == 0 then
    		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__HinataFarm_caster[this]) )*1.0), (( GetUnitY(s__HinataFarm_caster[this]))*1.0))) // INLINED!!
		endif

		set bj_lastCreatedGroup=CreateGroup()
		set s__HinataFarm_instance=this
        	call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__HinataFarm_caster[this]), GetUnitY(s__HinataFarm_caster[this]), 400.0, Filter(function s__HinataFarm_dealDamage))
        	call DestroyGroup(bj_lastCreatedGroup)

		set s__HinataFarm_count[this]=s__HinataFarm_count[this] + 1
		if s__HinataFarm_count[this] > 4 then
        		if GetUnitPropWindow(s__HinataFarm_caster[this]) == 0 then
                		call SetUnitPropWindow(s__HinataFarm_caster[this], s__HinataFarm_window[this])
            		endif
			call SetUnitTimeScalePercent(s__HinataFarm_caster[this], 100)
			call s__HinataFarm_deallocate(this)
            		call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__HinataFarm_actions takes nothing returns nothing
  local integer this= s__HinataFarm_allocate()
		set s__HinataFarm_caster[this]=GetTriggerUnit()
		set s__HinataFarm_count[this]=0
		if GetUnitPropWindow(s__HinataFarm_caster[this]) != 0 then
            		set s__HinataFarm_window[this]=GetUnitPropWindow(s__HinataFarm_caster[this])
            		call SetUnitPropWindow(s__HinataFarm_caster[this], 0)
        	endif
        	call SlowArea(s__HinataFarm_caster[this] , GetUnitX(s__HinataFarm_caster[this]) , GetUnitY(s__HinataFarm_caster[this]) , 400)
		set bj_lastCreatedUnit=CreateAbilityDummy(s__HinataFarm_caster[this] , 'A02A')
		call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", s__HinataFarm_caster[this])
		call TimerStart(NewTimerEx(this), 0.05, true, function s__HinataFarm_periodic)
 endfunction 

 function s__HinataFarm_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2((s__HinataFarm_SPELL_ID ) , Filter(( function s__HinataFarm_actions))) // INLINED!!
 endfunction 

