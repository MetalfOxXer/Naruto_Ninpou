        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitFlyHeight(s__HanzoUppercut_caster[this], 0, 2500)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__HanzoUppercut_punch takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__HanzoUppercut_caster[this]) , GetUnitY(s__HanzoUppercut_caster[this]) , GetUnitX(s__HanzoUppercut_target[this]) , GetUnitY(s__HanzoUppercut_target[this]))
        local real new_x= (((GetUnitX(s__HanzoUppercut_target[this]) )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__HanzoUppercut_target[this]) )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 100)*1.0)) // INLINED!!
        call ShowUnit(s__HanzoUppercut_caster[this], true)
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__HanzoUppercut_caster[this]) )*1.0), (( GetUnitY(s__HanzoUppercut_caster[this]))*1.0))) // INLINED!!
        call SelectUnitForPlayerSingle(s__HanzoUppercut_caster[this], GetOwningPlayer(s__HanzoUppercut_caster[this]))
        call SetUnitX(s__HanzoUppercut_caster[this], new_x)
        call SetUnitY(s__HanzoUppercut_caster[this], new_y)
        call SetUnitAnimation(s__HanzoUppercut_caster[this], "attack")
        call UnitAddAbility(s__HanzoUppercut_caster[this], 'Arav')
        call UnitRemoveAbility(s__HanzoUppercut_caster[this], 'Arav')
        call SetUnitFlyHeight(s__HanzoUppercut_caster[this], 500, 2500)
        set s__HanzoUppercut_angle[this]=angle
        call PauseUnit(s__HanzoUppercut_target[this], true)
        call SetUnitAnimation(s__HanzoUppercut_target[this], "death")
        call UnitDamageTarget(s__HanzoUppercut_caster[this], s__HanzoUppercut_target[this], GetHeroStr(s__HanzoUppercut_caster[this], true) * GetUnitAbilityLevel(s__HanzoUppercut_caster[this], s__HanzoUppercut_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
    
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__HanzoUppercut_target[this]) )*1.0), (( GetUnitY(s__HanzoUppercut_target[this]))*1.0))) // INLINED!!
        set bj_lastCreatedEffect=AddSpecialEffect("PunchImpact.mdl", GetUnitX(s__HanzoUppercut_target[this]), GetUnitY(s__HanzoUppercut_target[this]))
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__HanzoUppercut_caster[this]) + 180))
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.3)
        call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__HanzoUppercut_target[this]) , GetUnitY(s__HanzoUppercut_target[this])))
        call DestroyEffect(bj_lastCreatedEffect)
        set bj_lastCreatedEffect=AddSpecialEffect("Hit.mdx", GetUnitX(s__HanzoUppercut_target[this]), GetUnitY(s__HanzoUppercut_target[this]))
        call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__HanzoUppercut_target[this]) , GetUnitY(s__HanzoUppercut_target[this])))
        call DestroyEffect(bj_lastCreatedEffect)

        call TimerStart(NewTimerEx(this), 0.03, true, function s__HanzoUppercut_knockback)
        call TimerStart(NewTimerEx(this), 0.2, false, function s__HanzoUppercut_comedown)
    endfunction 

    function s__HanzoUppercut_actions takes nothing returns nothing
        local integer this
        local unit target= null
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 1000, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and IsUnitVisible(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and ( GetUnitAbilityLevel(bj_lastCreatedUnit, 'B021') > 0 or GetUnitAbilityLevel(bj_lastCreatedUnit, 'B06W') > 0 ) then
                if target == null or GetWidgetLife(bj_lastCreatedUnit) < GetWidgetLife(target) then
                    set target=bj_lastCreatedUnit
                endif
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if target == null then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 800, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and IsUnitVisible(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    if target == null or GetDistanceUnits(GetTriggerUnit() , bj_lastCreatedUnit) < GetDistanceUnits(GetTriggerUnit() , target) then
                        set target=bj_lastCreatedUnit
                    endif
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        if target != null then
            set this=s__HanzoUppercut_allocate()
            set s__HanzoUppercut_caster[this]=GetTriggerUnit()
            set s__HanzoUppercut_target[this]=target
            set s__HanzoUppercut_count[this]=0
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__HanzoUppercut_caster[this]) )*1.0), (( GetUnitY(s__HanzoUppercut_caster[this]))*1.0))) // INLINED!!
            call ShowUnit(s__HanzoUppercut_caster[this], false)
            call PauseUnit(s__HanzoUppercut_caster[this], true)
            call TimerStart(NewTimerEx(this), 0.2, false, function s__HanzoUppercut_punch)
	else
	    call IssueImmediateOrder(GetTriggerUnit(), "stop")
    	    call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A18B', 10.00)
        endif
    endfunction 

    function s__HanzoUppercut_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(86 , s__HanzoUppercut_SPELL_ID , function s__HanzoUppercut_actions)
    endfunction 

//===========================================================================
// Trigger: HanzoSemi
//===========================================================================

    
    function s__HanzoSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HanzoSemi_ball[this])
        local real y= GetUnitY(s__HanzoSemi_ball[this])
        local integer i= 0
        local real new_x= (((x )*1.0) + Cos((( s__HanzoSemi_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__HanzoSemi_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real angle

		if GetWidgetLife(s__HanzoSemi_caster[this]) > 0.405 then
			set s__HanzoSemi_cx[this]=GetUnitX(s__HanzoSemi_caster[this])
			set s__HanzoSemi_cy[this]=GetUnitY(s__HanzoSemi_caster[this])
		endif

		set angle=Atan3(s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this] , GetUnitX(s__HanzoSemi_ball[this]) , GetUnitY(s__HanzoSemi_ball[this]))

        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!

        if not s__HanzoSemi_hit[this] then
            call SetUnitX(s__HanzoSemi_ball[this], new_x)
            call SetUnitY(s__HanzoSemi_ball[this], new_y)
            set s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]=CreateUnit(GetOwningPlayer(s__HanzoSemi_caster[this]), 'n02E', x, y, Rad2Deg(s__HanzoSemi_angle[this]))
            call UnitApplyTimedLife(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]], 'BTLF', 5.0)
            set s__HanzoSemi_count[this]=s__HanzoSemi_count[this] + 1
        else
	    set s__HanzoSemi_angle[this]=Atan3(GetUnitX(s__HanzoSemi_ball[this]) , GetUnitY(s__HanzoSemi_ball[this]) , s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this])
            set s__HanzoSemi_count[this]=s__HanzoSemi_count[this] - 1
            call SetUnitX(s__HanzoSemi_ball[this], GetUnitX(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]))
            call SetUnitY(s__HanzoSemi_ball[this], GetUnitY(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]))
	    if s__HanzoSemi_target[this] != null then
		call SetUnitX(s__HanzoSemi_target[this], GetUnitX(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]))
            	call SetUnitY(s__HanzoSemi_target[this], GetUnitY(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]))
	    endif
            call KillUnit(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]])
            call ShowUnit(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]], false)
            set s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count[this]]=null
        endif

	if s__HanzoSemi_count[this] > 0 then
        set s__HanzoSemi_count2[this]=0
        loop
            set new_x=(((s__HanzoSemi_cx[this] )*1.0) + Cos((( angle )*1.0)) * (( 30 * s__HanzoSemi_count2[this])*1.0)) // INLINED!!
            set new_y=(((s__HanzoSemi_cy[this] )*1.0) + Sin((( angle )*1.0)) * (( 30 * s__HanzoSemi_count2[this])*1.0)) // INLINED!!
            if s__HanzoSemi_count2[this] == s__HanzoSemi_count[this] then
                exitwhen true
            else
		if GetDistance(s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this] , new_x , new_y) >= GetDistance(s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this] , GetUnitX(s__HanzoSemi_ball[this]) , GetUnitY(s__HanzoSemi_ball[this])) then
		        call SetUnitX(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count2[this]], GetUnitX(s__HanzoSemi_ball[this]))
                	call SetUnitY(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count2[this]], GetUnitY(s__HanzoSemi_ball[this]))
		else
                	call SetUnitX(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count2[this]], new_x)
                	call SetUnitY(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+s__HanzoSemi_count2[this]], new_y)
		endif
                set s__HanzoSemi_count2[this]=s__HanzoSemi_count2[this] + 1
            endif
        endloop
	endif

	call BlzSetSpecialEffectX(s__HanzoSemi_e[this], GetUnitX(s__HanzoSemi_ball[this]))
	call BlzSetSpecialEffectY(s__HanzoSemi_e[this], GetUnitY(s__HanzoSemi_ball[this]))
        call BlzSetSpecialEffectHeight(s__HanzoSemi_e[this], 130 + GetPointZ(GetUnitX(s__HanzoSemi_ball[this]) , GetUnitY(s__HanzoSemi_ball[this])))
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 140, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HanzoSemi_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and s__HanzoSemi_target[this] == null then
                call UnitDamageTarget(s__HanzoSemi_caster[this], bj_lastCreatedUnit, 600 * GetUnitAbilityLevel(s__HanzoSemi_caster[this], s__HanzoSemi_SPELL_ID) + 6 * GetHeroAgi(s__HanzoSemi_caster[this], true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		call sc__HanzoSpread_spread(s__HanzoSemi_caster[this] , bj_lastCreatedUnit)
                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                set s__HanzoSemi_target[this]=bj_lastCreatedUnit
                exitwhen true
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__HanzoSemi_target[this] != null then
            set s__HanzoSemi_hit[this]=true
            set s__HanzoSemi_angle[this]=s__HanzoSemi_angle[this] + bj_PI
        endif
        if not s__HanzoSemi_hit[this] and s__HanzoSemi_count[this] > 32 then
            set s__HanzoSemi_hit[this]=true
            set s__HanzoSemi_angle[this]=s__HanzoSemi_angle[this] + bj_PI
        elseif ( s__HanzoSemi_hit[this] and GetDistance(GetUnitX(s__HanzoSemi_ball[this]) , GetUnitY(s__HanzoSemi_ball[this]) , s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this]) < 70 ) or GetWidgetLife(s__HanzoSemi_caster[this]) < 0.405 then
	    set i=0
	    loop
		exitwhen i > s__HanzoSemi_count[this]
		call KillUnit(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+i])
            	call ShowUnit(s___HanzoSemi_chains[s__HanzoSemi_chains[this]+i], false)
            	set s___HanzoSemi_chains[s__HanzoSemi_chains[this]+i]=null
		set i=i + 1
	    endloop
	    call s__EffectUtils__EffectTimer_create((s__HanzoSemi_e[this] ) , (( 0.1)*1.0) , true) // INLINED!!
	    set s__HanzoSemi_e[this]=null
            call RecycleUnit(s__HanzoSemi_ball[this])
            set s__HanzoSemi_ball[this]=null
            set s__HanzoSemi_target[this]=null
            call s__HanzoSemi_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__HanzoSemi_actions takes nothing returns nothing
        local integer this= s__HanzoSemi__allocate()
        set s__HanzoSemi_caster[this]=GetTriggerUnit()
		set s__HanzoSemi_cx[this]=GetUnitX(s__HanzoSemi_caster[this])
		set s__HanzoSemi_cy[this]=GetUnitY(s__HanzoSemi_caster[this])
        set s__HanzoSemi_angle[this]=Atan3(s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this] , GetSpellTargetX() , GetSpellTargetY())
        set s__HanzoSemi_count[this]=0
        set s__HanzoSemi_count2[this]=0
        set s__HanzoSemi_ball[this]=(CreateUnit((GetTriggerPlayer() ), ( 'e007' ), (( s__HanzoSemi_cx[this] )*1.0), (( s__HanzoSemi_cy[this] )*1.0), (( Rad2Deg(s__HanzoSemi_angle[this]))*1.0))) // INLINED!!
        set s__HanzoSemi_hit[this]=false
        set s__HanzoSemi_e[this]=AddSpecialEffect("war3mapImported\\Hanzo_Scythe.mdl", s__HanzoSemi_cx[this], s__HanzoSemi_cy[this])
        call BlzSetSpecialEffectScale(s__HanzoSemi_e[this], 0.6)
        call BlzSetSpecialEffectPitch(s__HanzoSemi_e[this], - 1.57)
        call BlzSetSpecialEffectHeight(s__HanzoSemi_e[this], 130 + GetPointZ(s__HanzoSemi_cx[this] , s__HanzoSemi_cy[this]))
        call BlzSetSpecialEffectYaw(s__HanzoSemi_e[this], s__HanzoSemi_angle[this] + Deg2Rad(90))
        set s__HanzoSemi_target[this]=null
        call TimerStart(NewTimerEx(this), 0.03, true, function s__HanzoSemi_periodic)
    endfunction 
    
    function s__HanzoSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__HanzoSemi_SPELL_ID ) , Filter(( function s__HanzoSemi_actions))) // INLINED!!
    endfunction 
    
