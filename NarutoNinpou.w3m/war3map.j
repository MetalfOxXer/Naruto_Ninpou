    function s__HagoromoT_fire takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        local unit u2
        local real scale
        local real new_x
        local real new_y
        local integer i
        set s__HagoromoT_instance=this
        set bj_forLoopAIndex=1
	    set bj_forLoopAIndexEnd=3

		//set bj_lastCreatedEffect = AddSpecialEffect("war3mapImported\\HagoromoT.mdl", this.target_x, this.target_y)
		//call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.1)
		//call DestroyEffect(bj_lastCreatedEffect)
        
        // Count the total number of enemies in the radius
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HagoromoT_target_x[this], s__HagoromoT_target_y[this], 300, Filter(function s__HagoromoT_countEnemies))

        // Deal damage based on the number of enemies
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HagoromoT_target_x[this], s__HagoromoT_target_y[this], 300, Filter(function s__HagoromoT_damagenumunits))

        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            exitwhen bj_lastCreatedUnit == null
        endloop

        set u2=CreateUnit(GetOwningPlayer(s__HagoromoT_caster[this]), 'h07N', s__HagoromoT_target_x[this], s__HagoromoT_target_y[this], 0)
        call KillUnit(u2)
        set u2=null

        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 0.5, false, function s__HagoromoT_removeLightnings)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

