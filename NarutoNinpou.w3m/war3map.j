    function s__JuugoD_periodic takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
     local real x= GetUnitX(s__JuugoD_rock[this])
     local real y= GetUnitY(s__JuugoD_rock[this])
     local real x2
     local real y2
     local real angle= Atan3(x , y , s__JuugoD_x[this] , s__JuugoD_y[this])
     local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
     local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
					call SetUnitX(s__JuugoD_rock[this], new_x)
					call SetUnitY(s__JuugoD_rock[this], new_y)
					call SetUnitFlyHeight(s__JuugoD_rock[this], ParabolaZ(600 , s__JuugoD_distance[this] , s__JuugoD_distance[this] - GetDistance(new_x , new_y , s__JuugoD_rock_x[this] , s__JuugoD_rock_y[this])), 0)
					if GetDistance(new_x , new_y , s__JuugoD_x[this] , s__JuugoD_y[this]) < 100 or s__JuugoD_count[this] >= 500 then
						set s__JuugoD_count[this]=0
						set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Ground Crack Big.mdx", s__JuugoD_x[this], s__JuugoD_y[this])
						call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.5)*1.0) , false) // INLINED!!
						set s__JuugoD_rock_x[this]=GetUnitX(s__JuugoD_rock[this])
						set s__JuugoD_rock_y[this]=GetUnitY(s__JuugoD_rock[this])
						call SetUnitFlyHeight(s__JuugoD_rock[this], 0, 0)
            					call SlowArea(s__JuugoD_caster[this] , GetUnitX(s__JuugoD_rock[this]) , GetUnitY(s__JuugoD_rock[this]) , 300.0)
						set bj_lastCreatedGroup=CreateGroup()
						call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__JuugoD_x[this], s__JuugoD_y[this], 300, null)
						loop
							set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
							exitwhen bj_lastCreatedUnit == null
							if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__JuugoD_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
								call UnitDamageTarget(s__JuugoD_caster[this], bj_lastCreatedUnit, 3 * GetHeroStr(s__JuugoD_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
							endif
							call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
						endloop
						call DestroyGroup(bj_lastCreatedGroup)
						call TimerStart(NewTimerEx(this), 0.03, true, function s__JuugoD_periodic2)
						call ReleaseTimer(GetExpiredTimer())
					endif
					set s__JuugoD_count[this]=s__JuugoD_count[this] + 1
    endfunction
				
