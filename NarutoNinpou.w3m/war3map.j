    function s__ToneriSphere_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__ToneriSphere_caster[s__ToneriSphere_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            call UnitDamageTarget(s__ToneriSphere_caster[s__ToneriSphere_instance], GetFilterUnit(), 25 + GetHeroInt(s__ToneriSphere_caster[s__ToneriSphere_instance], true) / 2 * GetUnitAbilityLevel(s__ToneriSphere_caster[s__ToneriSphere_instance], s__ToneriSphere_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
    endfunction

    function s__ToneriSphere_explode takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	set bj_lastCreatedEffect=AddSpecialEffect("Energy Release.mdl", GetUnitX(s__ToneriSphere_ball[this]), GetUnitY(s__ToneriSphere_ball[this]))
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__ToneriSphere_ball[this]) , GetUnitY(s__ToneriSphere_ball[this])) + 100)
	call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 0, 255, 75)
	call DestroyEffect(bj_lastCreatedEffect)
        set bj_lastCreatedGroup=CreateGroup()
        set s__ToneriSphere_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ToneriSphere_ball[this]), GetUnitY(s__ToneriSphere_ball[this]), 250.0, Filter(function s__ToneriSphere_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
        call DestroyGroup(s__ToneriSphere_damaged[this])
        call DestroyEffect(s__ToneriSphere_e1[this])
        set s__ToneriSphere_e1[this]=null
        set s__ToneriSphere_damaged[this]=null
        call ShowUnit(s__ToneriSphere_ball[this], false)
        call KillUnit(s__ToneriSphere_ball[this])
        set s__ToneriSphere_ball[this]=null
        call s__ToneriSphere_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__ToneriSphere_pull takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        local real distance
        local real reduce
        call SetUnitFacing(s__ToneriSphere_ball[this], ( GetUnitFacing(s__ToneriSphere_ball[this]) + 20.00 ))
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ToneriSphere_ball[this]), GetUnitY(s__ToneriSphere_ball[this]), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToneriSphere_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__ToneriSphere_damaged[this]) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(x , y , GetUnitX(s__ToneriSphere_ball[this]) , GetUnitY(s__ToneriSphere_ball[this]))
                set distance=GetDistance(GetUnitX(s__ToneriSphere_ball[this]) , GetUnitY(s__ToneriSphere_ball[this]) , x , y)
                set reduce=( 400 - distance ) / 20
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 18 + reduce)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 18 + reduce)*1.0)) // INLINED!!
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                	call SetUnitX(bj_lastCreatedUnit, new_x)
                	call SetUnitY(bj_lastCreatedUnit, new_y)
		endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__ToneriSphere_damaged[this]) and GetDistance(new_x , new_y , GetUnitX(s__ToneriSphere_ball[this]) , GetUnitY(s__ToneriSphere_ball[this])) < 50 then
                    call GroupAddUnit(s__ToneriSphere_damaged[this], bj_lastCreatedUnit)
                    call UnitDamageTarget(s__ToneriSphere_caster[this], bj_lastCreatedUnit, GetHeroInt(s__ToneriSphere_caster[this], true) / 2 * GetUnitAbilityLevel(s__ToneriSphere_caster[this], s__ToneriSphere_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call StunUnitTimed(s__ToneriSphere_caster[this] , bj_lastCreatedUnit , 1.5)
                endif
            endif
        endloop
	call DestroyGroup(bj_lastCreatedGroup)
        set s__ToneriSphere_count[this]=s__ToneriSphere_count[this] + 1
        if s__ToneriSphere_count[this] >= 20 then
            call TimerStart(NewTimerEx(this), 0.4, false, function s__ToneriSphere_explode)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToneriSphere_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__ToneriSphere_ball[this]) , GetUnitY(s__ToneriSphere_ball[this]) , s__ToneriSphere_target_x[this] , s__ToneriSphere_target_y[this])
        local real x= (((GetUnitX(s__ToneriSphere_ball[this]) )*1.0) + Cos((( angle )*1.0)) * (( 35.0)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__ToneriSphere_ball[this]) )*1.0) + Sin((( angle )*1.0)) * (( 35.0)*1.0)) // INLINED!!
        call SetUnitX(s__ToneriSphere_ball[this], x)
        call SetUnitY(s__ToneriSphere_ball[this], y)
        if GetDistance(x , y , s__ToneriSphere_target_x[this] , s__ToneriSphere_target_y[this]) <= 100 then
            call SetUnitX(s__ToneriSphere_ball[this], s__ToneriSphere_target_x[this])
            call SetUnitY(s__ToneriSphere_ball[this], s__ToneriSphere_target_y[this])
	    set s__ToneriSphere_e1[this]=AddSpecialEffectTarget("WindAura.mdl", s__ToneriSphere_ball[this], "origin")
	    call BlzSetSpecialEffectScale(s__ToneriSphere_e1[this], 0.7)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__ToneriSphere_pull)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToneriSphere_actions takes nothing returns nothing
        local integer this= s__ToneriSphere_allocate()
        set s__ToneriSphere_caster[this]=GetTriggerUnit()
        set s__ToneriSphere_angle[this]=Atan3(GetUnitX(s__ToneriSphere_caster[this]) , GetUnitY(s__ToneriSphere_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__ToneriSphere_target_x[this]=GetSpellTargetX()
