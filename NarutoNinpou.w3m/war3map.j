//===========================================================================
// Trigger: MechaNarutoImmolationLevel
//===========================================================================

    function s__MechaNarutoImmolationLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A1B1') == 0 and GetUnitTypeId(u) != 'H03O' and GetUnitAbilityLevel(u, 'A17S') == 10 and GetUnitAbilityLevel(u, 'A17T') == 10 and GetUnitAbilityLevel(u, 'A17U') == 10 and GetUnitAbilityLevel(u, 'A17W') == 1 then
                call UnitRemoveAbility(u, 'A0I2')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0I2', false)
                call UnitAddAbility(u, 'A1B1')
		call s__MechaNarutoImmolationLevel35_start(u)
	    	call SetUnitMoveSpeed(u, 420)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__MechaNarutoImmolationLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H03K' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__MechaNarutoImmolationLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__MechaNarutoImmolationLevel_death takes nothing returns nothing
    if ( GetUnitTypeId(GetTriggerUnit()) == 'H03K' or GetUnitTypeId(GetTriggerUnit()) == 'H03O' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0I2', true)
    endif
    endfunction

    function s__MechaNarutoImmolationLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__MechaNarutoImmolationLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__MechaNarutoImmolationLevel_death))) // INLINED!!
    endfunction 

//===========================================================================
// Trigger: MeiYoukai
//===========================================================================

//Implemented from module Alloc:
    
        function s__MeiYoukai_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MeiYoukai_Alloc___recycle[(0)] == 0 ) then
                set s__MeiYoukai_Alloc___instanceCount=s__MeiYoukai_Alloc___instanceCount + 1
                set this=s__MeiYoukai_Alloc___instanceCount
            else
                set this=s__MeiYoukai_Alloc___recycle[(0)]
                set s__MeiYoukai_Alloc___recycle[(0)]=s__MeiYoukai_Alloc___recycle[s__MeiYoukai_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MeiYoukai_deallocate takes integer this returns nothing
            set s__MeiYoukai_Alloc___recycle[this]=s__MeiYoukai_Alloc___recycle[(0)]
            set s__MeiYoukai_Alloc___recycle[(0)]=this
        endfunction


    function s__MeiYoukai_destroy takes integer this returns nothing
        call DestroyGroup(s__MeiYoukai_units[this])
        set s__MeiYoukai_units[this]=null
        set s__MeiYoukai_caster[this]=null
        call s__MeiYoukai_deallocate(this)
    endfunction

    function s__MeiYoukai_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real caster_x
        local real caster_y
        local real unit_x
        local real unit_y
        local real new_x
        local real new_y
        local real angle
        set s__MeiYoukai_count[this]=s__MeiYoukai_count[this] + 1
        if s__MeiYoukai_count[this] <= 24 then
            call SetUnitAnimation(s__MeiYoukai_caster[this], "attack")
            set caster_x=s__MeiYoukai_x[this]
            set caster_y=s__MeiYoukai_y[this]
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__MeiYoukai_units[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                set unit_x=GetUnitX(bj_lastCreatedUnit)
                set unit_y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(unit_x , unit_y , GetUnitX(s__MeiYoukai_caster[this]) , GetUnitY(s__MeiYoukai_caster[this]))
                set new_x=unit_x + Cos(angle) * 12
                set new_y=unit_y + Sin(angle) * 12
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                  //  call AddSpecialEffectEx("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", new_x, new_y)
                endif
                call SetUnitFlyHeight(bj_lastCreatedUnit, ParabolaZ(300 , 300 , s__MeiYoukai_count[this] * 12.5), 0)
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        elseif s__MeiYoukai_count[this] > 24 then
            call SetUnitTimeScale(s__MeiYoukai_caster[this], 1.0)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__MeiYoukai_units[this])
                exitwhen bj_lastCreatedUnit == null
                call UnitDamageTarget(s__MeiYoukai_caster[this], bj_lastCreatedUnit, GetUnitAbilityLevel(s__MeiYoukai_caster[this], s__MeiYoukai_SPELL_ID) * GetHeroAgi(s__MeiYoukai_caster[this], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 0)
                call GroupRemoveUnit(s__MeiYoukai_units[this], bj_lastCreatedUnit)
            endloop
            call s__MeiYoukai_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

 function s__MeiYoukai_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        	set bj_lastCreatedEffect=AddSpecialEffect("AnimeFireEffectJiraiya.mdl", s__MeiYoukai_x[this], s__MeiYoukai_y[this])
        	call DestroyEffect(bj_lastCreatedEffect)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

    function s__MeiYoukai_Trig_MeiYoukai_Actions takes nothing returns nothing
        local integer this= s__MeiYoukai_allocate()
        set s__MeiYoukai_caster[this]=GetTriggerUnit()
        set s__MeiYoukai_units[this]=CreateGroup()
        set s__MeiYoukai_count[this]=0
        set s__MeiYoukai_x[this]=GetSpellTargetX()
        set s__MeiYoukai_y[this]=GetSpellTargetY()

        set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A09F')
        call SetUnitFlyHeight(bj_lastCreatedUnit, 100.0, 0)
        call SetUnitScale(bj_lastCreatedUnit, 2.0, 0, 0)
        call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", s__MeiYoukai_x[this], s__MeiYoukai_y[this])

        set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A09H')
        call SetUnitFlyHeight(bj_lastCreatedUnit, 100.0, 0)
        call SetUnitScale(bj_lastCreatedUnit, 1.5, 0, 0)
        call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", s__MeiYoukai_x[this], s__MeiYoukai_y[this])

	call TimerStart(NewTimerEx(this), 0.4, false, function s__MeiYoukai_delay)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__MeiYoukai_x[this], s__MeiYoukai_y[this], 250.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call StunUnitTimed(s__MeiYoukai_caster[this] , bj_lastCreatedUnit , 1.0)
                call SetUnitAnimation(bj_lastCreatedUnit, "death")
                call GroupAddUnit(s__MeiYoukai_units[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__MeiYoukai_periodic)
    endfunction

    //===========================================================================
    function s__MeiYoukai_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(30 , s__MeiYoukai_SPELL_ID , function s__MeiYoukai_Trig_MeiYoukai_Actions)
    endfunction

//===========================================================================
// Trigger: MeiKirigakure
//===========================================================================

//Implemented from module Alloc:
    
        function s__MeiKirigakure_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MeiKirigakure_Alloc___recycle[(0)] == 0 ) then
                set s__MeiKirigakure_Alloc___instanceCount=s__MeiKirigakure_Alloc___instanceCount + 1
                set this=s__MeiKirigakure_Alloc___instanceCount
            else
                set this=s__MeiKirigakure_Alloc___recycle[(0)]
                set s__MeiKirigakure_Alloc___recycle[(0)]=s__MeiKirigakure_Alloc___recycle[s__MeiKirigakure_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MeiKirigakure_deallocate takes integer this returns nothing
            set s__MeiKirigakure_Alloc___recycle[this]=s__MeiKirigakure_Alloc___recycle[(0)]
            set s__MeiKirigakure_Alloc___recycle[(0)]=this
        endfunction


    function s__MeiKirigakure_destroy takes integer this returns nothing
        call MoveRectTo(gg_rct_MeiKirigakure, - 1000, - 7300)
        call DestroyGroup(s__MeiKirigakure_damaged[this])
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__MeiKirigakure_fog[this])
            exitwhen bj_lastCreatedUnit == null
            call KillUnit(bj_lastCreatedUnit)
            call GroupRemoveUnit(s__MeiKirigakure_fog[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__MeiKirigakure_fog[this])
        set s__MeiKirigakure_damaged[this]=null
        set s__MeiKirigakure_fog[this]=null
        set s__MeiKirigakure_caster[this]=null
        call s__MeiKirigakure_deallocate(this)
    endfunction

    function s__MeiKirigakure_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real new_x= (((GetRectCenterX(gg_rct_MeiKirigakure) )*1.0) + Cos((( Deg2Rad(s__MeiKirigakure_angle[this]) )*1.0)) * (( 7)*1.0)) // INLINED!!
        local real new_y= (((GetRectCenterY(gg_rct_MeiKirigakure) )*1.0) + Sin((( Deg2Rad(s__MeiKirigakure_angle[this]) )*1.0)) * (( 7)*1.0)) // INLINED!!
        local real x
        local real y
        local unit u
        set s__MeiKirigakure_count[this]=s__MeiKirigakure_count[this] + 1
        call MoveRectTo(gg_rct_MeiKirigakure, new_x, new_y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MeiKirigakure_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__MeiKirigakure_damaged[this]) then
                //call UnitDamageTarget(this.caster, bj_lastCreatedUnit, (50 + 0.2 * GetHeroAgi(this.caster, true)) * GetUnitAbilityLevel(this.caster, SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call GroupAddUnit(s__MeiKirigakure_damaged[this], bj_lastCreatedUnit)
            elseif IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(s__MeiKirigakure_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and ModuloInteger(s__MeiKirigakure_count[this], 5) == 0 and not IsUnitInGroup(bj_lastCreatedUnit, s__MeiKirigakure_damaged[this]) then
                    set u=CreateAbilityDummy(s__MeiKirigakure_caster[this] , 'A09S')
                    call IssueTargetOrder(u, "invisibility", bj_lastCreatedUnit)
                    call GroupAddUnit(s__MeiKirigakure_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set u=null
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__MeiKirigakure_fog[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(s__MeiKirigakure_angle[this]) )*1.0)) * (( 7)*1.0)) // INLINED!!
            set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(s__MeiKirigakure_angle[this]) )*1.0)) * (( 7)*1.0)) // INLINED!!
            call SetUnitX(bj_lastCreatedUnit, x)
            call SetUnitY(bj_lastCreatedUnit, y)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__MeiKirigakure_count[this] > 99 then
            call s__MeiKirigakure_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__MeiKirigakure_actions takes nothing returns nothing
        local integer this= s__MeiKirigakure_allocate()
        local unit caster= GetTriggerUnit()
        local integer i
        local real x
        local real y
        set s__MeiKirigakure_caster[this]=GetTriggerUnit()
        set s__MeiKirigakure_damaged[this]=CreateGroup()
        call MoveRectTo(gg_rct_MeiKirigakure, GetUnitX(s__MeiKirigakure_caster[this]), GetUnitY(s__MeiKirigakure_caster[this]))
        set s__MeiKirigakure_angle[this]=GetUnitFacing(caster)
        set s__MeiKirigakure_count[this]=0
        set s__MeiKirigakure_fog[this]=CreateGroup()
        set i=1
        loop
            exitwhen i > 4
            set x=(((GetUnitX(s__MeiKirigakure_caster[this]) )*1.0) + Cos((( Deg2Rad(90 * i) )*1.0)) * (( 120)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__MeiKirigakure_caster[this]) )*1.0) + Sin((( Deg2Rad(90 * i) )*1.0)) * (( 120)*1.0)) // INLINED!!
            set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'h00A' ), (( x )*1.0), (( y )*1.0), (( 90 * i)*1.0))) // INLINED!!
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call GroupAddUnit(s__MeiKirigakure_fog[this], bj_lastCreatedUnit)
            set i=i + 1
        endloop
        call TimerStart(NewTimerEx(this), 0.05, true, function s__MeiKirigakure_periodic)
        call SetUnitAnimation(caster, "spell throw")
        set caster=null
    endfunction

    //===========================================================================
    function s__MeiKirigakure_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(30 , s__MeiKirigakure_SPELL_ID , function s__MeiKirigakure_actions)
    endfunction

//===========================================================================
// Trigger: MeiCriticalStrike
//===========================================================================

    function s__MeiCriticalStrike_skills takes nothing returns nothing
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, bj_mapInitialPlayableArea, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if not IsUnitIllusion(bj_lastCreatedUnit) then
                if GetUnitTypeId(bj_lastCreatedUnit) == 'O00E' then
                        call UnitRemoveAbility(bj_lastCreatedUnit, 'A0H6')
                        //call UnitAddAbility(bj_lastCreatedUnit, 'A0H7')
                elseif GetUnitTypeId(bj_lastCreatedUnit) == 'H008' then
                        //call UnitRemoveAbility(bj_lastCreatedUnit, 'A0H7')
                        call UnitAddAbility(bj_lastCreatedUnit, 'A0H6')
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction

    
    
    function s__MeiCriticalStrike_critical takes nothing returns nothing
        if GetUnitAbilityLevel(GetAttacker(), 'A0MC') > 0 then
            if GetUnitTypeId(GetAttacker()) == 'O00E' then
                if not IsUnitIllusion(GetAttacker()) then
                    call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( GetHeroAgi(GetAttacker(), true) * 0.15 ) * GetUnitAbilityLevel(GetAttacker(), 'A0MC'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                endif
            elseif GetUnitTypeId(GetAttacker()) == 'H008' then
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(GetAttacker())) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                        call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, 10 * GetUnitAbilityLevel(GetAttacker(), 'A0MC'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
            endif
        endif
    endfunction
    
    function s__MeiCriticalStrike_leave takes nothing returns nothing
	if ( GetUnitTypeId(GetLeavingUnit()) == 'H008' or GetUnitTypeId(GetLeavingUnit()) == 'O00E' ) then
        	call TimerStartEx((NewTimerEx(0)) , 0.1 , true , function s__MeiCriticalStrike_skills , "MeiCriticalStrike_skills") // INLINED!!
        	//call TimerStartEx(NewTimer(), 1.0, true, function thistype.acid, "MeiCriticalStrike_acid")
        endif
    endfunction 

    function s__MeiCriticalStrike_onInit takes nothing returns nothing
	call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__MeiCriticalStrike_leave))) // INLINED!!
        call RegisterPlayerUnitEventForId(30 , EVENT_PLAYER_UNIT_ATTACKED , function s__MeiCriticalStrike_critical)
    endfunction 
    


