	set s__JuugoCharge_damaged[this]=CreateGroup()
	set s__JuugoCharge_moving[this]=CreateGroup()
        //call AddSpecialEffectEx("Effects\\s_Earth_Smash.mdx", GetUnitX(this.caster), GetUnitY(this.caster))
        call TimerStart(NewTimerEx(this), 0.03, true, function s__JuugoCharge_charge)
    endfunction 

