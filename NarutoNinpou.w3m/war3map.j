 function s__TsunadeDeadlyPunch_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__TsunadeDeadlyPunch_caster[this])
  local real y= GetUnitY(s__TsunadeDeadlyPunch_caster[this])
  local real angle= Atan3(x , y , s__TsunadeDeadlyPunch_target_x[this] , s__TsunadeDeadlyPunch_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_dist= GetDistance(new_x , new_y , s__TsunadeDeadlyPunch_target_x[this] , s__TsunadeDeadlyPunch_target_y[this])
  local integer i
  local integer j
		
		call SetUnitX(s__TsunadeDeadlyPunch_caster[this], new_x)
		call SetUnitY(s__TsunadeDeadlyPunch_caster[this], new_y)
		call SetUnitFlyHeight(s__TsunadeDeadlyPunch_caster[this], Parabola(0 , 0 , 300 , s__TsunadeDeadlyPunch_dist[this] , 50 * s__TsunadeDeadlyPunch_count[this]), 0)
		call SetUnitFacing(s__TsunadeDeadlyPunch_caster[this], Rad2Deg(angle))
		set s__TsunadeDeadlyPunch_count[this]=s__TsunadeDeadlyPunch_count[this] + 1
		set s__TsunadeDeadlyPunch_count2[this]=s__TsunadeDeadlyPunch_count2[this] + 1
		if new_dist < 50 or s__TsunadeDeadlyPunch_count2[this] >= 20 then
			set i=0
			loop
				exitwhen i > 5
				set angle=Deg2Rad(60 * i)
				set new_x=(((GetUnitX(s__TsunadeDeadlyPunch_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
				set new_y=(((GetUnitY(s__TsunadeDeadlyPunch_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapimported\\Earth_Spikes.mdl", new_x, new_y)
				call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(45))
				call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
				call DestroyEffect(bj_lastCreatedEffect)
				set i=i + 1
			endloop
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(s__TsunadeDeadlyPunch_caster[this]) )*1.0), (( GetUnitY(s__TsunadeDeadlyPunch_caster[this]))*1.0))) // INLINED!!
			call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__TsunadeDeadlyPunch_caster[this]) )*1.0), (( GetUnitY(s__TsunadeDeadlyPunch_caster[this]))*1.0))) // INLINED!!
			set bj_lastCreatedGroup=CreateGroup()
			set s__TsunadeDeadlyPunch_instance=this
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__TsunadeDeadlyPunch_target_x[this], s__TsunadeDeadlyPunch_target_y[this], 250, Filter(function s__TsunadeDeadlyPunch_dealDamage))
			call DestroyGroup(bj_lastCreatedGroup)
			call SlowArea(s__TsunadeDeadlyPunch_caster[this] , s__TsunadeDeadlyPunch_target_x[this] , s__TsunadeDeadlyPunch_target_y[this] , 250)
			call SetUnitFlyHeight(s__TsunadeDeadlyPunch_caster[this], 0, 0)
			call PauseUnit(s__TsunadeDeadlyPunch_caster[this], false)
			call SetUnitTimeScale(s__TsunadeDeadlyPunch_caster[this], 1.0)
			call s__TsunadeDeadlyPunch_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__TsunadeDeadlyPunch_actions takes nothing returns nothing
  local integer this= s__TsunadeDeadlyPunch_allocate()
  local real x
  local real y
  local real x1
  local real y1
  local real x2
  local real y2
  local real angle
		set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
		set x=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
		set y=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
		set x1=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
		set y1=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
		set x2=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
		set y2=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
		set s__TsunadeDeadlyPunch_jump[this]=false
		if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
			set s__TsunadeDeadlyPunch_target_x[this]=GetSpellTargetX()
			set s__TsunadeDeadlyPunch_target_y[this]=GetSpellTargetY()
			set s__TsunadeDeadlyPunch_jump[this]=true
		elseif not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
			set s__TsunadeDeadlyPunch_target_x[this]=x
			set s__TsunadeDeadlyPunch_target_y[this]=y
			set s__TsunadeDeadlyPunch_jump[this]=true
		elseif not IsTerrainPathable(x1, y1, PATHING_TYPE_WALKABILITY) then
			set s__TsunadeDeadlyPunch_target_x[this]=x1
			set s__TsunadeDeadlyPunch_target_y[this]=y1
			set s__TsunadeDeadlyPunch_jump[this]=true
		elseif not IsTerrainPathable(x2, y2, PATHING_TYPE_WALKABILITY) then
			set s__TsunadeDeadlyPunch_target_x[this]=x2
			set s__TsunadeDeadlyPunch_target_y[this]=y2
			set s__TsunadeDeadlyPunch_jump[this]=true
		endif
		if s__TsunadeDeadlyPunch_jump[this] then
			set s__TsunadeDeadlyPunch_caster[this]=GetTriggerUnit()
			set s__TsunadeDeadlyPunch_dist[this]=GetDistance(GetUnitX(s__TsunadeDeadlyPunch_caster[this]) , GetUnitY(s__TsunadeDeadlyPunch_caster[this]) , s__TsunadeDeadlyPunch_target_x[this] , s__TsunadeDeadlyPunch_target_y[this])
			set s__TsunadeDeadlyPunch_first[this]=GetSpellAbilityId() == s__TsunadeDeadlyPunch_SPELL_ID
			call PauseUnit(s__TsunadeDeadlyPunch_caster[this], true)
			if GetUnitAbilityLevel(s__TsunadeDeadlyPunch_caster[this], 'B00A') > 0 then
				if BlzGetUnitSkin(s__TsunadeDeadlyPunch_caster[this]) == 'h02G' then
					call SetUnitAnimation(GetTriggerUnit(), "spell throw")
					call SetUnitTimeScale(s__TsunadeDeadlyPunch_caster[this], 0.5)
				else
					call SetUnitAnimation(GetTriggerUnit(), "spell throw alternate")
					call SetUnitTimeScale(s__TsunadeDeadlyPunch_caster[this], 0.5)
				endif
			else
				call SetUnitAnimation(GetTriggerUnit(), "spell throw")
				call SetUnitTimeScale(s__TsunadeDeadlyPunch_caster[this], 0.5)
			endif
			set s__TsunadeDeadlyPunch_count[this]=0
			set s__TsunadeDeadlyPunch_count2[this]=0
			call UnitAddAbility(s__TsunadeDeadlyPunch_caster[this], 'Arav')
			call UnitRemoveAbility(s__TsunadeDeadlyPunch_caster[this], 'Arav')
			call TimerStart(NewTimerEx(this), 0.035, true, function s__TsunadeDeadlyPunch_periodic)
		else
			call IssueImmediateOrder(GetTriggerUnit(), "stop")
			call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A0I9', ( 11 + GetUnitAbilityLevel(GetTriggerUnit(), s__TsunadeDeadlyPunch_SPELL_ID) * 0.5 ) / 2)
			call s__TsunadeDeadlyPunch_deallocate(this)
		endif
 endfunction 

 function s__TsunadeDeadlyPunch_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(2 , s__TsunadeDeadlyPunch_SPELL_ID , function s__TsunadeDeadlyPunch_actions)
 endfunction 

