//===========================================================================

//Implemented from module Alloc:
    
        function s__TemariStormWallNew_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__TemariStormWallNew_Alloc___recycle[(0)] == 0 ) then
                set s__TemariStormWallNew_Alloc___instanceCount=s__TemariStormWallNew_Alloc___instanceCount + 1
                set this=s__TemariStormWallNew_Alloc___instanceCount
            else
                set this=s__TemariStormWallNew_Alloc___recycle[(0)]
                set s__TemariStormWallNew_Alloc___recycle[(0)]=s__TemariStormWallNew_Alloc___recycle[s__TemariStormWallNew_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__TemariStormWallNew_deallocate takes integer this returns nothing
            set s__TemariStormWallNew_Alloc___recycle[this]=s__TemariStormWallNew_Alloc___recycle[(0)]
            set s__TemariStormWallNew_Alloc___recycle[(0)]=this
        endfunction

    function s__TemariStormWallNew_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        set x=(((GetUnitX(s__TemariStormWallNew_caster[this]) )*1.0) + Cos((( Deg2Rad(0 + s__TemariStormWallNew_count[this] * 10) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__TemariStormWallNew_caster[this]) )*1.0) + Sin((( Deg2Rad(0 + s__TemariStormWallNew_count[this] * 10) )*1.0)) * (( 400)*1.0)) // INLINED!!
        call BlzSetSpecialEffectX(s__TemariStormWallNew_e1[this], x)
        call BlzSetSpecialEffectY(s__TemariStormWallNew_e1[this], y)
        set x=(((GetUnitX(s__TemariStormWallNew_caster[this]) )*1.0) + Cos((( Deg2Rad(180 + s__TemariStormWallNew_count[this] * 10) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__TemariStormWallNew_caster[this]) )*1.0) + Sin((( Deg2Rad(180 + s__TemariStormWallNew_count[this] * 10) )*1.0)) * (( 400)*1.0)) // INLINED!!
        call BlzSetSpecialEffectX(s__TemariStormWallNew_e2[this], x)
        call BlzSetSpecialEffectY(s__TemariStormWallNew_e2[this], y)
        if ModuloInteger(s__TemariStormWallNew_count[this], 20) == 0 then
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Wind Blast - Classic.mdl", GetUnitX(s__TemariStormWallNew_caster[this]), GetUnitY(s__TemariStormWallNew_caster[this]))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.5)
            if BlzGetUnitSkin(s__TemariStormWallNew_caster[this]) == 'h02I' then
                //call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 0, 100, 255)
            endif
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__TemariStormWallNew_caster[this]), GetUnitY(s__TemariStormWallNew_caster[this]), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TemariStormWallNew_caster[this])) and not IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == true then
                set angle=Atan3(GetUnitX(s__TemariStormWallNew_caster[this]) , GetUnitY(s__TemariStormWallNew_caster[this]) , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit))
                set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( angle )*1.0)) * (( 15.0)*1.0)) // INLINED!!
                set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( angle )*1.0)) * (( 15.0)*1.0)) // INLINED!!
                if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, x)
                    call SetUnitY(bj_lastCreatedUnit, y)
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__TemariStormWallNew_damaged[this]) then
			        call UnitDamageTarget(s__TemariStormWallNew_caster[this], bj_lastCreatedUnit, 90 * GetUnitAbilityLevel(s__TemariStormWallNew_caster[this], s__TemariStormWallNew_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__TemariStormWallNew_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__TemariStormWallNew_count[this]=s__TemariStormWallNew_count[this] + 1
        if s__TemariStormWallNew_count[this] >= 60.0 then
            call DestroyEffect(s__TemariStormWallNew_e1[this])
            set s__TemariStormWallNew_e1[this]=null
            call DestroyEffect(s__TemariStormWallNew_e2[this])
            set s__TemariStormWallNew_e2[this]=null
            set s__TemariStormWallNew_b=false
            call DestroyGroup(s__TemariStormWallNew_damaged[this])
            set s__TemariStormWallNew_damaged[this]=null
            call s__TemariStormWallNew_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
	
    function s__TemariStormWallNew_evasion takes nothing returns nothing
     local real x
     local real y
     local real new_x
     local real new_y
     local unit caster
    	if GetUnitTypeId(GetTriggerUnit()) == 'H02P' then
       		set caster=GetTriggerUnit()
       		set x=GetUnitX(caster)
       		set y=GetUnitY(caster)
    	endif
    	set new_x=GetUnitX(GetTriggerUnit())
    	set new_y=GetUnitY(GetTriggerUnit())
	if s__TemariStormWallNew_b and GetDistance(x , y , new_x , new_y) < 800 and IsUnitType(GetAttacker(), UNIT_TYPE_RANGED_ATTACKER) == true then
        	call IssueImmediateOrder(GetAttacker(), "stop")
        	call CreateTextTagUnitBJ("TRIGSTR_5854", GetAttacker(), 0, 10.00, 100, 100, 100, 0)
        	call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 128.00, 90)
        	call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
        	call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 3.00)
        	call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 2.00)
        	call SetTextTagAgeBJ(GetLastCreatedTextTag(), 0)
	endif
    endfunction
	

    function s__TemariStormWallNew_actions takes nothing returns nothing
        local integer this= s__TemariStormWallNew_allocate()
        local real x
        local real y
        set s__TemariStormWallNew_caster[this]=GetTriggerUnit()
	    set s__TemariStormWallNew_b=true
        set s__TemariStormWallNew_damaged[this]=CreateGroup()
        set s__TemariStormWallNew_count[this]=0
        set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(0) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(0) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set s__TemariStormWallNew_e1[this]=AddSpecialEffect("Windcutter.mdl", x, y)
        set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(180) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(180) )*1.0)) * (( 400)*1.0)) // INLINED!!
        set s__TemariStormWallNew_e2[this]=AddSpecialEffect("Windcutter.mdl", x, y)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__TemariStormWallNew_periodic)
    endfunction 
    
    function s__TemariStormWallNew_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(16 , s__TemariStormWallNew_SPELL_ID , function s__TemariStormWallNew_actions)
	call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__TemariStormWallNew_evasion))) // INLINED!!
    endfunction 
    
