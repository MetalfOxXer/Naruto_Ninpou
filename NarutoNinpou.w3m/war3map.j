    function s__MaskedManNewR_damagefix takes nothing returns boolean
    if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__MaskedManNewR_caster[s__MaskedManNewR_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
			call UnitDamageTarget(s__MaskedManNewR_caster[s__MaskedManNewR_instance], GetFilterUnit(), 2 * GetHeroInt(s__MaskedManNewR_caster[s__MaskedManNewR_instance], true) + 700 * GetUnitAbilityLevel(s__MaskedManNewR_caster[s__MaskedManNewR_instance], s__MaskedManNewR_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		endif
    return false
    endfunction
    
    function s__MaskedManNewR_throw takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle1= Atan3(GetUnitX(s__MaskedManNewR_ball1[this]) , GetUnitY(s__MaskedManNewR_ball1[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this])
        local real angle2= Atan3(GetUnitX(s__MaskedManNewR_ball2[this]) , GetUnitY(s__MaskedManNewR_ball2[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this])
        local real angle3= Atan3(GetUnitX(s__MaskedManNewR_ball3[this]) , GetUnitY(s__MaskedManNewR_ball3[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this])
        local real x1= (((GetUnitX(s__MaskedManNewR_ball1[this]) )*1.0) + Cos((( angle1 )*1.0)) * (( 15)*1.0)) // INLINED!!
        local real y1= (((GetUnitY(s__MaskedManNewR_ball1[this]) )*1.0) + Sin((( angle1 )*1.0)) * (( 15)*1.0)) // INLINED!!
        local real x2= (((GetUnitX(s__MaskedManNewR_ball2[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real y2= (((GetUnitY(s__MaskedManNewR_ball2[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real x3= (((GetUnitX(s__MaskedManNewR_ball3[this]) )*1.0) + Cos((( angle3 )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real y3= (((GetUnitY(s__MaskedManNewR_ball3[this]) )*1.0) + Sin((( angle3 )*1.0)) * (( 25)*1.0)) // INLINED!!
        call SetUnitX(s__MaskedManNewR_ball1[this], x1)
        call SetUnitY(s__MaskedManNewR_ball1[this], y1)
        call SetUnitX(s__MaskedManNewR_ball2[this], x2)
        call SetUnitY(s__MaskedManNewR_ball2[this], y2)
        call SetUnitX(s__MaskedManNewR_ball3[this], x3)
        call SetUnitY(s__MaskedManNewR_ball3[this], y3)
        set s__MaskedManNewR_count[this]=s__MaskedManNewR_count[this] + 1
        if ModuloInteger(s__MaskedManNewR_count[this], 5) == 0 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MaskedManNewR_caster[this]), 'e019', x1, y1, 270)
            call SetUnitScale(bj_lastCreatedUnit, 1, 0, 0)
            call KillUnit(bj_lastCreatedUnit)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MaskedManNewR_caster[this]), 'e019', x2, y2, 270)
            call SetUnitScale(bj_lastCreatedUnit, 1, 0, 0)
            call KillUnit(bj_lastCreatedUnit)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MaskedManNewR_caster[this]), 'e019', x3, y3, 270)
            call SetUnitScale(bj_lastCreatedUnit, 1, 0, 0)
            call KillUnit(bj_lastCreatedUnit)
        endif
	if GetDistance(GetUnitX(s__MaskedManNewR_ball1[this]) , GetUnitY(s__MaskedManNewR_ball1[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 then
		call SetUnitVertexColor(s__MaskedManNewR_ball1[this], 255, 255, 255, 0)
	endif
	if GetDistance(GetUnitX(s__MaskedManNewR_ball2[this]) , GetUnitY(s__MaskedManNewR_ball2[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 then
		call SetUnitVertexColor(s__MaskedManNewR_ball2[this], 255, 255, 255, 0)
	endif
	if GetDistance(GetUnitX(s__MaskedManNewR_ball3[this]) , GetUnitY(s__MaskedManNewR_ball3[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 then
		call SetUnitVertexColor(s__MaskedManNewR_ball3[this], 255, 255, 255, 0)
	endif
        if ( GetDistance(GetUnitX(s__MaskedManNewR_ball1[this]) , GetUnitY(s__MaskedManNewR_ball1[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 and GetDistance(GetUnitX(s__MaskedManNewR_ball2[this]) , GetUnitY(s__MaskedManNewR_ball2[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 and GetDistance(GetUnitX(s__MaskedManNewR_ball3[this]) , GetUnitY(s__MaskedManNewR_ball3[this]) , s__MaskedManNewR_target_x[this] , s__MaskedManNewR_target_y[this]) < 50 ) or s__MaskedManNewR_count[this] >= 40 then
            //call PauseUnit(this.caster, false)
	    set bj_lastCreatedGroup=CreateGroup()
	    set s__MaskedManNewR_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__MaskedManNewR_target_x[this], s__MaskedManNewR_target_y[this], 450, Filter(function s__MaskedManNewR_damagefix))
            loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\PrettyExplosion.mdx", s__MaskedManNewR_target_x[this], s__MaskedManNewR_target_y[this])
	    call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
	    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.7)
	    call DestroyEffect(bj_lastCreatedEffect)
