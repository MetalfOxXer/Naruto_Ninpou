            else
                set this=s__ShizuneShield_Alloc___recycle[(0)]
                set s__ShizuneShield_Alloc___recycle[(0)]=s__ShizuneShield_Alloc___recycle[s__ShizuneShield_Alloc___recycle[(0)]]
            endif

    
            return this
