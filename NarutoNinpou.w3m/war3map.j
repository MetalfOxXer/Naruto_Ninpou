				//call AddSpecialEffectEx("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", GetUnitX(GetFilterUnit()), GetUnitY(GetFilterUnit()))
				endif
	    return false
 endfunction
	
