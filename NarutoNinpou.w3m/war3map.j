    function s__YaguraUltimate_damagefix takes nothing returns boolean
        if GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__YaguraUltimate_caster[s__YaguraUltimate_instance])) then
                    call UnitDamageTarget(s__YaguraUltimate_caster[s__YaguraUltimate_instance], GetFilterUnit(), 3 * GetHeroInt(s__YaguraUltimate_caster[s__YaguraUltimate_instance], true) + 3 * GetHeroStr(s__YaguraUltimate_caster[s__YaguraUltimate_instance], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    //call StunUnitTimed(instance.caster, GetFilterUnit(), 0.5)
                endif
    return false
    endfunction
    
    function s__YaguraUltimate_resetWindow takes nothing returns nothing
        call SetUnitPropWindow(s__YaguraUltimate_yagura, s__YaguraUltimate_default_window)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__YaguraUltimate_jump takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__YaguraUltimate_caster[this]) , GetUnitY(s__YaguraUltimate_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__YaguraUltimate_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__YaguraUltimate_caster[this])))])) // INLINED!!
        local real x
        local real y
        local real z
        local real new_x
        local real new_y
        local integer i= 0
        local integer j= 0
        call UnitRemoveBuffs(s__YaguraUltimate_caster[this], false, true)
        set s__YaguraUltimate_count[this]=s__YaguraUltimate_count[this] + 1
        set x=(((GetUnitX(s__YaguraUltimate_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__YaguraUltimate_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        set z=ParabolaZ(500 , 30.0 , s__YaguraUltimate_count[this])
        call SetUnitX(s__YaguraUltimate_sanbi[this], x)
        call SetUnitY(s__YaguraUltimate_sanbi[this], y)
        call SetUnitX(s__YaguraUltimate_caster[this], x)
        call SetUnitY(s__YaguraUltimate_caster[this], y)
        call SetUnitFlyHeight(s__YaguraUltimate_sanbi[this], z, 0)
        if s__YaguraUltimate_count[this] >= 30 then
            set s__YaguraUltimate_count[this]=0
            if not UnitAlive(s__YaguraUltimate_caster[this]) or GetWidgetLife(s__YaguraUltimate_caster[this]) < 0.405 then
                set s__YaguraUltimate_bounce[this]=4
            else
                set s__YaguraUltimate_bounce[this]=s__YaguraUltimate_bounce[this] + 1
            endif
            call SetUnitFlyHeight(s__YaguraUltimate_sanbi[this], 0, 0)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(s__YaguraUltimate_caster[this]) )*1.0), (( GetUnitY(s__YaguraUltimate_caster[this]))*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__YaguraUltimate_caster[this]) )*1.0), (( GetUnitY(s__YaguraUltimate_caster[this]))*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack Big.mdx" ), (( GetUnitX(s__YaguraUltimate_caster[this]) )*1.0), (( GetUnitY(s__YaguraUltimate_caster[this]))*1.0))) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("DustWave.mdx", GetUnitX(s__YaguraUltimate_caster[this]), GetUnitY(s__YaguraUltimate_caster[this]))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
            call DestroyEffect(bj_lastCreatedEffect)
            set bj_lastCreatedGroup=CreateGroup()
            set s__YaguraUltimate_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__YaguraUltimate_caster[this]), GetUnitY(s__YaguraUltimate_caster[this]), 350.0, Filter(function s__YaguraUltimate_damagefix))
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            if s__YaguraUltimate_bounce[this] < 3 then
            else
                set i=0
                loop
                    set i=i + 1
                    exitwhen i > 5
                    call KillUnit(CreateUnit(GetOwningPlayer(s__YaguraUltimate_caster[this]), 'h05R', GetUnitX(s__YaguraUltimate_caster[this]), GetUnitY(s__YaguraUltimate_caster[this]), GetRandomReal(0, 360)))
                endloop
                call KillUnit(s__YaguraUltimate_sanbi[this])
                call ShowUnit(s__YaguraUltimate_sanbi[this], false)
                set s__YaguraUltimate_sanbi[this]=null
                call SetUnitPropWindow(s__YaguraUltimate_caster[this], s__YaguraUltimate_default_window)
                call SetUnitVertexColor((s__YaguraUltimate_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
                call PauseUnit(s__YaguraUltimate_caster[this], false)
                call TimerStart((NewTimerEx(0)), 2.0, false, function s__YaguraUltimate_resetWindow) // INLINED!!
                call s__YaguraUltimate_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 
    
    function s__YaguraUltimate_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.03, true, function s__YaguraUltimate_jump)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__YaguraUltimate_actions takes nothing returns nothing
        local integer this= s__YaguraUltimate_allocate()
        local integer i= 0
        set s__YaguraUltimate_caster[this]=GetTriggerUnit()
        set s__YaguraUltimate_caster_x[this]=GetUnitX(s__YaguraUltimate_caster[this])
        set s__YaguraUltimate_caster_y[this]=GetUnitY(s__YaguraUltimate_caster[this])
        set s__YaguraUltimate_target_x[this]=GetSpellTargetX()
        set s__YaguraUltimate_target_y[this]=GetSpellTargetY()
        set s__YaguraUltimate_count[this]=0
        set s__YaguraUltimate_bounce[this]=0
        set s__YaguraUltimate_window[this]=GetUnitPropWindow(s__YaguraUltimate_caster[this])
        set s__YaguraUltimate_next_target_x=GetSpellTargetX()
        set s__YaguraUltimate_next_target_y=GetSpellTargetY()
        call SetUnitVertexColor((s__YaguraUltimate_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 0)) // INLINED!!
        call SetUnitPropWindow(s__YaguraUltimate_caster[this], 0)
	    call PauseUnit(s__YaguraUltimate_caster[this], true)
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Yagura_T, 100, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Yagura: For the sake of the village, I must do the dirty work.|r")
        endif
        set s__YaguraUltimate_sanbi[this]=CreateUnit(GetTriggerPlayer(), 'h09C', GetUnitX(s__YaguraUltimate_caster[this]), GetUnitY(s__YaguraUltimate_caster[this]), GetUnitFacing(s__YaguraUltimate_caster[this]))
        call SetUnitAnimation(s__YaguraUltimate_sanbi[this], "spell slam")
        loop
            set i=i + 1
            exitwhen i > 5
            call KillUnit(CreateUnit(GetOwningPlayer(s__YaguraUltimate_caster[this]), 'h05R', GetUnitX(s__YaguraUltimate_caster[this]), GetUnitY(s__YaguraUltimate_caster[this]), GetRandomReal(0, 360)))
        endloop
        call TimerStart(NewTimerEx(this), 0.2, false, function s__YaguraUltimate_delay)
    endfunction 
    

    function s__YaguraUltimate_leave takes nothing returns nothing
	if GetUnitTypeId(GetLeavingUnit()) == 'N01S' then
		set s__YaguraUltimate_yagura=GetLeavingUnit()
        	set s__YaguraUltimate_default_window=GetUnitPropWindow(GetLeavingUnit())
	endif
    endfunction
    
