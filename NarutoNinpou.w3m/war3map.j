            return this
        endfunction
    
        function s__Raiden___Spell_deallocate takes integer this returns nothing
            set s__Raiden___Spell_Alloc___recycle[this]=s__Raiden___Spell_Alloc___recycle[(0)]
            set s__Raiden___Spell_Alloc___recycle[(0)]=this
        endfunction
        
        
        function s__Raiden___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local location loc1
            local location loc2
            local location loc3
            local location loc4
            local group g
            local unit u
            local integer i
            local integer i_end
            set s__Raiden___Spell_count[this]=s__Raiden___Spell_count[this] + 1
            set loc1=PolarProjectionBJ(s__Raiden___Spell_point[this], s__Raiden___Spell_distance[this], ( s__Raiden___Spell_angle[this] + 180 ) + ( s__Raiden___Spell_count[this] * 10 ))
          //  if MapContainsX(GetLocationX(loc1)) and MapContainsY(GetLocationY(loc1)) then
                call SetUnitX(s__Raiden___Spell_bunshin1[this], GetLocationX(loc1))
                call SetUnitY(s__Raiden___Spell_bunshin1[this], GetLocationY(loc1))
                call DestroyEffect(AddSpecialEffectLoc("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", loc1))
          //  endif
            set loc2=PolarProjectionBJ(s__Raiden___Spell_point[this], s__Raiden___Spell_distance[this], ( s__Raiden___Spell_angle[this] + 180 ) - ( s__Raiden___Spell_count[this] * 10 ))
           // if MapContainsX(GetLocationX(loc2)) and MapContainsY(GetLocationY(loc2)) then
                call SetUnitX(s__Raiden___Spell_bunshin2[this], GetLocationX(loc2))
                call SetUnitY(s__Raiden___Spell_bunshin2[this], GetLocationY(loc2))
                call DestroyEffect(AddSpecialEffectLoc("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", loc2))
           // endif
            if s__Raiden___Spell_count[this] == 18 then
                call SetUnitFacing(s__Raiden___Spell_bunshin1[this], s__Raiden___Spell_angle[this] + 180)
                call SetUnitFacing(s__Raiden___Spell_bunshin2[this], s__Raiden___Spell_angle[this] + 180)
                call GroupClear(s__Raiden___Spell_units[this])
            endif
            call MoveLightningEx(s__Raiden___Spell_light[this], true, GetLocationX(loc1), GetLocationY(loc1), 60, GetLocationX(loc2), GetLocationY(loc2), 60)
            set i=0
            set i_end=R2I(DistanceBetweenPoints(loc1, loc2) / 100)
            loop
                set i=i + 1
                exitwhen i > i_end
                set loc3=PolarProjectionBJ(loc1, 100 * i, AngleBetweenPoints(loc1, loc2))
                set g=CreateGroup()
                call GroupEnumUnitsInRangeOfLoc(g, loc3, 100, null)
                loop
                    set u=FirstOfGroup(g)
                    exitwhen u == null
                    if IsUnitEnemy(u, GetOwningPlayer(s__Raiden___Spell_caster[this])) and GetWidgetLife(u) > 0.405 and not IsUnitInGroup(u, s__Raiden___Spell_units[this]) then
                        set loc4=GetUnitLoc(u)
                        call DestroyEffect(AddSpecialEffectLoc("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx", loc4))
                        call RemoveLocation(loc4)
                        call UnitDamageTarget(s__Raiden___Spell_caster[this], u, ( 600 + 2.0 * GetHeroAgi(s__Raiden___Spell_caster[this], true) ) * GetUnitAbilityLevel(s__Raiden___Spell_caster[this], 'A0HT'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                        call GroupAddUnit(s__Raiden___Spell_units[this], u)
                    endif
                    call GroupRemoveUnit(g, u)
                endloop
                call DestroyGroup(g)
                call RemoveLocation(loc3)
            endloop
            call RemoveLocation(loc1)
            call RemoveLocation(loc2)
            set loc1=null
            set loc2=null
            set loc3=null
            set loc4=null
            set g=null
            set u=null
            if s__Raiden___Spell_count[this] >= 36 then
                set loc1=GetUnitLoc(s__Raiden___Spell_bunshin1[this])
               // if MapContainsX(GetLocationX(loc1)) and MapContainsY(GetLocationY(loc1)) then
	    if not IsTerrainPathable(GetLocationX(loc1), GetLocationY(loc1), PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(s__Raiden___Spell_caster[this], GetLocationX(loc1))
                    call SetUnitY(s__Raiden___Spell_caster[this], GetLocationY(loc1))
                    call SetUnitFacing(s__Raiden___Spell_caster[this], GetUnitFacing(s__Raiden___Spell_bunshin1[this]))
              //  endif
                call RemoveLocation(loc1)
                set loc1=null
               // call PauseUnit(this.caster, false)
                call ShowUnit(s__Raiden___Spell_caster[this], true)
                call SelectUnitForPlayerSingle(s__Raiden___Spell_caster[this], GetOwningPlayer(s__Raiden___Spell_caster[this]))
                call RemoveLocation(s__Raiden___Spell_point[this])
                call RemoveUnit(s__Raiden___Spell_bunshin1[this])
                call RemoveUnit(s__Raiden___Spell_bunshin2[this])
                call DestroyLightning(s__Raiden___Spell_light[this])
                call DestroyGroup(s__Raiden___Spell_units[this])
                set s__Raiden___Spell_units[this]=null
                set s__Raiden___Spell_bunshin1[this]=null
                set s__Raiden___Spell_bunshin2[this]=null
                set s__Raiden___Spell_point[this]=null
                set s__Raiden___Spell_caster[this]=null
                call s__Raiden___Spell_deallocate(this)
                call PauseTimer(GetExpiredTimer())
                call ReleaseTimer(GetExpiredTimer())
            endif
		endif
        endfunction
        
        function s__Raiden___Spell_conditions takes nothing returns nothing
            local integer this= s__Raiden___Spell_allocate()
            local timer tm= NewTimerEx(this)
            local location loc1
            local location loc2
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                if BlzGetUnitSkin(GetTriggerUnit()) == 'h0AS' then
                    call PlaySoundOnUnitBJ(gg_snd_FemKakashi_Jounin_R, 100.0, GetTriggerUnit())
                else
                    call PlaySoundOnUnitBJ(gg_snd_Kakashi_Jounin_R, 100.0, GetTriggerUnit())
                endif
            endif
            set s__Raiden___Spell_caster[this]=GetTriggerUnit()
            set s__Raiden___Spell_count[this]=0
            set loc1=GetUnitLoc(s__Raiden___Spell_caster[this])
            set loc2=GetSpellTargetLoc()
            set s__Raiden___Spell_angle[this]=AngleBetweenPoints(loc1, loc2)
            set s__Raiden___Spell_distance[this]=450 //DistanceBetweenPoints(loc1, loc2)
            set s__Raiden___Spell_point[this]=PolarProjectionBJ(loc1, s__Raiden___Spell_distance[this] / 2.2, s__Raiden___Spell_angle[this])

            if BlzGetUnitSkin(s__Raiden___Spell_caster[this]) == 'h0AS' then
                    set s__Raiden___Spell_bunshin1[this]=CreateUnitAtLoc(GetTriggerPlayer(), 'n02I', loc1, s__Raiden___Spell_angle[this])
                    call SetUnitAnimationByIndex(s__Raiden___Spell_bunshin1[this], 7)
                    call AddSpecialEffectTarget("Chirodri_squished.mdx", s__Raiden___Spell_bunshin1[this], "right hand")
                    set s__Raiden___Spell_bunshin2[this]=CreateUnitAtLoc(GetTriggerPlayer(), 'n02I', loc1, s__Raiden___Spell_angle[this])
                    call SetUnitAnimationByIndex(s__Raiden___Spell_bunshin2[this], 7)
                    call AddSpecialEffectTarget("Chirodri_squished.mdx", s__Raiden___Spell_bunshin2[this], "right hand")
            else
                    set s__Raiden___Spell_bunshin1[this]=CreateUnitAtLoc(GetTriggerPlayer(), 'h06E', loc1, s__Raiden___Spell_angle[this])
                    call SetUnitAnimationByIndex(s__Raiden___Spell_bunshin1[this], 2)
                    call AddSpecialEffectTarget("Chirodri_squished.mdx", s__Raiden___Spell_bunshin1[this], "right hand")
                    set s__Raiden___Spell_bunshin2[this]=CreateUnitAtLoc(GetTriggerPlayer(), 'h06E', loc1, s__Raiden___Spell_angle[this])
                    call SetUnitAnimationByIndex(s__Raiden___Spell_bunshin2[this], 2)
                    call AddSpecialEffectTarget("Chirodri_squished.mdx", s__Raiden___Spell_bunshin2[this], "right hand")
            endif


            set s__Raiden___Spell_light[this]=AddLightningLoc("CLPB", s__Raiden___Spell_point[this], s__Raiden___Spell_point[this])
            //call PauseUnit(this.caster, true)
            call ShowUnit(s__Raiden___Spell_caster[this], false)
            call DestroyEffect(AddSpecialEffectLoc("blackblink.mdx", loc1))
            set s__Raiden___Spell_units[this]=CreateGroup()
            call TimerStartEx(tm , 0.04 , true , function s__Raiden___Spell_periodic , "KakashiRaiden_periodic")
            call RemoveLocation(loc1)
            call RemoveLocation(loc2)
            set loc1=null
            set loc2=null
            set tm=null
        endfunction
        
        function s__Raiden___Spell_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(11 , 'A0HT' , function s__Raiden___Spell_conditions)
        endfunction
        
    
// scope Raiden ends
