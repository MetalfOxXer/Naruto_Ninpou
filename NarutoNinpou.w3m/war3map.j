            call SetUnitFlyHeight(GetFilterUnit(), 250, 0)
            call PauseUnit(GetFilterUnit(), true)
            call GroupAddUnit(s__KushinaSlam_damaged[s__KushinaSlam_instance], GetFilterUnit())
        endif
        return false
    endfunction

    function s__KushinaSlam_delay3 takes nothing returns nothing
