function sa__HagoromoD_updateOrbs takes nothing returns boolean

            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer i= 0
            local real distance= 150
            local real height= 75
            local real angleOffset= 360 / s__HagoromoD_HagoromoMaxCharges
            local real angle= - 90
            local real x= GetUnitX(s__HagoromoD_Hagoromo)
            local real y= GetUnitY(s__HagoromoD_Hagoromo)
            local real currentAngle
            local real orbX
            local real orbY
            local real orbZ
            local real new_x
            local real new_y
            local real start_x
            local real start_y
            local real target_x
            local real target_y
            local real lerpFactor= 0.2
         local real maxMana= BlzGetUnitMaxMana(s__HagoromoD_Hagoromo)
         local real manaOffset= I2R(s__HagoromoD_HagoromoCurrentCharges) / I2R(s__HagoromoD_HagoromoMaxCharges)
         local real manaCur= maxMana * manaOffset
            set target_x=x
            set target_y=y
            call BlzSetUnitRealField(s__HagoromoD_Hagoromo, UNIT_RF_MANA, manaCur)
            set currentAngle=angle
            if s__HagoromoD_HagoromoCurrentCharges == 0 and IsUnitHidden(s__HagoromoChargesD_orbs[0]) then
                set s__HagoromoD_HagoromoSpellAntepenultimate=0
                set s__HagoromoD_HagoromoSpellPenultimate=0
                set s__HagoromoD_HagoromoSpellPrevious=0
                set s__HagoromoD_lastDebuff1=0
                set s__HagoromoD_lastDebuff2=0
                set s__HagoromoD_lastDebuff3=0
                call s__HagoromoD_removeAllDebuffs(this)
            else
                loop
                    if i < s__HagoromoD_HagoromoCurrentCharges then
                        if s__HagoromoChargesD_orbs[i] == null then
                            set s__HagoromoChargesD_orbs[i]= CreateUnit(GetOwningPlayer(s__HagoromoD_Hagoromo), 'h009', 0, 0, 0)
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        endif
                        set orbX=x + distance * Cos(currentAngle * bj_DEGTORAD)
                        set orbY=y + distance * Sin(currentAngle * bj_DEGTORAD)
                        set orbZ=height // for horizontal UX
                        if IsUnitHidden(s__HagoromoD_Hagoromo) or not IsUnitAliveBJ(s__HagoromoD_Hagoromo) then //or (IsUnitInvisible(this.Hagoromo, Player(3))) or (IsUnitInvisible(this.Hagoromo, Player(7))) or (IsUnitInvisible(this.Hagoromo, Player(11))) then 
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        else
                            call SetUnitX(s__HagoromoChargesD_orbs[i], orbX)
                            call SetUnitY(s__HagoromoChargesD_orbs[i], orbY)
                            call SetUnitFlyHeight(s__HagoromoChargesD_orbs[i], orbZ, 0)
                            call ShowUnit(s__HagoromoChargesD_orbs[i], true)
                            call UnitAddAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                        endif
                    else
                        set start_x=GetUnitX(s__HagoromoChargesD_orbs[i])
                        set start_y=GetUnitY(s__HagoromoChargesD_orbs[i])
                        set new_x=start_x + lerpFactor * ( target_x - start_x )
                        set new_y=start_y + lerpFactor * ( target_y - start_y )
                        call SetUnitX(s__HagoromoChargesD_orbs[i], new_x)
                        call SetUnitY(s__HagoromoChargesD_orbs[i], new_y)
                        if IsUnitHidden(s__HagoromoD_Hagoromo) or not IsUnitAliveBJ(s__HagoromoD_Hagoromo) or GetDistance(start_x , start_y , target_x , target_y) <= 44 then // (IsUnitInvisible(this.Hagoromo, Player(0)) or IsUnitInvisible(this.Hagoromo, Player(4)) or IsUnitInvisible(this.Hagoromo, Player(8)))
                            call SetUnitVertexColor(s__HagoromoChargesD_orbs[i], 255, 255, 255, 255)
                            call UnitRemoveAbility(s__HagoromoChargesD_orbs[i], 'Aloc')
                            call ShowUnit(s__HagoromoChargesD_orbs[i], false)
                        endif
                    endif
                    set currentAngle=currentAngle + angleOffset
                    set i=i + 1
                    exitwhen i >= s__HagoromoD_HagoromoMaxCharges
                endloop
            endif
            if GetUnitLevel(s__HagoromoD_Hagoromo) >= 10 and s__HagoromoD_HagoromoMaxCharges < 4 then
                set s__HagoromoD_HagoromoMaxCharges=4
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0ON')
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 15 and s__HagoromoD_HagoromoMaxCharges < 5 then
                set s__HagoromoD_HagoromoMaxCharges=5
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 35 and s__HagoromoD_HagoromoMaxCharges < 6 then
                set s__HagoromoD_HagoromoMaxCharges=6
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                call UnitAddAbility(s__HagoromoD_Hagoromo, 'A0OO')
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
            elseif GetUnitLevel(s__HagoromoD_Hagoromo) >= 50 and s__HagoromoD_HagoromoMaxCharges < 8 then
                set s__HagoromoD_HagoromoMaxCharges=8
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 2
                if s__HagoromoD_HagoromoCurrentCharges >= s__HagoromoD_HagoromoMaxCharges then
