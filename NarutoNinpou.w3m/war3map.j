//Implemented from module Alloc:
    
        function s__KankuroSummonKarasu_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KankuroSummonKarasu_Alloc___recycle[(0)] == 0 ) then
                set s__KankuroSummonKarasu_Alloc___instanceCount=s__KankuroSummonKarasu_Alloc___instanceCount + 1
                set this=s__KankuroSummonKarasu_Alloc___instanceCount
            else
                set this=s__KankuroSummonKarasu_Alloc___recycle[(0)]
                set s__KankuroSummonKarasu_Alloc___recycle[(0)]=s__KankuroSummonKarasu_Alloc___recycle[s__KankuroSummonKarasu_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KankuroSummonKarasu_deallocate takes integer this returns nothing
            set s__KankuroSummonKarasu_Alloc___recycle[this]=s__KankuroSummonKarasu_Alloc___recycle[(0)]
            set s__KankuroSummonKarasu_Alloc___recycle[(0)]=this
        endfunction

    function s__KankuroSummonKarasu_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real caster_x= GetUnitX(s__KankuroSummonKarasu_caster[this])
        local real caster_y= GetUnitY(s__KankuroSummonKarasu_caster[this])
        local real puppet_x= GetUnitX(s__KankuroSummonKarasu_puppet[this])
        local real puppet_y= GetUnitY(s__KankuroSummonKarasu_puppet[this])
        local real angle= Atan3(caster_x , caster_y , puppet_x , puppet_y)
        local real distance= GetDistance(caster_x , caster_y , puppet_x , puppet_y)
        local integer i
        if distance >= 1000 and not IsUnitPaused(s__KankuroSummonKarasu_puppet[this]) then
            call SetUnitX(s__KankuroSummonKarasu_puppet[this], (((caster_x )*1.0) + Cos((( angle )*1.0)) * (( 1000)*1.0))) // INLINED!!
            call SetUnitY(s__KankuroSummonKarasu_puppet[this], (((caster_y )*1.0) + Sin((( angle )*1.0)) * (( 1000)*1.0))) // INLINED!!
	    //call IssueTargetOrder(this.puppet, "patrol", this.caster)
        endif
        set s__KankuroSummonKarasu_count[this]=s__KankuroSummonKarasu_count[this] + 1
        set udg_KankuroKarasu=s__KankuroSummonKarasu_puppet[this]
        if GetWidgetLife(s__KankuroSummonKarasu_puppet[this]) <= 0.405 or s__KankuroSummonKarasu_count[this] > 33 * 120 or GetWidgetLife(s__KankuroSummonKarasu_caster[this]) <= 0.405 then
            //call SetPlayerAbilityAvailable(GetOwningPlayer(this.caster), 'A08I', true)
            set i=0
            loop
                exitwhen i > 5
                call UnitRemoveItemFromSlotSwapped(i + 1, s__KankuroSummonKarasu_puppet[this])
                set i=i + 1
            endloop
            call KillUnit(s__KankuroSummonKarasu_puppet[this])
            call ShowUnit(s__KankuroSummonKarasu_puppet[this], false)
            call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" ), (( GetUnitX(s__KankuroSummonKarasu_puppet[this]) )*1.0), (( GetUnitY(s__KankuroSummonKarasu_puppet[this]))*1.0))) // INLINED!!
            set udg_KankuroKarasu=null
            set s__KankuroSummonKarasu_caster[this]=null
            set s__KankuroSummonKarasu_puppet[this]=null
            call s__KankuroSummonKarasu_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KankuroSummonKarasu_actions takes nothing returns nothing
        local integer this= s__KankuroSummonKarasu_allocate()
        if udg_KankuroKarasu == null then
             set s__KankuroSummonKarasu_caster[this]=GetTriggerUnit()
            set s__KankuroSummonKarasu_puppet[this]=CreateUnit(GetTriggerPlayer(), 'h07O', GetUnitX(s__KankuroSummonKarasu_caster[this]), GetUnitY(s__KankuroSummonKarasu_caster[this]), GetUnitFacing(s__KankuroSummonKarasu_caster[this]))
            set s__KankuroSummonKarasu_count[this]=0
            set udg_KankuroKarasu=s__KankuroSummonKarasu_puppet[this]
            call SetUnitPathing(s__KankuroSummonKarasu_puppet[this], false)
	        call IssueTargetOrder(s__KankuroSummonKarasu_puppet[this], "patrol", s__KankuroSummonKarasu_caster[this])
            if BlzGetUnitAbilityCooldownRemaining(s__KankuroSummonKarasu_caster[this], 'A181') > 0 then
                call BlzStartUnitAbilityCooldown(s__KankuroSummonKarasu_puppet[this], 'A182', BlzGetUnitAbilityCooldownRemaining(s__KankuroSummonKarasu_caster[this], 'A181'))
            endif
            //call SetPlayerAbilityAvailable(GetOwningPlayer(this.caster), 'A08I', false)
            //call SetUnitState(udg_KankuroKarasu, UNIT_STATE_MAX_LIFE, 500.0 + 18 * GetHeroLevel(this.caster)) 
            call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" ), (( GetUnitX(s__KankuroSummonKarasu_puppet[this]) )*1.0), (( GetUnitY(s__KankuroSummonKarasu_puppet[this]))*1.0))) // INLINED!!
            call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__KankuroSummonKarasu_periodic , "KankuroSummonKarasu_periodic")
        else
            call s__KankuroSummonKarasu_deallocate(this)
        endif
    endfunction 
    
    function s__KankuroSummonKarasu_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(4 , 'A06H' , function s__KankuroSummonKarasu_actions)
    endfunction 
    
