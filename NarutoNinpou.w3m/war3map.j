//===========================================================================
// Trigger: SasoriKaiho
//===========================================================================
    
//Implemented from module Alloc:
    
        function s__SasoriKaiho_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasoriKaiho_Alloc___recycle[(0)] == 0 ) then
                set s__SasoriKaiho_Alloc___instanceCount=s__SasoriKaiho_Alloc___instanceCount + 1
                set this=s__SasoriKaiho_Alloc___instanceCount
            else
                set this=s__SasoriKaiho_Alloc___recycle[(0)]
                set s__SasoriKaiho_Alloc___recycle[(0)]=s__SasoriKaiho_Alloc___recycle[s__SasoriKaiho_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SasoriKaiho_deallocate takes integer this returns nothing
            set s__SasoriKaiho_Alloc___recycle[this]=s__SasoriKaiho_Alloc___recycle[(0)]
            set s__SasoriKaiho_Alloc___recycle[(0)]=this
        endfunction
    
	
    function s__SasoriKaiho_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__SasoriKaiho_count[this]=s__SasoriKaiho_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__SasoriKaiho_target_x[this], s__SasoriKaiho_target_y[this], 400, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			exitwhen bj_lastCreatedUnit == null
			if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriKaiho_caster[this])) then
					if GetHeroLevel(s__SasoriKaiho_caster[this]) >= 15 then
						call UnitDamageTarget(s__SasoriKaiho_caster[this], bj_lastCreatedUnit, ( 1600 + 2 * GetHeroStr(s__SasoriKaiho_caster[this], true) ) / 100, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					else
						call UnitDamageTarget(s__SasoriKaiho_caster[this], bj_lastCreatedUnit, ( 800 + GetHeroStr(s__SasoriKaiho_caster[this], true) ) / 100, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					endif
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
        if s__SasoriKaiho_count[this] >= 100 then
            call ShowUnit(s__SasoriKaiho_spikes[this], false)
            call KillUnit(s__SasoriKaiho_spikes[this])
            set s__SasoriKaiho_spikes[this]=null
            call s__SasoriKaiho_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SasoriKaiho_actions takes nothing returns nothing
        local integer this= s__SasoriKaiho_allocate()
        local integer i= 0
  local real x
  local real y
        set s__SasoriKaiho_caster[this]=GetTriggerUnit()
        set s__SasoriKaiho_target_x[this]=GetSpellTargetX()
        set s__SasoriKaiho_target_y[this]=GetSpellTargetY()
        set s__SasoriKaiho_count[this]=0
        set s__SasoriKaiho_spikes[this]=CreateUnit(GetOwningPlayer(s__SasoriKaiho_caster[this]), 'e02L', s__SasoriKaiho_target_x[this], s__SasoriKaiho_target_y[this], 270)
        call SetUnitTimeScale(s__SasoriKaiho_spikes[this], 1.2)
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__SasoriKaiho_periodic , "SasoriKaiho_periodic")
    endfunction 
   
    function s__SasoriKaiho_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__SasoriKaiho_SPELL_ID ) , Filter(( function s__SasoriKaiho_actions))) // INLINED!!
    endfunction 

