        if GetWidgetLife(GetFilterUnit()) > 0.405 and GetFilterUnit() != s__DeidaraC0_caster[s__DeidaraC0_instance] and GetUnitTypeId(GetFilterUnit()) != 'n005' and GetUnitTypeId(GetFilterUnit()) != 'n004' and GetUnitTypeId(GetFilterUnit()) != 'o009' then
			if IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == true and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__DeidaraC0_caster[s__DeidaraC0_instance])) then
				call UnitDamageTarget(s__DeidaraC0_caster[s__DeidaraC0_instance], GetFilterUnit(), 0.12 * GetHeroInt(s__DeidaraC0_caster[s__DeidaraC0_instance], true) * GetHeroLevel(s__DeidaraC0_caster[s__DeidaraC0_instance]), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			else
				if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__DeidaraC0_caster[s__DeidaraC0_instance])) then
					call UnitDamageTarget(s__DeidaraC0_caster[s__DeidaraC0_instance], GetFilterUnit(), 0.08 * GetHeroInt(s__DeidaraC0_caster[s__DeidaraC0_instance], true) * GetHeroLevel(s__DeidaraC0_caster[s__DeidaraC0_instance]), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__DeidaraC0_caster[s__DeidaraC0_instance], GetFilterUnit(), 0.04 * GetHeroInt(s__DeidaraC0_caster[s__DeidaraC0_instance], true) * GetHeroLevel(s__DeidaraC0_caster[s__DeidaraC0_instance]), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				endif
			endif
        endif
        return false
    endfunction 

 function s__DeidaraC0_delay2 takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real damage= GetUnitState(s__DeidaraC0_caster[this], UNIT_STATE_MAX_LIFE) * 0.15
		call UnitDamageTarget(s__DeidaraC0_caster[this], s__DeidaraC0_caster[this], damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)

		set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_C0.mdl", GetUnitX(s__DeidaraC0_caster[this]), GetUnitY(s__DeidaraC0_caster[this]))
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
		call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.5)*1.0) , false) // INLINED!!
		if IsUnitVisible(s__DeidaraC0_caster[this], GetLocalPlayer()) then
			call PlaySoundOnUnitBJ(gg_snd_Deidara_D, 80.0, s__DeidaraC0_caster[this])
		endif

		set bj_lastCreatedGroup=CreateGroup()
        	set s__DeidaraC0_instance=this
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__DeidaraC0_caster[this]), GetUnitY(s__DeidaraC0_caster[this]), 800, Filter(function s__DeidaraC0_dealDamage))
		call DestroyGroup(bj_lastCreatedGroup)
		call PauseUnit(s__DeidaraC0_caster[this], false)
		call SetUnitVertexColor(s__DeidaraC0_caster[this], 255, 255, 255, 255)
		call s__DeidaraC0_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__DeidaraC0_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__DeidaraC0_count[this]=s__DeidaraC0_count[this] - 2
		call SetUnitX(s__DeidaraC0_dummy[this], GetUnitX(s__DeidaraC0_caster[this]))
		call SetUnitY(s__DeidaraC0_dummy[this], GetUnitY(s__DeidaraC0_caster[this]))
		call SetUnitScale(s__DeidaraC0_dummy[this], 0.5 + I2R(s__DeidaraC0_count[this] * 3) / 100, 1.0, 1.0)
		if ModuloInteger(s__DeidaraC0_count[this], 5) == 0 then
			set bj_lastCreatedEffect=AddSpecialEffect("SuperShinyThingy.mdl", GetUnitX(s__DeidaraC0_caster[this]), GetUnitY(s__DeidaraC0_caster[this]))
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60)
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
			call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.5)*1.0) , false) // INLINED!!
		endif
		if s__DeidaraC0_count[this] <= 0 then
			call KillUnit(s__DeidaraC0_dummy[this])
			call ShowUnit(s__DeidaraC0_dummy[this], false)
			set s__DeidaraC0_dummy[this]=null
			call TimerStart(NewTimerEx(this), 0.03, false, function s__DeidaraC0_delay2)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__DeidaraC0_actions takes nothing returns nothing
  local integer this
		set this=s__DeidaraC0_allocate()
		set s__DeidaraC0_caster[this]=GetTriggerUnit()
		set s__DeidaraC0_count[this]=60
		call PauseUnit(s__DeidaraC0_caster[this], true)
