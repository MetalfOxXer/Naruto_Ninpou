 function s__FuuNewE_periodic2 takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__FuuNewE_caster[this])
  local real y= GetUnitY(s__FuuNewE_caster[this])
  local real new_x= (((x )*1.0) + Cos((( s__FuuNewE_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__FuuNewE_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
  local integer i
  local real angle
		call SetUnitX(s__FuuNewE_caster[this], new_x)
		call SetUnitY(s__FuuNewE_caster[this], new_y)
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		set s__FuuNewE_count[this]=s__FuuNewE_count[this] + 1
		if s__FuuNewE_count[this] > s__FuuNewE_max_count[this] then
			set i=0
			loop
				exitwhen i > 5
				set angle=Deg2Rad(60 * i)
				set new_x=(((GetUnitX(s__FuuNewE_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
				set new_y=(((GetUnitY(s__FuuNewE_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapimported\\Earth_Spikes.mdl", new_x, new_y)
				//call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(45))
				call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle + bj_PI)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 1.5)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
				call DestroyEffect(bj_lastCreatedEffect)
				set i=i + 1
			endloop

            set bj_lastCreatedGroup=CreateGroup()
            set s__FuuNewE_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__FuuNewE_caster[this]), GetUnitY(s__FuuNewE_caster[this]), 300.0, Filter(function s__FuuNewE_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)

			call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__FuuNewE_caster[this]) )*1.0), (( GetUnitY(s__FuuNewE_caster[this]))*1.0))) // INLINED!!
			call UnitRemoveAbility(s__FuuNewE_caster[this], 'Binv')
			call SetUnitTimeScale(s__FuuNewE_caster[this], 1.0)


            call TimerStartEx(NewTimerEx(this) , 0.50 , false , function s__FuuNewE_fall , "FuuNewE_fall")
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

    function s__FuuNewE_actions takes nothing returns nothing
        local integer this= s__FuuNewE_allocate()
        set s__FuuNewE_caster[this]=GetTriggerUnit()
        set s__FuuNewE_angle[this]=Atan3(GetUnitX(s__FuuNewE_caster[this]) , GetUnitY(s__FuuNewE_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__FuuNewE_max_count[this]=R2I(GetDistance(GetUnitX(s__FuuNewE_caster[this]) , GetUnitY(s__FuuNewE_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) / 100)
        set s__FuuNewE_count[this]=0
        set s__FuuNewE_damaged[this]=CreateGroup()
