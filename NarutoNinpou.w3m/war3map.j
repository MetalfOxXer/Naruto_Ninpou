    function s__OrochimaruNewD_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitRemoveBuffs(s__OrochimaruNewD_caster[this], false, true)
        if GetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_LIFE) < s__OrochimaruNewD_hp[this] - 80 then
 		set s__OrochimaruNewD_recover[this]=false
        endif
	set s__OrochimaruNewD_hp[this]=GetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_LIFE)
        if GetUnitTypeId(s__OrochimaruNewD_caster[this]) == 'U002' then
	    if s__OrochimaruNewD_recover[this] then
		call SetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_LIFE, GetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_LIFE) + GetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_MAX_LIFE) * 0.2)
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl" ), (( GetUnitX(s__OrochimaruNewD_caster[this]) )*1.0), (( GetUnitY(s__OrochimaruNewD_caster[this]))*1.0))) // INLINED!!
	    endif
            call s__OrochimaruNewD_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__OrochimaruNewD_actions takes nothing returns nothing
        local integer this
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        if GetUnitTypeId(GetTriggerUnit()) == 'U002' then
            call AddLoadingBar(GetTriggerUnit() , 5.0)
            set this=s__OrochimaruNewD_allocate()
            set s__OrochimaruNewD_caster[this]=GetTriggerUnit()
            set s__OrochimaruNewD_recover[this]=true
            set s__OrochimaruNewD_hp[this]=GetUnitState(s__OrochimaruNewD_caster[this], UNIT_STATE_LIFE)
            call SetPlayerAbilityAvailableBJ(false, 'A1AJ', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(false, 'A0CU', GetTriggerPlayer())
	    if (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I007'))) then // INLINED!!
	    else
            	call SetPlayerAbilityAvailableBJ(false, 'A02D', GetTriggerPlayer())
	    endif
            call SetPlayerAbilityAvailableBJ(false, 'A0LO', GetTriggerPlayer())
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') > 0 then
                call SetPlayerAbilityAvailableBJ(false, 'A0VF', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') > 0 then
                call SetPlayerAbilityAvailableBJ(false, 'A0SE', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') == 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') == 0 then
                call SetPlayerAbilityAvailableBJ(false, 'A0SH', GetTriggerPlayer())
            endif
            call TimerStart(NewTimerEx(this), 0.05, true, function s__OrochimaruNewD_periodic)
        else
            call SetPlayerAbilityAvailableBJ(true, 'A1AJ', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A0CU', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A02D', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A0LO', GetTriggerPlayer())
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') > 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0VF', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') > 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0SE', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') == 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') == 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0SH', GetTriggerPlayer())
            endif
        endif
    endfunction
    
    function s__OrochimaruNewD_orochimaruDeath takes nothing returns nothing
        if GetUnitTypeId(GetTriggerUnit()) == 'U006' or GetUnitTypeId(GetTriggerUnit()) == 'U00P' then
            call SetPlayerAbilityAvailableBJ(true, 'A1AJ', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A0CU', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A02D', GetTriggerPlayer())
            call SetPlayerAbilityAvailableBJ(true, 'A0LO', GetTriggerPlayer())
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') > 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0VF', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') > 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0SE', GetTriggerPlayer())
            endif
            if GetUnitAbilityLevel(GetTriggerUnit(), 'A0VF') == 0 and GetUnitAbilityLevel(GetTriggerUnit(), 'A0SE') == 0 then
                call SetPlayerAbilityAvailableBJ(true, 'A0SH', GetTriggerPlayer())
            endif
        endif
    endfunction 
    
    function s__OrochimaruNewD_onInit takes nothing returns nothing
	call RegisterPlayerUnitEventForId(25 , EVENT_PLAYER_UNIT_DEATH , function s__OrochimaruNewD_orochimaruDeath)
        call RegisterSpellEffectEventForId(25 , s__OrochimaruNewD_SPELL_ID , function s__OrochimaruNewD_actions)
	call RegisterSpellEffectEvent2(('A02I' ) , Filter(( function s__OrochimaruNewD_orochimaruDeath))) // INLINED!!
    endfunction
    
