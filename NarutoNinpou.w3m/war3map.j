//Implemented from module Alloc:
    
        function s__RoshiPunch_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__RoshiPunch_Alloc___recycle[(0)] == 0 ) then
                set s__RoshiPunch_Alloc___instanceCount=s__RoshiPunch_Alloc___instanceCount + 1
                set this=s__RoshiPunch_Alloc___instanceCount
            else
                set this=s__RoshiPunch_Alloc___recycle[(0)]
                set s__RoshiPunch_Alloc___recycle[(0)]=s__RoshiPunch_Alloc___recycle[s__RoshiPunch_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__RoshiPunch_deallocate takes integer this returns nothing
            set s__RoshiPunch_Alloc___recycle[this]=s__RoshiPunch_Alloc___recycle[(0)]
            set s__RoshiPunch_Alloc___recycle[(0)]=this
        endfunction

        function s__RoshiPunch_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__RoshiPunch_caster[s__RoshiPunch_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false and IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true then
        	if GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_LIFE) < GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_MAX_LIFE) / 2 and GetWidgetLife(s__RoshiPunch_caster[s__RoshiPunch_instance]) > 0.405 then
                	if GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_LIFE) / GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_MAX_LIFE) <= 0.1 then
                    		call StunUnitTimed(s__RoshiPunch_caster[s__RoshiPunch_instance] , GetFilterUnit() , 1.0)
                	endif
                	call UnitDamageTarget(s__RoshiPunch_caster[s__RoshiPunch_instance], GetFilterUnit(), GetHeroStr(s__RoshiPunch_caster[s__RoshiPunch_instance], true) * GetUnitAbilityLevel(s__RoshiPunch_caster[s__RoshiPunch_instance], s__RoshiPunch_SPELL_ID) * ( 1.5 - GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_LIFE) / GetUnitState(s__RoshiPunch_caster[s__RoshiPunch_instance], UNIT_STATE_MAX_LIFE) ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            	else
                	call UnitDamageTarget(s__RoshiPunch_caster[s__RoshiPunch_instance], GetFilterUnit(), GetHeroStr(s__RoshiPunch_caster[s__RoshiPunch_instance], true) * GetUnitAbilityLevel(s__RoshiPunch_caster[s__RoshiPunch_instance], s__RoshiPunch_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            	endif
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( GetUnitX(GetFilterUnit()) )*1.0), (( GetUnitY(GetFilterUnit()))*1.0))) // INLINED!!
        endif
        return false
        endfunction

 function s__RoshiPunch_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__RoshiPunch_caster[this])
  local real y= GetUnitY(s__RoshiPunch_caster[this])
  local real new_x= (((x )*1.0) + Cos((( s__RoshiPunch_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__RoshiPunch_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
  local integer i= 0
         local unit u= null
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__RoshiPunch_caster[this], new_x)
			call SetUnitY(s__RoshiPunch_caster[this], new_y)
		endif
            	call SetUnitFacing(s__RoshiPunch_caster[this], Rad2Deg(s__RoshiPunch_angle[this]))
        	set bj_lastCreatedGroup=CreateGroup()
        	call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200.0, null)
        	loop
            		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            		exitwhen bj_lastCreatedUnit == null
            		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__RoshiPunch_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                		set s__RoshiPunch_target[this]=bj_lastCreatedUnit
            		endif
            		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        	endloop
       		call DestroyGroup(bj_lastCreatedGroup)
		set s__RoshiPunch_count[this]=s__RoshiPunch_count[this] + 1
		if s__RoshiPunch_target[this] != null or s__RoshiPunch_count[this] > 20 then
            		if s__RoshiPunch_target[this] != null then
                		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( GetUnitX(s__RoshiPunch_target[this]) )*1.0), (( GetUnitY(s__RoshiPunch_target[this]))*1.0))) // INLINED!!
           	 	endif
			set s__RoshiPunch_count[this]=0
			set bj_lastCreatedEffect=AddSpecialEffect("LavaCrack.mdx", GetUnitX(s__RoshiPunch_caster[this]), GetUnitY(s__RoshiPunch_caster[this]))
			call DestroyEffect(bj_lastCreatedEffect)
            		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Abyssal_Impact_Base.mdx", GetUnitX(s__RoshiPunch_caster[this]), GetUnitY(s__RoshiPunch_caster[this]))
			call DestroyEffect(bj_lastCreatedEffect)
			call SlowArea(s__RoshiPunch_caster[this] , GetUnitX(s__RoshiPunch_caster[this]) , GetUnitY(s__RoshiPunch_caster[this]) , 300)
            		set bj_lastCreatedGroup=CreateGroup()
            		set s__RoshiPunch_instance=this
            		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__RoshiPunch_caster[this]), GetUnitY(s__RoshiPunch_caster[this]), 300.0, Filter(function s__RoshiPunch_dealDamage))
            		call DestroyGroup(bj_lastCreatedGroup)
            		call DestroyEffect(s__RoshiPunch_fire1[this])
            		set s__RoshiPunch_fire1[this]=null
			call PauseUnit(s__RoshiPunch_caster[this], false)
            		call s__RoshiPunch_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__RoshiPunch_actions takes nothing returns nothing
  local integer this= s__RoshiPunch_allocate()
		set s__RoshiPunch_caster[this]=GetTriggerUnit()
        	set s__RoshiPunch_angle[this]=Atan3(GetUnitX(s__RoshiPunch_caster[this]) , GetUnitY(s__RoshiPunch_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
		set s__RoshiPunch_target[this]=null
		set s__RoshiPunch_count[this]=0
		call PauseUnit(s__RoshiPunch_caster[this], true)
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\slam.mdx" ), (( GetUnitX(s__RoshiPunch_caster[this]) )*1.0), (( GetUnitY(s__RoshiPunch_caster[this]))*1.0))) // INLINED!!
		call SetUnitTimeScale(s__RoshiPunch_caster[this], 2.0)
		call SetUnitAnimationByIndex(s__RoshiPunch_caster[this], 2)
		set bj_lastCreatedEffect=AddSpecialEffect("DustWaveDash.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(GetTriggerUnit())))
		//call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.5)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
		call DestroyEffect(bj_lastCreatedEffect)
        	set s__RoshiPunch_fire1[this]=AddSpecialEffectTarget("war3mapimported\\Windwalk Fire.mdx", s__RoshiPunch_caster[this], "chest")
		call TimerStart(NewTimerEx(this), 0.03, true, function s__RoshiPunch_periodic)
 endfunction 

 function s__RoshiPunch_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(80 , s__RoshiPunch_SPELL_ID , function s__RoshiPunch_actions)
 endfunction 

