function Trig_RingoRakurai_Conditions takes nothing returns boolean
	return ( ( GetSpellAbilityId() == 'A0WH' ) )
endfunction

function Trig_RingoRakurai_Func014A takes nothing returns nothing
	call RemoveLocation(GetUnitLoc(GetEnumUnit()))
	call KillUnit(GetEnumUnit())
endfunction

function Trig_RingoRakurai_Actions takes nothing returns nothing
 local real x= GetUnitX(GetTriggerUnit())
 local real y= GetUnitY(GetTriggerUnit())
 local real angle= AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()))
	set udg_units19[741]=GetTriggerUnit()
	set udg_RaigaBurialTarget=GetSpellTargetUnit()
	set udg_RaigaBurialCounter=0
	set udg_RaigaBurialCounterMax=3 //R2I(GetDistance(GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()))/300.0)
	call TriggerSleepAction(0.10)
	//call PauseUnit(GetTriggerUnit(),true)
	//call SetUnitAnimation(GetTriggerUnit(),"spell channel")
call AddSpecialEffectTargetUnitBJ(("hand left" ), ( GetTriggerUnit() ), ( "by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx")) // INLINED!!
	call DestroyEffect(bj_lastCreatedEffect)
	set udg_locations03[18]=GetUnitLoc(GetTriggerUnit())
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=3
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		call CreateNUnitsAtLoc(1, 'nwna', GetOwningPlayer(GetTriggerUnit()), udg_locations03[18], GetRandomReal(( angle - 60.00 ), ( angle + 60.00 )))
		call RemoveLocation(GetUnitLoc(bj_lastCreatedUnit))
		call GroupAddUnit(udg_groups03[5], bj_lastCreatedUnit)
		call GroupAddUnit(udg_groups03[6], bj_lastCreatedUnit)
		call UnitApplyTimedLifeBJ(0.65, 'BTLF', bj_lastCreatedUnit)
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	call RemoveLocation(udg_locations03[18])
	call EnableTrigger(udg_trigger126)
	call TriggerSleepAction(0.50)
	call DisableTrigger(udg_trigger126)
	//call PauseUnit(GetTriggerUnit(),false)
	//call StunUnitTimed(udg_units19[741], udg_RaigaBurialTarget, 2.0)
	call EsnareUnitTimed(udg_units19[741] , udg_RaigaBurialTarget , 2.0)
	call UnitDamageTarget(udg_units19[741], udg_RaigaBurialTarget, GetHeroAgi(udg_units19[741], true) * GetUnitAbilityLevel(udg_units19[741], 'A0WH'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
	call AddStack(udg_units19[741] , udg_RaigaBurialTarget , 1)
	call SetUnitAnimation(udg_RaigaBurialTarget, "death")
	call ForGroupBJ(udg_groups03[6], function Trig_RingoRakurai_Func014A)
	call GroupClear(udg_groups03[5])
	call GroupClear(udg_groups03[6])
endfunction

function Trig_RingoRakurai2_Func001A takes nothing returns nothing
	if udg_RaigaBurialCounter >= udg_RaigaBurialCounterMax then
		set udg_locations03[135]=PolarProjectionBJ(GetUnitLoc(GetEnumUnit()), 150.00, AngleBetweenPoints(GetUnitLoc(GetEnumUnit()), GetUnitLoc(udg_RaigaBurialTarget)))
	else
		set udg_locations03[135]=PolarProjectionBJ(GetUnitLoc(GetEnumUnit()), 150.00, GetRandomReal(( GetUnitFacing(GetEnumUnit()) - 60.00 ), ( GetUnitFacing(GetEnumUnit()) + 60.00 )))
	endif
	call SetUnitPositionLocFacingBJ(GetEnumUnit(), udg_locations03[135], GetUnitFacing(udg_units19[741]))
	call RemoveLocation(udg_locations03[135])
	set udg_locations03[135]=PolarProjectionBJ(GetUnitLoc(GetEnumUnit()), 50.00, GetUnitFacing(GetEnumUnit()))
	call CreateNUnitsAtLoc(1, 'n00F', GetOwningPlayer(GetEnumUnit()), udg_locations03[135], GetRandomReal(0, 360))
	call KillUnit(bj_lastCreatedUnit)
	call RemoveLocation(udg_locations03[135])
endfunction

function Trig_RingoRakurai2_Func002A takes nothing returns nothing
	set udg_locations03[19]=GetUnitLoc(GetEnumUnit())
	call CreateNUnitsAtLoc(1, 'nwna', GetOwningPlayer(GetEnumUnit()), udg_locations03[19], GetRandomReal(( GetUnitFacing(GetEnumUnit()) - 70.00 ), ( GetUnitFacing(GetEnumUnit()) + 70.00 )))
	call GroupAddUnit(udg_groups03[6], bj_lastCreatedUnit)
	call UnitApplyTimedLifeBJ(1.00, 'BTLF', bj_lastCreatedUnit)
	call RemoveLocation(udg_locations03[19])
endfunction

function Trig_RingoRakurai2_Actions takes nothing returns nothing
	set udg_RaigaBurialCounter=udg_RaigaBurialCounter + 1
	call ForGroupBJ(udg_groups03[6], function Trig_RingoRakurai2_Func001A)
	call ForGroupBJ(udg_groups03[5], function Trig_RingoRakurai2_Func002A)
endfunction

