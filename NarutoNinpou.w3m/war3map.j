function Trig_PreventTeleportShoes_Func001C takes nothing returns boolean
	return ( GetSpellAbilityId() == 'A00E' or GetSpellAbilityId() == 'A0RR' or GetSpellAbilityId() == 'A0RS' ) and ( RectContainsUnit(gg_rct_DuelArena, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionB, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionS, GetTriggerUnit()) or RectContainsUnit(gg_rct_KamuiDimensionObito, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionA, GetTriggerUnit()) or RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) or RectContainsUnit(gg_rct_JiroboPrison, GetTriggerUnit()) or RectContainsUnit(gg_rct_KaguyaLavaDimension, GetTriggerUnit()) )
endfunction

function Trig_PreventTeleportShoes_Conditions takes nothing returns boolean
    if ( not (( GetSpellAbilityId() == 'A00E' or GetSpellAbilityId() == 'A0RR' or GetSpellAbilityId() == 'A0RS' ) and ( RectContainsUnit(gg_rct_DuelArena, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionB, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionS, GetTriggerUnit()) or RectContainsUnit(gg_rct_KamuiDimensionObito, GetTriggerUnit()) or RectContainsUnit(gg_rct_MissionA, GetTriggerUnit()) or RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) or RectContainsUnit(gg_rct_JiroboPrison, GetTriggerUnit()) or RectContainsUnit(gg_rct_KaguyaLavaDimension, GetTriggerUnit()) )) ) then // INLINED!!
        return false
    endif
    return true
endfunction

function Trig_PreventTeleportShoes_Actions takes nothing returns nothing
	call IssueImmediateOrder(GetTriggerUnit(), "stop")
endfunction

