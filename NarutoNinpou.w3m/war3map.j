function Trig_NarutoNeedle_Actions takes nothing returns nothing
	if GetUnitTypeId(GetTriggerUnit()) == 'h09U' or GetUnitTypeId(GetTriggerUnit()) == 'h09T' then
		call ShowUnitHide(GetTriggerUnit())
	endif
endfunction

//===========================================================================
function InitTrig_SasoriHideUnits takes nothing returns nothing
	call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function Trig_NarutoNeedle_Actions))) // INLINED!!
endfunction


//===========================================================================
// Trigger: SasukeSetGlobals Copy
//===========================================================================
function Trig_SasukeSetGlobals_Copy_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U00J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SasukeSetGlobals_Copy_Actions takes nothing returns nothing
    set sasuke=GetTriggerUnit()
    call DisableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_SasukeSetGlobals_Copy takes nothing returns nothing
    set gg_trg_SasukeSetGlobals_Copy=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_SasukeSetGlobals_Copy, GetPlayableMapRect())
    call TriggerAddCondition(gg_trg_SasukeSetGlobals_Copy, Condition(function Trig_SasukeSetGlobals_Copy_Conditions))
    call TriggerAddAction(gg_trg_SasukeSetGlobals_Copy, function Trig_SasukeSetGlobals_Copy_Actions)
endfunction

//===========================================================================
// Trigger: SasukeCommandMoveSummon
//===========================================================================

function updateSasuke takes nothing returns nothing
    local location tempLoc= Location(sasukeMouseX, sasukeMouseY)
    if GetUnitCurrentOrder(sasuke) == 0 and metaCtrlDownSasuke and IsUnitAliveBJ(s__sasukeSummon[1]) then
        call IssueImmediateOrder(sasuke, "stop")
    elseif GetUnitCurrentOrder(sasuke) == 851971 and metaCtrlDownSasuke and IsUnitAliveBJ(s__sasukeSummon[1]) then
        call IssuePointOrderLoc(sasuke, "move", tempLoc)
    endif
    call RemoveLocation(tempLoc)
    set tempLoc=null
    call DestroyTimer(GetExpiredTimer())
endfunction

function isRMBPressSasuke takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(sasuke) and IsUnitAliveBJ(s__sasukeSummon[1]) then
        set sasukeMoveTimer=CreateTimer()
        if not metaCtrlDownSasuke then
            set sasukeMouseX=BlzGetTriggerPlayerMouseX()
            set sasukeMouseY=BlzGetTriggerPlayerMouseY()
        endif
        call TimerStart(sasukeMoveTimer, 0.01, true, function updateSasuke)
        if metaCtrlDownSasuke then
            return true
        endif
    endif
    return false
endfunction

function isRMBReleaseSasuke takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(sasuke) and IsUnitAliveBJ(s__sasukeSummon[1]) then
        set sasukeMoveTimer=CreateTimer()
        call TimerStart(sasukeMoveTimer, 0.01, true, function updateSasuke)
        if metaCtrlDownSasuke then
            return true
        endif
    endif
    return false
endfunction

function actionsSasuke takes nothing returns nothing
    local player p= GetTriggerPlayer()
    local integer i= 0
    
    if p == GetOwningPlayer(sasuke) then
        set i=0
        loop
            set i=i + 1
            exitwhen i > 12
        	call IssuePointOrderLocBJ(s__sasukeSummon[i], "move", BlzGetTriggerPlayerMousePosition())
        endloop
    endif
endfunction

function pressCTRLSasuke takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(sasuke) then
        set metaCtrlDownSasuke=true
    endif
endfunction  

function releaseCTRLSasuke takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(sasuke) then
        set metaCtrlDownSasuke=false
    endif
endfunction

//===========================================================================
function InitTrig_SasukeCommandMoveSummon takes nothing returns nothing
    local integer i= 0
    
    loop
    exitwhen ( i > 24 )
        //call TriggerRegisterPlayerMouseEventBJ( rmbClickTriggerSasuke , Player(i), bj_MOUSEEVENTTYPE_DOWN ) 
        call TriggerRegisterPlayerMouseEventBJ(rmbReleaseTriggerSasuke, Player(i), bj_MOUSEEVENTTYPE_UP)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlDownSasukeTriggerSasuke, Player(i), OSKEY_LCONTROL, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlUpTriggerSasuke, Player(i), OSKEY_LCONTROL, 0, false)
        set i=i + 1
    endloop
    
    call TriggerAddCondition(rmbClickTriggerSasuke, Condition(function isRMBPressSasuke))
    call TriggerAddCondition(rmbReleaseTriggerSasuke, Condition(function isRMBReleaseSasuke))
    call TriggerAddAction(rmbClickTriggerSasuke, function actionsSasuke)
