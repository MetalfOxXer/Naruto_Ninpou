        call RegisterSpellEffectEventForId(89 , s__JiroboHeadbutt_SPELL_ID , function s__JiroboHeadbutt_actions)
    endfunction 

//===========================================================================
// Trigger: JiroboCursedSeal
//===========================================================================
function Trig_JiroboCursedSeal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == ( 'A1AO' ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_JiroboCursedSeal_Actions takes nothing returns nothing
    local real x= GetUnitX(GetTriggerUnit())
    local real y= GetUnitY(GetTriggerUnit())
    local real x2
    local real y2
    local integer i
	if GetUnitTypeId(GetTriggerUnit()) == 'H05E' then
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Jirobo_R, 100, GetTriggerUnit())
    endif
	endif
    set i=0
    loop
        exitwhen i > 10
        set x2=(((x )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
        set y2=(((y )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h07D', x2, y2, GetRandomReal(0, 360))
	if GetUnitTypeId(GetTriggerUnit()) == 'H05E' then
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A1AO', false)
        else
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A1AO', true)
	endif
        call SetUnitTimeScale(bj_lastCreatedUnit, 0.3)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        set i=i + 1
    endloop
endfunction

//===========================================================================
function InitTrig_JiroboCursedSeal takes nothing returns nothing
    set gg_trg_JiroboCursedSeal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_JiroboCursedSeal, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_JiroboCursedSeal, Condition(function Trig_JiroboCursedSeal_Conditions))
    call TriggerAddAction(gg_trg_JiroboCursedSeal, function Trig_JiroboCursedSeal_Actions)
endfunction


