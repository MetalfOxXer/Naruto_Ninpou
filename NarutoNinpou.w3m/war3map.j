        endfunction

    function s__KurenaiInvisibility_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= (((s__KurenaiInvisibility_previous_x[this] )*1.0) + Cos((( Deg2Rad(- 90) )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real y= (((s__KurenaiInvisibility_previous_y[this] )*1.0) + Sin((( Deg2Rad(- 90) )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_x= (((s__KurenaiInvisibility_previous_x[this] )*1.0) + Cos((( Deg2Rad(90) )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_y= (((s__KurenaiInvisibility_previous_y[this] )*1.0) + Sin((( Deg2Rad(90) )*1.0)) * (( 50)*1.0)) // INLINED!!
        local integer i= 0
        set s__KurenaiInvisibility_count[this]=s__KurenaiInvisibility_count[this] + 1
        if s__KurenaiInvisibility_previous_x[this] != GetUnitX(s__KurenaiInvisibility_caster[this]) or s__KurenaiInvisibility_previous_y[this] != GetUnitY(s__KurenaiInvisibility_caster[this]) and GetUnitAbilityLevel(s__KurenaiInvisibility_caster[this], 'B01Q') > 0 then
            if ModuloInteger(s__KurenaiInvisibility_count[this], 3) == 0 then
                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", x, y)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__KurenaiInvisibility_caster[this])))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", new_x, new_y)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__KurenaiInvisibility_caster[this])))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
                set s__KurenaiInvisibility_previous_x[this]=GetUnitX(s__KurenaiInvisibility_caster[this])
                set s__KurenaiInvisibility_previous_y[this]=GetUnitY(s__KurenaiInvisibility_caster[this])
            endif
        endif
        if s__KurenaiInvisibility_count[this] > 49 then
            call SetHeroInt(s__KurenaiInvisibility_caster[this], GetHeroInt(s__KurenaiInvisibility_caster[this], false) - s__KurenaiInvisibility_stat[this], false)
            call s__KurenaiInvisibility_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KurenaiInvisibility_actions takes nothing returns nothing
        local integer this= s__KurenaiInvisibility_allocate()
        set s__KurenaiInvisibility_caster[this]=GetTriggerUnit()
        set s__KurenaiInvisibility_count[this]=0
        set s__KurenaiInvisibility_previous_x[this]=GetUnitX(s__KurenaiInvisibility_caster[this])
        set s__KurenaiInvisibility_previous_y[this]=GetUnitY(s__KurenaiInvisibility_caster[this])
        set s__KurenaiInvisibility_stat[this]=GetHeroLevel(s__KurenaiInvisibility_caster[this])
        call SetHeroInt(s__KurenaiInvisibility_caster[this], GetHeroInt(s__KurenaiInvisibility_caster[this], false) + s__KurenaiInvisibility_stat[this], false)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__KurenaiInvisibility_periodic)
    endfunction 
    
    function s__KurenaiInvisibility_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(63 , s__KurenaiInvisibility_SPELL_ID , function s__KurenaiInvisibility_actions)
    endfunction 
    
