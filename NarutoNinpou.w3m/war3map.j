	set TayuyaCore_W2Angle=Atan3(GetUnitX(TayuyaCore_Tayuya) , GetUnitY(TayuyaCore_Tayuya) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(TayuyaCore_Tayuya)))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(TayuyaCore_Tayuya)))])) // INLINED!!
        call SetUnitFacingTimed(TayuyaCore_Tayuya, Rad2Deg(TayuyaCore_W2Angle), 0)
    
	set TayuyaCore_IsAttacking=false
	set TayuyaCore_PuppetTarget=null
        
        call SetUnitPosition(s__TayuyaRecall_puppet[this], new_x, new_y)
	call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__TayuyaRecall_puppet[this]) )*1.0), (( GetUnitY(s__TayuyaRecall_puppet[this]))*1.0))) // INLINED!!
    endfunction
    
