            set i=CTL___ic + 1
            set CTL___ic=i
        else
            set i=CTL___n[0]
            set CTL___n[0]=CTL___n[i]
        endif
        set CTL___th[i]=r
        set CTL___ns[i]=- 1
        set f=CTL___rf[r]
        if ( 0 == f ) then
            set CTL___n[i]=0
            set CTL___p[i]=0
            set CTL___rf[r]=i
            set CTL___ct[r]=TriggerAddCondition(CTL___t, CTL___rc[r])
            //set ct[r] = null
            if ( 0 == CTL___tc ) then
                call TimerStart(CTL___m, .031250000, true, function CTL___E)
            endif
            set CTL___tc=CTL___tc + 1
        else
            set CTL___n[i]=f
            set CTL___p[i]=0
            set CTL___p[f]=i
            set CTL___rf[r]=i
        endif
        return i
    endfunction
function CTL___DT takes integer l__CTL___t returns nothing
            set CTL___ns[l__CTL___t]=CTL___ns[0]
