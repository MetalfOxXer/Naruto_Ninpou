        endif
    endfunction
    
    function s__KurenaiSemi_pause takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__KurenaiSemi_dummy[this]=CreateUnit(GetOwningPlayer(s__KurenaiSemi_caster[this]), 'h08E', GetUnitX(s__KurenaiSemi_tree[this]), GetUnitY(s__KurenaiSemi_tree[this]), GetUnitFacing(s__KurenaiSemi_tree[this]))
        call SetUnitX(s__KurenaiSemi_dummy[this], GetUnitX(s__KurenaiSemi_tree[this]))
        call SetUnitY(s__KurenaiSemi_dummy[this], GetUnitY(s__KurenaiSemi_tree[this]))
        call SetUnitVertexColor((s__KurenaiSemi_dummy[this] ), ( 255 ), ( 255 ), ( 255 ), ( 0)) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KurenaiSemi_appear)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

 function s__KurenaiSemi_grow takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		//call SetUnitScale(this.tree, 0.08 * this.count2, 0, 0)
		set s__KurenaiSemi_count2[this]=s__KurenaiSemi_count2[this] + 1
		if s__KurenaiSemi_count2[this] >= 16 then
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction
    
    function s__KurenaiSemi_disappear takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real new_x
        local real new_y
        local real x
        local real y
        local real caster_x= GetUnitX(s__KurenaiSemi_caster[this])
        local real caster_y= GetUnitY(s__KurenaiSemi_caster[this])
        local real angle
        local real offset
        local integer i
        set s__KurenaiSemi_count[this]=s__KurenaiSemi_count[this] + 1
        call SetUnitVertexColor((s__KurenaiSemi_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255 - 30 * s__KurenaiSemi_count[this])) // INLINED!!
        if s__KurenaiSemi_count[this] > 8 then
            set s__KurenaiSemi_count[this]=0
            set angle=Atan3(GetUnitX(s__KurenaiSemi_caster[this]) , GetUnitY(s__KurenaiSemi_caster[this]) , GetUnitX(s__KurenaiSemi_target[this]) , GetUnitY(s__KurenaiSemi_target[this]))
            set x=(((GetUnitX(s__KurenaiSemi_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 150.0)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__KurenaiSemi_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 150.0)*1.0)) // INLINED!!
            set s__KurenaiSemi_tree[this]=CreateUnit(GetOwningPlayer(s__KurenaiSemi_caster[this]), 'h03R', x, y, Rad2Deg(angle + bj_PI))
	    //call SetUnitScale(this.tree, 0, 0, 0)
	    set s__KurenaiSemi_count2[this]=0
	    call TimerStart(NewTimerEx(this), 0.03, true, function s__KurenaiSemi_grow)
            call ShowUnit(s__KurenaiSemi_caster[this], false)
            set i=0
            loop
                exitwhen i > 5
                set angle=Deg2Rad(60 * i)
                set offset=300
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KurenaiSemi_caster[this]), 'z007', new_x, new_y, 24 * i)
                call SetUnitScale(bj_lastCreatedUnit, 4.0, 0, 0)
                call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 200)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.1)
                //call AddSpecialEffectEx("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl", new_x, new_y)
                set i=i + 1
            endloop
            call TimerStart(NewTimerEx(this), 0.5, false, function s__KurenaiSemi_pause)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KurenaiSemi_actions takes nothing returns nothing
        local integer this= s__KurenaiSemi_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Kurenai_T, 80.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Kurenai: You can't escape my genjutsu!|r")
        endif
        set s__KurenaiSemi_caster[this]=GetTriggerUnit()
        set s__KurenaiSemi_target[this]=GetSpellTargetUnit()
        call PauseUnit(s__KurenaiSemi_caster[this], true)
        call PauseUnit(s__KurenaiSemi_target[this], true)
        //call SetUnitInvulnerable(this.caster, true) 
        set s__KurenaiSemi_count[this]=0
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Pink_Wind.mdx" ), (( GetUnitX(s__KurenaiSemi_caster[this]) )*1.0), (( GetUnitY(s__KurenaiSemi_caster[this]))*1.0))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KurenaiSemi_disappear)
    endfunction
    
    function s__KurenaiSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(63 , s__KurenaiSemi_SPELL_ID , function s__KurenaiSemi_actions)
    endfunction
    
