    //private static boolean picked = false 
    
    function s__ItachiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__ItachiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__ItachiUltimateChoice_caster[this]), 'A0CQ', false)
        else
            call s__ItachiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ItachiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__ItachiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__ItachiUltimateChoice_u, s__ItachiUltimateChoice_SUSANOO)
            call UnitMakeAbilityPermanent(s__ItachiUltimateChoice_u, true, s__ItachiUltimateChoice_SUSANOO)
        else
            call UnitAddAbility(s__ItachiUltimateChoice_u, s__ItachiUltimateChoice_AMATERASU)
            call UnitMakeAbilityPermanent(s__ItachiUltimateChoice_u, true, s__ItachiUltimateChoice_AMATERASU)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0CQ', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0CQ', false)
        set s__s__ItachiUltimateChoice_b[0]= null
        set s__s__ItachiUltimateChoice_b[1]= null
        set s__ItachiUltimateChoice_u=null
        call s__Dialog_destroy(s__ItachiUltimateChoice_d)
        call DestroyBoolExpr(s__ItachiUltimateChoice_pick)
        set s__ItachiUltimateChoice_pick=null
        set this=s__ItachiUltimateChoice_allocate()
        set s__ItachiUltimateChoice_caster[this]=s__ItachiUltimateChoice_u
        set s__ItachiUltimateChoice_pp[this]=GetOwningPlayer(s__ItachiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__ItachiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__ItachiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__ItachiUltimateChoice_SUSANOO) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__ItachiUltimateChoice_AMATERASU) == 0 then
            set s__ItachiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__ItachiUltimateChoice_d,"Pick a skill")
            set s__s__ItachiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__ItachiUltimateChoice_d)], ("Susano'o" ), ( 0))) // INLINED!!
            set s__s__ItachiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__ItachiUltimateChoice_d)], ("Amaterasu" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__ItachiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__ItachiUltimateChoice_d,s__ItachiUltimateChoice_pick)
            set s__ItachiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__ItachiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0CQ' then
            set s__ItachiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__ItachiUltimateChoice_onInit takes nothing returns nothing
        set s__ItachiUltimateChoice_pick=Condition(function s__ItachiUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__ItachiUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0CQ' ) , Filter(( function s__ItachiUltimateChoice_actions))) // INLINED!!
    endfunction 
    
