        endfunction
    function s__SaiNewSemi_damagefix takes nothing returns boolean
	if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__SaiNewSemi_caster[s__SaiNewSemi_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
		//call AddSpecialEffectEx("war3mapImported\\slam.mdx", GetUnitX(GetFilterUnit()), GetUnitY(GetFilterUnit()))
		if GetHeroLevel(s__SaiNewSemi_caster[s__SaiNewSemi_instance]) >= 15 then
                	call UnitDamageTarget(s__SaiNewSemi_caster[s__SaiNewSemi_instance], GetFilterUnit(), 2.0 * GetHeroAgi(s__SaiNewSemi_caster[s__SaiNewSemi_instance], true) + 700 * 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		else
			call UnitDamageTarget(s__SaiNewSemi_caster[s__SaiNewSemi_instance], GetFilterUnit(), 2.0 * GetHeroAgi(s__SaiNewSemi_caster[s__SaiNewSemi_instance], true) + 700 * GetUnitAbilityLevel(s__SaiNewSemi_caster[s__SaiNewSemi_instance], 'A1E7'), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		endif
	       endif
	return false
    endfunction
    
    function s__SaiNewSemi_run takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SaiNewSemi_dog[this])
        local real y= GetUnitY(s__SaiNewSemi_dog[this])
        local real angle= Atan3(x , y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30.0)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30.0)*1.0)) // INLINED!!
        local real offset
        local integer i
        call SetUnitX(s__SaiNewSemi_dog[this], new_x)
        call SetUnitY(s__SaiNewSemi_dog[this], new_y)
        call SetUnitFacing(s__SaiNewSemi_dog[this], Rad2Deg(angle))
        if GetDistance(new_x , new_y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this]) < 5000 then
            //call PauseUnit(this.target, false)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SaiNewSemi_caster[this]), 'ucs3', s__SaiNewSemi_target_x[this], s__SaiNewSemi_target_y[this], 270.0)
            call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SaiNewSemi_caster[this]), 'ucs3', GetUnitX(s__SaiNewSemi_statue1[this]), GetUnitY(s__SaiNewSemi_statue1[this]), 270.0)
            call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SaiNewSemi_caster[this]), 'ucs3', GetUnitX(s__SaiNewSemi_statue2[this]), GetUnitY(s__SaiNewSemi_statue2[this]), 270.0)
            call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            
            //set bj_lastCreatedUnit = CreateAbilityDummy(this.caster, 'A0UR')
            //call IssueTargetOrder(bj_lastCreatedUnit, "soulburn", this.target)
            
            call KillUnit(s__SaiNewSemi_dog[this])
            call ShowUnit(s__SaiNewSemi_dog[this], false)
            set s__SaiNewSemi_dog[this]=null
            call KillUnit(s__SaiNewSemi_statue1[this])
            call ShowUnit(s__SaiNewSemi_statue1[this], false)
            call KillUnit(s__SaiNewSemi_statue2[this])
            call ShowUnit(s__SaiNewSemi_statue2[this], false)
            call KillUnit(s__SaiNewSemi_dummy[this])
            set s__SaiNewSemi_statue1[this]=null
            set s__SaiNewSemi_statue2[this]=null
            call s__SaiNewSemi_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SaiNewSemi_cast takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        local real offset= GetRandomReal(75, 200)
        local real angle= Deg2Rad(GetRandomReal(0, 360))
        local real x= (((GetUnitX(u) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real y= (((GetUnitY(u) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        //call IssuePointOrder(u, "clusterrockets", x, y)
        set u=null
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SaiNewSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SaiNewSemi_dummy[this])
        local real y= GetUnitY(s__SaiNewSemi_dummy[this])
        local real angle= Atan3(x , y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real statue1_x= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(s__SaiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue1_y= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(s__SaiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue1_x2= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(( s__SaiNewSemi_count[this] + 1 ) * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue1_y2= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(( s__SaiNewSemi_count[this] + 1 ) * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue2_x= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + s__SaiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue2_y= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + s__SaiNewSemi_count[this] * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue2_x2= (((new_x )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + ( s__SaiNewSemi_count[this] + 1 ) * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue2_y2= (((new_y )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( Cos(Deg2Rad(180 + ( s__SaiNewSemi_count[this] + 1 ) * 7)) * 200.0)*1.0)) // INLINED!!
        local real statue1_angle= Atan3(statue1_x , statue1_y , statue1_x2 , statue1_y2)
        local real statue2_angle= Atan3(statue2_x , statue2_y , statue2_x2 , statue2_y2)
        local real offset
        local integer i
        call SetUnitX(s__SaiNewSemi_dummy[this], new_x)
        call SetUnitY(s__SaiNewSemi_dummy[this], new_y)
        if s__SaiNewSemi_attack[this] then
            set angle=Atan3(GetUnitX(s__SaiNewSemi_statue1[this]) , GetUnitY(s__SaiNewSemi_statue1[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])
            set statue1_x=(((GetUnitX(s__SaiNewSemi_statue1[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            set statue1_y=(((GetUnitY(s__SaiNewSemi_statue1[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        endif
        call SetUnitX(s__SaiNewSemi_statue1[this], statue1_x)
        call SetUnitY(s__SaiNewSemi_statue1[this], statue1_y)
        call SetUnitFacing(s__SaiNewSemi_statue1[this], Rad2Deg(Atan3(GetUnitX(s__SaiNewSemi_statue1[this]) , GetUnitY(s__SaiNewSemi_statue1[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])))
        if s__SaiNewSemi_attack[this] then
            set angle=Atan3(GetUnitX(s__SaiNewSemi_statue2[this]) , GetUnitY(s__SaiNewSemi_statue2[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])
            set statue2_x=(((GetUnitX(s__SaiNewSemi_statue2[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
            set statue2_y=(((GetUnitY(s__SaiNewSemi_statue2[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        endif
        call SetUnitX(s__SaiNewSemi_statue2[this], statue2_x)
        call SetUnitY(s__SaiNewSemi_statue2[this], statue2_y)
        call SetUnitFacing(s__SaiNewSemi_statue2[this], Rad2Deg(Atan3(GetUnitX(s__SaiNewSemi_statue2[this]) , GetUnitY(s__SaiNewSemi_statue2[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])))
        
        set s__SaiNewSemi_count[this]=s__SaiNewSemi_count[this] + 1
        if GetDistance(new_x , new_y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this]) < 100 then
            if not s__SaiNewSemi_attack[this] then
                call SetUnitAnimation(s__SaiNewSemi_statue1[this], "attack")
                call SetUnitAnimation(s__SaiNewSemi_statue2[this], "attack")
                call SetUnitFacing(s__SaiNewSemi_statue1[this], Rad2Deg(Atan3(GetUnitX(s__SaiNewSemi_statue1[this]) , GetUnitY(s__SaiNewSemi_statue1[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])))
                call SetUnitFacing(s__SaiNewSemi_statue2[this], Rad2Deg(Atan3(GetUnitX(s__SaiNewSemi_statue2[this]) , GetUnitY(s__SaiNewSemi_statue2[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])))
                //call SetUnitFacingToFaceUnitTimed(this.statue1, this.target, 0.3)
                //call SetUnitFacingToFaceUnitTimed(this.statue2, this.target, 0.3)
                //call SetUnitFacing(this.statue1, Rad2Deg(statue1_angle))
                //call SetUnitFacing(this.statue2, Rad2Deg(statue2_angle)) 
                set s__SaiNewSemi_attack[this]=true
            endif
            if GetDistance(statue1_x , statue1_y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this]) < 100 and GetDistance(statue2_x , statue2_y , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this]) < 100 then
                set bj_lastCreatedGroup=CreateGroup()
		set s__SaiNewSemi_instance=this
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__SaiNewSemi_target_x[this], s__SaiNewSemi_target_y[this], 300, Filter(function s__SaiNewSemi_damagefix))
                loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)

		endloop
                call SlowArea(s__SaiNewSemi_caster[this] , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this] , 300)
		//call AddSpecialEffectEx("war3mapImported\\slam.mdx", this.target_x, this.target_y)
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack.mdx" ), (( s__SaiNewSemi_target_x[this] )*1.0), (( s__SaiNewSemi_target_y[this])*1.0))) // INLINED!!
                set x=s__SaiNewSemi_target_x[this]
                set y=s__SaiNewSemi_target_y[this]
                
                
                //set this.dummy = null 
                //call PauseUnit(this.target, true)
                //call EsnareUnitTimed(this.caster, this.target, 4.0)
                call SetUnitAnimation(s__SaiNewSemi_caster[this], "spell slam")
                set angle=Atan3(GetUnitX(s__SaiNewSemi_caster[this]) , GetUnitY(s__SaiNewSemi_caster[this]) , s__SaiNewSemi_target_x[this] , s__SaiNewSemi_target_y[this])
                set new_x=(((GetUnitX(s__SaiNewSemi_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100.0)*1.0)) // INLINED!!
                set new_y=(((GetUnitY(s__SaiNewSemi_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100.0)*1.0)) // INLINED!!
                //set this.dog = CreateUnit(GetOwningPlayer(this.caster), 'e03O', new_x, new_y, Rad2Deg(angle))
                set s__SaiNewSemi_dog[this]=CreateUnit(GetOwningPlayer(s__SaiNewSemi_caster[this]), 'e007', new_x, new_y, Rad2Deg(angle))
                if IsUnitVisible(s__SaiNewSemi_caster[this], GetLocalPlayer()) then
                    call PlaySoundOnUnitBJ(gg_snd_BattleRoar, 100.0, s__SaiNewSemi_dog[this])
                endif
                call AddSpecialEffectTargetUnitBJ("overhead", s__SaiNewSemi_dog[this], "Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl")
                call SetUnitTimeScale(s__SaiNewSemi_dog[this], 2.0)
                call SetUnitAnimationByIndex(s__SaiNewSemi_dog[this], 1)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__SaiNewSemi_run)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 
    
    function s__SaiNewSemi_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitAnimationByIndex(s__SaiNewSemi_statue1[this], 3)
        call SetUnitAnimationByIndex(s__SaiNewSemi_statue2[this], 3)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__SaiNewSemi_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SaiNewSemi_actions takes nothing returns nothing
        local integer this= s__SaiNewSemi_allocate()
        local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
        local real x1= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
        local real y1= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
        local real x2= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle + Deg2Rad(90) )*1.0)) * (( - 200.0)*1.0)) // INLINED!!
        local real y2= (((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle + Deg2Rad(90) )*1.0)) * (( - 200.0)*1.0)) // INLINED!!
        set s__SaiNewSemi_caster[this]=GetTriggerUnit()
        set s__SaiNewSemi_target_x[this]=GetSpellTargetX()
        set s__SaiNewSemi_target_y[this]=GetSpellTargetY()
        set s__SaiNewSemi_statue1[this]=CreateUnit(GetTriggerPlayer(), 'e03N', x1, y1, Rad2Deg(angle))
        call SetUnitTimeScale(s__SaiNewSemi_statue1[this], 4.0)
        call SetUnitAnimation(s__SaiNewSemi_statue1[this], "birth")
        call AddSpecialEffectTargetUnitBJ("chest", s__SaiNewSemi_statue1[this], "Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl")
        set s__SaiNewSemi_statue2[this]=CreateUnit(GetTriggerPlayer(), 'e03N', x2, y2, Rad2Deg(angle))
        call SetUnitTimeScale(s__SaiNewSemi_statue2[this], 4.0)
        call SetUnitAnimation(s__SaiNewSemi_statue2[this], "birth")
        call AddSpecialEffectTargetUnitBJ("chest", s__SaiNewSemi_statue2[this], "Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl")
        set s__SaiNewSemi_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0)
        set s__SaiNewSemi_count[this]=0
        set s__SaiNewSemi_attack[this]=false
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Sai_R, 100.0, s__SaiNewSemi_caster[this])
        endif
        
        call TimerStart(NewTimerEx(this), 0.25, false, function s__SaiNewSemi_delay)
    endfunction 
    
    function s__SaiNewSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(20 , s__SaiNewSemi_SPELL_ID , function s__SaiNewSemi_actions)
    endfunction 
    
//===========================================================================
// Trigger: SaiDragon
//===========================================================================

//Implemented from module Alloc:
    
        function s__SaiDragon_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SaiDragon_Alloc___recycle[(0)] == 0 ) then
                set s__SaiDragon_Alloc___instanceCount=s__SaiDragon_Alloc___instanceCount + 1
                set this=s__SaiDragon_Alloc___instanceCount
            else
                set this=s__SaiDragon_Alloc___recycle[(0)]
                set s__SaiDragon_Alloc___recycle[(0)]=s__SaiDragon_Alloc___recycle[s__SaiDragon_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SaiDragon_deallocate takes integer this returns nothing
            set s__SaiDragon_Alloc___recycle[this]=s__SaiDragon_Alloc___recycle[(0)]
            set s__SaiDragon_Alloc___recycle[(0)]=this
        endfunction

    function s__SaiDragon_damagefix takes nothing returns boolean
	if GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__SaiDragon_caster[s__SaiDragon_instance])) then
                call UnitDamageTarget(s__SaiDragon_caster[s__SaiDragon_instance], GetFilterUnit(), 10 * GetHeroAgi(s__SaiDragon_caster[s__SaiDragon_instance], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
	return false
    endfunction
    
    function s__SaiDragon_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local integer j
        local real x
        local real y
	call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack Big.mdx" ), (( s__SaiDragon_target_x[this] )*1.0), (( s__SaiDragon_target_y[this])*1.0))) // INLINED!!
	set bj_lastCreatedEffect=AddSpecialEffect("DustWave.mdx", s__SaiDragon_target_x[this], s__SaiDragon_target_y[this])
	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
	call DestroyEffect(bj_lastCreatedEffect)
        set i=1
        loop
            exitwhen i > 5
            set j=0
            loop
                exitwhen j > 5
                set x=(((s__SaiDragon_target_x[this] )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                set y=(((s__SaiDragon_target_y[this] )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                //call AddSpecialEffectEx("war3mapImported\\slam.mdx", x, y)
                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SaiDragon_caster[this]), 'ucs3', x, y, GetRandomReal(0, 360))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
                set j=j + 1
            endloop
            set i=i + 1
        endloop
    	call BlzSetSpecialEffectX(s__SaiDragon_dragon[this], 9700.0)
    	call BlzSetSpecialEffectY(s__SaiDragon_dragon[this], 6700.0)
	call DestroyEffect(s__SaiDragon_dragon[this])
        //call ShowUnit(this.dragon, false) 
        set bj_lastCreatedGroup=CreateGroup()
	set s__SaiDragon_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__SaiDragon_target_x[this], s__SaiDragon_target_y[this], 500, Filter(function s__SaiDragon_damagefix))
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call s__SaiDragon_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
 function s__SaiDragon_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__SaiDragon_count[this]=s__SaiDragon_count[this] + 1
		call BlzSetSpecialEffectHeight(s__SaiDragon_dragon[this], 1200 - 1200 / 50.0 * s__SaiDragon_count[this])
		if s__SaiDragon_count[this] >= 40 then
			
       		 call TimerStart(NewTimerEx(this), 0.01, false, function s__SaiDragon_damage)
		call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

    function s__SaiDragon_actions takes nothing returns nothing
        local integer this= s__SaiDragon_allocate()
        set s__SaiDragon_caster[this]=GetTriggerUnit()
        set s__SaiDragon_target_x[this]=GetSpellTargetX()
        set s__SaiDragon_target_y[this]=GetSpellTargetY()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Sai_T, 100.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Sai: A smile is enough to take control of this situation...|r")
        endif
	set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\ChineseDragon.mdl", s__SaiDragon_target_x[this], s__SaiDragon_target_y[this])
	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 1200.0)
	call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, 1.57)
    	call BlzPlaySpecialEffect(bj_lastCreatedEffect, ANIM_TYPE_WALK)
	set s__SaiDragon_dragon[this]=bj_lastCreatedEffect
	set s__SaiDragon_count[this]=0
	call TimerStart(NewTimerEx(this), 0.03, true, function s__SaiDragon_periodic)
    endfunction 
    
    function s__SaiDragon_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(20 , s__SaiDragon_SPELL_ID , function s__SaiDragon_actions)
    endfunction 
    

//===========================================================================
// Trigger: SaiInkDie
//===========================================================================


 function s__SaiInkDie_dies takes nothing returns nothing
		if ( ( ( ( GetUnitTypeId(GetTriggerUnit()) == 'ucry' ) ) or ( ( GetUnitTypeId(GetTriggerUnit()) == 'ugar' ) ) or ( ( GetUnitTypeId(GetTriggerUnit()) == 'unec' ) ) or ( ( GetUnitTypeId(GetTriggerUnit()) == 'nsw1' ) ) or ( ( GetUnitTypeId(GetTriggerUnit()) == 'ntrh' ) ) ) ) then
			set udg_locations03[33]=GetUnitLoc(GetTriggerUnit())
