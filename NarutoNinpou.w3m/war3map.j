//===========================================================================
//textmacro instance: UltimateChoice("Tobirama", "A0RH", "A10H", "KIBAKUFUDA", "Gojou Kibaku Fuda", "A1D4", "SUISHOHA", "Suiton: Suishoha")

//Implemented from module Alloc:
    
        function s__TobiramaUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__TobiramaUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__TobiramaUltimateChoice_Alloc___instanceCount=s__TobiramaUltimateChoice_Alloc___instanceCount + 1
                set this=s__TobiramaUltimateChoice_Alloc___instanceCount
            else
                set this=s__TobiramaUltimateChoice_Alloc___recycle[(0)]
                set s__TobiramaUltimateChoice_Alloc___recycle[(0)]=s__TobiramaUltimateChoice_Alloc___recycle[s__TobiramaUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__TobiramaUltimateChoice_deallocate takes integer this returns nothing
            set s__TobiramaUltimateChoice_Alloc___recycle[this]=s__TobiramaUltimateChoice_Alloc___recycle[(0)]
            set s__TobiramaUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__TobiramaUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__TobiramaUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__TobiramaUltimateChoice_caster[this]), 'A0RH', false)
        else
            call s__TobiramaUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__TobiramaUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__TobiramaUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__TobiramaUltimateChoice_u, s__TobiramaUltimateChoice_KIBAKUFUDA)
            call UnitMakeAbilityPermanent(s__TobiramaUltimateChoice_u, true, s__TobiramaUltimateChoice_KIBAKUFUDA)
        else
            call UnitAddAbility(s__TobiramaUltimateChoice_u, s__TobiramaUltimateChoice_SUISHOHA)
            call UnitMakeAbilityPermanent(s__TobiramaUltimateChoice_u, true, s__TobiramaUltimateChoice_SUISHOHA)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0RH', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0RH', false)
        set s__s__TobiramaUltimateChoice_b[0]= null
        set s__s__TobiramaUltimateChoice_b[1]= null
        set s__TobiramaUltimateChoice_u=null
        call s__Dialog_destroy(s__TobiramaUltimateChoice_d)
        call DestroyBoolExpr(s__TobiramaUltimateChoice_pick)
        set s__TobiramaUltimateChoice_pick=null
        set this=s__TobiramaUltimateChoice_allocate()
        set s__TobiramaUltimateChoice_caster[this]=s__TobiramaUltimateChoice_u
        set s__TobiramaUltimateChoice_pp[this]=GetOwningPlayer(s__TobiramaUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__TobiramaUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__TobiramaUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__TobiramaUltimateChoice_KIBAKUFUDA) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__TobiramaUltimateChoice_SUISHOHA) == 0 then
            set s__TobiramaUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__TobiramaUltimateChoice_d,"Pick a skill")
            set s__s__TobiramaUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__TobiramaUltimateChoice_d)], ("Gojou Kibaku Fuda" ), ( 0))) // INLINED!!
            set s__s__TobiramaUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__TobiramaUltimateChoice_d)], ("Suiton: Suishoha" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__TobiramaUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__TobiramaUltimateChoice_d,s__TobiramaUltimateChoice_pick)
            set s__TobiramaUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__TobiramaUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0RH' then
            set s__TobiramaUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__TobiramaUltimateChoice_onInit takes nothing returns nothing
        set s__TobiramaUltimateChoice_pick=Condition(function s__TobiramaUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__TobiramaUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0RH' ) , Filter(( function s__TobiramaUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Tobirama", "A0RH", "A10H", "KIBAKUFUDA", "Gojou Kibaku Fuda", "A1D4", "SUISHOHA", "Suiton: Suishoha")

