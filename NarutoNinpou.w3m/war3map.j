 function s__SasukeDragonFlame_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__SasukeDragonFlame_dummy[this])
  local real y= GetUnitY(s__SasukeDragonFlame_dummy[this])
  local real new_x= (((x )*1.0) + Cos((( s__SasukeDragonFlame_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__SasukeDragonFlame_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real h
  local integer i= 0
  local group g
		set bj_lastCreatedGroup=CreateGroup()
		call GroupAddGroup(s__SasukeDragonFlame_katon[this], bj_lastCreatedGroup)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			set i=i + 1
			if i == 1 then
				set x=(((new_x )*1.0) + Cos((( s__SasukeDragonFlame_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(150 , 1600 , 25 * s__SasukeDragonFlame_count[this]))*1.0)) // INLINED!!
				set y=(((new_y )*1.0) + Sin((( s__SasukeDragonFlame_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(150 , 1600 , 25 * s__SasukeDragonFlame_count[this]))*1.0)) // INLINED!!
				set h=ParabolaZ(50 , 800 , 25 * s__SasukeDragonFlame_count[this])
			elseif i == 2 then
				set x=new_x
				set y=new_y
				set h=ParabolaZ(70 , 800 , 25 * s__SasukeDragonFlame_count[this])
			elseif i == 3 then
				set x=(((new_x )*1.0) + Cos((( s__SasukeDragonFlame_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(150 , 1600 , 25 * s__SasukeDragonFlame_count[this]))*1.0)) // INLINED!!
				set y=(((new_y )*1.0) + Sin((( s__SasukeDragonFlame_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(150 , 1600 , 25 * s__SasukeDragonFlame_count[this]))*1.0)) // INLINED!!
				set h=ParabolaZ(50 , 800 , 25 * s__SasukeDragonFlame_count[this])
			endif
			call SetUnitX(bj_lastCreatedUnit, x)
			call SetUnitY(bj_lastCreatedUnit, y)
			set g=CreateGroup()
			call GroupEnumUnitsInRange(g, x, y, 110, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(g)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(g, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasukeDragonFlame_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__SasukeDragonFlame_damaged[this]) then
					call UnitDamageTarget(s__SasukeDragonFlame_caster[this], bj_lastCreatedUnit, ( 45 + GetHeroAgi(s__SasukeDragonFlame_caster[this], true) / 2 ) * GetUnitAbilityLevel(s__SasukeDragonFlame_caster[this], s__SasukeDragonFlame_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					call GroupAddUnit(s__SasukeDragonFlame_damaged[this], bj_lastCreatedUnit)
					set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
					call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
					call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.7)
					call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 70 + GetPointZ(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit)))
					call DestroyEffect(bj_lastCreatedEffect)
				endif
			endloop
			call DestroyGroup(g)
			set g=null
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		call SetUnitX(s__SasukeDragonFlame_dummy[this], new_x)
		call SetUnitY(s__SasukeDragonFlame_dummy[this], new_y)
		call SetUnitX(s__SasukeDragonFlame_shuriken[this], new_x)
		call SetUnitY(s__SasukeDragonFlame_shuriken[this], new_y)
		set s__SasukeDragonFlame_count[this]=s__SasukeDragonFlame_count[this] + 1
		if s__SasukeDragonFlame_count[this] > 30 then
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__SasukeDragonFlame_katon[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__SasukeDragonFlame_katon[this], bj_lastCreatedUnit)
				call KillUnit(bj_lastCreatedUnit)
			endloop
			call DestroyGroup(s__SasukeDragonFlame_katon[this])
			call DestroyGroup(s__SasukeDragonFlame_damaged[this])
			set s__SasukeDragonFlame_damaged[this]=null
			set s__SasukeDragonFlame_katon[this]=null
			call KillUnit(s__SasukeDragonFlame_dummy[this])
			set s__SasukeDragonFlame_dummy[this]=null
			call KillUnit(s__SasukeDragonFlame_shuriken[this])
			set s__SasukeDragonFlame_shuriken[this]=null
			call s__SasukeDragonFlame_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__SasukeDragonFlame_actions takes nothing returns nothing
  local integer this= s__SasukeDragonFlame_allocate()
  local integer i= 0
  local real x
  local real y
		set s__SasukeDragonFlame_caster[this]=GetTriggerUnit()
		set s__SasukeDragonFlame_count[this]=0
		set s__SasukeDragonFlame_angle[this]=Atan3(GetUnitX(s__SasukeDragonFlame_caster[this]) , GetUnitY(s__SasukeDragonFlame_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
		set s__SasukeDragonFlame_katon[this]=CreateGroup()
		set s__SasukeDragonFlame_damaged[this]=CreateGroup()
		set s__SasukeDragonFlame_dummy[this]=CreateUnit(GetTriggerPlayer(), 'h062', GetUnitX(s__SasukeDragonFlame_caster[this]), GetUnitY(s__SasukeDragonFlame_caster[this]), Rad2Deg(s__SasukeDragonFlame_angle[this]))
		set s__SasukeDragonFlame_shuriken[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__SasukeDragonFlame_caster[this]), GetUnitY(s__SasukeDragonFlame_caster[this]), Rad2Deg(s__SasukeDragonFlame_angle[this]))
		call SetUnitAnimation(s__SasukeDragonFlame_caster[this], "Spell 2")
		set x=(((GetUnitX(s__SasukeDragonFlame_caster[this]) )*1.0) + Cos((( s__SasukeDragonFlame_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
		set y=(((GetUnitY(s__SasukeDragonFlame_caster[this]) )*1.0) + Sin((( s__SasukeDragonFlame_angle[this] )*1.0)) * (( 100)*1.0)) // INLINED!!
		loop
			set i=i + 1
			exitwhen i > 3
			set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h062', x, y, Rad2Deg(s__SasukeDragonFlame_angle[this]))
			call GroupAddUnit(s__SasukeDragonFlame_katon[this], bj_lastCreatedUnit)
		endloop
		call TimerStart(NewTimerEx(this), 0.03, true, function s__SasukeDragonFlame_periodic)
 endfunction 

 function s__SasukeDragonFlame_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2((s__SasukeDragonFlame_SPELL_ID ) , Filter(( function s__SasukeDragonFlame_actions))) // INLINED!!
 endfunction 

//===========================================================================
// Trigger: SasukeCursedSeal
//===========================================================================
function Trig_SasukeCursedSeal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == ( 'A0B8' ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_SasukeCursedSeal_Actions takes nothing returns nothing
    local real x= GetUnitX(GetTriggerUnit())
    local real y= GetUnitY(GetTriggerUnit())
    local real x2
    local real y2
    local integer i
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) and GetUnitTypeId(GetTriggerUnit()) == 'U00H' then
		call PlaySoundOnUnitBJ(gg_snd_Sasuke_Hebi_R, 100, GetTriggerUnit())
	endif

	if GetUnitTypeId(GetTriggerUnit()) == 'U00H' then
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0B8', false)
        else
		call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0B8', true)
	endif
    set i=0
    loop
        exitwhen i > 10
        set x2=(((x )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
        set y2=(((y )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h07D', x2, y2, GetRandomReal(0, 360))
        call SetUnitTimeScale(bj_lastCreatedUnit, 0.3)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        set i=i + 1
    endloop
endfunction

//===========================================================================
function InitTrig_SasukeCursedSeal takes nothing returns nothing
    set gg_trg_SasukeCursedSeal=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SasukeCursedSeal, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SasukeCursedSeal, Condition(function Trig_SasukeCursedSeal_Conditions))
    call TriggerAddAction(gg_trg_SasukeCursedSeal, function Trig_SasukeCursedSeal_Actions)
endfunction


