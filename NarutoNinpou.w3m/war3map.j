    function s__KisameSharkDance_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KisameSharkDance_caster[this])
        local real y= GetUnitY(s__KisameSharkDance_caster[this])
        local real angle= Atan3(GetUnitX(s__KisameSharkDance_caster[this]) , GetUnitY(s__KisameSharkDance_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__KisameSharkDance_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__KisameSharkDance_caster[this])))])) // INLINED!!
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__KisameSharkDance_caster[this], new_x)
            call SetUnitY(s__KisameSharkDance_caster[this], new_y)
            call SetUnitFacing(s__KisameSharkDance_caster[this], Rad2Deg(angle))
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KisameSharkDance_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__KisameSharkDance_damaged[this]) then
                    call UnitDamageTarget(s__KisameSharkDance_caster[this], bj_lastCreatedUnit, 5.0 * GetHeroStr(s__KisameSharkDance_caster[this], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__KisameSharkDance_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KisameSharkDance_count[this]=s__KisameSharkDance_count[this] + 1
        if s__KisameSharkDance_count[this] > 36 then
            //call PauseUnit(this.caster, false)
            call DestroyGroup(s__KisameSharkDance_damaged[this])
            set s__KisameSharkDance_damaged[this]=null
            call s__KisameSharkDance_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KisameSharkDance_actions takes nothing returns nothing
        local integer this= s__KisameSharkDance_allocate()
        set s__KisameSharkDance_caster[this]=GetTriggerUnit()
        set s__KisameSharkDance_count[this]=0
        set s__KisameSharkDance_damaged[this]=CreateGroup()
        set s__KisameSharkDance_angle[this]=Atan3(GetUnitX(s__KisameSharkDance_caster[this]) , GetUnitY(s__KisameSharkDance_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__KisameSharkDance_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__KisameSharkDance_caster[this])))])) // INLINED!!
        //call PauseUnit(this.caster, true)
        call SetUnitAnimation(s__KisameSharkDance_caster[this], "spell one")
        call SetUnitFacing(s__KisameSharkDance_caster[this], Rad2Deg(s__KisameSharkDance_angle[this]))
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KisameSharkDance_periodic)
    endfunction 
    
    function s__KisameSharkDance_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__KisameSharkDance_SPELL_ID ) , Filter(( function s__KisameSharkDance_actions))) // INLINED!!
    endfunction 
    
