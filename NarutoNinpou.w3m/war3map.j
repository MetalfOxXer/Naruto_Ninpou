    function s__ObitoFlame_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ObitoFlame_missile[this])
        local real y= GetUnitY(s__ObitoFlame_missile[this])
        local real new_x= (((x )*1.0) + Cos((( s__ObitoFlame_angle[this] )*1.0)) * (( 20)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__ObitoFlame_angle[this] )*1.0)) * (( 20)*1.0)) // INLINED!!
        call SetUnitX(s__ObitoFlame_missile[this], new_x)
        call SetUnitY(s__ObitoFlame_missile[this], new_y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200 + 4 * s__ObitoFlame_count[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoFlame_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoFlame_damaged[this]) then
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                call UnitDamageTarget(s__ObitoFlame_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__ObitoFlame_caster[this], s__ObitoFlame_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__ObitoFlame_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__ObitoFlame_count[this]=s__ObitoFlame_count[this] + 1
        if s__ObitoFlame_count[this] > 30 then
            call KillUnit(s__ObitoFlame_missile[this])
            set s__ObitoFlame_missile[this]=null
            call DestroyGroup(s__ObitoFlame_damaged[this])
            set s__ObitoFlame_damaged[this]=null
            call DestroyEffect(s__ObitoFlame_tornado[this])
            set s__ObitoFlame_tornado[this]=null
            call s__ObitoFlame_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ObitoFlame_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__ObitoFlame_tornado[this]=AddSpecialEffect("war3mapImported\\Bakufu_Ranbu.mdl", s__ObitoFlame_origin_x[this], s__ObitoFlame_origin_y[this])
        call BlzSetSpecialEffectYaw(s__ObitoFlame_tornado[this], s__ObitoFlame_angle[this] + bj_PI)
        call BlzSetSpecialEffectScale(s__ObitoFlame_tornado[this], 1.5)
        call BlzSetSpecialEffectHeight(s__ObitoFlame_tornado[this], 100 + GetPointZ(s__ObitoFlame_origin_x[this] , s__ObitoFlame_origin_y[this]))
        call BlzPlaySpecialEffect(s__ObitoFlame_tornado[this], ANIM_TYPE_BIRTH)
        //call BlzSetSpecialEffectTime(this.tornado, 1.3)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ObitoFlame_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ObitoFlame_actions takes nothing returns nothing
        local integer this= s__ObitoFlame_allocate()
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
         
        set s__ObitoFlame_caster[this]=GetTriggerUnit()
        set s__ObitoFlame_angle[this]=Atan3(x , y , GetSpellTargetX() , GetSpellTargetY())
        set s__ObitoFlame_origin_x[this]=GetUnitX(s__ObitoFlame_caster[this])
        set s__ObitoFlame_origin_y[this]=GetUnitY(s__ObitoFlame_caster[this])
        set s__ObitoFlame_count[this]=0
        set s__ObitoFlame_damaged[this]=CreateGroup()
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__ObitoFlame_caster[this]) ), ( 'h03U' ), (( s__ObitoFlame_origin_x[this] )*1.0), (( s__ObitoFlame_origin_y[this] )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, 0.75, 0, 0)
        call KillUnit(bj_lastCreatedUnit)
        set s__ObitoFlame_missile[this]=CreateUnit(GetOwningPlayer(s__ObitoFlame_caster[this]), 'e007', s__ObitoFlame_origin_x[this], s__ObitoFlame_origin_y[this], 270)
        call TimerStart(NewTimerEx(this), 0.05, false, function s__ObitoFlame_delay)
    endfunction 
    
    function s__ObitoFlame_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(37 , s__ObitoFlame_SPELL_ID , function s__ObitoFlame_actions)
    endfunction 
    
