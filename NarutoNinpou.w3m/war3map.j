 function s__ZetsuTrap_periodic2 takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i
  local real dist1
  local real angle1
  local real x1
  local real y1
  local real dist2
  local real x2
  local real y2
		set s__ZetsuTrap_c[this]=s__ZetsuTrap_c[this] + 1

		if s__ZetsuTrap_c[this] > 20 then
			set bj_lastCreatedGroup=CreateGroup()
			set s__ZetsuTrap_instance=this
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ZetsuTrap_trap[this]), GetUnitY(s__ZetsuTrap_trap[this]), 400, Filter(function s__ZetsuTrap_dealDamage))
			call DestroyGroup(bj_lastCreatedGroup)
			set i=1
            		loop
                		exitwhen i > 30

                		set angle1=i * 12
                		set dist2=13 * i
                		set x2=(((GetUnitX(s__ZetsuTrap_trap[this]) )*1.0) + Cos((( angle1 )*1.0)) * (( dist2)*1.0)) // INLINED!!
                		set y2=(((GetUnitY(s__ZetsuTrap_trap[this]) )*1.0) + Sin((( angle1 )*1.0)) * (( dist2)*1.0)) // INLINED!!

				set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdl", x2, y2)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.5)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.5)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.5)*1.0) , false) // INLINED!!


                		set dist1=8 * i
                		set x1=(((GetUnitX(s__ZetsuTrap_trap[this]) )*1.0) + Cos((( angle1 )*1.0)) * (( dist1)*1.0)) // INLINED!!
                		set y1=(((GetUnitY(s__ZetsuTrap_trap[this]) )*1.0) + Sin((( angle1 )*1.0)) * (( dist1)*1.0)) // INLINED!!

				set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Weapons\\TreantMissile\\TreantMissile.mdl", x1, y1)
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.8)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.0)*1.0) , false) // INLINED!!


                		set i=i + 1
            		endloop
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__ZetsuTrap_damaged[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__ZetsuTrap_damaged[this], bj_lastCreatedUnit)
			endloop
			call s__ZetsuTrap_destroy(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__ZetsuTrap_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer count= 0
		if GetWidgetLife(s__ZetsuTrap_trap[this]) > 0.405 then
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ZetsuTrap_trap[this]), GetUnitY(s__ZetsuTrap_trap[this]), 400, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ZetsuTrap_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
					call GroupAddUnit(s__ZetsuTrap_damaged[this], bj_lastCreatedUnit)
					call EsnareUnitTimed(s__ZetsuTrap_caster[this] , bj_lastCreatedUnit , 3.0)
					set count=count + 1
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			if count > 0 then
				call TimerStart(NewTimerEx(this), 0.01, true, function s__ZetsuTrap_periodic2)
				call ReleaseTimer(GetExpiredTimer())
			endif
		else
			call s__ZetsuTrap_destroy(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

