 function s__IrukaKaton_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__IrukaKaton_IrukaFireBall)
  local real y= GetUnitY(s__IrukaKaton_IrukaFireBall)
  local real new_x= (((x )*1.0) + Cos((( s__IrukaKaton_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__IrukaKaton_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
		call SetUnitX(s__IrukaKaton_IrukaFireBall, new_x)
		call SetUnitY(s__IrukaKaton_IrukaFireBall, new_y)
		set s__IrukaKaton_count[this]=s__IrukaKaton_count[this] + 1
		call SetUnitScale(s__IrukaKaton_IrukaFireBall, 1.0 + 1 / 28.0 * s__IrukaKaton_count[this], 0, 0)
		call SetUnitFlyHeight(s__IrukaKaton_IrukaFireBall, 120 + 120 / 20.0 * s__IrukaKaton_count[this], 0)
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 180 + 6 * s__IrukaKaton_count[this], null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__IrukaKaton_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__IrukaKaton_damaged[this]) then
				set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.7)
				call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 70 + GetPointZ(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit)))
				call DestroyEffect(bj_lastCreatedEffect)
				call UnitDamageTarget(s__IrukaKaton_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__IrukaKaton_caster[this], s__IrukaKaton_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				call GroupAddUnit(s__IrukaKaton_damaged[this], bj_lastCreatedUnit)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if s__IrukaKaton_count[this] > 30 then
			call KillUnit(s__IrukaKaton_IrukaFireBall)
			call DestroyGroup(s__IrukaKaton_damaged[this])
			set s__IrukaKaton_IrukaFireBall=null
			set s__IrukaKaton_damaged[this]=null
			call s__IrukaKaton_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

