//===========================================================================
// Trigger: GedoMazoBorn
//===========================================================================
function Trig_GedoMazo_Born_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'h0B0' ) ) then
        return true
    endif
    return false
endfunction

function Trig_GedoMazo_Born_Conditions takes nothing returns boolean
    if ( not Trig_GedoMazo_Born_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_GedoMazo_Born_Actions takes nothing returns nothing
    set obitoSummon=null
    set udg_GedoMazo_GedoMazo=GetSummonedUnit()
    set obitoSummon=GetSummonedUnit()
    call SetUnitTimeScale(udg_GedoMazo_GedoMazo, 3.0)
    call SetUnitAnimation(GetSummonedUnit(), "birth")
    set udg_GedoMazo_Point[1]=GetUnitLoc(GetSummonedUnit())
    call CreateNUnitsAtLoc(1, 'h01V', GetTriggerPlayer(), udg_GedoMazo_Point[1], bj_UNIT_FACING)
    call SetUnitAnimation(GetLastCreatedUnit(), "birth")
    call UnitApplyTimedLifeBJ(3.50, 'BTLF', GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'h04S', GetOwningPlayer(GetSummonedUnit()), udg_GedoMazo_Point[1], bj_UNIT_FACING)
    call KillUnit(GetLastCreatedUnit())
    call CreateNUnitsAtLoc(1, 'h007', GetTriggerPlayer(), udg_GedoMazo_Point[1], bj_UNIT_FACING)
    call UnitApplyTimedLifeBJ(1.00, 'BTLF', GetLastCreatedUnit())
    call IssueImmediateOrder(GetLastCreatedUnit(), "stomp")
    call RemoveLocation(udg_GedoMazo_Point[1])
    call SelectUnitForPlayerSingle(udg_GedoMazo_GedoMazo, GetOwningPlayer(udg_GedoMazo_GedoMazo))
    call PauseUnit(udg_GedoMazo_GedoMazo, true)
    call PolledWait(1.5)
    call SetUnitTimeScale(udg_GedoMazo_GedoMazo, 1.0)
    call PauseUnit(udg_GedoMazo_GedoMazo, false)
endfunction

//===========================================================================
function InitTrig_GedoMazoBorn takes nothing returns nothing
    set gg_trg_GedoMazoBorn=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GedoMazoBorn, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddCondition(gg_trg_GedoMazoBorn, Condition(function Trig_GedoMazo_Born_Conditions))
    call TriggerAddAction(gg_trg_GedoMazoBorn, function Trig_GedoMazo_Born_Actions)
endfunction


//===========================================================================
// Trigger: GedoMazo Start Effect
//===========================================================================
function Trig_GedoMazo_Start_Effect_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A123' ) ) then
        return false
    endif
    return true
endfunction

function Trig_GedoMazo_Start_Effect_Actions takes nothing returns nothing
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Tobi_R, 100.0, GetTriggerUnit())
    endif
    set udg_GedoMazo_Caster=GetTriggerUnit()
    call SetUnitAnimation(GetTriggerUnit(), "spell two")
endfunction

//===========================================================================
function InitTrig_GedoMazo_Start_Effect takes nothing returns nothing
    set gg_trg_GedoMazo_Start_Effect=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_GedoMazo_Start_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_GedoMazo_Start_Effect, Condition(function Trig_GedoMazo_Start_Effect_Conditions))
    call TriggerAddAction(gg_trg_GedoMazo_Start_Effect, function Trig_GedoMazo_Start_Effect_Actions)
endfunction


