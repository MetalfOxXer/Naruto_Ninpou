		call DestroyGroup(bj_lastCreatedGroup)
		call PauseUnit(s__YugitoClawsStorm_caster[this], true)
		call SetUnitAnimation(s__YugitoClawsStorm_caster[this], "spell one")
		call SetUnitTimeScale(s__YugitoClawsStorm_caster[this], 2.0)
