					call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
					call UnitRemoveBuffs(bj_lastCreatedUnit, false, true)
