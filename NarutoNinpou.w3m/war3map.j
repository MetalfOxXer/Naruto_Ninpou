 endfunction 

 function s__DanzoSuicide_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x
  local real y
  local real angle
  local real new_x
  local real new_y
		set s__DanzoSuicide_count[this]=s__DanzoSuicide_count[this] + 1
		call SetUnitX(s__DanzoSuicide_sphere[this], GetUnitX(s__DanzoSuicide_caster[this]))
		call SetUnitY(s__DanzoSuicide_sphere[this], GetUnitY(s__DanzoSuicide_caster[this]))
		set bj_lastCreatedGroup=CreateGroup()
		if s__DanzoSuicide_ultimate[this] then
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__DanzoSuicide_sphere[this]), GetUnitY(s__DanzoSuicide_sphere[this]), 600, null)
		else
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__DanzoSuicide_sphere[this]), GetUnitY(s__DanzoSuicide_sphere[this]), 400, null)
		endif
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__DanzoSuicide_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
				set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(x , y , GetUnitX(s__DanzoSuicide_sphere[this]) , GetUnitY(s__DanzoSuicide_sphere[this]))
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( s__DanzoSuicide_count[this] / 2)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( s__DanzoSuicide_count[this] / 2)*1.0)) // INLINED!!
				if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                	call SetUnitX(bj_lastCreatedUnit, new_x)
                	call SetUnitY(bj_lastCreatedUnit, new_y)
				endif
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)

		if s__DanzoSuicide_count[this] >= 33 then
			call SetUnitTimeScale(s__DanzoSuicide_sphere[this], 1.2)
			call SetUnitAnimation(s__DanzoSuicide_sphere[this], "death")
		endif
		if s__DanzoSuicide_count[this] >= 41 then
			call TimerStart(NewTimerEx(this), 0.03, false, function s__DanzoSuicide_delay2)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__DanzoSuicide_actions takes nothing returns nothing
  local integer this
		set this=s__DanzoSuicide_allocate()
		set s__DanzoSuicide_ultimate[this]=false
		set s__DanzoSuicide_caster[this]=GetTriggerUnit()
		set s__DanzoSuicide_count[this]=0
		call PauseUnit(s__DanzoSuicide_caster[this], true)
		call UnitRemoveAbility(s__DanzoSuicide_caster[this], 'Broa')
		if s__DanzoIzanagiModel_Dexplode then
			set s__DanzoSuicide_ultimate[this]=true
		endif
		if s__DanzoSuicide_ultimate[this] then
			set s__DanzoSuicide_domo[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h02X' ), (( GetUnitX(s__DanzoSuicide_caster[this]) )*1.0), (( GetUnitY(s__DanzoSuicide_caster[this]) )*1.0), (( 270)*1.0))) // INLINED!!
			call SetUnitVertexColor(s__DanzoSuicide_domo[this], 255, 255, 255, 125)
			call SetUnitScale(s__DanzoSuicide_domo[this], 6, 6, 6)
		endif
		set s__DanzoSuicide_sphere[this]=CreateUnit(GetTriggerPlayer(), 'h051', GetUnitX(s__DanzoSuicide_caster[this]), GetUnitY(s__DanzoSuicide_caster[this]), 270)
		if s__DanzoSuicide_ultimate[this] then
			call SetUnitScale(s__DanzoSuicide_sphere[this], 1.5, 1.5, 1.5)
		else
			call SetUnitScale(s__DanzoSuicide_sphere[this], 0.75, 0.75, 0.75)
		endif
		call SetUnitTimeScale(s__DanzoSuicide_sphere[this], 3.0)
		call SetUnitAnimation(s__DanzoSuicide_sphere[this], "birth")
		call TimerStart(NewTimerEx(this), 0.03, true, function s__DanzoSuicide_delay)
 endfunction 

 function s__DanzoSuicide_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(41 , s__DanzoSuicide_SPELL_ID , function s__DanzoSuicide_actions)
 endfunction 

