    function s__NagatoShinraGigaTensei_delay2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if IsUnitPaused(s__NagatoShinraGigaTensei_caster[this]) == false then
            call PauseUnit(s__NagatoShinraGigaTensei_caster[this], true)
        endif
        set s__NagatoShinraGigaTensei_count[this]=s__NagatoShinraGigaTensei_count[this] + 1
        if s__NagatoShinraGigaTensei_count[this] >= 20 then
            set s__NagatoShinraGigaTensei_count[this]=0
            call TimerStart(NewTimerEx(this), 0.03, true, function s__NagatoShinraGigaTensei_periodic)
            call SetUnitAnimation(s__NagatoShinraGigaTensei_caster[this], "spell slam")
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NagatoShinraGigaTensei_delay1 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call PauseUnit(s__NagatoShinraGigaTensei_caster[this], true)
        call SetUnitAnimation(s__NagatoShinraGigaTensei_caster[this], "spell")
        call SetUnitFlyHeight(s__NagatoShinraGigaTensei_caster[this], 500, 250)
        call SetUnitInvulnerable(s__NagatoShinraGigaTensei_caster[this], true)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__NagatoShinraGigaTensei_delay2)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__NagatoShinraGigaTensei_actions takes nothing returns nothing
        local integer this= s__NagatoShinraGigaTensei_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Nagato_T_Shinra, 100.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Nagato: I want you to feel pain, to think about pain, to accept pain, to know pain.|r")
        endif
	set bj_lastCreatedGroup=CreateGroup()
	call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 500, null)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
			call StunUnitTimed(GetTriggerUnit() , bj_lastCreatedUnit , 3.0)
		endif
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
        set s__NagatoShinraGigaTensei_caster[this]=GetTriggerUnit()
        set s__NagatoShinraGigaTensei_count[this]=0
        set s__NagatoShinraGigaTensei_damaged[this]=CreateGroup()
	set s__NagatoShinraGigaTensei_dummy[this]=CreateUnit(GetTriggerPlayer(), 'n01P', GetUnitX(s__NagatoShinraGigaTensei_caster[this]), GetUnitY(s__NagatoShinraGigaTensei_caster[this]), 270)
	call SetUnitScale(s__NagatoShinraGigaTensei_dummy[this], 0, 0, 0)
        call TimerStart(NewTimerEx(this), 0.1, false, function s__NagatoShinraGigaTensei_delay1)
    endfunction 
    
    function s__NagatoShinraGigaTensei_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(10 , s__NagatoShinraGigaTensei_SPELL_ID , function s__NagatoShinraGigaTensei_actions)
    endfunction 
    
