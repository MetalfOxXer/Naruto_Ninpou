                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoGedoMazo_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoGedoMazo_damaged[this]) then
                    call GroupAddUnit(s__ObitoGedoMazo_damaged[this], bj_lastCreatedUnit)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    call UnitDamageTarget(s__ObitoGedoMazo_caster[this], bj_lastCreatedUnit, 8 * GetHeroInt(udg_units33[GetPlayerId(GetOwningPlayer(s__ObitoGedoMazo_caster[this])) + 1], true) + 500, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=i + 1
        endloop
        if s__ObitoGedoMazo_count[this] > 20 then
            call PauseUnit(s__ObitoGedoMazo_caster[this], false)
            set i=0
            loop
                exitwhen i > 11
                call DestroyLightning(s___ObitoGedoMazo_l[s__ObitoGedoMazo_l[this]+i])
                set s___ObitoGedoMazo_l[s__ObitoGedoMazo_l[this]+i]=null
                set i=i + 1
            endloop
            call DestroyGroup(s__ObitoGedoMazo_damaged[this])
            set s__ObitoGedoMazo_damaged[this]=null
            call s__ObitoGedoMazo_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ObitoGedoMazo_actions takes nothing returns nothing
        local integer this= s__ObitoGedoMazo__allocate()
        local integer i= 0
        set s__ObitoGedoMazo_caster[this]=GetTriggerUnit()
        loop
            exitwhen i > 11
            set s___ObitoGedoMazo_l[s__ObitoGedoMazo_l[this]+i]=AddLightningEx("CLPB", false, GetUnitX(s__ObitoGedoMazo_caster[this]), GetUnitY(s__ObitoGedoMazo_caster[this]), 1000, GetUnitX(s__ObitoGedoMazo_caster[this]), GetUnitY(s__ObitoGedoMazo_caster[this]), 0)
            set i=i + 1
        endloop
        set s__ObitoGedoMazo_damaged[this]=CreateGroup()
        set s__ObitoGedoMazo_caster_x[this]=GetUnitX(s__ObitoGedoMazo_caster[this])
        set s__ObitoGedoMazo_caster_y[this]=GetUnitY(s__ObitoGedoMazo_caster[this])
        set s__ObitoGedoMazo_count[this]=0
        call PauseUnit(s__ObitoGedoMazo_caster[this], true)
        call SetUnitAnimation(s__ObitoGedoMazo_caster[this], "spell")
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ObitoGedoMazo_periodic)
    endfunction 
    
    function s__ObitoGedoMazo_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2(('A128' ) , Filter(( function s__ObitoGedoMazo_actions))) // INLINED!!
    endfunction 

