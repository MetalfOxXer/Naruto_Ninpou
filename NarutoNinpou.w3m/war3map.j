        call EnableTrigger(gg_trg_BasesInvulMode)
        set udg_ModeS=udg_ModeS + "| 70 Kills"
        set udg_KillModeLimit=70
        set udg_KillModeEnabled=true
        call LeaderboardSetLabelBJ(udg_Leaderbox, "Team kills (Max 70)")
    endif
endfunction

