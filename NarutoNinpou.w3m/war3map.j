    function s__KushinaSlam_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KushinaSlam_caster[s__KushinaSlam_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
