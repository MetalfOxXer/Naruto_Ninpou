            else
                set this=s__HeroMessage_Alloc___recycle[(0)]
                set s__HeroMessage_Alloc___recycle[(0)]=s__HeroMessage_Alloc___recycle[s__HeroMessage_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
