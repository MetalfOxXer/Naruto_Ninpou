                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e01G', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), GetRandomReal(0, 360))
                call SetUnitX(bj_lastCreatedUnit, GetUnitX(GetTriggerUnit()))
                call SetUnitY(bj_lastCreatedUnit, GetUnitY(GetTriggerUnit()))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            endloop
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiLightningClone_kakashi)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(s__KakashiLightningClone_kakashi, bj_lastCreatedUnit, GetUnitAbilityLevel(s__KakashiLightningClone_kakashi, s__KakashiLightningClone_SPELL_ID) * GetHeroAgi(s__KakashiLightningClone_kakashi, true) / 2.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
    endfunction
    
