// Trigger: NarutoGuoudama
//===========================================================================

    
    function s__NarutoGudoudama_destroy takes integer this returns nothing
        local integer i= 0
        loop
            exitwhen i > 11
            call RecycleUnit(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i])
            set s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]=null
            set i=i + 1
        endloop
        call DestroyGroup(s__NarutoGudoudama_damaged[this])
        set s__NarutoGudoudama_damaged[this]=null
        set s__NarutoGudoudama_caster[this]=null
        call s__NarutoGudoudama_deallocate(this)
    endfunction
    
    function s__NarutoGudoudama_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x
        local real y
        set s__NarutoGudoudama_count[this]=s__NarutoGudoudama_count[this] + 1
        set i=0
        loop
            exitwhen i > 11
            if s__NarutoGudoudama_count[this] < 50 then
                set x=(((s__NarutoGudoudama_x[this] )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]) + 18) )*1.0)) * (( s__NarutoGudoudama_count[this] * 12)*1.0)) // INLINED!!
                set y=(((s__NarutoGudoudama_y[this] )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]) + 18) )*1.0)) * (( s__NarutoGudoudama_count[this] * 12)*1.0)) // INLINED!!
            else
                set x=(((s__NarutoGudoudama_x[this] )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]) + 18) )*1.0)) * (( 1200 - s__NarutoGudoudama_count[this] * 12)*1.0)) // INLINED!!
                set y=(((s__NarutoGudoudama_y[this] )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]) + 18) )*1.0)) * (( 1200 - s__NarutoGudoudama_count[this] * 12)*1.0)) // INLINED!!
            endif
            if ModuloInteger(s__NarutoGudoudama_count[this], 2) == 0 then
                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            endif
            call SetUnitX(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i], x)
            call SetUnitY(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i], y)
            call SetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i], GetUnitFacing(s___NarutoGudoudama_orbs[s__NarutoGudoudama_orbs[this]+i]) + 18)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 110.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NarutoGudoudama_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.40 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
