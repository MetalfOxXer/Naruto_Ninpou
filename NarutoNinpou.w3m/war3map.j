        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" ), (( GetUnitX(s__HakuNewSemi_caster[this]) )*1.0), (( GetUnitY(s__HakuNewSemi_caster[this]))*1.0))) // INLINED!!
