        call UnitRemoveAbility(s__YamanakaTech_caster[this], 'A02Q')
        call DestroyEffect(AddSpecialEffect(("Units\\Undead\\Abomination\\AbominationExplosion.mdl" ), (( GetUnitX(s__YamanakaTech_target[this]) )*1.0), (( GetUnitY(s__YamanakaTech_target[this]))*1.0))) // INLINED!!
        call UnitDamageTarget(s__YamanakaTech_caster[this], s__YamanakaTech_target[this], ( GetHeroInt(s__YamanakaTech_caster[this], true) ) * GetUnitAbilityLevel(s__YamanakaTech_caster[this], s__YamanakaTech_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)

	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__YamanakaTech_caster[this]), 'n03F', GetUnitX(s__YamanakaTech_caster[this]), GetUnitY(s__YamanakaTech_caster[this]), GetUnitFacing(s__YamanakaTech_caster[this]))
	call UnitAddAbility(bj_lastCreatedUnit, 'A057')
	call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", s__YamanakaTech_target[this])
	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)

	call SilenceUnitLight(s__YamanakaTech_caster[this] , s__YamanakaTech_target[this])
        call UnitRemoveAbility(s__YamanakaTech_caster[this], 'Binv')
        set s__YamanakaTech_target[this]=null
        call s__YamanakaTech_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__YamanakaTech_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__YamanakaTech_caster[this]) , GetUnitY(s__YamanakaTech_caster[this]) , GetUnitX(s__YamanakaTech_target[this]) , GetUnitY(s__YamanakaTech_target[this]))
        local real x= (((GetUnitX(s__YamanakaTech_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__YamanakaTech_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        call SetUnitX(s__YamanakaTech_caster[this], x)
        call SetUnitY(s__YamanakaTech_caster[this], y)
        call TimerStart(NewTimerEx(this), 0.05, false, function s__YamanakaTech_delay2)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__YamanakaTech_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__YamanakaTech_caster[this]) , GetUnitY(s__YamanakaTech_caster[this]) , GetUnitX(s__YamanakaTech_target[this]) , GetUnitY(s__YamanakaTech_target[this]))
        //call ShowUnit(this.caster, true) 
        call SelectUnitForPlayerSingle(s__YamanakaTech_caster[this], GetOwningPlayer(s__YamanakaTech_caster[this]))
        call SetUnitFacing(s__YamanakaTech_caster[this], Rad2Deg(angle) + 180)
        call SetUnitAnimation(s__YamanakaTech_caster[this], "attack")
        //call PauseUnit(this.target, true) 
        call TimerStart(NewTimerEx(this), 0.01, false, function s__YamanakaTech_damage)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
