    function s__KakuzuMasks_check_distance takes integer this,unit u returns nothing
        local real angle
        if GetWidgetLife(u) < 0.405 then
            return
        endif
        //if GetDistanceUnits(this.caster, u) > 2500 then 
            //set angle = Atan3(GetUnitX(this.caster), GetUnitY(this.caster), GetUnitX(u), GetUnitY(u))
            //call SetUnitX(u, GetPolarX(GetUnitX(this.caster), angle, 2500))
            //call SetUnitY(u, GetPolarY(GetUnitY(this.caster), angle, 2500))
	    //call IssueTargetOrder(u, "patrol", this.caster)
        //endif 
    endfunction 
    
    function s__KakuzuMasks_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__KakuzuMasks_count[this]=s__KakuzuMasks_count[this] + 0.1
        call s__KakuzuMasks_check_distance(this,s__KakuzuMasks_fire_mask[this])
        call s__KakuzuMasks_check_distance(this,s__KakuzuMasks_wind_mask[this])
        call s__KakuzuMasks_check_distance(this,s__KakuzuMasks_lightning_mask[this])
        if GetWidgetLife(s__KakuzuMasks_caster[this]) < 0.405 then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_fire_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_fire_mask[this]))*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_wind_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_wind_mask[this]))*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_lightning_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_lightning_mask[this]))*1.0))) // INLINED!!
            call KillUnit(s__KakuzuMasks_fire_mask[this])
            call ShowUnit(s__KakuzuMasks_fire_mask[this], false)
            set s__KakuzuMasks_fire_mask[this]=null
            call KillUnit(s__KakuzuMasks_wind_mask[this])
            call ShowUnit(s__KakuzuMasks_wind_mask[this], false)
            set s__KakuzuMasks_wind_mask[this]=null
            call KillUnit(s__KakuzuMasks_lightning_mask[this])
            call ShowUnit(s__KakuzuMasks_lightning_mask[this], false)
            set s__KakuzuMasks_lightning_mask[this]=null
            call s__KakuzuMasks_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KakuzuMasks_actions takes nothing returns nothing
        local integer this= s__KakuzuMasks__allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Kakuzu_T_Hearts, 80.0, GetTriggerUnit())
        endif
        set s__KakuzuMasks_caster[this]=GetTriggerUnit()
        set s__KakuzuMasks_count[this]=0
        set s__KakuzuMasks_fire_mask[this]=CreateUnit(GetTriggerPlayer(), 'h097', GetUnitX(s__KakuzuMasks_caster[this]), GetUnitY(s__KakuzuMasks_caster[this]), GetUnitFacing(s__KakuzuMasks_caster[this]))
        call UnitApplyTimedLife(s__KakuzuMasks_fire_mask[this], 'BTLF', 45.0)
        set s__KakuzuMasks_wind_mask[this]=CreateUnit(GetTriggerPlayer(), 'h098', GetUnitX(s__KakuzuMasks_caster[this]), GetUnitY(s__KakuzuMasks_caster[this]), GetUnitFacing(s__KakuzuMasks_caster[this]))
        call UnitApplyTimedLife(s__KakuzuMasks_wind_mask[this], 'BTLF', 45.0)
        set s__KakuzuMasks_lightning_mask[this]=CreateUnit(GetTriggerPlayer(), 'h099', GetUnitX(s__KakuzuMasks_caster[this]), GetUnitY(s__KakuzuMasks_caster[this]), GetUnitFacing(s__KakuzuMasks_caster[this]))
        call UnitApplyTimedLife(s__KakuzuMasks_lightning_mask[this], 'BTLF', 45.0)
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_fire_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_fire_mask[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_wind_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_wind_mask[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( GetUnitX(s__KakuzuMasks_lightning_mask[this]) )*1.0), (( GetUnitY(s__KakuzuMasks_lightning_mask[this]))*1.0))) // INLINED!!
        call AddLoadingBar(s__KakuzuMasks_caster[this] , 45.0)
	call IssueTargetOrder(s__KakuzuMasks_fire_mask[this], "patrol", s__KakuzuMasks_caster[this])
	call IssueTargetOrder(s__KakuzuMasks_wind_mask[this], "patrol", s__KakuzuMasks_caster[this])
	call IssueTargetOrder(s__KakuzuMasks_lightning_mask[this], "patrol", s__KakuzuMasks_caster[this])
        call TimerStartEx(NewTimerEx(this) , 0.1 , true , function s__KakuzuMasks_periodic , "KankuroMasks_periodic")
    endfunction
    
    function s__KakuzuMasks_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(5 , s__KakuzuMasks_SPELL_ID , function s__KakuzuMasks_actions)
    endfunction
    
//===========================================================================
// Trigger: KakuzuRaiton
//===========================================================================

    
    function s__KakuzuRaiton_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i= 0
        loop
            exitwhen i > 11
            call DestroyLightning(s___KakuzuRaiton_lights[s__KakuzuRaiton_lights[this]+i])
            set s___KakuzuRaiton_lights[s__KakuzuRaiton_lights[this]+i]=null
            set i=i + 1
        endloop
        call s__KakuzuRaiton_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__KakuzuRaiton_actions takes nothing returns nothing
        local integer this= s__KakuzuRaiton__allocate()
        local real x
        local real y
        local integer i= 0
        loop
            exitwhen i > 11
            set x=(((GetUnitX(GetSpellTargetUnit()) )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 50.0)*1.0)) // INLINED!!
            set y=(((GetUnitY(GetSpellTargetUnit()) )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 50.0)*1.0)) // INLINED!!
            set s___KakuzuRaiton_lights[s__KakuzuRaiton_lights[this]+i]=AddLightningEx("CHIM", true, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 100.0, x, y, 60.0)
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e01G', GetUnitX(GetSpellTargetUnit()), GetUnitY(GetSpellTargetUnit()), GetRandomReal(0, 360))
            call SetUnitX(bj_lastCreatedUnit, GetUnitX(GetSpellTargetUnit()))
            call SetUnitY(bj_lastCreatedUnit, GetUnitY(GetSpellTargetUnit()))
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            set i=i + 1
        endloop
        call UnitDamageTarget(GetTriggerUnit(), GetSpellTargetUnit(), 10.0 * GetHeroStr(udg_units33[GetPlayerId(GetTriggerPlayer()) + 1], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        call TimerStartEx(NewTimerEx(this) , 1.0 , false , function s__KakuzuRaiton_finish , "KankuroRaiton_finish")
    endfunction
    
    function s__KakuzuRaiton_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(5 , s__KakuzuRaiton_SPELL_ID , function s__KakuzuRaiton_actions)
    endfunction
    
