 function s__NejiNewUltimate_destroy takes integer this returns nothing
		call SetUnitTimeScale(s__NejiNewUltimate_caster[this], 1.0)
		call UnitRemoveAbility(s__NejiNewUltimate_caster[this], 'A02Q')
		call KillUnit(s__NejiNewUltimate_domo[this])
		call ShowUnit(s__NejiNewUltimate_domo[this], false)
        	call KillUnit(s__NejiNewUltimate_domo3[this])
        	call ShowUnit(s__NejiNewUltimate_domo3[this], false)
		call KillUnit(s__NejiNewUltimate_domo4[this])
		set s__NejiNewUltimate_domo4[this]=null
        	call SetUnitTimeScale(s__NejiNewUltimate_domo2[this], 1.0)
