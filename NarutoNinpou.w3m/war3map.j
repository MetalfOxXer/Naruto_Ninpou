        function s__TayuyaR_throw takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real dx
            local real dy
            local real distance
            local real speed= 30.0
            local unit projectile
            local integer i= - 1
            loop
                set i=i + 1
                exitwhen i > 2
                set projectile=s__TayuyaRAbility___projectileTayuyaT[i]
                set dx=GetLocationX(s__TayuyaR_targetLoc[this]) - GetUnitX(projectile)
                set dy=GetLocationY(s__TayuyaR_targetLoc[this]) - GetUnitY(projectile)
                set distance=SquareRoot(dx * dx + dy * dy)
                if distance < 10.0 or s__TayuyaR_count[this] >= 60 then
                    set s__TayuyaR_dokihit[this]=s__TayuyaR_dokihit[this] + 1
                else
                    set s__TayuyaR_count[this]=s__TayuyaR_count[this] + 1
                    call SetUnitX(projectile, GetUnitX(projectile) + ( dx / distance ) * speed)
                    call SetUnitY(projectile, GetUnitY(projectile) + ( dy / distance ) * speed)
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(projectile), GetUnitY(projectile), 180, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TayuyaR_caster[this])) then
                            if not IsUnitInGroup(bj_lastCreatedUnit, s__TayuyaR_damaged[this]) and bj_lastCreatedUnit != s__TayuyaR_target[this] then
                                call GroupAddUnit(s__TayuyaR_damaged[this], bj_lastCreatedUnit)
                                call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, 800 + ( GetHeroInt(TayuyaCore_Tayuya, true) + GetHeroStr(TayuyaCore_Tayuya, true) + GetHeroAgi(TayuyaCore_Tayuya, true) ) * GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaR_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                            endif
                        endif
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    endloop
                endif
            endloop
            if s__TayuyaR_dokihit[this] >= 1 or s__TayuyaR_count[this] >= 60 then
                call ShowUnit(s__TayuyaRAbility___projectileTayuyaT[0], false)
                call KillUnit(s__TayuyaRAbility___projectileTayuyaT[0])
                set s__TayuyaRAbility___projectileTayuyaT[0]= null
                call ShowUnit(s__TayuyaRAbility___projectileTayuyaT[1], false)
                call KillUnit(s__TayuyaRAbility___projectileTayuyaT[1])
                set s__TayuyaRAbility___projectileTayuyaT[1]= null
                call ShowUnit(s__TayuyaRAbility___projectileTayuyaT[2], false)
                call KillUnit(s__TayuyaRAbility___projectileTayuyaT[2])
                set s__TayuyaRAbility___projectileTayuyaT[2]= null
                call UnitDamageTarget(TayuyaCore_Tayuya, s__TayuyaR_target[this], 800 + ( GetHeroInt(TayuyaCore_Tayuya, true) + GetHeroStr(TayuyaCore_Tayuya, true) + GetHeroAgi(TayuyaCore_Tayuya, true) ) * GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaR_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                call RemoveLocation(s__TayuyaR_targetLoc[this])
                call PauseUnit(s__TayuyaR_target[this], false)
                set TayuyaCore_OgreRCasting=false
                call RemoveLocation(s__TayuyaR_targetLoc[this])
                call SetUnitInvulnerable(s__TayuyaR_caster[this], false)
                call ShowUnit(TayuyaCore_Puppet, true)
                call PauseUnit(TayuyaCore_Puppet, false)
                call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(TayuyaCore_Puppet) )*1.0), (( GetUnitY(TayuyaCore_Puppet))*1.0))) // INLINED!!
                call UnitRemoveAbility(TayuyaCore_Puppet, 'Aloc')
                call UnitAddAbility(TayuyaCore_Puppet, 'Aloc')
                call ShowUnit(TayuyaCore_Tayuya, true)
