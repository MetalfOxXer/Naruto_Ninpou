            call SetUnitY(s__ObitoNewQ_caster[this], s__ObitoNewQ_target_y[this])
            set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A0E2')
            call IssueTargetOrder(bj_lastCreatedUnit, "invisibility", s__ObitoNewQ_caster[this])
            call TimerStart(NewTimerEx(this), 0.25, false, function s__ObitoNewQ_delay)
