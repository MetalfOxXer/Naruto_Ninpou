    function s__EdoTobiramaNewQ_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__EdoTobiramaNewQ_caster[this])
        local real y= GetUnitY(s__EdoTobiramaNewQ_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__EdoTobiramaNewQ_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__EdoTobiramaNewQ_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__EdoTobiramaNewQ_caster[this], new_x)
            call SetUnitY(s__EdoTobiramaNewQ_caster[this], new_y)
            call SetUnitX(s__EdoTobiramaNewQ_wave[this], new_x)
            call SetUnitY(s__EdoTobiramaNewQ_wave[this], new_y)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__EdoTobiramaNewQ_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set new_x=(((x )*1.0) + Cos((( s__EdoTobiramaNewQ_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( s__EdoTobiramaNewQ_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__EdoTobiramaNewQ_damaged[this]) then
                    if GetUnitTypeId(s__EdoTobiramaNewQ_caster[this]) == 'N01Y' then
                        call UnitDamageTarget(s__EdoTobiramaNewQ_caster[this], bj_lastCreatedUnit, 10 * GetHeroAgi(s__EdoTobiramaNewQ_caster[this], true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    else
                        call UnitDamageTarget(s__EdoTobiramaNewQ_caster[this], bj_lastCreatedUnit, GetUnitAbilityLevel(s__EdoTobiramaNewQ_caster[this], 'A0BI') * GetHeroAgi(s__EdoTobiramaNewQ_caster[this], true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                    call GroupAddUnit(s__EdoTobiramaNewQ_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__EdoTobiramaNewQ_count[this]=s__EdoTobiramaNewQ_count[this] + 1
        if s__EdoTobiramaNewQ_count[this] > 26 then
            call SetUnitTimeScale(s__EdoTobiramaNewQ_caster[this], 1.0)
            call PauseUnit(s__EdoTobiramaNewQ_caster[this], false)
            call KillUnit(s__EdoTobiramaNewQ_wave[this])
            call DestroyGroup(s__EdoTobiramaNewQ_damaged[this])
            set s__EdoTobiramaNewQ_damaged[this]=null
            set s__EdoTobiramaNewQ_wave[this]=null
            call s__EdoTobiramaNewQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__EdoTobiramaNewQ_actions takes nothing returns nothing
        local integer this= s__EdoTobiramaNewQ_allocate()
        set s__EdoTobiramaNewQ_caster[this]=GetTriggerUnit()
        set s__EdoTobiramaNewQ_damaged[this]=CreateGroup()
        set s__EdoTobiramaNewQ_count[this]=0
        set s__EdoTobiramaNewQ_spell[this]=GetSpellAbilityId()
        set s__EdoTobiramaNewQ_angle[this]=Atan3(GetUnitX(s__EdoTobiramaNewQ_caster[this]) , GetUnitY(s__EdoTobiramaNewQ_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__EdoTobiramaNewQ_wave[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h05T' ), (( GetUnitX(s__EdoTobiramaNewQ_caster[this]) )*1.0), (( GetUnitY(s__EdoTobiramaNewQ_caster[this]) )*1.0), (( Rad2Deg(s__EdoTobiramaNewQ_angle[this]))*1.0))) // INLINED!!
        call SetUnitAnimation(s__EdoTobiramaNewQ_wave[this], "stand")
        call SetUnitTimeScale(s__EdoTobiramaNewQ_caster[this], 0)
        call PauseUnit(s__EdoTobiramaNewQ_caster[this], true)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__EdoTobiramaNewQ_periodic)
    endfunction 

