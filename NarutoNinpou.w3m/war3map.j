    function s__MitsukiE_dealDamage takes nothing returns boolean
    if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__MitsukiE_caster[s__MitsukiE_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
        call UnitDamageTarget(s__MitsukiE_caster[s__MitsukiE_instance], GetFilterUnit(), ( 70 + GetHeroInt(s__MitsukiE_caster[s__MitsukiE_instance], true) / 3 ) * GetUnitAbilityLevel(s__MitsukiE_caster[s__MitsukiE_instance], s__MitsukiE_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
    endif
    return false
    endfunction

    function s__MitsukiE_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real size
        local integer fade
        set size=0.003 * s__MitsukiE_count[this]
        set fade=3 * s__MitsukiE_count[this]
        call SetUnitScale(s__MitsukiE_ball[this], size, size, size)
        call SetUnitVertexColor(s__MitsukiE_ball[this], 255, 255, 255, fade)
        set s__MitsukiE_count[this]=s__MitsukiE_count[this] + 1
        if s__MitsukiE_count[this] > 40 then
	    call DestroyEffect(AddSpecialEffect(("war3mapImported\\Wind Blast - Classic.mdl" ), (( GetUnitX(s__MitsukiE_ball[this]) )*1.0), (( GetUnitY(s__MitsukiE_ball[this]))*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
	    set s__MitsukiE_instance=this
	    call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__MitsukiE_target_x1[this], s__MitsukiE_target_y1[this], 300, Filter(function s__MitsukiE_dealDamage))
	    call DestroyGroup(bj_lastCreatedGroup)
            call s__MitsukiE_deallocate(this)
	    call ShowUnit(s__MitsukiE_ball[this], false)
	    call KillUnit(s__MitsukiE_ball[this])
	    set s__MitsukiE_ball[this]=null
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__MitsukiE_actions takes nothing returns nothing
        local integer this= s__MitsukiE_allocate()
        set s__MitsukiE_caster[this]=GetTriggerUnit()
        set s__MitsukiE_target_x1[this]=GetSpellTargetX()
        set s__MitsukiE_target_y1[this]=GetSpellTargetY()
        set s__MitsukiE_ball[this]=CreateUnit(GetTriggerPlayer(), 'e006', s__MitsukiE_target_x1[this], s__MitsukiE_target_y1[this], 270)
        call SetUnitScale(s__MitsukiE_ball[this], 0.0001, 0.0001, 0.0001)
        call SetUnitVertexColor(s__MitsukiE_ball[this], 255, 255, 255, 0)
        call SetUnitTimeScale(s__MitsukiE_ball[this], 0.1)
        set s__MitsukiE_count[this]=0
        call TimerStart(NewTimerEx(this), 0.025, true, function s__MitsukiE_periodic)
    endfunction 
    
    function s__MitsukiE_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(91 , s__MitsukiE_SPELL_ID , function s__MitsukiE_actions)
    endfunction 
    
