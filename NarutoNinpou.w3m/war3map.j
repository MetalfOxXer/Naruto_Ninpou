     endfunction

 function s__NagatoChibakuTensei_pause2 takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i= 0
  local integer j
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack Big.mdx" ), (( s__NagatoChibakuTensei_target_x[this] )*1.0), (( s__NagatoChibakuTensei_target_y[this])*1.0))) // INLINED!!
		loop
			exitwhen i > 2
			set i=i + 1
			set j=0
			loop
				exitwhen j > 10
				set j=j + 1
				//call AddSpecialEffectEx("war3mapImported\\Ground Crack.mdx", GetPolarX(this.target_x, Deg2Rad(36 * j), 100 * i), GetPolarY(this.target_y, Deg2Rad(36 * j), 100 * i))
			endloop
		endloop
		loop
			set bj_lastCreatedUnit=FirstOfGroup(s__NagatoChibakuTensei_damaged[this])
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(s__NagatoChibakuTensei_damaged[this], bj_lastCreatedUnit)
			call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 3000)
			call UnitDamageTarget(s__NagatoChibakuTensei_caster[this], bj_lastCreatedUnit, 11 * GetHeroInt(s__NagatoChibakuTensei_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			call ShowUnit(bj_lastCreatedUnit, true)
			call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
			call PauseUnit(bj_lastCreatedUnit, false)
			call SetUnitPosition(bj_lastCreatedUnit, GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
		endloop
		call s__NagatoChibakuTensei_destroy(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

