        local real x2= (((GetUnitX(s__HagoromoD_Hagoromo) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__HagoromoD_Hagoromo) - 90) )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real y2= (((GetUnitY(s__HagoromoD_Hagoromo) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__HagoromoD_Hagoromo) - 90) )*1.0)) * (( 300)*1.0)) // INLINED!!
