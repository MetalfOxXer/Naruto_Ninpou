        function s__HagoromoD_handleSpell takes integer this,integer spellId,integer spellType returns nothing
            if GetUnitAbilityLevel(s__HagoromoD_Hagoromo, spellId) > 0 then
    
                if s__HagoromoD_HagoromoSpellOne == 0 and s__HagoromoD_HagoromoSpellTwo == 0 then
                    //call BJDebugMsg("Single Release")
                    set s__HagoromoD_HagoromoSpellOne=spellType
                elseif ( s__HagoromoD_HagoromoSpellOne != 0 and s__HagoromoD_HagoromoSpellOne != spellType ) and s__HagoromoD_HagoromoSpellTwo == 0 then
                    //call BJDebugMsg("Combine Release")
                    set s__HagoromoD_HagoromoSpellTwo=s__HagoromoD_HagoromoSpellOne
                    set s__HagoromoD_HagoromoSpellOne=spellType
                elseif ( s__HagoromoD_HagoromoSpellOne != 0 and s__HagoromoD_HagoromoSpellOne != spellType ) and ( s__HagoromoD_HagoromoSpellTwo != 0 and s__HagoromoD_HagoromoSpellTwo != spellType ) then
                    //call BJDebugMsg("Combine Release Reset")
                    call s__HagoromoD_resetRemovedRelease(this,s__HagoromoD_HagoromoSpellTwo)
                    set s__HagoromoD_HagoromoSpellTwo=s__HagoromoD_HagoromoSpellOne
                    set s__HagoromoD_HagoromoSpellOne=spellType
                else
                    //call BJDebugMsg("Single Release Reset")
                    call s__HagoromoD_resetRemovedRelease(this,s__HagoromoD_HagoromoSpellTwo)
                    call s__HagoromoD_resetRemovedRelease(this,s__HagoromoD_HagoromoSpellOne)
                    set s__HagoromoD_HagoromoSpellTwo=0
                    set s__HagoromoD_HagoromoSpellOne=spellType
                endif

                if s__HagoromoD_combineRelease == false and ( s__HagoromoD_ReleaseEarth == true or s__HagoromoD_ReleaseWater == true or s__HagoromoD_ReleaseFire == true or s__HagoromoD_ReleaseWind == true or s__HagoromoD_ReleaseLightning == true ) and s__HagoromoD_HagoromoCurrentCharges > 1 then
                    set s__HagoromoD_combineRelease=true
                    if spellType == 1 then
                        set s__HagoromoD_ReleaseEarth=true
                        //call BJDebugMsg("Combine Earth")
                    elseif spellType == 2 then
                        set s__HagoromoD_ReleaseWater=true
                        //call BJDebugMsg("Combine Water")
                    elseif spellType == 3 then
                        set s__HagoromoD_ReleaseFire=true
                        //call BJDebugMsg("Combine Fire")
                    elseif spellType == 4 then
                        set s__HagoromoD_ReleaseWind=true
                        //call BJDebugMsg("Combine Wind")
                    elseif spellType == 5 then
                        set s__HagoromoD_ReleaseLightning=true
                        //call BJDebugMsg("Combine Lightning")
                    endif
                else
                    if spellType == 1 then
                        set s__HagoromoD_ReleaseEarth=true
                        //call BJDebugMsg("Set Earth")
                    elseif spellType == 2 then
                        set s__HagoromoD_ReleaseWater=true
                        //call BJDebugMsg("Set Water")
                    elseif spellType == 3 then
                        set s__HagoromoD_ReleaseFire=true
                        //call BJDebugMsg("Set Fire")
                    elseif spellType == 4 then
                        set s__HagoromoD_ReleaseWind=true
                        //call BJDebugMsg("Set Wind")
                    elseif spellType == 5 then
                        set s__HagoromoD_ReleaseLightning=true
                        //call BJDebugMsg("Set Lightning")
                    endif
                    set s__HagoromoD_HagoromoCasting=true
                endif
    
                call sc__HagoromoD_filterSpell(this)
            endif
        endfunction
    
        function s__HagoromoD_filterSpell takes integer this returns nothing
            local integer i= 0
            set s__HagoromoD_combineRelease=false
    
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_SPELL_IDD)
            if s__HagoromoD_HagoromoCurrentCharges <= 0 then
                // Reset the spell history when charges reach 0
                set s__HagoromoD_HagoromoSpellPrevious=0
                set s__HagoromoD_HagoromoSpellPenultimate=0
                set s__HagoromoD_HagoromoSpellAntepenultimate=0
                call sc__HagoromoD_applyDebuffFromHistory(this)
            endif

            if s__HagoromoD_HagoromoCurrentCharges > 0 then
                if HagoromoChargesD_release != null then
                    call DestroyEffect(HagoromoChargesD_release)
		            set HagoromoChargesD_release=null
                    //call DestroyEffect(releaseOverhead)
                    loop
                        exitwhen i > 8
                        call SetUnitVertexColor(s__HagoromoChargesD_orbs[i], 255, 255, 255, 255)
                        set i=i + 1
                    endloop
                endif
                if s__HagoromoD_ReleaseEarth == true and s__HagoromoD_ReleaseWater == false and s__HagoromoD_ReleaseFire == false and s__HagoromoD_ReleaseWind == false and s__HagoromoD_ReleaseLightning == false then
                    set s__HagoromoD_HagoromoSpellCurrent=1

                    call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue)
                    set s__HagoromoD_HagoromoSpellQueue='A0OP'
                    call UnitAddAbility(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue)

                    call SetUnitVertexColor(s__HagoromoChargesD_orbs[s__HagoromoD_HagoromoCurrentCharges - 1], 139, 69, 19, 255)
                    set s__s__HagoromoD_R[s__HagoromoD_HagoromoCurrentCharges - 1]= 139
                    set s__s__HagoromoD_G[s__HagoromoD_HagoromoCurrentCharges - 1]= 69
                    set s__s__HagoromoD_B[s__HagoromoD_HagoromoCurrentCharges - 1]= 19
                    set HagoromoChargesD_release=AddSpecialEffectTarget("war3mapImported\\ReleaseEarth.mdx", s__HagoromoD_Hagoromo, "origin")
                    //call BlzSetSpecialEffectScale(release, 0.25)
                    //set releaseOverhead = AddSpecialEffectTarget("war3mapImported\\ReleaseBBEarth.mdx", this.Hagoromo, "overhead")
                elseif s__HagoromoD_ReleaseEarth == false and s__HagoromoD_ReleaseWater == true and s__HagoromoD_ReleaseFire == false and s__HagoromoD_ReleaseWind == false and s__HagoromoD_ReleaseLightning == false then
                    set s__HagoromoD_HagoromoSpellCurrent=2

                    call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue)
                    set s__HagoromoD_HagoromoSpellQueue='A0OQ'
                    call UnitAddAbility(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue)

                    call SetUnitVertexColor(s__HagoromoChargesD_orbs[s__HagoromoD_HagoromoCurrentCharges - 1], 0, 191, 255, 255)
                    set s__s__HagoromoD_R[s__HagoromoD_HagoromoCurrentCharges - 1]= 0
                    set s__s__HagoromoD_G[s__HagoromoD_HagoromoCurrentCharges - 1]= 191
                    set s__s__HagoromoD_B[s__HagoromoD_HagoromoCurrentCharges - 1]= 255
