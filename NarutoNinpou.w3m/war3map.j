//Implemented from module Alloc:
    
        function s__TemariKaimatachi_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__TemariKaimatachi_Alloc___recycle[(0)] == 0 ) then
                set s__TemariKaimatachi_Alloc___instanceCount=s__TemariKaimatachi_Alloc___instanceCount + 1
                set this=s__TemariKaimatachi_Alloc___instanceCount
            else
                set this=s__TemariKaimatachi_Alloc___recycle[(0)]
                set s__TemariKaimatachi_Alloc___recycle[(0)]=s__TemariKaimatachi_Alloc___recycle[s__TemariKaimatachi_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__TemariKaimatachi_deallocate takes integer this returns nothing
            set s__TemariKaimatachi_Alloc___recycle[this]=s__TemariKaimatachi_Alloc___recycle[(0)]
            set s__TemariKaimatachi_Alloc___recycle[(0)]=this
        endfunction
    
    
    function s__TemariKaimatachi_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__TemariKaimatachi_units[this])
            exitwhen bj_lastCreatedUnit == null
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
            call PauseUnit(bj_lastCreatedUnit, false)
            call SetUnitAnimation(bj_lastCreatedUnit, "death")
            call UnitDamageTarget(s__TemariKaimatachi_caster[this], bj_lastCreatedUnit, GetUnitAbilityLevel(s__TemariKaimatachi_caster[this], s__TemariKaimatachi_SPELL_ID) * GetHeroAgi(s__TemariKaimatachi_caster[this], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            call GroupRemoveUnit(s__TemariKaimatachi_units[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__TemariKaimatachi_units[this])
        set s__TemariKaimatachi_units[this]=null
        call s__TemariKaimatachi_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__TemariKaimatachi_spin takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        set s__TemariKaimatachi_count[this]=s__TemariKaimatachi_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__TemariKaimatachi_units[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if s__TemariKaimatachi_count[this] > 0 then
                set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(( s__TemariKaimatachi_count[this] - 1 ) * 20 + 180) )*1.0)) * (( 100)*1.0)) // INLINED!!
                set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(( s__TemariKaimatachi_count[this] - 1 ) * 20 + 180) )*1.0)) * (( 100)*1.0)) // INLINED!!
                call SetUnitX(bj_lastCreatedUnit, x)
                call SetUnitY(bj_lastCreatedUnit, y)
            endif
            set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(s__TemariKaimatachi_count[this] * 20) )*1.0)) * (( 100)*1.0)) // INLINED!!
            set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(s__TemariKaimatachi_count[this] * 20) )*1.0)) * (( 100)*1.0)) // INLINED!!
            call SetUnitX(bj_lastCreatedUnit, x)
            call SetUnitY(bj_lastCreatedUnit, y)
            call SetUnitFacing(bj_lastCreatedUnit, s__TemariKaimatachi_count[this] * 20)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__TemariKaimatachi_count[this] > 50 then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__TemariKaimatachi_units[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 1600)
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__TemariKaimatachi_tornadoes[this])
                exitwhen bj_lastCreatedUnit == null
                call KillUnit(bj_lastCreatedUnit)
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__TemariKaimatachi_tornadoes[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__TemariKaimatachi_tornadoes[this])
            set s__TemariKaimatachi_tornadoes[this]=null
            call TimerStart(NewTimerEx(this), 0.25, false, function s__TemariKaimatachi_damage)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__TemariKaimatachi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__TemariKaimatachi_tornado[this])
        local real y= GetUnitY(s__TemariKaimatachi_tornado[this])
        local real new_x= (((x )*1.0) + Cos((( s__TemariKaimatachi_angle[this] )*1.0)) * (( 25.0)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__TemariKaimatachi_angle[this] )*1.0)) * (( 25.0)*1.0)) // INLINED!!
        local unit u
        local unit u2
        local boolean find_hero= false
	if BlzGetUnitSkin(s__TemariKaimatachi_caster[this]) == 'h02I' then
        	if ModuloInteger(s__TemariKaimatachi_count[this], 5) == 0 then
            		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\shazitoushe.mdl", x, y)
            		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.1)
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__TemariKaimatachi_angle[this])
            		call DestroyEffect(bj_lastCreatedEffect)
		endif
	else
        	call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
	endif
        call SetUnitX(s__TemariKaimatachi_tornado[this], new_x)
        call SetUnitY(s__TemariKaimatachi_tornado[this], new_y)
        set s__TemariKaimatachi_count[this]=s__TemariKaimatachi_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 128.0, null)
        loop
            set u=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen u == null
            if GetWidgetLife(u) > 0.405 and IsUnitEnemy(u, GetOwningPlayer(s__TemariKaimatachi_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(u, s__TemariKaimatachi_units[this]) and not find_hero then
                set u2=CreateUnit(GetOwningPlayer(s__TemariKaimatachi_caster[this]), 'h09I', GetUnitX(u), GetUnitY(u), GetUnitFacing(u))
		if BlzGetUnitSkin(s__TemariKaimatachi_caster[this]) == 'h02I' then
	    		call SetUnitVertexColor(u2, 100, 100, 255, 255)
		endif
                call SetUnitTimeScale(u2, 1.4)
                call SetUnitAnimation(u2, "birth")
                call GroupAddUnit(s__TemariKaimatachi_tornadoes[this], u2) //CreateDummy(GetOwningPlayer(this.caster), GetUnitX(u), GetUnitY(u), GetUnitFacing(u), 1.0, 0, 0, 3.0, "Abilities\\Spells\\NightElf\\Cyclone\\CycloneTarget.mdl", true))
                call PauseUnit(u, true)
                call SetUnitFlyHeight(u, 400.0, 1200.0)
                call GroupAddUnit(s__TemariKaimatachi_units[this], u)
		if IsUnitType(u, UNIT_TYPE_HERO) == true and not IsUnitIllusion(u) then
			set find_hero=true
		endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, u)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set u2=null
        if s__TemariKaimatachi_count[this] > 32 then
            call KillUnit(s__TemariKaimatachi_tornado[this])
            call ShowUnit(s__TemariKaimatachi_tornado[this], false)
            set s__TemariKaimatachi_tornado[this]=null
            set s__TemariKaimatachi_count[this]=0
            call TimerStart(NewTimerEx(this), 0.03, true, function s__TemariKaimatachi_spin)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__TemariKaimatachi_actions takes nothing returns nothing
        local integer this= s__TemariKaimatachi_allocate()
        set s__TemariKaimatachi_caster[this]=GetTriggerUnit()
        set s__TemariKaimatachi_tornadoes[this]=CreateGroup()
        set s__TemariKaimatachi_units[this]=CreateGroup()
        set s__TemariKaimatachi_count[this]=0
        set s__TemariKaimatachi_angle[this]=Atan3(GetUnitX(s__TemariKaimatachi_caster[this]) , GetUnitY(s__TemariKaimatachi_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
