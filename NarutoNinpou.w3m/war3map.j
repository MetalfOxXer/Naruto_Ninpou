	        if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
            	call PanCameraToTimedForPlayer(GetOwningPlayer(bj_lastCreatedUnit), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
	        endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__ObitoKamuiDimension_ObitoDimension)
            exitwhen bj_lastCreatedUnit == null
            if ( RectContainsUnit(gg_rct_KamuiDimensionObito, bj_lastCreatedUnit) or RectContainsUnit(gg_rct_KaguyaLavaDimension, bj_lastCreatedUnit) or RectContainsUnit(gg_rct_JiroboPrison, bj_lastCreatedUnit) ) then
                call SetUnitPosition(bj_lastCreatedUnit, s__s__ObitoKamuiDimension_xx[id], s__s__ObitoKamuiDimension_yy[id])
            endif
            call GroupRemoveUnit(s__ObitoKamuiDimension_ObitoDimension, bj_lastCreatedUnit)
        endloop
        call TimerStart(s__s__ObitoKamuiDimension_t[id], 3.0, false, function s__ObitoKamuiDimension_finish3)
    endfunction
    
