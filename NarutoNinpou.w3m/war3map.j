			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(0, 300))
        	call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetRandomReal(0, 360)))
        	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.5)*1.0) , true) // INLINED!!
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__ShichiseikenSlash_count[this]=s__ShichiseikenSlash_count[this] + 1
		if s__ShichiseikenSlash_count[this] >= 6 then
			call DestroyEffect(AddSpecialEffect(("animeslashfinal.mdl" ), (( GetUnitX(s__ShichiseikenSlash_caster[this]) )*1.0), (( GetUnitY(s__ShichiseikenSlash_caster[this]))*1.0))) // INLINED!!
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__ShichiseikenSlash_damaged[this])
				exitwhen bj_lastCreatedUnit == null
				call UnitDamageTarget(s__ShichiseikenSlash_caster[this], bj_lastCreatedUnit, 1, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				call DestroyEffect(AddSpecialEffect(("animeslashfinal.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
				call SetUnitAnimation(bj_lastCreatedUnit, "death")
				call PauseUnit(bj_lastCreatedUnit, false)
				call GroupRemoveUnit(s__ShichiseikenSlash_damaged[this], bj_lastCreatedUnit)
			endloop
			call PauseUnit(s__ShichiseikenSlash_caster[this], false)
			//call SlowArea(this.caster, GetUnitX(this.caster), GetUnitY(this.caster), 350)
			call DestroyGroup(s__ShichiseikenSlash_damaged[this])
			set s__ShichiseikenSlash_damaged[this]=null
			set s__ShichiseikenSlash_caster[this]=null
			call s__ShichiseikenSlash_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__ShichiseikenSlash_actions takes nothing returns nothing
  local integer this= s__ShichiseikenSlash__allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Ginkaku_Q, 100, GetTriggerUnit())
        endif
		set s__ShichiseikenSlash_caster[this]=GetTriggerUnit()
		set s__ShichiseikenSlash_damaged[this]=CreateGroup()
		set s__ShichiseikenSlash_count[this]=0
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ShichiseikenSlash_caster[this]), GetUnitY(s__ShichiseikenSlash_caster[this]), 300, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ShichiseikenSlash_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
				call GroupAddUnit(s__ShichiseikenSlash_damaged[this], bj_lastCreatedUnit)
				call PauseUnit(bj_lastCreatedUnit, true)
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		call PauseUnit(s__ShichiseikenSlash_caster[this], true)
		call SetUnitAnimation(s__ShichiseikenSlash_caster[this], "Attack 1")
		call SetUnitTimeScale(s__ShichiseikenSlash_caster[this], 1.0)
		call TimerStart(NewTimerEx(this), 0.1, true, function s__ShichiseikenSlash_periodic)
 endfunction 

 function s__ShichiseikenSlash_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2((s__ShichiseikenSlash_SPELL_ID ) , Filter(( function s__ShichiseikenSlash_actions))) // INLINED!!
 endfunction

