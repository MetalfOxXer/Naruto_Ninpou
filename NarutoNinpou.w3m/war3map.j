//===========================================================================
// Trigger: KankuroRecallReleasePuppets
//===========================================================================
//TESH.scrollpos=3
//TESH.alwaysfold=0

    function s__KankuroRecallPuppets_actions takes nothing returns nothing
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        if udg_KankuroKarasu != null then
            call SetUnitX(udg_KankuroKarasu, x)
            call SetUnitY(udg_KankuroKarasu, y)
            call IssueImmediateOrder(udg_KankuroKarasu, "stop")
        endif
        if udg_KankuroKuroari != null then
            call SetUnitX(udg_KankuroKuroari, x)
            call SetUnitY(udg_KankuroKuroari, y)
            call IssueImmediateOrder(udg_KankuroKuroari, "stop")
        endif
        if udg_KankuroScorpion != null then
            call SetUnitX(udg_KankuroScorpion, x)
            call SetUnitY(udg_KankuroScorpion, y)
            call IssueImmediateOrder(udg_KankuroScorpion, "stop")
        endif
    endfunction
    
    function s__KankuroRecallPuppets_release takes nothing returns nothing
        call KillUnit(GetTriggerUnit())
    endfunction
    
    function s__KankuroRecallPuppets_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(4 , 'A06J' , function s__KankuroRecallPuppets_actions)
        call RegisterSpellEffectEventForId(4 , 'A0AU' , function s__KankuroRecallPuppets_release)
    endfunction
    
//===========================================================================
// Trigger: KarinPerfumeSpray
//===========================================================================

//Implemented from module Alloc:
    
        function s__KarinPerfumeSpray_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KarinPerfumeSpray_Alloc___recycle[(0)] == 0 ) then
                set s__KarinPerfumeSpray_Alloc___instanceCount=s__KarinPerfumeSpray_Alloc___instanceCount + 1
                set this=s__KarinPerfumeSpray_Alloc___instanceCount
            else
                set this=s__KarinPerfumeSpray_Alloc___recycle[(0)]
                set s__KarinPerfumeSpray_Alloc___recycle[(0)]=s__KarinPerfumeSpray_Alloc___recycle[s__KarinPerfumeSpray_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KarinPerfumeSpray_deallocate takes integer this returns nothing
            set s__KarinPerfumeSpray_Alloc___recycle[this]=s__KarinPerfumeSpray_Alloc___recycle[(0)]
            set s__KarinPerfumeSpray_Alloc___recycle[(0)]=this
        endfunction

    function s__KarinPerfumeSpray_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KarinPerfumeSpray_caster[this]), GetUnitY(s__KarinPerfumeSpray_caster[this]), 4000, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KarinPerfumeSpray_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and GetUnitAbilityLevel(bj_lastCreatedUnit, 'B01E') > 0 then
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KarinPerfumeSpray_caster[this]), 'h017', GetUnitX(s__KarinPerfumeSpray_caster[this]), GetUnitY(s__KarinPerfumeSpray_caster[this]), GetUnitFacing(s__KarinPerfumeSpray_caster[this]))
                call IssueTargetOrder(bj_lastCreatedUnit, "acidbomb", bj_lastCreatedUnit)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.1)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call s__KarinPerfumeSpray_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__KarinPerfumeSpray_actions takes nothing returns nothing
        local integer this= s__KarinPerfumeSpray_allocate()
        set s__KarinPerfumeSpray_caster[this]=GetTriggerUnit()
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KarinPerfumeSpray_caster[this]), GetUnitY(s__KarinPerfumeSpray_caster[this]), 1000, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if bj_lastCreatedUnit != s__KarinPerfumeSpray_caster[this] and IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(s__KarinPerfumeSpray_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    call SetUnitLifeBJ(bj_lastCreatedUnit, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE) + ( ( 45 + 20 * GetUnitAbilityLevel(s__KarinPerfumeSpray_caster[this], s__KarinPerfumeSpray_SPELL_ID) ) ))
                    call CreateTextTagUnitBJ(I2S(( ( 45 + 20 * GetUnitAbilityLevel(s__KarinPerfumeSpray_caster[this], s__KarinPerfumeSpray_SPELL_ID) ) )), bj_lastCreatedUnit, 0, 10.00, 0, 255, 0, 0)
                    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 128.00, 90)
                    call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
                    call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 2.00)
                    call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 1.00)
                    call SetTextTagAgeBJ(GetLastCreatedTextTag(), 0)
                    if not IsUnitVisible(s__KarinPerfumeSpray_caster[this], GetLocalPlayer()) then
                        call SetTextTagVisibility(bj_lastCreatedTextTag, false)
                    endif
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 0.3, false, function s__KarinPerfumeSpray_periodic)
    endfunction 

    function s__KarinPerfumeSpray_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(33 , s__KarinPerfumeSpray_SPELL_ID , function s__KarinPerfumeSpray_actions)
    endfunction 

