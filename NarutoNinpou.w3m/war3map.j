//===========================================================================

//Implemented from module Alloc:
    
        function s__ZetsuDevour_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ZetsuDevour_Alloc___recycle[(0)] == 0 ) then
                set s__ZetsuDevour_Alloc___instanceCount=s__ZetsuDevour_Alloc___instanceCount + 1
                set this=s__ZetsuDevour_Alloc___instanceCount
            else
                set this=s__ZetsuDevour_Alloc___recycle[(0)]
                set s__ZetsuDevour_Alloc___recycle[(0)]=s__ZetsuDevour_Alloc___recycle[s__ZetsuDevour_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ZetsuDevour_deallocate takes integer this returns nothing
            set s__ZetsuDevour_Alloc___recycle[this]=s__ZetsuDevour_Alloc___recycle[(0)]
            set s__ZetsuDevour_Alloc___recycle[(0)]=this
        endfunction
    
    function s__ZetsuDevour_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        call SetUnitX(s__ZetsuDevour_target[this], GetUnitX(s__ZetsuDevour_caster[this]))
        call SetUnitY(s__ZetsuDevour_target[this], GetUnitY(s__ZetsuDevour_caster[this]))
        call PauseUnit(s__ZetsuDevour_target[this], false)
        call ShowUnit(s__ZetsuDevour_target[this], true)
        call IssueImmediateOrder(s__ZetsuDevour_target[this], "stop")
        if IsUnitEnemy(s__ZetsuDevour_target[this], GetOwningPlayer(s__ZetsuDevour_caster[this])) then
            call UnitDamageTarget(s__ZetsuDevour_caster[this], s__ZetsuDevour_target[this], GetHeroInt(s__ZetsuDevour_caster[this], true) * 3, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, null)
        else
            call SetUnitState(s__ZetsuDevour_target[this], UNIT_STATE_LIFE, GetUnitState(s__ZetsuDevour_target[this], UNIT_STATE_LIFE) + GetHeroInt(s__ZetsuDevour_caster[this], true) * 3)
        endif
        call SelectUnitForPlayerSingle(s__ZetsuDevour_target[this], GetOwningPlayer(s__ZetsuDevour_target[this]))
        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl" ), (( GetUnitX(s__ZetsuDevour_target[this]) )*1.0), (( GetUnitY(s__ZetsuDevour_target[this]))*1.0))) // INLINED!!
        call s__ZetsuDevour_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__ZetsuDevour_actions takes nothing returns nothing
        local integer this= s__ZetsuDevour_allocate()
        local integer i
        set s__ZetsuDevour_target[this]=GetSpellTargetUnit()
        set s__ZetsuDevour_caster[this]=GetTriggerUnit()
        call PauseUnit(s__ZetsuDevour_target[this], true)
        call ShowUnit(s__ZetsuDevour_target[this], false)
        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl" ), (( GetUnitX(s__ZetsuDevour_target[this]) )*1.0), (( GetUnitY(s__ZetsuDevour_target[this]))*1.0))) // INLINED!!
        call TimerStart(NewTimerEx(this), 1.5, false, function s__ZetsuDevour_finish)
    endfunction
    
    function s__ZetsuDevour_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(18 , 'A02T' , function s__ZetsuDevour_actions)
    endfunction
    
//===========================================================================
// Trigger: AntiHostAFK
//===========================================================================

    function s__AntiAFK_chooseNextPlayer takes nothing returns nothing
        call DialogDisplayBJ(false, udg_Host_Dialog, udg_Host)
        set udg_Host=sc__AntiAFK_chooseHost(GetPlayerId(udg_Host) + 1)
        call TimerStart(udg_Host_Timer, 10.0, false, function sc__AntiAFK_timeOut)
        call DialogDisplayBJ(true, udg_Host_Dialog, udg_Host)
    endfunction 
    
    function s__AntiAFK_timeOut takes nothing returns nothing
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, GetPlayerName(udg_Host) + " |cff87ceebis AFK. The next player on the queue will be chosen.|r")
        call s__AntiAFK_chooseNextPlayer()
    endfunction

    function s__AntiAFK_clickDialog takes nothing returns nothing
        if GetClickedButtonBJ() == udg_Host_Dialog_Buttons[1] then
            call PauseTimer(udg_Host_Timer)
            call DestroyTimerDialog(udg_Host_Timer_Window)
            set udg_CanSelectModes=true
        else
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, GetPlayerName(udg_Host) + " |cff87ceebrefuses to choose modes. The next player on the queue will be chosen.|r")
            call s__AntiAFK_chooseNextPlayer()
        endif
    endfunction
    
    function s__AntiAFK_createTimer takes nothing returns nothing
        call CreateTimerDialogBJ(udg_Host_Timer, "Choose modes")
        set udg_Host_Timer_Window=GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ(true, udg_Host_Timer_Window)
    endfunction
    
    function s__AntiAFK_createDialog takes nothing returns nothing
        call DialogClear(udg_Host_Dialog)
        call DialogSetMessageBJ(udg_Host_Dialog, "Do you want to choose modes?")
        call DialogAddButtonBJ(udg_Host_Dialog, "Yes")
        set udg_Host_Dialog_Buttons[1]=GetLastCreatedButtonBJ()
        call DialogAddButtonBJ(udg_Host_Dialog, "No")
        set udg_Host_Dialog_Buttons[2]=GetLastCreatedButtonBJ()
    endfunction 
    
    function s__AntiAFK_chooseHost takes integer i returns player
        local integer j
        set j=i
        loop
            exitwhen j > 11
            if GetPlayerController(Player(j)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(j)) == PLAYER_SLOT_STATE_PLAYING then
                return Player(j)
            endif
            set j=j + 1
        endloop
        set j=0
        loop
            exitwhen j > 11
            if GetPlayerController(Player(j)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(j)) == PLAYER_SLOT_STATE_PLAYING then
                return Player(j)
            endif
            set j=j + 1
        endloop
        return Player(0)
    endfunction
    
    function s__AntiAFK_actions takes nothing returns nothing
        local trigger t= CreateTrigger()
        local integer hostplayer
        local integer i
        local integer length
        call TriggerRegisterDialogEventBJ(t, udg_Host_Dialog)
        call TriggerAddAction(t, function s__AntiAFK_clickDialog)
        set hostplayer=0
        set udg_Host=s__AntiAFK_chooseHost(hostplayer)
        call s__AntiAFK_createDialog()
        call s__AntiAFK_createTimer()
        call TimerStart(udg_Host_Timer, 10.0, false, function s__AntiAFK_timeOut)
        call DialogDisplayBJ(true, udg_Host_Dialog, udg_Host)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__AntiAFK_onInit takes nothing returns nothing
        set udg_Host=Player(0)
        call TimerStartEx((NewTimerEx(0)) , 1.0 , false , function s__AntiAFK_actions , "AntiHostAFK_actions") // INLINED!!
    endfunction
        
