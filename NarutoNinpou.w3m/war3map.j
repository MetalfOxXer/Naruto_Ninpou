    function s__KakashiKamui_littleDelay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakashiKamui_caster[this]), 'u008', s__KakashiKamui_target_x[this], s__KakashiKamui_target_y[this], 270)
        call KillUnit(bj_lastCreatedUnit)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__KakashiKamui_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            call ShowUnit(bj_lastCreatedUnit, true)
            if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
            endif
            call SetUnitInvulnerable(bj_lastCreatedUnit, false)
            call PauseUnit(bj_lastCreatedUnit, false)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
	    set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__KakashiKamui_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
	    call UnitDamageTarget(s__KakashiKamui_caster[this], bj_lastCreatedUnit, 10 * GetHeroAgi(s__KakashiKamui_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call ShowUnit(s__KakashiKamui_dummy[this], false)
        set s__KakashiKamui_dummy[this]=null
        call ShowUnit(s__KakashiKamui_dummy2[this], false)
        call KillUnit(s__KakashiKamui_dummy2[this])
        set s__KakashiKamui_dummy2[this]=null
        call DestroyGroup(s__KakashiKamui_damaged[this])
        set s__KakashiKamui_damaged[this]=null
        call s__KakashiKamui_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    


    function s__KakashiKamui_pull takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        set s__KakashiKamui_count[this]=s__KakashiKamui_count[this] + 1
        call sc__KakashiKamui_enumUnits(this)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__KakashiKamui_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if not IsUnitHidden(bj_lastCreatedUnit) then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(x , y , s__KakashiKamui_target_x[this] , s__KakashiKamui_target_y[this])
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 5)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 5)*1.0)) // INLINED!!
                call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                if GetDistance(new_x , new_y , s__KakashiKamui_target_x[this] , s__KakashiKamui_target_y[this]) < 75 then
                    call ShowUnit(bj_lastCreatedUnit, false)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KakashiKamui_count[this] > 25 then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__KakashiKamui_damaged[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if not IsUnitHidden(bj_lastCreatedUnit) then
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call ShowUnit(bj_lastCreatedUnit, false)
                    call SetUnitInvulnerable(bj_lastCreatedUnit, true)
                endif
                call SetUnitX(bj_lastCreatedUnit, s__KakashiKamui_target_x[this])
                call SetUnitY(bj_lastCreatedUnit, s__KakashiKamui_target_y[this])
                call IssueImmediateOrder(bj_lastCreatedUnit, "stop")
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__KakashiKamui_count[this]=0
            call KillUnit(s__KakashiKamui_dummy[this])
            call TimerStart(NewTimerEx(this), 2.0, false, function s__KakashiKamui_littleDelay)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__KakashiKamui_enumUnits takes integer this returns nothing
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KakashiKamui_target_x[this], s__KakashiKamui_target_y[this], 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiKamui_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__KakashiKamui_damaged[this]) then
                call GroupAddUnit(s__KakashiKamui_damaged[this], bj_lastCreatedUnit)
                call PauseUnit(bj_lastCreatedUnit, true)
                call SetUnitInvulnerable(bj_lastCreatedUnit, true)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction 

    function s__KakashiKamui_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitDamageTarget(s__KakashiKamui_caster[this], s__KakashiKamui_caster[this], GetUnitState(s__KakashiKamui_caster[this], UNIT_STATE_MAX_LIFE) * 0.2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        call TimerStart(NewTimerEx(this), 0.04, true, function s__KakashiKamui_pull)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__KakashiKamui_actions takes nothing returns nothing
        local integer this= s__KakashiKamui_allocate()
        set s__KakashiKamui_caster[this]=GetTriggerUnit()
        set s__KakashiKamui_count[this]=0
        set s__KakashiKamui_damaged[this]=CreateGroup()
        set s__KakashiKamui_target_x[this]=GetSpellTargetX()
        set s__KakashiKamui_target_y[this]=GetSpellTargetY()
        set s__KakashiKamui_dummy[this]=CreateUnit(GetTriggerPlayer(), 'h029', s__KakashiKamui_target_x[this], s__KakashiKamui_target_y[this], 270)
        set s__KakashiKamui_dummy2[this]=CreateUnit(GetTriggerPlayer(), 'n02A', s__KakashiKamui_target_x[this], s__KakashiKamui_target_y[this], 270)
        call SetUnitAnimation(s__KakashiKamui_dummy2[this], "birth")
        call SetUnitTimeScale(s__KakashiKamui_dummy2[this], 0.5)
        call SetUnitFlyHeight(s__KakashiKamui_dummy2[this], 300, 0)
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            if BlzGetUnitSkin(GetTriggerUnit()) == 'h0AS' then
                call PlaySoundOnUnitBJ(gg_snd_FemKakashi_Jounin_T, 100.0, GetTriggerUnit())
            else
                call PlaySoundOnUnitBJ(gg_snd_Kakashi_Jounin_T, 100.0, GetTriggerUnit())
            endif
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Kakashi: Disappear!|r")
        endif
        call TimerStartEx(NewTimerEx(this) , 0.5 , false , function s__KakashiKamui_delay , "KakashiKamui_delay")
    endfunction 
    
    function s__KakashiKamui_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(11 , s__KakashiKamui_SPELL_ID , function s__KakashiKamui_actions)
    endfunction 
    
