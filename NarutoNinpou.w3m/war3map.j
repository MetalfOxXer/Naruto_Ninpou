			call CreateTextTagUnitBJ("Got blood for 15 seconds", s__HidanRScythe_caster[this], 0, 10.00, 100, 100.00, 100.00, 0)
            call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
            call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 3.00)
            if not IsUnitVisible(s__HidanRScythe_caster[this], GetLocalPlayer()) then
				call SetTextTagVisibility(GetLastCreatedTextTag(), false)
            endif

			set damage=GetUnitState(s__HidanRScythe_caster[this], UNIT_STATE_MAX_LIFE) * 0.10
			call UnitDamageTarget(s__HidanRScythe_caster[this], s__HidanRScythe_target[this], ( GetHeroStr(s__HidanRScythe_caster[this], true) * GetUnitAbilityLevel(s__HidanRScythe_caster[this], s__HidanRScythe_SPELL_ID) ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
			call UnitDamageTarget(s__HidanRScythe_caster[this], s__HidanRScythe_target[this], damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			call KillUnit(s__HidanRScythe_scythe[this])
			call ShowUnit(s__HidanRScythe_scythe[this], false)
			set s__HidanRScythe_scythe[this]=null
			set s__HidanRScythe_target[this]=null
			call s__Lightning_release((s__HidanRScythe_l[this]),0.) // INLINED!!
			call s__HidanRScythe_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
