function s__PakuraW_periodic3 takes nothing returns nothing
    local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
    local real x
    local real y
    local real new_x
    local real new_y
    local real distance
    local real angle
    local real knockbackStep
    local real totalKnockback
    local real progressDistance
    set bj_lastCreatedGroup=CreateGroup()
    call GroupAddGroup(s__PakuraW_damaged[this], bj_lastCreatedGroup)
    loop
        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
        exitwhen bj_lastCreatedUnit == null
        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        set x=GetUnitX(bj_lastCreatedUnit)
        set y=GetUnitY(bj_lastCreatedUnit)
        set distance=GetDistance(x , y , s__PakuraW_fireball_x[this] , s__PakuraW_fireball_y[this])
        if distance > 400 then
            set distance=400
        endif
        set angle=Atan3(s__PakuraW_fireball_x[this] , s__PakuraW_fireball_y[this] , x , y)

        set knockbackStep=40 - ( ( distance / 400 ) * 20 )
        set totalKnockback=knockbackStep * 9
        set progressDistance=knockbackStep * s__PakuraW_count[this]

        set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( knockbackStep)*1.0)) // INLINED!!
        set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( knockbackStep)*1.0)) // INLINED!!

        if s__PakuraW_count[this] == 9 then
            call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 0)
        else
            call SetUnitFlyHeight(bj_lastCreatedUnit, ParabolaZ(200 , totalKnockback , progressDistance), 0)
        endif

        if IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            if IsTerrainPathable((((x )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)), (((y )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
                if IsTerrainPathable((((x )*1.0) + Cos((( angle )*1.0)) * (( 200)*1.0)), (((y )*1.0) + Sin((( angle )*1.0)) * (( 200)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
                    if IsTerrainPathable((((x )*1.0) + Cos((( angle )*1.0)) * (( 300)*1.0)), (((y )*1.0) + Sin((( angle )*1.0)) * (( 300)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
                        if IsTerrainPathable((((x )*1.0) + Cos((( angle )*1.0)) * (( 400)*1.0)), (((y )*1.0) + Sin((( angle )*1.0)) * (( 400)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
                            set new_x=x
                            set new_y=y
                        endif
                    endif
                endif
            endif
        endif

        call SetUnitX(bj_lastCreatedUnit, new_x)
        call SetUnitY(bj_lastCreatedUnit, new_y)
    endloop
    call DestroyGroup(bj_lastCreatedGroup)
    set s__PakuraW_count[this]=s__PakuraW_count[this] + 1
    if s__PakuraW_count[this] > 9 then
        call DestroyGroup(s__PakuraW_damaged[this])
        set s__PakuraW_damaged[this]=null
        call s__PakuraW_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endif
endfunction


    function s__PakuraW_periodic2 takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
					set s__PakuraW_count[this]=s__PakuraW_count[this] + 1
					//call SetUnitFacing(this.fireball,(GetUnitFacing(this.fireball)+10.00))
					if s__PakuraW_count[this] > 100 or s__PakuraW_explode then
						set s__PakuraW_count[this]=0
						set bj_lastCreatedEffect=AddSpecialEffect("LW10.mdl", s__PakuraW_fireball_x[this], s__PakuraW_fireball_y[this])
						call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.6)
						call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
						call DestroyEffect(bj_lastCreatedEffect)

						call KillUnit(s__PakuraW_fireball[this])
						call ShowUnit(s__PakuraW_fireball[this], false)
						set s__PakuraW_fireball[this]=null
						set bj_lastCreatedGroup=CreateGroup()
						set s__PakuraW_instance=this
						call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__PakuraW_fireball_x[this], s__PakuraW_fireball_y[this], 300, Filter(function s__PakuraW_dealDamage))
						call DestroyGroup(bj_lastCreatedGroup)
						call UnitRemoveAbility(s__PakuraW_caster[this], 'A0UT')
						call SetPlayerAbilityAvailable(GetOwningPlayer(s__PakuraW_caster[this]), s__PakuraW_SPELL_ID, true)
						call TimerStart(NewTimerEx(this), 0.03, true, function s__PakuraW_periodic3)
						call ReleaseTimer(GetExpiredTimer())
					endif
    endfunction
			   
				
    function s__PakuraW_periodic takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
     local real x= GetUnitX(s__PakuraW_fireball[this])
     local real y= GetUnitY(s__PakuraW_fireball[this])
     local real angle= Atan3(x , y , s__PakuraW_x[this] , s__PakuraW_y[this])
     local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
     local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
     local integer i
					call SetUnitX(s__PakuraW_fireball[this], new_x)
					call SetUnitY(s__PakuraW_fireball[this], new_y)
					call SetUnitFlyHeight(s__PakuraW_fireball[this], ParabolaZ(400 , s__PakuraW_distance[this] , s__PakuraW_distance[this] - GetDistance(new_x , new_y , s__PakuraW_x[this] , s__PakuraW_y[this])), 0)
					if GetDistance(new_x , new_y , s__PakuraW_x[this] , s__PakuraW_y[this]) < 100 or s__PakuraW_count[this] >= 50 then
						set s__PakuraW_count[this]=0
						set s__PakuraW_fireball_x[this]=GetUnitX(s__PakuraW_fireball[this])
						set s__PakuraW_fireball_y[this]=GetUnitY(s__PakuraW_fireball[this])
						call SetUnitFlyHeight(s__PakuraW_fireball[this], 100, 0)
						set i=0
						loop
							exitwhen i > 6
							set x=(((s__PakuraW_fireball_x[this] )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
							set y=(((s__PakuraW_fireball_y[this] )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!

