 function s__YamanakaBindingPupppet_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real new_caster_hp= GetUnitState(s__YamanakaBindingPupppet_puppet[this], UNIT_STATE_LIFE)
  local real new_casters_hp= GetUnitState(s__YamanakaBindingPupppet_caster[this], UNIT_STATE_LIFE)
  local real new_target_hp= GetUnitState(s__YamanakaBindingPupppet_target[this], UNIT_STATE_LIFE)
		set s__YamanakaBindingPupppet_count[this]=s__YamanakaBindingPupppet_count[this] + 0.06
		if s__YamanakaBindingPupppet_count[this] > 50 or GetWidgetLife(s__YamanakaBindingPupppet_puppet[this]) < 0.405 or GetDistanceUnits(s__YamanakaBindingPupppet_caster[this] , s__YamanakaBindingPupppet_target[this]) > 8000 then
			call s__Lightning_release((s__YamanakaBindingPupppet_l[this]),0.) // INLINED!!
			call s__YamanakaBindingPupppet_deallocate(this)
			call KillUnit(s__YamanakaBindingPupppet_puppet[this])
			set s__YamanakaBindingPupppet_puppet[this]=null
			call ReleaseTimer(GetExpiredTimer())
		else
			if new_caster_hp < s__YamanakaBindingPupppet_caster_hp[this] then
				call UnitDamageTarget(s__YamanakaBindingPupppet_caster[this], s__YamanakaBindingPupppet_target[this], ( s__YamanakaBindingPupppet_caster_hp[this] - new_caster_hp ) / 2.0 * GetUnitAbilityLevel(s__YamanakaBindingPupppet_caster[this], s__YamanakaBindingPupppet_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			endif
                        //call UnitDamageTarget(this.caster, this.target, GetUnitState(this.target, UNIT_STATE_MAX_LIFE) * 0.01 / 33, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			if s__YamanakaBindingPupppet_target_hp[this] - new_target_hp > 0 then
				call SetUnitState(s__YamanakaBindingPupppet_caster[this], UNIT_STATE_LIFE, ( new_casters_hp + ( s__YamanakaBindingPupppet_target_hp[this] - new_target_hp ) ))
			endif
			set s__YamanakaBindingPupppet_caster_hp[this]=GetUnitState(s__YamanakaBindingPupppet_puppet[this], UNIT_STATE_LIFE)
			set s__YamanakaBindingPupppet_target_hp[this]=GetUnitState(s__YamanakaBindingPupppet_target[this], UNIT_STATE_LIFE)
		endif
 endfunction 

 function s__YamanakaBindingPupppet_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call TimerStart(NewTimerEx(this), 0.03, true, function s__YamanakaBindingPupppet_periodic)
		call PauseUnit(s__YamanakaBindingPupppet_target[this], false)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__YamanakaBindingPupppet_actions takes nothing returns nothing
  local integer this= s__YamanakaBindingPupppet_allocate()
		set s__YamanakaBindingPupppet_caster[this]=GetTriggerUnit()
		set s__YamanakaBindingPupppet_target[this]=GetSpellTargetUnit()
    		set s__YamanakaBindingPupppet_puppet[this]=(CreateUnit((GetOwningPlayer(s__YamanakaBindingPupppet_target[this]) ), ( 'n00Q' ), (( GetUnitX(s__YamanakaBindingPupppet_caster[this]) )*1.0), (( GetUnitY(s__YamanakaBindingPupppet_caster[this]) )*1.0), (( 270.0)*1.0))) // INLINED!!
		call BlzSetUnitSkin(s__YamanakaBindingPupppet_puppet[this], BlzGetUnitSkin(s__YamanakaBindingPupppet_target[this]))
		call BlzSetUnitMaxHP(s__YamanakaBindingPupppet_puppet[this], R2I(GetUnitState(s__YamanakaBindingPupppet_target[this], UNIT_STATE_MAX_LIFE)))
		call SetUnitState(s__YamanakaBindingPupppet_puppet[this], UNIT_STATE_LIFE, GetUnitState(s__YamanakaBindingPupppet_puppet[this], UNIT_STATE_MAX_LIFE) / 2 + ( GetHeroInt(s__YamanakaBindingPupppet_caster[this], true) * 3 ))
    		call UnitApplyTimedLife(s__YamanakaBindingPupppet_puppet[this], 'BTLF', 15.0)
		call SetUnitAnimation(s__YamanakaBindingPupppet_puppet[this], "Stand Alternate")
 		set s__YamanakaBindingPupppet_l[this]=s__Lightning_create("AFOD" , true , 0.5)
        	call s__Lightning_attachToUnit(s__YamanakaBindingPupppet_l[this],true , s__YamanakaBindingPupppet_puppet[this] , 60)
		call s__Lightning_attachToUnit(s__YamanakaBindingPupppet_l[this],false , s__YamanakaBindingPupppet_target[this] , 60)
		set s__YamanakaBindingPupppet_caster_hp[this]=GetUnitState(s__YamanakaBindingPupppet_puppet[this], UNIT_STATE_LIFE)
		set s__YamanakaBindingPupppet_target_hp[this]=GetUnitState(s__YamanakaBindingPupppet_target[this], UNIT_STATE_LIFE)
		set s__YamanakaBindingPupppet_count[this]=0
		//set bj_lastCreatedUnit = CreateAbilityDummy(this.caster, 'A12Y')
		//call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A12Y', GetUnitAbilityLevel(this.caster, SPELL_ID))
		//call IssueTargetOrder(bj_lastCreatedUnit, "faeriefire", this.target)
		call PauseUnit(s__YamanakaBindingPupppet_target[this], true)
		call TimerStart(NewTimerEx(this), 0.1, false, function s__YamanakaBindingPupppet_delay)
 endfunction 

 function s__YamanakaBindingPupppet_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2((s__YamanakaBindingPupppet_SPELL_ID ) , Filter(( function s__YamanakaBindingPupppet_actions))) // INLINED!!
 endfunction 

