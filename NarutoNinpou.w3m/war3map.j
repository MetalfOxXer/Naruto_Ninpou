    function s__GaaraBijuuMode_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if GetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE) < s__GaaraBijuuMode_hp[this] then
            call SetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE, GetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE) + ( s__GaaraBijuuMode_hp[this] - GetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE) ) * 0.25)
        endif
        set s__GaaraBijuuMode_hp[this]=GetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0WR', false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A02Y', false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0DY', false)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0AW', false)
        //call SetPlayerAbilityAvailable(GetOwningPlayer(this.caster),'A0KE',false)
        if GetUnitTypeId(s__GaaraBijuuMode_caster[this]) == 'H00C' then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0WR', true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A02Y', true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0DY', true)
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaaraBijuuMode_caster[this]), 'A0AW', true)
            //call SetPlayerAbilityAvailable(GetOwningPlayer(this.caster),'A0KE',true)
	    call SetUnitFlyHeight(s__GaaraBijuuMode_caster[this], 200, 0)
	    call AddUnitAnimationProperties(s__GaaraBijuuMode_caster[this], "alternate", true)
            call s__GaaraBijuuMode_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__GaaraBijuuMode_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__GaaraBijuuMode_hp[this]=GetUnitState(s__GaaraBijuuMode_caster[this], UNIT_STATE_LIFE)
	call SetUnitFlyHeight(s__GaaraBijuuMode_caster[this], 0, 0)
        call TimerStart(NewTimerEx(this), 0.05, true, function s__GaaraBijuuMode_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__GaaraBijuuMode_actions takes nothing returns nothing
        local integer this
        local integer i
        if GetUnitTypeId(GetTriggerUnit()) == 'H00C' then
            set this=s__GaaraBijuuMode_allocate()
            set s__GaaraBijuuMode_caster[this]=GetTriggerUnit()
            call TimerStart(NewTimerEx(this), 0.01, false, function s__GaaraBijuuMode_delay)
        endif
        set i=0
        loop
            exitwhen i > 50
            set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Wind.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(1.0, 3.0))
            call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, GetRandomReal(0.5, 2.0))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(0, 300))
            call DestroyEffect(bj_lastCreatedEffect)
            set i=i + 1
        endloop
    endfunction 

    function s__GaaraBijuuMode_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(15 , s__GaaraBijuuMode_SPELL_ID , function s__GaaraBijuuMode_actions)
    endfunction 

