        call UnitAddAbility(s__NejiNewW_dummy[this], 'A09R')
        call SetUnitAnimation(s__NejiNewW_dummy[this], "spell spin")
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__NejiNewW_caster[this]) )*1.0), (( GetUnitY(s__NejiNewW_caster[this]))*1.0))) // INLINED!!
        call SetUnitVertexColor((s__NejiNewW_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 0)) // INLINED!!
        set s__NejiNewW_count[this]=0
        set s__NejiNewW_damaged[this]=CreateGroup()
	call SetUnitInvulnerable(s__NejiNewW_caster[this], true)
        call AddLoadingBar(s__NejiNewW_caster[this] , 1.0)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__NejiNewW_periodic)
    endfunction 
    
