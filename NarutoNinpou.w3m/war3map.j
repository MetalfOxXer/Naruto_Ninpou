    function s__OhnokiGenkiHakuri_disappear takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	set bj_lastCreatedGroup=CreateGroup()
	call GroupAddGroup(s__OhnokiGenkiHakuri_damaged[this], bj_lastCreatedGroup)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		call ShowUnit(bj_lastCreatedUnit, false)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
        call RecycleUnit(s__OhnokiGenkiHakuri_cube[this])
        call TimerStart(NewTimerEx(this), 1.0, false, function s__OhnokiGenkiHakuri_damage)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__OhnokiGenkiHakuri_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real distance= GetDistance(GetUnitX(s__OhnokiGenkiHakuri_cube[this]) , GetUnitY(s__OhnokiGenkiHakuri_cube[this]) , s__OhnokiGenkiHakuri_target_x[this] , s__OhnokiGenkiHakuri_target_y[this])
        local real size= 0.05 + ( s__OhnokiGenkiHakuri_distance[this] - distance ) / s__OhnokiGenkiHakuri_distance[this] * 0.5
        local real x
        local real y
        local real new_x
        local real new_y
        local real angle
        local real dist
        local integer i
        if size < 0.5 then
            call SetUnitScale(s__OhnokiGenkiHakuri_cube[this], size, 0, 0)
        endif
        set x=GetUnitX(s__OhnokiGenkiHakuri_cube[this])
        set y=GetUnitY(s__OhnokiGenkiHakuri_cube[this])
        set angle=Atan3(x , y , s__OhnokiGenkiHakuri_target_x[this] , s__OhnokiGenkiHakuri_target_y[this])
        set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        set dist=GetDistance(x , y , s__OhnokiGenkiHakuri_target_x[this] , s__OhnokiGenkiHakuri_target_y[this])
        call SetUnitX(s__OhnokiGenkiHakuri_cube[this], new_x)
        call SetUnitY(s__OhnokiGenkiHakuri_cube[this], new_y)
        if dist <= 100 then
            set i=1
            loop
                exitwhen i > 5
                set bj_lastCreatedUnit=GetDummy(GetOwningPlayer(s__OhnokiGenkiHakuri_caster[this]) , "SuperShinyThingy.mdl" , GetUnitX(s__OhnokiGenkiHakuri_cube[this]) , GetUnitY(s__OhnokiGenkiHakuri_cube[this]) , GetRandomReal(0, 360))
                call SetUnitFlyHeight(bj_lastCreatedUnit, 100, 0)
                call SetUnitScale(bj_lastCreatedUnit, 2.5, 2.5, 2.5)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
                set i=i + 1
            endloop
	    set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__OhnokiGenkiHakuri_target_x[this], s__OhnokiGenkiHakuri_target_y[this], 300, null)
            loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__OhnokiGenkiHakuri_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
			call PauseUnit(bj_lastCreatedUnit, true)
			call GroupAddUnit(s__OhnokiGenkiHakuri_damaged[this], bj_lastCreatedUnit)
		endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            call TimerStart(NewTimerEx(this), 1.0, false, function s__OhnokiGenkiHakuri_disappear)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    

    function s__OhnokiGenkiHakuri_actions takes nothing returns nothing
        local integer this= s__OhnokiGenkiHakuri_allocate()
 local real angle= Atan2(( GetSpellTargetY() - GetUnitY(GetTriggerUnit()) ), ( GetSpellTargetX() - GetUnitX(GetTriggerUnit()) ))
        local real new_x= GetUnitX(GetTriggerUnit()) + Cos(angle) * 100
        local real new_y= GetUnitY(GetTriggerUnit()) + Sin(angle) * 100
        local real distance_x= new_x - GetSpellTargetX()
        local real distance_y= new_y - GetSpellTargetY()
        local real distance= SquareRoot(distance_x * distance_x + distance_y * distance_y)
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            if BlzGetUnitSkin(GetTriggerUnit()) == 'h05H' then
		        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Tatsumaki: You disgust me. Leave.|r")
                call PlaySoundOnUnitBJ(gg_snd_TatsumakiR, 100.0, GetTriggerUnit())
            else
                call PlaySoundOnUnitBJ(gg_snd_Onooki_R, 100.0, GetTriggerUnit())
            endif
        endif
        set s__OhnokiGenkiHakuri_caster[this]=GetTriggerUnit()
        set s__OhnokiGenkiHakuri_target_x[this]=GetSpellTargetX()
        set s__OhnokiGenkiHakuri_target_y[this]=GetSpellTargetY()
        set s__OhnokiGenkiHakuri_damaged[this]=CreateGroup()
        set s__OhnokiGenkiHakuri_cube[this]=CreateUnit(GetTriggerPlayer(), 'e01Z', GetUnitX(s__OhnokiGenkiHakuri_caster[this]), GetUnitY(s__OhnokiGenkiHakuri_caster[this]), GetUnitFacing(s__OhnokiGenkiHakuri_caster[this])) //GetDummy(GetTriggerPlayer(), "Effects\\s_Jinton.mdl", GetUnitX(this.caster), GetUnitY(this.caster), GetUnitFacing(this.caster))
        if BlzGetUnitSkin(s__OhnokiGenkiHakuri_caster[this]) == 'h05H' then
            call SetUnitVertexColor(s__OhnokiGenkiHakuri_cube[this], 0, 240, 200, 255)
        endif
        call SetUnitScale(s__OhnokiGenkiHakuri_cube[this], 0.05, 0.05, 0.05)
        //call SetUnitVertexColor(this.cube, 255, 255, 255, 120)
        //call SetUnitFlyHeight(this.cube, 0, 333)
        set s__OhnokiGenkiHakuri_distance[this]=GetDistance(GetUnitX(s__OhnokiGenkiHakuri_cube[this]) , GetUnitY(s__OhnokiGenkiHakuri_cube[this]) , s__OhnokiGenkiHakuri_target_x[this] , s__OhnokiGenkiHakuri_target_y[this])
        //call PauseUnit(this.caster, true)
        call SetUnitAnimation(s__OhnokiGenkiHakuri_caster[this], "spell")
        call TimerStart(NewTimerEx(this), 0.03 - distance / 100000, true, function s__OhnokiGenkiHakuri_move)
    endfunction
    
    function s__OhnokiGenkiHakuri_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(39 , 'A0EV' , function s__OhnokiGenkiHakuri_actions)
    endfunction
    
