                    //Haku
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'H071' then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Tsunade & Sakura
                    elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H00H' or GetUnitTypeId(GetTriggerUnit()) == 'E00V' ) then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Yugito
                    elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H0B2' or GetUnitTypeId(GetTriggerUnit()) == 'H0B4' ) then
                        set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Pillar of Flame Blue.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
                        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
                    //Temari
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'H02P' then
                        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Wind Blast - Classic.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Hanabi & Hinata & Neji
                    elseif ( GetUnitTypeId(GetTriggerUnit()) == 'E000' or GetUnitTypeId(GetTriggerUnit()) == 'H09G' or GetUnitTypeId(GetTriggerUnit()) == 'H06Z' or GetUnitTypeId(GetTriggerUnit()) == 'H000' ) then
                        call DestroyEffect(AddSpecialEffect(("ByakuganHitEffect.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Anko
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'U01G' then
                        call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Kaguya
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'N013' then
                        call DestroyEffect(AddSpecialEffect(("Mr.War3_SKM.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    else
                        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    endif
                else
                    set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
                    set distance=GetDistance(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY()) + 200
                    loop
                        exitwhen distance <= 0
                        set distance=distance - 50
                        set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle )*1.0)) * (( distance)*1.0)) // INLINED!!
                        set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle )*1.0)) * (( distance)*1.0)) // INLINED!!
                        if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                            // minato special effect 
                            if GetUnitTypeId(GetTriggerUnit()) == 'H086' or GetUnitTypeId(GetTriggerUnit()) == 'H082' or GetUnitTypeId(GetTriggerUnit()) == 'H072' then
                                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            // itachi special effect
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N001' or GetUnitTypeId(GetTriggerUnit()) == 'N025' then
                                call DestroyEffect(AddSpecialEffect(("ItachiE.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            // ichigo special effect
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'U00A' or GetUnitTypeId(GetTriggerUnit()) == 'U00G' or GetUnitTypeId(GetTriggerUnit()) == 'H0A7' then
                                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Kurenai/Ino
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N01M' or GetUnitTypeId(GetTriggerUnit()) == 'N00J' then
                                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Pink_Wind.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Darui/Ringo/Anbu Kakashi/Hebi Sasuke
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'E00F' or GetUnitTypeId(GetTriggerUnit()) == 'U00K' or GetUnitTypeId(GetTriggerUnit()) == 'H07A' or GetUnitTypeId(GetTriggerUnit()) == 'U00H' or GetUnitTypeId(GetTriggerUnit()) == 'U00I' then
                                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Lightning_Cloud_Strike_2.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.45)
                                call DestroyEffect(bj_lastCreatedEffect)
                            //Haku
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'H071' then
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Tsunade & Sakura
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H00H' or GetUnitTypeId(GetTriggerUnit()) == 'E00V' ) then
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Yugito
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H0B2' or GetUnitTypeId(GetTriggerUnit()) == 'H0B4' ) then
                                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Pillar of Flame Blue.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
                                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
                            //Temari
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'H02P' then
                                set bj_lastCreatedEffect=AddSpecialEffect("DustWindFaster3.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY()))
                                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.8)
                                call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())) + 50)
                                call DestroyEffect(bj_lastCreatedEffect)
                            //Hanabi & Hinata & Neji
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'E000' or GetUnitTypeId(GetTriggerUnit()) == 'H09G' or GetUnitTypeId(GetTriggerUnit()) == 'H06Z' or GetUnitTypeId(GetTriggerUnit()) == 'H000' ) then
                                call DestroyEffect(AddSpecialEffect(("ByakuganHitEffect.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Anko
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'U01G' then
                                set k=0
                                loop
                                    exitwhen k > 12
                                    set angle1=GetRandomReal(0, 2 * bj_PI)
                                    set offset=GetRandomReal(0, 200)
                                    set x4=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle1 )*1.0)) * (( offset)*1.0)) // INLINED!!
                                    set y4=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle1 )*1.0)) * (( offset)*1.0)) // INLINED!!
                                    set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e05B', x4, y4, k * 10)
                                    call SetUnitScale(bj_lastCreatedUnit, 0.5, 0.5, 0.5)
                                    call SetUnitMoveSpeed(bj_lastCreatedUnit, 522)
                                    set x4=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(k * 30) )*1.0)) * (( 1200)*1.0)) // INLINED!!
                                    set y4=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(k * 30) )*1.0)) * (( 1200)*1.0)) // INLINED!!
                                    call IssuePointOrder(bj_lastCreatedUnit, "move", x4, y4)
                                    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
                                    set k=k + 1
                                endloop
                            //Kaguya
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N013' then
                                call DestroyEffect(AddSpecialEffect(("Mr.War3_SKM.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            else
                                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            endif
                            call SetUnitX(GetTriggerUnit(), x)
                            call SetUnitY(GetTriggerUnit(), y)
                            // minato special effect 
                            if GetUnitTypeId(GetTriggerUnit()) == 'H086' or GetUnitTypeId(GetTriggerUnit()) == 'H082' or GetUnitTypeId(GetTriggerUnit()) == 'H072' then
                                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            // itachi special effect
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N001' or GetUnitTypeId(GetTriggerUnit()) == 'N025' then
                                call DestroyEffect(AddSpecialEffect(("ItachiE.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            // ichigo special effect
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'U00A' or GetUnitTypeId(GetTriggerUnit()) == 'U00G' or GetUnitTypeId(GetTriggerUnit()) == 'H0A7' then
                                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Kurenai/Ino
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N01M' or GetUnitTypeId(GetTriggerUnit()) == 'N00J' then
                                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Pink_Wind.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Darui/Ringo/Anbu Kakashi/Hebi Sasuke
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'E00F' or GetUnitTypeId(GetTriggerUnit()) == 'U00K' or GetUnitTypeId(GetTriggerUnit()) == 'H07A' or GetUnitTypeId(GetTriggerUnit()) == 'U00H' or GetUnitTypeId(GetTriggerUnit()) == 'U00I' then
                                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Lightning_Cloud_Strike_2.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.45)
                                call DestroyEffect(bj_lastCreatedEffect)
                            //Haku
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'H071' then
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Tsunade & Sakura
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H00H' or GetUnitTypeId(GetTriggerUnit()) == 'E00V' ) then
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Yugito
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'H0B2' or GetUnitTypeId(GetTriggerUnit()) == 'H0B4' ) then
                                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Pillar of Flame Blue.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
                                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
                            //Temari
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'H02P' then
                                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Wind Blast - Classic.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Hanabi & Hinata & Neji
                            elseif ( GetUnitTypeId(GetTriggerUnit()) == 'E000' or GetUnitTypeId(GetTriggerUnit()) == 'H09G' or GetUnitTypeId(GetTriggerUnit()) == 'H06Z' or GetUnitTypeId(GetTriggerUnit()) == 'H000' ) then
                                call DestroyEffect(AddSpecialEffect(("ByakuganHitEffect.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Anko
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'U01G' then
                                call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            //Kaguya
                            elseif GetUnitTypeId(GetTriggerUnit()) == 'N013' then
                                call DestroyEffect(AddSpecialEffect(("Mr.War3_SKM.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            else
                                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                            endif
                            exitwhen true
                        endif
                    endloop
                endif
            endif
        //endif 
