			call UnitDamageTarget(s__KankuroPoisonNew_caster[this], bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(s__KankuroPoisonNew_caster[this], s__KankuroPoisonNew_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
