        		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetRandomReal(0, 360)))
        		call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , true) // INLINED!!

			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__YugitoClawsStorm_count[this]=s__YugitoClawsStorm_count[this] + 1
		if s__YugitoClawsStorm_count[this] >= 9 then
			call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack.mdx" ), (( GetUnitX(s__YugitoClawsStorm_caster[this]) )*1.0), (( GetUnitY(s__YugitoClawsStorm_caster[this]))*1.0))) // INLINED!!
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__YugitoClawsStorm_damaged[this])
				exitwhen bj_lastCreatedUnit == null
