            set s__ToruneShield_Alloc___recycle[(0)]=this
        endfunction
    

        function s__ToruneShield_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__ToruneShield_target[s__ToruneShield_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            call UnitDamageTarget(s__ToruneShield_target[s__ToruneShield_instance], GetFilterUnit(), s__ToruneShield_total_hp[s__ToruneShield_instance], true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
        endfunction

    function s__ToruneShield_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real diff= s__ToruneShield_last_hp[this] - GetUnitState(s__ToruneShield_target[this], UNIT_STATE_LIFE)
        local integer i
        local real x
        local real y
        if diff > 0 then
            set diff=RMinBJ(s__ToruneShield_hp[this], diff)
            set s__ToruneShield_hp[this]=s__ToruneShield_hp[this] - diff
            call SetUnitState(s__ToruneShield_target[this], UNIT_STATE_LIFE, GetUnitState(s__ToruneShield_target[this], UNIT_STATE_LIFE) + diff)
        endif
        set s__ToruneShield_last_hp[this]=GetUnitState(s__ToruneShield_target[this], UNIT_STATE_LIFE)
        if s__ToruneShield_hp[this] <= 0 or GetUnitAbilityLevel(s__ToruneShield_target[this], 'B05O') == 0 then
            set i=0
            loop
                exitwhen i > 6
                set x=(((GetUnitX(s__ToruneShield_target[this]) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__ToruneShield_target[this]) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 200)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ToruneShield_target[this]), 'ntkt', x, y, 60 * i)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
                call IssuePointOrder(bj_lastCreatedUnit, "move", GetUnitX(s__ToruneShield_target[this]), GetUnitY(s__ToruneShield_target[this]))
                call DestroyEffect(AddSpecialEffect(("ShadowCannon.mdx" ), (( GetUnitX(s__ToruneShield_target[this]) )*1.0), (( GetUnitY(s__ToruneShield_target[this]))*1.0))) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" ), (( GetUnitX(s__ToruneShield_target[this]) )*1.0), (( GetUnitY(s__ToruneShield_target[this]))*1.0))) // INLINED!!
                set i=i + 1
            endloop

	    set bj_lastCreatedGroup=CreateGroup()
            set s__ToruneShield_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ToruneShield_target[this]), GetUnitY(s__ToruneShield_target[this]), 500.0, Filter(function s__ToruneShield_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)

            call SlowArea(s__ToruneShield_target[this] , GetUnitX(s__ToruneShield_target[this]) , GetUnitY(s__ToruneShield_target[this]) , 500)
            call UnitRemoveAbility(s__ToruneShield_target[this], 'B05O')
            set s__ToruneShield_target[this]=null
            call s__ToruneShield_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ToruneShield_actions takes nothing returns nothing
        local integer this= s__ToruneShield_allocate()
        set s__ToruneShield_target[this]=GetSpellTargetUnit()
        set s__ToruneShield_hp[this]=GetUnitState(s__ToruneShield_target[this], UNIT_STATE_MAX_MANA) * 0.2
        set s__ToruneShield_last_hp[this]=GetUnitState(s__ToruneShield_target[this], UNIT_STATE_LIFE)
        set s__ToruneShield_total_hp[this]=s__ToruneShield_hp[this]
        call TimerStart(NewTimerEx(this), 0.1, true, function s__ToruneShield_periodic)
    endfunction 
    
    function s__ToruneShield_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(72 , s__ToruneShield_SPELL_ID , function s__ToruneShield_actions)
    endfunction 
    
