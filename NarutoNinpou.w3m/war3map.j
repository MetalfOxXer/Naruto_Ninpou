            set s__MinatoJouninD_kunai2=CreateUnit(GetOwningPlayer(s__MinatoJouninD_caster[this]), 'e02O', GetUnitX(s__MinatoJouninD_kunai[this]), GetUnitY(s__MinatoJouninD_kunai[this]), GetUnitFacing(s__MinatoJouninD_kunai[this]))
            call UnitApplyTimedLife(s__MinatoJouninD_kunai2, 'BTLF', 20.0)
            call AddSpecialEffectTarget("Effects\\s_Kunai_Mark2.mdx", s__MinatoJouninD_kunai2, "origin")
	    set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Flying_Thunder_God_Kunai.mdl", GetUnitX(s__MinatoJouninD_kunai[this]), GetUnitY(s__MinatoJouninD_kunai[this]))
	    call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__MinatoJouninD_caster[this])))
            call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, 1.57)
	    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
	    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__MinatoJouninD_kunai[this]) , GetUnitY(s__MinatoJouninD_kunai[this])))
            set s__MinatoJouninD_kunai2e=bj_lastCreatedEffect
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__MinatoJouninD_caster[this]), s__MinatoJouninD_SPELL_ID, false)
            call UnitAddAbility(s__MinatoJouninD_caster[this], 'A1CQ')
