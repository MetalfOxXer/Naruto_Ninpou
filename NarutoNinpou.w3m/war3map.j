            set s__SasukeIndraArrow___Spell_angle[this]=Atan3(GetUnitX(s__SasukeIndraArrow___Spell_caster[this]) , GetUnitY(s__SasukeIndraArrow___Spell_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
