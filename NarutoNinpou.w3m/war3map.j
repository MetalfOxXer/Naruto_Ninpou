// scope KurotsuchiWaterTrumpet begins


    function KurotsuchiWaterTrumpet__HasTrumpetHit takes unit u returns boolean
        local integer i= 0
        loop
            exitwhen i >= TrumpetHitCount
            if TrumpetHitUnits[i] == u then
                return true
            endif
            set i=i + 1
        endloop
        return false
    endfunction

    function ClearTrumpetHits takes nothing returns nothing
        local integer i= 0
        loop
            exitwhen i >= TrumpetHitCount
            set TrumpetHitUnits[i]=null
            set i=i + 1
        endloop
        set TrumpetHitCount=0
    endfunction

    function KurotsuchiWaterTrumpet__RegisterTrumpetHit takes unit u returns nothing
        local integer i= 0
        loop
            exitwhen i >= TrumpetHitCount
            if TrumpetHitUnits[i] == u then
                return
            endif
            set i=i + 1
        endloop
        if TrumpetHitCount < KurotsuchiWaterTrumpet__MAX_TRUMPET_HITS then
            set TrumpetHitUnits[TrumpetHitCount]=u
            set TrumpetHitCount=TrumpetHitCount + 1
        endif
    endfunction

    function KurotsuchiWaterTrumpet__TryHardenRBlobs takes real x,real y,unit caster returns nothing
        local integer instIdx= 0
        local integer rInst
        local integer blobTable
        local integer fullDmgTable
        local integer i= 0
        local real bx
        local real by
        local integer state
        local real range= 180.0
        local real dist
        local real dx
        local real dy
        local unit u
        local group g
        local real dmg
        local real dealt
        local real remaining
        local integer uid

        loop
            exitwhen instIdx >= activeInstanceCount
            set rInst=activeInstances[instIdx]
            set blobTable=(LoadInteger(Table__ht, (YokaiSpray_blobDamageDone), (rInst))) // INLINED!!
            set fullDmgTable=(LoadInteger(Table__ht, (YokaiSpray_unitsFullyDamaged), (rInst))) // INLINED!!
        
            set i=0
            loop
                exitwhen i >= 200
                set bx=LoadReal(KurotsuchiHash, rInst, i * 20 + 11)
                set by=LoadReal(KurotsuchiHash, rInst, i * 20 + 12)
                if bx == 0.0 and by == 0.0 then
                    exitwhen true
                endif

                set dx=bx - x
                set dy=by - y
                set dist=SquareRoot(dx * dx + dy * dy)

                if dist <= range then
                    set state=LoadInteger(KurotsuchiHash, rInst, i * 20 + 9)
                    if state != 2 then
                        call YokaiSpray_HardenBlob(rInst , i)

                        set g=CreateGroup()
                        call GroupEnumUnitsInRange(g, bx, by, range, null)
                        loop
                            set u=FirstOfGroup(g)
                            exitwhen u == null
                            call GroupRemoveUnit(g, u)
                            set uid=GetHandleId(u)

                            if IsUnitEnemy(u, GetOwningPlayer(caster)) and not IsUnitType(u, UNIT_TYPE_DEAD) and (LoadInteger(Table__ht, (fullDmgTable), (uid))) != 1 then // INLINED!!
                                call EsnareUnitTimed(caster , u , 1.0)
                                set dealt=(LoadReal(Table__ht, (((blobTable))), (i * 1000 + uid))) // INLINED!!
                                set dmg=800.0 + 4.0 * I2R(GetHeroStr(caster, true)) * I2R(GetUnitAbilityLevel(caster, 'A0X2'))
                                set remaining=dmg - dealt

                                if remaining > 0.0 then
                                    call UnitDamageTarget(caster, u, remaining, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                                endif
                                call SaveInteger(Table__ht, (fullDmgTable), (uid), ( 1)) // INLINED!!
                            endif
                        endloop
                        call DestroyGroup(g)
                    endif
                endif
                set i=i + 1
            endloop
        
            set instIdx=instIdx + 1
        endloop
    endfunction

