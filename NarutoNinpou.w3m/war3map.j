//===========================================================================
// Trigger: MinatoJouninLevel
//===========================================================================

    function s__MinatoJouninLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A0Q1') == 1 and GetUnitAbilityLevel(u, 'A1CR') == 1 then
                call UnitRemoveAbility(u, 'A1CR')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A1CR', false)
                call UnitAddAbility(u, 'A0U0')
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__MinatoJouninLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H082' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__MinatoJouninLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__MinatoJouninLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__MinatoJouninLevel_leave))) // INLINED!!
    endfunction 

//===========================================================================
// Trigger: MinatoJouninSpaceTimeJutsu
//===========================================================================
function Trig_MinatoJouninSpaceTimeJutsu_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0U0'
endfunction

function Trig_MinatoJouninSpaceTimeJutsu_Actions takes nothing returns nothing
    local integer team
    if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
		set team=0
	elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
		set team=1
	else
		set team=2
	endif
		//call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, I2S(team))
    if team == 0 and ( RectContainsCoords(gg_rct_Base_Otogakure, GetSpellTargetX(), GetSpellTargetY()) or RectContainsCoords(gg_rct_Base_Akatsuki, GetSpellTargetX(), GetSpellTargetY()) ) then
		call IssueImmediateOrder(GetTriggerUnit(), "stop")
    elseif team == 1 and ( RectContainsCoords(gg_rct_Base_Konohagakure, GetSpellTargetX(), GetSpellTargetY()) or RectContainsCoords(gg_rct_Base_Akatsuki, GetSpellTargetX(), GetSpellTargetY()) ) then
		call IssueImmediateOrder(GetTriggerUnit(), "stop")
    elseif team == 2 and ( RectContainsCoords(gg_rct_Base_Konohagakure, GetSpellTargetX(), GetSpellTargetY()) or RectContainsCoords(gg_rct_Base_Otogakure, GetSpellTargetX(), GetSpellTargetY()) ) then
		call IssueImmediateOrder(GetTriggerUnit(), "stop")
	endif
endfunction

//===========================================================================
function InitTrig_MinatoJouninSpaceTimeJutsu takes nothing returns nothing
    set gg_trg_MinatoJouninSpaceTimeJutsu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MinatoJouninSpaceTimeJutsu, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(gg_trg_MinatoJouninSpaceTimeJutsu, Condition(function Trig_MinatoJouninSpaceTimeJutsu_Conditions))
    call TriggerAddAction(gg_trg_MinatoJouninSpaceTimeJutsu, function Trig_MinatoJouninSpaceTimeJutsu_Actions)
endfunction


//===========================================================================
// Trigger: Mitsuki Rorentsugan
//===========================================================================
function Trig_Mitsuki_Rorentsugan_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0E1' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mitsuki_Rorentsugan_Actions takes nothing returns nothing
    call PolledWait(10.00)
    call UnitDamageTargetBJ(GetTriggerUnit(), GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) * 0.20 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL)
    call BlzEndUnitAbilityCooldown(GetTriggerUnit(), 'A0E5')
    call BlzEndUnitAbilityCooldown(GetTriggerUnit(), 'A0E7')
    call BlzEndUnitAbilityCooldown(GetTriggerUnit(), 'A0E9')
endfunction

//===========================================================================
function InitTrig_Mitsuki_Rorentsugan takes nothing returns nothing
    set gg_trg_Mitsuki_Rorentsugan=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Mitsuki_Rorentsugan, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Mitsuki_Rorentsugan, Condition(function Trig_Mitsuki_Rorentsugan_Conditions))
    call TriggerAddAction(gg_trg_Mitsuki_Rorentsugan, function Trig_Mitsuki_Rorentsugan_Actions)
endfunction


