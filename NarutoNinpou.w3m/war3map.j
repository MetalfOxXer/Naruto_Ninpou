                call GroupRemoveUnit(s__KaguyaLavaDimension_damaged[this], bj_lastCreatedUnit)
            endloop
            call KillUnit(s__KaguyaLavaDimension_portal[this])
            set s__KaguyaLavaDimension_portal[this]=null
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KaguyaLavaDimension_caster[this]), s__KaguyaLavaDimension_SPELL_ID, true)
            call UnitRemoveAbility(s__KaguyaLavaDimension_caster[this], 'A16X')
	        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__KaguyaLavaDimension_caster[this]) )*1.0), (( GetUnitY(s__KaguyaLavaDimension_caster[this]))*1.0))) // INLINED!!
	        call TimerStart(NewTimerEx(this), 3.0, false, function s__KaguyaLavaDimension_delay)
