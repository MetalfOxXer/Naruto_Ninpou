    function s__KakashiUnderground_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local integer i= 0
        set s__KakashiUnderground_count[this]=s__KakashiUnderground_count[this] + 1
        if s__KakashiUnderground_previous_x[this] != GetUnitX(s__KakashiUnderground_caster[this]) or s__KakashiUnderground_previous_y[this] != GetUnitY(s__KakashiUnderground_caster[this]) then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl" ), (( s__KakashiUnderground_previous_x[this] )*1.0), (( s__KakashiUnderground_previous_y[this])*1.0))) // INLINED!!
            set s__KakashiUnderground_previous_x[this]=GetUnitX(s__KakashiUnderground_caster[this])
            set s__KakashiUnderground_previous_y[this]=GetUnitY(s__KakashiUnderground_caster[this])
        endif
        if s__KakashiUnderground_count[this] > ( 5 + .5 * GetUnitAbilityLevel(s__KakashiUnderground_caster[this], s__KakashiUnderground_SPELL_ID) ) and ( s__KakashiUnderground_count[this] == ( 50 + 10 * GetUnitAbilityLevel(s__KakashiUnderground_caster[this], s__KakashiUnderground_SPELL_ID) ) or s__KakashiUnderground_stop or GetUnitAbilityLevel(s__KakashiUnderground_caster[this], 'Binv') == 0 ) then
