    function s__HayateTrail_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real x= (((s__HayateTrail_previous_x[this] )*1.0) + Cos((( Deg2Rad(- 90) )*1.0)) * (( 50)*1.0)) // INLINED!!
 local real y= (((s__HayateTrail_previous_y[this] )*1.0) + Sin((( Deg2Rad(- 90) )*1.0)) * (( 50)*1.0)) // INLINED!!
 local real new_x= (((s__HayateTrail_previous_x[this] )*1.0) + Cos((( Deg2Rad(90) )*1.0)) * (( 50)*1.0)) // INLINED!!
 local real new_y= (((s__HayateTrail_previous_y[this] )*1.0) + Sin((( Deg2Rad(90) )*1.0)) * (( 50)*1.0)) // INLINED!!
        local integer i= 0
        set s__HayateTrail_count[this]=s__HayateTrail_count[this] + 1
        if s__HayateTrail_previous_x[this] != GetUnitX(s__HayateTrail_caster[this]) or s__HayateTrail_previous_y[this] != GetUnitY(s__HayateTrail_caster[this]) then
            if ModuloInteger(s__HayateTrail_count[this], 3) == 0 then
                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", x, y)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__HayateTrail_caster[this])))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", new_x, new_y)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__HayateTrail_caster[this])))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
                call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
                set s__HayateTrail_previous_x[this]=GetUnitX(s__HayateTrail_caster[this])
                set s__HayateTrail_previous_y[this]=GetUnitY(s__HayateTrail_caster[this])
            endif
        endif
        if s__HayateTrail_count[this] > ( .6 * GetUnitAbilityLevel(s__HayateTrail_caster[this], s__HayateTrail_SPELL_ID) * 10 ) or GetUnitAbilityLevel(s__HayateTrail_caster[this], 'B01Q') == 0 then
            call s__HayateTrail_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 


