 function s__HayateNewW_removespell takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__HayateNewW_count[this]=s__HayateNewW_count[this] + 1
		if s__HayateNewW_count[this] > 67 then
			call UnitRemoveAbility(s__HayateNewW_caster[this], 'A0UF')
