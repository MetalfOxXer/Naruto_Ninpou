    function s__KidomaruKuchiyose_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= GetRandomReal(0, 2 * bj_PI)
        local real offset= GetRandomReal(0, 300)
        local real x= (((s__KidomaruKuchiyose_target_x[this] )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real y= (((s__KidomaruKuchiyose_target_y[this] )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        if s__KidomaruKuchiyose_count[this] < 35 then
            if ModuloInteger(s__KidomaruKuchiyose_count[this], 2) == 0 then
		if ModuloInteger(s__KidomaruKuchiyose_count[this], 4) == 0 then
                	set bj_lastCreatedUnit=CreateAbilityDummy(s__KidomaruKuchiyose_caster[this] , 'A1A1')
		else
                	set bj_lastCreatedUnit=CreateAbilityDummy(s__KidomaruKuchiyose_caster[this] , 'A1A2')
		endif
                call SetUnitX(bj_lastCreatedUnit, s__KidomaruKuchiyose_target_x[this])
                call SetUnitY(bj_lastCreatedUnit, s__KidomaruKuchiyose_target_y[this])
                call SetUnitFlyHeight(bj_lastCreatedUnit, GetUnitFlyHeight(s__KidomaruKuchiyose_spider[this]), 0)
                call SetUnitScale(bj_lastCreatedUnit, 0.1, 0.1, 0.1)
                call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", x, y)
            endif
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KidomaruKuchiyose_target_x[this], s__KidomaruKuchiyose_target_y[this], 450, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KidomaruKuchiyose_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                if ModuloInteger(s__KidomaruKuchiyose_count[this], 5) == 0 then
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\wanhuajing.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
		if not IsUnitInGroup(bj_lastCreatedUnit, s__KidomaruKuchiyose_damaged[this]) then
			call GroupAddUnit(s__KidomaruKuchiyose_damaged[this], bj_lastCreatedUnit)
			//call StunUnitTimed(this.caster, bj_lastCreatedUnit, 2.0)
                        call EsnareUnitTimed(s__KidomaruKuchiyose_caster[this] , bj_lastCreatedUnit , 2.0)
		endif
		if GetHeroLevel(s__KidomaruKuchiyose_caster[this]) >= 15 then
                	call UnitDamageTarget(s__KidomaruKuchiyose_caster[this], bj_lastCreatedUnit, ( GetHeroAgi(s__KidomaruKuchiyose_caster[this], true) + 800 ) / 66.0 * 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		else
                	call UnitDamageTarget(s__KidomaruKuchiyose_caster[this], bj_lastCreatedUnit, ( GetHeroAgi(s__KidomaruKuchiyose_caster[this], true) + 800 ) / 66.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KidomaruKuchiyose_count[this]=s__KidomaruKuchiyose_count[this] + 1
        if s__KidomaruKuchiyose_count[this] > 66 then
            loop
            set bj_lastCreatedUnit=FirstOfGroup(s__KidomaruKuchiyose_effects[this])
                exitwhen bj_lastCreatedUnit == null
	            call ShowUnit(bj_lastCreatedUnit, false)
                call KillUnit(bj_lastCreatedUnit)
                call GroupRemoveUnit(s__KidomaruKuchiyose_effects[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__KidomaruKuchiyose_effects[this])
	        set s__KidomaruKuchiyose_effects[this]=null
            set bj_lastCreatedEffect=AddSpecialEffect("s_Shadow_Smoke.mdx", s__KidomaruKuchiyose_target_x[this], s__KidomaruKuchiyose_target_y[this])
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__KidomaruKuchiyose_spider[this]) + GetPointZ(s__KidomaruKuchiyose_target_x[this] , s__KidomaruKuchiyose_target_y[this]))
            call DestroyEffect(bj_lastCreatedEffect)
            call KillUnit(s__KidomaruKuchiyose_spider[this])
            call ShowUnit(s__KidomaruKuchiyose_spider[this], false)
            set s__KidomaruKuchiyose_spider[this]=null
	    call DestroyGroup(s__KidomaruKuchiyose_damaged[this])
	    call s__KidomaruKuchiyose_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
 function s__KidomaruKuchiyose_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
         local integer i
  local real x
  local real y
		set s__KidomaruKuchiyose_spider[this]=CreateUnit(GetOwningPlayer(s__KidomaruKuchiyose_caster[this]), 'h04U', s__KidomaruKuchiyose_target_x[this], s__KidomaruKuchiyose_target_y[this], 270)
