    function s__KimimaroTessenka_dealDamage takes nothing returns boolean
		call GroupRemoveUnit(bj_lastCreatedGroup, GetFilterUnit())
			if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KimimaroTessenka_caster[s__KimimaroTessenka_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
				call UnitDamageTarget(s__KimimaroTessenka_caster[s__KimimaroTessenka_instance], GetFilterUnit(), ( 450 + GetHeroStr(s__KimimaroTessenka_caster[s__KimimaroTessenka_instance], true) ) * GetUnitAbilityLevel(s__KimimaroTessenka_caster[s__KimimaroTessenka_instance], 'A0FJ'), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
