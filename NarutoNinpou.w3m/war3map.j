    function s__TentenDanceOfChains_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__TentenDanceOfChains_dummy[this])
        local real y= GetUnitY(s__TentenDanceOfChains_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__TentenDanceOfChains_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__TentenDanceOfChains_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local unit u= null
        set s__TentenDanceOfChains_count[this]=s__TentenDanceOfChains_count[this] + 1
        set s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]]=AddSpecialEffect("war3mapImported\\ChainElement.mdl", new_x, new_y)
		//call BlzSetSpecialEffectPitch(this.chains[this.count], -1.57)
		call BlzSetSpecialEffectYaw(s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]], s__TentenDanceOfChains_angle[this])
		call BlzSetSpecialEffectScale(s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]], 2.0)
		call BlzSetSpecialEffectHeight(s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]], 100 + GetPointZ(new_x , new_y))
		set s___TentenDanceOfChains_chains_x[s__TentenDanceOfChains_chains_x[this]+s__TentenDanceOfChains_count[this]]=new_x
		set s___TentenDanceOfChains_chains_y[s__TentenDanceOfChains_chains_y[this]+s__TentenDanceOfChains_count[this]]=new_y
        call SetUnitX(s__TentenDanceOfChains_dummy[this], new_x)
        call SetUnitY(s__TentenDanceOfChains_dummy[this], new_y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TentenDanceOfChains_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
