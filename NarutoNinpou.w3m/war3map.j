            set s__MinatoJouninRasengan_Alloc___recycle[(0)]=this
        endfunction


  function s__MinatoJouninRasengan_destroy takes integer this returns nothing
	
    call DestroyGroup(s__MinatoJouninRasengan_damaged1[this])
    call KillUnit(s__MinatoJouninRasengan_dummy[this])
    //call PauseUnit(this.target, false)
    set s__MinatoJouninRasengan_damaged1[this]=null
    set s__MinatoJouninRasengan_dummy[this]=null
    set s__MinatoJouninRasengan_caster[this]=null
    set s__MinatoJouninRasengan_target[this]=null
    call s__MinatoJouninRasengan_deallocate(this)
  endfunction

  function s__MinatoJouninRasengan_periodic takes nothing returns nothing
    local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
    local real unit_x
    local real unit_y
    local real caster_x
    local real caster_y
    local real target_x
    local real target_y
    local real new_x
    local real new_y
    local real new_x_2
    local real new_y_2
    local real distance_x
    local real distance_y
    local real distance
    local real angle
    local real angle_2
    local integer i= 0
    set s__MinatoJouninRasengan_count[this]=s__MinatoJouninRasengan_count[this] + 1
    if s__MinatoJouninRasengan_count_2[this] < 3 then
        set unit_x=GetUnitX(s__MinatoJouninRasengan_dummy[this])
        set unit_y=GetUnitY(s__MinatoJouninRasengan_dummy[this])
        set target_x=GetUnitX(s__MinatoJouninRasengan_target[this])
        set target_y=GetUnitY(s__MinatoJouninRasengan_target[this])
        set angle=Atan2(( target_y - unit_y ), ( target_x - unit_x ))
        set new_x=unit_x + Cos(angle) * 50
        set new_y=unit_y + Sin(angle) * 50
        call SetUnitX(s__MinatoJouninRasengan_dummy[this], new_x)
        call SetUnitY(s__MinatoJouninRasengan_dummy[this], new_y)
        set distance_x=target_x - new_x
        set distance_y=target_y - new_y
        set distance=SquareRoot(distance_x * distance_x + distance_y * distance_y)
        if distance <= 50 and s__MinatoJouninRasengan_count_2[this] == 0 then
            set s__MinatoJouninRasengan_angle[this]=angle
            set s__MinatoJouninRasengan_count_2[this]=1
        endif
        if ModuloInteger(s__MinatoJouninRasengan_count[this], 2) == 0 and s__MinatoJouninRasengan_count_2[this] < 1 then
            if s__MinatoJouninRasengan_b[this] == 1 then
                set angle_2=angle + bj_PI / 2
                set s__MinatoJouninRasengan_b[this]=2
            else
                set angle_2=angle - bj_PI / 2
                set s__MinatoJouninRasengan_b[this]=1
            endif
            loop
                set i=i + 1
                exitwhen i > 4
                set new_x_2=new_x + Cos(angle_2) * ( 50 * i )
                set new_y_2=new_y + Sin(angle_2) * ( 50 * i )
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MinatoJouninRasengan_caster[this]), 'h09P', new_x_2, new_y_2, Rad2Deg(angle))
                call SetUnitX(bj_lastCreatedUnit, new_x_2)
                call SetUnitY(bj_lastCreatedUnit, new_y_2)
                call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 100)
                call SetUnitAnimation(bj_lastCreatedUnit, "spell two")
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.15)
            endloop
            call SetUnitX(s__MinatoJouninRasengan_caster[this], new_x_2)
            call SetUnitY(s__MinatoJouninRasengan_caster[this], new_y_2)
        endif
    endif
    if s__MinatoJouninRasengan_count_2[this] > 0 then
        set s__MinatoJouninRasengan_count_2[this]=s__MinatoJouninRasengan_count_2[this] + 1
        if s__MinatoJouninRasengan_count_2[this] == 2 then
            call UnitRemoveAbility(s__MinatoJouninRasengan_caster[this], 'A0BA')
            set new_x_2=target_x + Cos(s__MinatoJouninRasengan_angle[this] + bj_PI) * 100
            set new_y_2=target_y + Sin(s__MinatoJouninRasengan_angle[this] + bj_PI) * 100
            call SetUnitX(s__MinatoJouninRasengan_caster[this], new_x_2)
            call SetUnitY(s__MinatoJouninRasengan_caster[this], new_y_2)
        elseif s__MinatoJouninRasengan_count_2[this] == 10 then
            call PauseUnit(s__MinatoJouninRasengan_target[this], false)
            call DestroyEffect(s__MinatoJouninRasengan_rasengan[this])
            call DestroyEffect(s__MinatoJouninRasengan_rasengan_2[this])
            set caster_x=GetUnitX(s__MinatoJouninRasengan_caster[this])
            set caster_y=GetUnitY(s__MinatoJouninRasengan_caster[this])
            set target_x=GetUnitX(s__MinatoJouninRasengan_target[this])
            set target_y=GetUnitY(s__MinatoJouninRasengan_target[this])
            set angle=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MinatoJouninRasengan_caster[this]), 'e02X', target_x, target_y, Rad2Deg(angle))
            call SetUnitX(bj_lastCreatedUnit, target_x)
            call SetUnitY(bj_lastCreatedUnit, target_y)
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        elseif s__MinatoJouninRasengan_count_2[this] > 10 and s__MinatoJouninRasengan_count_2[this] < 30 then
            set target_x=GetUnitX(s__MinatoJouninRasengan_target[this])
            set target_y=GetUnitY(s__MinatoJouninRasengan_target[this])
            set new_x=target_x + Cos(s__MinatoJouninRasengan_angle[this]) * 25
            set new_y=target_y + Sin(s__MinatoJouninRasengan_angle[this]) * 25
            if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                call SetUnitX(s__MinatoJouninRasengan_target[this], new_x)
                call SetUnitY(s__MinatoJouninRasengan_target[this], new_y)
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MinatoJouninRasengan_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__MinatoJouninRasengan_damaged1[this]) then
                        call UnitDamageTarget(s__MinatoJouninRasengan_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__MinatoJouninRasengan_caster[this], true) * GetUnitAbilityLevel(s__MinatoJouninRasengan_caster[this], 'A1A8'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(s__MinatoJouninRasengan_damaged1[this], bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
            else
                set s__MinatoJouninRasengan_count[this]=30
            endif
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        endif
    endif
    if s__MinatoJouninRasengan_count_2[this] >= 30 then
        set target_x=GetUnitX(s__MinatoJouninRasengan_target[this])
        set target_y=GetUnitY(s__MinatoJouninRasengan_target[this])
        call s__MinatoJouninRasengan_destroy(this)
        call ReleaseTimer(GetExpiredTimer())
    endif
  endfunction

  function s__MinatoJouninRasengan_actions takes nothing returns nothing
    local integer this= s__MinatoJouninRasengan_allocate()
    local real caster_x
    local real caster_y
    set s__MinatoJouninRasengan_damaged1[this]=CreateGroup()
    set s__MinatoJouninRasengan_caster[this]=GetTriggerUnit()
    set s__MinatoJouninRasengan_target[this]=GetSpellTargetUnit()
    set caster_x=GetUnitX(s__MinatoJouninRasengan_caster[this])
    set caster_y=GetUnitY(s__MinatoJouninRasengan_caster[this])
    set s__MinatoJouninRasengan_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', caster_x, caster_y, 0)
    call SetUnitX(s__MinatoJouninRasengan_dummy[this], caster_x)
    call SetUnitY(s__MinatoJouninRasengan_dummy[this], caster_y)
    set s__MinatoJouninRasengan_b[this]=1
    set s__MinatoJouninRasengan_count[this]=0
    set s__MinatoJouninRasengan_count_2[this]=0
    call UnitAddAbility(s__MinatoJouninRasengan_caster[this], 'A0BA')
    call PauseUnit(s__MinatoJouninRasengan_target[this], true)
    call SetUnitAnimation(s__MinatoJouninRasengan_caster[this], "spell two")
    set s__MinatoJouninRasengan_rasengan[this]=AddSpecialEffectTarget("war3mapImported\\lxw jhxcom_2000.mdx", s__MinatoJouninRasengan_caster[this], "right hand")
    set s__MinatoJouninRasengan_rasengan_2[this]=AddSpecialEffectTarget("war3mapImported\\lxw jhxcom_2000.mdx", s__MinatoJouninRasengan_caster[this], "left hand")
    //set MinatoJouninRasenganBlink.rasengan3 = false
    call TimerStart(NewTimerEx(this), 0.04, true, function s__MinatoJouninRasengan_periodic)
  endfunction

  function s__MinatoJouninRasengan_dies takes nothing returns nothing
    if GetUnitTypeId(GetTriggerUnit()) == 'h083' or GetUnitTypeId(GetTriggerUnit()) == 'e030' or GetUnitTypeId(GetTriggerUnit()) == 'h09P' or GetUnitTypeId(GetTriggerUnit()) == 'e03S' then
        call ShowUnit(GetTriggerUnit(), false)
    endif
  endfunction

  function s__MinatoJouninRasengan_onInit takes nothing returns nothing
    call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__MinatoJouninRasengan_dies))) // INLINED!!
    call RegisterSpellEffectEvent2((s__MinatoJouninRasengan_SPELL_ID ) , Filter(( function s__MinatoJouninRasengan_actions))) // INLINED!!
  endfunction


