    function s__ItachiKatonSpell_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ItachiKatonSpell_ball[this])
        local real y= GetUnitY(s__ItachiKatonSpell_ball[this])
        local real new_x= (((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__ItachiKatonSpell_ball[this])) )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__ItachiKatonSpell_ball[this])) )*1.0)) * (( 25)*1.0)) // INLINED!!
    
        set s__ItachiKatonSpell_count[this]=s__ItachiKatonSpell_count[this] + 1
        call SetUnitX(s__ItachiKatonSpell_ball[this], new_x)
        call SetUnitY(s__ItachiKatonSpell_ball[this], new_y)
        //call AddSpecialEffectEx("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", x, y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 240.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
        if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ItachiKatonSpell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__ItachiKatonSpell_damaged[this]) then
            if GetHeroLevel(s__ItachiKatonSpell_caster[this]) >= 35 then
                call UnitDamageTarget(s__ItachiKatonSpell_caster[this], bj_lastCreatedUnit, 100.0 * GetUnitAbilityLevel(s__ItachiKatonSpell_caster[this], s__ItachiKatonSpell_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	    else
            	call UnitDamageTarget(s__ItachiKatonSpell_caster[this], bj_lastCreatedUnit, 100.0 * GetUnitAbilityLevel(s__ItachiKatonSpell_caster[this], s__ItachiKatonSpell_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            endif
            call GroupAddUnit(s__ItachiKatonSpell_damaged[this], bj_lastCreatedUnit)
        endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__ItachiKatonSpell_count[this] > 35 then
            call s__ItachiKatonSpell_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__ItachiKatonSpell_actions takes nothing returns nothing
        local integer this= s__ItachiKatonSpell_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Itachi_Q, 100.0, GetTriggerUnit())
        endif
        set s__ItachiKatonSpell_caster[this]=GetTriggerUnit()
        set s__ItachiKatonSpell_damaged[this]=CreateGroup()
        set s__ItachiKatonSpell_ball[this]=CreateUnit(GetTriggerPlayer(), 'h04Q', GetUnitX(s__ItachiKatonSpell_caster[this]), GetUnitY(s__ItachiKatonSpell_caster[this]), Rad2Deg(Atan3(GetUnitX(s__ItachiKatonSpell_caster[this]) , GetUnitY(s__ItachiKatonSpell_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))

        set s__ItachiKatonSpell_count[this]=0
        
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ItachiKatonSpell_periodic)
    endfunction
    
