    function s__HagoromoE_damagenumunits takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HagoromoD_Hagoromo)) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            if s__HagoromoE_empowered[s__HagoromoE_instance] then
                //call BJDebugMsg(R2S((GetHeroInt(HagoromoD.Hagoromo, true) * R2I(GetHeroLevel(HagoromoD.Hagoromo)/5)) / 100))
                if not IsUnitInGroup(GetFilterUnit(), s__HagoromoE_damaged[s__HagoromoE_instance]) then
                    call UnitDamageTarget(s__HagoromoD_Hagoromo, GetFilterUnit(), ( 500 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) * 0.75 ) ) ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__HagoromoE_damaged[s__HagoromoE_instance], GetFilterUnit())
                endif
            else
                //call BJDebugMsg(R2S((250 * R2I(GetHeroLevel(HagoromoD.Hagoromo)/5)) / 100))
                if not IsUnitInGroup(GetFilterUnit(), s__HagoromoE_damaged[s__HagoromoE_instance]) then
                    call UnitDamageTarget(s__HagoromoD_Hagoromo, GetFilterUnit(), 500 * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) / 2 ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__HagoromoE_damaged[s__HagoromoE_instance], GetFilterUnit())
                endif
            endif
        endif
        return false
    endfunction

    function s__HagoromoE_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real speed= 10
        local real x
        local real y
        local real new_x
        local real new_y
        local location loc1
        local location loc2
        local real scale
        set s__HagoromoE_instance=this
        set scale=0.5 + 0.25 / 100 * s__HagoromoE_count[s__HagoromoE_instance]
        set x=(((GetUnitX(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) )*1.0) + Cos((( s__HagoromoE_angle[s__HagoromoE_instance] )*1.0)) * (( speed)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) )*1.0) + Sin((( s__HagoromoE_angle[s__HagoromoE_instance] )*1.0)) * (( speed)*1.0)) // INLINED!!

        // Determine how fireball should behave
        if s__HagoromoE_empowered[s__HagoromoE_instance] then
            set x=(((GetUnitX(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) )*1.0) + Cos((( s__HagoromoE_angle[s__HagoromoE_instance] )*1.0)) * (( 30)*1.0)) //25 // INLINED!!
            set y=(((GetUnitY(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) )*1.0) + Sin((( s__HagoromoE_angle[s__HagoromoE_instance] )*1.0)) * (( 30)*1.0)) //25 // INLINED!!
            call SetUnitX(s__HagoromoE_instanceFireball[s__HagoromoE_instance], x)
            call SetUnitY(s__HagoromoE_instanceFireball[s__HagoromoE_instance], y)
            call SetUnitFacingTimed(s__HagoromoE_instanceFireball[s__HagoromoE_instance], Rad2Deg(s__HagoromoE_angle[s__HagoromoE_instance]), 0.1)
            set scale=0.5 + 0.25 / 12.5 * s__HagoromoE_count[s__HagoromoE_instance]
            call SetUnitScale(s__HagoromoE_instanceFireball[s__HagoromoE_instance], scale, scale, scale)
               
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 256 * scale, Filter(function s__HagoromoE_damagenumunits))
            call DestroyGroup(bj_lastCreatedGroup)
        else
            call SetUnitX(s__HagoromoE_instanceFireball[s__HagoromoE_instance], x)
            call SetUnitY(s__HagoromoE_instanceFireball[s__HagoromoE_instance], y)
            call SetUnitScale(s__HagoromoE_instanceFireball[s__HagoromoE_instance], scale, scale, scale)
      
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 256 * scale + 64, Filter(function s__HagoromoE_damagenumunits))
            call DestroyGroup(bj_lastCreatedGroup)
        endif

        set s__HagoromoE_count[s__HagoromoE_instance]=s__HagoromoE_count[s__HagoromoE_instance] + 1
        if s__HagoromoE_count[s__HagoromoE_instance] > 100 or GetWidgetLife(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) <= 0.045 then
            call DestroyGroup(s__HagoromoE_damaged[this])
            set s__HagoromoE_damaged[s__HagoromoE_instance]=null
            set s__HagoromoE_empowered[s__HagoromoE_instance]=false
            if GetWidgetLife(s__HagoromoE_instanceFireball[s__HagoromoE_instance]) >= 0.045 then
                call KillUnit(s__HagoromoE_instanceFireball[s__HagoromoE_instance])
            endif
            set s__HagoromoE_instanceFireball[s__HagoromoE_instance]=null
            call s__HagoromoE_deallocate(s__HagoromoE_instance)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__HagoromoE_actions takes nothing returns nothing
        local integer this= s__HagoromoE_allocate()
        set s__HagoromoE_caster[this]=s__HagoromoD_Hagoromo
        set s__HagoromoE_angle[this]=Atan2(GetSpellTargetY() - GetUnitY(s__HagoromoE_caster[this]), GetSpellTargetX() - GetUnitX(s__HagoromoE_caster[this]))
        set s__HagoromoE_count[this]=0
