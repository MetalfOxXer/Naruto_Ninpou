    function s__KabutoT_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
 local integer p
 local unit u
	set x=(((GetUnitX(s__KabutoT_dummy[this]) )*1.0) + Cos((( 3.8 * s__KabutoT_count[this] )*1.0)) * (( 10.0 * s__KabutoT_count[this])*1.0)) // INLINED!!
	set y=(((GetUnitY(s__KabutoT_dummy[this]) )*1.0) + Sin((( 3.8 * s__KabutoT_count[this] )*1.0)) * (( 10.0 * s__KabutoT_count[this])*1.0)) // INLINED!!
	set p=GetRandomInt(1, 4)
        if p == 1 then
	  //set bj_lastCreatedEffect = AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl", x, y)
        elseif p == 2 then
	  //set bj_lastCreatedEffect = AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl", x, y)
        elseif p == 3 then
	  //set bj_lastCreatedEffect = AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl", x, y)
        elseif p == 4 then
	  //set bj_lastCreatedEffect = AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl", x, y)
        endif
        //call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(-100, 100))
        //call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, GetRandomReal(0, 2*bj_PI))
        //call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(2, 3))
        //call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
        //call DestroyEffectTimed(bj_lastCreatedEffect, 1.25)
	set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl", x, y)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KabutoT_dummy[this]), GetUnitY(s__KabutoT_dummy[this]), 10 * s__KabutoT_count[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KabutoT_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__KabutoT_damaged[this]) then
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call GroupAddUnit(s__KabutoT_damaged[this], bj_lastCreatedUnit)
		    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
		    	set u=CreateUnit(GetOwningPlayer(s__KabutoT_caster[this]), 'e007', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
            	    	call UnitAddAbility(u, 'A0A3')
            	    	call IssueTargetOrder(u, "sleep", bj_lastCreatedUnit)
            	    	call UnitApplyTimedLife(u, 'BTLF', 0.20)

		    endif
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KabutoT_count[this]=s__KabutoT_count[this] + 1
        if s__KabutoT_count[this] > 60 then
	    call KillUnit(s__KabutoT_dummy[this])
	    call ShowUnit(s__KabutoT_dummy[this], false)
            call DestroyGroup(s__KabutoT_damaged[this])
            set s__KabutoT_damaged[this]=null
	    set s__KabutoT_dummy[this]=null
            call s__KabutoT_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KabutoT_delay takes nothing returns nothing
 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	call TimerStart(NewTimerEx(this), 0.025, true, function s__KabutoT_periodic)
	call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__KabutoT_actions takes nothing returns nothing
        local integer this= s__KabutoT_allocate()
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        local real new_x
        local real new_y
        local real scale
        local integer i
        local integer j
        set i=0
        call SetUnitAnimation(s__KabutoT_caster[this], "spell channel")
        loop
            exitwhen i > 6
            set j=0
            loop
                exitwhen j > 3
                set j=j + 1
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 100 * j)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 100 * j)*1.0)) // INLINED!!
                set scale=GetRandomReal(0.5, 1.5)
                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e06V', new_x, new_y, 60 * i)
                call SetUnitTimeScale(bj_lastCreatedUnit, 0.5)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.25)
            endloop
            set i=i + 1
        endloop
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Kabuto_Young_T, 100, GetTriggerUnit())
        endif
        set s__KabutoT_caster[this]=GetTriggerUnit()
	set s__KabutoT_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__KabutoT_caster[this]), GetUnitY(s__KabutoT_caster[this]), 270)
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\HolyForce.mdx" ), (( GetUnitX(s__KabutoT_caster[this]) )*1.0), (( GetUnitY(s__KabutoT_caster[this]))*1.0))) // INLINED!!
        set s__KabutoT_count[this]=0
        set s__KabutoT_damaged[this]=CreateGroup()
	call TimerStart(NewTimerEx(this), 0.1, false, function s__KabutoT_delay)
    endfunction 
    
    function s__KabutoT_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(45 , s__KabutoT_SPELL_ID , function s__KabutoT_actions)
    endfunction 
    
