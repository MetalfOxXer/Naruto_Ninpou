 function s__NejiNewSemi_start takes integer this returns nothing
		set s__NejiNewSemi_count[this]=s__NejiNewSemi_count[this] * 2
		call s__NejiNewSemi_showText(this)
		set bj_lastCreatedEffect=AddSpecialEffect("Hit.mdx", GetUnitX(s__NejiNewSemi_target[this]), GetUnitY(s__NejiNewSemi_target[this]))
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__NejiNewSemi_target[this]) , GetUnitY(s__NejiNewSemi_target[this])))
		call DestroyEffect(bj_lastCreatedEffect)
		//call AddSpecialEffectEx("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl", GetUnitX(this.target), GetUnitY(this.target))
		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__NejiNewSemi_caster[this]), 'hgry', GetUnitX(s__NejiNewSemi_caster[this]), GetUnitY(s__NejiNewSemi_caster[this]), GetUnitFacing(s__NejiNewSemi_caster[this]))
		call SetUnitTimeScale(bj_lastCreatedUnit, 3.0)
		call SetUnitAnimation(bj_lastCreatedUnit, "spell channel")
		//call SetUnitAnimationWithRarity(bj_lastCreatedUnit,"attack",RARITY_FREQUENT)
		call SetUnitVertexColorBJEx(bj_lastCreatedUnit , 100 , 100 , 100 , 60.00)
		call UnitApplyTimedLifeBJ(0.10, 'BTLF', bj_lastCreatedUnit)
		call SetUnitAnimation(s__NejiNewSemi_target[this], "death")
		call SetUnitAnimationWithRarity(s__NejiNewSemi_caster[this], "attack", RARITY_FREQUENT)
                if s__NejiNewSemi_domo3[this] == null then
			set s__NejiNewSemi_domo3[this]=CreateUnit(GetOwningPlayer(s__NejiNewSemi_caster[this]), 'h016', GetUnitX(s__NejiNewSemi_target[this]), GetUnitY(s__NejiNewSemi_target[this]), 270)
			call TimerStart(NewTimerEx(this), 0.5, false, function s__NejiNewSemi_decreaseTime)
		endif
 endfunction 

 function s__NejiNewSemi_actions takes nothing returns nothing
  local integer this= s__NejiNewSemi_allocate()
  local real new_x
  local real new_y
		set s__NejiNewSemi_caster[this]=GetTriggerUnit()
		set s__NejiNewSemi_target[this]=GetSpellTargetUnit()
		set s__NejiNewSemi_domo[this]=CreateUnit(GetOwningPlayer(s__NejiNewSemi_caster[this]), 'e007', GetUnitX(s__NejiNewSemi_target[this]), GetUnitY(s__NejiNewSemi_target[this]), 270)
		set s__NejiNewSemi_domo2[this]=CreateUnit(GetTriggerPlayer(), 'h025', GetUnitX(s__NejiNewSemi_target[this]), GetUnitY(s__NejiNewSemi_target[this]), 270)
		set s__NejiNewSemi_domo3[this]=null
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
			call PlaySoundOnUnitBJ(gg_snd_Neji_R, 100.0, GetTriggerUnit())
		endif
		if GetUnitAbilityLevel(s__NejiNewSemi_caster[this], 'B00F') == 0 then
			call PauseUnit(s__NejiNewSemi_caster[this], true)
		endif
		call PauseUnit(s__NejiNewSemi_target[this], true)
		if GetUnitAbilityLevel(s__NejiNewSemi_caster[this], 'B01Z') == 0 then
			call SetUnitInvulnerable(s__NejiNewSemi_target[this], true)
		endif
		call UnitAddAbility(s__NejiNewSemi_caster[this], 'A02Q')
		//call SetUnitAnimation(this.caster, "morph")
		call SetUnitTimeScale(s__NejiNewSemi_caster[this], 1.5)
		set s__NejiNewSemi_count[this]=1
		set s__NejiNewSemi_count2[this]=0
		set s__NejiNewSemi_angle[this]=Rad2Deg(Atan3(GetUnitX(s__NejiNewSemi_caster[this]) , GetUnitY(s__NejiNewSemi_caster[this]) , GetUnitX(s__NejiNewSemi_target[this]) , GetUnitY(s__NejiNewSemi_target[this]))) + 180
		set new_x=(((GetUnitX(s__NejiNewSemi_target[this]) )*1.0) + Cos((( Deg2Rad(s__NejiNewSemi_angle[this]) )*1.0)) * (( 200)*1.0)) // INLINED!!
		set new_y=(((GetUnitY(s__NejiNewSemi_target[this]) )*1.0) + Sin((( Deg2Rad(s__NejiNewSemi_angle[this]) )*1.0)) * (( 200)*1.0)) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__NejiNewSemi_caster[this]) )*1.0), (( GetUnitY(s__NejiNewSemi_caster[this]))*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		call SetUnitX(s__NejiNewSemi_caster[this], new_x)
		call SetUnitY(s__NejiNewSemi_caster[this], new_y)
		call SetUnitFacing(s__NejiNewSemi_caster[this], s__NejiNewSemi_angle[this])
		set s__NejiNewSemi_tt[this]=null
		set s__NejiNewSemi_target_x[this]=GetUnitX(s__NejiNewSemi_caster[this])
		set s__NejiNewSemi_target_y[this]=GetUnitY(s__NejiNewSemi_caster[this])
		call TimerStart(NewTimerEx(this), 0.01, true, function s__NejiNewSemi_periodic)
 endfunction 
	
 function s__NejiNewSemi_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(14 , s__NejiNewSemi_SPELL_ID , function s__NejiNewSemi_actions)
 endfunction 

