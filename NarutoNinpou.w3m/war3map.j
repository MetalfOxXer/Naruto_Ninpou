    function s__ShisuiSilentKill_pause0 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real target_x= GetUnitX(s__ShisuiSilentKill_target[this])
        local real target_y= GetUnitY(s__ShisuiSilentKill_target[this])
        local real new_x= (((target_x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__ShisuiSilentKill_target[this]) + 180) )*1.0)) * (( 120.0)*1.0)) // INLINED!!
        local real new_y= (((target_y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__ShisuiSilentKill_target[this]) + 180) )*1.0)) * (( 120.0)*1.0)) // INLINED!!
        local real new_x2
        local real new_y2
        local real angle
        call SetUnitX(s__ShisuiSilentKill_caster[this], new_x)
        call SetUnitY(s__ShisuiSilentKill_caster[this], new_y)
        set angle=Atan3(GetUnitX(s__ShisuiSilentKill_caster[this]) , GetUnitY(s__ShisuiSilentKill_caster[this]) , GetUnitX(s__ShisuiSilentKill_target[this]) , GetUnitY(s__ShisuiSilentKill_target[this]))
        if GetUnitAbilityLevel(s__ShisuiSilentKill_caster[this], 'A0RI') > 0 then
            call DestroyEffect(AddSpecialEffect(("ItachiE.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        elseif GetUnitAbilityLevel(s__ShisuiSilentKill_caster[this], 'A0S7') > 0 then
            call DestroyEffect(AddSpecialEffect(("FireCrack.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            set new_x2=(((new_x )*1.0) + Cos((( angle )*1.0)) * (( 60)*1.0)) // INLINED!!
            set new_y2=(((new_y )*1.0) + Sin((( angle )*1.0)) * (( 60)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("FireSlash.mdl", new_x2, new_y2)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(new_x2 , new_y2))
            call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.5)
            call DestroyEffect(bj_lastCreatedEffect)
        else
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        endif
        call SetUnitAnimation(s__ShisuiSilentKill_caster[this], "spell four")
        call TimerStart(NewTimerEx(this), 0.3, false, function s__ShisuiSilentKill_pause1)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__ShisuiSilentKill_actions takes nothing returns nothing
        local integer this
        local unit target= null
        local real angle
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, GetPlayableMapRect(), null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if bj_lastCreatedUnit == s__ShisuiGenjutsu_ShisuiE then
                set target=bj_lastCreatedUnit
                exitwhen true
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if GetUnitAbilityLevel(GetTriggerUnit(), 'A0RI') > 0 then
            call DestroyEffect(AddSpecialEffect(("ItachiE.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
            if target != null then
                set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetUnitX(target) , GetUnitY(target))
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetTriggerUnit()), 'h08H', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), Rad2Deg(angle))
            endif
        	call SetUnitTimeScale(bj_lastCreatedUnit, 1.0)
        	call SetUnitAnimationWithRarity(bj_lastCreatedUnit, "attack", RARITY_FREQUENT)
        	call SetUnitVertexColorBJEx(bj_lastCreatedUnit , 100 , 100 , 100 , 60.00)
       		call UnitApplyTimedLifeBJ(0.5, 'BTLF', bj_lastCreatedUnit)
        elseif GetUnitAbilityLevel(GetTriggerUnit(), 'A0S7') > 0 then
            call DestroyEffect(AddSpecialEffect(("FireCrack.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        else
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        endif
        if target != null then
            set this=s__ShisuiSilentKill_allocate()
            set s__ShisuiSilentKill_caster[this]=GetTriggerUnit()
            set s__ShisuiSilentKill_target[this]=target
            call PauseUnit(s__ShisuiSilentKill_caster[this], true)
            call TimerStart(NewTimerEx(this), 0.1, false, function s__ShisuiSilentKill_pause0)
        endif
    endfunction

        function s__ShisuiSilentKill_death takes nothing returns nothing
            if GetUnitTypeId(GetTriggerUnit()) == 'h08H' then
                call ShowUnit(GetTriggerUnit(), false)
            endif
        endfunction

    
    function s__ShisuiSilentKill_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(65 , s__ShisuiSilentKill_SPELL_ID , function s__ShisuiSilentKill_actions)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__ShisuiSilentKill_death))) // INLINED!!
    endfunction
    
