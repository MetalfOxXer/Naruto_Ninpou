                set s__MuuInvisibility_Alloc___recycle[(0)]=s__MuuInvisibility_Alloc___recycle[s__MuuInvisibility_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MuuInvisibility_deallocate takes integer this returns nothing
            set s__MuuInvisibility_Alloc___recycle[this]=s__MuuInvisibility_Alloc___recycle[(0)]
            set s__MuuInvisibility_Alloc___recycle[(0)]=this
        endfunction
    
    function s__MuuInvisibility_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetHeroInt(s__MuuInvisibility_caster[this], GetHeroInt(s__MuuInvisibility_caster[this], false) - s__MuuInvisibility_stat[this], false)
        call s__MuuInvisibility_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__MuuInvisibility_actions takes nothing returns nothing
        local integer this= s__MuuInvisibility_allocate()
