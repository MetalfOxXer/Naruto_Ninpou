//textmacro instance: UltimateChoice("Kakuzu", "A0W4", "A0TG", "RELEASE_MASKS", "Release Masks", "A0W9", "COMBINED_ATTACK", "Masks: Combined Attack")

//Implemented from module Alloc:
    
        function s__KakuzuUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KakuzuUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__KakuzuUltimateChoice_Alloc___instanceCount=s__KakuzuUltimateChoice_Alloc___instanceCount + 1
                set this=s__KakuzuUltimateChoice_Alloc___instanceCount
            else
                set this=s__KakuzuUltimateChoice_Alloc___recycle[(0)]
                set s__KakuzuUltimateChoice_Alloc___recycle[(0)]=s__KakuzuUltimateChoice_Alloc___recycle[s__KakuzuUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KakuzuUltimateChoice_deallocate takes integer this returns nothing
            set s__KakuzuUltimateChoice_Alloc___recycle[this]=s__KakuzuUltimateChoice_Alloc___recycle[(0)]
            set s__KakuzuUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__KakuzuUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__KakuzuUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakuzuUltimateChoice_caster[this]), 'A0W4', false)
        else
            call s__KakuzuUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KakuzuUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__KakuzuUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__KakuzuUltimateChoice_u, s__KakuzuUltimateChoice_RELEASE_MASKS)
            call UnitMakeAbilityPermanent(s__KakuzuUltimateChoice_u, true, s__KakuzuUltimateChoice_RELEASE_MASKS)
        else
            call UnitAddAbility(s__KakuzuUltimateChoice_u, s__KakuzuUltimateChoice_COMBINED_ATTACK)
            call UnitMakeAbilityPermanent(s__KakuzuUltimateChoice_u, true, s__KakuzuUltimateChoice_COMBINED_ATTACK)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0W4', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0W4', false)
        set s__s__KakuzuUltimateChoice_b[0]= null
        set s__s__KakuzuUltimateChoice_b[1]= null
        set s__KakuzuUltimateChoice_u=null
        call s__Dialog_destroy(s__KakuzuUltimateChoice_d)
        call DestroyBoolExpr(s__KakuzuUltimateChoice_pick)
        set s__KakuzuUltimateChoice_pick=null
        set this=s__KakuzuUltimateChoice_allocate()
        set s__KakuzuUltimateChoice_caster[this]=s__KakuzuUltimateChoice_u
        set s__KakuzuUltimateChoice_pp[this]=GetOwningPlayer(s__KakuzuUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__KakuzuUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__KakuzuUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__KakuzuUltimateChoice_RELEASE_MASKS) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__KakuzuUltimateChoice_COMBINED_ATTACK) == 0 then
            set s__KakuzuUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__KakuzuUltimateChoice_d,"Pick a skill")
            set s__s__KakuzuUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__KakuzuUltimateChoice_d)], ("Release Masks" ), ( 0))) // INLINED!!
            set s__s__KakuzuUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__KakuzuUltimateChoice_d)], ("Masks: Combined Attack" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__KakuzuUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__KakuzuUltimateChoice_d,s__KakuzuUltimateChoice_pick)
            set s__KakuzuUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__KakuzuUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0W4' then
            set s__KakuzuUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__KakuzuUltimateChoice_onInit takes nothing returns nothing
        set s__KakuzuUltimateChoice_pick=Condition(function s__KakuzuUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__KakuzuUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0W4' ) , Filter(( function s__KakuzuUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Kakuzu", "A0W4", "A0TG", "RELEASE_MASKS", "Release Masks", "A0W9", "COMBINED_ATTACK", "Masks: Combined Attack")

