    function s__KillerBeeHachimaki_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KillerBeeHachimaki_caster[this])
        local real y= GetUnitY(s__KillerBeeHachimaki_caster[this])
        local real angle
        local real x2
        local real y2
        local real new_x
        local real new_y
        if ModuloInteger(s__KillerBeeHachimaki_count[this], 3) == 0 then
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__KillerBeeHachimaki_caster[this]) ), ( 'e015' ), (( GetUnitX(s__KillerBeeHachimaki_caster[this]) )*1.0), (( GetUnitY(s__KillerBeeHachimaki_caster[this]) )*1.0), (( GetRandomReal(0, 360))*1.0))) // INLINED!!
            call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__KillerBeeHachimaki_caster[this]))
            call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__KillerBeeHachimaki_caster[this]))
            call SetUnitTimeScale(bj_lastCreatedUnit, 1.5)
            call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
            call KillUnit(bj_lastCreatedUnit)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 800.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KillerBeeHachimaki_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                call UnitDamageTarget(s__KillerBeeHachimaki_caster[this], bj_lastCreatedUnit, 5.0 * GetHeroStr(s__KillerBeeHachimaki_caster[this], true) / 66.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    set x2=GetUnitX(bj_lastCreatedUnit)
                    set y2=GetUnitY(bj_lastCreatedUnit)
                    set angle=Atan3(x2 , y2 , x , y)
                    set new_x=(((x2 )*1.0) + Cos((( angle )*1.0)) * (( 3.0)*1.0)) // INLINED!!
                    set new_y=(((y2 )*1.0) + Sin((( angle )*1.0)) * (( 3.0)*1.0)) // INLINED!!
                    if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(bj_lastCreatedUnit, new_x)
                        call SetUnitY(bj_lastCreatedUnit, new_y)
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x2 )*1.0), (( y2)*1.0))) // INLINED!!
                    endif
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KillerBeeHachimaki_count[this]=s__KillerBeeHachimaki_count[this] + 1
        if s__KillerBeeHachimaki_count[this] > 66 then
            call PauseUnit(s__KillerBeeHachimaki_caster[this], false)
            call s__KillerBeeHachimaki_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KillerBeeHachimaki_actions takes nothing returns nothing
        local integer this= s__KillerBeeHachimaki_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call PlaySoundOnUnitBJ(gg_snd_Killer_Bee_Transform_Q, 100, GetTriggerUnit())
    endif
        set s__KillerBeeHachimaki_caster[this]=GetTriggerUnit()
        set s__KillerBeeHachimaki_count[this]=0
        call PauseUnit(s__KillerBeeHachimaki_caster[this], true)
        call SetUnitAnimation(s__KillerBeeHachimaki_caster[this], "spell slam")
        call SetUnitTimeScale(s__KillerBeeHachimaki_caster[this], 2.0)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KillerBeeHachimaki_periodic)
    endfunction 
    
