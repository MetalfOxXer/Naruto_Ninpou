    function s__SuigetsuDemonFish_destroy takes integer this returns nothing
        local integer id= (GetUnitUserData((s__SuigetsuDemonFish_caster[this]))) // INLINED!!
        local real x
        local real y
        local integer i
        local integer j
        set s__SuigetsuDemonFish_DEMON_FISH_UNIT=null
        set i=1
        loop
            exitwhen i > 2
            set j=1
            loop
                exitwhen j > 10
                set x=(((GetUnitX(s__SuigetsuDemonFish_caster[this]) )*1.0) + Cos((( Deg2Rad(36 * j) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__SuigetsuDemonFish_caster[this]) )*1.0) + Sin((( Deg2Rad(36 * j) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set j=j + 1
            endloop
            set i=i + 1
        endloop
        call RecycleUnit(s__SuigetsuDemonFish_bubble[this])
       // call UnitMakeAbilityPermanent(this.caster, false, 'A03B')
       // call UnitRemoveAbility(this.caster, 'A03B')
        call SetUnitVertexColor((s__SuigetsuDemonFish_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
        call SetUnitFlyHeight(s__SuigetsuDemonFish_caster[this], 0, 0)
        call RemoveSavedInteger(Table__ht, (s__SuigetsuDemonFish_casters), (id)) // INLINED!!
        set s__SuigetsuDemonFish_caster[this]=null
        set s__SuigetsuDemonFish_bubble[this]=null
        call s__SuigetsuDemonFish_deallocate(this)
    endfunction
    
    function s__SuigetsuDemonFish_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SuigetsuDemonFish_caster[this])
        local real y= GetUnitY(s__SuigetsuDemonFish_caster[this])
        local real angle
        local real new_x
        local real new_y
        local real mp
        set s__SuigetsuDemonFish_count[this]=s__SuigetsuDemonFish_count[this] + 1
        call SetUnitX(s__SuigetsuDemonFish_bubble[this], x)
        call SetUnitY(s__SuigetsuDemonFish_bubble[this], y)
        call SetUnitFacing(s__SuigetsuDemonFish_bubble[this], GetUnitFacing(s__SuigetsuDemonFish_caster[this]))
        if IsUnitHidden(s__SuigetsuDemonFish_caster[this]) then
            call SetUnitVertexColor((s__SuigetsuDemonFish_bubble[this] ), ( 255 ), ( 255 ), ( 255 ), ( 0)) // INLINED!!
        else
            call SetUnitVertexColor(s__SuigetsuDemonFish_bubble[this], 255, 255, 255, 255)
        endif
        call SetUnitVertexColor((s__SuigetsuDemonFish_caster[this] ), ( 0 ), ( 150 ), ( 255 ), ( 175)) // INLINED!!
        //call ShowUnit(this.bubble, not IsUnitHidden(this.caster))
        set mp=GetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_LIFE) - s__SuigetsuDemonFish_hp[this]
        if mp < 0 then
            call SetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_MANA, GetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_MANA) + ( mp / 4.0 ))
        endif
        call SetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_LIFE, s__SuigetsuDemonFish_hp[this])
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SuigetsuDemonFish_caster[this]), GetUnitY(s__SuigetsuDemonFish_caster[this]), 300.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SuigetsuDemonFish_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=GetAngleUnits(bj_lastCreatedUnit , s__SuigetsuDemonFish_caster[this])
                if UnitHasItemOfTypeBJ(s__SuigetsuDemonFish_caster[this], 'I057') then
                    set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 5)*1.0)) // INLINED!!
                    set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 5)*1.0)) // INLINED!!
                else
                    set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 3)*1.0)) // INLINED!!
                    set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 3)*1.0)) // INLINED!!
                endif
                if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                   // call SetUnitX(bj_lastCreatedUnit, new_x)
                   // call SetUnitY(bj_lastCreatedUnit, new_y)
                endif
                call UnitDamageTarget(s__SuigetsuDemonFish_caster[this], bj_lastCreatedUnit, ( GetHeroStr(s__SuigetsuDemonFish_caster[this], true) / 2 + GetHeroAgi(s__SuigetsuDemonFish_caster[this], true) / 2 ) / 33, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)


            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if GetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_LIFE) <= 0.405 or GetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_MANA) <= 10 or s__SuigetsuDemonFish_count[this] > 33 * 20 then
            call s__SuigetsuDemonFish_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SuigetsuDemonFish_actions takes nothing returns nothing
        local integer this
        local integer id= (GetUnitUserData((GetTriggerUnit()))) // INLINED!!
        if not (HaveSavedInteger(Table__ht, (s__SuigetsuDemonFish_casters), (id))) then // INLINED!!
            set this=s__SuigetsuDemonFish_allocate()
            set s__SuigetsuDemonFish_caster[this]=GetTriggerUnit()
            set s__SuigetsuDemonFish_DEMON_FISH_UNIT=s__SuigetsuDemonFish_caster[this]
            call SaveInteger(Table__ht, (s__SuigetsuDemonFish_casters), ((GetUnitUserData((s__SuigetsuDemonFish_caster[this])))), ( R2I(GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE)))) // INLINED!!
            set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( s__SuigetsuDemonFish_DUMMY_ID ), (( GetUnitX(s__SuigetsuDemonFish_caster[this]) )*1.0), (( GetUnitY(s__SuigetsuDemonFish_caster[this]) )*1.0), (( GetUnitFacing(s__SuigetsuDemonFish_caster[this]))*1.0))) //CreateDummy(GetTriggerPlayer(), GetUnitX(this.caster), GetUnitY(this.caster), GetUnitFacing(this.caster), 0.8, 0, 0, 21.0, "Sasuke_Susano'o.mdl", false) // INLINED!!
            set s__SuigetsuDemonFish_bubble[this]=bj_lastCreatedUnit
            set s__SuigetsuDemonFish_count[this]=0
            call AddLoadingBar(s__SuigetsuDemonFish_caster[this] , 25)
         //   call UnitAddAbility(this.caster, 'A03B')
         //   call UnitMakeAbilityPermanent(this.caster, true, 'A03B')
            call SetUnitVertexColor((s__SuigetsuDemonFish_caster[this] ), ( 0 ), ( 150 ), ( 255 ), ( 175)) // INLINED!!
            call SetUnitFlyHeight(s__SuigetsuDemonFish_caster[this], 100, 0)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__SuigetsuDemonFish_periodic)
            set s__SuigetsuDemonFish_hp[this]=GetUnitState(s__SuigetsuDemonFish_caster[this], UNIT_STATE_LIFE)
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Suigetsu_T_Wave, 80.0, GetTriggerUnit())
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Suigetsu: I will have much pleasure to cut your meat into pieces!|r")
            endif
        endif
    endfunction
    
    function s__SuigetsuDemonFish_onInit takes nothing returns nothing
        set s__SuigetsuDemonFish_casters=s__Table_create()
        call RegisterSpellEffectEventForId(46 , 'A0HY' , function s__SuigetsuDemonFish_actions)
    endfunction
    
