            call KillUnit(s__TobiramaHiraishin_hiraishinMark)
        elseif s__TobiramaHiraishin_hiraishinTarget != null and GetWidgetLife(s__TobiramaHiraishin_hiraishinTarget) > 0.405 then //and GetUnitAbilityLevel(hiraishinTarget, 'B043') > 0 then 
