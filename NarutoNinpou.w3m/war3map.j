    function s__MitsukiSnakes_dealDamage takes nothing returns boolean
                		if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__MitsukiSnakes_caster[s__MitsukiSnakes_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                    			call UnitDamageTarget(s__MitsukiSnakes_caster[s__MitsukiSnakes_instance], GetFilterUnit(), 1000 + GetHeroInt(s__MitsukiSnakes_caster[s__MitsukiSnakes_instance], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                		endif
			return false
  endfunction

 function s__MitsukiSnakes_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real angle
  local real dist
  local real offset
  local real x
  local real y
  local integer i
		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MitsukiSnakes_caster[this]), 'h064', s__MitsukiSnakes_target_x[this], s__MitsukiSnakes_target_y[this], GetRandomReal(0, 360))
		call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
		call SetUnitScale(bj_lastCreatedUnit, 0.1 + 0.04 * s__MitsukiSnakes_count[this], 0, 0)
		call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(0, 300), 0)
		call SetUnitAnimation(bj_lastCreatedUnit, "spell two")
		call SetUnitTimeScale(bj_lastCreatedUnit, 1.0 + 6.0 / 44 * s__MitsukiSnakes_count[this])
		call GroupAddUnit(s__MitsukiSnakes_snakes[this], bj_lastCreatedUnit)
		set s__MitsukiSnakes_count[this]=s__MitsukiSnakes_count[this] + 1
		if s__MitsukiSnakes_count[this] > 33 then
			call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl" ), (( s__MitsukiSnakes_target_x[this] )*1.0), (( s__MitsukiSnakes_target_y[this])*1.0))) // INLINED!!
        		set i=1
        		loop
            		exitwhen i > 20
            			set i=i + 1
				set dist=GetRandomReal(25, 150)
				set angle=Deg2Rad(GetRandomReal(0, 360))
				set x=(((s__MitsukiSnakes_target_x[this] )*1.0) + Cos((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
				set y=(((s__MitsukiSnakes_target_y[this] )*1.0) + Sin((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                		set s__MitsukiSnakes_snakers[this]=CreateUnit(GetOwningPlayer(s__MitsukiSnakes_caster[this]), 'h064', x, y, 24 * i)
                		set x=s__MitsukiSnakes_target_x[this] + Cos(Deg2Rad(30 * i)) * 800
                		set y=s__MitsukiSnakes_target_y[this] + Sin(Deg2Rad(30 * i)) * 800
				call SetUnitAnimation(s__MitsukiSnakes_snakers[this], "death")
				call SetUnitVertexColor(s__MitsukiSnakes_snakers[this], 255, 255, 255, 255)
				call SetUnitMoveSpeed(s__MitsukiSnakes_snakers[this], 400)
                		call IssuePointOrder(s__MitsukiSnakes_snakers[this], "move", x, y)
                		call UnitApplyTimedLife(s__MitsukiSnakes_snakers[this], 'BTLF', 2.0)
        		endloop
            		set bj_lastCreatedGroup=CreateGroup()
					set s__MitsukiSnakes_instance=this
            		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__MitsukiSnakes_target_x[this], s__MitsukiSnakes_target_y[this], 300.0, Filter(function s__MitsukiSnakes_dealDamage))
            		call DestroyGroup(bj_lastCreatedGroup)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__MitsukiSnakes_snakes[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__MitsukiSnakes_snakes[this], bj_lastCreatedUnit)
				call KillUnit(bj_lastCreatedUnit)
				call ShowUnit(bj_lastCreatedUnit, false)
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			set s__MitsukiSnakes_snakes[this]=null
			call s__MitsukiSnakes_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__MitsukiSnakes_actions takes nothing returns nothing
  local integer this= s__MitsukiSnakes_allocate()
		set s__MitsukiSnakes_caster[this]=GetTriggerUnit()
		set s__MitsukiSnakes_target_x[this]=GetSpellTargetX()
                set s__MitsukiSnakes_target_y[this]=GetSpellTargetY()
		set s__MitsukiSnakes_count[this]=0
