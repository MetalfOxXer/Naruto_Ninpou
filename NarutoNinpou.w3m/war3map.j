                call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 2.0 * GetHeroAgi(GetAttacker(), true) + 250, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
