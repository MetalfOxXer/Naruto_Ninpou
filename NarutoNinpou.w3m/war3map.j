function Trig_RockLeeDrunkenFist_RemoveInvul takes nothing returns nothing
 local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
	set udg_RockLeeCooldowns[(GetUnitUserData((u)))]=false // INLINED!!
	call SetUnitInvulnerable(u, false)
	call ReleaseTimer(GetExpiredTimer())
endfunction 

function Trig_RockLeeDrunkenFist_Actions takes nothing returns nothing
    local real angle
    local real offset
    local real x
    local real y
    if GetUnitAbilityLevel(GetTriggerUnit(), 'B060') > 0 and GetEventDamage() > 100 and not udg_RockLeeCooldowns[(GetUnitUserData((GetTriggerUnit())))] and GetRandomInt(0, 100) < 20 then // INLINED!!
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        set angle=Deg2Rad(GetRandomReal(0, 360))
        set offset=GetRandomReal(0, 400)
        set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
        	call SetUnitX(GetTriggerUnit(), x)
        	call SetUnitY(GetTriggerUnit(), y)
	endif
        call SetUnitInvulnerable(GetTriggerUnit(), true)
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
        set udg_RockLeeCooldowns[(GetUnitUserData((GetTriggerUnit())))]=true // INLINED!!
        call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 0.2, false, function Trig_RockLeeDrunkenFist_RemoveInvul) // INLINED!!
    endif
endfunction

function Trig_RockLeeDrunkenFist_AddBar takes nothing returns nothing
    call AddLoadingBar(GetTriggerUnit() , 10.0)
    set udg_RockLeeCooldowns[(GetUnitUserData((GetTriggerUnit())))]=false // INLINED!!
endfunction 

function InitTrig_RockLeeDrunkenFist_Leave takes nothing returns nothing
	if GetUnitTypeId(GetLeavingUnit()) == 'H070' then
    	    call TriggerRegisterUnitEvent(gg_trg_RockLeeDrunkenFist, GetLeavingUnit(), EVENT_UNIT_DAMAGED)
            call GroupAddUnit(udg_Gengetsus, GetLeavingUnit())
	endif
endfunction

//===========================================================================
function InitTrig_RockLeeDrunkenFist takes nothing returns nothing
    call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function InitTrig_RockLeeDrunkenFist_Leave))) // INLINED!!
    call RegisterSpellEffectEventForId(51 , 'A16K' , function Trig_RockLeeDrunkenFist_AddBar)
    set gg_trg_RockLeeDrunkenFist=CreateTrigger()
    call TriggerAddAction(gg_trg_RockLeeDrunkenFist, function Trig_RockLeeDrunkenFist_Actions)
endfunction


