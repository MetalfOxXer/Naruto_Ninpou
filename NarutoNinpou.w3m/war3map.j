        local real angle
        set s__KimimaroNewYanagi2_count[this]=s__KimimaroNewYanagi2_count[this] + 1
        set angle=GetAngleUnits(s__KimimaroNewYanagi2_caster[this] , s__KimimaroNewYanagi2_target[this])
