    function s__ShisuiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__ShisuiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__ShisuiUltimateChoice_caster[this]), 'A0SJ', false)
        else
            call s__ShisuiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ShisuiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__ShisuiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__ShisuiUltimateChoice_u, s__ShisuiUltimateChoice_SUSANOO)
            call UnitMakeAbilityPermanent(s__ShisuiUltimateChoice_u, true, s__ShisuiUltimateChoice_SUSANOO)
        else
            call UnitAddAbility(s__ShisuiUltimateChoice_u, s__ShisuiUltimateChoice_TSUKUMO)
            call UnitMakeAbilityPermanent(s__ShisuiUltimateChoice_u, true, s__ShisuiUltimateChoice_TSUKUMO)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0SJ', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0SJ', false)
        set s__s__ShisuiUltimateChoice_b[0]= null
        set s__s__ShisuiUltimateChoice_b[1]= null
        set s__ShisuiUltimateChoice_u=null
        call s__Dialog_destroy(s__ShisuiUltimateChoice_d)
        call DestroyBoolExpr(s__ShisuiUltimateChoice_pick)
        set s__ShisuiUltimateChoice_pick=null
        set this=s__ShisuiUltimateChoice_allocate()
        set s__ShisuiUltimateChoice_caster[this]=s__ShisuiUltimateChoice_u
        set s__ShisuiUltimateChoice_pp[this]=GetOwningPlayer(s__ShisuiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__ShisuiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__ShisuiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__ShisuiUltimateChoice_SUSANOO) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__ShisuiUltimateChoice_TSUKUMO) == 0 then
            set s__ShisuiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__ShisuiUltimateChoice_d,"Pick a skill")
            set s__s__ShisuiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__ShisuiUltimateChoice_d)], ("Perfect Susano'o" ), ( 0))) // INLINED!!
            set s__s__ShisuiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__ShisuiUltimateChoice_d)], ("Susano'o: Tsukumo" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__ShisuiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__ShisuiUltimateChoice_d,s__ShisuiUltimateChoice_pick)
            set s__ShisuiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__ShisuiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0SJ' then
            set s__ShisuiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__ShisuiUltimateChoice_onInit takes nothing returns nothing
        set s__ShisuiUltimateChoice_pick=Condition(function s__ShisuiUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__ShisuiUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0SJ' ) , Filter(( function s__ShisuiUltimateChoice_actions))) // INLINED!!
    endfunction 
    
