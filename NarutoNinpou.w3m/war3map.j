            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\EarthQuake\\EarthQuakeTarget.mdl" ), (( GetUnitX(s__FuuGrab_target[this]) )*1.0), (( GetUnitY(s__FuuGrab_target[this]))*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(s__FuuGrab_target[this]) )*1.0), (( GetUnitY(s__FuuGrab_target[this]))*1.0))) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("CircularWind.mdl", GetUnitX(s__FuuGrab_target[this]), GetUnitY(s__FuuGrab_target[this]))
            call DestroyEffect(bj_lastCreatedEffect)
            set i=0
            loop
                exitwhen i > 12
                set angle=( 360 / 12 ) * i
                set offset=100
                set x=GetUnitX(s__FuuGrab_caster[this]) + Cos(Deg2Rad(angle)) * offset
                set y=GetUnitY(s__FuuGrab_caster[this]) + Sin(Deg2Rad(angle)) * offset
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
            call PauseUnit(s__FuuGrab_caster[this], false)
            call s__FuuGrab_deallocate(this)
