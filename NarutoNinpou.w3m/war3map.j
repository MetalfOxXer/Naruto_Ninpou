 function s__SpiritOrbs_windCritCDoff takes nothing returns nothing
  local integer uid= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__s__SpiritOrbs_windCritCD[uid]= false
		call ReleaseTimer(GetExpiredTimer())
 endfunction

 function s__SpiritOrbs_exeCritCDoff takes nothing returns nothing
  local integer uid= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__s__SpiritOrbs_exeCritCD[uid]= false
		call ReleaseTimer(GetExpiredTimer())
 endfunction	

     function s__SpiritOrbs_actions takes nothing returns nothing
 local real damage
	//Spirit of Fire
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I05Z') or UnitHasItemOfTypeBJ(GetAttacker(), 'I045') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04L') or UnitHasItemOfTypeBJ(GetAttacker(), 'I01Z') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04F') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02D') or UnitHasItemOfTypeBJ(GetAttacker(), 'I028') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02W') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'n03F', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), GetUnitFacing(GetAttacker()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A04U')
			call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetTriggerUnit())
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
		endif
	endif
	//Spirit of Earth
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I05X') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04J') or UnitHasItemOfTypeBJ(GetAttacker(), 'I022') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04D') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02B') or UnitHasItemOfTypeBJ(GetAttacker(), 'I025') or UnitHasItemOfTypeBJ(GetAttacker(), 'I048') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06B') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03M') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06B') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'n03F', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), GetUnitFacing(GetAttacker()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A0CG')
			call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetTriggerUnit())
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
		endif
	endif
	//Spirit of Thunder
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I07L') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04A') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04M') or UnitHasItemOfTypeBJ(GetAttacker(), 'I021') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04G') or UnitHasItemOfTypeBJ(GetAttacker(), 'I029') or UnitHasItemOfTypeBJ(GetAttacker(), 'I027') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03N') or UnitHasItemOfTypeBJ(GetAttacker(), 'I058') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 and GetRandomInt(1, 100) <= 20 then

        	set bj_lastCreatedGroup=CreateGroup()
 		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 400, null)
        	loop
            	  set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            	  exitwhen bj_lastCreatedUnit == null
            		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(GetAttacker())) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                		call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\Bolt\\BoltImpact.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
            			call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, 300, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
            		endif
            	  call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        	endloop
        	call DestroyGroup(bj_lastCreatedGroup)

		endif
	endif
	// Spirit of Water
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I05W') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02Y') or UnitHasItemOfTypeBJ(GetAttacker(), 'I047') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04I') or UnitHasItemOfTypeBJ(GetAttacker(), 'I01Y') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02A') or UnitHasItemOfTypeBJ(GetAttacker(), 'I024') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03L') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02H') or UnitHasItemOfTypeBJ(GetAttacker(), 'I031') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'n03F', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), GetUnitFacing(GetAttacker()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A04V')
			call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetTriggerUnit())
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
		endif
	endif
	//Spirit of Darkness
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I04K') or UnitHasItemOfTypeBJ(GetAttacker(), 'I023') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04E') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I026') or UnitHasItemOfTypeBJ(GetAttacker(), 'I049') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06D') or UnitHasItemOfTypeBJ(GetAttacker(), 'I032') or UnitHasItemOfTypeBJ(GetAttacker(), 'I05U') or UnitHasItemOfTypeBJ(GetAttacker(), 'I05G') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'n03F', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), GetUnitFacing(GetAttacker()))
			if ( UnitHasItemOfTypeBJ(GetAttacker(), 'I06D') and UnitHasItemOfTypeBJ(GetAttacker(), 'I05U') ) then
				call UnitAddAbility(bj_lastCreatedUnit, 'A056')
				call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A056', 3)
			elseif ( UnitHasItemOfTypeBJ(GetAttacker(), 'I05G') or UnitHasItemOfTypeBJ(GetAttacker(), 'I032') or UnitHasItemOfTypeBJ(GetAttacker(), 'I049') or UnitHasItemOfTypeBJ(GetAttacker(), 'I023') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04E') or UnitHasItemOfTypeBJ(GetAttacker(), 'I02C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04K') or UnitHasItemOfTypeBJ(GetAttacker(), 'I026') ) and UnitHasItemOfTypeBJ(GetAttacker(), 'I05U') then
				call UnitAddAbility(bj_lastCreatedUnit, 'A056')
				call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A056', 2)
			else
				call UnitAddAbility(bj_lastCreatedUnit, 'A056')
				call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A056', 1)
			endif
			call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetTriggerUnit())
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
		endif
	endif
	//Spirit of Light
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I061') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06E') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06G') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06F') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 and GetRandomInt(1, 100) <= 15 then
            		call SilenceUnitLight(GetAttacker() , GetTriggerUnit())
            		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
		endif
	endif



	//Spirit of Wind
        if not IsUnitIllusion(GetAttacker()) and ( UnitHasItemOfTypeBJ(GetAttacker(), 'I057') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03O') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I032') or UnitHasItemOfTypeBJ(GetAttacker(), 'I007') or UnitHasItemOfTypeBJ(GetAttacker(), 'I046') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03A') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04B') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04H') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03B') ) then
		if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 and IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false then
			if ( UnitHasItemOfTypeBJ(GetAttacker(), 'I007') or UnitHasItemOfTypeBJ(GetAttacker(), 'I046') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03A') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04B') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03C') or UnitHasItemOfTypeBJ(GetAttacker(), 'I04H') or UnitHasItemOfTypeBJ(GetAttacker(), 'I03B') ) and not s__s__SpiritOrbs_windCritCD[(GetUnitUserData((GetAttacker())))] then // INLINED!!
				if I2R(GetHeroStr(GetAttacker(), true)) > I2R(GetHeroAgi(GetAttacker(), true)) and I2R(GetHeroStr(GetAttacker(), true)) > I2R(GetHeroInt(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroStr(GetAttacker(), true)) * 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroStr(GetAttacker(), true)) * 2
				elseif I2R(GetHeroInt(GetAttacker(), true)) > I2R(GetHeroStr(GetAttacker(), true)) and I2R(GetHeroInt(GetAttacker(), true)) > I2R(GetHeroAgi(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroInt(GetAttacker(), true)) * 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroInt(GetAttacker(), true)) * 2
				elseif I2R(GetHeroAgi(GetAttacker(), true)) > I2R(GetHeroStr(GetAttacker(), true)) and I2R(GetHeroAgi(GetAttacker(), true)) > I2R(GetHeroInt(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroAgi(GetAttacker(), true)) * 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroAgi(GetAttacker(), true)) * 2
				endif
				set s__s__SpiritOrbs_windCritCD[(GetUnitUserData((GetAttacker())))]= true // INLINED!!
				call TimerStart(NewTimerEx((GetUnitUserData((GetAttacker())))), 2.0, false, function s__SpiritOrbs_windCritCDoff) // INLINED!!
			endif
			if ( UnitHasItemOfTypeBJ(GetAttacker(), 'I03O') or UnitHasItemOfTypeBJ(GetAttacker(), 'I06C') ) and GetRandomInt(1, 100) <= 15 then
				if I2R(GetHeroStr(GetAttacker(), true)) > I2R(GetHeroAgi(GetAttacker(), true)) and I2R(GetHeroStr(GetAttacker(), true)) > I2R(GetHeroInt(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroStr(GetAttacker(), true)), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroStr(GetAttacker(), true))
				elseif I2R(GetHeroInt(GetAttacker(), true)) > I2R(GetHeroStr(GetAttacker(), true)) and I2R(GetHeroInt(GetAttacker(), true)) > I2R(GetHeroAgi(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroInt(GetAttacker(), true)), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroInt(GetAttacker(), true))
				elseif I2R(GetHeroAgi(GetAttacker(), true)) > I2R(GetHeroStr(GetAttacker(), true)) and I2R(GetHeroAgi(GetAttacker(), true)) > I2R(GetHeroInt(GetAttacker(), true)) then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroAgi(GetAttacker(), true)), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroAgi(GetAttacker(), true))
				endif
			endif
            		if UnitHasItemOfTypeBJ(GetAttacker(), 'I032') and GetRandomInt(1, 100) <= 20 then
					call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), I2R(GetHeroStr(GetAttacker(), true)) * 0.7 + I2R(GetHeroInt(GetAttacker(), true)) * 0.7 + I2R(GetHeroAgi(GetAttacker(), true)) * 0.7, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					set damage=I2R(GetHeroStr(GetAttacker(), true)) * 0.7 + I2R(GetHeroInt(GetAttacker(), true)) * 0.7 + I2R(GetHeroAgi(GetAttacker(), true)) * 0.7
