call AddSpecialEffectTarget(("SuperShinyThingy.mdx" ), ( s__RockLeeUraRenge___Spell_caster[this] ), ( "left foot")) // INLINED!!
            call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_caster[this], 0, 1000)
            call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_target[this], 0, 1000)
