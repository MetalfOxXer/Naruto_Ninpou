                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300.0, Filter(function s__ShinoQ_dealDamage))
                call DestroyGroup(bj_lastCreatedGroup)
                call KillUnit(s__ShinoQ_dummy[this])
