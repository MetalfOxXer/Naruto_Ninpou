                set s__KillerBeeThrowInk_missile[this]=AddSpecialEffect("doomboltmissile.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                call TimerStart(NewTimerEx(this), 0.03 * i, false, function s__KillerBeeThrowInk_start)
                call RemoveLocation(l1)
                set l1=null
                set j=j + 1
                exitwhen j > 5
            endloop
            set i=i + 1
        endloop
        call RemoveLocation(l3)
        call RemoveLocation(l4)
        set l3=null
        set l4=null
    endfunction
    
