    function s__KurenaiSemi_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real offset
        local integer i
        set i=0
        loop
            exitwhen i > 3
            set angle=GetRandomReal(0, 2 * bj_PI)
            set offset=GetRandomReal(0, 150.0)
            set x=(((GetUnitX(s__KurenaiSemi_tree[this]) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__KurenaiSemi_tree[this]) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            //call AddSpecialEffectEx("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl", x, y)
            set i=i + 1
        endloop
        call KillUnit(s__KurenaiSemi_tree[this])
        call ShowUnit(s__KurenaiSemi_tree[this], false)
        call KillUnit(s__KurenaiSemi_dummy[this])
        call ShowUnit(s__KurenaiSemi_dummy[this], false)
        call SetUnitX(s__KurenaiSemi_caster[this], GetUnitX(s__KurenaiSemi_tree[this]))
        call SetUnitY(s__KurenaiSemi_caster[this], GetUnitY(s__KurenaiSemi_tree[this]))
        call SetUnitFacing(s__KurenaiSemi_caster[this], GetUnitFacing(s__KurenaiSemi_tree[this]))
        call SetUnitVertexColor((s__KurenaiSemi_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
        //call SetUnitInvulnerable(this.caster, false)
        call PauseUnit(s__KurenaiSemi_caster[this], false)
        call ShowUnit(s__KurenaiSemi_caster[this], true)
        call SelectUnitForPlayerSingle(s__KurenaiSemi_caster[this], GetOwningPlayer(s__KurenaiSemi_caster[this]))
        set s__KurenaiSemi_caster[this]=null
        set s__KurenaiSemi_target[this]=null
        set s__KurenaiSemi_tree[this]=null
        set s__KurenaiSemi_dummy[this]=null
        call s__KurenaiSemi_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__KurenaiSemi_hit takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(s__KurenaiSemi_target[this]) )*1.0), (( GetUnitY(s__KurenaiSemi_target[this]))*1.0))) // INLINED!!
        call PauseUnit(s__KurenaiSemi_target[this], false)
        //call StunUnitTimed(this.caster, this.target, 2.0)
        call UnitDamageTarget(s__KurenaiSemi_caster[this], s__KurenaiSemi_target[this], ( 800 + GetHeroInt(s__KurenaiSemi_caster[this], true) ) * GetUnitAbilityLevel(s__KurenaiSemi_caster[this], s__KurenaiSemi_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        call SetUnitAnimation(s__KurenaiSemi_target[this], "death")
        call TimerStart(NewTimerEx(this), 0.25, false, function s__KurenaiSemi_finish)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__KurenaiSemi_appear takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__KurenaiSemi_count[this]=s__KurenaiSemi_count[this] + 1
        call SetUnitVertexColor((s__KurenaiSemi_dummy[this] ), ( 255 ), ( 255 ), ( 255 ), ( 30 * s__KurenaiSemi_count[this])) // INLINED!!
        if s__KurenaiSemi_count[this] > 8 then
            call SetUnitTimeScale(s__KurenaiSemi_dummy[this], 0.5)
            call SetUnitAnimation(s__KurenaiSemi_dummy[this], "attack")
            call TimerStart(NewTimerEx(this), 0.25, false, function s__KurenaiSemi_hit)
