        function s__RockLeeHachimon___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            if GetUnitTypeId(s__RockLeeHachimon___Spell_caster[this]) == 'H070' then
