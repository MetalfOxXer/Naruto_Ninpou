 function s__RockLeeHachimon___Spell_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	    	call SetUnitMoveSpeed(s__RockLeeHachimon___Spell_caster[this], ( 300 ) + ( 20.00 * I2R(GetUnitAbilityLevelSwapped(s__RockLeeHachimon___Spell_SPELL_ID, s__RockLeeHachimon___Spell_caster[this])) ))
            	if GetUnitAbilityLevelSwapped(s__RockLeeHachimon___Spell_SPELL_ID, s__RockLeeHachimon___Spell_caster[this]) >= 5 then
                	call UnitAddAbility(s__RockLeeHachimon___Spell_caster[this], 'A0L5')
            	endif
            	if GetUnitAbilityLevelSwapped(s__RockLeeHachimon___Spell_SPELL_ID, s__RockLeeHachimon___Spell_caster[this]) >= 10 then
                	call UnitAddAbility(s__RockLeeHachimon___Spell_caster[this], 'A0JW')
            	endif
            	call TimerStartEx(NewTimerEx(this) , 0.1 , true , function s__RockLeeHachimon___Spell_periodic , "RockLeeHachimon_periodic")
		call ReleaseTimer(GetExpiredTimer())
 endfunction
        
        function s__RockLeeHachimon___Spell_actions takes nothing returns nothing
