// Trigger: ObitoJinchuuriki
//===========================================================================
// scope ObitoJinchuuriki begins

    
//Implemented from module Alloc:
    
        function s__ObitoJinchuuriki___Spell_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ObitoJinchuuriki___Spell_Alloc___recycle[(0)] == 0 ) then
                set s__ObitoJinchuuriki___Spell_Alloc___instanceCount=s__ObitoJinchuuriki___Spell_Alloc___instanceCount + 1
                set this=s__ObitoJinchuuriki___Spell_Alloc___instanceCount
            else
