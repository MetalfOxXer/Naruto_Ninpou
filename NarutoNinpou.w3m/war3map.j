        call DestroyGroup(bj_lastCreatedGroup)

        if GetDistance(x , y , s__SuigetsuDrowningNew_target_x[this] , s__SuigetsuDrowningNew_target_y[this]) <= 50 or s__SuigetsuDrowningNew_count2[this] >= 30 or s__SuigetsuDrowningNew_herohit[this] then
