                endif
            endif
            return debuffId
        endfunction        
        
        // This method removes all debuffs currently active on the unit
        function s__HagoromoD_removeAllDebuffs takes integer this returns nothing
            //local thistype this = thistype.allocate()
            local integer debuffId
        
            // Loop through all possible debuffs and remove them (adjust this if needed)
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 1, 0) // Earth Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 2, 0) // Water Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 3, 0) // Fire Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 4, 0) // Wind Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 5, 0) // Lightning Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 6, 0) // Lava Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 7, 0) // Wood Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 8, 0) // Boil Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 9, 0) // Magnet Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 10, 0) // Ice Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 11, 0) // Scorch Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 12, 0) // Explosion Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)
        
            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 13, 0) // Storm Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 14, 0) // Blaze Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            set debuffId=LoadInteger(HagoromoChargesD_DebuffTable, 15, 0) // Swift Debuff
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, debuffId)

            //call this.deallocate()
        endfunction                

        function s__HagoromoD_actions takes nothing returns nothing
            local integer this
            local integer this2
            local integer i= 0
            local real target_x
            local real target_y
            local real angle
            local unit u
    
            if GetTriggerUnit() == s__HagoromoD_Hagoromo and GetSpellAbilityId() != 'A0PH' and GetSpellAbilityId() == s__HagoromoD_HagoromoSpellQueue then
                set this=s__HagoromoD_allocate()
                set this2=s__HagoromoD_allocate()
                set target_x=(s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__HagoromoD_Hagoromo)))]) // INLINED!!
                set target_y=(s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__HagoromoD_Hagoromo)))]) // INLINED!!
                set angle=Atan2(target_y - GetUnitY(s__HagoromoD_Hagoromo), target_x - GetUnitX(s__HagoromoD_Hagoromo)) * bj_RADTODEG
                set s__HagoromoD_count[this]=0
                //call BJDebugMsg("Spell Cast")
                if ( s__HagoromoD_HagoromoCasting == true ) and ( ( s__HagoromoD_HagoromoSpellCurrent != s__HagoromoD_HagoromoSpellPrevious ) and ( s__HagoromoD_HagoromoSpellCurrent != s__HagoromoD_HagoromoSpellPenultimate ) and ( s__HagoromoD_HagoromoSpellCurrent != s__HagoromoD_HagoromoSpellAntepenultimate ) ) and ( ( s__HagoromoD_HagoromoCurrentCharges > 0 and s__HagoromoD_combineRelease == false ) or ( s__HagoromoD_HagoromoCurrentCharges > 1 and s__HagoromoD_combineRelease == true ) ) then
                    
                    if HagoromoChargesD_release != null then
                        call DestroyEffect(HagoromoChargesD_release)
                        set HagoromoChargesD_release=null
                    endif

                    call SetUnitFacingTimed(s__HagoromoD_Hagoromo, angle, 0.01)
    
                    if s__HagoromoD_combineRelease == true then
                        set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges - 2
                        //call SetUnitAnimation(this.Hagoromo, "spell slam")
                    else
                        set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges - 1
                        //call SetUnitAnimation(this.Hagoromo, "spell")
                    endif
    
                    if s__HagoromoD_HagoromoSpellPrevious == 0 and s__HagoromoD_HagoromoSpellPenultimate == 0 and s__HagoromoD_HagoromoSpellAntepenultimate == 0 then
                        // First time casting a spell
                        set s__HagoromoD_HagoromoSpellPrevious=s__HagoromoD_HagoromoSpellCurrent
                    elseif s__HagoromoD_HagoromoSpellPrevious != 0 and s__HagoromoD_HagoromoSpellPenultimate == 0 and s__HagoromoD_HagoromoSpellAntepenultimate == 0 then
                        // Second time casting a spell
                        set s__HagoromoD_HagoromoSpellPenultimate=s__HagoromoD_HagoromoSpellPrevious
                        set s__HagoromoD_HagoromoSpellPrevious=s__HagoromoD_HagoromoSpellCurrent
                    elseif s__HagoromoD_HagoromoSpellPrevious != 0 and s__HagoromoD_HagoromoSpellPenultimate != 0 and s__HagoromoD_HagoromoSpellAntepenultimate == 0 then
                        // Third time casting a spell
                        set s__HagoromoD_HagoromoSpellAntepenultimate=s__HagoromoD_HagoromoSpellPenultimate
                        set s__HagoromoD_HagoromoSpellPenultimate=s__HagoromoD_HagoromoSpellPrevious
                        set s__HagoromoD_HagoromoSpellPrevious=s__HagoromoD_HagoromoSpellCurrent
                    elseif s__HagoromoD_HagoromoSpellPrevious != 0 and s__HagoromoD_HagoromoSpellPenultimate != 0 and s__HagoromoD_HagoromoSpellAntepenultimate != 0 then
                        // Fourth time casting a spell
                        set s__HagoromoD_HagoromoSpellAntepenultimate=s__HagoromoD_HagoromoSpellPenultimate
                        set s__HagoromoD_HagoromoSpellPenultimate=s__HagoromoD_HagoromoSpellPrevious
                        set s__HagoromoD_HagoromoSpellPrevious=s__HagoromoD_HagoromoSpellCurrent
                    endif

                    //call BJDebugMsg("Recharge Time: " + I2S(6 + (this.HagoromoMaxCharges - (ModuloInteger(this.HagoromoCurrentCharges, this.HagoromoMaxCharges)))*2))
                    //call BJDebugMsg("Current Charges: " + I2S(ModuloInteger(this.HagoromoCurrentCharges, this.HagoromoMaxCharges)) + " / " + I2S(this.HagoromoMaxCharges))
    
                    if s__HagoromoD_HagoromoRecharging == false then
                        set s__HagoromoD_HagoromoRecharging=true
                        set s__HagoromoD_HagoromoRechargeSpeed=0
                        call TimerStart(NewTimerEx(this2), 0.03, true, function s__HagoromoD_rechargeTimerPeriodic)
                    endif
    
                    if s__HagoromoD_HagoromoSpellCurrent == 1 then
                        call TriggerEvaluate(st__HagoromoQ_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0QY')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 2 then
                        call TriggerEvaluate(st__HagoromoW_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0R0')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 3 then
                        call TriggerEvaluate(st__HagoromoE_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0R2')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 4 then
                        call TriggerEvaluate(st__HagoromoR_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0R7')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 5 then
                        call TriggerEvaluate(st__HagoromoT_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0R8')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 6 then
                        call TriggerEvaluate(st__HagoromoQW_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0RB')
                        //call SetUnitX(u, GetUnitX(this.Hagoromo))
                        //call SetUnitY(u, GetUnitY(this.Hagoromo))
                        //call IssueTargetOrder(u, "acidbomb", this.Hagoromo)
                        //set u = null
                    elseif s__HagoromoD_HagoromoSpellCurrent == 7 then
                        call TriggerEvaluate(st__HagoromoWE_actions) // INLINED!!
