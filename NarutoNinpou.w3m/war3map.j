			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 


    function s__TentenNewBomb_throw takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real dist
 local real angle1
 local real x= GetUnitX(s__TentenNewBomb_projectile[this])
 local real y= GetUnitY(s__TentenNewBomb_projectile[this])
 local real angle= Atan3(x , y , s__TentenNewBomb_target_x[this] , s__TentenNewBomb_target_y[this])
