            else
                set this=s__MuTracking_Alloc___recycle[(0)]
                set s__MuTracking_Alloc___recycle[(0)]=s__MuTracking_Alloc___recycle[s__MuTracking_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MuTracking_deallocate takes integer this returns nothing
            set s__MuTracking_Alloc___recycle[this]=s__MuTracking_Alloc___recycle[(0)]
