         local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__BorutoClone_periodic , "BorutoClone_periodic")
    endfunction

