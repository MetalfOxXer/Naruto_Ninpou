                        call UnitDamageTarget(s__ShinoQ_caster[this], bj_lastCreatedUnit, 40.0 * GetUnitAbilityLevel(s__ShinoQ_caster[this], s__ShinoQ_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
