    function s__KonanNewSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KonanNewSemi_lance[this])
        local real y= GetUnitY(s__KonanNewSemi_lance[this])
        local real angle= Atan3(x , y , GetUnitX(s__KonanNewSemi_target[this]) , GetUnitY(s__KonanNewSemi_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real dist2= GetDistance(x , y , GetUnitX(s__KonanNewSemi_target[this]) , GetUnitY(s__KonanNewSemi_target[this]))
        local real fly= 500 - 440 * ( 1 - dist2 / s__KonanNewSemi_dist[this] )
        local integer i
        call SetUnitX(s__KonanNewSemi_lance[this], new_x)
        call SetUnitY(s__KonanNewSemi_lance[this], new_y)
        call SetUnitFacing(s__KonanNewSemi_lance[this], Rad2Deg(angle) - 90)
        call SetUnitFlyHeight(s__KonanNewSemi_lance[this], fly, 0)
        set s__KonanNewSemi_count[this]=s__KonanNewSemi_count[this] + 1
        if dist2 < 100 or s__KonanNewSemi_count[this] > 200 then
            set x=GetUnitX(s__KonanNewSemi_target[this])
            set y=GetUnitY(s__KonanNewSemi_target[this])
            set i=0
            loop
                set i=i + 1
                exitwhen i > 10
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
            endloop
	     call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack Big.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__KonanNewSemi_caster[this]) ), ( 'e01E' ), (( x )*1.0), (( y )*1.0), (( GetUnitFacing(s__KonanNewSemi_caster[this]))*1.0))) // INLINED!!
            call SetUnitScale(bj_lastCreatedUnit, 1.0, 1.0, 1.0)
            call KillUnit(bj_lastCreatedUnit)
            call ShowUnit(s__KonanNewSemi_target[this], true)
            call SelectUnitForPlayerSingle(s__KonanNewSemi_target[this], GetOwningPlayer(s__KonanNewSemi_target[this]))
            if GetHeroLevel(s__KonanNewSemi_caster[this]) >= 15 then
                call UnitDamageTarget(s__KonanNewSemi_caster[this], s__KonanNewSemi_target[this], ( 1.5 * GetHeroInt(s__KonanNewSemi_caster[this], true) + 600 ) * 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            else
                call UnitDamageTarget(s__KonanNewSemi_caster[this], s__KonanNewSemi_target[this], ( 1.5 * GetHeroInt(s__KonanNewSemi_caster[this], true) + 600 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
            call PauseUnit(s__KonanNewSemi_target[this], false)
            call SetUnitAnimation(s__KonanNewSemi_target[this], "death")
            call KillUnit(s__KonanNewSemi_lance[this])
            call KillUnit(s__KonanNewSemi_cage[this])
            set s__KonanNewSemi_lance[this]=null
            set s__KonanNewSemi_cage[this]=null
            set s__KonanNewSemi_target[this]=null
            call s__KonanNewSemi_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    

    function s__KonanNewSemi_throwLance takes nothing returns nothing
