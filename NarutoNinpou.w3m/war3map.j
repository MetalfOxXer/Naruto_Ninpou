    function s__NejiNewW_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        call SetUnitX(s__NejiNewW_dummy[this], GetUnitX(s__NejiNewW_caster[this]))
        call SetUnitY(s__NejiNewW_dummy[this], GetUnitY(s__NejiNewW_caster[this]))
	call SetUnitX(s__NejiNewW_kaiten[this], GetUnitX(s__NejiNewW_caster[this]))
	call SetUnitY(s__NejiNewW_kaiten[this], GetUnitY(s__NejiNewW_caster[this]))
        //call SetUnitFlyHeight(this.dummy, GetUnitFlyHeight(this.caster), 0)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NejiNewW_caster[this]), GetUnitY(s__NejiNewW_caster[this]), 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NejiNewW_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(GetUnitX(s__NejiNewW_caster[this]) , GetUnitY(s__NejiNewW_caster[this]) , x , y)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                    if ModuloInteger(s__NejiNewW_count[this], 5) == 0 then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    endif
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__NejiNewW_damaged[this]) then
                    call GroupAddUnit(s__NejiNewW_damaged[this], bj_lastCreatedUnit)
                    call UnitDamageTarget(s__NejiNewW_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__NejiNewW_caster[this], s__NejiNewW_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__NejiNewW_count[this]=s__NejiNewW_count[this] + 1
        if s__NejiNewW_count[this] > 33 then
            call KillUnit(s__NejiNewW_dummy[this])
            call ShowUnit(s__NejiNewW_dummy[this], false)
	    call KillUnit(s__NejiNewW_kaiten[this])
            call SetUnitVertexColor((s__NejiNewW_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
	    call SetUnitInvulnerable(s__NejiNewW_caster[this], false)
            call DestroyGroup(s__NejiNewW_damaged[this])
            set s__NejiNewW_damaged[this]=null
            call s__NejiNewW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NejiNewW_actions takes nothing returns nothing
