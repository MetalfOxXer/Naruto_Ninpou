                set s___SasoriSenbons_senbons[s__SasoriSenbons_senbons[this]+i]=CreateUnit(GetOwningPlayer(s__SasoriSenbons_caster[this]), 'h088', GetUnitX(s__SasoriSenbons_caster[this]), GetUnitY(s__SasoriSenbons_caster[this]), s__SasoriSenbons_angle - 30 + 6.66 * ( i + 1 ))
                set i=i + 1
