                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffdf80ffSasuke: If you interfere with my revenge, I'll crush you. That's all!|r")
                                		
								
                elseif ( GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'U002' or GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'U00P' or GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'H06D' or GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'H09Y' or GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'H02O' or GetUnitTypeId(udg_units33[GetPlayerId(pk) + 1]) == 'N01Y' ) then
                    call PlaySoundOnUnitBJ(gg_snd_Orochimaru_Kill, 175.0, GetTriggerUnit())
