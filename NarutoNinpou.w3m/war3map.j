        if ( GetUnitFlyHeight(s__SakuraGetLost_caster[this]) <= 50 or s__SakuraGetLost_count[this] >= 5 ) then
		set i=0
		loop
			exitwhen i > 5
			set angle=Deg2Rad(60 * i)
			set new_x=(((GetUnitX(s__SakuraGetLost_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
			set new_y=(((GetUnitY(s__SakuraGetLost_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 200)*1.0)) // INLINED!!
			set bj_lastCreatedEffect=AddSpecialEffect("war3mapimported\\Earth_Spikes.mdl", new_x, new_y)
			call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(45))
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
			call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
			call DestroyEffect(bj_lastCreatedEffect)
			set i=i + 1
		endloop
            set l=Location(GetUnitX(s__SakuraGetLost_caster[this]), GetUnitY(s__SakuraGetLost_caster[this]))
            call TerrainDeformationRippleBJ(1.50, false, l, 100.00, 300.00, 128, 0.25, 50.00)
            call RemoveLocation(l)
            set l=null
            set bj_lastCreatedGroup=CreateGroup()
            set s__SakuraGetLost_instance=this
            set s__SakuraGetLost_count[this]=0
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SakuraGetLost_caster[this]), GetUnitY(s__SakuraGetLost_caster[this]), 300.0, Filter(function s__SakuraGetLost_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
