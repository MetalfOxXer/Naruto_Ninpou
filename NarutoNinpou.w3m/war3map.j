                    exitwhen j > 11
                    if j != 3 and j != 7 and j != 11 then
                        if ( IsPlayerAlly(Player(i), Player(3)) and IsPlayerAlly(Player(j), Player(3)) ) or ( IsPlayerAlly(Player(i), Player(7)) and IsPlayerAlly(Player(j), Player(7)) ) or ( IsPlayerAlly(Player(i), Player(11)) and IsPlayerAlly(Player(j), Player(11)) ) then
                            call SetPlayerAllianceStateAllyBJ(Player(i), Player(j), true)
                            call SetPlayerAllianceStateAllyBJ(Player(j), Player(i), true)
                        endif
                    endif
                    set j=j + 1
                endloop
            endif
            set i=i + 1
        endloop
        call DestroyForce(s__YaguraBloodList_affected[this])
	call GroupClear(udg_BloodMist)
        set s__YaguraBloodList_affected[this]=null
        call s__YaguraBloodList_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__YaguraBloodList_actions takes nothing returns nothing
        local integer this= s__YaguraBloodList_allocate()
        local integer i= 0
        local real x
        local real y
	set udg_Yagura=GetTriggerUnit()
        set s__YaguraBloodList_caster[this]=GetTriggerUnit()
        set s__YaguraBloodList_affected[this]=CreateForce()
        loop
            set i=i + 1
            exitwhen i > 30
            set x=(((GetUnitX(s__YaguraBloodList_caster[this]) )*1.0) + Cos((( Deg2Rad(45 * i) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__YaguraBloodList_caster[this]) )*1.0) + Sin((( Deg2Rad(45 * i) )*1.0)) * (( 200.0)*1.0)) // INLINED!!
            if i > 8 then
                set x=(((GetUnitX(s__YaguraBloodList_caster[this]) )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 450.0)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__YaguraBloodList_caster[this]) )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 450.0)*1.0)) // INLINED!!
            endif
            if i > 18 then
                set x=(((GetUnitX(s__YaguraBloodList_caster[this]) )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 700.0)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__YaguraBloodList_caster[this]) )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 700.0)*1.0)) // INLINED!!
            endif
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Weapons\\SteamMissile\\SteamMissile.mdl", x, y)
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 7.0)
            call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.5)
            call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 255, 0, 0)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 0)
            call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 5.0)*1.0) , false) // INLINED!!
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__YaguraBloodList_caster[this]), GetUnitY(s__YaguraBloodList_caster[this]), 800.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call ForceAddPlayer(s__YaguraBloodList_affected[this], GetOwningPlayer(bj_lastCreatedUnit))
                set i=0
                loop
                    exitwhen i > 11
                    if i != 3 and i != 7 and i != 11 then
                        call SetPlayerAllianceStateAllyBJ(GetOwningPlayer(bj_lastCreatedUnit), Player(i), false)
                        call SetPlayerAllianceStateAllyBJ(Player(i), GetOwningPlayer(bj_lastCreatedUnit), false)
                    endif
                    set i=i + 1
                endloop
		call GroupAddUnit(udg_BloodMist, bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 5.0, false, function s__YaguraBloodList_finish)
    endfunction 
    
    function s__YaguraBloodList_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(67 , s__YaguraBloodList_SPELL_ID , function s__YaguraBloodList_actions)
    endfunction

