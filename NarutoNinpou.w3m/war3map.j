    function s__JiroboHeadbutt_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real new_x= (((GetUnitX(s__JiroboHeadbutt_target[this]) )*1.0) + Cos((( s__JiroboHeadbutt_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__JiroboHeadbutt_target[this]) )*1.0) + Sin((( s__JiroboHeadbutt_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real z= ParabolaZ(300 , 10 , s__JiroboHeadbutt_count[this])
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__JiroboHeadbutt_target[this], new_x)
			call SetUnitY(s__JiroboHeadbutt_target[this], new_y)
		endif
        call UnitAddAbility(s__JiroboHeadbutt_target[this], 'Arav')
        call UnitRemoveAbility(s__JiroboHeadbutt_target[this], 'Arav')
        call SetUnitFlyHeight(s__JiroboHeadbutt_target[this], z, 0)
        set s__JiroboHeadbutt_count[this]=s__JiroboHeadbutt_count[this] + 1
        if s__JiroboHeadbutt_count[this] == 10 then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(s__JiroboHeadbutt_target[this]) )*1.0), (( GetUnitY(s__JiroboHeadbutt_target[this]))*1.0))) // INLINED!!
            call PauseUnit(s__JiroboHeadbutt_target[this], false)
            call SetUnitFlyHeight(s__JiroboHeadbutt_target[this], 0, 0)
            call s__JiroboHeadbutt_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__JiroboHeadbutt_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__JiroboHeadbutt_caster[this])
        local real y= GetUnitY(s__JiroboHeadbutt_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__JiroboHeadbutt_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__JiroboHeadbutt_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real x2
        local real y2
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
           call SetUnitX(s__JiroboHeadbutt_caster[this], new_x)
           call SetUnitY(s__JiroboHeadbutt_caster[this], new_y)
        endif
        call SetUnitFacing(s__JiroboHeadbutt_caster[this], Rad2Deg(s__JiroboHeadbutt_angle[this]))
        if GetUnitTypeId(s__JiroboHeadbutt_caster[this]) == 'H05E' then
            call SetUnitAnimationByIndex(s__JiroboHeadbutt_caster[this], 0)
        else
            call SetUnitAnimationByIndex(s__JiroboHeadbutt_caster[this], 10)
        endif
        set s__JiroboHeadbutt_count[this]=s__JiroboHeadbutt_count[this] + 1
        if ModuloInteger(s__JiroboHeadbutt_count[this], 5) == 0 then
            set x2=(((x )*1.0) + Cos((( s__JiroboHeadbutt_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set y2=(((y )*1.0) + Sin((( s__JiroboHeadbutt_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdx", x2, y2)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__JiroboHeadbutt_angle[this])
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__JiroboHeadbutt_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call UnitDamageTarget(s__JiroboHeadbutt_caster[this], bj_lastCreatedUnit, GetHeroStr(s__JiroboHeadbutt_caster[this], true) / 1.5 * GetUnitAbilityLevel(s__JiroboHeadbutt_caster[this], s__JiroboHeadbutt_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__JiroboHeadbutt_knockback)
                set s__JiroboHeadbutt_target[this]=bj_lastCreatedUnit
                set s__JiroboHeadbutt_count[this]=0
                call PauseUnit(s__JiroboHeadbutt_target[this], true)
            	call PauseUnit(s__JiroboHeadbutt_caster[this], false)
            	call SetUnitAnimation(s__JiroboHeadbutt_caster[this], "stand")
            	call SetUnitTimeScale(s__JiroboHeadbutt_caster[this], 1.0)
                    
                set bj_lastCreatedEffect=AddSpecialEffect("PunchImpact.mdl", GetUnitX(s__JiroboHeadbutt_target[this]), GetUnitY(s__JiroboHeadbutt_target[this]))
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__JiroboHeadbutt_caster[this]) + 180))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.3)
                call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__JiroboHeadbutt_target[this]) , GetUnitY(s__JiroboHeadbutt_target[this])))
                call DestroyEffect(bj_lastCreatedEffect)

                call ReleaseTimer(GetExpiredTimer())
                call DestroyGroup(bj_lastCreatedGroup)
                return
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__JiroboHeadbutt_count[this] > 800 / 35.0 then
            call PauseUnit(s__JiroboHeadbutt_caster[this], false)
            call SetUnitAnimation(s__JiroboHeadbutt_caster[this], "stand")
            call SetUnitTimeScale(s__JiroboHeadbutt_caster[this], 1.0)
            call s__JiroboHeadbutt_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__JiroboHeadbutt_actions takes nothing returns nothing
        local integer this= s__JiroboHeadbutt_allocate()
        set s__JiroboHeadbutt_caster[this]=GetTriggerUnit()
        set s__JiroboHeadbutt_count[this]=0
        set s__JiroboHeadbutt_angle[this]=Atan3(GetUnitX(s__JiroboHeadbutt_caster[this]) , GetUnitY(s__JiroboHeadbutt_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        call SetUnitTimeScale(s__JiroboHeadbutt_caster[this], 2.0)
        if GetUnitTypeId(s__JiroboHeadbutt_caster[this]) == 'H05E' then
            call SetUnitAnimationByIndex(s__JiroboHeadbutt_caster[this], 0)
        else
            call SetUnitAnimationByIndex(s__JiroboHeadbutt_caster[this], 10)
        endif
        call PauseUnit(s__JiroboHeadbutt_caster[this], true)
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__JiroboHeadbutt_caster[this]) )*1.0), (( GetUnitY(s__JiroboHeadbutt_caster[this]))*1.0))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.03, true, function s__JiroboHeadbutt_periodic)
    endfunction 

