   function s__MitsukiQ_dealDamage takes nothing returns boolean
          if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__MitsukiQ_caster[s__MitsukiQ_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
		call UnitDamageTarget(s__MitsukiQ_caster[s__MitsukiQ_instance], GetFilterUnit(), GetHeroInt(s__MitsukiQ_caster[s__MitsukiQ_instance], true) * GetUnitAbilityLevel(s__MitsukiQ_caster[s__MitsukiQ_instance], s__MitsukiQ_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
		call EsnareUnitTimed(s__MitsukiQ_caster[s__MitsukiQ_instance] , GetFilterUnit() , 2.0)
          endif
          return false
    endfunction


   function s__MitsukiQ_removesnakes takes nothing returns nothing
 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	loop
		set bj_lastCreatedUnit=FirstOfGroup(s__MitsukiQ_snakes[this])
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(s__MitsukiQ_snakes[this], bj_lastCreatedUnit)
		call KillUnit(bj_lastCreatedUnit)
		call ShowUnit(bj_lastCreatedUnit, false)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
	set s__MitsukiQ_snakes[this]=null
	call s__MitsukiQ_deallocate(this)
	call ReleaseTimer(GetExpiredTimer())
   endfunction
	
    function s__MitsukiQ_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MitsukiQ_dummy[this])
        local real y= GetUnitY(s__MitsukiQ_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__MitsukiQ_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__MitsukiQ_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
 local integer i
        set s__MitsukiQ_count[this]=s__MitsukiQ_count[this] + 1
        call SetUnitX(s__MitsukiQ_dummy[this], new_x)
        call SetUnitY(s__MitsukiQ_dummy[this], new_y)
	call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\StrongDrink\\BrewmasterMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 210.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MitsukiQ_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                set s__MitsukiQ_target[this]=bj_lastCreatedUnit
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__MitsukiQ_target[this] != null then
		call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdl" ), (( GetUnitX(s__MitsukiQ_target[this]) )*1.0), (( GetUnitY(s__MitsukiQ_target[this]))*1.0))) // INLINED!!
		set i=1
		loop
		exitwhen i > 3
            		set i=i + 1
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MitsukiQ_caster[this]), 'h064', GetUnitX(s__MitsukiQ_target[this]), GetUnitY(s__MitsukiQ_target[this]), GetRandomReal(0, 360))
			call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
			call SetUnitScale(bj_lastCreatedUnit, 0.4 + 0.08 * i, 0, 0)
			call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(0, 200), 0)
			call SetUnitAnimation(bj_lastCreatedUnit, "birth")
			call SetUnitTimeScale(bj_lastCreatedUnit, 1.0 + 6.0 / 44 * i)
			call GroupAddUnit(s__MitsukiQ_snakes[this], bj_lastCreatedUnit)
		endloop

		set bj_lastCreatedGroup=CreateGroup()
		set s__MitsukiQ_instance=this
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__MitsukiQ_target[this]), GetUnitY(s__MitsukiQ_target[this]), 300.0, Filter(function s__MitsukiQ_dealDamage))
		call DestroyGroup(bj_lastCreatedGroup)

		call KillUnit(s__MitsukiQ_dummy[this])
		call ShowUnit(s__MitsukiQ_dummy[this], false)
		set s__MitsukiQ_dummy[this]=null
		call TimerStart(NewTimerEx(this), 2.0, false, function s__MitsukiQ_removesnakes)
		call ReleaseTimer(GetExpiredTimer())
        elseif s__MitsukiQ_count[this] > 23 then
		call KillUnit(s__MitsukiQ_dummy[this])
		call ShowUnit(s__MitsukiQ_dummy[this], false)
		set s__MitsukiQ_dummy[this]=null
		call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__MitsukiQ_actions takes nothing returns nothing
        local integer this= s__MitsukiQ_allocate()
        set s__MitsukiQ_caster[this]=GetTriggerUnit()
        set s__MitsukiQ_target_x[this]=GetSpellTargetX()
        set s__MitsukiQ_target_y[this]=GetSpellTargetY()
        set s__MitsukiQ_target[this]=null
	set s__MitsukiQ_snakes[this]=CreateGroup()
        set s__MitsukiQ_angle[this]=Atan3(GetUnitX(s__MitsukiQ_caster[this]) , GetUnitY(s__MitsukiQ_caster[this]) , s__MitsukiQ_target_x[this] , s__MitsukiQ_target_y[this])
        set s__MitsukiQ_count[this]=0
        set s__MitsukiQ_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__MitsukiQ_caster[this]), GetUnitY(s__MitsukiQ_caster[this]), 270.0)
        call SetUnitAnimation(s__MitsukiQ_caster[this], "attack")
        call TimerStartEx(NewTimerEx(this) , 0.02 , true , function s__MitsukiQ_periodic , "MitsukiQ_periodic")
    endfunction
    
    function s__MitsukiQ_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(91 , s__MitsukiQ_SPELL_ID , function s__MitsukiQ_actions)
    endfunction
    
//===========================================================================
// Trigger: MitsukiRaiton
//===========================================================================

        
        function s__MitsukiRaiton_actions takes nothing returns nothing
            local group damaged= CreateGroup()
            local real caster_x= GetUnitX(GetTriggerUnit())
            local real caster_y= GetUnitY(GetTriggerUnit())
            local real target_x= GetSpellTargetX()
            local real target_y= GetSpellTargetY()
            local real angle= Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            local real new_x= caster_x + Cos(angle) * 100
            local real new_y= caster_y + Sin(angle) * 100
            local integer i= 0
            local real new_x_2
            local real new_y_2
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
         	//call PlaySoundOnUnitBJ(gg_snd_Mitsuki_W, 100, GetTriggerUnit())
            endif
            call SetUnitAnimation(GetTriggerUnit(), "spell channel")
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h05C', new_x, new_y, Rad2Deg(angle))
            call SetUnitX(bj_lastCreatedUnit, new_x)
            call SetUnitY(bj_lastCreatedUnit, new_y)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
            loop
                set i=i + 1
                exitwhen i > 7
                set new_x_2=new_x + Cos(angle) * ( 100 * i )
                set new_y_2=new_y + Sin(angle) * ( 100 * i )
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x_2, new_y_2, 240.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                        call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(GetTriggerUnit(), s__MitsukiRaiton_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                	call GroupAddUnit(damaged, bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
            endloop
            call DestroyGroup(damaged)
            set damaged=null
        endfunction
        
        function s__MitsukiRaiton_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(91 , s__MitsukiRaiton_SPELL_ID , function s__MitsukiRaiton_actions)
        endfunction
        
    
