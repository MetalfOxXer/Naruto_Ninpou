        call SetUnitTimeScale(s__FuuNewE_caster[this], 4.0)
        call SetUnitAnimation(s__FuuNewE_caster[this], "spell finish")
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__FuuNewE_caster[this]) )*1.0), (( GetUnitY(s__FuuNewE_caster[this]))*1.0))) // INLINED!!
        set bj_lastCreatedUnit=CreateAbilityDummy(s__FuuNewE_caster[this] , 'A007')
        call IssueTargetOrder(bj_lastCreatedUnit, "invisibility", s__FuuNewE_caster[this])
		call TimerStart(NewTimerEx(this), 0.03, true, function s__FuuNewE_periodic2)
    endfunction 
    
