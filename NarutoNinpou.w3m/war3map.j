    function s__ShizuneShield_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real diff= s__ShizuneShield_last_hp[this] - GetUnitState(s__ShizuneShield_target[this], UNIT_STATE_LIFE)
        if diff > 0 then
            set diff=RMinBJ(s__ShizuneShield_hp[this], diff)
            set s__ShizuneShield_hp[this]=s__ShizuneShield_hp[this] - diff
            call SetUnitState(s__ShizuneShield_target[this], UNIT_STATE_LIFE, GetUnitState(s__ShizuneShield_target[this], UNIT_STATE_LIFE) + diff)
        endif
        set s__ShizuneShield_last_hp[this]=GetUnitState(s__ShizuneShield_target[this], UNIT_STATE_LIFE)
        if s__ShizuneShield_hp[this] <= 0 or GetUnitAbilityLevel(s__ShizuneShield_target[this], 'B059') == 0 then
            call UnitRemoveAbility(s__ShizuneShield_target[this], 'B059')
            set s__ShizuneShield_target[this]=null
            call s__ShizuneShield_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ShizuneShield_actions takes nothing returns nothing
        local integer this= s__ShizuneShield_allocate()
        set s__ShizuneShield_target[this]=GetTriggerUnit()
        set s__ShizuneShield_hp[this]=( GetHeroStr(GetTriggerUnit(), true) / 2.5 ) * GetUnitAbilityLevel(GetTriggerUnit(), s__ShizuneShield_SPELL_ID)


        set s__ShizuneShield_last_hp[this]=GetUnitState(s__ShizuneShield_target[this], UNIT_STATE_LIFE)
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__ShizuneShield_periodic , "ShizuneShield_periodic")
    endfunction 
    
    function s__ShizuneShield_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(74 , s__ShizuneShield_SPELL_ID , function s__ShizuneShield_actions)
    endfunction 
    
