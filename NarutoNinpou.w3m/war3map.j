    function s__KakashiAnbuRaikiri_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KakashiAnbuRaikiri_caster[this])
        local real y= GetUnitY(s__KakashiAnbuRaikiri_caster[this])
     local real angle= Atan3(GetUnitX(s__KakashiAnbuRaikiri_caster[this]) , GetUnitY(s__KakashiAnbuRaikiri_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__KakashiAnbuRaikiri_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__KakashiAnbuRaikiri_caster[this])))])) // INLINED!!
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__KakashiAnbuRaikiri_caster[this], new_x)
            call SetUnitY(s__KakashiAnbuRaikiri_caster[this], new_y)
            call SetUnitFacing(s__KakashiAnbuRaikiri_caster[this], Rad2Deg(angle))
 
            call SetUnitX(s__KakashiAnbuRaikiri_dummy[this], new_x)
            call SetUnitY(s__KakashiAnbuRaikiri_dummy[this], new_y)
        endif
        call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakashiAnbuRaikiri_caster[this]), 'nogn', x, y, Rad2Deg(angle))
        call SetUnitX(bj_lastCreatedUnit, x)
        call SetUnitY(bj_lastCreatedUnit, y)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.2)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiAnbuRaikiri_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__KakashiAnbuRaikiri_damaged[this]) then
                    call UnitDamageTarget(s__KakashiAnbuRaikiri_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__KakashiAnbuRaikiri_caster[this], true) * GetUnitAbilityLevel(s__KakashiAnbuRaikiri_caster[this], s__KakashiAnbuRaikiri_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__KakashiAnbuRaikiri_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__KakashiAnbuRaikiri_count[this]=s__KakashiAnbuRaikiri_count[this] + 1
        if s__KakashiAnbuRaikiri_count[this] > 20 then
            call DestroyGroup(s__KakashiAnbuRaikiri_damaged[this])
            set s__KakashiAnbuRaikiri_damaged[this]=null
            call SetUnitTimeScale(s__KakashiAnbuRaikiri_caster[this], 1.0)
            call KillUnit(s__KakashiAnbuRaikiri_dummy[this])
            set s__KakashiAnbuRaikiri_dummy[this]=null
            call s__KakashiAnbuRaikiri_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
