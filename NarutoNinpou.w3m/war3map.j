        set s__PakuraE_PakuraEcastY=0.0
        call RegisterSpellEffectEventForId(87 , s__PakuraE_SPELL_ID , function s__PakuraE_actions)
        call RegisterSpellEffectEventForId(87 , s__PakuraE_RECAST_ID , function s__PakuraE_recast)
    endfunction
