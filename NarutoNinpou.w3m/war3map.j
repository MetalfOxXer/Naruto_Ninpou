                    elseif s__HagoromoD_HagoromoSpellCurrent == 14 then
                        call TriggerEvaluate(st__HagoromoTQ_actions) // INLINED!!
                        //set u = CreateAbilityDummy(this.Hagoromo, 'A0RZ')
