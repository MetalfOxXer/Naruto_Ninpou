    function s__IrukaWildAxes_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real t= s__IrukaWildAxes_progress[this]
        local real t2= t * t
        local real t3= t2 * t
        local real mt= 1. - t
        local real mt2= mt * mt
        local real mt3= mt2 * mt
        local real axeX
        local real axeY
        local real casterX= GetUnitX(s__IrukaWildAxes_caster[this])
        local real casterY= GetUnitY(s__IrukaWildAxes_caster[this])
        local real bezierX
        local real bezierY
        local real lerpFactor
        local effect trailFx

        set bezierX=mt3 * s__IrukaWildAxes_startX[this] + 3. * mt2 * t * s__IrukaWildAxes_ctrl1x[this] + 3. * mt * t2 * s__IrukaWildAxes_ctrl2x[this] + t3 * s__IrukaWildAxes_startX[this]
        set bezierY=mt3 * s__IrukaWildAxes_startY[this] + 3. * mt2 * t * s__IrukaWildAxes_ctrl1y[this] + 3. * mt * t2 * s__IrukaWildAxes_ctrl2y[this] + t3 * s__IrukaWildAxes_startY[this]

        if t > 0.8 then
            set lerpFactor=( t - 0.8 ) / 0.2
            set axeX=bezierX * ( 1. - lerpFactor ) + casterX * lerpFactor
            set axeY=bezierY * ( 1. - lerpFactor ) + casterY * lerpFactor
        else
            set axeX=bezierX
            set axeY=bezierY
        endif

        call SetUnitX(s__IrukaWildAxes_axe[this], axeX)
        call SetUnitY(s__IrukaWildAxes_axe[this], axeY)
        call SetUnitX(s__IrukaWildAxes_sfx[this], axeX)
        call SetUnitY(s__IrukaWildAxes_sfx[this], axeY)
        set trailFx=AddSpecialEffect(s__IrukaWildAxes_TRAIL_EFFECT, axeX, axeY)
        call BlzSetSpecialEffectScale(trailFx, s__IrukaWildAxes_TRAIL_EFFECT_SCALE)
        call DestroyEffect(trailFx)
        set trailFx=null
        call s__IrukaWildAxes_applyEffects(this,axeX , axeY)

        set s__IrukaWildAxes_progress[this]=s__IrukaWildAxes_progress[this] + s__IrukaWildAxes_SPEED

        if s__IrukaWildAxes_progress[this] >= 1. then
            call DestroyGroup(s__IrukaWildAxes_damaged[this])
            set s__IrukaWildAxes_damaged[this]=null
            call RemoveUnit(s__IrukaWildAxes_axe[this])
            set s__IrukaWildAxes_axe[this]=null
            call RemoveUnit(s__IrukaWildAxes_sfx[this])
            set s__IrukaWildAxes_sfx[this]=null
            set s__IrukaWildAxes_caster[this]=null
            call s__IrukaWildAxes_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__IrukaWildAxes_actions takes nothing returns nothing
        local integer this1= s__IrukaWildAxes_allocate()
        local integer this2= s__IrukaWildAxes_allocate()
        local real baseAngle
        local real angleOffset= 0.7853981633974483
        local real perpAngle1
        local real perpAngle2
        local real distToTarget
        local real ctrl1Dist
        local location targetLoc

        set s__IrukaWildAxes_caster[this1]=GetTriggerUnit()
        set s__IrukaWildAxes_caster[this2]=s__IrukaWildAxes_caster[this1]
