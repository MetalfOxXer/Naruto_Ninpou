        	set s__KakashiNewRaikiri_e2[this]=AddSpecialEffectTarget("war3mapImported\\RedRaikiri.mdx", s__KakashiNewRaikiri_caster[this], "right hand")
            call SetUnitTimeScale(s__KakashiNewRaikiri_caster[this], 4.0)
