//Implemented from module Alloc:
    
        function s__ChakraJump_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ChakraJump_Alloc___recycle[(0)] == 0 ) then
                set s__ChakraJump_Alloc___instanceCount=s__ChakraJump_Alloc___instanceCount + 1
                set this=s__ChakraJump_Alloc___instanceCount
            else
                set this=s__ChakraJump_Alloc___recycle[(0)]
                set s__ChakraJump_Alloc___recycle[(0)]=s__ChakraJump_Alloc___recycle[s__ChakraJump_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ChakraJump_deallocate takes integer this returns nothing
            set s__ChakraJump_Alloc___recycle[this]=s__ChakraJump_Alloc___recycle[(0)]
            set s__ChakraJump_Alloc___recycle[(0)]=this
        endfunction

    function s__ChakraJump_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ChakraJump_dummy[this])
        local real y= GetUnitY(s__ChakraJump_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__ChakraJump_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__ChakraJump_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__ChakraJump_count[this]=s__ChakraJump_count[this] + 1
        call SetUnitX(s__ChakraJump_dummy[this], new_x)
        call SetUnitY(s__ChakraJump_dummy[this], new_y)
        if s__ChakraJump_count[this] >= s__ChakraJump_distance[this] then
	   call SetUnitX(s__ChakraJump_caster[this], GetUnitX(s__ChakraJump_dummy[this]))
	   call SetUnitY(s__ChakraJump_caster[this], GetUnitY(s__ChakraJump_dummy[this]))
	   call ShowUnit(s__ChakraJump_dummy[this], false)
	   call KillUnit(s__ChakraJump_dummy[this])
	   set s__ChakraJump_dummy[this]=null
           call SetUnitInvulnerable(s__ChakraJump_caster[this], false)
	   call ShowUnit(s__ChakraJump_caster[this], true)
    	   call SelectUnitForPlayerSingle(s__ChakraJump_caster[this], GetOwningPlayer(s__ChakraJump_caster[this]))
           call s__ChakraJump_deallocate(this)
           call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ChakraJump_cooldown takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if (UnitHasItemOfTypeBJ((s__ChakraJump_caster[this] ), ( 'I077'))) then // INLINED!!
            call BlzEndUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K')
            call BlzStartUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K', 100)
        elseif (UnitHasItemOfTypeBJ((s__ChakraJump_caster[this] ), ( 'I05F'))) then // INLINED!!
            call BlzEndUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K')
            call BlzStartUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K', 160)
        elseif (UnitHasItemOfTypeBJ((s__ChakraJump_caster[this] ), ( 'I00U'))) then // INLINED!!
            call BlzEndUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K')
            call BlzStartUnitAbilityCooldown(s__ChakraJump_caster[this], 'A06K', 180)
        endif
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__ChakraJump_jump takes nothing returns nothing
        local integer this= s__ChakraJump_allocate()
        local integer this2
        local real angle
        local real angle1
        local real distance
        local real distance1
        local real x
        local real y
        local real x1
        local real y1
        local integer i
        local integer k
        local real x2
        local real y2
        local real x3
        local real y3
        local real x4
        local real y4
        local real offset
       	call UnitRemoveAbility(GetTriggerUnit(), 'B05H')

            if GetUnitTypeId(GetTriggerUnit()) == 'E034' then
                call SetUnitAnimationByIndex(GetTriggerUnit(), 2)
            endif
            if (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I077'))) then // INLINED!!
                set this2=s__ChakraJump_allocate()
                set s__ChakraJump_caster[this2]=GetTriggerUnit()
                call TimerStart(NewTimerEx(this2), 0.01, false, function s__ChakraJump_cooldown)
            elseif (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I05F'))) then // INLINED!!
                set this2=s__ChakraJump_allocate()
                set s__ChakraJump_caster[this]=GetTriggerUnit()
                call TimerStart(NewTimerEx(this), 0.01, false, function s__ChakraJump_cooldown)
            elseif (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I00U'))) then // INLINED!!
                set this2=s__ChakraJump_allocate()
                set s__ChakraJump_caster[this]=GetTriggerUnit()
                call TimerStart(NewTimerEx(this), 0.01, false, function s__ChakraJump_cooldown)
            endif
            if GetUnitTypeId(GetTriggerUnit()) == 'H01Y' then
                set s__ChakraJump_caster[this]=GetTriggerUnit()
                set s__ChakraJump_angle[this]=Atan3(GetUnitX(s__ChakraJump_caster[this]) , GetUnitY(s__ChakraJump_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
                set s__ChakraJump_dummy[this]=CreateUnit(GetOwningPlayer(s__ChakraJump_caster[this]), 'hwat', GetUnitX(s__ChakraJump_caster[this]), GetUnitY(s__ChakraJump_caster[this]), GetUnitFacing(s__ChakraJump_caster[this]))
                set distance1=GetDistance(GetUnitX(s__ChakraJump_dummy[this]) , GetUnitY(s__ChakraJump_dummy[this]) , GetSpellTargetX() , GetSpellTargetY()) + 200
                set x1=(((GetUnitX(s__ChakraJump_dummy[this]) )*1.0) + Cos((( s__ChakraJump_angle[this] )*1.0)) * (( distance1)*1.0)) // INLINED!!
                set y1=(((GetUnitY(s__ChakraJump_dummy[this]) )*1.0) + Sin((( s__ChakraJump_angle[this] )*1.0)) * (( distance1)*1.0)) // INLINED!!
                if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
                    set s__ChakraJump_distance[this]=R2I(GetDistance(GetUnitX(s__ChakraJump_dummy[this]) , GetUnitY(s__ChakraJump_dummy[this]) , GetSpellTargetX() , GetSpellTargetY()) / 30)
                    call SetUnitAnimationByIndex(s__ChakraJump_dummy[this], 17)
                    call SetUnitTimeScale(s__ChakraJump_dummy[this], 5.0 - s__ChakraJump_distance[this] / 5)
                    call ShowUnit(s__ChakraJump_caster[this], false)
                    call SetUnitInvulnerable(s__ChakraJump_caster[this], true)
                    set s__ChakraJump_count[this]=0
                    call TimerStart(NewTimerEx(this), 0.03, true, function s__ChakraJump_periodic)
                elseif not IsTerrainPathable(x1, y1, PATHING_TYPE_WALKABILITY) then
                    set s__ChakraJump_distance[this]=R2I(GetDistance(GetUnitX(s__ChakraJump_dummy[this]) , GetUnitY(s__ChakraJump_dummy[this]) , x1 , y1) / 30)
                    call SetUnitAnimationByIndex(s__ChakraJump_dummy[this], 17)
                    call SetUnitTimeScale(s__ChakraJump_dummy[this], 5.0 - s__ChakraJump_distance[this] / 5)
                    call ShowUnit(s__ChakraJump_caster[this], false)
                    call SetUnitInvulnerable(s__ChakraJump_caster[this], true)
                    set s__ChakraJump_count[this]=0
                    call TimerStart(NewTimerEx(this), 0.03, true, function s__ChakraJump_periodic)
                else
                    call ShowUnit(s__ChakraJump_dummy[this], false)
                    call KillUnit(s__ChakraJump_dummy[this])
                    set s__ChakraJump_dummy[this]=null
                endif
            else
                if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
                    // minato special effect 
                    if GetUnitTypeId(GetTriggerUnit()) == 'H086' or GetUnitTypeId(GetTriggerUnit()) == 'H082' or GetUnitTypeId(GetTriggerUnit()) == 'H072' then
                        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    // itachi special effect
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'N001' or GetUnitTypeId(GetTriggerUnit()) == 'N025' then
                        call DestroyEffect(AddSpecialEffect(("ItachiE.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    // ichigo special effect
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'U00A' or GetUnitTypeId(GetTriggerUnit()) == 'U00G' or GetUnitTypeId(GetTriggerUnit()) == 'H0A7' then
                        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Kurenai/Ino
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'N01M' or GetUnitTypeId(GetTriggerUnit()) == 'N00J' then
                        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Pink_Wind.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                    //Darui/Ringo/Anbu Kakashi/Hebi Sasuke
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'E00F' or GetUnitTypeId(GetTriggerUnit()) == 'U00K' or GetUnitTypeId(GetTriggerUnit()) == 'H07A' or GetUnitTypeId(GetTriggerUnit()) == 'U00H' or GetUnitTypeId(GetTriggerUnit()) == 'U00I' then
                        set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Lightning_Cloud_Strike_2.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
                        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.45)
                        call DestroyEffect(bj_lastCreatedEffect)
                    //Haku
                    elseif GetUnitTypeId(GetTriggerUnit()) == 'H071' then
