        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KakashiLightningClone_kakashi), GetUnitY(s__KakashiLightningClone_kakashi), 500, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
