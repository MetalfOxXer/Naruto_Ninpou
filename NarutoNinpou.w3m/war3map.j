    function s__DeidaraFlyLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A0E8') == 0 and GetUnitTypeId(u) != 'H01H' and GetUnitAbilityLevel(u, 'A0NM') == 10 and GetUnitAbilityLevel(u, 'A02G') == 10 and GetUnitAbilityLevel(u, 'A0JD') == 10 and GetUnitAbilityLevel(u, 'A020') == 1 then
                call UnitRemoveAbility(u, 'A0E3')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0E3', false)
                call UnitAddAbility(u, 'A0E8')
        	call SetUnitFlyHeight(u, 300, 600)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__DeidaraFlyLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H00D' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__DeidaraFlyLevel_periodic) // INLINED!!
        endif
    endfunction 


    function s__DeidaraFlyLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'H01H' or GetUnitTypeId(GetTriggerUnit()) == 'H00D' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0E3', true)
        endif
    endfunction

    function s__DeidaraFlyLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__DeidaraFlyLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__DeidaraFlyLevel_death))) // INLINED!!
    endfunction 

