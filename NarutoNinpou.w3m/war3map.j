                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HashiramaGate___Spell_caster[this]), 'e02G', s__HashiramaGate___Spell_target_x[this], s__HashiramaGate___Spell_target_y[this], GetRandomReal(0, 360))
