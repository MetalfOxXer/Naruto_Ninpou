	call SetUnitPositionLocFacingLocBJ(GetEnumUnit(), PolarProjectionBJ(GetUnitLoc(udg_units26[101]), 70.00, AngleBetweenPoints(GetUnitLoc(udg_units26[101]), GetUnitLoc(GetTriggerUnit()))), GetUnitLoc(udg_units26[101]))
