//===========================================================================
// Trigger: HanabiW
//===========================================================================


        
        function s__HanabiW_actions takes nothing returns nothing
            local group damaged= CreateGroup()
            local real caster_x= GetUnitX(GetTriggerUnit())
            local real caster_y= GetUnitY(GetTriggerUnit())
            local real target_x= GetSpellTargetX()
            local real target_y= GetSpellTargetY()
            local real angle= Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            local real new_x= caster_x + Cos(angle) * 100
            local real new_y= caster_y + Sin(angle) * 100
            local integer i= 0
            local real new_x_2
            local real new_y_2
            call SetUnitAnimation(GetTriggerUnit(), "attack slam")
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h00W', new_x, new_y, Rad2Deg(angle))
            call SetUnitX(bj_lastCreatedUnit, new_x)
            call SetUnitY(bj_lastCreatedUnit, new_y)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
            loop
                set i=i + 1
                exitwhen i > 6
                set new_x_2=new_x + Cos(angle) * ( 100 * i )
                set new_y_2=new_y + Sin(angle) * ( 100 * i )
                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x_2 )*1.0), (( new_y_2)*1.0))) // INLINED!!
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x_2, new_y_2, 200.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                            call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 95 * GetUnitAbilityLevel(GetTriggerUnit(), s__HanabiW_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			    call GroupAddUnit(damaged, bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
            endloop
            call DestroyGroup(damaged)
            set damaged=null
        endfunction
        
        function s__HanabiW_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(68 , s__HanabiW_SPELL_ID , function s__HanabiW_actions)
        endfunction
        
