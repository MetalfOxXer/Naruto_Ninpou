    function s__IrukaTrap_dealDamage takes nothing returns boolean
				if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__IrukaTrap_caster[s__IrukaTrap_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
					call UnitDamageTarget(s__IrukaTrap_caster[s__IrukaTrap_instance], GetFilterUnit(), ( 35 + GetHeroAgi(s__IrukaTrap_caster[s__IrukaTrap_instance], true) / 2 ) * GetUnitAbilityLevel(s__IrukaTrap_caster[s__IrukaTrap_instance], s__IrukaTrap_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
