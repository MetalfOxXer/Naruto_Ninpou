    function s__KakashiKamuiShuriken___Spell_multiplier takes unit u returns real
        local integer i= 0
 local real multiplier= 0.00
        loop
            exitwhen i >= 128
            if s__KakashiKamuiShuriken_HitTarg[i] == u then
		set multiplier=1.0 + 0.1 * s__KakashiKamuiShuriken_HitMulti[i]
                set s__KakashiKamuiShuriken_HitMulti[i]= s__KakashiKamuiShuriken_HitMulti[i] + 1.0
                return multiplier
            elseif s__KakashiKamuiShuriken_HitTarg[i] == null then
                set s__KakashiKamuiShuriken_HitTarg[i]= u
                set s__KakashiKamuiShuriken_HitMulti[i]= 1.0
                return 1.0
            endif
            set i=i + 1
        endloop
        return 1.0
    endfunction

    function s__KakashiKamuiShuriken___Spell_show takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__KakashiKamuiShuriken___Spell_damaged[this])
            exitwhen bj_lastCreatedUnit == null
            call ShowUnit(bj_lastCreatedUnit, true)
            if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
            endif
            call PauseUnit(bj_lastCreatedUnit, false)
            if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) then
                call UnitDamageTarget(s__KakashiKamuiShuriken___Spell_caster[this], bj_lastCreatedUnit, ( 4.0 * GetHeroAgi(s__KakashiKamuiShuriken___Spell_caster[this], true) ) * s__KakashiKamuiShuriken___Spell_multiplier(bj_lastCreatedUnit), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            else
                call UnitDamageTarget(s__KakashiKamuiShuriken___Spell_caster[this], bj_lastCreatedUnit, 4.0 * GetHeroAgi(s__KakashiKamuiShuriken___Spell_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
            call GroupRemoveUnit(s__KakashiKamuiShuriken___Spell_damaged[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__KakashiKamuiShuriken___Spell_damaged[this])
        set s__KakashiKamuiShuriken___Spell_damaged[this]=null
        call UnitRemoveAbility(s__KakashiKamuiShuriken___Spell_caster[this], s__KakashiKamuiShuriken___Spell_RELEASE_SPELL_ID)
        if kakashi_susanoo_active then
            call UnitAddAbility(s__KakashiKamuiShuriken___Spell_caster[this], s__KakashiKamuiShuriken___Spell_SPELL_ID)
        endif
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakashiKamuiShuriken___Spell_caster[this]), 'u008', s__KakashiKamuiShuriken___Spell_target_x[this], s__KakashiKamuiShuriken___Spell_target_y[this], 0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        call s__KakashiKamuiShuriken___Spell_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__KakashiKamuiShuriken___Spell_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real arrow_x= GetUnitX(s__KakashiKamuiShuriken___Spell_arrow[this])
        local real arrow_y= GetUnitY(s__KakashiKamuiShuriken___Spell_arrow[this])
        local real new_x= (((arrow_x )*1.0) + Cos((( s__KakashiKamuiShuriken___Spell_angle[this] )*1.0)) * (( 35.0)*1.0)) // INLINED!!
        local real new_y= (((arrow_y )*1.0) + Sin((( s__KakashiKamuiShuriken___Spell_angle[this] )*1.0)) * (( 35.0)*1.0)) // INLINED!!
        local integer i
        local unit u

        set s__KakashiKamuiShuriken___Spell_count[this]=s__KakashiKamuiShuriken___Spell_count[this] + 1
        call SetUnitX(s__KakashiKamuiShuriken___Spell_arrow[this], new_x)
        call SetUnitY(s__KakashiKamuiShuriken___Spell_arrow[this], new_y)

        if s__KakashiKamuiShuriken___Spell_count[this] > 160 or GetWidgetLife(s__KakashiKamuiShuriken___Spell_arrow[this]) < 0.405 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakashiKamuiShuriken___Spell_caster[this]), 'h029', new_x, new_y, 0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
            set s__KakashiKamuiShuriken___Spell_target_x[this]=new_x
            set s__KakashiKamuiShuriken___Spell_target_y[this]=new_y
            set s__KakashiKamuiShuriken___Spell_damaged[this]=CreateGroup()
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiKamuiShuriken___Spell_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call ShowUnit(bj_lastCreatedUnit, false)
                    call GroupAddUnit(s__KakashiKamuiShuriken___Spell_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)

            set i=0
            loop
                exitwhen i >= 128
                set u=s__KakashiKamuiShuriken_HitTarg[i]
                if u != null and not IsUnitInGroup(u, s__KakashiKamuiShuriken___Spell_damaged[this]) then
                    set s__KakashiKamuiShuriken_HitTarg[i]= null
                    set s__KakashiKamuiShuriken_HitMulti[i]= 0.0
                endif
                set i=i + 1
            endloop

            call KillUnit(s__KakashiKamuiShuriken___Spell_arrow[this])
            set s__KakashiKamuiShuriken___Spell_arrow[this]=null
            call TimerStart(NewTimerEx(this), 2.0, false, function s__KakashiKamuiShuriken___Spell_show)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__KakashiKamuiShuriken___Spell_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitTimeScale(kakashi_susanoo, 1.0)
        set s__KakashiKamuiShuriken___Spell_arrow[this]=CreateUnit(GetOwningPlayer(s__KakashiKamuiShuriken___Spell_caster[this]), 'h09X', GetUnitX(s__KakashiKamuiShuriken___Spell_caster[this]), GetUnitY(s__KakashiKamuiShuriken___Spell_caster[this]), Rad2Deg(s__KakashiKamuiShuriken___Spell_angle[this]))
        call SetUnitFlyHeight(s__KakashiKamuiShuriken___Spell_arrow[this], 100, 400)
        set s__KakashiKamuiShuriken___Spell_shuriken=s__KakashiKamuiShuriken___Spell_arrow[this]
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__KakashiKamuiShuriken___Spell_move , "KakashiKamuiShuriken_move")
        set udg_SusanooKamui=false
        call UnitAddAbility(s__KakashiKamuiShuriken___Spell_caster[this], s__KakashiKamuiShuriken___Spell_RELEASE_SPELL_ID)
        call UnitRemoveAbility(s__KakashiKamuiShuriken___Spell_caster[this], s__KakashiKamuiShuriken___Spell_SPELL_ID)
