 function s__OhnokiNewUltimate_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i= 0
  local real x
  local real y
		set s__OhnokiNewUltimate_count[this]=s__OhnokiNewUltimate_count[this] + 1
		call SetUnitFacing(s__OhnokiNewUltimate_caster[this], GetUnitFacing(s__OhnokiNewUltimate_caster[this]) + 11)
		call SetUnitFacing(s__OhnokiNewUltimate_laser[this], GetUnitFacing(s__OhnokiNewUltimate_caster[this]) - 30)
		loop
			set i=i + 1
			exitwhen i > 8
			set x=(((GetUnitX(s__OhnokiNewUltimate_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__OhnokiNewUltimate_caster[this]) - 30) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
			set y=(((GetUnitY(s__OhnokiNewUltimate_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__OhnokiNewUltimate_caster[this]) - 30) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
			if ModuloInteger(s__OhnokiNewUltimate_count[this], 2) == 1 then
				call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
				call DestroyEffect(AddSpecialEffect(("Effects\\s_War_Stomp.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
			endif
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 110, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__OhnokiNewUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__OhnokiNewUltimate_damaged[this]) then
					call UnitDamageTarget(s__OhnokiNewUltimate_caster[this], bj_lastCreatedUnit, 10 * GetHeroInt(s__OhnokiNewUltimate_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					call GroupAddUnit(s__OhnokiNewUltimate_damaged[this], bj_lastCreatedUnit)
				endif
			endloop
		endloop
		if s__OhnokiNewUltimate_count[this] > 33 then
			call PauseUnit(s__OhnokiNewUltimate_caster[this], false)
			call DestroyGroup(s__OhnokiNewUltimate_damaged[this])
			call KillUnit(s__OhnokiNewUltimate_laser[this])
			set s__OhnokiNewUltimate_damaged[this]=null
			set s__OhnokiNewUltimate_laser[this]=null
			call s__OhnokiNewUltimate_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__OhnokiNewUltimate_actions takes nothing returns nothing
  local integer this= s__OhnokiNewUltimate_allocate()
		set s__OhnokiNewUltimate_caster[this]=GetTriggerUnit()
		set s__OhnokiNewUltimate_count[this]=0
		set s__OhnokiNewUltimate_damaged[this]=CreateGroup()
		call PauseUnit(s__OhnokiNewUltimate_caster[this], true)
        	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
			if BlzGetUnitSkin(s__OhnokiNewUltimate_caster[this]) == 'h05H' then
				call PlaySoundOnUnitBJ(gg_snd_TatsumakiT, 100, GetTriggerUnit())
			else
				call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Onoki: My duty is to protect the new generation!|r")
				call PlaySoundOnUnitBJ(gg_snd_Onooki_T, 100, GetTriggerUnit())
			endif
        	endif
		set s__OhnokiNewUltimate_laser[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h04P' ), (( GetUnitX(s__OhnokiNewUltimate_caster[this]) )*1.0), (( GetUnitY(s__OhnokiNewUltimate_caster[this]) )*1.0), (( GetUnitFacing(s__OhnokiNewUltimate_caster[this]) - 30)*1.0))) // INLINED!!
		if BlzGetUnitSkin(s__OhnokiNewUltimate_caster[this]) == 'h05H' then
			call SetUnitVertexColor(s__OhnokiNewUltimate_laser[this], 0, 255, 50, 255)
		endif
        	//call SetUnitScale(this.laser, 1, 1, )
        	call SetUnitFlyHeight(s__OhnokiNewUltimate_laser[this], 100 + GetUnitFlyHeight(GetTriggerUnit()), 0)
		call TimerStart(NewTimerEx(this), 0.03, true, function s__OhnokiNewUltimate_periodic)
 endfunction 

 function s__OhnokiNewUltimate_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(39 , s__OhnokiNewUltimate_SPELL_ID , function s__OhnokiNewUltimate_actions)
 endfunction

