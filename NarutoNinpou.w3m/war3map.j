    function s__PurifiedTotsuka_actions2 takes nothing returns nothing
        local real damage
        if not IsUnitIllusion(GetAttacker()) and UnitHasItemOfTypeBJ(GetAttacker(), 'I00S') and GetRandomInt(1, 10) <= 2 then
            set damage=300
            if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) and GetWidgetLife(GetTriggerUnit()) > 0.405 then
	            call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), damage, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		    call SetUnitState(GetAttacker(), UNIT_STATE_LIFE, GetUnitState(GetAttacker(), UNIT_STATE_LIFE) + 150)
		    call DestroyEffect(AddSpecialEffect(("war3mapImported\\Heal Green.mdx" ), (( GetUnitX(GetAttacker()) )*1.0), (( GetUnitY(GetAttacker()))*1.0))) // INLINED!!
	    endif
	endif
    endfunction 

