    function s__HidanTakeBlood_periodic2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HidanTakeBlood_caster[this])
        local real y= GetUnitY(s__HidanTakeBlood_caster[this])
        local real angle= Atan3(x , y , GetUnitX(s__HidanTakeBlood_target[this]) , GetUnitY(s__HidanTakeBlood_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 15)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 15)*1.0)) // INLINED!!
        local real distance= GetDistance(new_x , new_y , GetUnitX(s__HidanTakeBlood_target[this]) , GetUnitY(s__HidanTakeBlood_target[this]))
        call SetUnitX(s__HidanTakeBlood_caster[this], new_x)
        call SetUnitY(s__HidanTakeBlood_caster[this], new_y)
        call SetUnitFacing(s__HidanTakeBlood_caster[this], Rad2Deg(angle))
	set s__HidanTakeBlood_count[this]=s__HidanTakeBlood_count[this] + 1
        if distance <= 50 or s__HidanTakeBlood_count[this] >= 20 then
            call SetUnitVertexColor((s__HidanTakeBlood_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
            call PauseUnit(s__HidanTakeBlood_target[this], true)
            set s__HidanTakeBlood_count[this]=0
