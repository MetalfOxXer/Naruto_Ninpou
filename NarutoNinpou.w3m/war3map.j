            exitwhen i > 5
            set x=(((GetSpellTargetX() )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
            set y=(((GetSpellTargetY() )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\congbi.mdl", x, y)
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.8)
            call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.0)*1.0) , false) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            set i=i + 1
        endloop
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" ), (( s__ShinoStun_target_x[this] )*1.0), (( s__ShinoStun_target_y[this])*1.0))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        set s__ShinoStun_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ShinoStun_target_x[this], s__ShinoStun_target_y[this], 200.0, Filter(function s__ShinoStun_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
	set s__ShinoStun_caster[this]=null
    endfunction 

