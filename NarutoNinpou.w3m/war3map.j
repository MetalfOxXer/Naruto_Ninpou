                    set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(360 / 12 * j) )*1.0)) * (( 50 * ( i + 1 ))*1.0)) // INLINED!!
                    set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(360 / 12 * j) )*1.0)) * (( 50 * ( i + 1 ))*1.0)) // INLINED!!
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                    set j=j + 1
