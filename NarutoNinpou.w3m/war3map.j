 function s__MechaNarutoBomb_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__MechaNarutoBomb_caster[this])
  local real y= GetUnitY(s__MechaNarutoBomb_caster[this])
  local real new_x= (((x )*1.0) + Cos((( s__MechaNarutoBomb_angle[this] )*1.0)) * (( 20 + s__MechaNarutoBomb_count[this] / 2)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__MechaNarutoBomb_angle[this] )*1.0)) * (( 20 + s__MechaNarutoBomb_count[this] / 2)*1.0)) // INLINED!!
  local boolean found= false
		set s__MechaNarutoBomb_count[this]=s__MechaNarutoBomb_count[this] + 1
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MechaNarutoBomb_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
				set found=true
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			set found=true
		else
			call SetUnitX(s__MechaNarutoBomb_caster[this], new_x)
			call SetUnitY(s__MechaNarutoBomb_caster[this], new_y)
		endif
		if ModuloInteger(s__MechaNarutoBomb_count[this], 2) == 0 then
		    set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", GetUnitX(s__MechaNarutoBomb_caster[this]), GetUnitY(s__MechaNarutoBomb_caster[this]))
		    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
		    call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
		    call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, s__MechaNarutoBomb_angle[this])
		    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(s__MechaNarutoBomb_caster[this]) , GetUnitY(s__MechaNarutoBomb_caster[this])))
		    call DestroyEffect(bj_lastCreatedEffect)
		elseif ModuloInteger(s__MechaNarutoBomb_count[this], 3) == 0 then
			set x=(((x )*1.0) + Cos((( s__MechaNarutoBomb_angle[this] + bj_PI )*1.0)) * (( 120)*1.0)) // INLINED!!
			set y=(((y )*1.0) + Sin((( s__MechaNarutoBomb_angle[this] + bj_PI )*1.0)) * (( 120)*1.0)) // INLINED!!
			set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdx", x, y)
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__MechaNarutoBomb_angle[this])
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
			call DestroyEffect(bj_lastCreatedEffect)
		endif
		if ModuloInteger(s__MechaNarutoBomb_count[this], 10) == 0 then
			call SetUnitAnimationByIndex(s__MechaNarutoBomb_caster[this], 7)
		endif
		if found then
			set bj_lastCreatedEffect=AddSpecialEffect("InoQ.mdx", new_x, new_y)
			call DestroyEffect(bj_lastCreatedEffect)
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MechaNarutoBomb_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				if GetHeroLevel(s__MechaNarutoBomb_caster[this]) >= 35 then
					call UnitDamageTarget(s__MechaNarutoBomb_caster[this], bj_lastCreatedUnit, 450 * 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__MechaNarutoBomb_caster[this], bj_lastCreatedUnit, 450 * GetUnitAbilityLevel(s__MechaNarutoBomb_caster[this], 'A0I2'), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				endif
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			call SlowArea(s__MechaNarutoBomb_caster[this] , new_x , new_y , 300)
			call PauseUnit(s__MechaNarutoBomb_caster[this], false)
			call SetUnitAnimation(s__MechaNarutoBomb_caster[this], "stand")
			call s__MechaNarutoBomb_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

