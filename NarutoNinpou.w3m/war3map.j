 function s__YamatoSealing_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real mana= ( GetUnitState(s__YamatoSealing_target[this], UNIT_STATE_MAX_MANA) * 0.01 + 30 ) * GetUnitAbilityLevel(s__YamatoSealing_caster[this], s__YamatoSealing_SPELL_ID)
		call SetUnitState(s__YamatoSealing_caster[this], UNIT_STATE_MANA, GetUnitState(s__YamatoSealing_caster[this], UNIT_STATE_MANA) + mana)
		call SetUnitState(s__YamatoSealing_target[this], UNIT_STATE_MANA, GetUnitState(s__YamatoSealing_target[this], UNIT_STATE_MANA) - mana)
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl" ), (( GetUnitX(s__YamatoSealing_target[this]) )*1.0), (( GetUnitY(s__YamatoSealing_target[this]))*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl" ), (( GetUnitX(s__YamatoSealing_caster[this]) )*1.0), (( GetUnitY(s__YamatoSealing_caster[this]))*1.0))) // INLINED!!
		call UnitDamageTarget(s__YamatoSealing_caster[this], s__YamatoSealing_target[this], ( GetHeroInt(s__YamatoSealing_caster[this], true) ) * GetUnitAbilityLevel(s__YamatoSealing_caster[this], s__YamatoSealing_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
		set s__YamatoSealing_count[this]=s__YamatoSealing_count[this] + 1
		if s__YamatoSealing_count[this] >= 1 then
			loop
				set bj_lastCreatedUnit=FirstOfGroup(s__YamatoSealing_spikes[this])
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(s__YamatoSealing_spikes[this], bj_lastCreatedUnit)
				call s__Lightning_release(s__s__YamatoSealing_lights[(this)*(1)+(GetUnitUserData((bj_lastCreatedUnit)))],0.3) // INLINED!!
				call KillUnit(bj_lastCreatedUnit)
			endloop
			call DestroyGroup(s__YamatoSealing_spikes[this])
			set s__YamatoSealing_spikes[this]=null
			call s__YamatoSealing_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__YamatoSealing_actions takes nothing returns nothing
  local integer this= s__YamatoSealing_allocate()
  local real x
  local real y
  local integer i
		set s__YamatoSealing_caster[this]=GetTriggerUnit()
		set s__YamatoSealing_target[this]=GetSpellTargetUnit()
		set s__YamatoSealing_spikes[this]=CreateGroup()
		set i=0
		loop
			exitwhen i > 5
			set x=(((GetUnitX(s__YamatoSealing_target[this]) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 300)*1.0)) // INLINED!!
			set y=(((GetUnitY(s__YamatoSealing_target[this]) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 300)*1.0)) // INLINED!!
			set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'n02P', x, y, 60 * i + 180)
			call GroupAddUnit(s__YamatoSealing_spikes[this], bj_lastCreatedUnit)
                        set s__s__YamatoSealing_lights[(this)*(1)+(GetUnitUserData((bj_lastCreatedUnit)))]= s__Lightning_create("DRAL" , true , 0.3) // INLINED!!
			call s__Lightning_attachToUnit(s__s__YamatoSealing_lights[(this)*(1)+(GetUnitUserData((bj_lastCreatedUnit)))],true , bj_lastCreatedUnit , 100) // INLINED!!
			call s__Lightning_attachToUnit(s__s__YamatoSealing_lights[(this)*(1)+(GetUnitUserData((bj_lastCreatedUnit)))],false , s__YamatoSealing_target[this] , 60) // INLINED!!
                        set i=i + 1
		endloop
		call EsnareUnitTimed(s__YamatoSealing_caster[this] , s__YamatoSealing_target[this] , 1.5)
		set s__YamatoSealing_count[this]=0
		call TimerStart(NewTimerEx(this), 0.5, true, function s__YamatoSealing_periodic)
 endfunction 

 function s__YamatoSealing_onInit takes nothing returns nothing
