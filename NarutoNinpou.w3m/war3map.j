                call PlaySoundOnUnitBJ(gg_snd_Tayuya_T, 100, GetTriggerUnit())
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Tayuya: There's no one that's heard this song and lived|r")
