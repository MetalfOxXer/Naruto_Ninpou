    function s__MadaraMugenTsukuyomi_timer2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__MadaraMugenTsukuyomi_madara_cooldown2=s__MadaraMugenTsukuyomi_madara_cooldown2 - 1
        if s__MadaraMugenTsukuyomi_madara_cooldown2 <= 0 then
            call ReleaseTimer(GetExpiredTimer())
            call s__MadaraMugenTsukuyomi_deallocate(this)
        endif
    endfunction

    function s__MadaraMugenTsukuyomi_suckChakra takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        if GetWidgetLife(s__MadaraMugenTsukuyomi_tree[this]) < 0.405 then
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__MadaraMugenTsukuyomi_tree[this]) )*1.0), (( GetUnitY(s__MadaraMugenTsukuyomi_tree[this]))*1.0))) // INLINED!!
            call ShowUnit(s__MadaraMugenTsukuyomi_tree[this], false)
            set s__MadaraMugenTsukuyomi_tree[this]=null
            call s__MadaraMugenTsukuyomi_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        else
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__MadaraMugenTsukuyomi_tree[this]), GetUnitY(s__MadaraMugenTsukuyomi_tree[this]), 9999, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MadaraMugenTsukuyomi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) - GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MAX_MANA) * 0.02)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__MadaraMugenTsukuyomi_count[this]=s__MadaraMugenTsukuyomi_count[this] + 1
            if s__MadaraMugenTsukuyomi_count[this] == 10 then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Madara: Now! Become one!|r")
                call PlaySoundOnUnitBJ(gg_snd_Madara_T_Tsukuyomi, 100, GetTriggerUnit())
                	

                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__MadaraMugenTsukuyomi_tree[this]), GetUnitY(s__MadaraMugenTsukuyomi_tree[this]), 9999, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MadaraMugenTsukuyomi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                        if RectContainsUnit(gg_rct_DuelArena, bj_lastCreatedUnit) and not RectContainsUnit(gg_rct_DuelArena, s__MadaraMugenTsukuyomi_caster[this]) then
                        elseif RectContainsUnit(gg_rct_MissionB, bj_lastCreatedUnit) and ( s__MadaraMugenTsukuyomi_caster[this] != udg_MissionBUnit ) then
			            elseif RectContainsUnit(gg_rct_MissionA, bj_lastCreatedUnit) and ( s__MadaraMugenTsukuyomi_caster[this] != udg_MissionAUnit ) then
			            elseif RectContainsUnit(gg_rct_MissionS, bj_lastCreatedUnit) and ( s__MadaraMugenTsukuyomi_caster[this] != udg_MissionSUnit ) then
			            elseif RectContainsUnit(gg_rct_Dummy, bj_lastCreatedUnit) then
			            elseif RectContainsUnit(gg_rct_TestArena, bj_lastCreatedUnit) then
			            elseif RectContainsUnit(gg_rct_fonte, bj_lastCreatedUnit) then
                        else
                            call EsnareUnitTimed(s__MadaraMugenTsukuyomi_caster[this] , bj_lastCreatedUnit , 5.0)
                            call UnitDamageTarget(s__MadaraMugenTsukuyomi_caster[this], bj_lastCreatedUnit, 2000, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                            set u=CreateUnit(GetOwningPlayer(s__MadaraMugenTsukuyomi_caster[this]), 'h067', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), GetUnitFacing(bj_lastCreatedUnit))
                            call UnitApplyTimedLife(u, 'BTLF', 5.0)
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)

                call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__MadaraMugenTsukuyomi_tree[this]) )*1.0), (( GetUnitY(s__MadaraMugenTsukuyomi_tree[this]))*1.0))) // INLINED!!
                call ShowUnit(s__MadaraMugenTsukuyomi_tree[this], false)
                set s__MadaraMugenTsukuyomi_tree[this]=null
                call s__MadaraMugenTsukuyomi_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__MadaraMugenTsukuyomi_comeUp takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__MadaraMugenTsukuyomi_count[this]=s__MadaraMugenTsukuyomi_count[this] + 1
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__MadaraMugenTsukuyomi_tree[this]) )*1.0), (( GetUnitY(s__MadaraMugenTsukuyomi_tree[this]))*1.0))) // INLINED!!
        if s__MadaraMugenTsukuyomi_count[this] == 33 then
	        call SetUnitAnimation(s__MadaraMugenTsukuyomi_tree[this], "stand")
            call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUTIN, 2.00, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 100.00, 0, 0, 50.00)
            set s__MadaraMugenTsukuyomi_count[this]=0
            call TimerStart(NewTimerEx(this), 1.0, true, function s__MadaraMugenTsukuyomi_suckChakra)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 


    function s__MadaraMugenTsukuyomi_actions takes nothing returns nothing
        local integer this= s__MadaraMugenTsukuyomi_allocate()
        local integer this2
        set s__MadaraMugenTsukuyomi_caster[this]=GetTriggerUnit()
	if RectContainsUnit(gg_rct_DuelArena, s__MadaraMugenTsukuyomi_caster[this]) then
        	set s__MadaraMugenTsukuyomi_tree[this]=CreateUnit(GetTriggerPlayer(), 'e07E', - 3264, - 8370, 270)
	else
        	set s__MadaraMugenTsukuyomi_tree[this]=CreateUnit(GetTriggerPlayer(), 'e07E', 3070, - 767, 270)
	endif
