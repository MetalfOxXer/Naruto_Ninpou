//===========================================================================
// Trigger: ChakraDisruptionRecipe
//===========================================================================

function Trig_ChakraDisruptionRecipe_Actions takes nothing returns nothing
    if GetItemTypeId(GetManipulatedItem()) == 'I08F' then
         if (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I01X'))) and (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I05V'))) then // INLINED!!
             call RemoveItem(GetItemOfTypeFromUnitBJ((GetTriggerUnit() ), ( 'I01X'))) // INLINED!!
             call RemoveItem(GetItemOfTypeFromUnitBJ((GetTriggerUnit() ), ( 'I05V'))) // INLINED!!
             call UnitAddItemEx(GetTriggerUnit() , 'I08E')
         else
             call AdjustPlayerStateBJ(9000, GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)
         endif
    endif
 endfunction
 
 //===========================================================================
 function InitTrig_ChakraDisruptionRecipe takes nothing returns nothing
     call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_PICKUP_ITEM ) , Filter(( function Trig_ChakraDisruptionRecipe_Actions))) // INLINED!!
 endfunction
 
 
//===========================================================================
