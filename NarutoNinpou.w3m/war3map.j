                endif
                set s__HagoromoD_ReleaseEarth=false
                set s__HagoromoD_ReleaseWater=false
                set s__HagoromoD_ReleaseFire=false
                set s__HagoromoD_ReleaseWind=false
                set s__HagoromoD_ReleaseLightning=false
                set s__HagoromoD_HagoromoCasting=false
                set s__HagoromoD_combineRelease=false
                set s__HagoromoD_HagoromoSpellTwo=0
                set s__HagoromoD_HagoromoSpellOne=0
                set s__HagoromoD_HagoromoSpellCurrent=0
                if HagoromoChargesD_release != null then
                    call DestroyEffect(HagoromoChargesD_release)
		            set HagoromoChargesD_release=null
