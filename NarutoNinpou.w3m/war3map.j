    function s__JiroboGolem_attack takes nothing returns nothing
        if GetUnitTypeId(GetAttacker()) == 'h05G' then
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 220, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(GetAttacker())) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, GetHeroStr(udg_Jirobo, true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) - GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MAX_MANA) * 0.01)
                    call AddSpecialEffect("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        elseif ( GetUnitTypeId(GetAttacker()) == 'H05E' or GetUnitTypeId(GetAttacker()) == 'H05F' ) and IsUnitEnemy(GetAttacker(), GetTriggerPlayer()) and IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true then
            if GetTriggerUnit() == s__JiroboGolem_last_target then
                call ModifyHeroStat(bj_HEROSTAT_STR, GetAttacker(), bj_MODIFYMETHOD_ADD, 2)
                set s__JiroboGolem_timer=10
                set s__JiroboGolem_bonus=s__JiroboGolem_bonus + 2
            else
                set s__JiroboGolem_last_target=GetTriggerUnit()
                call ModifyHeroStat(bj_HEROSTAT_STR, GetAttacker(), bj_MODIFYMETHOD_SUB, s__JiroboGolem_bonus)
                call ModifyHeroStat(bj_HEROSTAT_STR, GetAttacker(), bj_MODIFYMETHOD_ADD, 2)
                set s__JiroboGolem_timer=10
                set s__JiroboGolem_bonus=2
            endif
            set bj_lastCreatedEffect=AddSpecialEffect("PunchImpact.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(GetAttacker()) + 180))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.3)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
            call DestroyEffect(bj_lastCreatedEffect)
        endif
    endfunction 

    function s__JiroboGolem_decreaseTimer takes nothing returns nothing
        if s__JiroboGolem_timer > 0 then
            set s__JiroboGolem_timer=s__JiroboGolem_timer - 1
            if s__JiroboGolem_timer == 0 then
                call ModifyHeroStat(bj_HEROSTAT_STR, udg_Jirobo, bj_MODIFYMETHOD_SUB, s__JiroboGolem_bonus)
                set s__JiroboGolem_bonus=0
                set s__JiroboGolem_last_target=null
            endif
        endif
    endfunction 

    function s__JiroboGolem_onInit takes nothing returns nothing
        set s__JiroboGolem_timer=0
        set s__JiroboGolem_bonus=0
        set s__JiroboGolem_last_target=null
        call RegisterPlayerUnitEventForId(89 , EVENT_PLAYER_UNIT_ATTACKED , function s__JiroboGolem_attack)
        call TimerStart((NewTimerEx(0)), 1.0, true, function s__JiroboGolem_decreaseTimer) // INLINED!!
    endfunction 

