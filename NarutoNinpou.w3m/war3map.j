    function s__FuuNet_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local unit u
        set s__FuuNet_count[this]=s__FuuNet_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
	call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__FuuNet_target_x[this], s__FuuNet_target_y[this], 300, null)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		exitwhen bj_lastCreatedUnit == null
		if not IsUnitInGroup(bj_lastCreatedUnit, s__FuuNet_damaged[this]) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__FuuNet_caster[this])) then
			call GroupAddUnit(s__FuuNet_damaged[this], bj_lastCreatedUnit)
			call UnitDamageTarget(s__FuuNet_caster[this], bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(s__FuuNet_caster[this], s__FuuNet_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                	set u=CreateAbilityDummy(s__FuuNet_caster[this] , 'A01L')
                	call IssueTargetOrder(u, "web", bj_lastCreatedUnit)
			set u=null
		endif
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
        if s__FuuNet_count[this] >= 66 then
            loop
            set bj_lastCreatedUnit=FirstOfGroup(s__FuuNet_effects[this])
                exitwhen bj_lastCreatedUnit == null
	            call ShowUnit(bj_lastCreatedUnit, false)
                call KillUnit(bj_lastCreatedUnit)
                call GroupRemoveUnit(s__FuuNet_effects[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__FuuNet_effects[this])
	        set s__FuuNet_effects[this]=null
            call DestroyGroup(s__FuuNet_damaged[this])
            set s__FuuNet_damaged[this]=null
            call s__FuuNet_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    

    function s__FuuNet_periodic2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__FuuNet_missile[this])
        local real y= GetUnitY(s__FuuNet_missile[this])
        local real new_x= (((x )*1.0) + Cos((( s__FuuNet_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__FuuNet_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local integer i= 0
        call SetUnitX(s__FuuNet_missile[this], new_x)
        call SetUnitY(s__FuuNet_missile[this], new_y)
        call SetUnitFacing(s__FuuNet_missile[this], Rad2Deg(s__FuuNet_angle[this]))
	call SetUnitFlyHeight(s__FuuNet_missile[this], ParabolaZ(600 , s__FuuNet_distance[this] , s__FuuNet_distance[this] - GetDistance(new_x , new_y , s__FuuNet_caster_x[this] , s__FuuNet_caster_y[this])), 0)
        if GetDistance(x , y , s__FuuNet_target_x[this] , s__FuuNet_target_y[this]) <= 100 then
            call ShowUnit(s__FuuNet_missile[this], false)
            call KillUnit(s__FuuNet_missile[this])
            set s__FuuNet_missile[this]=null
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__FuuNet_caster[this]), 'h0AI', s__FuuNet_target_x[this], s__FuuNet_target_y[this], 270)
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
            call GroupAddUnit(s__FuuNet_effects[this], bj_lastCreatedUnit)
            loop
            exitwhen i > 12
                set x=(((s__FuuNet_target_x[this] )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set y=(((s__FuuNet_target_y[this] )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 150)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__FuuNet_caster[this]), 'h00P', x, y, 270.0)
                call SetUnitScale(bj_lastCreatedUnit, 1.0, 1.0, 1.0)
                call GroupAddUnit(s__FuuNet_effects[this], bj_lastCreatedUnit)
                set i=i + 1
            endloop
            call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__FuuNet_periodic , "FuuNet_periodic")
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction


    function s__FuuNet_actions takes nothing returns nothing
        local integer this= s__FuuNet_allocate()
        local integer i= 0
     local real x
     local real y
        set s__FuuNet_caster[this]=GetTriggerUnit()
        set s__FuuNet_target_x[this]=GetSpellTargetX()
        set s__FuuNet_target_y[this]=GetSpellTargetY()
        set s__FuuNet_caster_x[this]=GetUnitX(s__FuuNet_caster[this])
        set s__FuuNet_caster_y[this]=GetUnitY(s__FuuNet_caster[this])
        set s__FuuNet_distance[this]=GetDistance(GetUnitX(s__FuuNet_caster[this]) , GetUnitY(s__FuuNet_caster[this]) , s__FuuNet_target_x[this] , s__FuuNet_target_y[this])
        set s__FuuNet_count[this]=0
        set s__FuuNet_angle[this]=Atan3(GetUnitX(s__FuuNet_caster[this]) , GetUnitY(s__FuuNet_caster[this]) , s__FuuNet_target_x[this] , s__FuuNet_target_y[this])
        set s__FuuNet_damaged[this]=CreateGroup()
        set s__FuuNet_effects[this]=CreateGroup()
        set s__FuuNet_missile[this]=CreateUnit(GetOwningPlayer(s__FuuNet_caster[this]), 'h0AJ', GetUnitX(s__FuuNet_caster[this]), GetUnitY(s__FuuNet_caster[this]), s__FuuNet_angle[this])
	call SetUnitAnimation(s__FuuNet_missile[this], "birth")
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__FuuNet_periodic2 , "FuuNet_periodic2")
    endfunction 
   
