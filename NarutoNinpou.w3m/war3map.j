                set bj_lastCreatedGroup=CreateGroup()
		set s__ObitoMokuton_instance=this
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ObitoMokuton_target_x[this], s__ObitoMokuton_target_y[this], 300, Filter(function s__ObitoMokuton_dealDamage))
