    function s__GaaraAirBullet_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= (((GetUnitX(s__GaaraAirBullet_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__GaaraAirBullet_caster[this])) )*1.0)) * (( 700)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__GaaraAirBullet_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__GaaraAirBullet_caster[this])) )*1.0)) * (( 700)*1.0)) // INLINED!!
        local real angle
        local integer i= 0
        call SetUnitX(s__GaaraAirBullet_dummy[this], GetUnitX(s__GaaraAirBullet_caster[this]))
        call SetUnitY(s__GaaraAirBullet_dummy[this], GetUnitY(s__GaaraAirBullet_caster[this]))
        call SetUnitFacing(s__GaaraAirBullet_dummy[this], GetUnitFacing(s__GaaraAirBullet_caster[this]))
        call SetUnitX(s__GaaraAirBullet_wave[this], x)
        call SetUnitY(s__GaaraAirBullet_wave[this], y)
        call SetUnitFacing(s__GaaraAirBullet_wave[this], GetUnitFacing(s__GaaraAirBullet_dummy[this]))
        call SetUnitVertexColor(s__GaaraAirBullet_caster[this], 255, 255, 255, 0)
        call SetUnitFlyHeight(s__GaaraAirBullet_wave[this], 300 + 2 * s__GaaraAirBullet_count[this], 0)
        loop
            set i=i + 1
            exitwhen i > 7
            set x=(((GetUnitX(s__GaaraAirBullet_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__GaaraAirBullet_dummy[this])) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__GaaraAirBullet_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__GaaraAirBullet_dummy[this])) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
        endloop
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 400, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__GaaraAirBullet_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__GaaraAirBullet_caster[this], bj_lastCreatedUnit, ( 10 * GetHeroAgi(s__GaaraAirBullet_caster[this], true) ) / 99, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    set angle=Atan3(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , GetUnitX(s__GaaraAirBullet_caster[this]) , GetUnitY(s__GaaraAirBullet_caster[this]))
                    set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( angle )*1.0)) * (( 15)*1.0)) // INLINED!!
                    set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( angle )*1.0)) * (( 15)*1.0)) // INLINED!!
                    if ModuloInteger(s__GaaraAirBullet_count[this], 2) == 0 then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    endif
                    if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) and GetDistanceUnits(s__GaaraAirBullet_caster[this] , bj_lastCreatedUnit) > 200 then
                        call SetUnitX(bj_lastCreatedUnit, x)
                        call SetUnitY(bj_lastCreatedUnit, y)
                    endif
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        set s__GaaraAirBullet_count[this]=s__GaaraAirBullet_count[this] + 1
        if s__GaaraAirBullet_count[this] == 33 * 3 then
            call KillUnit(s__GaaraAirBullet_dummy[this])
            call ShowUnit(s__GaaraAirBullet_dummy[this], false)
            call SetUnitVertexColor(s__GaaraAirBullet_caster[this], 255, 255, 255, 255)
            call KillUnit(s__GaaraAirBullet_wave[this])
            set s__GaaraAirBullet_dummy2=null
            call s__GaaraAirBullet_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__GaaraAirBullet_actions takes nothing returns nothing
        local integer this= s__GaaraAirBullet_allocate()
        local real x= (((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(GetTriggerUnit())) )*1.0)) * (( 700)*1.0)) // INLINED!!
        local real y= (((GetUnitX(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(GetTriggerUnit())) )*1.0)) * (( 700)*1.0)) // INLINED!!
        set s__GaaraAirBullet_caster[this]=GetTriggerUnit()
        set s__GaaraAirBullet_wave[this]=CreateUnit(GetTriggerPlayer(), 'e08I', x, y, GetUnitFacing(s__GaaraAirBullet_caster[this]))
        call UnitAddAbility(s__GaaraAirBullet_wave[this], 'Arav')
        call SetUnitFlyHeight(s__GaaraAirBullet_wave[this], 300, 0)
        call SetUnitPathing(s__GaaraAirBullet_wave[this], false)
        set s__GaaraAirBullet_count[this]=0
        set s__GaaraAirBullet_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e08J', GetUnitX(s__GaaraAirBullet_caster[this]), GetUnitY(s__GaaraAirBullet_caster[this]), GetUnitFacing(s__GaaraAirBullet_caster[this]))
        set s__GaaraAirBullet_dummy2=s__GaaraAirBullet_dummy[this]
        call SetUnitPathing(s__GaaraAirBullet_dummy[this], false)
        call SetUnitAnimation(s__GaaraAirBullet_dummy[this], "spell")
        call SetUnitTimeScale(s__GaaraAirBullet_dummy[this], 0.5)
        call SetUnitVertexColor(s__GaaraAirBullet_caster[this], 255, 255, 255, 0)
        set bj_lastCreatedEffect=AddSpecialEffect("DustWaveGeneric.mdl", GetUnitX(s__GaaraAirBullet_caster[this]), GetUnitY(s__GaaraAirBullet_caster[this]))
        call DestroyEffect(bj_lastCreatedEffect)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__GaaraAirBullet_periodic)
    endfunction 

