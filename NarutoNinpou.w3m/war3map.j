	set udg_units18[91]=bj_lastCreatedUnit
	call SetUnitAnimation(bj_lastCreatedUnit, "attack")
call AddSpecialEffectTargetUnitBJ(("head" ), ( bj_lastCreatedUnit ), ( "Abilities\\Spells\\Undead\\Cripple\\CrippleTarget.mdl")) // INLINED!!
call AddSpecialEffectTargetUnitBJ(("head" ), ( bj_lastCreatedUnit ), ( "Abilities\\Spells\\Other\\Tornado\\Tornado_Target.mdl")) // INLINED!!
	call RemoveLocation(udg_locations03[55])
