        call s__SaiNewE_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SaiNewE_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SaiNewE_caster[this])
        local real y= GetUnitY(s__SaiNewE_caster[this])
        local real angle= Atan3(x , y , s__SaiNewE_target_x[this] , s__SaiNewE_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real distance= GetDistance(new_x , new_y , s__SaiNewE_target_x[this] , s__SaiNewE_target_y[this])
        call SetUnitX(s__SaiNewE_caster[this], new_x)
        call SetUnitY(s__SaiNewE_caster[this], new_y)
        call SetUnitFacing(s__SaiNewE_caster[this], Rad2Deg(angle))
        set s__SaiNewE_count[this]=s__SaiNewE_count[this] + 1
        if distance <= 50 or s__SaiNewE_count[this] >= 37 then
            call PauseUnit(s__SaiNewE_caster[this], false)
            call SetUnitTimeScale(s__SaiNewE_caster[this], 4.0)
            call SetUnitAnimation(s__SaiNewE_caster[this], "morph alternate")
	        if GetHeroLevel(s__SaiNewE_caster[this]) <= 35 then
            	call SetUnitFlyHeight(s__SaiNewE_caster[this], 0, 1000)
	        endif
            call TimerStart(NewTimerEx(this), 0.25, false, function s__SaiNewE_finish)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SaiNewE_delay1 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitTimeScale(s__SaiNewE_caster[this], 1.0)
        call SetUnitAnimationByIndex(s__SaiNewE_caster[this], 12)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__SaiNewE_move)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SaiNewE_actions takes nothing returns nothing
        local integer this= s__SaiNewE_allocate()
        set s__SaiNewE_caster[this]=GetTriggerUnit()
        set s__SaiNewE_target_x[this]=GetSpellTargetX()
        set s__SaiNewE_target_y[this]=GetSpellTargetY()
        set s__SaiNewE_count[this]=0
        call PauseUnit(s__SaiNewE_caster[this], true)
        call SetUnitTimeScale(s__SaiNewE_caster[this], 10.0)
        call SetUnitAnimation(s__SaiNewE_caster[this], "morph")
        call SetUnitFlyHeight(s__SaiNewE_caster[this], 300, 2000)
        call TimerStart(NewTimerEx(this), 0.1, false, function s__SaiNewE_delay1)
    endfunction 
    
