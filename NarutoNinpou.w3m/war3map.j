	call DestroyEffect(AddSpecialEffect(("animeslashfinal.mdl" ), (( GetSpellTargetX() )*1.0), (( GetSpellTargetY())*1.0))) // INLINED!!
	if GetUnitTypeId(s__Farm_caster[this]) == 'H05Q' then
        	set s__Farm_kinkaku[this]=CreateUnit(GetTriggerPlayer(), 'h05U', GetSpellTargetX(), GetSpellTargetY(), 270)
        	set j=0
        	loop
            		set j=j + 1
            		exitwhen j > 6
            		set x=(((GetUnitX(s__Farm_kinkaku[this]) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
            		set y=(((GetUnitY(s__Farm_kinkaku[this]) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
            		call DestroyEffect(AddSpecialEffect(("AnotherLightning.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        	endloop

	else
		set s__Farm_ginkaku[this]=CreateUnit(GetTriggerPlayer(), 'h07P', GetSpellTargetX(), GetSpellTargetY(), 270)
        	set j=0
        	loop
            		set j=j + 1
            		exitwhen j > 6
            		set x=(((GetUnitX(s__Farm_ginkaku[this]) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
            		set y=(((GetUnitY(s__Farm_ginkaku[this]) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
            		call DestroyEffect(AddSpecialEffect(("FireCrack.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        	endloop
	endif
        call SetUnitAnimation(s__Farm_ginkaku[this], "Spell One")
        call SetUnitAnimation(s__Farm_kinkaku[this], "attack slam")
        call SetUnitAnimation(GetTriggerUnit(), "spell")
        set bj_lastCreatedGroup=CreateGroup()
		set s__Farm_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetSpellTargetX(), GetSpellTargetY(), 400, Filter(function s__Farm_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 0.5, false, function s__Farm_finish)
    endfunction 
    
