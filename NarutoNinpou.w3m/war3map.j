//===========================================================================
// Trigger: MinatoSpaceTimeJutsu
//===========================================================================
function Trig_MinatoSpaceTimeJutsu_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0BC' or GetSpellAbilityId() == 'A0YR'
endfunction

function Trig_MinatoSpaceTimeJutsu_Actions takes nothing returns nothing
    call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), 0)
endfunction

//===========================================================================
function InitTrig_MinatoSpaceTimeJutsu takes nothing returns nothing
    set gg_trg_MinatoSpaceTimeJutsu=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MinatoSpaceTimeJutsu, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_MinatoSpaceTimeJutsu, Condition(function Trig_MinatoSpaceTimeJutsu_Conditions))
    call TriggerAddAction(gg_trg_MinatoSpaceTimeJutsu, function Trig_MinatoSpaceTimeJutsu_Actions)
endfunction


