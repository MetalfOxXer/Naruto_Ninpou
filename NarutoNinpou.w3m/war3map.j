    function s__HayateNewW_periodic3 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HayateNewW_slash[this])
        local real y= GetUnitY(s__HayateNewW_slash[this])
        local real new_x= (((x )*1.0) + Cos((( s__HayateNewW_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__HayateNewW_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        call SetUnitX(s__HayateNewW_slash[this], new_x)
        call SetUnitY(s__HayateNewW_slash[this], new_y)
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__HayateNewW_caster[this]), 'nogn', x, y, Rad2Deg(s__HayateNewW_angle[this]))
        call SetUnitX(bj_lastCreatedUnit, x)
        call SetUnitY(bj_lastCreatedUnit, y)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.2)
	if ModuloInteger(s__HayateNewW_count[this], 5) == 0 then
		set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdx", x, y)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HayateNewW_angle[this])
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
		call DestroyEffect(bj_lastCreatedEffect)
	endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HayateNewW_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__HayateNewW_damaged[this]) then
                call GroupAddUnit(s__HayateNewW_damaged[this], bj_lastCreatedUnit)
                call UnitDamageTarget(s__HayateNewW_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__HayateNewW_caster[this], true) / 3 * GetUnitAbilityLevel(s__HayateNewW_caster[this], s__HayateNewW_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__HayateNewW_count[this]=s__HayateNewW_count[this] + 1
        if s__HayateNewW_count[this] >= 25 then
            call KillUnit(s__HayateNewW_slash[this])
            call ShowUnit(s__HayateNewW_slash[this], false)
            set s__HayateNewW_slash[this]=null
            call DestroyGroup(s__HayateNewW_damaged[this])
            set s__HayateNewW_damaged[this]=null
            call s__HayateNewW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 


