				call UnitDamageTarget(s__YugitoClawsStorm_caster[this], bj_lastCreatedUnit, ( GetHeroAgi(s__YugitoClawsStorm_caster[this], true) ) * GetUnitAbilityLevel(s__YugitoClawsStorm_caster[this], s__YugitoClawsStorm_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Orc\\Orcblood\\BattrollBlood.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
				call SetUnitAnimation(bj_lastCreatedUnit, "death")
				call PauseUnit(bj_lastCreatedUnit, false)
				call GroupRemoveUnit(s__YugitoClawsStorm_damaged[this], bj_lastCreatedUnit)
			endloop
			call PauseUnit(s__YugitoClawsStorm_caster[this], false)
			//call SlowArea(this.caster, GetUnitX(this.caster), GetUnitY(this.caster), 350)
			call DestroyGroup(s__YugitoClawsStorm_damaged[this])
			set s__YugitoClawsStorm_damaged[this]=null
			call s__YugitoClawsStorm_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__YugitoClawsStorm_actions takes nothing returns nothing
  local integer this= s__YugitoClawsStorm__allocate()
		set s__YugitoClawsStorm_caster[this]=GetTriggerUnit()
		set s__YugitoClawsStorm_damaged[this]=CreateGroup()
		set s__YugitoClawsStorm_count[this]=0
