//===========================================================================
// Trigger: AkatsukiArtistsGenjutsuBonus
//===========================================================================

    function s__AkatsukiArtistsGenjutsuBonus_actions takes nothing returns nothing
        local integer id= GetUnitTypeId(GetTriggerUnit())
        local integer id2
        local integer i
      if udg_DraftPickAR == false then
        if id == 'H00D' or id == 'H01H' then
            set i=0
            loop
                exitwhen i > 11
                if IsPlayerAlly(Player(i), GetTriggerPlayer()) and udg_units33[i + 1] != null then
                    set id2=GetUnitTypeId(udg_units33[i + 1])
                    if id2 == 'E01Y' or id2 == 'EO2E' or id2 == 'E02F' then
                        call SetHeroInt(GetTriggerUnit(), GetHeroInt(GetTriggerUnit(), false) + 1, true)
                    endif
                endif
                set i=i + 1
            endloop
        elseif id == 'E01Y' or id == 'E02E' or id == 'E02F' then
            set i=0
            loop
                exitwhen i > 11
                if IsPlayerAlly(Player(i), GetTriggerPlayer()) and udg_units33[i + 1] != null then
                    set id2=GetUnitTypeId(udg_units33[i + 1])
                    if id2 == 'H00D' or id2 == 'H01H' then
                        call SetHeroInt(GetTriggerUnit(), GetHeroInt(GetTriggerUnit(), false) + 1, true)
                    endif
                endif
                set i=i + 1
            endloop
        endif
      endif
    endfunction
    
    function s__AkatsukiArtistsGenjutsuBonus_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_LEVEL ) , Filter(( function s__AkatsukiArtistsGenjutsuBonus_actions))) // INLINED!!
    endfunction
    
