                    call BlzSetUnitSkin(bj_lastCreatedUnit, 'h0AS')
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
            set s__KakashiLightningClone_kakashi_clone=u
            set x=GetUnitX(s__KakashiLightningClone_kakashi)
            set y=GetUnitY(s__KakashiLightningClone_kakashi)
