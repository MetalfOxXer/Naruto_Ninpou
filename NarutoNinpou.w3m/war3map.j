            //    call SetUnitPropWindow(this.caster, this.window)
            endif
            call SetUnitVertexColor(s__KakashiUnderground_caster[this], 255, 255, 255, 255)
            loop
                exitwhen i > 5
                set x=(((GetUnitX(s__KakashiUnderground_caster[this]) )*1.0) + Cos((( Deg2Rad(72 * i) )*1.0)) * (( 130)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__KakashiUnderground_caster[this]) )*1.0) + Sin((( Deg2Rad(72 * i) )*1.0)) * (( 130)*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
            call DestroyEffect(AddSpecialEffect(("" ), (( GetUnitX(s__KakashiUnderground_caster[this]) )*1.0), (( GetUnitY(s__KakashiUnderground_caster[this]))*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KakashiUnderground_caster[this]), GetUnitY(s__KakashiUnderground_caster[this]), 350, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiUnderground_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__KakashiUnderground_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__KakashiUnderground_caster[this], true) / 2 * GetUnitAbilityLevel(s__KakashiUnderground_caster[this], s__KakashiUnderground_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    call EsnareUnitTimed(s__KakashiUnderground_caster[this] , bj_lastCreatedUnit , 0.5)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            call UnitRemoveAbility(s__KakashiUnderground_caster[this], 'Binv')
            call UnitRemoveAbility(s__KakashiUnderground_caster[this], 'A171')
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakashiUnderground_caster[this]), s__KakashiUnderground_SPELL_ID, true)
            call ReleaseTimer(GetExpiredTimer())
            call s__KakashiUnderground_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__KakashiUnderground_disableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitAddAbility(s__KakashiUnderground_caster[this], 'A171')
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakashiUnderground_caster[this]), s__KakashiUnderground_SPELL_ID, false)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__KakashiUnderground_actions takes nothing returns nothing
        local integer this= s__KakashiUnderground_allocate()
        set s__KakashiUnderground_caster[this]=GetTriggerUnit()
        set s__KakashiUnderground_count[this]=0
        call SetUnitVertexColor(s__KakashiUnderground_caster[this], 255, 255, 255, 0)
        set s__KakashiUnderground_window[this]=GetUnitPropWindow(s__KakashiUnderground_caster[this])
        //call SetUnitPropWindow(this.caster, 0)
        set s__KakashiUnderground_stop=false
        set bj_lastCreatedUnit=CreateAbilityDummy(s__KakashiUnderground_caster[this] , 'A007')
        call IssueTargetOrder(bj_lastCreatedUnit, "invisibility", s__KakashiUnderground_caster[this])
        set s__KakashiUnderground_previous_x[this]=GetUnitX(s__KakashiUnderground_caster[this])
        set s__KakashiUnderground_previous_y[this]=GetUnitY(s__KakashiUnderground_caster[this])
        call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( GetUnitX(s__KakashiUnderground_caster[this]) )*1.0), (( GetUnitY(s__KakashiUnderground_caster[this]))*1.0))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.5, false, function s__KakashiUnderground_disableSkill)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__KakashiUnderground_periodic)
    endfunction 

    function s__KakashiUnderground_stopCast takes nothing returns nothing
        set s__KakashiUnderground_stop=true
    endfunction 

    function s__KakashiUnderground_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__KakashiUnderground_SPELL_ID ) , Filter(( function s__KakashiUnderground_actions))) // INLINED!!
        call RegisterSpellEffectEvent2(('A171' ) , Filter(( function s__KakashiUnderground_stopCast))) // INLINED!!
    endfunction 

