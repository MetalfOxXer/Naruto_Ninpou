    function s__Bird_actions takes nothing returns nothing
        local integer this= s__Bird_allocate()
 local real x
 local real y
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Ajisai_Animal_Path_T, 100, GetTriggerUnit())
        endif
        set s__Bird_caster[this]=GetTriggerUnit()
	set s__Bird_target_x[this]=GetSpellTargetX()
	set s__Bird_target_y[this]=GetSpellTargetY()
        set s__Bird_angle[this]=Atan3(GetUnitX(s__Bird_caster[this]) , GetUnitY(s__Bird_caster[this]) , s__Bird_target_x[this] , s__Bird_target_y[this])

	set x=(((GetUnitX(s__Bird_caster[this]) )*1.0) + Cos((( s__Bird_angle[this] )*1.0)) * (( - 600)*1.0)) // INLINED!!
	set y=(((GetUnitY(s__Bird_caster[this]) )*1.0) + Sin((( s__Bird_angle[this] )*1.0)) * (( - 600)*1.0)) // INLINED!!

	set s__Bird_x[this]=(((GetUnitX(s__Bird_caster[this]) )*1.0) + Cos((( s__Bird_angle[this] )*1.0)) * (( 600)*1.0)) // INLINED!!
	set s__Bird_y[this]=(((GetUnitY(s__Bird_caster[this]) )*1.0) + Sin((( s__Bird_angle[this] )*1.0)) * (( 600)*1.0)) // INLINED!!

        set s__Bird_bird[this]=CreateUnit(GetOwningPlayer(s__Bird_caster[this]), 'e083', x, y, Rad2Deg(s__Bird_angle[this]))
        call SetUnitFlyHeight(s__Bird_bird[this], 800, 0)
        set s__Bird_count[this]=0
        call TimerStart(NewTimerEx(this), 0.03, true, function s__Bird_fly)
