    function s__KisameSemi_dealDamage takes nothing returns boolean
			call GroupRemoveUnit(bj_lastCreatedGroup, GetFilterUnit())
			if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KisameSemi_caster[s__KisameSemi_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
			if GetUnitTypeId(s__KisameSemi_caster[s__KisameSemi_instance]) == 'U005' then
					call UnitDamageTarget(s__KisameSemi_caster[s__KisameSemi_instance], GetFilterUnit(), 700 * GetUnitAbilityLevel(s__KisameSemi_caster[s__KisameSemi_instance], s__KisameSemi_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					if (UnitHasItemOfTypeBJ((s__KisameSemi_caster[s__KisameSemi_instance] ), ( 'I00H'))) then // INLINED!!
   						call SetUnitState(GetFilterUnit(), UNIT_STATE_MANA, GetUnitState(GetFilterUnit(), UNIT_STATE_MANA) - GetUnitState(GetFilterUnit(), UNIT_STATE_MAX_MANA) * 0.15)
					endif
				else
					call UnitDamageTarget(s__KisameSemi_caster[s__KisameSemi_instance], GetFilterUnit(), 1400, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					if (UnitHasItemOfTypeBJ((s__KisameSemi_caster[s__KisameSemi_instance] ), ( 'I00H'))) then // INLINED!!
   						call SetUnitState(GetFilterUnit(), UNIT_STATE_MANA, GetUnitState(GetFilterUnit(), UNIT_STATE_MANA) - GetUnitState(GetFilterUnit(), UNIT_STATE_MAX_MANA) * 0.15)
					endif
				endif
			endif
	    return false
 endfunction

 function s__KisameSemi_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i= 0
		loop
			exitwhen i == 3
			set i=i + 1
		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Blood.mdx", s__KisameSemi_target_x[this], s__KisameSemi_target_y[this])
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, GetRandomReal(0, 2 * bj_PI))
		call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 3.0)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 200 + GetPointZ(s__KisameSemi_target_x[this] , s__KisameSemi_target_y[this]))
		call DestroyEffect(bj_lastCreatedEffect)
		endloop
		set bj_lastCreatedGroup=CreateGroup()
		set s__KisameSemi_instance=this
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KisameSemi_target_x[this], s__KisameSemi_target_y[this], 400, Filter(function s__KisameSemi_dealDamage))
		call s__KisameSemi_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__KisameSemi_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real offset
  local real angle
  local real x
  local real y
  local real facing_angle
  local integer i= 0
		loop
		exitwhen i == 3
		set i=i + 1
		set offset=GetRandomReal(0, 200)
		set angle=GetRandomReal(0, 360)
		set x=(((s__KisameSemi_target_x[this] )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
		set y=(((s__KisameSemi_target_y[this] )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
		set facing_angle=Atan3(x , y , s__KisameSemi_target_x[this] , s__KisameSemi_target_y[this])
		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\Shark_New.mdx", x, y)
		//call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(-270))
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, facing_angle)
		call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, GetRandomReal(2.5, 3.5))
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(100, 300))
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(0.7, 1.3))
		call BlzSpecialEffectAddSubAnimation(bj_lastCreatedEffect, SUBANIM_TYPE_ONE)
    		call BlzPlaySpecialEffect(bj_lastCreatedEffect, ANIM_TYPE_SPELL)
		call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , true) // INLINED!!
		endloop
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KisameSemi_target_x[this], s__KisameSemi_target_y[this], 400, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KisameSemi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				if GetUnitTypeId(s__KisameSemi_caster[this]) == 'U005' then
					call UnitDamageTarget(s__KisameSemi_caster[this], bj_lastCreatedUnit, 2.5 * GetHeroStr(s__KisameSemi_caster[this], true) * GetUnitAbilityLevel(s__KisameSemi_caster[this], s__KisameSemi_SPELL_ID) / 33.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__KisameSemi_caster[this], bj_lastCreatedUnit, 5.0 * GetHeroStr(s__KisameSemi_caster[this], true) / 33.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				endif
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__KisameSemi_count[this]=s__KisameSemi_count[this] + 1
		if s__KisameSemi_count[this] == 33 then
			set x=(((s__KisameSemi_target_x[this] )*1.0) + Cos((( Rad2Deg(0) )*1.0)) * (( 200)*1.0)) // INLINED!!
			set y=(((s__KisameSemi_target_y[this] )*1.0) + Sin((( Rad2Deg(0) )*1.0)) * (( 200)*1.0)) // INLINED!!
			set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Water_Shark_Greater.mdl", x, y)
			call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(270))
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 300 + GetPointZ(s__KisameSemi_target_x[this] , s__KisameSemi_target_y[this]))
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
			call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1.0)*1.0) , false) // INLINED!!
			call KillUnit(s__KisameSemi_pool[this])
			call TimerStart(NewTimerEx(this), 0.25, false, function s__KisameSemi_delay)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction

 function s__KisameSemi_actions takes nothing returns nothing
  local integer this= s__KisameSemi_allocate()
