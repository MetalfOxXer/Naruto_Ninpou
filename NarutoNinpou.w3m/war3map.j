    function s__HayateSwordStrikeNew_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HayateSwordStrikeNew_clone[this])
        local real y= GetUnitY(s__HayateSwordStrikeNew_clone[this])
        local real new_x= (((x )*1.0) + Cos((( s__HayateSwordStrikeNew_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__HayateSwordStrikeNew_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!

        set s__HayateSwordStrikeNew_count[this]=s__HayateSwordStrikeNew_count[this] + 1
        if s__HayateSwordStrikeNew_count[this] < 13 then
		set bj_lastCreatedEffect=AddSpecialEffect("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdl", new_x, new_y)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__HayateSwordStrikeNew_angle[this])
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__HayateSwordStrikeNew_clone[this]) , GetUnitY(s__HayateSwordStrikeNew_clone[this])))
		call BlzSetSpecialEffectAlpha(bj_lastCreatedEffect, 200)
		call DestroyEffect(bj_lastCreatedEffect)
        	call SetUnitX(s__HayateSwordStrikeNew_clone[this], new_x)
        	call SetUnitY(s__HayateSwordStrikeNew_clone[this], new_y)
        	call SetUnitAnimationByIndex(s__HayateSwordStrikeNew_clone[this], 1)
        	set bj_lastCreatedGroup=CreateGroup()
        	call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
        	loop
            		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            		exitwhen bj_lastCreatedUnit == null
            		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HayateSwordStrikeNew_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__HayateSwordStrikeNew_damaged[this]) then
                		call GroupAddUnit(s__HayateSwordStrikeNew_damaged[this], bj_lastCreatedUnit)
                		call UnitDamageTarget(s__HayateSwordStrikeNew_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__HayateSwordStrikeNew_caster[this], true) * GetUnitAbilityLevel(s__HayateSwordStrikeNew_caster[this], s__HayateSwordStrikeNew_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
						set bj_lastCreatedEffect=AddSpecialEffect("zhanji-blue.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
						call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(0.25, 0.3))
						call DestroyEffect(bj_lastCreatedEffect)
	            endif
        	    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        	endloop
        	call DestroyGroup(bj_lastCreatedGroup)
	endif
	if s__HayateSwordStrikeNew_count[this] == 13 then
	    call SetUnitAnimation(s__HayateSwordStrikeNew_clone[this], "Attack")
            set bj_lastCreatedEffect=AddSpecialEffect("animeslashfinal.mdl", GetUnitX(s__HayateSwordStrikeNew_clone[this]), GetUnitY(s__HayateSwordStrikeNew_clone[this]))
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
