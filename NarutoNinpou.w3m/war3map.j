//Implemented from module Alloc:
    
        function s__BMission_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__BMission_Alloc___recycle[(0)] == 0 ) then
                set s__BMission_Alloc___instanceCount=s__BMission_Alloc___instanceCount + 1
                set this=s__BMission_Alloc___instanceCount
            else
                set this=s__BMission_Alloc___recycle[(0)]
                set s__BMission_Alloc___recycle[(0)]=s__BMission_Alloc___recycle[s__BMission_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__BMission_deallocate takes integer this returns nothing
            set s__BMission_Alloc___recycle[this]=s__BMission_Alloc___recycle[(0)]
            set s__BMission_Alloc___recycle[(0)]=this
        endfunction
   
    function s__BMission_start takes nothing returns nothing
  local integer this= s__BMission_allocate()
  local integer team
  local boolean haspoints
		if GetItemTypeId(GetManipulatedItem()) == 'I05B' then
				if not udg_MissionsEnabled then
					return
				endif
				if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
					set team=0
					set haspoints=( GetTeamPoints(7) - GetTeamPoints(3) ) >= 100 or ( GetTeamPoints(11) - GetTeamPoints(3) >= 100 )
				elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
					set team=1
					set haspoints=( GetTeamPoints(3) - GetTeamPoints(7) ) >= 100 or ( GetTeamPoints(11) - GetTeamPoints(7) >= 100 )
				else
					set team=2
					set haspoints=( GetTeamPoints(3) - GetTeamPoints(11) ) >= 100 or ( GetTeamPoints(7) - GetTeamPoints(11) >= 100 )
				endif
					if not udg_MissionBRankActive then
						if not udg_MissionBRankTeamCompleted[team] then
							if haspoints then
								if true then
									set udg_MissionBRankActive=true
									set udg_MissionBRankTeams[team]=true
									set udg_MissionBUnit=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
									set udg_MissionBCount=0
									set s__BMission_delayMission=false
									call TimerStart(NewTimerEx(this), 0.1, false, function sc__BMission_actions)
								else
									call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000You have already completed a mission. You can only do one at a time.|r")
								endif
							else
								call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Your team must have 100 points below the winning team before doing this mission.|r")
							endif
						else
							call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000This mission was already done by your team.|r")
						endif
					else
						call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Someone is already doing this mission at this moment.|r")
					endif
			else
			return
		endif
    endfunction 
   
  function s__BMission_actions takes nothing returns nothing
     local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
   local unit u
   local unit k
   local unit j
			call SetUnitPosition(udg_MissionBUnit, GetRectCenterX(gg_rct_MissionBEntry), GetRectCenterY(gg_rct_MissionBEntry))
			set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'U00R', - 3079, 5404, 204.87)
			call SetHeroLevel(u, 1, true)
			set k=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'H09A', - 2854, 5204, 189.74)
			call SetHeroLevel(k, 1, true)
			set j=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'U00Q', - 2629, 5404, 162.17)
			call SetHeroLevel(j, 1, true)
			call PanCameraToTimedForPlayer(GetOwningPlayer(udg_MissionBUnit), GetRectCenterX(gg_rct_MissionBEntry), GetRectCenterY(gg_rct_MissionBEntry), 0)
			set u=null
			set j=null
			set k=null
		   call ReleaseTimer(GetExpiredTimer())
  endfunction 
   
    function s__BMission_death takes nothing returns nothing
     local integer team
			   if GetTriggerUnit() == udg_MissionBUnit then
				   if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
					   set team=0
				   elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
					   set team=1
				   else
					   set team=2
				   endif
				   set udg_MissionBRankActive=false
				   set udg_MissionBRankTeams[team]=false
				   set udg_MissionBUnit=null
			   set bj_lastCreatedGroup=CreateGroup()
				   call GroupEnumUnitsInRange(bj_lastCreatedGroup, - 2854, 5204, 2000, null)
				   loop
						   set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
						   exitwhen bj_lastCreatedUnit == null
						   if ( GetUnitTypeId(bj_lastCreatedUnit) == 'U00R' or GetUnitTypeId(bj_lastCreatedUnit) == 'H09A' or GetUnitTypeId(bj_lastCreatedUnit) == 'U00Q' ) then
						   call KillUnit(bj_lastCreatedUnit)
				   endif
						   call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				   endloop
				   call DestroyGroup(bj_lastCreatedGroup)
			   endif
    endfunction 
   
    function s__BMission_delay3 takes nothing returns nothing
     local integer i= 0
     local integer team
		   if IsPlayerAlly(GetOwningPlayer(udg_MissionBUnit), Player(3)) then
			   set team=0
		   elseif IsPlayerAlly(GetOwningPlayer(udg_MissionBUnit), Player(7)) then
			   set team=1
		   else
			   set team=2
		   endif
		   set udg_MissionBRankTeamCompleted[team]=true
		   call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(GetOwningPlayer(udg_MissionBUnit)) + 1] + GetUnitName(udg_MissionBUnit) + " |cff87ceebcompleted a B-Rank mission!|r")
		   loop
				   exitwhen i > 11
				   if IsPlayerAlly(Player(i), GetOwningPlayer(udg_MissionBUnit)) and udg_units33[i + 1] != null then
                    call AddHeroXPSwappedCappedToMax(12500 , udg_units33[i + 1] , true)
				   endif
				   set i=i + 1
		   endloop
		   if IsPlayerAlly(GetOwningPlayer(udg_MissionBUnit), Player(3)) then
				   call SetUnitPosition(udg_MissionBUnit, GetRectCenterX(gg_rct_FountainKonohagakure), GetRectCenterY(gg_rct_FountainKonohagakure))
		   elseif IsPlayerAlly(GetOwningPlayer(udg_MissionBUnit), Player(7)) then
				   call SetUnitPosition(udg_MissionBUnit, GetRectCenterX(gg_rct_FountainOtogakure), GetRectCenterY(gg_rct_FountainOtogakure))
		   else
				   call SetUnitPosition(udg_MissionBUnit, GetRectCenterX(gg_rct_FountainAkatsuki), GetRectCenterY(gg_rct_FountainAkatsuki))
		   endif
		   //call GroupAddUnit(udg_MissionComplete, udg_MissionBUnit)
			   set udg_MissionBUnit=null
			   set udg_MissionBRankActive=false
			   call ReleaseTimer(GetExpiredTimer())
    endfunction
   
  function s__BMission_death2 takes nothing returns nothing
		  if udg_MissionBCount >= 3 and udg_MissionBRankActive and not s__BMission_delayMission then
				set s__BMission_delayMission=true
			   call TimerStartEx((NewTimerEx(0)) , 3.0 , false , function s__BMission_delay3 , "MissionBRank_delay3") // INLINED!!
		  endif
  endfunction 
   
    function s__BMission_onInit takes nothing returns nothing
			   call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_PICKUP_ITEM ) , Filter(( function s__BMission_start))) // INLINED!!
		   call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__BMission_death))) // INLINED!!
		   call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__BMission_death2))) // INLINED!!
                   //call Init_Debug_XPTest()
    endfunction 
   

