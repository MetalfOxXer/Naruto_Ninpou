//Implemented from module Alloc:
    
        function s__NagatoDevaTarget__Spell_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__NagatoDevaTarget__Spell_Alloc___recycle[(0)] == 0 ) then
