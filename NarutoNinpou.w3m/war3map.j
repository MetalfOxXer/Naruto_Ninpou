            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
            set s__TentenDanceOfChains_target[this]=u
            //call PauseUnit(this.caster, false)
	    set s__TentenDanceOfChains_bondage[this]=AddSpecialEffectTarget("war3mapImported\\Bondage Blue SD.mdl", s__TentenDanceOfChains_target[this], "origin")
	    call BlzSetSpecialEffectColor(s__TentenDanceOfChains_bondage[this], 20, 20, 30)
            call PauseUnit(s__TentenDanceOfChains_target[this], true)
            call TimerStart(NewTimerEx(this), 0.02, true, function s__TentenDanceOfChains_pull)
            call ReleaseTimer(GetExpiredTimer())
        elseif s__TentenDanceOfChains_count[this] > 30 then
            if s__TentenDanceOfChains_target[this] != null then
                //call PauseUnit(this.caster, false)
                call PauseUnit(s__TentenDanceOfChains_target[this], true)
		set s__TentenDanceOfChains_bondage[this]=AddSpecialEffectTarget("war3mapImported\\Bondage Blue SD.mdl", s__TentenDanceOfChains_target[this], "origin")
		call BlzSetSpecialEffectColor(s__TentenDanceOfChains_bondage[this], 20, 20, 30)
                call TimerStart(NewTimerEx(this), 0.02, true, function s__TentenDanceOfChains_pull)
                call ReleaseTimer(GetExpiredTimer())
            else
                //call PauseUnit(this.caster, false)
                call SetUnitAnimation(s__TentenDanceOfChains_caster[this], "stand")
                call SetUnitPropWindow(s__TentenDanceOfChains_caster[this], s__TentenDanceOfChains_window[this])
                loop
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl" ), (( s___TentenDanceOfChains_chains_x[s__TentenDanceOfChains_chains_x[this]+s__TentenDanceOfChains_count[this]] )*1.0), (( s___TentenDanceOfChains_chains_y[s__TentenDanceOfChains_chains_y[this]+s__TentenDanceOfChains_count[this]])*1.0))) // INLINED!!
					call BlzSetSpecialEffectScale(s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]], 0)
                    call DestroyEffect(s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]])
                    set s___TentenDanceOfChains_chains[s__TentenDanceOfChains_chains[this]+s__TentenDanceOfChains_count[this]]=null
                    set s__TentenDanceOfChains_count[this]=s__TentenDanceOfChains_count[this] - 1
                    exitwhen s__TentenDanceOfChains_count[this] == 0
                endloop
                call s__TentenDanceOfChains_destroy(this)
                //call TimerStart(NewTimerEx(this), 0.02, true, function thistype.pull)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction
    
