		call DestroyEffect(AddSpecialEffect(("AnimeGroundSmack.mdx" ), (( GetUnitX(s__MechaNarutoFlyMode_caster[this]) )*1.0), (( GetUnitY(s__MechaNarutoFlyMode_caster[this]))*1.0))) // INLINED!!
		call TimerStart(NewTimerEx(this), 0.03, true, function s__MechaNarutoFlyMode_periodic)
 endfunction 

 function s__MechaNarutoFlyMode_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2((s__MechaNarutoFlyMode_SPELL_ID ) , Filter(( function s__MechaNarutoFlyMode_actions))) // INLINED!!
