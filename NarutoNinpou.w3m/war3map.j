    function s__ShisuiSusanooDrill_startDamage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i= 0
        local integer j
        local real x
        local real y
        loop
            exitwhen i > 6
            set x=(((s__ShisuiSusanooDrill_target_x[this] )*1.0) + Cos((( Deg2Rad(72 * i) )*1.0)) * (( 20 * ( i + 1 ))*1.0)) // INLINED!!
            set y=(((s__ShisuiSusanooDrill_target_y[this] )*1.0) + Sin((( Deg2Rad(72 * i) )*1.0)) * (( 20 * ( i + 1 ))*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Grass_Explosion.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("FireCrack.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            set i=i + 1
        endloop
        set bj_lastCreatedGroup=CreateGroup()
        set s__ShisuiSusanooDrill_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ShisuiSusanooDrill_target_x[this], s__ShisuiSusanooDrill_target_y[this], 250.0, Filter(function s__ShisuiSusanooDrill_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
        call PauseUnit(s__ShisuiSusanooDrill_caster[this], false)
        call SelectUnitForPlayerSingle(s__ShisuiSusanooDrill_caster[this], GetOwningPlayer(s__ShisuiSusanooDrill_caster[this]))
	set udg_SusanooDrill=false
	set s__ShisuiSusanooDrill_caster[this]=null
        call s__ShisuiSusanooDrill_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
