    function s__YaguraSemiNew_corals takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real scale= GetRandomReal(0.75, 2.5)
        local real x= GetUnitX(s__YaguraSemiNew_target[this])
        local real y= GetUnitY(s__YaguraSemiNew_target[this])
        set s__YaguraSemiNew_count[this]=s__YaguraSemiNew_count[this] + 1
        if ModuloInteger(s__YaguraSemiNew_count[this], 3) == 0 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__YaguraSemiNew_caster[this]), 'e03I', x, y, GetRandomReal(0, 360))
            call SetUnitScale(bj_lastCreatedUnit, scale, scale, scale)
            call SetUnitTimeScale(bj_lastCreatedUnit, 160.0)
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        endif
        if GetUnitAbilityLevel(s__YaguraSemiNew_target[this], 'B017') == 0 then
	    set s__YaguraSemiNew_target[this]=null
            call s__YaguraSemiNew_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction 
    
    function s__YaguraSemiNew_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= (((GetUnitX(s__YaguraSemiNew_target[this]) )*1.0) + Cos((( s__YaguraSemiNew_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__YaguraSemiNew_target[this]) )*1.0) + Sin((( s__YaguraSemiNew_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" ), (( GetUnitX(s__YaguraSemiNew_target[this]) )*1.0), (( GetUnitY(s__YaguraSemiNew_target[this]))*1.0))) // INLINED!!
            call SetUnitX(s__YaguraSemiNew_target[this], x)
            call SetUnitY(s__YaguraSemiNew_target[this], y)
        else
            set s__YaguraSemiNew_count[this]=20
        endif
        set s__YaguraSemiNew_count[this]=s__YaguraSemiNew_count[this] + 1
        if s__YaguraSemiNew_count[this] >= 20 then
	    set s__YaguraSemiNew_count[this]=0
	    call PauseUnit(s__YaguraSemiNew_target[this], false)
            call TimerStart(NewTimerEx(this), 0.1, true, function s__YaguraSemiNew_corals)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__YaguraSemiNew_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i= 0
        local real angle= Atan3(GetUnitX(s__YaguraSemiNew_bijuu[this]) , GetUnitY(s__YaguraSemiNew_bijuu[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__YaguraSemiNew_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__YaguraSemiNew_caster[this])))])) // INLINED!!
        local real x= (((GetUnitX(s__YaguraSemiNew_bijuu[this]) )*1.0) + Cos((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__YaguraSemiNew_bijuu[this]) )*1.0) + Sin((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
	call SetUnitFacing(s__YaguraSemiNew_caster[this], Rad2Deg(angle))
	set s__YaguraSemiNew_count[this]=s__YaguraSemiNew_count[this] + 1
	if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
        	call SetUnitX(s__YaguraSemiNew_bijuu[this], x)
        	call SetUnitY(s__YaguraSemiNew_bijuu[this], y)
        	call SetUnitX(s__YaguraSemiNew_caster[this], x)
        	call SetUnitY(s__YaguraSemiNew_caster[this], y)
	endif
        call SetUnitFacing(s__YaguraSemiNew_bijuu[this], Rad2Deg(angle))
	if s__YaguraSemiNew_count[this] >= 100 then
		set s__YaguraSemiNew_count[this]=0
		set s__YaguraSemiNew_duration[this]=s__YaguraSemiNew_duration[this] + 1
     		call SetUnitAnimationByIndex(s__YaguraSemiNew_bijuu[this], 2)
	endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 200.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__YaguraSemiNew_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                set s__YaguraSemiNew_target[this]=bj_lastCreatedUnit
            	set s__YaguraSemiNew_angle[this]=Atan3(GetUnitX(s__YaguraSemiNew_bijuu[this]) , GetUnitY(s__YaguraSemiNew_bijuu[this]) , GetUnitX(s__YaguraSemiNew_target[this]) , GetUnitY(s__YaguraSemiNew_target[this]))
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__YaguraSemiNew_target[this] != null then
            call PauseUnit(s__YaguraSemiNew_caster[this], false)
	    call PauseUnit(s__YaguraSemiNew_target[this], true)
            call SetUnitVertexColor((s__YaguraSemiNew_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
            call KillUnit(s__YaguraSemiNew_bijuu[this])
            call ShowUnit(s__YaguraSemiNew_bijuu[this], false)
	    call UnitDamageTarget(s__YaguraSemiNew_caster[this], s__YaguraSemiNew_target[this], ( 800.0 + GetHeroStr(s__YaguraSemiNew_caster[this], true) + GetHeroInt(s__YaguraSemiNew_caster[this], true) ) * GetUnitAbilityLevel(s__YaguraSemiNew_caster[this], s__YaguraSemiNew_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	    call EsnareUnitTimed(s__YaguraSemiNew_caster[this] , s__YaguraSemiNew_target[this] , 2.5)
            set s__YaguraSemiNew_bijuu[this]=null
            set s__YaguraSemiNew_count[this]=0
            call TimerStart(NewTimerEx(this), 0.03, true, function s__YaguraSemiNew_knockback)
            call ReleaseTimer(GetExpiredTimer())
	elseif s__YaguraSemiNew_duration[this] >= 2 or GetWidgetLife(s__YaguraSemiNew_caster[this]) < 0.405 then
            call PauseUnit(s__YaguraSemiNew_caster[this], false)
            call SetUnitVertexColor((s__YaguraSemiNew_caster[this] ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
            call KillUnit(s__YaguraSemiNew_bijuu[this])
            call ShowUnit(s__YaguraSemiNew_bijuu[this], false)
            set s__YaguraSemiNew_bijuu[this]=null
            set s__YaguraSemiNew_count[this]=0
            call s__YaguraSemiNew_deallocate(this)
	    call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
