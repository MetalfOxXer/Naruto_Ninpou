        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__TobiramaHiraishin_tobirama) )*1.0), (( GetUnitY(s__TobiramaHiraishin_tobirama))*1.0))) // INLINED!!
