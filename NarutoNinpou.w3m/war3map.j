                endif
            endif
        elseif id == s__SpawnBijuus_ANBU then
            if udg_Mode30Min then
                call AdjustPlayerStateBJ(350, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD)
            else
                call AdjustPlayerStateBJ(250, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD)
            endif
        elseif ( GetUnitTypeId(GetTriggerUnit()) == 'U00R' or GetUnitTypeId(GetTriggerUnit()) == 'H09A' or GetUnitTypeId(GetTriggerUnit()) == 'U00Q' ) then
            set udg_MissionBCount=udg_MissionBCount + 1
        elseif ( GetUnitTypeId(GetTriggerUnit()) == 'U00S' or GetUnitTypeId(GetTriggerUnit()) == 'N01Q' ) then
            set udg_MissionACount=udg_MissionACount + 1
        elseif ( GetUnitTypeId(GetTriggerUnit()) == 'N01R' ) then
            set udg_MissionSCount=udg_MissionSCount + 1
        endif
        if b then
            if id == s__SpawnBijuus_SHUKAKU then
                call CreateItemLoc('I06R', GetUnitLoc(GetTriggerUnit()))
