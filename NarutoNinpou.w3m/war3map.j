 endfunction 

        function s__RoshiGreenFlame___Spell_delay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
   local group damaged= CreateGroup()
   local real x
   local real y
            local real caster_x= GetUnitX(s__RoshiGreenFlame___Spell_bijuu[this])
            local real caster_y= GetUnitY(s__RoshiGreenFlame___Spell_bijuu[this])
            local real target_x= s__RoshiGreenFlame___Spell_x[this]
            local real target_y= s__RoshiGreenFlame___Spell_y[this]
            local real angle= Deg2Rad(GetUnitFacing(s__RoshiGreenFlame___Spell_bijuu[this]))
            local real new_x= caster_x + Cos(angle) * 30
            local real new_y= caster_y + Sin(angle) * 30
            local integer i= 0
            local real new_x_2
            local real new_y_2
			if BlzGetUnitSkin(s__RoshiGreenFlame___Spell_caster[this]) == 'h05H' then
				loop
					exitwhen i > 10
					set x=(((GetUnitX(s__RoshiGreenFlame___Spell_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 150 * i)*1.0)) // INLINED!!
					set y=(((GetUnitY(s__RoshiGreenFlame___Spell_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 150 * i)*1.0)) // INLINED!!
					set bj_lastCreatedEffect=AddSpecialEffect("AnimeFireEffectJiraiya.mdl", x, y)
					call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
					call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
					call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 100)
					call DestroyEffect(bj_lastCreatedEffect)
					set i=i + 1
				endloop
			else
            	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__RoshiGreenFlame___Spell_caster[this]), 'h07C', new_x, new_y, Rad2Deg(angle))
            	call SetUnitX(bj_lastCreatedUnit, new_x)
            	call SetUnitY(bj_lastCreatedUnit, new_y)
            	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
			endif
			set i=0
            loop
                set i=i + 1
                exitwhen i > 15
                set new_x_2=new_x + Cos(angle) * ( 100 * i )
                set new_y_2=new_y + Sin(angle) * ( 100 * i )
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__RoshiGreenFlame___Spell_caster[this]), GetUnitY(s__RoshiGreenFlame___Spell_caster[this]), 300, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__RoshiGreenFlame___Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                        

				if GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_LIFE) < GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_MAX_LIFE) / 2 and GetWidgetLife(s__RoshiGreenFlame___Spell_caster[this]) > 0.405 then
					if GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_LIFE) / GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_MAX_LIFE) <= 0.1 then
						call StunUnitTimed(s__RoshiGreenFlame___Spell_caster[this] , bj_lastCreatedUnit , 1.0)
					endif
					call UnitDamageTarget(s__RoshiGreenFlame___Spell_caster[this], bj_lastCreatedUnit, ( 10 * GetHeroStr(s__RoshiGreenFlame___Spell_caster[this], true) ) * GetUnitAbilityLevel(s__RoshiGreenFlame___Spell_caster[this], s__RoshiGreenFlame___Spell_SPELL_ID) * ( 1.5 - GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_LIFE) / GetUnitState(s__RoshiGreenFlame___Spell_caster[this], UNIT_STATE_MAX_LIFE) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				else
					call UnitDamageTarget(s__RoshiGreenFlame___Spell_caster[this], bj_lastCreatedUnit, ( 10 * GetHeroStr(s__RoshiGreenFlame___Spell_caster[this], true) ) * GetUnitAbilityLevel(s__RoshiGreenFlame___Spell_caster[this], s__RoshiGreenFlame___Spell_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				endif


						//call UnitDamageTarget(this.caster, bj_lastCreatedUnit, 6 * GetHeroStr(this.caster, true) + 2000, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(damaged, bj_lastCreatedUnit)
						if BlzGetUnitSkin(s__RoshiGreenFlame___Spell_caster[this]) == 'h05H' then
							call DestroyEffect(AddSpecialEffect(("FireAnimation.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
						else
							call DestroyEffect(AddSpecialEffect(("Effects\\s_Green_Fire.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
						endif
                    endif
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x_2, new_y_2, 300.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__RoshiGreenFlame___Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                        call UnitDamageTarget(s__RoshiGreenFlame___Spell_caster[this], bj_lastCreatedUnit, 10 * GetHeroStr(s__RoshiGreenFlame___Spell_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(damaged, bj_lastCreatedUnit)
						if BlzGetUnitSkin(s__RoshiGreenFlame___Spell_caster[this]) == 'h05H' then
							call DestroyEffect(AddSpecialEffect(("FireAnimation.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
						else
							call DestroyEffect(AddSpecialEffect(("Effects\\s_Green_Fire.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
						endif
                    endif
                endloop
            endloop
            call DestroyGroup(damaged)
            set damaged=null
	    call TimerStart(NewTimerEx(this), 0.3, false, function s__RoshiGreenFlame___Spell_disappear)
        endfunction

 function s__RoshiGreenFlame___Spell_actions takes nothing returns nothing
  local integer this= s__RoshiGreenFlame___Spell_allocate()
  local integer i
  local integer j
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Roshi_T, 100, GetTriggerUnit())
        endif
		set s__RoshiGreenFlame___Spell_caster[this]=GetTriggerUnit()
		set s__RoshiGreenFlame___Spell_x[this]=GetSpellTargetX()
		set s__RoshiGreenFlame___Spell_y[this]=GetSpellTargetY()
		if BlzGetUnitSkin(s__RoshiGreenFlame___Spell_caster[this]) == 'h05H' then
			set s__RoshiGreenFlame___Spell_bijuu[this]=CreateUnit(GetTriggerPlayer(), 'h05H', GetUnitX(s__RoshiGreenFlame___Spell_caster[this]), GetUnitY(s__RoshiGreenFlame___Spell_caster[this]), Rad2Deg(Atan3(GetUnitX(s__RoshiGreenFlame___Spell_caster[this]) , GetUnitY(s__RoshiGreenFlame___Spell_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
			call SetUnitScale(s__RoshiGreenFlame___Spell_bijuu[this], 4.0, 4.0, 4.0)
		else
			set s__RoshiGreenFlame___Spell_bijuu[this]=CreateUnit(GetTriggerPlayer(), 'e00P', GetUnitX(s__RoshiGreenFlame___Spell_caster[this]), GetUnitY(s__RoshiGreenFlame___Spell_caster[this]), Rad2Deg(Atan3(GetUnitX(s__RoshiGreenFlame___Spell_caster[this]) , GetUnitY(s__RoshiGreenFlame___Spell_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
		endif
		call SetUnitTimeScale(s__RoshiGreenFlame___Spell_bijuu[this], 2.5)
		call SetUnitAnimation(s__RoshiGreenFlame___Spell_bijuu[this], "spell")
		call PauseUnit(s__RoshiGreenFlame___Spell_caster[this], true)
		call ShowUnit(s__RoshiGreenFlame___Spell_caster[this], false)
		call SetUnitInvulnerable(s__RoshiGreenFlame___Spell_caster[this], true)
		call TimerStart(NewTimerEx(this), 1.0, false, function s__RoshiGreenFlame___Spell_delay)
		
			set i=0
			loop
				exitwhen i > 4
				set j=0
				loop
					exitwhen j > 12
					set s__RoshiGreenFlame___Spell_x[this]=(((GetUnitX(s__RoshiGreenFlame___Spell_caster[this]) )*1.0) + Cos((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					set s__RoshiGreenFlame___Spell_y[this]=(((GetUnitY(s__RoshiGreenFlame___Spell_caster[this]) )*1.0) + Sin((( Deg2Rad(30 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					if BlzGetUnitSkin(s__RoshiGreenFlame___Spell_caster[this]) == 'h05H' then
						call DestroyEffect(AddSpecialEffect(("FireAnimation.mdl" ), (( s__RoshiGreenFlame___Spell_x[this] )*1.0), (( s__RoshiGreenFlame___Spell_y[this])*1.0))) // INLINED!!
					else
						call DestroyEffect(AddSpecialEffect(("Effects\\s_Green_Fire.mdx" ), (( s__RoshiGreenFlame___Spell_x[this] )*1.0), (( s__RoshiGreenFlame___Spell_y[this])*1.0))) // INLINED!!
					endif
					set j=j + 1
				endloop
				set i=i + 1
			endloop
 endfunction 
        
        function s__RoshiGreenFlame___Spell_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(80 , s__RoshiGreenFlame___Spell_SPELL_ID , function s__RoshiGreenFlame___Spell_actions)
        endfunction
        
    
