//Implemented from module Alloc:
    
        function s__SaiRats_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SaiRats_Alloc___recycle[(0)] == 0 ) then
                set s__SaiRats_Alloc___instanceCount=s__SaiRats_Alloc___instanceCount + 1
                set this=s__SaiRats_Alloc___instanceCount
            else
                set this=s__SaiRats_Alloc___recycle[(0)]
                set s__SaiRats_Alloc___recycle[(0)]=s__SaiRats_Alloc___recycle[s__SaiRats_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SaiRats_deallocate takes integer this returns nothing
            set s__SaiRats_Alloc___recycle[this]=s__SaiRats_Alloc___recycle[(0)]
            set s__SaiRats_Alloc___recycle[(0)]=this
        endfunction
        
        function s__SaiRats_actions takes nothing returns nothing
            local integer this= s__SaiRats_allocate()
            local real x
            local real y
            local integer i
            local real dist
            local real angle
            set s__SaiRats_caster[this]=GetTriggerUnit()
            set i=0
            loop
                set i=i + 1
                exitwhen i > 10
                set dist=GetRandomReal(25, 150)
                set angle=Deg2Rad(36 * i)
                set x=(((GetUnitX(s__SaiRats_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__SaiRats_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SaiRats_caster[this]), 'unec', x, y, 36 * i)
                set x=GetUnitX(s__SaiRats_caster[this]) + Cos(Deg2Rad(36 * i)) * 4000
                set y=GetUnitY(s__SaiRats_caster[this]) + Sin(Deg2Rad(36 * i)) * 4000
                call SetUnitMoveSpeed(bj_lastCreatedUnit, 522)
                call IssuePointOrder(bj_lastCreatedUnit, "move", x, y)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.5)
            endloop
            set s__SaiRats_caster[this]=null
            call s__SaiRats_deallocate(this)
        endfunction 
        

        function s__SaiRats_onInit takes nothing returns nothing
            call RegisterSpellEffectEvent2(('A0PT' ) , Filter(( function s__SaiRats_actions))) // INLINED!!
        endfunction 
        
    
