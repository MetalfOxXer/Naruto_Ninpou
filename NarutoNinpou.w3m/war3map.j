                    set y1=GetUnitY(udg_KaguyaTeleport1[id])
                    set x2=GetUnitX(udg_KaguyaTeleport2[id])
                    set y2=GetUnitY(udg_KaguyaTeleport2[id])
                    set new_x=(((x2 )*1.0) + Cos((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id])) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                    set new_y=(((y2 )*1.0) + Sin((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id])) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, x1, y1, 100.0, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and not IsUnitPaused(bj_lastCreatedUnit) then
                            call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                        endif
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    endloop
                    call DestroyGroup(bj_lastCreatedGroup)
                    set new_x=(((x1 )*1.0) + Cos((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id]) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                    set new_y=(((y1 )*1.0) + Sin((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id]) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, x2, y2, 100.0, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and not IsUnitPaused(bj_lastCreatedUnit) then
                            call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                        endif
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                    endloop
                    call DestroyGroup(bj_lastCreatedGroup)
                endif
                set i=i + 1
            endloop
        endfunction

