    function s__FuuGrab_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__FuuGrab_caster[s__FuuGrab_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
            if s__FuuGrab_drop[s__FuuGrab_instance] then
                call UnitDamageTarget(s__FuuGrab_caster[s__FuuGrab_instance], s__FuuGrab_target[s__FuuGrab_instance], 10 * GetHeroLevel(s__FuuGrab_caster[s__FuuGrab_instance]), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
            call UnitDamageTarget(s__FuuGrab_caster[s__FuuGrab_instance], GetFilterUnit(), ( ( GetHeroAgi(s__FuuGrab_caster[s__FuuGrab_instance], true) ) / 2 ) * GetUnitAbilityLevel(s__FuuGrab_caster[s__FuuGrab_instance], s__FuuGrab_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
    endfunction

    function s__FuuGrab_jump takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__FuuGrab_caster[this])
        local real y= GetUnitY(s__FuuGrab_caster[this])
        local real angle= Atan3(x , y , s__FuuGrab_caster_x[this] , s__FuuGrab_caster_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 40)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 40)*1.0)) // INLINED!!
        local integer i
        local real offset
        call SetUnitX(s__FuuGrab_caster[this], new_x)
        call SetUnitY(s__FuuGrab_caster[this], new_y)
        call SetUnitFlyHeight(s__FuuGrab_caster[this], ParabolaZ(600 , s__FuuGrab_distance[this] , s__FuuGrab_distance[this] - GetDistance(new_x , new_y , s__FuuGrab_caster_x[this] , s__FuuGrab_caster_y[this])), 0)
        set new_x=(((GetUnitX(s__FuuGrab_caster[this]) )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 80)*1.0)) // INLINED!!
        set new_y=(((GetUnitY(s__FuuGrab_caster[this]) )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 80)*1.0)) // INLINED!!
        call SetUnitX(s__FuuGrab_target[this], new_x)
        call SetUnitY(s__FuuGrab_target[this], new_y)
        call SetUnitFlyHeight(s__FuuGrab_target[this], ParabolaZ(600 , s__FuuGrab_distance[this] , s__FuuGrab_distance[this] - GetDistance(new_x , new_y , s__FuuGrab_caster_x[this] , s__FuuGrab_caster_y[this])), 0)
        if GetDistance(x , y , s__FuuGrab_caster_x[this] , s__FuuGrab_caster_y[this]) < 100 then
            call PauseUnit(s__FuuGrab_caster[this], false)
            call SetUnitAnimation(s__FuuGrab_caster[this], "stand")
            call SetUnitTimeScale(s__FuuGrab_caster[this], 1.0)
            call SetUnitFlyHeight(s__FuuGrab_caster[this], 0, 0)
            call SetUnitFlyHeight(s__FuuGrab_target[this], 0, 0)

            call SetUnitAnimation(s__FuuGrab_target[this], "death")

            set bj_lastCreatedGroup=CreateGroup()
            set s__FuuGrab_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__FuuGrab_target[this]), GetUnitY(s__FuuGrab_target[this]), 200.0, Filter(function s__FuuGrab_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)

	        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack.mdx" ), (( GetUnitX(s__FuuGrab_target[this]) )*1.0), (( GetUnitY(s__FuuGrab_target[this]))*1.0))) // INLINED!!
            set i=0
            loop
                exitwhen i > 12
                set angle=( 360 / 12 ) * i
                set offset=100
                set x=GetUnitX(s__FuuGrab_caster[this]) + Cos(Deg2Rad(angle)) * offset
                set y=GetUnitY(s__FuuGrab_caster[this]) + Sin(Deg2Rad(angle)) * offset
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
            call s__FuuGrab_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__FuuGrab_periodic3 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle
        local real offset
        local integer i
        local real x
        local real y
        call SetUnitFlyHeight(s__FuuGrab_target[this], GetUnitFlyHeight(s__FuuGrab_target[this]) - 40, 0)
        call SetUnitFlyHeight(s__FuuGrab_caster[this], GetUnitFlyHeight(s__FuuGrab_caster[this]) - 40, 0)
        set s__FuuGrab_count[this]=s__FuuGrab_count[this] + 1
        if ( GetUnitFlyHeight(s__FuuGrab_caster[this]) <= 20.00 or s__FuuGrab_count[this] >= 15 ) then
            set bj_lastCreatedGroup=CreateGroup()
            set s__FuuGrab_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__FuuGrab_target[this]), GetUnitY(s__FuuGrab_target[this]), 200.0, Filter(function s__FuuGrab_dealDamage))
