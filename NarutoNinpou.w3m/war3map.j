    endfunction 

    function s__TobiramaHiraishingiri_end takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i= 0
        //call StunUnitTimed(this.caster, this.target, 2.0)
        call PauseUnit(s__TobiramaHiraishingiri_caster[this], false)
        //call PauseUnit(this.target, false)
        //call SetUnitAnimation(this.target, "death")
        call DestroyEffect(s__TobiramaHiraishingiri_sword[this])
        //call AddSpecialEffectEx("Units\\Undead\\Abomination\\AbominationExplosion.mdl", target_x, target_y)
        //call UnitDamageTarget(this.caster, this.target, 10.0 * GetHeroAgi(this.caster, true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        //set this.target = null
        set s__TobiramaHiraishingiri_sword[this]=null
        call DestroyGroup(s__TobiramaHiraishingiri_damaged[this])
        set s__TobiramaHiraishingiri_damaged[this]=null
	if s__TobiramaHiraishingiri_secondspell[this] then
		call UnitAddAbility(s__TobiramaHiraishingiri_caster[this], 'A0C2')
		call SetPlayerAbilityAvailable(GetOwningPlayer(s__TobiramaHiraishingiri_caster[this]), 'A0BQ', false)
		call TimerStart(NewTimerEx(this), 6.0, false, function s__TobiramaHiraishingiri_end2)
	else
        	call s__TobiramaHiraishingiri_deallocate(this)
	endif
	//set this.caster = null
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    
    
    function s__TobiramaHiraishingiri_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__TobiramaHiraishingiri_caster[this])
        local real y= GetUnitY(s__TobiramaHiraishingiri_caster[this])
        local real angle= Atan3(GetUnitX(s__TobiramaHiraishingiri_caster[this]) , GetUnitY(s__TobiramaHiraishingiri_caster[this]) , s__TobiramaHiraishingiri_target_x[this] , s__TobiramaHiraishingiri_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__TobiramaHiraishingiri_caster[this]) ), ( 'h02F' ), (( GetUnitX(s__TobiramaHiraishingiri_caster[this]) )*1.0), (( GetUnitY(s__TobiramaHiraishingiri_caster[this]) )*1.0), (( Rad2Deg(s__TobiramaHiraishingiri_angle[this]))*1.0))) // INLINED!!
        call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__TobiramaHiraishingiri_caster[this]))
        call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__TobiramaHiraishingiri_caster[this]))
        call SetUnitAnimation(bj_lastCreatedUnit, "spell throw")
        call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 175)
        call RecycleUnitDelayed(bj_lastCreatedUnit , 0.15)
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__TobiramaHiraishingiri_caster[this]) )*1.0), (( GetUnitY(s__TobiramaHiraishingiri_caster[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__TobiramaHiraishingiri_caster[this]) )*1.0), (( GetUnitY(s__TobiramaHiraishingiri_caster[this]))*1.0))) // INLINED!!
        call SetUnitX(s__TobiramaHiraishingiri_caster[this], new_x)
        call SetUnitY(s__TobiramaHiraishingiri_caster[this], new_y)
	set bj_lastCreatedGroup=CreateGroup()
	call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220.0, null)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TobiramaHiraishingiri_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__TobiramaHiraishingiri_damaged[this]) then
			if s__TobiramaHiraishingiri_spell[this] == 'A0BQ' then
				if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
					set s__TobiramaHiraishingiri_secondspell[this]=true
				endif
				call UnitDamageTarget(s__TobiramaHiraishingiri_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__TobiramaHiraishingiri_caster[this], true) * GetUnitAbilityLevel(s__TobiramaHiraishingiri_caster[this], s__TobiramaHiraishingiri_spell[this]), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
			else
				call UnitDamageTarget(s__TobiramaHiraishingiri_caster[this], bj_lastCreatedUnit, 50 * GetUnitAbilityLevel(s__TobiramaHiraishingiri_caster[this], 'A0BQ'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
				call StunUnitTimed(s__TobiramaHiraishingiri_caster[this] , bj_lastCreatedUnit , 1.0)
			endif
			if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
				call DestroyEffect(AddSpecialEffect(("Effects\\s_Hit.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
			endif
			call GroupAddUnit(s__TobiramaHiraishingiri_damaged[this], bj_lastCreatedUnit)
		endif
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
	set s__TobiramaHiraishingiri_count[this]=s__TobiramaHiraishingiri_count[this] + 1
        if GetDistance(new_x , new_y , s__TobiramaHiraishingiri_target_x[this] , s__TobiramaHiraishingiri_target_y[this]) <= 50 or s__TobiramaHiraishingiri_count[this] >= 20 then
            set s__TobiramaHiraishingiri_angle[this]=angle
            //call AddSpecialEffectEx("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", GetUnitX(this.target), GetUnitY(this.target))
            //call TimerStart(NewTimerEx(this), 0.03, true, function thistype.periodic2)
            call TimerStart(NewTimerEx(this), 0.1, false, function s__TobiramaHiraishingiri_end)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__TobiramaHiraishingiri_actions takes nothing returns nothing
        local integer this= s__TobiramaHiraishingiri_allocate()
        //if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then 
        //    call PlaySoundOnUnitBJ(gg_snd_TobiramaHiraishingiri, 100.0, GetTriggerUnit())
        //endif 
        set s__TobiramaHiraishingiri_caster[this]=GetTriggerUnit()
        //set this.target = GetSpellTargetUnit() 
        set s__TobiramaHiraishingiri_target_x[this]=GetSpellTargetX()
        set s__TobiramaHiraishingiri_target_y[this]=GetSpellTargetY()
        set s__TobiramaHiraishingiri_angle[this]=Atan3(GetUnitX(s__TobiramaHiraishingiri_caster[this]) , GetUnitY(s__TobiramaHiraishingiri_caster[this]) , s__TobiramaHiraishingiri_target_x[this] , s__TobiramaHiraishingiri_target_y[this])
	set s__TobiramaHiraishingiri_damaged[this]=CreateGroup()
        set s__TobiramaHiraishingiri_count[this]=0
        set s__TobiramaHiraishingiri_secondspell[this]=false
        call PauseUnit(s__TobiramaHiraishingiri_caster[this], true)
        //call PauseUnit(this.target, true)
        call SetUnitAnimation(s__TobiramaHiraishingiri_caster[this], "spell throw")
        set s__TobiramaHiraishingiri_sword[this]=AddSpecialEffectTarget("", s__TobiramaHiraishingiri_caster[this], "right hand")
        //if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then 
        //    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Tobirama: This is power of Hokage!!|r")
        //endif 
	set s__TobiramaHiraishingiri_spell[this]=GetSpellAbilityId()
        call TimerStart(NewTimerEx(this), 0.03, true, function s__TobiramaHiraishingiri_periodic)
    endfunction
    
    function s__TobiramaHiraishingiri_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(34 , 'A0BQ' , function s__TobiramaHiraishingiri_actions)
        call RegisterSpellEffectEventForId(34 , 'A0C2' , function s__TobiramaHiraishingiri_actions)
    endfunction
    
