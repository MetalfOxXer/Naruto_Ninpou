function Trig_KakashiSharinganCritical_Conditions takes nothing returns boolean
	return ( ( UnitHasBuffBJ(GetAttacker(), 'B02F') ) ) and ( ( GetRandomInt(1, 100) <= 15 ) ) and ( ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) ) )
endfunction

function Trig_KakashiSharinganCritical_Actions takes nothing returns nothing
	set udg_locations06[17]=GetUnitLoc(GetAttacker())
	set udg_locations06[18]=GetUnitLoc(GetTriggerUnit())
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=5
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations06[19]=PolarProjectionBJ(udg_locations06[17], ( 40.00 * I2R(bj_forLoopAIndex) ), AngleBetweenPoints(udg_locations06[17], udg_locations06[18]))
		if GetUnitTypeId(GetAttacker()) == 'h07A' then
			call CreateNUnitsAtLocFacingLocBJ(1, 'n01I', GetOwningPlayer(GetAttacker()), udg_locations06[19], udg_locations06[18])
		else
			call CreateNUnitsAtLocFacingLocBJ(1, 'noga', GetOwningPlayer(GetAttacker()), udg_locations06[19], udg_locations06[18])
		endif
		call SetUnitVertexColorBJEx(bj_lastCreatedUnit , 100 , 100 , 100 , 55.00)
		call SetUnitTimeScale(bj_lastCreatedUnit, 5.00)
		call SetUnitAnimation(bj_lastCreatedUnit, "attack")
		call UnitApplyTimedLifeBJ(0.20, 'BTLF', bj_lastCreatedUnit)
		call RemoveLocation(udg_locations06[19])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	set udg_locations06[19]=PolarProjectionBJ(udg_locations06[17], 200.00, AngleBetweenPoints(udg_locations06[17], udg_locations06[18]))
	call SetUnitX(GetAttacker(), GetLocationX(udg_locations06[19]))
	call SetUnitY(GetAttacker(), GetLocationY(udg_locations06[19]))
	call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), ( 100.00 + ( ( I2R(GetHeroStatBJ(1, GetAttacker(), true)) * 2.00 ) ) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
call AddSpecialEffectLocBJ((udg_locations06[18] ), ( "by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx")) // INLINED!!
	call DestroyEffect(bj_lastCreatedEffect)
	call RemoveLocation(udg_locations06[19])
	call RemoveLocation(udg_locations06[17])
	call RemoveLocation(udg_locations06[18])
endfunction

function Trig_KakashiSharinganEvasion_Conditions takes nothing returns boolean
	return ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B02F') ) ) and ( ( GetRandomInt(1, 100) <= ( 4 + GetUnitAbilityLevelSwapped('A01B', GetTriggerUnit()) ) ) )
endfunction

function Trig_KakashiSharinganEvasion_Actions takes nothing returns nothing
	set udg_locations03[503]=GetUnitLoc(GetTriggerUnit())
	if GetUnitTypeId(GetTriggerUnit()) == 'H07A' then
		call CreateNUnitsAtLoc(1, 'n01I', GetOwningPlayer(GetTriggerUnit()), udg_locations03[503], GetUnitFacing(GetTriggerUnit()))
	else
		call CreateNUnitsAtLoc(1, 'noga', GetOwningPlayer(GetTriggerUnit()), udg_locations03[503], GetUnitFacing(GetTriggerUnit()))
	endif
	call UnitApplyTimedLifeBJ(0.10, 'BTLF', bj_lastCreatedUnit)
	call SetUnitVertexColorBJEx(bj_lastCreatedUnit , 100 , 100 , 100 , 55.00)
	call SetUnitTimeScale(bj_lastCreatedUnit, 3.00)
	call SetUnitAnimation(bj_lastCreatedUnit, "death")
	call SetWidgetLife(GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetEventDamage() * 0.35 ) ))
endfunction

function InitTrig_KakashiSharingan takes nothing returns nothing
	set udg_trigger96=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger96, EVENT_PLAYER_UNIT_ATTACKED)
	call TriggerAddCondition(udg_trigger96, Condition(function Trig_KakashiSharinganCritical_Conditions))
	call TriggerAddAction(udg_trigger96, function Trig_KakashiSharinganCritical_Actions)
        //call EnableTriggerForId(11, udg_trigger96)
	//set udg_trigger97=CreateTrigger()
	//call TriggerRegisterUnitEvent(udg_trigger97,udg_unit71,EVENT_UNIT_DAMAGED)
	//call TriggerAddCondition(udg_trigger97,Condition(function Trig_KakashiSharinganEvasion_Conditions))
	//call TriggerAddAction(udg_trigger97,function Trig_KakashiSharinganEvasion_Actions)
        //call EnableTriggerForId(11, udg_trigger97)
endfunction 

//===========================================================================
// Trigger: KakashiRaijuu GaiHirudora
//===========================================================================

function Trig_KakashiRaijuu_GaiHirudora_Conditions takes nothing returns boolean
	return ( ( ( GetSpellAbilityId() == 'A01T' ) ) and ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B00H') ) ) ) or ( GetSpellAbilityId() == 'A15Y' )
endfunction

function Trig_KakashiRaijuu_GaiHirudora_Actions takes nothing returns nothing
	if GetSpellAbilityId() == 'A15Y' then
		set udg_IsKakashi=true
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
			call PlaySoundOnUnitBJ(gg_snd_Kakashi_Anbu_R, 100.0, GetTriggerUnit())
		endif
	else
		set udg_IsKakashi=false
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
			call PlaySoundOnUnitBJ(gg_snd_Gai_T, 100.0, GetTriggerUnit())
		endif
	endif
	set udg_units31[130]=GetTriggerUnit()
	set udg_units31[131]=GetSpellTargetUnit()
    if udg_units31[131] == null then
        set udg_units31[131]=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'e007', GetSpellTargetX(), GetSpellTargetY(), 270)
    endif
	set udg_locations03[506]=GetUnitLoc(GetTriggerUnit())
	if udg_IsKakashi then
		call CreateNUnitsAtLoc(1, 'o005', GetOwningPlayer(GetTriggerUnit()), udg_locations03[506], GetUnitFacing(GetTriggerUnit()))
		call SetUnitAnimationByIndex(bj_lastCreatedUnit, 0)
		//call SetUnitAnimation(bj_lastCreatedUnit,"walk")
		call SetUnitTimeScalePercent(bj_lastCreatedUnit, 300.00)
		//call SetUnitVertexColorBJEx(bj_lastCreatedUnit,255,255,255,50.00)
		call SetUnitColor(bj_lastCreatedUnit, ConvertPlayerColor(12))
	else
		call CreateNUnitsAtLoc(1, 'o00C', GetOwningPlayer(GetTriggerUnit()), udg_locations03[506], GetUnitFacing(GetTriggerUnit()))
		call SetUnitTimeScale(bj_lastCreatedUnit, 2.0)
		call SetUnitAnimation(bj_lastCreatedUnit, "stand channel")
	endif
	set udg_units31[132]=bj_lastCreatedUnit
	call RemoveLocation(udg_locations03[506])
	call EnableTrigger(udg_trigger105)
	call TriggerSleepAction(0.10)
	set udg_booleans01[130]=true
	//call SetUnitTimeScalePercent(udg_units31[132],50.00)
	//call SetUnitAnimation(udg_units31[132],"Stand Channel")
	call TriggerSleepAction(0.20)
	set udg_booleans01[131]=true
endfunction

function Trig_KakashiRaijuu_2_Func001Func001Func001Func004002003001 takes nothing returns boolean
	return ( IsUnitDeadBJ(GetFilterUnit()) == false )
endfunction

function Trig_KakashiRaijuu_2_Func001Func001Func001Func004002003002 takes nothing returns boolean
	return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_units31[130])) )
endfunction

function Trig_KakashiRaijuu_2_Func001Func001Func001Func004002003 takes nothing returns boolean
	return GetBooleanAnd(( IsUnitDeadBJ(GetFilterUnit()) == false ), ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_units31[130])) ))
endfunction

function Trig_KakashiRaijuu_2_Func001Func001Func001Func005A takes nothing returns nothing
	if udg_IsKakashi then
		call UnitDamageTarget(udg_units31[130], GetEnumUnit(), ( 700 + 4 * GetHeroAgi(udg_units31[130], true) ) * GetUnitAbilityLevel(udg_units31[130], 'A15Y'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
	else
		call UnitDamageTarget(udg_units31[130], GetEnumUnit(), ( ( I2R(GetHeroStatBJ(0, udg_units31[130], true)) * 11.00 ) + ( 0.00 * I2R(GetUnitAbilityLevelSwapped('ANfl', udg_units31[130])) ) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
	endif
endfunction

function Trig_KakashiRaijuu_2_Func001Func001Func001C takes nothing returns boolean
	return ( ( DistanceBetweenPoints(GetUnitLoc(udg_units31[132]), GetUnitLoc(udg_units31[131])) <= 50.00 ) )
endfunction

function Trig_KakashiRaijuu_2_Func001Func001C takes nothing returns boolean
	return ( ( udg_booleans01[131] == false ) )
endfunction

function Trig_KakashiRaijuu_2_Func001C takes nothing returns boolean
	return ( ( udg_booleans01[130] == false ) )
endfunction

function Trig_KakashiRaijuu_2_Actions takes nothing returns nothing
	if ( ( udg_booleans01[130] == false ) ) then
		set udg_locations03[506]=GetUnitLoc(udg_units31[132])
		set udg_locations03[508]=GetUnitLoc(udg_units31[131])
		set udg_locations03[507]=PolarProjectionBJ(udg_locations03[506], 22.00, GetUnitFacing(udg_units31[132]))
		call SetUnitPositionLocFacingBJ(udg_units31[132], udg_locations03[507], ( GetUnitFacing(udg_units31[132]) + 8.00 ))
		if udg_IsKakashi then
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx")) // INLINED!!
		else
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")) // INLINED!!
		endif
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations03[506])
		call RemoveLocation(udg_locations03[507])
		call RemoveLocation(udg_locations03[508])
	else
		if ( ( udg_booleans01[131] == false ) ) then
			set udg_locations03[506]=GetUnitLoc(udg_units31[132])
			set udg_locations03[508]=GetUnitLoc(udg_units31[131])
			set udg_locations03[507]=PolarProjectionBJ(udg_locations03[506], 22.00, GetUnitFacing(udg_units31[132]))
			call SetUnitPositionLocFacingBJ(udg_units31[132], udg_locations03[507], ( GetUnitFacing(udg_units31[132]) - 8.00 ))
			if udg_IsKakashi then
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx")) // INLINED!!
			else
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")) // INLINED!!
			endif
			call DestroyEffect(bj_lastCreatedEffect)
			call RemoveLocation(udg_locations03[506])
			call RemoveLocation(udg_locations03[507])
			call RemoveLocation(udg_locations03[508])
		else
			if ( ( DistanceBetweenPoints(GetUnitLoc(udg_units31[132]), GetUnitLoc(udg_units31[131])) <= 50.00 ) ) then
				call DisableTrigger(GetTriggeringTrigger())
				set udg_locations03[508]=GetUnitLoc(udg_units31[131])
				set bj_forLoopAIndex=1
				set bj_forLoopAIndexEnd=10
				loop
					exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
					if udg_IsKakashi then
						if bj_forLoopAIndex < 2 then
							call CreateNUnitsAtLoc(1, 'nser', GetOwningPlayer(udg_units31[130]), udg_locations03[508], GetRandomReal(0, 360))
							call SetUnitTimeScalePercent(bj_lastCreatedUnit, ( 80.00 + ( 3.00 * I2R(bj_forLoopAIndex) ) ))
							call SetUnitScale(bj_lastCreatedUnit, 1.2, 0, 0)
							call KillUnit(bj_lastCreatedUnit)
						endif
					else
						call CreateNUnitsAtLoc(1, 'o003', GetOwningPlayer(udg_units31[130]), udg_locations03[508], GetRandomReal(0, 360))
						call UnitApplyTimedLifeBJ(3.00, 'BTLF', bj_lastCreatedUnit)
						call SetUnitTimeScalePercent(bj_lastCreatedUnit, ( 40.00 + ( 3.00 * I2R(bj_forLoopAIndex) ) ))
						call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
					endif
					set bj_forLoopAIndex=bj_forLoopAIndex + 1
				endloop
				set udg_groups02[130]=GetUnitsInRangeOfLocMatching(300.00, udg_locations03[508], Condition(function Trig_KakashiRaijuu_2_Func001Func001Func001Func004002003))
				call ForGroupBJ(udg_groups02[130], function Trig_KakashiRaijuu_2_Func001Func001Func001Func005A)
				call RemoveLocation(udg_locations03[508])
				call GroupClear(udg_groups02[130])
				set udg_booleans01[130]=false
				set udg_booleans01[131]=false
				call RemoveUnit(udg_units31[132])
			else
				set udg_locations03[506]=GetUnitLoc(udg_units31[132])
				set udg_locations03[508]=GetUnitLoc(udg_units31[131])
				set udg_locations03[507]=PolarProjectionBJ(udg_locations03[506], 30.00, AngleBetweenPoints(udg_locations03[506], udg_locations03[508]))
				call SetUnitX(udg_units31[132], GetLocationX(udg_locations03[507]))
				call SetUnitY(udg_units31[132], GetLocationY(udg_locations03[507]))
				call SetUnitFacing(udg_units31[132], AngleBetweenPoints(udg_locations03[506], udg_locations03[508]))
				if udg_IsKakashi then
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdx")) // INLINED!!
				else
call AddSpecialEffectLocBJ((udg_locations03[507] ), ( "Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl")) // INLINED!!
				endif
				call DestroyEffect(bj_lastCreatedEffect)
				call RemoveLocation(udg_locations03[506])
				call RemoveLocation(udg_locations03[507])
				call RemoveLocation(udg_locations03[508])
			endif
		endif
	endif
endfunction

function InitTrig_KakashiRaijuu_GaiHirudora takes nothing returns nothing
	set udg_trigger104=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger104, EVENT_PLAYER_UNIT_SPELL_EFFECT)
	call TriggerAddCondition(udg_trigger104, Condition(function Trig_KakashiRaijuu_GaiHirudora_Conditions))
	call TriggerAddAction(udg_trigger104, function Trig_KakashiRaijuu_GaiHirudora_Actions)
	set udg_trigger105=CreateTrigger()
	call DisableTrigger(udg_trigger105)
	call TriggerRegisterTimerEventPeriodic(udg_trigger105, 0.02)
	call TriggerAddAction(udg_trigger105, function Trig_KakashiRaijuu_2_Actions)
endfunction 

