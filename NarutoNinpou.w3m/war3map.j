                    call PlaySoundOnUnitBJ(gg_snd_Sage_Kabuto_Kill, 175.0, GetTriggerUnit())
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffdf80ffKabuto: I am perfection. and I never lose.|r")
                                	

