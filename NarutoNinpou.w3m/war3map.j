 function s__YugitoJump_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__YugitoJump_caster[this])
  local real y= GetUnitY(s__YugitoJump_caster[this])
  local real angle= Atan3(x , y , s__YugitoJump_target_x[this] , s__YugitoJump_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_dist= GetDistance(new_x , new_y , s__YugitoJump_target_x[this] , s__YugitoJump_target_y[this])
  local integer i
  local integer j
		call SetUnitX(s__YugitoJump_caster[this], new_x)
		call SetUnitY(s__YugitoJump_caster[this], new_y)
		call SetUnitFlyHeight(s__YugitoJump_caster[this], Parabola(0 , 0 , 300 , s__YugitoJump_dist[this] , 50 * s__YugitoJump_count[this]), 0)
		call SetUnitFacing(s__YugitoJump_caster[this], Rad2Deg(angle))
		set s__YugitoJump_count[this]=s__YugitoJump_count[this] + 1
		set s__YugitoJump_count2[this]=s__YugitoJump_count2[this] + 1
		if new_dist < 50 or s__YugitoJump_count2[this] >= 20 then
			set i=0
			loop
				exitwhen i > 2
				set j=0
				loop
					exitwhen j > 5
					set x=(((new_x )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					set y=(((new_y )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 75 * ( i + 1 ))*1.0)) // INLINED!!
					call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
					set j=j + 1
				endloop
				set i=i + 1
			endloop
			set bj_lastCreatedGroup=CreateGroup()
			set s__YugitoJump_instance=this
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__YugitoJump_target_x[this], s__YugitoJump_target_y[this], 300, Filter(function s__YugitoJump_dealDamage))
			call DestroyGroup(bj_lastCreatedGroup)
			call SlowArea(s__YugitoJump_caster[this] , s__YugitoJump_target_x[this] , s__YugitoJump_target_y[this] , 300)
			call SetUnitFlyHeight(s__YugitoJump_caster[this], 0, 0)
			call PauseUnit(s__YugitoJump_caster[this], false)
			call SetUnitTimeScale(s__YugitoJump_caster[this], 1.0)
			call s__YugitoJump_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__YugitoJump_actions takes nothing returns nothing
  local integer this= s__YugitoJump_allocate()
  local real x
  local real y
  local real x1
  local real y1
  local real angle
		set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
		set x=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
		set y=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
		set x1=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
		set y1=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
		set s__YugitoJump_jump[this]=false
		if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
			set s__YugitoJump_target_x[this]=GetSpellTargetX()
			set s__YugitoJump_target_y[this]=GetSpellTargetY()
			set s__YugitoJump_jump[this]=true
		elseif not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
			set s__YugitoJump_target_x[this]=x
			set s__YugitoJump_target_y[this]=y
			set s__YugitoJump_jump[this]=true
		elseif not IsTerrainPathable(x1, y1, PATHING_TYPE_WALKABILITY) then
			set s__YugitoJump_target_x[this]=x1
			set s__YugitoJump_target_y[this]=y1
			set s__YugitoJump_jump[this]=true
		endif
		if s__YugitoJump_jump[this] then
			set s__YugitoJump_caster[this]=GetTriggerUnit()
			set s__YugitoJump_dist[this]=GetDistance(GetUnitX(s__YugitoJump_caster[this]) , GetUnitY(s__YugitoJump_caster[this]) , s__YugitoJump_target_x[this] , s__YugitoJump_target_y[this])
			set s__YugitoJump_first[this]=GetSpellAbilityId() == s__YugitoJump_SPELL_ID
			call PauseUnit(s__YugitoJump_caster[this], true)
			call SetUnitAnimationByIndex(s__YugitoJump_caster[this], 5)
			call SetUnitTimeScale(s__YugitoJump_caster[this], 1.7)
			set s__YugitoJump_count[this]=0
			set s__YugitoJump_count2[this]=0
			call UnitAddAbility(s__YugitoJump_caster[this], 'Arav')
			call UnitRemoveAbility(s__YugitoJump_caster[this], 'Arav')
			call TimerStart(NewTimerEx(this), 0.035, true, function s__YugitoJump_periodic)
		else
			call IssueImmediateOrder(GetTriggerUnit(), "stop")
			call BlzStartUnitAbilityCooldown(GetTriggerUnit(), 'A0ND', ( 13 + GetUnitAbilityLevel(GetTriggerUnit(), s__YugitoJump_SPELL_ID) * 0.33 ) / 2)
			call s__YugitoJump_deallocate(this)
		endif
 endfunction 

 function s__YugitoJump_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(79 , s__YugitoJump_SPELL_ID , function s__YugitoJump_actions)
		call RegisterSpellEffectEventForId(79 , s__YugitoJump_SPELL_ID2 , function s__YugitoJump_actions)
 endfunction 

