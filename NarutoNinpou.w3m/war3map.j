				exitwhen GetDistance(GetUnitX(s__JuugoW___JuugoW_caster[this]) , GetUnitY(s__JuugoW___JuugoW_caster[this]) , GetUnitX(s__JuugoW___JuugoW_target[this]) , GetUnitY(s__JuugoW___JuugoW_target[this])) < 100 or count2 == 1000
