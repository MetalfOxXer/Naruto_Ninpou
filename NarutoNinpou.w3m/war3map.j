//===========================================================================
// Trigger: FixTransformations
//===========================================================================
    
//Implemented from module Alloc:
    
        function s__FixTransformations_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__FixTransformations_Alloc___recycle[(0)] == 0 ) then
                set s__FixTransformations_Alloc___instanceCount=s__FixTransformations_Alloc___instanceCount + 1
                set this=s__FixTransformations_Alloc___instanceCount
            else
                set this=s__FixTransformations_Alloc___recycle[(0)]
                set s__FixTransformations_Alloc___recycle[(0)]=s__FixTransformations_Alloc___recycle[s__FixTransformations_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__FixTransformations_deallocate takes integer this returns nothing
            set s__FixTransformations_Alloc___recycle[this]=s__FixTransformations_Alloc___recycle[(0)]
            set s__FixTransformations_Alloc___recycle[(0)]=this
        endfunction

    function s__FixTransformations_removeInvul takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if GetUnitTypeId(s__FixTransformations_caster[this]) == 'N00U' or GetUnitTypeId(s__FixTransformations_caster[this]) == 'N01C' and s__FixTransformations_tatsumaki[this] then
		call BlzSetUnitSkin(s__FixTransformations_caster[this], 'h05H')
	endif
        if GetUnitTypeId(s__FixTransformations_caster[this]) == 'E01C' or GetUnitTypeId(s__FixTransformations_caster[this]) == 'E07G' and s__FixTransformations_raikage[this] then
		call BlzSetUnitSkin(s__FixTransformations_caster[this], 'h0BG')
	endif
        call s__FixTransformations_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__FixTransformations_actions takes nothing returns nothing
        local integer this= s__FixTransformations_allocate()
        set s__FixTransformations_caster[this]=GetTriggerUnit()
        set s__FixTransformations_tatsumaki[this]=false
	set s__FixTransformations_raikage[this]=false
        if BlzGetUnitSkin(s__FixTransformations_caster[this]) == 'h05H' then
		set s__FixTransformations_tatsumaki[this]=true
	endif
	if BlzGetUnitSkin(s__FixTransformations_caster[this]) == 'h0BG' then
		set s__FixTransformations_raikage[this]=true
	endif
        call UnitRemoveBuffs(GetTriggerUnit(), false, true)
        call TimerStartEx(NewTimerEx(this) , 0.01 , false , function s__FixTransformations_removeInvul , "FixTransformations.removeInvul")
    endfunction 

