//===========================================================================
// Trigger: SasoriPuppet
//===========================================================================

function Trig_SasoriPuppet_Conditions takes nothing returns boolean
	return ( ( GetUnitTypeId(GetAttacker()) == 'uloc' ) ) or ( ( GetUnitTypeId(GetAttacker()) == 'u00L' ) ) or ( ( GetUnitTypeId(GetAttacker()) == 'u00V' ) )
endfunction

function Trig_SasoriPuppet_Actions takes nothing returns nothing
 local real damage
 local real x
 local real y
 local real x1
 local real y1
 local real new_x
 local real new_y
 local real new_x1
 local real new_y1
	if not IsUnitIllusion(GetAttacker()) then
		set x1=GetUnitX(GetAttacker())
		set y1=GetUnitY(GetAttacker())
		set x=GetUnitX(GetTriggerUnit())
		set y=GetUnitY(GetTriggerUnit())
		set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( 75)*1.0)) // INLINED!!
		set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( 75)*1.0)) // INLINED!!
		set new_x1=(((x1 )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( 500)*1.0)) // INLINED!!
		set new_y1=(((y1 )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( 500)*1.0)) // INLINED!!
		call SetUnitX(GetAttacker(), new_x)
		call SetUnitY(GetAttacker(), new_y)
		if GetRandomInt(0, 3) == 1 then
			call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		endif
		if ( GetUnitTypeId(GetTriggerUnit()) == 'hfoo' or GetUnitTypeId(GetTriggerUnit()) == 'h01A' or GetUnitTypeId(GetTriggerUnit()) == 'e017' or GetUnitTypeId(GetTriggerUnit()) == 'ndth' or GetUnitTypeId(GetTriggerUnit()) == 'otau' or GetUnitTypeId(GetTriggerUnit()) == 'h01B' or GetUnitTypeId(GetTriggerUnit()) == 'h01J' or GetUnitTypeId(GetTriggerUnit()) == 'earc' or GetUnitTypeId(GetTriggerUnit()) == 'ogru' or GetUnitTypeId(GetTriggerUnit()) == 'h026' or GetUnitTypeId(GetTriggerUnit()) == 'h027' or GetUnitTypeId(GetTriggerUnit()) == 'e018' or GetUnitTypeId(GetTriggerUnit()) == 'orai' ) then
			call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
		else
			if GetUnitTypeId(GetAttacker()) == 'u00L' then
				call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 300.00, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			elseif GetUnitTypeId(GetAttacker()) == 'u00V' then
				call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 115.00, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			elseif ( GetUnitTypeId(GetAttacker()) == 'uloc' and GetUnitTypeId(udg_units33[GetPlayerId(GetOwningPlayer(GetAttacker())) + 1]) == 'E02E' ) then
				call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), GetHeroStr(udg_units33[GetPlayerId(GetOwningPlayer(GetAttacker())) + 1], true) / 6, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			else
				call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), 75.00, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			endif
		endif
		call TriggerSleepAction(0.05)
		call SetUnitX(GetAttacker(), new_x1)
		call SetUnitY(GetAttacker(), new_y1)
	endif
endfunction

function InitTrig_SasoriPuppet takes nothing returns nothing
	set udg_trigger299=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger299, EVENT_PLAYER_UNIT_ATTACKED)
	call TriggerAddCondition(udg_trigger299, Condition(function Trig_SasoriPuppet_Conditions))
	call TriggerAddAction(udg_trigger299, function Trig_SasoriPuppet_Actions)
endfunction 

