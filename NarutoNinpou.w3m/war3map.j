  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i= 0
  local integer j
  local real x
                local real y
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack Big.mdx" ), (( GetUnitX(s__KimimaroTessenka_caster[this]) )*1.0), (( GetUnitY(s__KimimaroTessenka_caster[this]))*1.0))) // INLINED!!
		loop
			exitwhen i > 3
			set i=i + 1
			set j=0
			loop
				exitwhen j > 10
				set j=j + 1
				set x=(((GetUnitX(s__KimimaroTessenka_caster[this]) )*1.0) + Cos((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
				set y=(((GetUnitY(s__KimimaroTessenka_caster[this]) )*1.0) + Sin((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
				//call AddSpecialEffectEx("Effects\\s_Earth_Smash.mdl", x, y)
			endloop
		endloop

			set bj_lastCreatedGroup=CreateGroup()
			set s__KimimaroTessenka_instance=this
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KimimaroTessenka_caster[this]), GetUnitY(s__KimimaroTessenka_caster[this]), 400, Filter(function s__KimimaroTessenka_dealDamage))
			call DestroyGroup(bj_lastCreatedGroup)

			call TimerStart(NewTimerEx(this), 0.1, false, function s__KimimaroTessenka_finish)
		call ReleaseTimer(GetExpiredTimer())
