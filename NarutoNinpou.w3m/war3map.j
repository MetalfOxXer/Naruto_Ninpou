        function s__TentenTensasai__Spell_actions takes nothing returns nothing
            local integer this= s__TentenTensasai__Spell_allocate()
            set s__TentenTensasai__Spell_caster[this]=GetTriggerUnit()
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Tenten_T, 100.0, GetTriggerUnit())
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Tenten: Watch out the steel rain!|r")
            endif
            set s__TentenTensasai__Spell_target_x[this]=GetSpellTargetX()
