 function s__MechaNarutoFlyMode_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__MechaNarutoFlyMode_caster[this])
  local real y= GetUnitY(s__MechaNarutoFlyMode_caster[this])
  local real angle= Atan3(x , y , s__MechaNarutoFlyMode_target_x[this] , s__MechaNarutoFlyMode_target_y[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
