    function s__RingoSilentKilling_actions takes nothing returns nothing
        local integer this= s__RingoSilentKilling_allocate()
 local real angle
 local real x
 local real y
 local real x1
 local real y1
        set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
	set x=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
	set y=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
	set x1=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
	set y1=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( 150)*1.0)) // INLINED!!
	set s__RingoSilentKilling_jump[this]=false
	if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
		set s__RingoSilentKilling_target_x[this]=GetSpellTargetX()
		set s__RingoSilentKilling_target_y[this]=GetSpellTargetY()
		set s__RingoSilentKilling_jump[this]=true
	elseif not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
		set s__RingoSilentKilling_target_x[this]=x
		set s__RingoSilentKilling_target_y[this]=y
		set s__RingoSilentKilling_jump[this]=true
	elseif not IsTerrainPathable(x1, y1, PATHING_TYPE_WALKABILITY) then
		set s__RingoSilentKilling_target_x[this]=x1
		set s__RingoSilentKilling_target_y[this]=y1
		set s__RingoSilentKilling_jump[this]=true
        else
            set s__RingoSilentKilling_target_x[this]=GetUnitX(GetTriggerUnit())
            set s__RingoSilentKilling_target_y[this]=GetUnitY(GetTriggerUnit())
	endif
        set s__RingoSilentKilling_caster[this]=GetTriggerUnit()
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__RingoSilentKilling_caster[this]) )*1.0), (( GetUnitY(s__RingoSilentKilling_caster[this]))*1.0))) // INLINED!!
        call PauseUnit(s__RingoSilentKilling_caster[this], true)
        call ShowUnit(s__RingoSilentKilling_caster[this], false)
        call TimerStart(NewTimerEx(this), 0.5, false, function s__RingoSilentKilling_finish)
    endfunction 

