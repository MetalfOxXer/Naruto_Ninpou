        function s__HagoromoTW_create takes unit caster returns integer
            local integer this= s__HagoromoTW_allocate()
            local real targetX= GetSpellTargetX()
            local real targetY= GetSpellTargetY()
            local integer i= 0
        
            set s__HagoromoTW_caster[this]=caster
            set s__HagoromoTW_casterX[this]=GetUnitX(caster)
            set s__HagoromoTW_casterY[this]=GetUnitY(caster)
            set s__HagoromoTW_targetX[this]=targetX
            set s__HagoromoTW_targetY[this]=targetY
            set s__HagoromoTW_angle[this]=Atan2(targetY - s__HagoromoTW_casterY[this], targetX - s__HagoromoTW_casterX[this])
            set s__HagoromoTW_distance[this]=0
            set s__HagoromoTW_lifeTime[this]=0
        
            set s__HagoromoTW_affectedUnits[this]=CreateGroup()
        
            call SetUnitAnimationByIndex(s__HagoromoTW_caster[this], 45)
            set s__HagoromoTW_storm[this]=CreateUnit(GetOwningPlayer(s__HagoromoTW_caster[this]), 'h08O', s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this], Rad2Deg(s__HagoromoTW_angle[this]))
            set s__HagoromoTW_stormWallEffect[this]=AddSpecialEffect(StormReleaseTempestSurge__SEGMENT_EFFECT_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectMatrixScale(s__HagoromoTW_stormWallEffect[this], 2.00, 2.00, 1.5)
            set s__HagoromoTW_electricOrb1[this]=AddSpecialEffect(StormReleaseTempestSurge__ELECTRICAL_ORB_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectScale(s__HagoromoTW_electricOrb1[this], 2.0)
            set s__HagoromoTW_electricOrb2[this]=AddSpecialEffect(StormReleaseTempestSurge__ELECTRICAL_ORB_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectScale(s__HagoromoTW_electricOrb2[this], 2.0)
            set s__HagoromoTW_electricOrb3[this]=AddSpecialEffect(StormReleaseTempestSurge__ELECTRICAL_ORB_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectScale(s__HagoromoTW_electricOrb3[this], 2.0)
            set s__HagoromoTW_electricOrb4[this]=AddSpecialEffect(StormReleaseTempestSurge__ELECTRICAL_ORB_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectScale(s__HagoromoTW_electricOrb4[this], 2.0)
        
            set s__HagoromoTW_stormTimer[this]=NewTimerEx(this)
            call TimerStart(s__HagoromoTW_stormTimer[this], StormReleaseTempestSurge__TIMER_INTERVAL, true, function sc__HagoromoTW_periodic)
            return this
        endfunction        

        function s__HagoromoTW_destroy takes integer this returns nothing
            local integer i= 0
        
            call DestroyEffect(s__HagoromoTW_stormWallEffect[this])
            call DestroyEffect(s__HagoromoTW_electricOrb1[this])
            call DestroyEffect(s__HagoromoTW_electricOrb2[this])
            call DestroyEffect(s__HagoromoTW_electricOrb3[this])
            call DestroyEffect(s__HagoromoTW_electricOrb4[this])
            call DestroyEffect(s__HagoromoTW_electricExplosion[this])
            call RemoveUnit(s__HagoromoTW_storm[this])
        
            call ReleaseTimer(s__HagoromoTW_stormTimer[this])
        
            call GroupClear(s__HagoromoTW_affectedUnits[this])
            call DestroyGroup(s__HagoromoTW_affectedUnits[this])
        
            call FlushChildHashtable(StormReleaseTempestSurge__damageReceived, GetHandleId(s__HagoromoTW_caster[this]))
            call s__HagoromoTW_deallocate(this)
        endfunction        

        function s__HagoromoTW_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x
            local real y
            local real z
            local real currentAngle
            local real terrainZ
            local integer i= 0
            local real angleOffset
            local real normalizedTime
            local location loc
        
            set s__HagoromoTW_lifeTime[this]=s__HagoromoTW_lifeTime[this] + StormReleaseTempestSurge__TIMER_INTERVAL
            if s__HagoromoTW_lifeTime[this] >= StormReleaseTempestSurge__SEGMENT_DURATION then
                call sc__HagoromoTW_explosionDamage(this)
                call s__HagoromoTW_destroy(this)
                return
            endif
        
            set s__HagoromoTW_casterX[this]=s__HagoromoTW_casterX[this] + StormReleaseTempestSurge__SEGMENT_SPEED * Cos(s__HagoromoTW_angle[this]) * StormReleaseTempestSurge__TIMER_INTERVAL
            set s__HagoromoTW_casterY[this]=s__HagoromoTW_casterY[this] + StormReleaseTempestSurge__SEGMENT_SPEED * Sin(s__HagoromoTW_angle[this]) * StormReleaseTempestSurge__TIMER_INTERVAL
        
            call SetUnitX(s__HagoromoTW_storm[this], s__HagoromoTW_casterX[this])
            call SetUnitY(s__HagoromoTW_storm[this], s__HagoromoTW_casterY[this])
        
            set loc=Location(s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            set terrainZ=GetLocationZ(loc)
            call RemoveLocation(loc)
        
            call BlzSetSpecialEffectPosition(s__HagoromoTW_stormWallEffect[this], s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this], terrainZ)
        
            set i=0
            loop
                exitwhen i >= StormReleaseTempestSurge__ORB_COUNT
            
                set angleOffset=i * ( 2 * bj_PI / StormReleaseTempestSurge__ORB_COUNT )
                set currentAngle=s__HagoromoTW_angle[this] + angleOffset + s__HagoromoTW_lifeTime[this] * StormReleaseTempestSurge__ORB_ROTATION_SPEED
            
                set x=s__HagoromoTW_casterX[this] + ( StormReleaseTempestSurge__ORB_INITIAL_RADIUS * ( 1 - ( s__HagoromoTW_lifeTime[this] / StormReleaseTempestSurge__SEGMENT_DURATION ) ) ) * Cos(currentAngle)
                set y=s__HagoromoTW_casterY[this] + ( StormReleaseTempestSurge__ORB_INITIAL_RADIUS * ( 1 - ( s__HagoromoTW_lifeTime[this] / StormReleaseTempestSurge__SEGMENT_DURATION ) ) ) * Sin(currentAngle)
            
                set loc=Location(x, y)
                set terrainZ=GetLocationZ(loc)
                call RemoveLocation(loc)
            
                set normalizedTime=s__HagoromoTW_lifeTime[this] / StormReleaseTempestSurge__SEGMENT_DURATION
            
                set z=terrainZ + StormReleaseTempestSurge__ORB_VERTICAL_ARC_HEIGHT * 4 * normalizedTime * ( 1 - normalizedTime )
            
                if i == 0 then
                    call BlzSetSpecialEffectPosition(s__HagoromoTW_electricOrb1[this], x, y, z)
                elseif i == 1 then
                    call BlzSetSpecialEffectPosition(s__HagoromoTW_electricOrb2[this], x, y, z)
                elseif i == 2 then
                    call BlzSetSpecialEffectPosition(s__HagoromoTW_electricOrb3[this], x, y, z)
                elseif i == 3 then
                    call BlzSetSpecialEffectPosition(s__HagoromoTW_electricOrb4[this], x, y, z)
                endif
            
                set i=i + 1
            endloop
        
            call sc__HagoromoTW_pullUnits(this)
        endfunction

        function s__HagoromoTW_explosionDamage takes integer this returns nothing
            local real primaryAttribute= GetHeroInt(s__HagoromoTW_caster[this], true)
            local real baseDamage= 500 + ( primaryAttribute * ( GetHeroLevel(s__HagoromoTW_caster[this]) / 10.0 ) )
            local real explosionDamage= baseDamage * StormReleaseTempestSurge__EXPLOSION_DAMAGE_PERCENT
            local real totalDamage
            local unit u
         local location loc
         local real terrainZ

    	    set loc=Location(s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
    	    set terrainZ=GetLocationZ(loc)
    	    call RemoveLocation(loc)

            set s__HagoromoTW_electricExplosion[this]=AddSpecialEffect(StormReleaseTempestSurge__ELECTRICAL_EXPLOSION_MODEL, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this])
            call BlzSetSpecialEffectPosition(s__HagoromoTW_electricExplosion[this], s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this], terrainZ + 200)
            call GroupEnumUnitsInRange(StormReleaseTempestSurge__tempGroup, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this], StormReleaseTempestSurge__EYE_RADIUS * 3, null)
            loop
                set u=FirstOfGroup(StormReleaseTempestSurge__tempGroup)
                exitwhen u == null

                if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoTW_caster[this])) then
                    set totalDamage=LoadReal(StormReleaseTempestSurge__damageReceived, GetHandleId(u), 0)

                    if totalDamage < baseDamage * 0.25 then
                        call UnitDamageTarget(s__HagoromoTW_caster[this], u, baseDamage * 1.25, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    else
                        call UnitDamageTarget(s__HagoromoTW_caster[this], u, explosionDamage + ( baseDamage - totalDamage ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
                endif
                call GroupRemoveUnit(StormReleaseTempestSurge__tempGroup, u)
            endloop
        endfunction

        function s__HagoromoTW_pullUnits takes integer this returns nothing
            local unit pulledUnit
            local real unitX
            local real unitY
            local real angle
            local real distance
            local real pullX
            local real pullY

            call GroupEnumUnitsInRange(StormReleaseTempestSurge__tempGroup, s__HagoromoTW_casterX[this], s__HagoromoTW_casterY[this], StormReleaseTempestSurge__PULL_RADIUS, null)

            loop
                set pulledUnit=FirstOfGroup(StormReleaseTempestSurge__tempGroup)
                exitwhen pulledUnit == null

                if IsUnitEnemy(pulledUnit, GetOwningPlayer(s__HagoromoTW_caster[this])) and IsUnitType(pulledUnit, UNIT_TYPE_STRUCTURE) == false then
                    set unitX=GetUnitX(pulledUnit)
                    set unitY=GetUnitY(pulledUnit)
                    set angle=Atan2(s__HagoromoTW_casterY[this] - unitY, s__HagoromoTW_casterX[this] - unitX)
                    set distance=SquareRoot(( s__HagoromoTW_casterX[this] - unitX ) * ( s__HagoromoTW_casterX[this] - unitX ) + ( s__HagoromoTW_casterY[this] - unitY ) * ( s__HagoromoTW_casterY[this] - unitY ))
                    
                    set pullX=unitX + StormReleaseTempestSurge__PULL_FORCE * Cos(angle)
                    set pullY=unitY + StormReleaseTempestSurge__PULL_FORCE * Sin(angle)

                    call SetUnitPosition(pulledUnit, pullX, pullY)

                    call sc__HagoromoTW_applyDragDamage(this,pulledUnit)
                endif
                call GroupRemoveUnit(StormReleaseTempestSurge__tempGroup, pulledUnit)
            endloop
        endfunction

        function s__HagoromoTW_applyDragDamage takes integer this,unit target returns nothing
            local real primaryAttribute= GetHeroInt(s__HagoromoTW_caster[this], true)
            local real baseDamage= 500 + ( primaryAttribute * ( GetHeroLevel(s__HagoromoTW_caster[this]) / 10.0 ) )
            local real dragDamage= ( baseDamage * StormReleaseTempestSurge__DRAG_DAMAGE_PERCENT ) / 66
            local real totalDamage= LoadReal(StormReleaseTempestSurge__damageReceived, GetHandleId(target), 0)
        
            if not IsUnitInGroup(target, s__HagoromoTW_affectedUnits[this]) then
                set totalDamage=0
                call SaveReal(StormReleaseTempestSurge__damageReceived, GetHandleId(target), 0, 0)
                call GroupAddUnit(s__HagoromoTW_affectedUnits[this], target)
            endif
        
            if totalDamage < baseDamage then
                call UnitDamageTarget(s__HagoromoTW_caster[this], target, dragDamage, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call SaveReal(StormReleaseTempestSurge__damageReceived, GetHandleId(target), 0, totalDamage + dragDamage)
            endif
        endfunction        

        function s__HagoromoTW_actions takes nothing returns nothing
            local unit caster= GetTriggerUnit()
            call s__HagoromoTW_create(caster)
        endfunction

