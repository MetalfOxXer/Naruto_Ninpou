    function s__TayuyaWOgre_jumpMovement takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(TayuyaCore_Puppet)
        local real y= GetUnitY(TayuyaCore_Puppet)
        local real new_x= (((x )*1.0) + Cos((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_dist[this] / 22)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_dist[this] / 22)*1.0)) // INLINED!!
        local integer i
        local integer j
        set s__TayuyaWOgre_count[this]=s__TayuyaWOgre_count[this] + 1
        call SetUnitFacing(TayuyaCore_Puppet, Rad2Deg(TayuyaCore_W2Angle))
        call SetUnitX(TayuyaCore_Puppet, new_x)
        call SetUnitY(TayuyaCore_Puppet, new_y)
        call SetUnitFlyHeight(TayuyaCore_Puppet, ParabolaZ(500 , s__TayuyaWOgre_dist[this] , s__TayuyaWOgre_dist[this] / 22.0 * s__TayuyaWOgre_count[this]), 0)
        if s__TayuyaWOgre_count[this] > 22 then
            call SlowArea(s__TayuyaWOgre_caster[this] , GetUnitX(TayuyaCore_Puppet) , GetUnitY(TayuyaCore_Puppet) , 300.0)
            set bj_lastCreatedGroup=CreateGroup()
