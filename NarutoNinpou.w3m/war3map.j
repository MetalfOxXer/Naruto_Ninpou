        call RecycleUnit(s__MeiSuriyuudan_dragon[this])
        call PauseUnit(s__MeiSuriyuudan_caster[this], false)
        set s__MeiSuriyuudan_dragon[this]=null
        set s__MeiSuriyuudan_caster[this]=null
        call s__MeiSuriyuudan_deallocate(this)
