        //call ShowUnit(this.caster, false)
        set bj_lastCreatedUnit=CreateAbilityDummy(s__YamanakaTech_caster[this] , 'A11K')
        call IssueTargetOrder(bj_lastCreatedUnit, "invisibility", s__YamanakaTech_caster[this])
        call UnitAddAbility(s__YamanakaTech_caster[this], 'A02Q')
        call TimerStart(NewTimerEx(this), 0.5, false, function s__YamanakaTech_delay)
    endfunction 
    
    function s__YamanakaTech_death takes nothing returns nothing
        if GetUnitTypeId(GetTriggerUnit()) == 'e047' then
            call ShowUnit(GetTriggerUnit(), false)
