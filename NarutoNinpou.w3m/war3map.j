 function s__SuigetsuNewWave_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__SuigetsuNewWave_slash[this])
  local real y= GetUnitY(s__SuigetsuNewWave_slash[this])
  local real new_x= (((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__SuigetsuNewWave_slash[this])) )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__SuigetsuNewWave_slash[this])) )*1.0)) * (( 50)*1.0)) // INLINED!!
		call SetUnitX(s__SuigetsuNewWave_slash[this], new_x)
		call SetUnitY(s__SuigetsuNewWave_slash[this], new_y)
		call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SuigetsuNewWave_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__SuigetsuNewWave_damaged[this]) then
				call GroupAddUnit(s__SuigetsuNewWave_damaged[this], bj_lastCreatedUnit)
				call UnitDamageTarget(s__SuigetsuNewWave_caster[this], bj_lastCreatedUnit, 6.5 * GetHeroStr(s__SuigetsuNewWave_caster[this], true) + 6.5 * GetHeroAgi(s__SuigetsuNewWave_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__SuigetsuNewWave_count[this]=s__SuigetsuNewWave_count[this] + 1
		if s__SuigetsuNewWave_count[this] >= 25 then
			call KillUnit(s__SuigetsuNewWave_slash[this])
			set s__SuigetsuNewWave_slash[this]=null
			call DestroyGroup(s__SuigetsuNewWave_damaged[this])
			set s__SuigetsuNewWave_damaged[this]=null
			call s__SuigetsuNewWave_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

 function s__SuigetsuNewWave_actions takes nothing returns nothing
  local integer this= s__SuigetsuNewWave_allocate()
  local real angle= Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Suigetsu_T2_Bubble, 100.0, GetTriggerUnit())
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Suigetsu: I will kill you and become the greatest assassin of the mist!|r")
            endif
		set s__SuigetsuNewWave_caster[this]=GetTriggerUnit()
		set s__SuigetsuNewWave_slash[this]=CreateUnit(GetTriggerPlayer(), 'hdes', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), Rad2Deg(angle))
		set s__SuigetsuNewWave_damaged[this]=CreateGroup()
		set s__SuigetsuNewWave_count[this]=0
		call TimerStart(NewTimerEx(this), 0.045, true, function s__SuigetsuNewWave_periodic)
 endfunction 

 function s__SuigetsuNewWave_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(46 , s__SuigetsuNewWave_SPELL_ID , function s__SuigetsuNewWave_actions)
 endfunction

