    function s__ToruneNewMode_acid takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	if GetUnitTypeId(s__ToruneNewMode_caster[this]) == 'H013' then
		call SetUnitVertexColor(s__ToruneNewMode_caster[this], 75, 0, 130, 255)
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ToruneNewMode_caster[this]), GetUnitY(s__ToruneNewMode_caster[this]), 250, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(s__ToruneNewMode_caster[this], GetOwningPlayer(bj_lastCreatedUnit)) and GetWidgetLife(s__ToruneNewMode_caster[this]) > 0.405 and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                         call UnitDamageTarget(s__ToruneNewMode_caster[this], bj_lastCreatedUnit, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MAX_LIFE) * 0.005 * GetUnitAbilityLevel(s__ToruneNewMode_caster[this], s__ToruneNewMode_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
                         call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) - GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) * 0.003 * GetUnitAbilityLevel(s__ToruneNewMode_caster[this], s__ToruneNewMode_SPELL_ID))
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
	elseif GetUnitTypeId(s__ToruneNewMode_caster[this]) != 'H013' then
	    call SetUnitVertexColor(s__ToruneNewMode_caster[this], 255, 255, 255, 255)
            call s__ToruneNewMode_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction
    
    function s__ToruneNewMode_actions takes nothing returns nothing
        local integer this= s__ToruneNewMode_allocate()
        set s__ToruneNewMode_caster[this]=GetTriggerUnit()
        call TimerStart(NewTimerEx(this), 1.0, true, function s__ToruneNewMode_acid)
    endfunction 
    
    function s__ToruneNewMode_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(72 , s__ToruneNewMode_SPELL_ID , function s__ToruneNewMode_actions)
    endfunction 
    
