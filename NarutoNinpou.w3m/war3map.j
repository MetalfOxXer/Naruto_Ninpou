    function s__ItachiTsukuyomi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        set x=(((GetUnitX(s__ItachiTsukuyomi_target[this]) )*1.0) + Cos((( Deg2Rad(12 * s__ItachiTsukuyomi_count[this]) )*1.0)) * (( GetRandomReal(300, 380))*1.0)) // INLINED!!
        set y=(((GetUnitY(s__ItachiTsukuyomi_target[this]) )*1.0) + Sin((( Deg2Rad(12 * s__ItachiTsukuyomi_count[this]) )*1.0)) * (( GetRandomReal(300, 380))*1.0)) // INLINED!!
        set angle=Atan3(GetUnitX(s__ItachiTsukuyomi_target[this]) , GetUnitY(s__ItachiTsukuyomi_target[this]) , x , y)
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ItachiTsukuyomi_caster[this]), 'e005', x, y, Rad2Deg(angle) - 180)
        call UnitAddAbility(bj_lastCreatedUnit, 'A0CN')
        call UnitAddAbility(bj_lastCreatedUnit, 'A0JA')
        call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 155)
        call SetUnitAnimation(bj_lastCreatedUnit, "walk")
        call GroupAddUnit(s__ItachiTsukuyomi_itachis[this], bj_lastCreatedUnit)
        set s__ItachiTsukuyomi_count[this]=s__ItachiTsukuyomi_count[this] + 1
        if s__ItachiTsukuyomi_count[this] >= 29 then
            call TimerStart(NewTimerEx(this), 1.0, false, function s__ItachiTsukuyomi_delay)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction


