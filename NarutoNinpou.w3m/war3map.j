                set s__IchigoUnleash_Alloc___instanceCount=s__IchigoUnleash_Alloc___instanceCount + 1
                set this=s__IchigoUnleash_Alloc___instanceCount
            else
                set this=s__IchigoUnleash_Alloc___recycle[(0)]
                set s__IchigoUnleash_Alloc___recycle[(0)]=s__IchigoUnleash_Alloc___recycle[s__IchigoUnleash_Alloc___recycle[(0)]]
