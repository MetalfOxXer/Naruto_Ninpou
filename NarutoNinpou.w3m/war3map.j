//Implemented from module Alloc:
    
        function s__AMission_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__AMission_Alloc___recycle[(0)] == 0 ) then
                set s__AMission_Alloc___instanceCount=s__AMission_Alloc___instanceCount + 1
                set this=s__AMission_Alloc___instanceCount
            else
                set this=s__AMission_Alloc___recycle[(0)]
                set s__AMission_Alloc___recycle[(0)]=s__AMission_Alloc___recycle[s__AMission_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__AMission_deallocate takes integer this returns nothing
            set s__AMission_Alloc___recycle[this]=s__AMission_Alloc___recycle[(0)]
            set s__AMission_Alloc___recycle[(0)]=this
        endfunction

    function s__AMission_start takes nothing returns nothing
        local integer this= s__AMission_allocate()
        local integer team
        local boolean haspoints
        if GetItemTypeId(GetManipulatedItem()) == 'I05C' then
            if not udg_MissionsEnabled then
                return
            endif
            if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
                set team=0
                set haspoints=( GetTeamPoints(7) - GetTeamPoints(3) ) >= 150 or ( GetTeamPoints(11) - GetTeamPoints(3) >= 150 )
            elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
                set team=1
                set haspoints=( GetTeamPoints(3) - GetTeamPoints(7) ) >= 150 or ( GetTeamPoints(11) - GetTeamPoints(7) >= 150 )
            else
                set team=2
                set haspoints=( GetTeamPoints(3) - GetTeamPoints(11) ) >= 150 or ( GetTeamPoints(7) - GetTeamPoints(11) >= 150 )
            endif
            if not udg_MissionARankActive then
                if not udg_MissionARankTeamCompleted[team] then
                    if haspoints then
                        set udg_MissionARankActive=true
                        set udg_MissionARankTeams[team]=true
                        set udg_MissionAUnit=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
                        set udg_MissionACount=0
                        set s__AMission_delayMission=false
                        call TimerStart(NewTimerEx(this), 0.1, false, function sc__AMission_actions)
                    else
                        call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Your team must have 150 points below the winning team before doing this mission.|r")
                    endif
                else
                    call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000This mission was already done by your team.|r")
                endif
            else
                call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Someone is already doing this mission at this moment.|r")
            endif
        else
            return
        endif
    endfunction 
   
    function s__AMission_actions takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        local unit j
        call SetUnitPosition(udg_MissionAUnit, GetRectCenterX(gg_rct_MissionAEntry), GetRectCenterY(gg_rct_MissionAEntry))
        set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'U00S', 9726, 4917, 128)
        call UnitAddItemEx(u , 'I04S')
        call UnitAddItemEx(u , 'I01V')
        call SetHeroLevel(u, 1, true)
        set j=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'N01Q', 10239, 4917, 128)
        call UnitAddItemEx(j , 'I04S')
        call UnitAddItemEx(j , 'I01V')
        call SetHeroLevel(j, 1, true)
        call PanCameraToTimedForPlayer(GetOwningPlayer(udg_MissionAUnit), GetRectCenterX(gg_rct_MissionAEntry), GetRectCenterY(gg_rct_MissionAEntry), 0)
        set u=null
        set j=null
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
   
    function s__AMission_death takes nothing returns nothing
        local integer team
        if GetTriggerUnit() == udg_MissionAUnit then
            if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
                set team=0
            elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
                set team=1
            else
                set team=2
            endif
            set udg_MissionARankActive=false
            set udg_MissionARankTeams[team]=false
            set udg_MissionAUnit=null
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, 9982.5, 4917, 1000, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if ( GetUnitTypeId(bj_lastCreatedUnit) == 'U00S' or GetUnitTypeId(bj_lastCreatedUnit) == 'N01Q' ) then
                    call KillUnit(bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
    endfunction 
   
 function s__AMission_delay3 takes nothing returns nothing
        local integer team
        local integer i= 0
        local integer team2= 0
        local integer bounty= 19500
        if IsPlayerAlly(GetOwningPlayer(s__AMission_killer), Player(3)) then
            set team=0
        elseif IsPlayerAlly(GetOwningPlayer(s__AMission_killer), Player(7)) then
            set team=1
        else
            set team=2
        endif
        set udg_MissionARankTeamCompleted[team]=true
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(GetOwningPlayer(s__AMission_killer)) + 1] + GetUnitName(s__AMission_killer) + " |cff87ceebcompleted a A-Rank mission!|r")
        loop
            exitwhen i > 11
            if IsPlayerAlly(Player(i), GetOwningPlayer(s__AMission_killer)) and udg_units33[i + 1] != null then
                set team2=team2 + 1
            endif
            set i=i + 1
        endloop
        set i=0
        loop
            exitwhen i > 11
            if IsPlayerAlly(Player(i), GetOwningPlayer(s__AMission_killer)) and udg_units33[i + 1] != null then
                call AdjustPlayerStateBJ(bounty / team2, GetOwningPlayer(udg_units33[i + 1]), PLAYER_STATE_RESOURCE_GOLD)
            endif
            set i=i + 1
        endloop
        if IsPlayerAlly(GetOwningPlayer(s__AMission_killer), Player(3)) then
            call SetUnitPosition(s__AMission_killer, GetRectCenterX(gg_rct_FountainKonohagakure), GetRectCenterY(gg_rct_FountainKonohagakure))
        elseif IsPlayerAlly(GetOwningPlayer(s__AMission_killer), Player(7)) then
            call SetUnitPosition(s__AMission_killer, GetRectCenterX(gg_rct_FountainOtogakure), GetRectCenterY(gg_rct_FountainOtogakure))
        else
            call SetUnitPosition(s__AMission_killer, GetRectCenterX(gg_rct_FountainAkatsuki), GetRectCenterY(gg_rct_FountainAkatsuki))
        endif
        set udg_MissionAUnit=null
        set udg_MissionARankActive=false
        set s__AMission_killer=null
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__AMission_death2 takes nothing returns nothing
        if udg_MissionACount >= 2 and udg_MissionARankActive and not s__AMission_delayMission then
            set s__AMission_delayMission=true
            set s__AMission_killer=udg_MissionAUnit
            call TimerStartEx((NewTimerEx(0)) , 3.0 , false , function s__AMission_delay3 , "MissionARank_delay3") // INLINED!!
        endif
    endfunction 
   
    function s__AMission_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_PICKUP_ITEM ) , Filter(( function s__AMission_start))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__AMission_death))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__AMission_death2))) // INLINED!!
    endfunction 
