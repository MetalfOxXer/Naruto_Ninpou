				call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		set s__MadaraSusanooSlash_count[this]=s__MadaraSusanooSlash_count[this] + 1
		if s__MadaraSusanooSlash_count[this] >= 25 then
			call SetUnitTimeScale(madara_susanoo, 1.0)
			call KillUnit(s__MadaraSusanooSlash_slash[this])
			set s__MadaraSusanooSlash_slash[this]=null
			call DestroyGroup(s__MadaraSusanooSlash_damaged[this])
			set s__MadaraSusanooSlash_damaged[this]=null
			call s__MadaraSusanooSlash_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

