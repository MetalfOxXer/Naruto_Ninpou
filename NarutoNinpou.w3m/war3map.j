//Implemented from module Alloc:
    
        function s__GaiDynamicEntry_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__GaiDynamicEntry_Alloc___recycle[(0)] == 0 ) then
