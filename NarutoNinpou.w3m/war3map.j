 function s__KakashiDogs_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__KakashiDogs_dummy[this])
  local real y= GetUnitY(s__KakashiDogs_dummy[this])
  local real angle= GetAngleUnits(s__KakashiDogs_dummy[this] , s__KakashiDogs_target[this])
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
  local integer i
  local location l1
  local location l2
		call SetUnitX(s__KakashiDogs_dummy[this], new_x)
		call SetUnitY(s__KakashiDogs_dummy[this], new_y)
		call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		if GetDistanceUnits(s__KakashiDogs_dummy[this] , s__KakashiDogs_target[this]) <= 100 then
			call ShowUnit(s__KakashiDogs_dummy[this], false)
			call KillUnit(s__KakashiDogs_dummy[this])
			set s__KakashiDogs_dummy[this]=null
			set bj_lastCreatedEffect=AddSpecialEffect("NewDirtEXNofire.mdl", GetUnitX(s__KakashiDogs_target[this]), GetUnitY(s__KakashiDogs_target[this]))
            		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
            		call DestroyEffect(bj_lastCreatedEffect)
            		call StunUnitTimed(s__KakashiDogs_caster[this] , s__KakashiDogs_target[this] , 1.5)
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KakashiDogs_target[this]), GetUnitY(s__KakashiDogs_target[this]), 350, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakashiDogs_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
					call UnitDamageTarget(s__KakashiDogs_caster[this], bj_lastCreatedUnit, 85 * GetUnitAbilityLevel(s__KakashiDogs_caster[this], s__KakashiDogs_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				endif
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			set i=0
			loop
				exitwhen i == 6
				set x=(((GetUnitX(s__KakashiDogs_target[this]) )*1.0) + Cos((( Deg2Rad(60 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
				set y=(((GetUnitY(s__KakashiDogs_target[this]) )*1.0) + Sin((( Deg2Rad(60 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
				set angle=Atan3(x , y , GetUnitX(s__KakashiDogs_target[this]) , GetUnitY(s__KakashiDogs_target[this]))
				set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakashiDogs_caster[this]), 'n01B', x, y, Rad2Deg(angle))
				call SetUnitScale(bj_lastCreatedUnit, GetRandomReal(0.7, 1.2), 0, 0)
				if i == 1 then
					call SetUnitVertexColor(bj_lastCreatedUnit, 40, 40, 40, 255)
				endif
				call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
				call SetUnitAnimation(bj_lastCreatedUnit, "attack")
				set i=i + 1
			endloop
			call s__KakashiDogs_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		else
			set l1=Location(x, y)
			set l2=Location(new_x, new_y)
			call TerrainDeformationWaveBJ(0.25, l1, l2, 120.00, 30.00, 0)
			call RemoveLocation(l1)
			call RemoveLocation(l2)
			set l1=null
			set l2=null
		endif
 endfunction 

 function s__KakashiDogs_actions takes nothing returns nothing
  local integer this= s__KakashiDogs_allocate()
		set s__KakashiDogs_caster[this]=GetTriggerUnit()
		set s__KakashiDogs_target[this]=GetSpellTargetUnit()
		set s__KakashiDogs_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__KakashiDogs_caster[this]), GetUnitY(s__KakashiDogs_caster[this]), 270)
