        function PowerupSentinel__anon__0 takes nothing returns boolean
            if ( GetWidgetLife(GetManipulatedItem()) == 0 ) then
                call RemoveItem(GetManipulatedItem())
            endif
            return false
        endfunction
    function PowerupSentinel__onInit takes nothing returns nothing
        local trigger t=CreateTrigger()
        call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DROP_ITEM)
        call TriggerAddCondition(t, Condition(function PowerupSentinel__anon__0))
    endfunction

//library PowerupSentinel ends
//library PreventSave:
//====================================
//  by TriggerHappy
//====================================
//
//  This library allows you to enable or disable game saving. 
//  It works by showing a dialog instantly before a game is saved which interrupts it.
//  It does nothing visually to the game that I've noticed.
//
//  You can toggle saving for a specific player with the PreventSave function.
//  Example:
//      call PreventSave(Player(0), true) - disables saving for player 0
//
//  You also can toggle for everybody by setting
//  GameAllowSave to true, or false.
//
//====================================
// Import Instructions
//====================================
//
//  Decide whether you want GUI or vJASS, then copy the triggers or script over to your map.
//  This script requires JassHelper which is included in JassNewGenPack.
//
//====================================
    
    
//====================================
// Do not edit below this line
//====================================
    
    
    function PreventSave takes player p,boolean flag returns nothing
        if ( p == PreventSave__localplayer ) then
            set GameAllowSave=not flag
        endif
    endfunction
    
    function PreventSave__Exit takes nothing returns nothing
        call DialogDisplay(PreventSave__localplayer, PreventSave__Dialog, false)
    endfunction
    
    function PreventSave__StopSave takes nothing returns boolean
        if not GameAllowSave then
            call DialogDisplay(PreventSave__localplayer, PreventSave__Dialog, true)
        endif
        call TimerStart(PreventSave__Timer, 0.00, false, function PreventSave__Exit)
        return false
    endfunction
    
    function PreventSave__onInit takes nothing returns nothing
        local trigger t= CreateTrigger()
        set PreventSave__localplayer=GetLocalPlayer()
        
        call TriggerRegisterGameEvent(t, EVENT_GAME_SAVE)
        call TriggerAddCondition(t, Condition(function PreventSave__StopSave))
    endfunction


//library PreventSave ends
//library String2:



        function s__String3_create takes string s returns integer
            local integer this= s__String3_recycle[(0)]

            if this == 0 then
                set s__String3_count=s__String3_count + 1
                set this=s__String3_count
            else
                set s__String3_recycle[(0)]=s__String3_recycle[this]
            endif

            set s__String3_value[this]=s
            set s__String3_length[this]=StringLength(s)

            return this
        endfunction

        function s__String3_clear takes integer this returns nothing
            set s__String3_value[this]=null
            set s__String3_length[this]=0
        endfunction

        function s__String3_destroy takes integer this returns nothing
            call s__String3_clear(this)

            set s__String3_recycle[this]=s__String3_recycle[(0)]
            set s__String3_recycle[(0)]=this
        endfunction

        function s__String3__staticgetindex takes integer js returns integer
            return s__String3_create(s__String3_value[js])
        endfunction

        function s__String3_empty takes integer this returns boolean
            return s__String3_length[this] == 0
        endfunction

        function s__String3_size takes integer this returns integer
            return s__String3_length[this]
        endfunction

        constant function s__String3_maxSize takes nothing returns integer
            return 1023
        endfunction

        // private asserts for String objects
        function s__String3_assert_pos takes integer this,integer pos,string f returns boolean
            return ( pos >= 0 and pos < s__String3_length[this] )
        endfunction

        function s__String3_assert_size takes integer this,integer count,string f returns boolean
            return ( count <= (1023) ) // INLINED!!
        endfunction

        function s__String3_assert_range takes integer this,integer index,string f returns boolean
            return ( index >= 0 and index <= s__String3_length[this] )
        endfunction

        function s__String3_assert_resize takes integer this,integer count,string f returns boolean
            return s__String3_assert_size(this,s__String3_length[this] + count , f)
        endfunction

        function s__String3__getindex takes integer this,integer pos returns string
            return SubString(s__String3_value[this], pos, pos + 1)
        endfunction

        function s__String3__setindex takes integer this,integer pos,string s returns nothing
            set s__String3_value[this]=SubString(s__String3_value[this], 0, pos) + SubString(s, 0, 1) + SubString(s__String3_value[this], pos + 1, s__String3_length[this])
        endfunction

        function s__String3__get_front takes integer this returns string
            return SubString(s__String3_value[this], 0, 1)
        endfunction

        function s__String3__get_back takes integer this returns string
            return SubString(s__String3_value[this], s__String3_length[this] - 1, s__String3_length[this])
        endfunction

        function s__String3__get_str takes integer this returns string
            return s__String3_value[this]
        endfunction

        function s__String3_assign takes integer this,string str returns integer
            local integer len= StringLength(str)

            if ( s__String3_assert_size(this,len , "assign") ) then
                set s__String3_value[this]=str
                set s__String3_length[this]=len
            endif

            return this
        endfunction

        function s__String3_assignSubstring takes integer this,string str,integer pos,integer count returns integer
            if ( count == s__String3_npos ) then
                set count=StringLength(str)
            endif

            return s__String3_assign(this,SubString(str, pos, pos + count))
        endfunction

        function s__String3_insert takes integer this,integer pos,string str returns integer
            local integer len

            if ( s__String3_assert_range(this,pos , "insert") ) then
                set len=StringLength(str)

                if ( len > 0 and s__String3_assert_resize(this,len , "insert") ) then
                    set s__String3_value[this]=SubString(s__String3_value[this], 0, pos) + str + SubString(s__String3_value[this], pos, s__String3_length[this])
                    set s__String3_length[this]=s__String3_length[this] + len
                endif
            endif

            return this
        endfunction

        function s__String3_insertSubstring takes integer this,integer pos,string str,integer subpos,integer count returns integer
            if ( count == s__String3_npos ) then
                set count=StringLength(str)
            endif

            return s__String3_insert(this,pos , SubString(str, subpos, subpos + count))
        endfunction

        function s__String3_erase takes integer this,integer pos,integer count returns integer
            if s__String3_assert_pos(this,pos , "erase") then
                if ( count == s__String3_npos ) or ( pos + count > s__String3_length[this] ) then
                    set count=s__String3_length[this] - pos
                endif

                if ( count > 0 ) then
                    set s__String3_value[this]=SubString(s__String3_value[this], 0, pos) + SubString(s__String3_value[this], pos + count, s__String3_length[this])
                    set s__String3_length[this]=s__String3_length[this] - count
                endif
            endif

            return this
        endfunction

        function s__String3_pop takes integer this returns integer
            if ( s__String3_length[this] > 0 ) then
                set s__String3_value[this]=SubString(s__String3_value[this], 0, s__String3_length[this] - 1)
                set s__String3_length[this]=s__String3_length[this] - 1
            endif

            return this
        endfunction

        function s__String3_shift takes integer this returns integer
            if ( s__String3_length[this] > 0 ) then
                set s__String3_value[this]=SubString(s__String3_value[this], 1, s__String3_length[this])
                set s__String3_length[this]=s__String3_length[this] - 1
            endif

            return this
        endfunction

        function s__String3_append takes integer this,string str returns integer
            local integer len= StringLength(str)

            if ( len > 0 and s__String3_assert_resize(this,len , "append") ) then
                set s__String3_value[this]=s__String3_value[this] + str
                set s__String3_length[this]=s__String3_length[this] + len
            endif

            return this
        endfunction

        function s__String3_appendSubstring takes integer this,string str,integer pos,integer count returns integer
            if ( count == s__String3_npos ) then
                set count=StringLength(str)
            endif

            return s__String3_append(this,SubString(str, pos, pos + count))
        endfunction

        function s__String3_compare takes integer this,string str returns integer
            if ( s__String3_value[this] == str ) then
                return 0
            elseif s__String3_length[this] > StringLength(str) then
                return 1
            endif

            return - 1
        endfunction

        function s__String3_compareSubstrings takes integer this,integer pos,integer len,string str,integer subpos,integer sublen returns integer
            local integer result= - 1
            local string sub
            local string sub2

            if ( len == s__String3_npos ) then
                set len=s__String3_length[this]
            endif
            if ( sublen == s__String3_npos ) then
                set sublen=StringLength(str)
            endif

            set sub=SubString(s__String3_value[this], pos, pos + len)
            set sub2=SubString(str, subpos, subpos + sublen)

            if sub == sub2 then
                set result=0
            elseif StringLength(sub) > StringLength(sub2) then
                set result=1
            endif

            set sub=null
            set sub2=null
            return result
        endfunction

        function s__String3_replace takes integer this,integer pos,integer count,string str returns integer
            local integer len

            if ( s__String3_assert_pos(this,pos , "replace") ) then
                if ( count == s__String3_npos ) or ( pos + count > s__String3_length[this] ) then
                    set count=s__String3_length[this] - pos
                endif

                set len=StringLength(str) - count
                if ( s__String3_assert_resize(this,len , "replace") ) then
                    set s__String3_value[this]=SubString(s__String3_value[this], 0, pos) + str + SubString(s__String3_value[this], pos + count, s__String3_length[this])
                    set s__String3_length[this]=s__String3_length[this] + len
                endif
            endif

            return this
        endfunction

        function s__String3_replaceSubstrings takes integer this,integer pos,integer len,string str,integer subpos,integer sublen returns integer
            if ( sublen == s__String3_npos ) then
                set sublen=StringLength(str)
            endif

            return s__String3_replace(this,pos , len , SubString(str, subpos, subpos + sublen))
        endfunction

        function s__String3_substr takes integer this,integer pos,integer count returns string
            if ( s__String3_assert_pos(this,pos , "substr") ) then
                if ( count == s__String3_npos ) then
                    set count=s__String3_length[this]
                endif

                return SubString(s__String3_value[this], pos, pos + count)
            endif

            return null
        endfunction

        function s__String3_resize takes integer this,integer count returns nothing
            if ( count > s__String3_length[this] ) then
                if ( s__String3_assert_size(this,count , "resize") ) then
                    loop
                        exitwhen s__String3_length[this] >= count
                        set s__String3_value[this]=s__String3_value[this] + " "
                        set s__String3_length[this]=s__String3_length[this] + 1
                    endloop
                endif
            elseif ( count >= 0 and count < s__String3_length[this] ) then
                set s__String3_value[this]=SubString(s__String3_value[this], 0, count)
                set s__String3_length[this]=count
            endif
        endfunction

        function s__String3_find takes integer this,string str,integer pos returns integer
            local integer count

            if ( s__String3_assert_pos(this,pos , "find") ) then
                set count=StringLength(str)

                if ( count > 0 ) then
                    loop
                        exitwhen ( pos + count > s__String3_length[this] )
                        if ( SubString(s__String3_value[this], pos, pos + count) == str ) then
                            return pos
                        endif
                        set pos=pos + 1
                    endloop
                endif
            endif

            return s__String3_npos
        endfunction

        function s__String3_findBuffer takes integer this,string str,integer pos,integer count returns integer
            return s__String3_find(this,SubString(str, 0, count) , pos)
        endfunction

        function s__String3_rfind takes integer this,string str,integer pos returns integer
            local integer count

            if ( pos == s__String3_npos or pos >= s__String3_length[this] ) then
                set pos=s__String3_length[this] - 1
            endif

            if ( s__String3_assert_pos(this,pos , "rfind") ) then
                set count=StringLength(str)

                if ( count > 0 ) then
                    set pos=pos - count + 1

                    loop
                        exitwhen ( pos + 1 < count )
                        if ( SubString(s__String3_value[this], pos, pos + count) == str ) then
                            return pos
                        endif
                        set pos=pos - 1
                    endloop
                endif
            endif

            return s__String3_npos
        endfunction

        function s__String3_rfindBuffer takes integer this,string str,integer pos,integer count returns integer
            return s__String3_rfind(this,SubString(str, 0, count) , pos)
        endfunction

        function s__String3_capital takes integer this returns string
            return StringCase(SubString(s__String3_value[this], 0, 1), true) + SubString(s__String3_value[this], 1, s__String3_length[this])
        endfunction

        function s__String3_upper takes integer this returns string
            return StringCase(s__String3_value[this], true)
        endfunction

        function s__String3_lower takes integer this returns string
            return StringCase(s__String3_value[this], false)
        endfunction


