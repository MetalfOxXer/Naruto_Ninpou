			set s__Dog_damaged[this]=CreateGroup()
			call PauseUnit(s__Dog_caster[this], true)
			call SetUnitAnimation(s__Dog_caster[this], "Attack Three")
			set s__Dog_dist[this]=GetDistance(GetUnitX(s__Dog_caster[this]) , GetUnitY(s__Dog_caster[this]) , s__Dog_target_x[this] , s__Dog_target_y[this])
			call SetUnitFlyHeight(s__Dog_caster[this], 400.00, 400.00)
			call TimerStartEx(NewTimerEx(this) , 0.01 , true , function s__Dog_periodic , "Dog_periodic")
		else
                	call IssuePointOrder(s__Dog_caster[this], "move", GetSpellTargetX(), GetSpellTargetY())
        		call IssueImmediateOrder(s__Dog_path[this], "stop")
            		call BlzStartUnitAbilityCooldown(s__Dog_path[this], 'A150', 0.00)
		endif

