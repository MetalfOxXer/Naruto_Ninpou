            else
                set this=s__RikuudouNecklaceActive_Alloc___recycle[(0)]
                set s__RikuudouNecklaceActive_Alloc___recycle[(0)]=s__RikuudouNecklaceActive_Alloc___recycle[s__RikuudouNecklaceActive_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__RikuudouNecklaceActive_deallocate takes integer this returns nothing
            set s__RikuudouNecklaceActive_Alloc___recycle[this]=s__RikuudouNecklaceActive_Alloc___recycle[(0)]
            set s__RikuudouNecklaceActive_Alloc___recycle[(0)]=this
        endfunction
    
    
    function s__RikuudouNecklaceActive_finish takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call BlzSetSpecialEffectX(s__RikuudouNecklaceActive_yata[this], GetUnitX(s__RikuudouNecklaceActive_target[this]))
        call BlzSetSpecialEffectY(s__RikuudouNecklaceActive_yata[this], GetUnitY(s__RikuudouNecklaceActive_target[this]))
        call BlzSetSpecialEffectX(s__RikuudouNecklaceActive_yata2[this], GetUnitX(s__RikuudouNecklaceActive_target[this]))
        call BlzSetSpecialEffectY(s__RikuudouNecklaceActive_yata2[this], GetUnitY(s__RikuudouNecklaceActive_target[this]))
        set s__RikuudouNecklaceActive_count[this]=s__RikuudouNecklaceActive_count[this] + 1
        if s__RikuudouNecklaceActive_count[this] >= 50 then
            call BlzSetSpecialEffectX(s__RikuudouNecklaceActive_yata[this], 11705)
            call BlzSetSpecialEffectY(s__RikuudouNecklaceActive_yata[this], 8008)
            call BlzSetSpecialEffectX(s__RikuudouNecklaceActive_yata2[this], 11705)
            call BlzSetSpecialEffectY(s__RikuudouNecklaceActive_yata2[this], 8008)
            call SetUnitInvulnerable(s__RikuudouNecklaceActive_target[this], false)
            call DestroyEffect(s__RikuudouNecklaceActive_yata[this])
            set s__RikuudouNecklaceActive_yata[this]=null
            call DestroyEffect(s__RikuudouNecklaceActive_yata2[this])
            set s__RikuudouNecklaceActive_yata2[this]=null
            set s__RikuudouNecklaceActive_target[this]=null
            call s__RikuudouNecklaceActive_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__RikuudouNecklaceActive_actions takes nothing returns nothing
        local integer this= s__RikuudouNecklaceActive_allocate()
        set s__RikuudouNecklaceActive_target[this]=GetTriggerUnit()
        set s__RikuudouNecklaceActive_count[this]=0
        call SetUnitInvulnerable(s__RikuudouNecklaceActive_target[this], true)
        set s__RikuudouNecklaceActive_yata[this]=AddSpecialEffect("FlowerAura.mdl", GetUnitX(s__RikuudouNecklaceActive_target[this]), GetUnitY(s__RikuudouNecklaceActive_target[this]))
        call BlzSetSpecialEffectScale(s__RikuudouNecklaceActive_yata[this], 2.0)
        set s__RikuudouNecklaceActive_yata2[this]=AddSpecialEffect("FountainEffect.mdl", GetUnitX(s__RikuudouNecklaceActive_target[this]), GetUnitY(s__RikuudouNecklaceActive_target[this]))
        call BlzSetSpecialEffectScale(s__RikuudouNecklaceActive_yata2[this], 2.0)
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__RikuudouNecklaceActive_finish , "RikuudouNecklaceActive_finish")
    endfunction
    
    function s__RikuudouNecklaceActive_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2(('A0JT' ) , Filter(( function s__RikuudouNecklaceActive_actions))) // INLINED!!
    endfunction
    
//===========================================================================
// Trigger: RepairBase
//===========================================================================

function Trig_RepairBase_Actions takes nothing returns nothing
    //call SetUnitState(GetSellingUnit(), UNIT_STATE_LIFE, GetUnitState(GetSellingUnit(), UNIT_STATE_LIFE) + GetUnitState(GetSellingUnit(), UNIT_STATE_MAX_LIFE) * 0.05)
    local unit u= null
    if GetItemTypeId(GetManipulatedItem()) == 'I05A' then
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, GetPlayableMapRect(), null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if ( GetUnitTypeId(bj_lastCreatedUnit) == 'hcas' or GetUnitTypeId(bj_lastCreatedUnit) == 'h00F' or GetUnitTypeId(bj_lastCreatedUnit) == 'h00E' ) then
                if u == null or GetDistanceUnits(GetTriggerUnit() , bj_lastCreatedUnit) < GetDistanceUnits(GetTriggerUnit() , u) then
                    set u=bj_lastCreatedUnit
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_LIFE) + GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.05)
    endif
endfunction

//===========================================================================
function InitTrig_RepairBase takes nothing returns nothing
    call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_PICKUP_ITEM ) , Filter(( function Trig_RepairBase_Actions))) // INLINED!!
endfunction


