    function s__ObitoKamuiDimension_finish2 takes integer id returns nothing
        set s__s__ObitoKamuiDimension_isActive[id]= false
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__ObitoKamuiDimension_u[id]) ), ( 'h03U' ), (( GetUnitX(s__s__ObitoKamuiDimension_u[id]) )*1.0), (( GetUnitY(s__s__ObitoKamuiDimension_u[id]) )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
        call SetUnitAnimation(bj_lastCreatedUnit, "birth")
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__s__ObitoKamuiDimension_u[id]) ), ( 'h03U' ), (( s__s__ObitoKamuiDimension_xx[id] )*1.0), (( s__s__ObitoKamuiDimension_yy[id] )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, 1.5, 1.5, 1.5)
        call SetUnitAnimation(bj_lastCreatedUnit, "birth")
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)

        call UnitRemoveAbility(s__s__ObitoKamuiDimension_u[id], s__ObitoKamuiDimension_SPELL_ID_BACK)
	    call SetPlayerAbilityAvailable(GetOwningPlayer(s__s__ObitoKamuiDimension_u[id]), s__ObitoKamuiDimension_SPELL_ID, true)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, gg_rct_KamuiDimensionObito, null)
