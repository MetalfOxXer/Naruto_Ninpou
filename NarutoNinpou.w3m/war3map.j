        endfunction


      function s__MuTracking_track takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local integer i
	if ( GetOwningPlayer(s__MuTracking_caster[this]) == Player(0) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(1) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(2) ) then
		set i=1
	elseif ( GetOwningPlayer(s__MuTracking_caster[this]) == Player(4) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(5) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(6) ) then
		set i=2
	elseif ( GetOwningPlayer(s__MuTracking_caster[this]) == Player(8) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(9) or GetOwningPlayer(s__MuTracking_caster[this]) == Player(10) ) then
		set i=3
	endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__MuTracking_caster[this]), GetUnitY(s__MuTracking_caster[this]), 3500, null)
        loop
           	set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
        	exitwhen bj_lastCreatedUnit == null
        	if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MuTracking_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and GetOwningPlayer(bj_lastCreatedUnit) != Player(PLAYER_NEUTRAL_AGGRESSIVE) and GetOwningPlayer(bj_lastCreatedUnit) != Player(PLAYER_NEUTRAL_PASSIVE) then
			if i == 1 then
                		call PingMinimapForPlayer(Player(0), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(1), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(2), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
			elseif i == 2 then
                		call PingMinimapForPlayer(Player(4), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(5), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(6), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
			elseif i == 3 then
                		call PingMinimapForPlayer(Player(8), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(9), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
                		call PingMinimapForPlayer(Player(10), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 3.0)
			endif
	        endif
        	call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
	set s__MuTracking_caster[this]=null
        call s__MuTracking_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
      endfunction


    function s__MuTracking_actions takes nothing returns nothing
        local integer this= s__MuTracking_allocate()
        set s__MuTracking_caster[this]=GetTriggerUnit()
	set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h043', GetUnitX(s__MuTracking_caster[this]), GetUnitY(s__MuTracking_caster[this]), 0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
        call TimerStart(NewTimerEx(this), 0.01, false, function s__MuTracking_track)
    endfunction 

    function s__MuTracking_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__MuTracking_SPELL_ID ) , Filter(( function s__MuTracking_actions))) // INLINED!!
    endfunction 
    
