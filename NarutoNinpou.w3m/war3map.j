			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
			call KillUnit(GetSpellTargetUnit())
		endif
