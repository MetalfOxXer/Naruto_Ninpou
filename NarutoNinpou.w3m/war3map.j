            set s__SasoriUltimateUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__SasoriUltimateUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__SasoriUltimateUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__SasoriUltimateUltimateChoice_caster[this]), 'A0LP', false)
        else
            call s__SasoriUltimateUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SasoriUltimateUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__SasoriUltimateUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__SasoriUltimateUltimateChoice_u, s__SasoriUltimateUltimateChoice_PUPPETS)
            call UnitMakeAbilityPermanent(s__SasoriUltimateUltimateChoice_u, true, s__SasoriUltimateUltimateChoice_PUPPETS)
        else
            call UnitAddAbility(s__SasoriUltimateUltimateChoice_u, s__SasoriUltimateUltimateChoice_TRUEFORM)
            call UnitMakeAbilityPermanent(s__SasoriUltimateUltimateChoice_u, true, s__SasoriUltimateUltimateChoice_TRUEFORM)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0LP', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0LP', false)
        set s__s__SasoriUltimateUltimateChoice_b[0]= null
        set s__s__SasoriUltimateUltimateChoice_b[1]= null
        set s__SasoriUltimateUltimateChoice_u=null
        call s__Dialog_destroy(s__SasoriUltimateUltimateChoice_d)
        call DestroyBoolExpr(s__SasoriUltimateUltimateChoice_pick)
        set s__SasoriUltimateUltimateChoice_pick=null
        set this=s__SasoriUltimateUltimateChoice_allocate()
        set s__SasoriUltimateUltimateChoice_caster[this]=s__SasoriUltimateUltimateChoice_u
        set s__SasoriUltimateUltimateChoice_pp[this]=GetOwningPlayer(s__SasoriUltimateUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__SasoriUltimateUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__SasoriUltimateUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__SasoriUltimateUltimateChoice_PUPPETS) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__SasoriUltimateUltimateChoice_TRUEFORM) == 0 then
            set s__SasoriUltimateUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__SasoriUltimateUltimateChoice_d,"Pick a skill")
            set s__s__SasoriUltimateUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__SasoriUltimateUltimateChoice_d)], ("Hundred Puppets" ), ( 0))) // INLINED!!
            set s__s__SasoriUltimateUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__SasoriUltimateUltimateChoice_d)], ("Scorpion Puppet" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__SasoriUltimateUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__SasoriUltimateUltimateChoice_d,s__SasoriUltimateUltimateChoice_pick)
            set s__SasoriUltimateUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__SasoriUltimateUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0LP' then
            set s__SasoriUltimateUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__SasoriUltimateUltimateChoice_onInit takes nothing returns nothing
        set s__SasoriUltimateUltimateChoice_pick=Condition(function s__SasoriUltimateUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__SasoriUltimateUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0LP' ) , Filter(( function s__SasoriUltimateUltimateChoice_actions))) // INLINED!!
    endfunction 
    
