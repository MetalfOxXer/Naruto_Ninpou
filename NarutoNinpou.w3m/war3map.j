    function s__YamanakaBinding_damage takes nothing returns nothing
	if s__YamanakaBinding_spell then
           if GetEventDamage() > 50 and GetUnitTypeId(GetTriggerUnit()) == 'N02N' and s__YamanakaBinding_b then
            	call UnitDamageTarget(GetTriggerUnit(), s__YamanakaBinding_target, GetEventDamage() / 2 * GetUnitAbilityLevel(GetTriggerUnit(), s__YamanakaBinding_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            	call SetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE, ( GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) + GetEventDamage() ))
	    	set s__YamanakaBinding_b=false
	    	call TimerStart(NewTimerEx((GetUnitUserData((GetTriggerUnit())))), 0.05, false, function s__YamanakaBinding_removedamage) // INLINED!!
           endif
	endif
    endfunction 

 function s__YamanakaBinding_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__YamanakaBinding_count[this]=s__YamanakaBinding_count[this] + 0.1
        	call UnitDamageTarget(s__YamanakaBinding_caster[this], s__YamanakaBinding_target, GetUnitState(s__YamanakaBinding_target, UNIT_STATE_MAX_LIFE) * 0.01 / 33, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		if s__YamanakaBinding_count[this] > 30 or GetUnitAbilityLevel(s__YamanakaBinding_target, 'B05U') == 0 then
            		set s__YamanakaBinding_spell=false
			set s__YamanakaBinding_b=false
			set s__YamanakaBinding_target=null
			call s__Lightning_release((s__YamanakaBinding_l[this]),0.) // INLINED!!
			call s__YamanakaBinding_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction

    function s__YamanakaBinding_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.1, true, function s__YamanakaBinding_periodic)
        call PauseUnit(s__YamanakaBinding_target, false)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__YamanakaBinding_actions takes nothing returns nothing
        local integer this= s__YamanakaBinding_allocate()
	set s__YamanakaBinding_caster[this]=GetTriggerUnit()
	set s__YamanakaBinding_target=GetSpellTargetUnit()
        set s__YamanakaBinding_b=true
	set s__YamanakaBinding_spell=true
 	set s__YamanakaBinding_l[this]=s__Lightning_create("AFOD" , true , 0.5)
        call s__Lightning_attachToUnit(s__YamanakaBinding_l[this],true , s__YamanakaBinding_caster[this] , 60)
	call s__Lightning_attachToUnit(s__YamanakaBinding_l[this],false , s__YamanakaBinding_target , 60)
        set s__YamanakaBinding_count[this]=0
	set bj_lastCreatedUnit=CreateAbilityDummy(s__YamanakaBinding_caster[this] , 'A12Y')
	call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A12Y', GetUnitAbilityLevel(s__YamanakaBinding_caster[this], s__YamanakaBinding_SPELL_ID))
	call IssueTargetOrder(bj_lastCreatedUnit, "faeriefire", s__YamanakaBinding_target)
        call TimerStart(NewTimerEx(this), 0.1, false, function s__YamanakaBinding_delay)
        call PauseUnit(s__YamanakaBinding_target, true)
	call TriggerRegisterUnitEvent(s__YamanakaBinding_t, GetTriggerUnit(), EVENT_UNIT_DAMAGED)
    endfunction
    
    function s__YamanakaBinding_onInit takes nothing returns nothing
	set s__YamanakaBinding_t=CreateTrigger()
	call TriggerAddAction(s__YamanakaBinding_t, function s__YamanakaBinding_damage)
        call RegisterSpellEffectEvent2((s__YamanakaBinding_SPELL_ID ) , Filter(( function s__YamanakaBinding_actions))) // INLINED!!
    endfunction
    
