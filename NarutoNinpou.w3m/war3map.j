    function s__ObitoGunbai_timer takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__ObitoGunbai_tobi_cooldown3=s__ObitoGunbai_tobi_cooldown3 - 1
        if s__ObitoGunbai_tobi_cooldown3 <= 0 then
            call ReleaseTimer(GetExpiredTimer())
            call s__ObitoGunbai_deallocate(this)
        endif
    endfunction
    
    function s__ObitoGunbai_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ObitoGunbai_ball[this])
        local real y= GetUnitY(s__ObitoGunbai_ball[this])
        local real new_x= (((x )*1.0) + Cos((( s__ObitoGunbai_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__ObitoGunbai_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real yawFacing

        call SetUnitX(s__ObitoGunbai_ball[this], new_x)
        call SetUnitY(s__ObitoGunbai_ball[this], new_y)
        call BlzSetSpecialEffectX(s__ObitoGunbai_e[this], GetUnitX(s__ObitoGunbai_ball[this]))
        call BlzSetSpecialEffectY(s__ObitoGunbai_e[this], GetUnitY(s__ObitoGunbai_ball[this]))

        set yawFacing=Atan3(GetUnitX(s__ObitoGunbai_caster[this]) , GetUnitY(s__ObitoGunbai_caster[this]) , GetUnitX(s__ObitoGunbai_ball[this]) , GetUnitY(s__ObitoGunbai_ball[this]))
        call BlzSetSpecialEffectYaw(s__ObitoGunbai_e[this], yawFacing)

        call BlzSetSpecialEffectHeight(s__ObitoGunbai_e[this], 130 + GetPointZ(GetUnitX(s__ObitoGunbai_ball[this]) , GetUnitY(s__ObitoGunbai_ball[this])))
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!

        if not s__ObitoGunbai_hit[this] then
            set s__ObitoGunbai_count[this]=s__ObitoGunbai_count[this] + 1
        else
            set s__ObitoGunbai_angle[this]=Atan3(GetUnitX(s__ObitoGunbai_ball[this]) , GetUnitY(s__ObitoGunbai_ball[this]) , GetUnitX(s__ObitoGunbai_caster[this]) , GetUnitY(s__ObitoGunbai_caster[this]))
            set s__ObitoGunbai_count[this]=s__ObitoGunbai_count[this] - 1
        endif

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 120, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoGunbai_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true and s__ObitoGunbai_target[this] == null and not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoGunbai_damaged[this]) then
                call UnitDamageTarget(s__ObitoGunbai_caster[this], bj_lastCreatedUnit, GetHeroInt(s__ObitoGunbai_caster[this], true) * GetUnitAbilityLevel(s__ObitoGunbai_caster[this], 'A0EC'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                if not s__ObitoGunbai_stunned[this] then
                    call StunUnitTimed(s__ObitoGunbai_caster[this] , bj_lastCreatedUnit , 1.5)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    set s__ObitoGunbai_stunned[this]=true
                endif
                call GroupAddUnit(s__ObitoGunbai_damaged[this], bj_lastCreatedUnit)
                exitwhen true
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        if not s__ObitoGunbai_hit[this] and s__ObitoGunbai_count[this] > 32 then
            set s__ObitoGunbai_hit[this]=true
            set s__ObitoGunbai_angle[this]=s__ObitoGunbai_angle[this] + bj_PI
        elseif s__ObitoGunbai_hit[this] and GetDistance(GetUnitX(s__ObitoGunbai_ball[this]) , GetUnitY(s__ObitoGunbai_ball[this]) , GetUnitX(s__ObitoGunbai_caster[this]) , GetUnitY(s__ObitoGunbai_caster[this])) < 100 then
            call s__EffectUtils__EffectTimer_create((s__ObitoGunbai_e[this] ) , (( 0.1)*1.0) , true) // INLINED!!
            set s__ObitoGunbai_e[this]=null
            call DestroyGroup(s__ObitoGunbai_damaged[this])
            set s__ObitoGunbai_damaged[this]=null
            call RecycleUnit(s__ObitoGunbai_ball[this])
            set s__ObitoGunbai_ball[this]=null
            set s__ObitoGunbai_target[this]=null
            call s__Lightning_release((s__ObitoGunbai_chains1[this]),0.) // INLINED!!
            call s__ObitoGunbai_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__ObitoGunbai_actions takes nothing returns nothing
        local integer this= s__ObitoGunbai__allocate()
        local integer this2
        set s__ObitoGunbai_caster[this]=GetTriggerUnit()
        set s__ObitoGunbai_angle[this]=Atan3(GetUnitX(s__ObitoGunbai_caster[this]) , GetUnitY(s__ObitoGunbai_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__ObitoGunbai_count[this]=0
        set s__ObitoGunbai_ball[this]=(CreateUnit((GetTriggerPlayer() ), ( 'e007' ), (( GetUnitX(s__ObitoGunbai_caster[this]) )*1.0), (( GetUnitY(s__ObitoGunbai_caster[this]) )*1.0), (( Rad2Deg(s__ObitoGunbai_angle[this]))*1.0))) // INLINED!!
        set s__ObitoGunbai_hit[this]=false
        set s__ObitoGunbai_stunned[this]=false
        set this2=s__ObitoGunbai__allocate()
        set s__ObitoGunbai_tobi_cooldown3=18
        set s__ObitoGunbai_e[this]=AddSpecialEffect("Items\\Gunbai.mdl", GetUnitX(s__ObitoGunbai_caster[this]), GetUnitY(s__ObitoGunbai_caster[this]))
        call BlzSetSpecialEffectPitch(s__ObitoGunbai_e[this], 1.57)
        call BlzSetSpecialEffectHeight(s__ObitoGunbai_e[this], 130 + GetPointZ(GetUnitX(s__ObitoGunbai_ball[this]) , GetUnitY(s__ObitoGunbai_ball[this])))
        call BlzSetSpecialEffectYaw(s__ObitoGunbai_e[this], s__ObitoGunbai_angle[this])
        set s__ObitoGunbai_chains1[this]=s__Lightning_create("BLCA" , true , 0.5)
        call s__Lightning_recolor(s__ObitoGunbai_chains1[this],0 , 0 , 0.7 , 1) //////////
        call s__Lightning_attachToUnit(s__ObitoGunbai_chains1[this],true , s__ObitoGunbai_caster[this] , 60)
        call s__Lightning_attachToUnit(s__ObitoGunbai_chains1[this],false , s__ObitoGunbai_ball[this] , 200)
        set s__ObitoGunbai_target[this]=null
        set s__ObitoGunbai_damaged[this]=CreateGroup()
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ObitoGunbai_periodic)
        call TimerStart(NewTimerEx(this2), 1.0, true, function s__ObitoGunbai_timer)
    endfunction 
    
    function s__ObitoGunbai_onInit takes nothing returns nothing
        set s__ObitoGunbai_tobi_cooldown3=0
        call RegisterSpellEffectEvent2((s__ObitoGunbai_SPELL_ID ) , Filter(( function s__ObitoGunbai_actions))) // INLINED!!
    endfunction 
    
