    endfunction 
    
    function s__KaguyaSemi_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KaguyaSemi_dummy[this])
        local real y= GetUnitY(s__KaguyaSemi_dummy[this])
        local real angle= Atan3(x , y , s__KaguyaSemi_portal_x[this] , s__KaguyaSemi_portal_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 70)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 70)*1.0)) // INLINED!!
        local real dist= GetDistance(x , y , s__KaguyaSemi_portal_x[this] , s__KaguyaSemi_portal_y[this])
        local real dist2= GetDistance(x , y , GetUnitX(s__KaguyaSemi_target[this]) , GetUnitY(s__KaguyaSemi_target[this]))
	if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
        call SetUnitX(s__KaguyaSemi_caster[this], new_x)
        call SetUnitY(s__KaguyaSemi_caster[this], new_y)
	endif
        call SetUnitX(s__KaguyaSemi_dummy[this], new_x)
        call SetUnitY(s__KaguyaSemi_dummy[this], new_y)
        if not s__KaguyaSemi_down[this] then
            call SetUnitFlyHeight(s__KaguyaSemi_dummy[this], dist, 0)
        else
            call SetUnitFlyHeight(s__KaguyaSemi_dummy[this], 600 - dist, 0)
        endif
        call SetUnitFacing(s__KaguyaSemi_caster[this], Rad2Deg(angle))
        if dist2 < 550 and not s__KaguyaSemi_attack[this] then
			set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl", GetUnitX(s__KaguyaSemi_target[this]), GetUnitY(s__KaguyaSemi_target[this]))
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__KaguyaSemi_target[this]))
			call DestroyEffect(bj_lastCreatedEffect)
            call SetUnitAnimation(s__KaguyaSemi_target[this], "death")
	        set s__KaguyaSemi_attack[this]=true
        endif
        if dist < 50 then
            set s__KaguyaSemi_count[this]=s__KaguyaSemi_count[this] + 1
            if s__KaguyaSemi_count[this] > 5 then
                if GetUnitAbilityLevel(s__KaguyaSemi_caster[this], 'A0TV') > 0 then
                    call UnitDamageTarget(s__KaguyaSemi_caster[this], s__KaguyaSemi_target[this], ( 1500 + 3 * GetHeroInt(s__KaguyaSemi_caster[this], true) * GetUnitAbilityLevel(s__KaguyaSemi_caster[this], s__KaguyaSemi_SPELL_ID) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                else
                    call UnitDamageTarget(s__KaguyaSemi_caster[this], s__KaguyaSemi_target[this], ( 500 + 3 * GetHeroInt(s__KaguyaSemi_caster[this], true) * GetUnitAbilityLevel(s__KaguyaSemi_caster[this], s__KaguyaSemi_SPELL_ID) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
                call DestroyEffect(s__KaguyaSemi_portal1[this])
                call DestroyEffect(s__KaguyaSemi_portal2[this])
                set s__KaguyaSemi_portal1[this]=null
                set s__KaguyaSemi_portal2[this]=null
                call KillUnit(s__KaguyaSemi_dummy[this])
                call ShowUnit(s__KaguyaSemi_dummy[this], false)
                set s__KaguyaSemi_dummy[this]=null
                call PauseUnit(s__KaguyaSemi_caster[this], false)
                call PauseUnit(s__KaguyaSemi_target[this], false)
                call ShowUnit(s__KaguyaSemi_caster[this], true)
                call SelectUnitForPlayerSingle(s__KaguyaSemi_caster[this], GetOwningPlayer(s__KaguyaSemi_caster[this]))
                call SetUnitFlyHeight(s__KaguyaSemi_caster[this], 0, 0)
                call SetUnitFlyHeight(s__KaguyaSemi_target[this], 0, 0)
                call StunUnitTimed(s__KaguyaSemi_caster[this] , s__KaguyaSemi_target[this] , 1.0)
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__KaguyaSemi_target[this]) )*1.0), (( GetUnitY(s__KaguyaSemi_target[this]))*1.0))) // INLINED!!
                call UnitAddAbility(s__KaguyaSemi_caster[this], 'A0IX')
                call TimerStart(NewTimerEx(this), 10, false, function s__KaguyaSemi_removeAbility)
            else
                set s__KaguyaSemi_down[this]=not s__KaguyaSemi_down[this]
                call sc__KaguyaSemi_startSlash(this)
            endif
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KaguyaSemi_startSlash takes integer this returns nothing
        local real angle= GetRandomReal(0, 360)
        local real x1= (((GetUnitX(s__KaguyaSemi_target[this]) )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real y1= (((GetUnitY(s__KaguyaSemi_target[this]) )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real x2= (((GetUnitX(s__KaguyaSemi_target[this]) )*1.0) + Cos((( Deg2Rad(angle + 180) )*1.0)) * (( 300)*1.0)) // INLINED!!
        local real y2= (((GetUnitY(s__KaguyaSemi_target[this]) )*1.0) + Sin((( Deg2Rad(angle + 180) )*1.0)) * (( 300)*1.0)) // INLINED!!
        if s__KaguyaSemi_portal1[this] != null then
            call DestroyEffect(s__KaguyaSemi_portal1[this])
            call DestroyEffect(s__KaguyaSemi_portal2[this])
            call KillUnit(s__KaguyaSemi_dummy[this])
            call ShowUnit(s__KaguyaSemi_dummy[this], false)
        endif
        set s__KaguyaSemi_portal1[this]=AddSpecialEffect("Mr.War3_SKM.mdl", x1, y1)
		call BlzSetSpecialEffectScale(s__KaguyaSemi_portal1[this], 1.5)
        if not s__KaguyaSemi_down[this] then
            call BlzSetSpecialEffectHeight(s__KaguyaSemi_portal1[this], 600)
        endif
        set s__KaguyaSemi_portal2[this]=AddSpecialEffect("Mr.War3_SKM.mdl", x2, y2)
		call BlzSetSpecialEffectScale(s__KaguyaSemi_portal2[this], 1.5)
		set s__KaguyaSemi_portal_x[this]=x2
		set s__KaguyaSemi_portal_y[this]=y2
        if s__KaguyaSemi_down[this] then
            call BlzSetSpecialEffectHeight(s__KaguyaSemi_portal2[this], 600)
        endif
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__KaguyaSemi_caster[this]) )*1.0), (( GetUnitY(s__KaguyaSemi_caster[this]))*1.0))) // INLINED!!
        call SetUnitX(s__KaguyaSemi_caster[this], x1)
        call SetUnitY(s__KaguyaSemi_caster[this], y1)
        call SetUnitFacing(s__KaguyaSemi_caster[this], angle + 180)
        set s__KaguyaSemi_dummy[this]=CreateUnit(GetOwningPlayer(s__KaguyaSemi_caster[this]), 'e03V', x1, y1, angle + 180)
        call UnitAddAbility(s__KaguyaSemi_dummy[this], 'A02Q')
        call SetUnitVertexColor((s__KaguyaSemi_dummy[this] ), ( 255 ), ( 255 ), ( 255 ), ( 200)) // INLINED!!
        call SetUnitTimeScale(s__KaguyaSemi_dummy[this], 3.0)
        call SetUnitAnimationByIndex(s__KaguyaSemi_dummy[this], 8)
        if not s__KaguyaSemi_down[this] then
            call SetUnitFlyHeight(s__KaguyaSemi_dummy[this], 600, 0)
        endif
        set s__KaguyaSemi_attack[this]=false
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KaguyaSemi_move)
    endfunction 
    
    function s__KaguyaSemi_actions takes nothing returns nothing
        local integer this= s__KaguyaSemi_allocate()
        set s__KaguyaSemi_caster[this]=GetTriggerUnit()
        set s__KaguyaSemi_target[this]=GetSpellTargetUnit()
        set s__KaguyaSemi_count[this]=0
        set s__KaguyaSemi_portal1[this]=null
        set s__KaguyaSemi_portal2[this]=null
        call PauseUnit(s__KaguyaSemi_caster[this], true)
        call PauseUnit(s__KaguyaSemi_target[this], true)
        call ShowUnit(s__KaguyaSemi_caster[this], false)
        call SetUnitFlyHeight(s__KaguyaSemi_target[this], 300, 0)
        call AddUnitAnimationProperties(s__KaguyaSemi_caster[this], "alternate", true)
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__KaguyaSemi_target[this]) )*1.0), (( GetUnitY(s__KaguyaSemi_target[this]))*1.0))) // INLINED!!
        call SetUnitAnimationByIndex(s__KaguyaSemi_caster[this], 8)
        call s__KaguyaSemi_startSlash(this)
    endfunction 
    
    function s__KaguyaSemi_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(48 , s__KaguyaSemi_SPELL_ID , function s__KaguyaSemi_actions)
    endfunction 
    
