        function s__RingoStacks___RingoStacksS_onInit takes nothing returns nothing
            set RingoStacks___countStacks=s__Table_create()
        endfunction 
    
    function RingoStacks___RemoveStacks takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        local integer id= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if GetUnitAbilityLevel(u, 'B037') == 0 then
            call RemoveSavedInteger(Table__ht, (RingoStacks___countStacks), (id)) // INLINED!!
            call ReleaseTimer(GetExpiredTimer())
        endif
        set u=null
    endfunction 
    
    function GetStacks takes unit u returns integer
        local integer stacks
        local integer id= (GetUnitUserData((u))) // INLINED!!
        if not (HaveSavedInteger(Table__ht, (RingoStacks___countStacks), (id))) then // INLINED!!
            return 0
        else
            set stacks=(LoadInteger(Table__ht, (RingoStacks___countStacks), (id))) // INLINED!!
            return stacks
        endif
    endfunction 
    
    function AddStack takes unit caster,unit target,integer count returns nothing
        local unit dummy= CreateAbilityDummy(target , 'A0BY')
        local integer id= (GetUnitUserData((target))) // INLINED!!
        local integer stacks
        if not (HaveSavedInteger(Table__ht, (RingoStacks___countStacks), (id))) then // INLINED!!
            call SaveInteger(Table__ht, (RingoStacks___countStacks), (id), ( count)) // INLINED!!
            call SetUnitAbilityLevel(dummy, 'A0BY', count)
            call TimerStart(NewTimerEx(id), 0.5, true, function RingoStacks___RemoveStacks)
        else
            set stacks=(LoadInteger(Table__ht, (RingoStacks___countStacks), (id))) // INLINED!!
            set stacks=IMinBJ(stacks + count, 5)
            call SetUnitAbilityLevel(dummy, 'A0BY', stacks)
            call SaveInteger(Table__ht, (RingoStacks___countStacks), (id), ( stacks)) // INLINED!!
        endif
        call IssueTargetOrder(dummy, "unholyfrenzy", target)
        set dummy=null
    endfunction 


