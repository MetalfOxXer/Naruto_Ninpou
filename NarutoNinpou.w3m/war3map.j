    function s__UtakataUltimate_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__UtakataUltimate_caster[this])
        local real y= GetUnitY(s__UtakataUltimate_caster[this])
        local real new_x
        local real new_y
        local integer i= 0
        local unit u
        if ModuloInteger(s__UtakataUltimate_count[this], 5) == 0 then
            loop
                exitwhen i > 12
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 25 * s__UtakataUltimate_count[this])*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 25 * s__UtakataUltimate_count[this])*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__UtakataUltimate_caster[this]), 'e04K', new_x, new_y, GetRandomReal(0, 360))
                call SetUnitVertexColor(bj_lastCreatedUnit, 170, 20, 100, 50)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
                set i=i + 1
            endloop
        endif
        set s__UtakataUltimate_count[this]=s__UtakataUltimate_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__UtakataUltimate_caster[this]), GetUnitY(s__UtakataUltimate_caster[this]), 25 * s__UtakataUltimate_count[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__UtakataUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__UtakataUltimate_damaged[this]) then
                set u=CreateAbilityDummy(s__UtakataUltimate_caster[this] , 'A11S')
                call IssueTargetOrder(u, "faeriefire", bj_lastCreatedUnit)
                set u=null
                call UnitDamageTarget(s__UtakataUltimate_caster[this], bj_lastCreatedUnit, 10 * GetHeroAgi(s__UtakataUltimate_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__UtakataUltimate_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__UtakataUltimate_count[this] > 33 then
            call KillUnit(s__UtakataUltimate_sixtails[this])
            call ShowUnit(s__UtakataUltimate_sixtails[this], false)
            set s__UtakataUltimate_sixtails[this]=null
            call DestroyGroup(s__UtakataUltimate_damaged[this])
            set s__UtakataUltimate_damaged[this]=null
            call PauseUnit(s__UtakataUltimate_caster[this], false)
            call ShowUnit(s__UtakataUltimate_caster[this], true)
            call SelectUnitForPlayerSingle(s__UtakataUltimate_caster[this], GetOwningPlayer(s__UtakataUltimate_caster[this]))
            set i=0
            loop
                set i=i + 1
                exitwhen i > 5
                call KillUnit(CreateUnit(GetOwningPlayer(s__UtakataUltimate_caster[this]), 'h05R', GetUnitX(s__UtakataUltimate_caster[this]), GetUnitY(s__UtakataUltimate_caster[this]), GetRandomReal(0, 360)))
            endloop
            call s__UtakataUltimate_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__UtakataUltimate_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.03, true, function s__UtakataUltimate_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__UtakataUltimate_actions takes nothing returns nothing
        local integer this= s__UtakataUltimate_allocate()
        local integer i= 0
        set s__UtakataUltimate_count[this]=0
        set s__UtakataUltimate_damaged[this]=CreateGroup()
        set s__UtakataUltimate_caster[this]=GetTriggerUnit()
        call ShowUnit(s__UtakataUltimate_caster[this], false)
        call PauseUnit(s__UtakataUltimate_caster[this], true)
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Utakata: My only reason for fighting, is to protect my own life.|r")
            call PlaySoundOnUnitBJ(gg_snd_Utakata_T, 100, GetTriggerUnit())
        endif
        set s__UtakataUltimate_sixtails[this]=CreateUnit(GetTriggerPlayer(), 'e04J', GetUnitX(s__UtakataUltimate_caster[this]), GetUnitY(s__UtakataUltimate_caster[this]), GetUnitFacing(s__UtakataUltimate_caster[this]))
        call SetUnitAnimation(s__UtakataUltimate_sixtails[this], "attack spell")
        loop
            set i=i + 1
            exitwhen i > 5
            //call KillUnit(CreateUnit(GetOwningPlayer(this.caster), 'h05R', GetUnitX(this.caster), GetUnitY(this.caster), GetRandomReal(0, 360)))
        endloop
        call TimerStart(NewTimerEx(this), 0.25, false, function s__UtakataUltimate_delay)
    endfunction 
    
    function s__UtakataUltimate_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(78 , s__UtakataUltimate_SPELL_ID , function s__UtakataUltimate_actions)
    endfunction 

