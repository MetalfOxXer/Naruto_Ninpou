//Implemented from module Alloc:
    
        function s__MinatoRasengan_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MinatoRasengan_Alloc___recycle[(0)] == 0 ) then
                set s__MinatoRasengan_Alloc___instanceCount=s__MinatoRasengan_Alloc___instanceCount + 1
                set this=s__MinatoRasengan_Alloc___instanceCount
            else
                set this=s__MinatoRasengan_Alloc___recycle[(0)]
                set s__MinatoRasengan_Alloc___recycle[(0)]=s__MinatoRasengan_Alloc___recycle[s__MinatoRasengan_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MinatoRasengan_deallocate takes integer this returns nothing
            set s__MinatoRasengan_Alloc___recycle[this]=s__MinatoRasengan_Alloc___recycle[(0)]
            set s__MinatoRasengan_Alloc___recycle[(0)]=this
        endfunction

    function s__MinatoRasengan_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MinatoRasengan_target[this])
        local real y= GetUnitY(s__MinatoRasengan_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__MinatoRasengan_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__MinatoRasengan_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        call SetUnitX(s__MinatoRasengan_target[this], new_x)
        call SetUnitY(s__MinatoRasengan_target[this], new_y)
        call BlzSetSpecialEffectX(s__MinatoRasengan_e2[this], new_x)
        call BlzSetSpecialEffectY(s__MinatoRasengan_e2[this], new_y)
        if ModuloInteger(s__MinatoRasengan_count[this], 4) == 0 then
            set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_War_Stomp.mdx", new_x, new_y)
	    call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 3.0)
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 150, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MinatoRasengan_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__MinatoRasengan_damaged[this]) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call UnitDamageTarget(s__MinatoRasengan_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__MinatoRasengan_caster[this], true) * GetUnitAbilityLevel(s__MinatoRasengan_caster[this], s__MinatoRasengan_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__MinatoRasengan_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        set s__MinatoRasengan_count[this]=s__MinatoRasengan_count[this] + 1
        if s__MinatoRasengan_count[this] >= 16 then
            call SelectUnitForPlayerSingle(s__MinatoRasengan_caster[this], GetOwningPlayer(s__MinatoRasengan_caster[this]))
            call BlzSetSpecialEffectX(s__MinatoRasengan_e2[this], 11705)
            call BlzSetSpecialEffectY(s__MinatoRasengan_e2[this], 8008)
            //call PauseUnit(this.caster, false)
            call PauseUnit(s__MinatoRasengan_target[this], false)
            call DestroyEffect(s__MinatoRasengan_e1[this])
            set s__MinatoRasengan_e1[this]=null
            call DestroyEffect(s__MinatoRasengan_e2[this])
            set s__MinatoRasengan_e2[this]=null
            call DestroyGroup(s__MinatoRasengan_damaged[this])
            set s__MinatoRasengan_damaged[this]=null
            call s__MinatoRasengan_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__MinatoRasengan_actions takes nothing returns nothing
        local integer this= s__MinatoRasengan_allocate()
        local real x
        local real y
        set s__MinatoRasengan_caster[this]=GetTriggerUnit()
        set s__MinatoRasengan_target[this]=GetSpellTargetUnit()
        set s__MinatoRasengan_caster_x[this]=GetUnitX(s__MinatoRasengan_caster[this])
        set s__MinatoRasengan_caster_y[this]=GetUnitY(s__MinatoRasengan_caster[this])
        set s__MinatoRasengan_target_x[this]=GetUnitX(s__MinatoRasengan_target[this])
        set s__MinatoRasengan_target_y[this]=GetUnitY(s__MinatoRasengan_target[this])
        set s__MinatoRasengan_angle[this]=Atan3(s__MinatoRasengan_caster_x[this] , s__MinatoRasengan_caster_y[this] , s__MinatoRasengan_target_x[this] , s__MinatoRasengan_target_y[this])
        set s__MinatoRasengan_count[this]=0
        set s__MinatoRasengan_damaged[this]=CreateGroup()
        set x=(((s__MinatoRasengan_target_x[this] )*1.0) + Cos((( s__MinatoRasengan_angle[this] )*1.0)) * (( 150)*1.0)) // INLINED!!
        set y=(((s__MinatoRasengan_target_y[this] )*1.0) + Sin((( s__MinatoRasengan_angle[this] )*1.0)) * (( 150)*1.0)) // INLINED!!
        //call PauseUnit(this.caster, true)
        call PauseUnit(s__MinatoRasengan_target[this], true)
        set s__MinatoRasengan_e1[this]=AddSpecialEffectTarget("war3mapImported\\lxw jhxcom_2000.mdx", s__MinatoRasengan_caster[this], "left hand")
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( GetUnitX(s__MinatoRasengan_caster[this]) )*1.0), (( GetUnitY(s__MinatoRasengan_caster[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Yellow Blink.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        call SetUnitX(s__MinatoRasengan_caster[this], x)
        call SetUnitY(s__MinatoRasengan_caster[this], y)
        call SetUnitAnimation(s__MinatoRasengan_caster[this], "spell throw")
        set s__MinatoRasengan_e2[this]=AddSpecialEffect("war3mapImported\\lxw jhxcom_2000.mdl", x, y)
        call BlzSetSpecialEffectScale(s__MinatoRasengan_e2[this], 4.0)
        set s__MinatoRasengan_angle[this]=Atan3(s__MinatoRasengan_target_x[this] , s__MinatoRasengan_target_y[this] , s__MinatoRasengan_caster_x[this] , s__MinatoRasengan_caster_y[this])
        call SetUnitFacing(s__MinatoRasengan_caster[this], Rad2Deg(s__MinatoRasengan_angle[this]))
        call SelectUnitForPlayerSingle(s__MinatoRasengan_caster[this], GetOwningPlayer(s__MinatoRasengan_caster[this]))
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__MinatoRasengan_periodic , "MinatoInstantLight_periodic")
    endfunction
    
    function s__MinatoRasengan_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(32 , s__MinatoRasengan_SPELL_ID , function s__MinatoRasengan_actions)
    endfunction
    
