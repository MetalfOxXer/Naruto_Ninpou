//===========================================================================


    function s__SamehadaMana_actions takes nothing returns nothing
 local real damage
        if not IsUnitIllusion(GetAttacker()) and IsUnitEnemy(GetAttacker(), GetOwningPlayer(GetTriggerUnit())) and (UnitHasItemOfTypeBJ((GetAttacker() ), ( 'I03J'))) then // INLINED!!
        	call SetUnitState(GetAttacker(), UNIT_STATE_MANA, GetUnitState(GetAttacker(), UNIT_STATE_MANA) + 100 + GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_MANA) * 0.02)
		call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) - 100 - GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_MANA) * 0.03)
		set damage=100 + GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_MANA) * 0.03
                call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), damage / 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		if GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) / GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_MANA) <= 0.10 then
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetAttacker()), 'n03F', GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), GetUnitFacing(GetAttacker()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A04V')
			call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetTriggerUnit())
			call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
		endif
    	endif
    endfunction 
    
