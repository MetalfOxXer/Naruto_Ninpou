    function s__KarinExplosiveNote_bombexplosion takes nothing returns nothing
    	if GetAttacker() == s__KarinExplosiveNote_explosivecaster and GetUnitTypeId(GetAttacker()) == 'N00M' and not s__KarinExplosiveNote_KarinRThrown and not s__KarinExplosiveNote_b and IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false then
            set bj_lastCreatedEffect=AddSpecialEffect("Hit.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
            call DestroyEffect(bj_lastCreatedEffect)
            set s__KarinExplosiveNote_explosivetarget=GetTriggerUnit()
            if GetUnitTypeId(GetTriggerUnit()) == 'U00J' or GetUnitTypeId(GetTriggerUnit()) == 'U00H' or GetUnitTypeId(GetTriggerUnit()) == 'U00I' then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call PlaySoundOnUnitBJ(gg_snd_Karin_R_When_Hitting_Sasuke, 80, GetTriggerUnit())
                endif
            else
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call PlaySoundOnUnitBJ(gg_snd_Karin_R_When_Hitting_An_Enemy, 80, GetTriggerUnit())
                endif
            endif
            set s__KarinExplosiveNote_b=true
