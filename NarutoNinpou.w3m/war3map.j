 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

        set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\ChaosMeteorV3.mdl", s__MadaraTengaiShinseiSingle_target_x[this], s__MadaraTengaiShinseiSingle_target_y[this])
