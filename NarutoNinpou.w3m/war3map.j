    function s__KakuzuGrab_getWindow takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'U009' then
            set udg_unit69=GetLeavingUnit()
            set udg_Kakuzu_Window=GetUnitPropWindow(GetTriggerUnit())
        endif
    endfunction 
    
    function s__KakuzuGrab_death takes nothing returns nothing
	if GetUnitTypeId(GetTriggerUnit()) == 'h09Z' then
		call ShowUnit(GetTriggerUnit(), false)
	endif
    endfunction

