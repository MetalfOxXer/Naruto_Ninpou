 function s__YamanakaLevel_periodic takes nothing returns nothing
		if s__YamanakaLevel_yamanaka == null then
			call ReleaseTimer(GetExpiredTimer())
		endif
		if GetHeroLevel(s__YamanakaLevel_yamanaka) >= 15 and GetUnitAbilityLevel(s__YamanakaLevel_yamanaka, 'A037') > 0 then
			call SetUnitAbilityLevel(s__YamanakaLevel_yamanaka, 'A037', 2)
			call ReleaseTimer(GetExpiredTimer())
		elseif GetHeroLevel(s__YamanakaLevel_yamanaka) >= 15 and GetUnitAbilityLevel(s__YamanakaLevel_yamanaka, 'A1E4') > 0 then
			call SetUnitAbilityLevel(s__YamanakaLevel_yamanaka, 'A1E4', 2)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 
	
 function s__YamanakaLevel_leave takes nothing returns nothing
		if GetUnitTypeId(GetLeavingUnit()) == 'N02N' then
			set s__YamanakaLevel_yamanaka=GetLeavingUnit()
			call TimerStartEx((NewTimerEx(0)) , 1.0 , true , function s__YamanakaLevel_periodic , "YamanakaLevel_periodic") // INLINED!!
		endif
 endfunction

 function s__YamanakaLevel_onInit takes nothing returns nothing
		call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__YamanakaLevel_leave))) // INLINED!!
 endfunction 

