			call RemoveDestructable(udg_destructables02[bj_forLoopAIndex])
			call RemoveDestructable(udg_destructables04[bj_forLoopAIndex])
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
	endif
        call SetUnitPathing(udg_Yamato, true)
	//call SetPlayerAbilityAvailable(GetOwningPlayer(udg_Yamato), 'A04J', true)
	//call UnitRemoveAbility(udg_Yamato, 'A0TQ')
	if udg_YamatoCageTimer != null then
		call ReleaseTimer(udg_YamatoCageTimer)
		set udg_YamatoCageTimer=null
	endif
	call GroupClear(udg_YamatoCageUnits)
	set udg_YamatoRemoved=false
	call RemoveLocation(udg_location03)
endfunction

function Trig_YamatoCage2_Conditions takes nothing returns boolean
	return ( ( GetUnitTypeId(GetTriggerUnit()) == 'nbal' ) )
endfunction

function Trig_YamatoCage2_Actions takes nothing returns nothing
	call TriggerSleepAction(0.10)
	call RemoveUnit(GetTriggerUnit())
endfunction

function InitTrig_YamatoCage takes nothing returns nothing
	set udg_trigger367=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger367, EVENT_PLAYER_UNIT_SPELL_EFFECT)
	call TriggerAddCondition(udg_trigger367, Condition(function Trig_YamatoCage_Conditions))
	call TriggerAddAction(udg_trigger367, function Trig_YamatoCage_Actions)
        call EnableTriggerForId(21 , udg_trigger367)
	set udg_trigger368=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger368, EVENT_PLAYER_UNIT_DEATH)
	call TriggerAddCondition(udg_trigger368, Condition(function Trig_YamatoCage2_Conditions))
	call TriggerAddAction(udg_trigger368, function Trig_YamatoCage2_Actions)
        call EnableTriggerForId(21 , udg_trigger368)
endfunction 

