        local unit enumUnit
        local unit u
        local boolean unitsDetected= false
                  
        //call BJDebugMsg(R2S(TayuyaCore_WDamage)) 
           
        call PauseUnit(TayuyaCore_Puppet, true)
        if ( s__TayuyaWOgre_count[this] > ( GetUnitAbilityLevel(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID) * 5 ) + 50 ) then // or  TayuyaCore_OgreQ then
            set TayuyaCore_WDamage=0
            call s__TayuyaWOgre_destroy2()
            call ReleaseTimer(GetExpiredTimer())
        elseif TayuyaCore_OgreQ and GetUnitTypeId(TayuyaCore_Puppet) != 'h035' then
            call TimerStart(NewTimerEx(this), 0.24, false, function s__TayuyaWOgre_destroy2)
            call SetUnitAnimationByIndex(TayuyaCore_Puppet, 7)
            call ReleaseTimer(GetExpiredTimer())
        endif

        set TayuyaCore_WDamage=TayuyaCore_WDamage + ( 0.025 * GetHeroInt(s__TayuyaWOgre_caster[this], true) * GetUnitAbilityLevel(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID) )
        set unitsDetected=false

        // Sweep around the Ogre
        call GroupEnumUnitsInRange(l__tempGroup, x, y, 75.0, null)
        loop
            set enumUnit=FirstOfGroup(l__tempGroup)
            exitwhen enumUnit == null
            call GroupRemoveUnit(l__tempGroup, enumUnit)

            if IsUnitEnemy(enumUnit, GetOwningPlayer(s__TayuyaWOgre_caster[this])) and GetWidgetLife(enumUnit) > 0.405 then
                call GroupAddUnit(detectedUnits, enumUnit)
                if IsUnitType(enumUnit, UNIT_TYPE_HERO) then
                    set unitsDetected=true
                endif
            endif
        endloop

        // Sweep in front
        call GroupEnumUnitsInRange(l__tempGroup, frontX, frontY, 75.0, null)
        loop
            set enumUnit=FirstOfGroup(l__tempGroup)
            exitwhen enumUnit == null
            call GroupRemoveUnit(l__tempGroup, enumUnit)

            if not IsUnitInGroup(enumUnit, detectedUnits) and IsUnitEnemy(enumUnit, GetOwningPlayer(s__TayuyaWOgre_caster[this])) and GetWidgetLife(enumUnit) > 0.405 then
                call GroupAddUnit(detectedUnits, enumUnit)
                if IsUnitType(enumUnit, UNIT_TYPE_HERO) then
                    set unitsDetected=true
                endif
            endif
        endloop

        // Sweep behind
        call GroupEnumUnitsInRange(l__tempGroup, backX, backY, 75.0, null)
        loop
            set enumUnit=FirstOfGroup(l__tempGroup)
            exitwhen enumUnit == null
            call GroupRemoveUnit(l__tempGroup, enumUnit)

            if not IsUnitInGroup(enumUnit, detectedUnits) and IsUnitEnemy(enumUnit, GetOwningPlayer(s__TayuyaWOgre_caster[this])) and GetWidgetLife(enumUnit) > 0.405 then
                call GroupAddUnit(detectedUnits, enumUnit)
                if IsUnitType(enumUnit, UNIT_TYPE_HERO) then
                    set unitsDetected=true
                endif
            endif
        endloop

        if unitsDetected then
            if s__TayuyaWOgre_speed[this] > ( speedIncrement + 4 ) then
                set s__TayuyaWOgre_speed[this]=s__TayuyaWOgre_speed[this] - ( speedIncrement + 4 )
            endif
            set new_x=(((x )*1.0) + Cos((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_speed[this])*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_speed[this])*1.0)) // INLINED!!
            call SetUnitX(TayuyaCore_Puppet, new_x)
            call SetUnitY(TayuyaCore_Puppet, new_y)
            call SetUnitFacing(TayuyaCore_Puppet, Rad2Deg(TayuyaCore_W2Angle))
        else
            if s__TayuyaWOgre_speed[this] < originalSpeed then
                set s__TayuyaWOgre_speed[this]=s__TayuyaWOgre_speed[this] + speedIncrement
            endif
            set new_x=(((x )*1.0) + Cos((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_speed[this])*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( TayuyaCore_W2Angle )*1.0)) * (( s__TayuyaWOgre_speed[this])*1.0)) // INLINED!!
            call SetUnitX(TayuyaCore_Puppet, new_x)
            call SetUnitY(TayuyaCore_Puppet, new_y)
            call SetUnitFacing(TayuyaCore_Puppet, Rad2Deg(TayuyaCore_W2Angle))
        endif
        loop
            set bj_lastCreatedUnit=FirstOfGroup(detectedUnits)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TayuyaWOgre_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, 0.05 * GetHeroInt(s__TayuyaWOgre_caster[this], true) * GetUnitAbilityLevel(s__TayuyaWOgre_caster[this], s__TayuyaWOgre_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            endif
            call GroupRemoveUnit(detectedUnits, bj_lastCreatedUnit)
        endloop
        // Clean up
        call DestroyGroup(detectedUnits)
        call DestroyGroup(l__tempGroup)
    
        set s__TayuyaWOgre_count[this]=s__TayuyaWOgre_count[this] + 1
      
        if ModuloInteger(s__TayuyaWOgre_count[this], 5) == 0 then
            //call KillUnit(GetUnit(GetOwningPlayer(this.caster), 'e02G', new_x, new_y, GetRandomReal(0, 360)))
        endif
    endfunction

