            set s__RockLeeHachimon___Spell_count[this]=GetUnitAbilityLevel(s__RockLeeHachimon___Spell_caster[this], s__RockLeeHachimon___Spell_SPELL_ID)
	    call TimerStart(NewTimerEx(this), 0.5, false, function s__RockLeeHachimon___Spell_delay)
        endfunction 
        
