return true
                else
                    set s__KaidoShock__KaidoShockSpell_height[this]=KaidoShock__KS_RISE_HEIGHT * ( 1.0 - sinkT * sinkT )
                    call SetUnitFlyHeight(s__KaidoShock__KaidoShockSpell_dummy[this], s__KaidoShock__KaidoShockSpell_height[this], 0.0)
                endif
