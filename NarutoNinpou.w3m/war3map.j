				set y1=(((s__SasoriBomb_target_y[this] )*1.0) + Sin((( angle1 )*1.0)) * (( dist)*1.0)) // INLINED!!
				call DestroyEffect(AddSpecialEffect(("FireCrack.mdx" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
            			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
