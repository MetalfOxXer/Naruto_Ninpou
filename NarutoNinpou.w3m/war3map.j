    function s__SakuraNewFarm_actions takes nothing returns nothing
        local integer i
        local real x
        local real y
        if GetUnitAbilityLevel(GetTriggerUnit(), GetSpellAbilityId()) == 10 and not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
            call SetUnitX(GetTriggerUnit(), GetSpellTargetX())
