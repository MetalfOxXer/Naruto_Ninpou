    function s__TobiramaNewW_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__TobiramaNewW_count[this]=s__TobiramaNewW_count[this] + 1
        if ModuloInteger(s__TobiramaNewW_count[this], 10) == 0 then
            call IssueImmediateOrder(s__TobiramaNewW_dummy[this], "stomp")
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__TobiramaNewW_caster[this]), GetUnitY(s__TobiramaNewW_caster[this]), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TobiramaNewW_caster[this])) then
                if GetUnitTypeId(s__TobiramaNewW_caster[this]) == 'N01Y' then
                    call UnitDamageTarget(s__TobiramaNewW_caster[this], bj_lastCreatedUnit, 26.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                else
                    call UnitDamageTarget(s__TobiramaNewW_caster[this], bj_lastCreatedUnit, 2.6 * GetUnitAbilityLevel(s__TobiramaNewW_caster[this], 'A0BP'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__TobiramaNewW_count[this] > 33 then
            call PauseUnit(s__TobiramaNewW_caster[this], false)
            call SetUnitTimeScale(s__TobiramaNewW_caster[this], 1.0)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__TobiramaNewW_tornadoes[this])
                exitwhen bj_lastCreatedUnit == null
                //call SetUnitTimeScale(bj_lastCreatedUnit, 1.0)
                call KillUnit(bj_lastCreatedUnit)
		call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__TobiramaNewW_tornadoes[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__TobiramaNewW_tornadoes[this])
            set s__TobiramaNewW_tornadoes[this]=null
            call RecycleUnit(s__TobiramaNewW_dummy[this])
            set s__TobiramaNewW_dummy[this]=null
            call s__TobiramaNewW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__TobiramaNewW_actions takes nothing returns nothing
        local integer this= s__TobiramaNewW_allocate()
 local real x
 local real y
        local integer i= 0
        set s__TobiramaNewW_caster[this]=GetTriggerUnit()
        set s__TobiramaNewW_count[this]=0
        set bj_lastCreatedUnit=CreateAbilityDummy(s__TobiramaNewW_caster[this] , 'A0EJ')
        call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", s__TobiramaNewW_caster[this])
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        call PauseUnit(s__TobiramaNewW_caster[this], true)
        call SetUnitAnimation(s__TobiramaNewW_caster[this], "spell one")
        call SetUnitTimeScale(s__TobiramaNewW_caster[this], 0.5)
        set s__TobiramaNewW_tornadoes[this]=CreateGroup()
        //loop 
            //set i = i + 1 
            //exitwhen i > 24
	    //set x = GetPolarX(GetUnitX(this.caster), Deg2Rad(15 * i), 300)
	    //set y = GetPolarY(GetUnitY(this.caster), Deg2Rad(15 * i), 300)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__TobiramaNewW_caster[this]) ), ( 'h01S' ), (( GetUnitX(s__TobiramaNewW_caster[this]) )*1.0), (( GetUnitY(s__TobiramaNewW_caster[this]) )*1.0), (( 270)*1.0))) // INLINED!!
            //call SetUnitX(bj_lastCreatedUnit, x)
            //call SetUnitY(bj_lastCreatedUnit, y)
            //call SetUnitAnimation(bj_lastCreatedUnit, "stand")
            //call SetUnitTimeScale(bj_lastCreatedUnit, GetRandomReal(3, 6))
	    call SetUnitFlyHeight(bj_lastCreatedUnit, 150, 0)
            call GroupAddUnit(s__TobiramaNewW_tornadoes[this], bj_lastCreatedUnit)
        //endloop 
        set s__TobiramaNewW_dummy[this]=GetInvisibleDummy(GetOwningPlayer(s__TobiramaNewW_caster[this]) , GetUnitX(s__TobiramaNewW_caster[this]) , GetUnitY(s__TobiramaNewW_caster[this]))
        call UnitAddAbility(s__TobiramaNewW_dummy[this], 'A0BU')
        call AddLoadingBar(s__TobiramaNewW_caster[this] , 2)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__TobiramaNewW_periodic)
    endfunction 
    
    function s__TobiramaNewW_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2(('A0BP' ) , Filter(( function s__TobiramaNewW_actions))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0VJ' ) , Filter(( function s__TobiramaNewW_actions))) // INLINED!!
    endfunction 
    
