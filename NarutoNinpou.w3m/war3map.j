                    set s__NagatoNarakaTarget__Spell_king[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h08Q' ), (( x )*1.0), (( y )*1.0), (( GetUnitFacing(GetTriggerUnit()))*1.0))) // INLINED!!
                    call SetUnitAnimation(s__NagatoNarakaTarget__Spell_king[this], "spell")
