                if s__KaguyaTeleport_t == null then
                    set s__KaguyaTeleport_t=(NewTimerEx(0)) // INLINED!!
                    call TimerStart(s__KaguyaTeleport_t, 0.1, true, function s__KaguyaTeleport_teleport)
                endif
                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( caster_x )*1.0), (( caster_y)*1.0))) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                call SetUnitX(GetTriggerUnit(), new_x)
                call SetUnitY(GetTriggerUnit(), new_y)
                if udg_KaguyaTeleport1[id] != null then
                    call KillUnit(udg_KaguyaTeleport1[id])
                    call KillUnit(udg_KaguyaTeleport2[id])
                endif
                set udg_KaguyaTeleport1[id]=CreateUnit(GetTriggerPlayer(), 'h06N', caster_x, caster_y, GetUnitFacing(GetTriggerUnit()))
                set udg_KaguyaTeleport2[id]=CreateUnit(GetTriggerPlayer(), 'h06N', target_x, target_y, GetUnitFacing(GetTriggerUnit()))
            endif
        endfunction

        function s__KaguyaTeleport_shift takes nothing returns nothing
            local real caster_x= GetUnitX(GetTriggerUnit())
            local real caster_y= GetUnitY(GetTriggerUnit())
            local real dist_1
            local real dist_2
            local real new_x
            local real new_y
            local integer i= 0
            local integer id
            loop
                exitwhen i > 11
                if udg_units33[i + 1] != null and udg_KaguyaTeleport1[(GetUnitUserData((udg_units33[i + 1])))] != null and GetOwningPlayer(udg_KaguyaTeleport1[(GetUnitUserData((udg_units33[i + 1])))]) == GetTriggerPlayer() then // INLINED!!
                    set id=(GetUnitUserData((udg_units33[i + 1]))) // INLINED!!
                    set dist_1=GetDistance(caster_x , caster_y , GetUnitX(udg_KaguyaTeleport1[id]) , GetUnitY(udg_KaguyaTeleport1[id]))
                    set dist_2=GetDistance(caster_x , caster_y , GetUnitX(udg_KaguyaTeleport2[id]) , GetUnitY(udg_KaguyaTeleport2[id]))
                    if dist_1 <= 3000 or dist_2 <= 3000 then
                        if dist_1 < dist_2 then
                            set new_x=(((GetUnitX(udg_KaguyaTeleport1[id]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id])) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                            set new_y=(((GetUnitY(udg_KaguyaTeleport1[id]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport1[id])) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                        else
                            set new_x=(((GetUnitX(udg_KaguyaTeleport2[id]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport2[id]) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                            set new_y=(((GetUnitY(udg_KaguyaTeleport2[id]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(udg_KaguyaTeleport2[id]) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
                        endif
                        set bj_lastCreatedGroup=CreateGroup()
                        call GroupEnumUnitsInRange(bj_lastCreatedGroup, caster_x, caster_y, 300.0, null)
                        loop
                            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                            exitwhen bj_lastCreatedUnit == null
                            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                                if bj_lastCreatedUnit == GetTriggerUnit() then
                                    call SetUnitX(bj_lastCreatedUnit, new_x)
                                    call SetUnitY(bj_lastCreatedUnit, new_y)
                                else
                                    call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                                endif
                            endif
                            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                        endloop
                        call DestroyGroup(bj_lastCreatedGroup)
                        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( caster_x )*1.0), (( caster_y)*1.0))) // INLINED!!
                        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                    endif
                endif
                set i=i + 1
            endloop
        endfunction

