    function s__KankuroCrow_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KankuroCrow_crow[this])
        local real y= GetUnitY(s__KankuroCrow_crow[this])
        local real new_x= (((x )*1.0) + Cos((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        if not s__KankuroCrow_isKarasu[this] then
            set new_x=(((x )*1.0) + Cos((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            call SetUnitFacing(s__KankuroCrow_crow[this], Rad2Deg(s__KankuroCrow_angle[this]))
        endif
        call SetUnitX(s__KankuroCrow_crow[this], new_x)
        call SetUnitY(s__KankuroCrow_crow[this], new_y)
        call SetUnitFacing(s__KankuroCrow_crow[this], Rad2Deg(s__KankuroCrow_angle[this]))
        set s__KankuroCrow_count[this]=s__KankuroCrow_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__KankuroCrow_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            set x=GetUnitX(bj_lastCreatedUnit)
            set y=GetUnitY(bj_lastCreatedUnit)
            if s__KankuroCrow_isKarasu[this] then
                set x=(((x )*1.0) + Cos((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                set y=(((y )*1.0) + Sin((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            else
                set x=(((x )*1.0) + Cos((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                set y=(((y )*1.0) + Sin((( s__KankuroCrow_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
            endif
            if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                call SetUnitX(bj_lastCreatedUnit, x)
                call SetUnitY(bj_lastCreatedUnit, y)
            endif
        endloop
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KankuroCrow_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__KankuroCrow_damaged[this]) then
                call UnitDamageTarget(s__KankuroCrow_caster[this], bj_lastCreatedUnit, GetUnitAbilityLevel(s__KankuroCrow_caster[this], s__KankuroCrow_SPELL_ID) * GetHeroInt(s__KankuroCrow_caster[this], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                call SetUnitAnimation(bj_lastCreatedUnit, "death")
                call PauseUnit(bj_lastCreatedUnit, true)
                call GroupAddUnit(s__KankuroCrow_damaged[this], bj_lastCreatedUnit)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KankuroCrow_count[this] >= 30 then
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__KankuroCrow_damaged[this])
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(s__KankuroCrow_damaged[this], bj_lastCreatedUnit)
                call StunUnitTimed(s__KankuroCrow_caster[this] , bj_lastCreatedUnit , 1.0)
                call PauseUnit(bj_lastCreatedUnit, false)
            endloop
            call DestroyGroup(s__KankuroCrow_damaged[this])
            set s__KankuroCrow_damaged[this]=null
            call s__KankuroCrow_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__KankuroCrow_actions takes nothing returns nothing
        local integer this= s__KankuroCrow_allocate()
        local real new_x
        local real new_y
        set s__KankuroCrow_isKarasu[this]=GetSpellAbilityId() == 'A182'
        if s__KankuroCrow_isKarasu[this] then
            set s__KankuroCrow_caster[this]=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
            set s__KankuroCrow_crow[this]=udg_KankuroKarasu
	        set s__KankuroCrow_angle[this]=Atan3(GetUnitX(s__KankuroCrow_crow[this]) , GetUnitY(s__KankuroCrow_crow[this]) , GetSpellTargetX() , GetSpellTargetY())
            set s__KankuroCrow_count[this]=0
	        set s__KankuroCrow_damaged[this]=CreateGroup()
            call BlzStartUnitAbilityCooldown(s__KankuroCrow_caster[this], 'A181', 12.0)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__KankuroCrow_periodic)
        else
            set s__KankuroCrow_caster[this]=GetTriggerUnit()
            set s__KankuroCrow_angle[this]=Atan3(GetUnitX(s__KankuroCrow_caster[this]) , GetUnitY(s__KankuroCrow_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
            set new_x=(((GetUnitX(s__KankuroCrow_caster[this]) )*1.0) + Cos((( s__KankuroCrow_angle[this] )*1.0)) * (( 75)*1.0)) // INLINED!!
            set new_y=(((GetUnitY(s__KankuroCrow_caster[this]) )*1.0) + Sin((( s__KankuroCrow_angle[this] )*1.0)) * (( 75)*1.0)) // INLINED!!
            if udg_KankuroKarasu != null then
                set s__KankuroCrow_crow[this]=udg_KankuroKarasu
                call IssueImmediateOrder(s__KankuroCrow_crow[this], "stop")
                call SetUnitX(s__KankuroCrow_crow[this], GetUnitX(s__KankuroCrow_caster[this]))
                call SetUnitY(s__KankuroCrow_crow[this], GetUnitY(s__KankuroCrow_caster[this]))
                call SetUnitFacing(s__KankuroCrow_crow[this], Rad2Deg(s__KankuroCrow_angle[this]))
                call BlzStartUnitAbilityCooldown(s__KankuroCrow_crow[this], 'A182', 12.0)
            else
                set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'hwt2' ), (( new_x )*1.0), (( new_y )*1.0), (( Rad2Deg(s__KankuroCrow_angle[this]))*1.0))) // INLINED!!
                call SetUnitAnimationByIndex(bj_lastCreatedUnit, 1)
                call UnitAddAbility(bj_lastCreatedUnit, 'A02Q')
                set s__KankuroCrow_crow[this]=bj_lastCreatedUnit
            endif
	        set s__KankuroCrow_count[this]=0
	        set s__KankuroCrow_damaged[this]=CreateGroup()
            call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__KankuroCrow_periodic , "KankuroCrow_periodic")
        endif
        call TimerStartEx(NewTimerEx(GetPlayerId(GetOwningPlayer(s__KankuroCrow_caster[this]))) , 10 + 2.0 * GetUnitAbilityLevel(s__KankuroCrow_caster[this], s__KankuroCrow_SPELL_ID) , false , function s__KankuroCrow_cooldown , "KankuroCrow_cooldown")
    endfunction
    
    function s__KankuroCrow_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(4 , s__KankuroCrow_SPELL_ID , function s__KankuroCrow_actions)
        call RegisterSpellEffectEventForId(4 , 'A182' , function s__KankuroCrow_actions)
    endfunction
    
