    function s__KankuroPoisonNew_actions takes nothing returns nothing
        local integer this= s__KankuroPoisonNew_allocate()
        local integer i= 0
        local integer j
        local real x
        local real y
        local real offset
        local real angle
        set s__KankuroPoisonNew_caster[this]=GetTriggerUnit()
        set s__KankuroPoisonNew_x[this]=GetSpellTargetX()
        set s__KankuroPoisonNew_y[this]=GetSpellTargetY()
        set s__KankuroPoisonNew_count[this]=0
	set s__KankuroPoisonNew_damaged[this]=CreateGroup()
        loop
            set i=i + 1
            exitwhen i > 5
            set j=0
            loop
                exitwhen j > 11
                set angle=GetRandomReal(0, 2 * bj_PI)
                set offset=GetRandomReal(0, 350)
                set x=(((s__KankuroPoisonNew_x[this] )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
                set y=(((s__KankuroPoisonNew_y[this] )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
		set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\MindFog.mdl", x, y)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetRandomReal(0, 360)))
            	call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x , y))
		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
		call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( GetUnitAbilityLevel(s__KankuroPoisonNew_caster[this], s__KankuroPoisonNew_SPELL_ID))*1.0) , false) // INLINED!!
                set j=j + 1
            endloop
        endloop
	set s__KankuroPoisonNew_dummy[this]=CreateUnit(GetOwningPlayer(s__KankuroPoisonNew_caster[this]), 'e007', s__KankuroPoisonNew_x[this], s__KankuroPoisonNew_y[this], 270)
	call SlowAura(s__KankuroPoisonNew_dummy[this] , 0.2 , 400)
        call TimerStartEx(NewTimerEx(this) , 0.1 , true , function s__KankuroPoisonNew_periodic , "KankuroPoisonNew_periodic")
    endfunction 
    
    
    function s__KankuroPoisonNew_onInit takes nothing returns nothing
