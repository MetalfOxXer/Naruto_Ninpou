        function s__HagoromoD_unitDeath takes nothing returns nothing
            local integer this= s__HagoromoD_allocate()
            if s__HagoromoD_Hagoromo == GetKillingUnit() and IsHeroUnitId(GetUnitTypeId(GetDyingUnit())) then
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + s__HagoromoD_HagoromoStreakReward
                if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
                set s__HagoromoD_HagoromoStreakReward=s__HagoromoD_HagoromoStreakReward - 1
                if s__HagoromoD_HagoromoStreakReward <= 0 then
                    set s__HagoromoD_HagoromoStreakReward=1
                endif
                //call BJDebugMsg("Reward Received")
                call s__HagoromoD_filterSpell(this)
            endif
            if s__HagoromoD_Hagoromo == GetDyingUnit() then
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + s__HagoromoD_HagoromoStreakReward
                set s__HagoromoD_HagoromoStreakReward=3
                //call BJDebugMsg("Reward Reset")
            endif
            call s__HagoromoD_deallocate(this)
        endfunction

        function s__HagoromoD_recharge takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer this2
    
            if s__HagoromoD_HagoromoCurrentCharges < s__HagoromoD_HagoromoMaxCharges - 1 then
                set this2=s__HagoromoD_allocate()
                set s__HagoromoD_count[this]=0
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
                call s__HagoromoD_filterSpell(this)
                //call BJDebugMsg("Recharge Time: " + I2S(((6 + (this.HagoromoMaxCharges - (ModuloInteger(this.HagoromoCurrentCharges, this.HagoromoMaxCharges)))*2) - this.HagoromoRechargeSpeed)))
                call TimerStart(NewTimerEx(this2), 0.03, true, function sc__HagoromoD_rechargeTimerPeriodic)
                call s__HagoromoD_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            else
                set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                endif
                call s__HagoromoD_filterSpell(this)
                set s__HagoromoD_HagoromoSpellPrevious=0
                set s__HagoromoD_HagoromoSpellPenultimate=0
		        set s__HagoromoD_HagoromoSpellAntepenultimate=0
                set s__HagoromoD_lastDebuff1=0
                set s__HagoromoD_lastDebuff2=0
                set s__HagoromoD_lastDebuff3=0
                set s__HagoromoD_HagoromoRecharging=false
                call sc__HagoromoD_removeAllDebuffs(this)
                call s__HagoromoD_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
    
        function s__HagoromoD_rechargeTimerPeriodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
    
            set s__HagoromoD_count[this]=s__HagoromoD_count[this] + 1
    
            if s__HagoromoD_count[this] > 33 * ( ( 6 + ( s__HagoromoD_HagoromoMaxCharges - ( ModuloInteger(s__HagoromoD_HagoromoCurrentCharges, s__HagoromoD_HagoromoMaxCharges) ) ) * 2 ) - s__HagoromoD_HagoromoRechargeSpeed ) then
                set s__HagoromoD_HagoromoRechargeSpeed=s__HagoromoD_HagoromoRechargeSpeed + 1
                call TimerStart(NewTimerEx(this), 0.03, false, function s__HagoromoD_recharge)
                call ReleaseTimer(GetExpiredTimer())
            endif

        endfunction
    
        function s__HagoromoD_resetReleases takes nothing returns nothing
            local integer this
            local integer i= 0
            if GetTriggerPlayer() == GetOwningPlayer(s__HagoromoD_Hagoromo) then
                set this=s__HagoromoD_allocate()
                set s__HagoromoD_ReleaseEarth=false
                set s__HagoromoD_ReleaseWater=false
                set s__HagoromoD_ReleaseFire=false
                set s__HagoromoD_ReleaseWind=false
                set s__HagoromoD_ReleaseLightning=false
                set s__HagoromoD_HagoromoCasting=false
                set s__HagoromoD_combineRelease=false
                set s__HagoromoD_HagoromoSpellTwo=0
                set s__HagoromoD_HagoromoSpellOne=0
                set s__HagoromoD_HagoromoSpellCurrent=0
                if HagoromoChargesD_release != null then
                    call DestroyEffect(HagoromoChargesD_release)
		            set HagoromoChargesD_release=null
                endif
                
                loop
                    exitwhen i >= 8
                    call SetUnitVertexColor(s__HagoromoChargesD_orbs[i], 255, 255, 255, 255)
                    set i=i + 1
                endloop

                call TimerStart(NewTimerEx(this), 0.03, false, function sc__HagoromoD_removeAbility)
            elseif s__HagoromoD_removeTriggers then
                //call BJDebugMsg("Removing Trigger action from: " + " Player Number - " + I2S(GetPlayerId(GetTriggerPlayer())))
                call DisableTrigger(GetTriggeringTrigger())
            endif
        endfunction
    
        function s__HagoromoD_removeAbility takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

            if GetUnitAbilityLevel(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue) > 0 then
                call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_HagoromoSpellQueue)
            endif
            if GetUnitAbilityLevel(s__HagoromoD_Hagoromo, s__HagoromoD_SPELL_IDD) < 1 then
                call UnitAddAbility(s__HagoromoD_Hagoromo, s__HagoromoD_SPELL_IDD)
            endif

            call sc__HagoromoD_applyDebuffFromHistory(this)
            call s__HagoromoD_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__HagoromoD_cheats takes nothing returns nothing
            local integer this
            local integer i= 0

            if GetTriggerPlayer() == GetOwningPlayer(s__HagoromoD_Hagoromo) then
	            if udg_DEBUG_INT <= 1 then
                    set this=(LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
                    set s__HagoromoD_ReleaseEarth=false
                    set s__HagoromoD_ReleaseWater=false
                    set s__HagoromoD_ReleaseFire=false
                    set s__HagoromoD_ReleaseWind=false
                    set s__HagoromoD_ReleaseLightning=false
                    set s__HagoromoD_HagoromoCasting=false
                    set s__HagoromoD_combineRelease=false
                    set s__HagoromoD_HagoromoSpellTwo=0
                    set s__HagoromoD_HagoromoSpellOne=0
                    set s__HagoromoD_HagoromoCurrentCharges=8
                    set s__HagoromoD_HagoromoSpellPrevious=0
                    set s__HagoromoD_HagoromoSpellPenultimate=0
	                set s__HagoromoD_HagoromoSpellAntepenultimate=0
                    set s__HagoromoD_HagoromoSpellCurrent=0
                    set s__HagoromoD_HagoromoRecharging=false
                    set s__HagoromoD_lastDebuff1=0
                    set s__HagoromoD_lastDebuff2=0
                    set s__HagoromoD_lastDebuff3=0
                    if HagoromoChargesD_release != null then
                        call DestroyEffect(HagoromoChargesD_release)
		                set HagoromoChargesD_release=null
                        loop
                            exitwhen i >= 8
                            call SetUnitVertexColor(s__HagoromoChargesD_orbs[i], 255, 255, 255, 255)
                            set i=i + 1
                        endloop
                    endif
                    call sc__HagoromoD_removeAllDebuffs(this)
                    call s__HagoromoD_deallocate(this)
                endif
            elseif s__HagoromoD_removeTriggers then
                //call BJDebugMsg("Removing Trigger action from: " + " Player Number - " + I2S(GetPlayerId(GetTriggerPlayer())))
                call DisableTrigger(GetTriggeringTrigger())
            endif
        endfunction
    
        function s__HagoromoD_applyDebuffFromHistory takes integer this returns nothing
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_lastDebuff1)
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_lastDebuff2)
            call UnitRemoveAbility(s__HagoromoD_Hagoromo, s__HagoromoD_lastDebuff3)
        
            // Apply debuffs based on the spell history
            if s__HagoromoD_HagoromoSpellPrevious != 0 then
                set s__HagoromoD_lastDebuff1=sc__HagoromoD_applyDebuff(this,s__HagoromoD_HagoromoSpellPrevious)
                //call BJDebugMsg(I2S(lastDebuff1))
            endif
            if s__HagoromoD_HagoromoSpellPenultimate != 0 then
                set s__HagoromoD_lastDebuff2=sc__HagoromoD_applyDebuff(this,s__HagoromoD_HagoromoSpellPenultimate)
                //call BJDebugMsg(I2S(lastDebuff2))
            endif
            if s__HagoromoD_HagoromoSpellAntepenultimate != 0 then
                set s__HagoromoD_lastDebuff3=sc__HagoromoD_applyDebuff(this,s__HagoromoD_HagoromoSpellAntepenultimate)
                //call BJDebugMsg(I2S(lastDebuff3))
            endif
        endfunction        
        
        function s__HagoromoD_applyDebuff takes integer this,integer spellId returns integer
            local integer debuffId= LoadInteger(HagoromoChargesD_DebuffTable, spellId, 0)
            local unit u
            if debuffId != 0 then
                if debuffId == s__HagoromoD_DEBUFF_EARTH then
                    set u=CreateAbilityDummy(s__HagoromoD_Hagoromo , 'A0QY')
                    call SetUnitX(u, GetUnitX(s__HagoromoD_Hagoromo))
                    call SetUnitY(u, GetUnitY(s__HagoromoD_Hagoromo))
                    call IssueTargetOrder(u, "acidbomb", s__HagoromoD_Hagoromo)
                    set u=null
                elseif debuffId == s__HagoromoD_DEBUFF_WATER then
                    set u=CreateAbilityDummy(s__HagoromoD_Hagoromo , 'A0R0')
                    call SetUnitX(u, GetUnitX(s__HagoromoD_Hagoromo))
                    call SetUnitY(u, GetUnitY(s__HagoromoD_Hagoromo))
                    call IssueTargetOrder(u, "acidbomb", s__HagoromoD_Hagoromo)
                    set u=null
                elseif debuffId == s__HagoromoD_DEBUFF_FIRE then
                    set u=CreateAbilityDummy(s__HagoromoD_Hagoromo , 'A0R2')
                    call SetUnitX(u, GetUnitX(s__HagoromoD_Hagoromo))
                    call SetUnitY(u, GetUnitY(s__HagoromoD_Hagoromo))
                    call IssueTargetOrder(u, "acidbomb", s__HagoromoD_Hagoromo)
