    call TriggerAddAction(gg_trg_PickHeroByName, function Trig_PickHeroByName_Actions)
endfunction
//===========================================================================
// Trigger: AnbuShuriken
//===========================================================================
// scope Anbus begins

            
        
//Implemented from module Alloc:
    
        function s__AnbuShuriken_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__AnbuShuriken_Alloc___recycle[(0)] == 0 ) then
                set s__AnbuShuriken_Alloc___instanceCount=s__AnbuShuriken_Alloc___instanceCount + 1
                set this=s__AnbuShuriken_Alloc___instanceCount
            else
                set this=s__AnbuShuriken_Alloc___recycle[(0)]
                set s__AnbuShuriken_Alloc___recycle[(0)]=s__AnbuShuriken_Alloc___recycle[s__AnbuShuriken_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__AnbuShuriken_deallocate takes integer this returns nothing
            set s__AnbuShuriken_Alloc___recycle[this]=s__AnbuShuriken_Alloc___recycle[(0)]
            set s__AnbuShuriken_Alloc___recycle[(0)]=this
        endfunction
        
        
            function s__AnbuShuriken_periodic takes nothing returns nothing
                local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
                local real x= GetUnitX(s__AnbuShuriken_missile[this])
                local real y= GetUnitY(s__AnbuShuriken_missile[this])
                local real angle= Atan2(GetUnitY(s__AnbuShuriken_target[this]) - y, GetUnitX(s__AnbuShuriken_target[this]) - x)
                local real new_x= x + 25 * Cos(angle)
                local real new_y= y + 25 * Sin(angle)
        
                set s__AnbuShuriken_count[this]=s__AnbuShuriken_count[this] + 1
        
                call SetUnitX(s__AnbuShuriken_missile[this], new_x)
                call SetUnitY(s__AnbuShuriken_missile[this], new_y)
        
                if GetDistanceUnits(s__AnbuShuriken_missile[this] , s__AnbuShuriken_target[this]) <= 100 and s__AnbuShuriken_count[this] < 100 then
                    call UnitDamageTarget(s__AnbuShuriken_caster[this], s__AnbuShuriken_target[this], 300, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    //call AddSpecialEffect("war3mapImported\\Blood.mdl", GetUnitX(this.target), GetUnitY(this.target))
                    call DestroyEffect(AddSpecialEffect("war3mapImported\\Blood.mdl", GetUnitX(s__AnbuShuriken_target[this]), GetUnitY(s__AnbuShuriken_target[this])))
                    call StunUnitTimed(s__AnbuShuriken_caster[this] , s__AnbuShuriken_target[this] , 1.0)
                    call KillUnit(s__AnbuShuriken_missile[this])
                    set s__AnbuShuriken_missile[this]=null
                    call s__AnbuShuriken_deallocate(this)
                    call ReleaseTimer(GetExpiredTimer())
                elseif s__AnbuShuriken_count[this] >= 100 then
                    call KillUnit(s__AnbuShuriken_missile[this])
                    set s__AnbuShuriken_missile[this]=null
                    call s__AnbuShuriken_deallocate(this)
                    call ReleaseTimer(GetExpiredTimer())
                endif
            endfunction 
            
            function s__AnbuShuriken_reset takes nothing returns nothing
                local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
                local integer index= LoadInteger(AnbuTable, GetHandleId(s__AnbuShuriken_caster[this]), 0) - 1
                if index >= 0 then
                    set AnbusWeapons[index]=AddSpecialEffectTarget("Items\\FuumaShurikenBack.mdx", s__AnbuShuriken_caster[this], "chest")
                endif
            
                call s__AnbuShuriken_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endfunction            
            
function s__AnbuShuriken_onUnitAttack takes nothing returns nothing
    local unit a= GetAttacker()
    local unit tgt= GetTriggerUnit()
    local integer index
    local integer this
    local integer this2

    if GetUnitTypeId(a) == s__AnbuShuriken_TARGET_UNIT_ID and BlzGetUnitAbilityCooldownRemaining(a, s__AnbuShuriken_SPELL_ID) <= 0.00 and IsUnitType(tgt, UNIT_TYPE_HERO) then

        set this=s__AnbuShuriken_allocate()
        set s__AnbuShuriken_caster[this]=a
        set s__AnbuShuriken_target[this]=tgt

        // index load (see sentinel fix section below)
        set index=LoadInteger(AnbuTable, GetHandleId(a), 0) - 1

        if index >= 0 and AnbusWeapons[index] != null then
            call DestroyEffect(AnbusWeapons[index])
            set AnbusWeapons[index]=null
        endif

        set this2=s__AnbuShuriken_allocate()
        set s__AnbuShuriken_caster[this2]=a

        set s__AnbuShuriken_missile[this]=CreateUnit(GetOwningPlayer(a), 'e03O', GetUnitX(a), GetUnitY(a), 270)
        set s__AnbuShuriken_count[this]=0

        call BlzSetUnitAbilityCooldown(a, s__AnbuShuriken_SPELL_ID, 1, 20.0)
        call BlzStartUnitAbilityCooldown(a, s__AnbuShuriken_SPELL_ID, 20.0)

        call TimerStart(NewTimerEx(this), 0.03, true, function s__AnbuShuriken_periodic)
        call TimerStart(NewTimerEx(this2), 20.0, false, function s__AnbuShuriken_reset)
    endif

    set a=null
    set tgt=null
endfunction       
            
function s__AnbuShuriken_createWeapon takes nothing returns nothing
    local unit u= GetEnumUnit()
    local integer id= GetHandleId(u)

    if GetUnitTypeId(u) == s__AnbuShuriken_TARGET_UNIT_ID and LoadInteger(AnbuTable, id, 0) == 0 then
        set AnbusWeapons[AnbuIndexLength]=AddSpecialEffectTarget("Items\\FuumaShurikenBack.mdx", u, "chest")
        set Anbus[AnbuIndexLength]=u

        // Store index+1 so 0 can mean "not registered"
        call SaveInteger(AnbuTable, id, 0, AnbuIndexLength + 1)

        set AnbuIndexLength=AnbuIndexLength + 1
    endif

    set u=null
endfunction               
        
            function s__AnbuShuriken_initWeapon takes nothing returns nothing
                call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function s__AnbuShuriken_createWeapon)
            endfunction
        
            function s__AnbuShuriken_onInit takes nothing returns nothing
                local trigger t= CreateTrigger()
                
                call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
                call TriggerAddAction(t, function s__AnbuShuriken_onUnitAttack)
        
                call ForGroupBJ(GetUnitsInRectAll(GetPlayableMapRect()), function s__AnbuShuriken_createWeapon)
            endfunction     
// scope Anbus ends
        
