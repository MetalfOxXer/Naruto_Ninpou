function InitTrig_DisplayModes takes nothing returns nothing
    local integer i= 0
    set gg_trg_DisplayModes=CreateTrigger()
    loop
        exitwhen i > 11
        call TriggerRegisterPlayerChatEvent(gg_trg_DisplayModes, Player(i), "-modes", true)
        set i=i + 1
    endloop
    call TriggerAddAction(gg_trg_DisplayModes, function Trig_DisplayModes_Actions)
endfunction


//===========================================================================
// Trigger: IncreaseBounty
//===========================================================================

    function s__ModeMinutesGold_actions takes nothing returns nothing
        local integer gold
        if GetOwningPlayer(GetTriggerUnit()) == Player(3) or GetOwningPlayer(GetTriggerUnit()) == Player(7) or GetOwningPlayer(GetTriggerUnit()) == Player(11) then
            set gold=GetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD)
            if udg_Mode30Min then
                if ( GetUnitTypeId(GetTriggerUnit()) == 'h01A' or GetUnitTypeId(GetTriggerUnit()) == 'h01J' or GetUnitTypeId(GetTriggerUnit()) == 'h027' ) then
                    call SetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD, gold + 35)
                elseif ( GetUnitTypeId(GetTriggerUnit()) == 'hfoo' or GetUnitTypeId(GetTriggerUnit()) == 'h01B' or GetUnitTypeId(GetTriggerUnit()) == 'h026' ) then
                    call SetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD, gold + 45)
                elseif ( GetUnitTypeId(GetTriggerUnit()) == 'e017' or GetUnitTypeId(GetTriggerUnit()) == 'earc' or GetUnitTypeId(GetTriggerUnit()) == 'e018' ) then
                    call SetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD, gold + 75)
                elseif ( GetUnitTypeId(GetTriggerUnit()) == 'otau' or GetUnitTypeId(GetTriggerUnit()) == 'ogru' or GetUnitTypeId(GetTriggerUnit()) == 'orai' ) then
                    call SetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD, gold + 150)
                elseif GetUnitTypeId(GetTriggerUnit()) == 'ndth' then
                    call SetPlayerState(GetOwningPlayer(GetKillingUnit()), PLAYER_STATE_RESOURCE_GOLD, gold + 95)
                endif
            endif
        endif
    endfunction
    
    function s__ModeMinutesGold_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__ModeMinutesGold_actions))) // INLINED!!
    endfunction
    
