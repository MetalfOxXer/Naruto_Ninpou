// Trigger: SasukeUltimateChoice
//===========================================================================
//textmacro instance: UltimateChoice("Sasuke", "A0V4", "A0KU", "SUSANOO", "Perfect Susano'o", "A0V5", "CHIBAKU_TENSEI", "Chibaku Tensei")

//Implemented from module Alloc:
    
        function s__SasukeUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasukeUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__SasukeUltimateChoice_Alloc___instanceCount=s__SasukeUltimateChoice_Alloc___instanceCount + 1
                set this=s__SasukeUltimateChoice_Alloc___instanceCount
            else
                set this=s__SasukeUltimateChoice_Alloc___recycle[(0)]
                set s__SasukeUltimateChoice_Alloc___recycle[(0)]=s__SasukeUltimateChoice_Alloc___recycle[s__SasukeUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SasukeUltimateChoice_deallocate takes integer this returns nothing
            set s__SasukeUltimateChoice_Alloc___recycle[this]=s__SasukeUltimateChoice_Alloc___recycle[(0)]
            set s__SasukeUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__SasukeUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__SasukeUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__SasukeUltimateChoice_caster[this]), 'A0V4', false)
        else
            call s__SasukeUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SasukeUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__SasukeUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__SasukeUltimateChoice_u, s__SasukeUltimateChoice_SUSANOO)
            call UnitMakeAbilityPermanent(s__SasukeUltimateChoice_u, true, s__SasukeUltimateChoice_SUSANOO)
        else
            call UnitAddAbility(s__SasukeUltimateChoice_u, s__SasukeUltimateChoice_CHIBAKU_TENSEI)
            call UnitMakeAbilityPermanent(s__SasukeUltimateChoice_u, true, s__SasukeUltimateChoice_CHIBAKU_TENSEI)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0V4', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0V4', false)
        set s__s__SasukeUltimateChoice_b[0]= null
        set s__s__SasukeUltimateChoice_b[1]= null
        set s__SasukeUltimateChoice_u=null
        call s__Dialog_destroy(s__SasukeUltimateChoice_d)
        call DestroyBoolExpr(s__SasukeUltimateChoice_pick)
        set s__SasukeUltimateChoice_pick=null
        set this=s__SasukeUltimateChoice_allocate()
        set s__SasukeUltimateChoice_caster[this]=s__SasukeUltimateChoice_u
        set s__SasukeUltimateChoice_pp[this]=GetOwningPlayer(s__SasukeUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__SasukeUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__SasukeUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__SasukeUltimateChoice_SUSANOO) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__SasukeUltimateChoice_CHIBAKU_TENSEI) == 0 then
            set s__SasukeUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__SasukeUltimateChoice_d,"Pick a skill")
            set s__s__SasukeUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__SasukeUltimateChoice_d)], ("Perfect Susano'o" ), ( 0))) // INLINED!!
            set s__s__SasukeUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__SasukeUltimateChoice_d)], ("Chibaku Tensei" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__SasukeUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__SasukeUltimateChoice_d,s__SasukeUltimateChoice_pick)
            set s__SasukeUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__SasukeUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0V4' then
            set s__SasukeUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__SasukeUltimateChoice_onInit takes nothing returns nothing
        set s__SasukeUltimateChoice_pick=Condition(function s__SasukeUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__SasukeUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0V4' ) , Filter(( function s__SasukeUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Sasuke", "A0V4", "A0KU", "SUSANOO", "Perfect Susano'o", "A0V5", "CHIBAKU_TENSEI", "Chibaku Tensei")

//===========================================================================
// Trigger: SasukeChibakuTensei
//===========================================================================

//Implemented from module Alloc:
    
        function s__SasukeChibakuTensei_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasukeChibakuTensei_Alloc___recycle[(0)] == 0 ) then
                set s__SasukeChibakuTensei_Alloc___instanceCount=s__SasukeChibakuTensei_Alloc___instanceCount + 1
                set this=s__SasukeChibakuTensei_Alloc___instanceCount
            else
                set this=s__SasukeChibakuTensei_Alloc___recycle[(0)]
                set s__SasukeChibakuTensei_Alloc___recycle[(0)]=s__SasukeChibakuTensei_Alloc___recycle[s__SasukeChibakuTensei_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SasukeChibakuTensei_deallocate takes integer this returns nothing
            set s__SasukeChibakuTensei_Alloc___recycle[this]=s__SasukeChibakuTensei_Alloc___recycle[(0)]
            set s__SasukeChibakuTensei_Alloc___recycle[(0)]=this
        endfunction
    
    function s__SasukeChibakuTensei_explosion takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local unit u
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__SasukeChibakuTensei_damaged[this])
            exitwhen bj_lastCreatedUnit == null
            call ShowUnit(bj_lastCreatedUnit, true)
            call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 1400)
            call PauseUnit(bj_lastCreatedUnit, false)
            call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
            call UnitDamageTarget(s__SasukeChibakuTensei_caster[this], bj_lastCreatedUnit, 10 * GetHeroAgi(s__SasukeChibakuTensei_caster[this], true) + 200, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            call GroupRemoveUnit(s__SasukeChibakuTensei_damaged[this], bj_lastCreatedUnit)
            
            set i=0
            loop
                exitwhen i > 2
                set u=CreateUnit(GetOwningPlayer(s__SasukeChibakuTensei_caster[this]), 'nrac', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 270)
                //call SetUnitTimeScale(u, 0.5)
                call KillUnit(u)
                //call SetUnitTimeScale(u, 0.1)
                call SetUnitFlyHeight(u, 450, 0)
                set i=i + 1
            endloop
            
        endloop
        call DestroyGroup(s__SasukeChibakuTensei_damaged[this])
        set s__SasukeChibakuTensei_damaged[this]=null
        call s__SasukeChibakuTensei_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SasukeChibakuTensei_hide takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__SasukeChibakuTensei_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call ShowUnit(bj_lastCreatedUnit, false)
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 3.0, false, function s__SasukeChibakuTensei_explosion)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SasukeChibakuTensei_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
        set s__SasukeChibakuTensei_count[this]=s__SasukeChibakuTensei_count[this] + 1
        if ModuloInteger(s__SasukeChibakuTensei_count[this], 5) == 0 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SasukeChibakuTensei_caster[this]), 'e015', GetUnitX(s__SasukeChibakuTensei_caster[this]), GetUnitY(s__SasukeChibakuTensei_caster[this]), GetRandomReal(0, 360))
            call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__SasukeChibakuTensei_caster[this]))
            call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__SasukeChibakuTensei_caster[this]))
            call SetUnitTimeScale(bj_lastCreatedUnit, 1.5)
            call KillUnit(bj_lastCreatedUnit)
        endif
        if s__SasukeChibakuTensei_count[this] == 20 then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__SasukeChibakuTensei_caster[this]), GetUnitY(s__SasukeChibakuTensei_caster[this]), 500, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasukeChibakuTensei_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and BlzIsUnitInvulnerable(bj_lastCreatedUnit) == false then
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call UnitAddAbility(bj_lastCreatedUnit, 'Arav')
                    call UnitRemoveAbility(bj_lastCreatedUnit, 'Arav')
                    call SetUnitFlyHeight(bj_lastCreatedUnit, 450, 450)
                    call GroupAddUnit(s__SasukeChibakuTensei_damaged[this], bj_lastCreatedUnit)
                    set u=CreateUnit(GetOwningPlayer(s__SasukeChibakuTensei_caster[this]), 'e03T', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), GetUnitFacing(bj_lastCreatedUnit))
                    //call SetUnitTimeScale(u, 2.0)
                    call UnitApplyTimedLife(u, 'BTLF', 4.0)
                    set u=CreateUnit(GetOwningPlayer(s__SasukeChibakuTensei_caster[this]), 'e013', GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
                    call SetUnitFlyHeight(u, 0, 0)
                    call SetUnitFlyHeight(u, 450, 800)
                    call UnitApplyTimedLife(u, 'BTLF', 3.0)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            set u=null
            call DestroyGroup(bj_lastCreatedGroup)
            call TimerStart(NewTimerEx(this), 1.0, false, function s__SasukeChibakuTensei_hide)
        endif
        if s__SasukeChibakuTensei_count[this] > 50 then
            call PauseUnit(s__SasukeChibakuTensei_caster[this], false)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SasukeChibakuTensei_actions takes nothing returns nothing
        local integer this= s__SasukeChibakuTensei_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Sasuke_Rikudou_T_Chibaku, 100, GetTriggerUnit())
        endif
        set s__SasukeChibakuTensei_caster[this]=GetTriggerUnit()
        set s__SasukeChibakuTensei_damaged[this]=CreateGroup()
        call PauseUnit(s__SasukeChibakuTensei_caster[this], true)
        call SetUnitAnimation(s__SasukeChibakuTensei_caster[this], "spell looping")
        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h00V', GetUnitX(s__SasukeChibakuTensei_caster[this]), GetUnitY(s__SasukeChibakuTensei_caster[this]), 0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
        set s__SasukeChibakuTensei_count[this]=0
        call TimerStart(NewTimerEx(this), 0.03, true, function s__SasukeChibakuTensei_periodic)
    endfunction 
    
    function s__SasukeChibakuTensei_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__SasukeChibakuTensei_SPELL_ID ) , Filter(( function s__SasukeChibakuTensei_actions))) // INLINED!!
    endfunction 
    
//===========================================================================
// Trigger: SasukeNewSusanoo
//===========================================================================
// scope SasukeNewSusanoo begins

    
    
//Implemented from module Alloc:
    
        function s__SasukeNewSusanoo___Spell_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)] == 0 ) then
                set s__SasukeNewSusanoo___Spell_Alloc___instanceCount=s__SasukeNewSusanoo___Spell_Alloc___instanceCount + 1
                set this=s__SasukeNewSusanoo___Spell_Alloc___instanceCount
            else
                set this=s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)]
                set s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)]=s__SasukeNewSusanoo___Spell_Alloc___recycle[s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SasukeNewSusanoo___Spell_deallocate takes integer this returns nothing
            set s__SasukeNewSusanoo___Spell_Alloc___recycle[this]=s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)]
            set s__SasukeNewSusanoo___Spell_Alloc___recycle[(0)]=this
        endfunction
        
        
        function s__SasukeNewSusanoo___Spell_destroy takes integer this returns nothing
            call DestroyTrigger(s__SasukeNewSusanoo___Spell_dmgTrig[this])
            set s__SasukeNewSusanoo___Spell_dmgTrig[this]=null
            call KillUnit(s__SasukeNewSusanoo___Spell_susanoo[this])
            call ShowUnit(s__SasukeNewSusanoo___Spell_susanoo[this], false)
            set s__SasukeNewSusanoo___Spell_susanoo[this]=null
            set s__SasukeNewSusanoo___Spell_caster[this]=null
            call s__SasukeNewSusanoo___Spell_deallocate(this)
        endfunction
        
        function s__SasukeNewSusanoo___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real fire_x
            local real fire_y
            local integer i= 0
            local integer i_2
            if s__SasukeNewSusanoo___Spell_count[this] < 150 then
                set s__SasukeNewSusanoo___Spell_count[this]=s__SasukeNewSusanoo___Spell_count[this] + 10
            endif
            call SetUnitAnimation(s__SasukeNewSusanoo___Spell_caster[this], "stand")
            if UnitAlive(s__SasukeNewSusanoo___Spell_susanoo[this]) then
                call SetUnitFlyHeight(s__SasukeNewSusanoo___Spell_caster[this], 300, 0)
            endif
            call SetUnitX(s__SasukeNewSusanoo___Spell_susanoo[this], GetUnitX(s__SasukeNewSusanoo___Spell_caster[this]))
            call SetUnitY(s__SasukeNewSusanoo___Spell_susanoo[this], GetUnitY(s__SasukeNewSusanoo___Spell_caster[this]))
            call SetUnitFacing(s__SasukeNewSusanoo___Spell_susanoo[this], GetUnitFacing(s__SasukeNewSusanoo___Spell_caster[this]))
            call PauseUnit(s__SasukeNewSusanoo___Spell_susanoo[this], true)
            if IsUnitHidden(s__SasukeNewSusanoo___Spell_caster[this]) then
                call SetUnitVertexColor(s__SasukeNewSusanoo___Spell_susanoo[this], 255, 255, 255, 0)
            else
                call SetUnitVertexColor(s__SasukeNewSusanoo___Spell_susanoo[this], 255, 255, 255, s__SasukeNewSusanoo___Spell_count[this])
            endif
            if not udg_SusanooShoot then
                call SetUnitTimeScale(s__SasukeNewSusanoo___Spell_susanoo[this], 2.0)
                if GetUnitCurrentOrder(s__SasukeNewSusanoo___Spell_caster[this]) == String2OrderIdBJ("smart") then
                    call SetUnitAnimationByIndex(s__SasukeNewSusanoo___Spell_susanoo[this], 3)
                else
                    call SetUnitAnimationByIndex(s__SasukeNewSusanoo___Spell_susanoo[this], 0)
                endif
            endif
	    set s__SasukeNewSusanoo___Spell_duration[this]=s__SasukeNewSusanoo___Spell_duration[this] + 0.03
	    if GetWidgetLife(s__SasukeNewSusanoo___Spell_susanoo[this]) < 0.405 or not UnitAlive(s__SasukeNewSusanoo___Spell_susanoo[this]) then
                call SetUnitFlyHeight(s__SasukeNewSusanoo___Spell_caster[this], 0, 1500)
                call SetUnitVertexColor(s__SasukeNewSusanoo___Spell_caster[this], 255, 255, 255, 255)
            endif
            if s__SasukeNewSusanoo___Spell_duration[this] > 25 or GetWidgetLife(s__SasukeNewSusanoo___Spell_caster[this]) < 0.405 then
                call SetUnitVertexColor(s__SasukeNewSusanoo___Spell_caster[this], 255, 255, 255, 255)
                //call AddUnitAnimationProperties(this.caster, "alternate", false)
                call UnitRemoveAbility(s__SasukeNewSusanoo___Spell_caster[this], 'A0CS')
                //call UnitRemoveAbility(this.caster, 'A0CR')
                //call UnitRemoveAbility(this.caster, 'A0P1')
		        call UnitAddAbility(s__SasukeNewSusanoo___Spell_caster[this], 'A0NQ')
                call UnitRemoveAbility(s__SasukeNewSusanoo___Spell_caster[this], 'B00Y')
                //call SetPlayerAbilityAvailable(GetOwningPlayer(this.caster), 'A0MA', true)
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__SasukeNewSusanoo___Spell_caster[this]), 'A0KV', true)
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__SasukeNewSusanoo___Spell_caster[this]), 'A0XY', true)
                loop
                    set i=i + 1
                    exitwhen i > 2
                    set i_2=0
                    loop
                        set i_2=i_2 + 1
                        exitwhen i_2 > 10
                        set fire_x=GetUnitX(s__SasukeNewSusanoo___Spell_caster[this]) + Cos(Deg2Rad(36 * i_2)) * ( 100 * i )
