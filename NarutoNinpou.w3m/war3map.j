        if s__GaaraKidSandDrizzle_count[this] > 5 then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__GaaraKidSandDrizzle_target_x[this], s__GaaraKidSandDrizzle_target_y[this], 400, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__GaaraKidSandDrizzle_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(s__GaaraKidSandDrizzle_caster[this], bj_lastCreatedUnit, ( GetUnitAbilityLevel(s__GaaraKidSandDrizzle_caster[this], s__GaaraKidSandDrizzle_SPELL_ID) * GetHeroAgi(s__GaaraKidSandDrizzle_caster[this], true) ) / 100, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        set s__GaaraKidSandDrizzle_count[this]=s__GaaraKidSandDrizzle_count[this] + 1
        if s__GaaraKidSandDrizzle_count[this] > 50 then
            call KillUnit(s__GaaraKidSandDrizzle_rain[this])
            call s__GaaraKidSandDrizzle_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__GaaraKidSandDrizzle_actions takes nothing returns nothing
        local integer this= s__GaaraKidSandDrizzle_allocate()
        set s__GaaraKidSandDrizzle_caster[this]=GetTriggerUnit()
        set s__GaaraKidSandDrizzle_target_x[this]=GetSpellTargetX()
        set s__GaaraKidSandDrizzle_target_y[this]=GetSpellTargetY()
        set s__GaaraKidSandDrizzle_count[this]=0
        set s__GaaraKidSandDrizzle_rain[this]=CreateUnit(GetTriggerPlayer(), 'e08F', s__GaaraKidSandDrizzle_target_x[this], s__GaaraKidSandDrizzle_target_y[this], 270)
	//call SlowAura(this.rain, 0.3, 400) 
        call SetUnitTimeScale(s__GaaraKidSandDrizzle_rain[this], 3)
        call TimerStart(NewTimerEx(this), 0.05, true, function s__GaaraKidSandDrizzle_periodic)
    endfunction 

    function s__GaaraKidSandDrizzle_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(15 , s__GaaraKidSandDrizzle_SPELL_ID , function s__GaaraKidSandDrizzle_actions)
    endfunction 

//===========================================================================
// Trigger: GaaraPassive
//===========================================================================

    function s__GaaraPassive_actions takes nothing returns nothing
        local real damage
        if ( GetUnitTypeId(GetAttacker()) == 'H00C' or GetUnitTypeId(GetAttacker()) == 'H0A1' ) then
            set damage=5 * GetHeroLevel(GetAttacker())
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 250, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(GetAttacker())) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
		    if IsUnitIllusion(GetAttacker()) then
                    	call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, damage / 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		    else
                    	call UnitDamageTarget(GetAttacker(), bj_lastCreatedUnit, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		    endif
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
    endfunction 

    function s__GaaraPassive_onInit takes nothing returns nothing
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__GaaraPassive_actions))) // INLINED!!
    endfunction 
    
