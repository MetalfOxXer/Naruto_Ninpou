 function s__KabutoPull_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__KabutoPull_dummy[this])
  local real y= GetUnitY(s__KabutoPull_dummy[this])
  local real new_x= (((x )*1.0) + Cos((( s__KabutoPull_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( s__KabutoPull_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_x2= (((new_x )*1.0) + Cos((( s__KabutoPull_angle[this] )*1.0)) * (( 120)*1.0)) // INLINED!!
  local real new_y2= (((new_y )*1.0) + Sin((( s__KabutoPull_angle[this] )*1.0)) * (( 120)*1.0)) // INLINED!!
  local integer i
		call SetUnitAnimation(s__KabutoPull_caster[this], "spell three")
		call SetUnitFacing(s__KabutoPull_caster[this], Rad2Deg(s__KabutoPull_angle[this]))
		call SetUnitX(s__KabutoPull_dummy[this], new_x)
		call SetUnitY(s__KabutoPull_dummy[this], new_y)


		set s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]]=AddSpecialEffect("war3mapImported\\White_Snake.mdl", new_x2, new_y2)
		call BlzSetSpecialEffectScale(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], 0.8)
		call BlzSetSpecialEffectHeight(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], 50 + GetPointZ(new_x2 , new_y2))
		call BlzSetSpecialEffectPitch(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], 1.57)
		call BlzSetSpecialEffectTimeScale(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], 5.0)
		call BlzPlaySpecialEffect(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+s__KabutoPull_count[this]], ANIM_TYPE_BIRTH)

		set s___KabutoPull_snakess[s__KabutoPull_snakess[this]+s__KabutoPull_count[this]]=AddSpecialEffect("war3mapImported\\Snake_2.mdl", new_x2, new_y2)
		call BlzSetSpecialEffectYaw(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+s__KabutoPull_count[this]], s__KabutoPull_angle[this])
		call BlzSetSpecialEffectScale(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+s__KabutoPull_count[this]], 0.8)
		call BlzSetSpecialEffectHeight(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+s__KabutoPull_count[this]], 50 + GetPointZ(new_x2 , new_y2))
		//call BlzSetSpecialEffectPitch(snakess[this.count], 1.57)
		call BlzSetSpecialEffectTimeScale(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+s__KabutoPull_count[this]], 1.0)
		//call BlzPlaySpecialEffect(snakess[this.count], ANIM_TYPE_WALK)

		set s__KabutoPull_count[this]=s__KabutoPull_count[this] + 1
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KabutoPull_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                		set s__KabutoPull_target[this]=bj_lastCreatedUnit
				set s__KabutoPull_found[this]=true
				call UnitDamageTarget(s__KabutoPull_caster[this], s__KabutoPull_target[this], GetHeroInt(s__KabutoPull_caster[this], true) * GetUnitAbilityLevel(s__KabutoPull_caster[this], s__KabutoPull_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
				call StunUnitTimed(s__KabutoPull_caster[this] , s__KabutoPull_target[this] , 1.5)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if s__KabutoPull_count[this] > 17 or s__KabutoPull_found[this] then
			if not s__KabutoPull_found[this] then
				set i=0
				loop
					call DestroyEffect(s___KabutoPull_snakes[s__KabutoPull_snakes[this]+i])
					set s___KabutoPull_snakes[s__KabutoPull_snakes[this]+i]=null
					call BlzSetSpecialEffectX(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+i], 11705)
					call BlzSetSpecialEffectY(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+i], 8008)
					call DestroyEffect(s___KabutoPull_snakess[s__KabutoPull_snakess[this]+i])
					set s___KabutoPull_snakess[s__KabutoPull_snakess[this]+i]=null
					set i=i + 1
					exitwhen i > 17
				endloop
				call s__KabutoPull_destroy(this)
				call ReleaseTimer(GetExpiredTimer())
			else
				call TimerStart(NewTimerEx(this), 0.02, true, function s__KabutoPull_pull)
				call ReleaseTimer(GetExpiredTimer())
			endif
		endif
 endfunction 

 function s__KabutoPull_actions takes nothing returns nothing
  local integer this= s__KabutoPull__allocate()
		set s__KabutoPull_caster[this]=GetTriggerUnit()
		set s__KabutoPull_angle[this]=Atan3(GetUnitX(s__KabutoPull_caster[this]) , GetUnitY(s__KabutoPull_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
