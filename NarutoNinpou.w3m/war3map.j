            set s__TentenNewSemi_count3[this]=0
            set s__TentenNewSemi_dist[this]=GetDistanceUnits(s__TentenNewSemi_dummy[this] , s__TentenNewSemi_target[this])
            call TimerStartEx(NewTimerEx(this) , 0.020 , true , function s__TentenNewSemi_circle , "TentenNewSemi_circle")
            call ReleaseTimer(GetExpiredTimer())
        elseif s__TentenNewSemi_count[this] > 30 then
	    call s__TentenNewSemi_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
