    function s__KaguyaSemi_removeAbility takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitRemoveAbility(s__KaguyaSemi_caster[this], 'A0IX')
