            set s__TentenTensasai__Spell_count[this]=0
            set s__TentenTensasai__Spell_damaged[this]=CreateGroup()
            set s__TentenTensasai__Spell_angle[this]=Atan3(GetUnitX(s__TentenTensasai__Spell_caster[this]) , GetUnitY(s__TentenTensasai__Spell_caster[this]) , s__TentenTensasai__Spell_target_x[this] , s__TentenTensasai__Spell_target_y[this])
            set s__TentenTensasai__Spell_target_x2[this]=(((s__TentenTensasai__Spell_target_x[this] )*1.0) + Cos((( s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
            set s__TentenTensasai__Spell_target_y2[this]=(((s__TentenTensasai__Spell_target_y[this] )*1.0) + Sin((( s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
            set s__TentenTensasai__Spell_scroll[this]=CreateUnit(GetTriggerPlayer(), 'otbk', s__TentenTensasai__Spell_target_x2[this], s__TentenTensasai__Spell_target_y2[this], Rad2Deg(s__TentenTensasai__Spell_angle[this]) + 90)
            call TimerStartEx(NewTimerEx(this) , 0.1 , false , function s__TentenTensasai__Spell_delay , "TentenNewD_delay")
        endfunction 
        
