				endif
				call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 
	
        function s__SpawnCreeps_anbudeath takes nothing returns nothing
      local integer SpawnItem
		    if GetUnitTypeId(GetTriggerUnit()) == 'uabo' then
				if GetTriggerUnit() == s__SpawnCreeps_ForestAnbu1 then
					if udg_Mode30Min then
