    function s__YamanakaTech_delay2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        //call PauseUnit(this.caster, false)
        //call PauseUnit(this.target, false)
	if GetUnitTypeId(s__YamanakaTech_target[this]) != 'n00Q' then
        	call SetUnitAnimation(s__YamanakaTech_target[this], "death")
