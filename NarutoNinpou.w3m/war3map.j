		set bj_lastCreatedUnit=FirstOfGroup(s__OhnokiGenkiHakuri_damaged[this])
		exitwhen bj_lastCreatedUnit == null
		call GroupRemoveUnit(s__OhnokiGenkiHakuri_damaged[this], bj_lastCreatedUnit)
		call PauseUnit(bj_lastCreatedUnit, false)
        	call ShowUnit(bj_lastCreatedUnit, true)
		call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
        	call SetUnitAnimation(bj_lastCreatedUnit, "death")
        	call UnitDamageTarget(s__OhnokiGenkiHakuri_caster[this], bj_lastCreatedUnit, 500.00 * GetUnitAbilityLevel(s__OhnokiGenkiHakuri_caster[this], 'A0EV') + 5.0 * GetHeroInt(s__OhnokiGenkiHakuri_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
	endloop
        call s__OhnokiGenkiHakuri_destroy(this)
