    function s__ObitoKaton_timer takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	set s__ObitoKaton_tobi_cooldown1=s__ObitoKaton_tobi_cooldown1 - 1
	if s__ObitoKaton_tobi_cooldown1 <= 0 then
            call ReleaseTimer(GetExpiredTimer())
	    call s__ObitoKaton_deallocate(this)
	endif
    endfunction 
        
        function s__ObitoKaton_destroy takes integer this returns nothing
            local integer i= 0
            loop
                exitwhen i > 2
                call KillUnit(s__ObitoKaton__tornadoes[(this)*(1)+i])
                set s__ObitoKaton__tornadoes[(this)*(1)+i]= null
                set i=i + 1
            endloop
            call DestroyGroup(s__ObitoKaton_damaged[this])
            set s__ObitoKaton_damaged[this]=null
            set s__ObitoKaton_caster[this]=null
            call s__ObitoKaton_deallocate(this)
        endfunction
        
        function s__ObitoKaton_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real tornadoes_x
            local real tornadoes_y
            local real new_x
            local real new_y
            local real x
            local real y
            local integer i= 0
            local unit u
            set s__ObitoKaton_count[this]=s__ObitoKaton_count[this] + 1
            loop
                exitwhen i > 2
                set tornadoes_x=GetUnitX(s__ObitoKaton__tornadoes[(this)*(1)+i])
                set tornadoes_y=GetUnitY(s__ObitoKaton__tornadoes[(this)*(1)+i])
                set new_x=tornadoes_x + Cos(Deg2Rad(GetUnitFacing(s__ObitoKaton__tornadoes[(this)*(1)+i]))) * 30
                set new_y=tornadoes_y + Sin(Deg2Rad(GetUnitFacing(s__ObitoKaton__tornadoes[(this)*(1)+i]))) * 30
                call SetUnitX(s__ObitoKaton__tornadoes[(this)*(1)+i], new_x)
                call SetUnitY(s__ObitoKaton__tornadoes[(this)*(1)+i], new_y)
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 110.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoKaton_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                        
                        if not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoKaton_damaged[this]) then
			    if GetUnitTypeId(s__ObitoKaton_caster[this]) == 'U00D' then
				call UnitDamageTarget(s__ObitoKaton_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__ObitoKaton_caster[this], 'A13O'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			    else
                            	call UnitDamageTarget(s__ObitoKaton_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__ObitoKaton_caster[this], 'A17Y'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                            endif
			    call GroupAddUnit(s__ObitoKaton_damaged[this], bj_lastCreatedUnit)
                        endif
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
                set i=i + 1
            endloop
            if s__ObitoKaton_count[this] > 25 then
                call s__ObitoKaton_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
            set u=null
        endfunction
        
        function s__ObitoKaton_actions takes nothing returns nothing
            local integer this= s__ObitoKaton_allocate()
     local integer this2
            local real caster_x
            local real caster_y
            local real target_x= GetSpellTargetX()
            local real target_y= GetSpellTargetY()
            local real angle
            local integer i= 0
            set s__ObitoKaton_damaged[this]=CreateGroup()
            set s__ObitoKaton_caster[this]=GetTriggerUnit()
	    set this2=s__ObitoKaton_allocate()
   	    set s__ObitoKaton_tobi_cooldown1=15
            set caster_x=GetUnitX(s__ObitoKaton_caster[this])
            set caster_y=GetUnitY(s__ObitoKaton_caster[this])
            set angle=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            loop
                exitwhen i > 2
                set s__ObitoKaton__tornadoes[(this)*(1)+i]= (CreateUnit((GetTriggerPlayer() ), ( 'e04C' ), (( caster_x )*1.0), (( caster_y )*1.0), (( Rad2Deg(angle) + 30 - 30 * i)*1.0))) // INLINED!!
                call SetUnitX(s__ObitoKaton__tornadoes[(this)*(1)+i], caster_x)
                call SetUnitY(s__ObitoKaton__tornadoes[(this)*(1)+i], caster_y)
                call SetUnitAnimation(s__ObitoKaton__tornadoes[(this)*(1)+i], "birth")
                set i=i + 1
            endloop
	    call DestroyEffect(AddSpecialEffect(("Shockwave.mdx" ), (( GetUnitX(s__ObitoKaton_caster[this]) )*1.0), (( GetUnitY(s__ObitoKaton_caster[this]))*1.0))) // INLINED!!
		set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, caster_x, caster_y, 300.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoKaton_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                        if not IsUnitInGroup(bj_lastCreatedUnit, s__ObitoKaton_damaged[this]) then
			    if GetUnitTypeId(s__ObitoKaton_caster[this]) == 'U00D' then
				call UnitDamageTarget(s__ObitoKaton_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__ObitoKaton_caster[this], 'A13O'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			    else
                            	call UnitDamageTarget(s__ObitoKaton_caster[this], bj_lastCreatedUnit, 80 * GetUnitAbilityLevel(s__ObitoKaton_caster[this], 'A17Y'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                            endif
			    call GroupAddUnit(s__ObitoKaton_damaged[this], bj_lastCreatedUnit)
                        endif
                    endif
