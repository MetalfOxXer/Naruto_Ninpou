        local real y= GetUnitY(s__MinatoJouninD_kunai[this])
        local real new_x= (((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__MinatoJouninD_kunai[this])) )*1.0)) * (( 15)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__MinatoJouninD_kunai[this])) )*1.0)) * (( 15)*1.0)) // INLINED!!
        set s__MinatoJouninD_count[this]=s__MinatoJouninD_count[this] + 1
        call SetUnitX(s__MinatoJouninD_kunai[this], new_x)
        call SetUnitY(s__MinatoJouninD_kunai[this], new_y)
        if s__MinatoJouninD_count[this] > 60 then
            call KillUnit(s__MinatoJouninD_kunai[this])
