    function s__Yasaka_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__Yasaka_missile[this])
        local real y= GetUnitY(s__Yasaka_missile[this])
        local real angle= Atan3(x , y , GetUnitX(s__Yasaka_target[this]) , GetUnitY(s__Yasaka_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local integer i
        call SetUnitX(s__Yasaka_missile[this], new_x)
        call SetUnitY(s__Yasaka_missile[this], new_y)
        if GetDistance(x , y , GetUnitX(s__Yasaka_target[this]) , GetUnitY(s__Yasaka_target[this])) < 50 then
            set i=0
            set x=GetUnitX(s__Yasaka_target[this])
            set y=GetUnitY(s__Yasaka_target[this])
            loop
                exitwhen i > 10
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100.0)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100.0)*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Doom\\DoomTarget.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call KillUnit(s__Yasaka_missile[this])
            set s__Yasaka_missile[this]=null
            call UnitDamageTarget(s__Yasaka_caster[this], s__Yasaka_target[this], 9 * GetHeroInt(s__Yasaka_caster[this], true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
	    call StunUnitTimed(s__Yasaka_caster[this] , s__Yasaka_target[this] , 1.5)
            call s__Yasaka_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__Yasaka_actions takes nothing returns nothing
        local integer this= s__Yasaka_allocate()
