        local integer i= 0
        set s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this]]= CreateUnit(GetOwningPlayer(s__OrochimaruSenei_caster[this]), 'e007', x, y, Rad2Deg(s__OrochimaruSenei_angle[this]))
        call SetUnitScale(s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this]], scale, 0, 0)
        if s__OrochimaruSenei_count[this] == 0 then
            set s__s__OrochimaruSenei_snakes2[(this)*(1)+s__OrochimaruSenei_count[this]]= CreateUnit(GetOwningPlayer(s__OrochimaruSenei_caster[this]), 'ndtb', GetUnitX(s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this]]), GetUnitY(s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this]]), Rad2Deg(s__OrochimaruSenei_angle[this]))
        else
            set s__s__OrochimaruSenei_snakes2[(this)*(1)+s__OrochimaruSenei_count[this]]= CreateUnit(GetOwningPlayer(s__OrochimaruSenei_caster[this]), 'ndtb', GetUnitX(s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this] - 1]), GetUnitY(s__s__OrochimaruSenei_snakes1[(this)*(1)+s__OrochimaruSenei_count[this] - 1]), Rad2Deg(s__OrochimaruSenei_angle[this]))
        endif
        call SetUnitFlyHeight(s__s__OrochimaruSenei_snakes2[(this)*(1)+s__OrochimaruSenei_count[this]], GetRandomReal(0, 150), 0)
        call SetUnitScale(s__s__OrochimaruSenei_snakes2[(this)*(1)+s__OrochimaruSenei_count[this]], scale, 0, 0)
        call SetUnitAnimation(s__s__OrochimaruSenei_snakes2[(this)*(1)+s__OrochimaruSenei_count[this]], "death")
	set s__OrochimaruSenei_count[this]=s__OrochimaruSenei_count[this] + 1
        if s__OrochimaruSenei_count[this] > 9 then
	    set i=0
            loop
                exitwhen i > 9
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__s__OrochimaruSenei_snakes1[(this)*(1)+i]), GetUnitY(s__s__OrochimaruSenei_snakes1[(this)*(1)+i]), 200, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__OrochimaruSenei_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__OrochimaruSenei_damaged[this]) then
                        call UnitDamageTarget(s__OrochimaruSenei_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__OrochimaruSenei_caster[this], true) * GetUnitAbilityLevel(s__OrochimaruSenei_caster[this], s__OrochimaruSenei_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                        call GroupAddUnit(s__OrochimaruSenei_damaged[this], bj_lastCreatedUnit)
                        set angle=Atan3(GetUnitX(s__OrochimaruSenei_caster[this]) , GetUnitY(s__OrochimaruSenei_caster[this]) , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit))
                        set x=(((GetUnitX(s__OrochimaruSenei_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
                        set y=(((GetUnitY(s__OrochimaruSenei_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
                        call SetUnitPosition(bj_lastCreatedUnit, x, y)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
                set i=i + 1
            endloop
            call PauseUnit(s__OrochimaruSenei_caster[this], false)
	    call SetUnitAnimation(s__OrochimaruSenei_caster[this], "stand")
            call TimerStart(NewTimerEx(this), 0.03, true, function s__OrochimaruSenei_periodic2)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__OrochimaruSenei_actions takes nothing returns nothing
        local integer this= s__OrochimaruSenei_allocate()
 local real x
 local real y
        set s__OrochimaruSenei_caster[this]=GetTriggerUnit()
        set s__OrochimaruSenei_count[this]=0
        set s__OrochimaruSenei_damaged[this]=CreateGroup()
        set s__OrochimaruSenei_angle[this]=Atan3(GetUnitX(s__OrochimaruSenei_caster[this]) , GetUnitY(s__OrochimaruSenei_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__OrochimaruSenei_missile[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__OrochimaruSenei_caster[this]), GetUnitY(s__OrochimaruSenei_caster[this]), 270)
	set x=(((GetUnitX(s__OrochimaruSenei_caster[this]) )*1.0) + Cos((( s__OrochimaruSenei_angle[this] )*1.0)) * (( 200)*1.0)) // INLINED!!
	set y=(((GetUnitY(s__OrochimaruSenei_caster[this]) )*1.0) + Sin((( s__OrochimaruSenei_angle[this] )*1.0)) * (( 200)*1.0)) // INLINED!!
        call PauseUnit(s__OrochimaruSenei_caster[this], true)
        call SetUnitAnimation(s__OrochimaruSenei_caster[this], "spell three")
        call TimerStart(NewTimerEx(this), 0.02, true, function s__OrochimaruSenei_periodic)
    endfunction 

    function s__OrochimaruSenei_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(25 , s__OrochimaruSenei_SPELL_ID , function s__OrochimaruSenei_actions)
    endfunction 


//===========================================================================
// Trigger: Rashimon INIT
//===========================================================================
function Trig_Rashimon_INIT_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rashimon_INIT_Actions takes nothing returns nothing
    local integer i
    local real x
    local real y
    local real x2
    local real y2
    local real x3
    local real y3
    local integer j
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
    call PlaySoundOnUnitBJ(gg_snd_Orochimaru_W, 100.0, GetTriggerUnit())
            endif
    set udg_RASHO_CASTER=GetTriggerUnit()
	set bj_lastCreatedGroup=CreateGroup()
	call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 400, null)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		if IsUnitAlly(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
			call GroupAddUnit(udg_RashimonGroup, bj_lastCreatedUnit)
		       	if (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I00M'))) then // INLINED!!
			else
				call PauseUnit(bj_lastCreatedUnit, true)
			endif
			call SetUnitInvulnerable(bj_lastCreatedUnit, true)
		endif
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
	endloop
	call DestroyGroup(bj_lastCreatedGroup)
    call SetUnitInvulnerable(udg_RASHO_CASTER, true)
    call AddLoadingBar(GetTriggerUnit() , 2.0)
    call SlowArea(GetTriggerUnit() , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 300)
    call SetUnitAnimation(udg_RASHO_CASTER, "spell")
    set i=0
    loop
        exitwhen i > 2
        set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(GetTriggerUnit())) )*1.0)) * (( 100 + 200 * i)*1.0)) // INLINED!!
        set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(GetTriggerUnit())) )*1.0)) * (( 100 + 200 * i)*1.0)) // INLINED!!
        //call AddSpecialEffectEx("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", x, y)
	if i == 0 then
        	set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h01Z', x, y, GetUnitFacing(GetTriggerUnit()))
	elseif i == 1 then
        	set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h01X', x, y, GetUnitFacing(GetTriggerUnit()))
	elseif i == 2 then
        	set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h03P', x, y, GetUnitFacing(GetTriggerUnit()))
	endif
        call SetUnitAbilityLevel(bj_lastCreatedUnit, 'h03P', GetUnitAbilityLevel(udg_RASHO_CASTER, 'A0CU'))
        call IssueImmediateOrder(bj_lastCreatedUnit, "thunderclap")
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
	call SetUnitAnimation(bj_lastCreatedUnit, "birth")
	set x2=(((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) + 90) )*1.0)) * (( - 150)*1.0)) // INLINED!!
	set y2=(((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) + 90) )*1.0)) * (( - 150)*1.0)) // INLINED!!
	set j=0
        loop
		exitwhen j > 5
		set j=j + 1
		set x3=(((x )*1.0) + Cos((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) + 90) )*1.0)) * (( - 150 + 60 * j)*1.0)) // INLINED!!
		set y3=(((y )*1.0) + Sin((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) + 90) )*1.0)) * (( - 150 + 60 * j)*1.0)) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x3 )*1.0), (( y3)*1.0))) // INLINED!!
        endloop
	call TriggerSleepAction(0.1)
        set i=i + 1
    endloop
    set bj_lastCreatedGroup=CreateGroup()
    call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300, null)
    loop
        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
        exitwhen bj_lastCreatedUnit == null
        if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) then
            //call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 50 * GetUnitAbilityLevel(GetTriggerUnit(), 'A0CU'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
        endif
        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
    endloop
    call DestroyGroup(bj_lastCreatedGroup)
    call TriggerSleepAction(1.8)
    call SetUnitInvulnerable(udg_RASHO_CASTER, false)
	loop
		set bj_lastCreatedUnit=FirstOfGroup(udg_RashimonGroup)
		exitwhen bj_lastCreatedUnit == null
		call PauseUnit(bj_lastCreatedUnit, false)
		call SetUnitInvulnerable(bj_lastCreatedUnit, false)
		call GroupRemoveUnit(udg_RashimonGroup, bj_lastCreatedUnit)
	endloop
endfunction

//===========================================================================
function InitTrig_Rashimon_INIT takes nothing returns nothing
    set gg_trg_Rashimon_INIT=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Rashimon_INIT, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Rashimon_INIT, Condition(function Trig_Rashimon_INIT_Conditions))
    call TriggerAddAction(gg_trg_Rashimon_INIT, function Trig_Rashimon_INIT_Actions)
    call EnableTriggerForId(25 , gg_trg_Rashimon_INIT)
endfunction


//===========================================================================
// Trigger: Rashimon Dies
//===========================================================================

function Trig_Rashimon_Dies_Actions takes nothing returns nothing
	if GetUnitTypeId(GetTriggerUnit()) == 'h03P' or GetUnitTypeId(GetTriggerUnit()) == 'h01Z' or GetUnitTypeId(GetTriggerUnit()) == 'h01X' then
    call ShowUnitHide(GetTriggerUnit())
    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
	endif
endfunction

//===========================================================================
function InitTrig_Rashimon_Dies takes nothing returns nothing
	call RegisterPlayerUnitEventForId(25 , EVENT_PLAYER_UNIT_DEATH , function Trig_Rashimon_Dies_Actions)
endfunction


