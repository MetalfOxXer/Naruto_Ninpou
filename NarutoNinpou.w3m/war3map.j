// Trigger: YamanakaSemiChoice
//===========================================================================
//textmacro instance: UltimateChoice("YamanakaSemi", "A1E5", "A037", "PUPPET", "Soul Puppet", "A1E4", "BINDING", "Soul Binding")

//Implemented from module Alloc:
    
        function s__YamanakaSemiUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__YamanakaSemiUltimateChoice_Alloc___instanceCount=s__YamanakaSemiUltimateChoice_Alloc___instanceCount + 1
                set this=s__YamanakaSemiUltimateChoice_Alloc___instanceCount
            else
                set this=s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)]
                set s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)]=s__YamanakaSemiUltimateChoice_Alloc___recycle[s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__YamanakaSemiUltimateChoice_deallocate takes integer this returns nothing
            set s__YamanakaSemiUltimateChoice_Alloc___recycle[this]=s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)]
            set s__YamanakaSemiUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__YamanakaSemiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__YamanakaSemiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__YamanakaSemiUltimateChoice_caster[this]), 'A1E5', false)
        else
            call s__YamanakaSemiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__YamanakaSemiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__YamanakaSemiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__YamanakaSemiUltimateChoice_u, s__YamanakaSemiUltimateChoice_PUPPET)
            call UnitMakeAbilityPermanent(s__YamanakaSemiUltimateChoice_u, true, s__YamanakaSemiUltimateChoice_PUPPET)
        else
            call UnitAddAbility(s__YamanakaSemiUltimateChoice_u, s__YamanakaSemiUltimateChoice_BINDING)
            call UnitMakeAbilityPermanent(s__YamanakaSemiUltimateChoice_u, true, s__YamanakaSemiUltimateChoice_BINDING)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A1E5', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A1E5', false)
        set s__s__YamanakaSemiUltimateChoice_b[0]= null
        set s__s__YamanakaSemiUltimateChoice_b[1]= null
        set s__YamanakaSemiUltimateChoice_u=null
        call s__Dialog_destroy(s__YamanakaSemiUltimateChoice_d)
        call DestroyBoolExpr(s__YamanakaSemiUltimateChoice_pick)
        set s__YamanakaSemiUltimateChoice_pick=null
        set this=s__YamanakaSemiUltimateChoice_allocate()
        set s__YamanakaSemiUltimateChoice_caster[this]=s__YamanakaSemiUltimateChoice_u
        set s__YamanakaSemiUltimateChoice_pp[this]=GetOwningPlayer(s__YamanakaSemiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__YamanakaSemiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__YamanakaSemiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__YamanakaSemiUltimateChoice_PUPPET) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__YamanakaSemiUltimateChoice_BINDING) == 0 then
            set s__YamanakaSemiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__YamanakaSemiUltimateChoice_d,"Pick a skill")
            set s__s__YamanakaSemiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__YamanakaSemiUltimateChoice_d)], ("Soul Puppet" ), ( 0))) // INLINED!!
            set s__s__YamanakaSemiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__YamanakaSemiUltimateChoice_d)], ("Soul Binding" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__YamanakaSemiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__YamanakaSemiUltimateChoice_d,s__YamanakaSemiUltimateChoice_pick)
            set s__YamanakaSemiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__YamanakaSemiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A1E5' then
            set s__YamanakaSemiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__YamanakaSemiUltimateChoice_onInit takes nothing returns nothing
        set s__YamanakaSemiUltimateChoice_pick=Condition(function s__YamanakaSemiUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__YamanakaSemiUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A1E5' ) , Filter(( function s__YamanakaSemiUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("YamanakaSemi", "A1E5", "A037", "PUPPET", "Soul Puppet", "A1E4", "BINDING", "Soul Binding")

