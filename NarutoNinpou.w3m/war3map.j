    function s__ShisuiSpear_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ShisuiSpear_caster[this])
        local real y= GetUnitY(s__ShisuiSpear_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__ShisuiSpear_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__ShisuiSpear_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real x2
        local real y2
	if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
        	call SetUnitX(s__ShisuiSpear_caster[this], new_x)
        	call SetUnitY(s__ShisuiSpear_caster[this], new_y)
        	call SetUnitX(shisui_susanoo, new_x)
        	call SetUnitY(shisui_susanoo, new_y)
	endif
        call SetUnitFacing(s__ShisuiSpear_caster[this], Rad2Deg(s__ShisuiSpear_angle[this]))
        set s__ShisuiSpear_count[this]=s__ShisuiSpear_count[this] + 1
        if ModuloInteger(s__ShisuiSpear_count[this], 5) == 0 then
            set x2=(((x )*1.0) + Cos((( s__ShisuiSpear_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set y2=(((y )*1.0) + Sin((( s__ShisuiSpear_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("BurningEffect.mdl", x2, y2)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__ShisuiSpear_angle[this])
	        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.25)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
            call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.4)*1.0) , false) // INLINED!!

            set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdl", x2, y2)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__ShisuiSpear_angle[this])
	        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.25)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
            call DestroyEffect(bj_lastCreatedEffect)
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ShisuiSpear_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call UnitDamageTarget(s__ShisuiSpear_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__ShisuiSpear_caster[this], true) * 5, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
		call StunUnitTimed(s__ShisuiSpear_caster[this] , bj_lastCreatedUnit , 1.0)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__ShisuiSpear_knockback)
                set s__ShisuiSpear_target[this]=bj_lastCreatedUnit
                set s__ShisuiSpear_count[this]=0
            	call PauseUnit(s__ShisuiSpear_caster[this], false)
                    
                set bj_lastCreatedEffect=AddSpecialEffect("FireCrack.mdl", GetUnitX(s__ShisuiSpear_target[this]), GetUnitY(s__ShisuiSpear_target[this]))
                call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
                //call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(this.target), GetUnitY(this.target)))
                call DestroyEffect(bj_lastCreatedEffect)

                call ReleaseTimer(GetExpiredTimer())
                call DestroyGroup(bj_lastCreatedGroup)
                return
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__ShisuiSpear_count[this] > 900 / 35.0 then
            call PauseUnit(s__ShisuiSpear_caster[this], false)
            set udg_SusanooDrill=false
            call s__ShisuiSpear_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

