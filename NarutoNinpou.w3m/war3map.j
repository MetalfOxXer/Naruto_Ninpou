        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToneriT_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__ToneriT_damaged[this]) then
                call GroupAddUnit(s__ToneriT_damaged[this], bj_lastCreatedUnit)
                call UnitDamageTarget(s__ToneriT_caster[this], bj_lastCreatedUnit, 8.0 * GetHeroInt(s__ToneriT_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__ToneriT_count[this]=s__ToneriT_count[this] + 1
        if s__ToneriT_count[this] >= 35 then
	    call KillUnit(s__ToneriT_ball[this])
	    set s__ToneriT_ball[this]=null
	    call SetUnitFlyHeight(s__ToneriT_caster[this], 0, 0)
	    call PauseUnit(s__ToneriT_caster[this], false)
	    call SetUnitInvulnerable(s__ToneriT_caster[this], false)
            call KillUnit(s__ToneriT_dummy[this])
            call ShowUnit(s__ToneriT_dummy[this], false)
            set s__ToneriT_dummy[this]=null
            call DestroyGroup(s__ToneriT_damaged[this])
            set s__ToneriT_damaged[this]=null
            call s__Lightning_release((s__ToneriT_l[this]),0.) // INLINED!!
            call TimerStart(NewTimerEx(this), 0.4, false, function s__ToneriT_explode)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__ToneriT_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
