					call TimerStart(NewTimerEx(this2), 0.03, true, function s__KimimaroKaramatsu_knockback)
				endif
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			call SetUnitFlyHeight(s__KimimaroKaramatsu_caster[this], 0, 0)
			//call PauseUnit(this.caster, false)
			call SetUnitTimeScale(s__KimimaroKaramatsu_caster[this], 1.0)
			//call SetUnitInvulnerable(this.caster, false)
			call s__KimimaroKaramatsu_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		endif
