        if s__SasukeGenjutsu_count[this] >= 20 then
            call UnitDamageTarget(s__SasukeGenjutsu_caster[this], s__SasukeGenjutsu_target[this], 3.0 * GetHeroInt(s__SasukeGenjutsu_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
