			call SetUnitY(s__ZetsuNewMayfly_dummy[this], GetUnitY(s__ZetsuNewMayfly_caster[this]))
			call SetUnitFacing(s__ZetsuNewMayfly_dummy[this], GetUnitFacing(s__ZetsuNewMayfly_caster[this]))
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ZetsuNewMayfly_caster[this]), GetUnitY(s__ZetsuNewMayfly_caster[this]), 350, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ZetsuNewMayfly_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
					call UnitDamageTarget(s__ZetsuNewMayfly_caster[this], bj_lastCreatedUnit, GetHeroInt(s__ZetsuNewMayfly_caster[this], true) / 50 * GetUnitAbilityLevel(s__ZetsuNewMayfly_caster[this], s__ZetsuNewMayfly_SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
			set i=1
			loop
				exitwhen i > 4
				set angle=GetRandomReal(0, 2 * bj_PI)
				set offset=GetRandomReal(0, 100)
				set x=(((GetUnitX(s__ZetsuNewMayfly_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
				set y=(((GetUnitY(s__ZetsuNewMayfly_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
				call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
				set i=i + 1
			endloop
		endif
 endfunction 

 function s__ZetsuNewMayfly_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		if s__ZetsuSpore_ZetsuE then
           		call UnitAddAbility(s__ZetsuNewMayfly_caster[this], 'A0SG')
		endif
		if GetUnitTypeId(s__ZetsuNewMayfly_caster[this]) != 'H01W' then
			call SetUnitVertexColor(s__ZetsuNewMayfly_caster[this], 255, 255, 255, 125)
		else
			call s__ZetsuNewMayfly_deallocate(this)
		endif
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__ZetsuNewMayfly_actions takes nothing returns nothing
  local integer this
		if GetUnitTypeId(GetTriggerUnit()) == 'H01W' then
			set this=s__ZetsuNewMayfly_allocate()
			set s__ZetsuNewMayfly_caster[this]=GetTriggerUnit()
			set s__ZetsuNewMayfly_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e06E', GetUnitX(s__ZetsuNewMayfly_caster[this]), GetUnitY(s__ZetsuNewMayfly_caster[this]), 270)
			call SlowAura(s__ZetsuNewMayfly_dummy[this] , 0.4 , 300)
			call SetUnitScale(s__ZetsuNewMayfly_caster[this], 0.0, 0.0, 0.0)
			call TimerStart(NewTimerEx(this), 0.5, false, function s__ZetsuNewMayfly_delay)
			call TimerStart(NewTimerEx(this), 0.04, true, function s__ZetsuNewMayfly_periodic)
		else
			set this=s__ZetsuNewMayfly_allocate()
			set s__ZetsuNewMayfly_caster[this]=GetTriggerUnit()
			call TimerStart(NewTimerEx(this), 0.5, false, function s__ZetsuNewMayfly_delay)
		endif
 endfunction 


 function s__ZetsuNewMayfly_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(18 , s__ZetsuNewMayfly_SPELL_ID , function s__ZetsuNewMayfly_actions)
 endfunction 

//===========================================================================
// Trigger: ZetsuUltimate
//===========================================================================

//Implemented from module Alloc:
    
        function s__ZetsuUltimate_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ZetsuUltimate_Alloc___recycle[(0)] == 0 ) then
                set s__ZetsuUltimate_Alloc___instanceCount=s__ZetsuUltimate_Alloc___instanceCount + 1
                set this=s__ZetsuUltimate_Alloc___instanceCount
            else
                set this=s__ZetsuUltimate_Alloc___recycle[(0)]
                set s__ZetsuUltimate_Alloc___recycle[(0)]=s__ZetsuUltimate_Alloc___recycle[s__ZetsuUltimate_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ZetsuUltimate_deallocate takes integer this returns nothing
            set s__ZetsuUltimate_Alloc___recycle[this]=s__ZetsuUltimate_Alloc___recycle[(0)]
            set s__ZetsuUltimate_Alloc___recycle[(0)]=this
        endfunction
    
    function s__ZetsuUltimate_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local integer p
        set x=(((GetUnitX(s__ZetsuUltimate_dummy[this]) )*1.0) + Cos((( 3.8 * s__ZetsuUltimate_count[this] )*1.0)) * (( 10.0 * s__ZetsuUltimate_count[this])*1.0)) // INLINED!!
        set y=(((GetUnitY(s__ZetsuUltimate_dummy[this]) )*1.0) + Sin((( 3.8 * s__ZetsuUltimate_count[this] )*1.0)) * (( 10.0 * s__ZetsuUltimate_count[this])*1.0)) // INLINED!!
        set p=GetRandomInt(1, 4)
        if p == 1 then
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdl", x, y)
        elseif p == 2 then
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\EntangleMine\\Roots.mdl", x, y)
        elseif p == 3 then
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\EntangleMine\\Roots.mdl", x, y)
        elseif p == 4 then
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdl", x, y)
        endif
        call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetRandomReal(- 100, 100))
        //call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, GetRandomReal(0, 2*bj_PI))
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, GetRandomReal(2.5, 3.5))
        call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 0.75)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 3.0)*1.0) , false) // INLINED!!
        set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Weapons\\BrewmasterMissile\\BrewmasterMissile.mdl", x, y)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ZetsuUltimate_dummy[this]), GetUnitY(s__ZetsuUltimate_dummy[this]), 10 * s__ZetsuUltimate_count[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ZetsuUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__ZetsuUltimate_caster[this], bj_lastCreatedUnit, 15 * GetHeroInt(s__ZetsuUltimate_caster[this], true) / 100, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		        else
                    call UnitDamageTarget(s__ZetsuUltimate_caster[this], bj_lastCreatedUnit, 20 * GetHeroInt(s__ZetsuUltimate_caster[this], true) / 100, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__ZetsuUltimate_count[this]=s__ZetsuUltimate_count[this] + 1
        if s__ZetsuUltimate_count[this] > 100 then
            call KillUnit(s__ZetsuUltimate_dummy[this])
            call ShowUnit(s__ZetsuUltimate_dummy[this], false)
	        set s__ZetsuUltimate_dummy[this]=null
            call s__ZetsuUltimate_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ZetsuUltimate_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.025, true, function s__ZetsuUltimate_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__ZetsuUltimate_actions takes nothing returns nothing
        local integer this= s__ZetsuUltimate_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Zetsu: I will revive Kaguya, regardless of the cost!|r")
        endif
        set s__ZetsuUltimate_caster[this]=GetTriggerUnit()
	    set s__ZetsuUltimate_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__ZetsuUltimate_caster[this]), GetUnitY(s__ZetsuUltimate_caster[this]), 270)
        set s__ZetsuUltimate_count[this]=0
	    call TimerStart(NewTimerEx(this), 0.1, false, function s__ZetsuUltimate_delay)
    endfunction 
    
    function s__ZetsuUltimate_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(18 , s__ZetsuUltimate_SPELL_ID , function s__ZetsuUltimate_actions)
    endfunction 
    
