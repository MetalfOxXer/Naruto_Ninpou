    function s__HagoromoT_countEnemies takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HagoromoT_caster[s__HagoromoT_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            set s__HagoromoT_totalEnemies[s__HagoromoT_instance]=s__HagoromoT_totalEnemies[s__HagoromoT_instance] + 1 // Count the enemies in the radius
        endif
        return false
    endfunction

    function s__HagoromoT_damagenumunits takes nothing returns boolean
        local real enemyHPMax
        local real enemyHPCur
        local real baseDamage

        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HagoromoT_caster[s__HagoromoT_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
            set enemyHPMax=BlzGetUnitMaxHP(GetFilterUnit())
            set enemyHPCur=GetUnitState(GetFilterUnit(), UNIT_STATE_LIFE)
            
	    call EsnareUnitTimed(s__HagoromoT_caster[s__HagoromoT_instance] , GetFilterUnit() , 0.5)
            // Calculate the base damage, split by the total number of enemies
            set baseDamage=( 250 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) / 2 ) ) / s__HagoromoT_totalEnemies[s__HagoromoT_instance]

            if enemyHPCur > ( enemyHPMax * 0.25 ) then
                // Normal damage if the unit's health is above 25%
                call UnitDamageTarget(s__HagoromoT_caster[s__HagoromoT_instance], GetFilterUnit(), baseDamage * 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
            else
                // Apply the base damage and extra damage for low HP enemies
                call UnitDamageTarget(s__HagoromoT_caster[s__HagoromoT_instance], GetFilterUnit(), baseDamage * 2, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                call UnitDamageTarget(s__HagoromoT_caster[s__HagoromoT_instance], GetFilterUnit(), ( ( ( enemyHPMax - enemyHPCur ) / 500 ) / 100 ) * ( enemyHPMax - enemyHPCur ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
            endif
        endif
	    return false
    endfunction

