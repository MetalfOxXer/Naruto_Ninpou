            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MeiLavaPit__Spell_Alloc___recycle[(0)] == 0 ) then
                set s__MeiLavaPit__Spell_Alloc___instanceCount=s__MeiLavaPit__Spell_Alloc___instanceCount + 1
