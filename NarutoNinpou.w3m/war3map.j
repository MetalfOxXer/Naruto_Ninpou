 function s__YamanakaSlashes_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set bj_lastCreatedUnit=FirstOfGroup(s__YamanakaSlashes_damaged[this])
		if bj_lastCreatedUnit == null then
			call PauseUnit(s__YamanakaSlashes_caster[this], false)
			call UnitRemoveAbility(s__YamanakaSlashes_caster[this], 'A02Q')
			call s__YamanakaSlashes_deallocate(this)
			call ReleaseTimer(GetExpiredTimer())
		elseif ( GetUnitTypeId(GetFilterUnit()) != 'n000' or GetUnitTypeId(GetFilterUnit()) != 'n00A' or GetUnitTypeId(GetFilterUnit()) != 'n008' or GetUnitTypeId(GetFilterUnit()) != 'h005' or GetUnitTypeId(GetFilterUnit()) != 'hvlt' ) then
			call UnitDamageTarget(s__YamanakaSlashes_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__YamanakaSlashes_caster[this], s__YamanakaSlashes_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
			call SetUnitPosition(s__YamanakaSlashes_caster[this], GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
			call GroupRemoveUnit(s__YamanakaSlashes_damaged[this], bj_lastCreatedUnit)
			set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__YamanakaSlashes_caster[this]), 'e04N', GetUnitX(s__YamanakaSlashes_caster[this]), GetUnitY(s__YamanakaSlashes_caster[this]), Rad2Deg(Atan3(GetUnitX(s__YamanakaSlashes_caster[this]) , GetUnitY(s__YamanakaSlashes_caster[this]) , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit))))
			call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 150)
			call SetUnitTimeScale(bj_lastCreatedUnit, 3.0)
			call SetUnitAnimation(bj_lastCreatedUnit, "attack")
			call RecycleUnitDelayed(bj_lastCreatedUnit , 0.15)
		endif
 endfunction 

