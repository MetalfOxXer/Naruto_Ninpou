    function s__TobiramaKibakuFuda_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__TobiramaKibakuFuda_missile[this])
        local real y= GetUnitY(s__TobiramaKibakuFuda_missile[this])
        local real angle= Deg2Rad(GetRandomReal(0, 360))
 local real offset= 700
        local real new_x= (((GetUnitX(s__TobiramaKibakuFuda_dome[this]) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__TobiramaKibakuFuda_dome[this]) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local integer i
        call SetUnitX(s__TobiramaKibakuFuda_missile[this], s__TobiramaKibakuFuda_target_x[this])
        call SetUnitY(s__TobiramaKibakuFuda_missile[this], s__TobiramaKibakuFuda_target_y[this])
        call SetUnitFacing(s__TobiramaKibakuFuda_missile[this], Rad2Deg(angle))
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TobiramaKibakuFuda_caster[this]), 'h0AY', s__TobiramaKibakuFuda_target_x[this], s__TobiramaKibakuFuda_target_y[this], GetRandomReal(0, 360))
        call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(100, 300), 0)
	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 10.0)
        call GroupAddUnit(s__TobiramaKibakuFuda_tags[this], bj_lastCreatedUnit)
        set s__TobiramaKibakuFuda_target_x[this]=new_x
        set s__TobiramaKibakuFuda_target_y[this]=new_y
        set s__TobiramaKibakuFuda_count[this]=s__TobiramaKibakuFuda_count[this] + 1
        if s__TobiramaKibakuFuda_count[this] > 20 then
            set s__TobiramaKibakuFuda_target_x[this]=GetUnitX(s__TobiramaKibakuFuda_dome[this])
            set s__TobiramaKibakuFuda_target_y[this]=GetUnitY(s__TobiramaKibakuFuda_dome[this])
            set i=0
            loop
                set i=i + 1
                exitwhen i > 3
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TobiramaKibakuFuda_caster[this]), 'h058', s__TobiramaKibakuFuda_target_x[this], s__TobiramaKibakuFuda_target_y[this], GetRandomReal(0, 360))
                call SetUnitScale(bj_lastCreatedUnit, 5.0, 5.0, 5.0)
                call SetUnitTimeScale(bj_lastCreatedUnit, 0.2)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            endloop
            call DestroyEffect(AddSpecialEffect(("s_LW10.mdx" ), (( s__TobiramaKibakuFuda_target_x[this] )*1.0), (( s__TobiramaKibakuFuda_target_y[this])*1.0))) // INLINED!!
            if IsUnitVisible(s__TobiramaKibakuFuda_caster[this], GetLocalPlayer()) then
                call CameraSetEQNoiseForPlayer(GetLocalPlayer(), 10.00)
            endif
            call TimerStart(CreateTimer(), 1.5, false, function s__TobiramaKibakuFuda_shake)
            set i=0
            loop
                set i=i + 1
                exitwhen i > 20
                set angle=32 * i
                set offset=400
                set x=s__TobiramaKibakuFuda_target_x[this] + Cos(Deg2Rad(angle)) * offset
                set y=s__TobiramaKibakuFuda_target_y[this] + Sin(Deg2Rad(angle)) * offset
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TobiramaKibakuFuda_caster[this]), 'n02R', x, y, GetRandomReal(0, 360))
                call SetUnitX(bj_lastCreatedUnit, x)
                call SetUnitY(bj_lastCreatedUnit, y)
                call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(100, 300), 0)
                //call SetUnitTimeScale(bj_lastCreatedUnit, GetRandomReal(0.5, 0.7))
                call KillUnit(bj_lastCreatedUnit)
            endloop
            
            set bj_lastCreatedGroup=CreateGroup()
	    set s__TobiramaKibakuFuda_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__TobiramaKibakuFuda_dome[this]), GetUnitY(s__TobiramaKibakuFuda_dome[this]), 800, Filter(function s__TobiramaKibakuFuda_damagefix))
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(s__TobiramaKibakuFuda_tags[this])
                exitwhen bj_lastCreatedUnit == null
                call KillUnit(bj_lastCreatedUnit)
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(s__TobiramaKibakuFuda_tags[this], bj_lastCreatedUnit)
            endloop
            call DestroyGroup(s__TobiramaKibakuFuda_tags[this])
            set s__TobiramaKibakuFuda_tags[this]=null
            call PauseUnit(s__TobiramaKibakuFuda_caster[this], false)
            call ShowUnit(s__TobiramaKibakuFuda_caster[this], true)
            call SelectUnitForPlayerSingle(s__TobiramaKibakuFuda_caster[this], GetOwningPlayer(s__TobiramaKibakuFuda_caster[this]))
            call KillUnit(s__TobiramaKibakuFuda_missile[this])
            set s__TobiramaKibakuFuda_missile[this]=null
            call KillUnit(s__TobiramaKibakuFuda_dome[this])
            set s__TobiramaKibakuFuda_dome[this]=null
            call ReleaseTimer(GetExpiredTimer())
        endif
        
    endfunction 
    
    function s__TobiramaKibakuFuda_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call PauseUnit(s__TobiramaKibakuFuda_caster[this], true)
        call ShowUnit(s__TobiramaKibakuFuda_caster[this], false)
        call TimerStart(NewTimerEx(this), 0.05, true, function s__TobiramaKibakuFuda_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 

    function s__TobiramaKibakuFuda_actions takes nothing returns nothing
        local integer this= s__TobiramaKibakuFuda_allocate()
        local real angle= GetRandomReal(0, 2 * bj_PI)
        local real offset= GetRandomReal(0, 400)
        set s__TobiramaKibakuFuda_caster[this]=GetTriggerUnit()
        if IsUnitVisible(s__TobiramaKibakuFuda_caster[this], GetLocalPlayer()) then
	    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Tobirama: This is the power of the Hokage!")
            call PlaySoundOnUnitBJ(gg_snd_Tobirama_T_Gojou, 100, s__TobiramaKibakuFuda_caster[this])
        endif
        set s__TobiramaKibakuFuda_dome[this]=CreateUnit(GetTriggerPlayer(), 'h0AX', GetSpellTargetX(), GetSpellTargetY(), 270)
        call SetUnitScale(s__TobiramaKibakuFuda_dome[this], 2, 0, 0)
        set s__TobiramaKibakuFuda_missile[this]=CreateUnit(GetTriggerPlayer(), 'h04H', GetUnitX(s__TobiramaKibakuFuda_caster[this]), GetUnitY(s__TobiramaKibakuFuda_caster[this]), GetUnitFacing(s__TobiramaKibakuFuda_caster[this]))
        set s__TobiramaKibakuFuda_count[this]=0
        set s__TobiramaKibakuFuda_target_x[this]=(((GetSpellTargetX() )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set s__TobiramaKibakuFuda_target_y[this]=(((GetSpellTargetY() )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set s__TobiramaKibakuFuda_tags[this]=CreateGroup()
	//call SlowAura(this.dome, 0.5, 800)
	call TimerStart(NewTimerEx(this), 0.5, false, function s__TobiramaKibakuFuda_delay)
    endfunction 
    
    function s__TobiramaKibakuFuda_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(34 , s__TobiramaKibakuFuda_SPELL_ID , function s__TobiramaKibakuFuda_actions)
    endfunction 

