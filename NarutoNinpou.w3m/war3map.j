    function s__ToruneAssassination_delay2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call PauseUnit(s__ToruneAssassination_caster[this], false)
        //call PauseUnit(this.target, false)
        call SetUnitAnimation(s__ToruneAssassination_target[this], "death")
        call UnitRemoveAbility(s__ToruneAssassination_caster[this], 'A02Q')
        call UnitRemoveAbility(s__ToruneAssassination_target[this], 'A02Q')
        call DestroyEffect(AddSpecialEffect(("Units\\Undead\\Abomination\\AbominationExplosion.mdl" ), (( GetUnitX(s__ToruneAssassination_target[this]) )*1.0), (( GetUnitY(s__ToruneAssassination_target[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("ShadowCannon.mdx" ), (( GetUnitX(s__ToruneAssassination_target[this]) )*1.0), (( GetUnitY(s__ToruneAssassination_target[this]))*1.0))) // INLINED!!
        call UnitDamageTarget(s__ToruneAssassination_caster[this], s__ToruneAssassination_target[this], GetHeroInt(s__ToruneAssassination_caster[this], true) * GetUnitAbilityLevel(s__ToruneAssassination_caster[this], s__ToruneAssassination_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        set s__ToruneAssassination_target[this]=null
        call UnitRemoveAbility(s__ToruneAssassination_caster[this], 'Binv')
        call s__ToruneAssassination_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ToruneAssassination_damage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__ToruneAssassination_caster[this]) , GetUnitY(s__ToruneAssassination_caster[this]) , GetUnitX(s__ToruneAssassination_target[this]) , GetUnitY(s__ToruneAssassination_target[this]))
        local real x= (((GetUnitX(s__ToruneAssassination_target[this]) )*1.0) + Cos((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__ToruneAssassination_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        call SetUnitX(s__ToruneAssassination_caster[this], x)
        call SetUnitY(s__ToruneAssassination_caster[this], y)
        call TimerStart(NewTimerEx(this), 0.05, false, function s__ToruneAssassination_delay2)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ToruneAssassination_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__ToruneAssassination_caster[this]) , GetUnitY(s__ToruneAssassination_caster[this]) , GetUnitX(s__ToruneAssassination_target[this]) , GetUnitY(s__ToruneAssassination_target[this]))
        call ShowUnit(s__ToruneAssassination_caster[this], true)
        call SelectUnitForPlayerSingle(s__ToruneAssassination_caster[this], GetOwningPlayer(s__ToruneAssassination_caster[this]))
        call SetUnitFacing(s__ToruneAssassination_caster[this], Rad2Deg(angle) + 180)
        call SetUnitAnimation(s__ToruneAssassination_caster[this], "attack")
        //call PauseUnit(this.target, true) 
	call StunUnitTimed(s__ToruneAssassination_caster[this] , s__ToruneAssassination_target[this] , 1.0)
        call TimerStart(NewTimerEx(this), 0.01, false, function s__ToruneAssassination_damage)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ToruneAssassination_actions takes nothing returns nothing
        local integer this= s__ToruneAssassination_allocate()
        set s__ToruneAssassination_caster[this]=GetTriggerUnit()
        set s__ToruneAssassination_target[this]=GetSpellTargetUnit()
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__ToruneAssassination_caster[this]) )*1.0), (( GetUnitY(s__ToruneAssassination_caster[this]))*1.0))) // INLINED!!
        //call PauseUnit(this.caster, true)
        //call ShowUnit(this.caster, false)
        call UnitAddAbility(s__ToruneAssassination_caster[this], 'A02Q')
        call UnitAddAbility(s__ToruneAssassination_target[this], 'A02Q')
        set bj_lastCreatedUnit=CreateAbilityDummy(s__ToruneAssassination_caster[this] , 'A11K')
        call IssueTargetOrder(bj_lastCreatedUnit, "invisibility", s__ToruneAssassination_caster[this])
        call TimerStart(NewTimerEx(this), 1.0, false, function s__ToruneAssassination_delay)
    endfunction 
    
    function s__ToruneAssassination_death takes nothing returns nothing
        if GetUnitTypeId(GetTriggerUnit()) == 'e047' then
            call ShowUnit(GetTriggerUnit(), false)
        endif
    endfunction 
    
    function s__ToruneAssassination_onInit takes nothing returns nothing
        call RegisterPlayerUnitEventForId(72 , EVENT_PLAYER_UNIT_DEATH , function s__ToruneAssassination_death)
        call RegisterSpellEffectEventForId(72 , s__ToruneAssassination_SPELL_ID , function s__ToruneAssassination_actions)
    endfunction 
    
