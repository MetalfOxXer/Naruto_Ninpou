endfunction

function s__HiruzenEnmaAttacks_critical takes nothing returns nothing
 local integer i= GetRandomInt(1, 100)
	if GetUnitTypeId(GetAttacker()) == 'h04R' and IsUnitEnemy(GetAttacker(), GetOwningPlayer(GetTriggerUnit())) and i <= 100 then
		call s__HiruzenEnmaAttacks_critical_actions(GetAttacker() , GetTriggerUnit())
	endif
endfunction

