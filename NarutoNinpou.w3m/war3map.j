    function s__ShikamaruNewUltimate_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__ShikamaruNewUltimate_missle[this])
        local real y= GetUnitY(s__ShikamaruNewUltimate_missle[this])
        local real angle= Atan3(x , y , s__ShikamaruNewUltimate_target_x[this] , s__ShikamaruNewUltimate_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real distance= GetDistance(x , y , s__ShikamaruNewUltimate_target_x[this] , s__ShikamaruNewUltimate_target_y[this])
        if distance > 400 and s__ShikamaruNewUltimate_count[this] == 0 then
            set s__ShikamaruNewUltimate_angle[this]=angle
        else
            if s__ShikamaruNewUltimate_count[this] == 0 then
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(s__ShikamaruNewUltimate_smoke)
                    exitwhen bj_lastCreatedUnit == null
                    call GroupAddUnit(s__ShikamaruNewUltimate_shadows2[this], bj_lastCreatedUnit)
                    call GroupRemoveUnit(s__ShikamaruNewUltimate_smoke, bj_lastCreatedUnit)
                endloop
            endif
            set s__ShikamaruNewUltimate_count[this]=s__ShikamaruNewUltimate_count[this] + 1
            set new_x=(((s__ShikamaruNewUltimate_target_x[this] )*1.0) + Cos((( angle + bj_PI + Deg2Rad(3 * s__ShikamaruNewUltimate_count[this]) )*1.0)) * (( 400 / 60.0 * ( 60 - s__ShikamaruNewUltimate_count[this] ))*1.0)) // INLINED!!
            set new_y=(((s__ShikamaruNewUltimate_target_y[this] )*1.0) + Sin((( angle + bj_PI + Deg2Rad(3 * s__ShikamaruNewUltimate_count[this]) )*1.0)) * (( 400 / 60.0 * ( 60 - s__ShikamaruNewUltimate_count[this] ))*1.0)) // INLINED!!
        endif
        call SetUnitX(s__ShikamaruNewUltimate_missle[this], new_x)
        call SetUnitY(s__ShikamaruNewUltimate_missle[this], new_y)
        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ShikamaruNewUltimate_caster[this]), 'hkni', x, y, Rad2Deg(angle))
        call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__ShikamaruNewUltimate_missle[this]))
        call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__ShikamaruNewUltimate_missle[this]))
        call GroupAddUnit(s__ShikamaruNewUltimate_shadows[this], bj_lastCreatedUnit)
        if s__ShikamaruNewUltimate_count[this] > 0 then
            call SetUnitScale(bj_lastCreatedUnit, 1.0 - ( s__ShikamaruNewUltimate_count[this] / 60 ), 0, 0)
            call SetUnitFlyHeight(bj_lastCreatedUnit, s__ShikamaruNewUltimate_count[this] * 6, 0.00)
            call GroupAddUnit(s__ShikamaruNewUltimate_shadows2[this], bj_lastCreatedUnit)
        endif
        call SetUnitTimeScale(bj_lastCreatedUnit, 0)
        if s__ShikamaruNewUltimate_count[this] > 44 then
            //call SetUnitAnimationWithRarity(this.caster,"attack",RARITY_RARE)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__ShikamaruNewUltimate_damaged[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call ShowUnit(bj_lastCreatedUnit, false)
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__ShikamaruNewUltimate_shadows2[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call IssuePointOrder(bj_lastCreatedUnit, "move", s__ShikamaruNewUltimate_target_x[this], s__ShikamaruNewUltimate_target_y[this])
                call SetUnitFlyHeight(bj_lastCreatedUnit, 0.00, ( GetUnitFlyHeight(bj_lastCreatedUnit) * 4.00 ))
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            call TimerStartEx(NewTimerEx(this) , 0.5 , false , function s__ShikamaruNewUltimate_hide , "ShikamaruNewUltimate_hide")
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ShikamaruNewUltimate_throwSmoke takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real offset= GetRandomReal(0, 200)
        local real angle= Deg2Rad(GetRandomReal(0, 360))
        local real x= (((s__ShikamaruNewUltimate_target_x[this] )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real y= (((s__ShikamaruNewUltimate_target_y[this] )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        set s__ShikamaruNewUltimate_count[this]=s__ShikamaruNewUltimate_count[this] + 1
        if s__ShikamaruNewUltimate_count[this] <= 3 then
            set bj_lastCreatedUnit=GetInvisibleDummy(GetOwningPlayer(s__ShikamaruNewUltimate_caster[this]) , GetUnitX(s__ShikamaruNewUltimate_caster[this]) , GetUnitY(s__ShikamaruNewUltimate_caster[this]))
            call UnitAddAbility(bj_lastCreatedUnit, 'A00V')
            call IssuePointOrder(bj_lastCreatedUnit, "summonfactory", x, y)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        endif
        if s__ShikamaruNewUltimate_count[this] > 10 then
            call PauseUnit(s__ShikamaruNewUltimate_caster[this], true)
            call SetUnitAnimation(s__ShikamaruNewUltimate_caster[this], "spell")
            set s__ShikamaruNewUltimate_damaged[this]=CreateGroup()
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ShikamaruNewUltimate_target_x[this], s__ShikamaruNewUltimate_target_y[this], 400.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ShikamaruNewUltimate_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call GroupAddUnit(s__ShikamaruNewUltimate_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__ShikamaruNewUltimate_shadows[this]=CreateGroup()
            set s__ShikamaruNewUltimate_missle[this]=GetInvisibleDummy(GetOwningPlayer(s__ShikamaruNewUltimate_caster[this]) , GetUnitX(s__ShikamaruNewUltimate_caster[this]) , GetUnitY(s__ShikamaruNewUltimate_caster[this]))
            call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__ShikamaruNewUltimate_periodic , "ShikamaruNewUltimate_periodic")
            set s__ShikamaruNewUltimate_count[this]=0
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ShikamaruNewUltimate_actions takes nothing returns nothing
        local integer this= s__ShikamaruNewUltimate_allocate()
        local integer i
        set s__ShikamaruNewUltimate_caster[this]=GetTriggerUnit()
        set s__ShikamaruNewUltimate_target_x[this]=GetSpellTargetX()
        set s__ShikamaruNewUltimate_target_y[this]=GetSpellTargetY()
        set s__ShikamaruNewUltimate_shadows2[this]=CreateGroup()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Shikamaru_T2_Emnaku, 100, s__ShikamaruNewUltimate_caster[this])
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Shikamaru: It is so problematic... Lets get over with it at once...|r")
        endif
        set s__ShikamaruNewUltimate_count[this]=0
        call TimerStartEx(NewTimerEx(this) , 0.1 , true , function s__ShikamaruNewUltimate_throwSmoke , "ShikamaruNewUltimate_throwSmoke")
   endfunction 
        
    function s__ShikamaruNewUltimate_death takes nothing returns nothing
        local real offset
        local real angle
        local real x
        local real y
        if GetUnitTypeId(GetTriggerUnit()) == 'hgyr' then
            set offset=GetRandomReal(0, 100)
            set angle=GetRandomReal(0, 360)
            set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( offset)*1.0)) // INLINED!!
            set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'zcso', x, y, GetRandomReal(0, 360))
            call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(50.00, 300.00), 600.00)
            call SetUnitScale(bj_lastCreatedUnit, 6, 6, 6)
            set angle=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , x , y)
            set offset=GetRandomReal(200, 300)
            set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 10.0)
            call GroupAddUnit(s__ShikamaruNewUltimate_smoke, bj_lastCreatedUnit)
        endif
    endfunction 
    
    function s__ShikamaruNewUltimate_onInit takes nothing returns nothing
        set s__ShikamaruNewUltimate_smoke=CreateGroup()
        call RegisterSpellEffectEventForId(3 , s__ShikamaruNewUltimate_SPELL_ID , function s__ShikamaruNewUltimate_actions)
        call RegisterPlayerUnitEventForId(3 , EVENT_PLAYER_UNIT_DEATH , function s__ShikamaruNewUltimate_death)
    endfunction 
    
