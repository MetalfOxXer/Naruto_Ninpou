        call SetUnitVertexColor(GetTriggerUnit(), 197, 205, 215, 100)
        call TimerStart(NewTimerEx(id), 0.1, true, function s__Shichiseiken_periodic)
        set bj_lastCreatedUnit=CreateAbilityDummy(GetTriggerUnit() , 'A19B')
