                call SetUnitFacing(s__KisameGreatSharkDance__watereffect[(this)*(1)+i], Rad2Deg(angle2))
            endloop
            if s__KisameGreatSharkDance__Spell_count[this] > 50 then
            	call SetUnitInvulnerable(s__KisameGreatSharkDance__Spell_caster[this], false)
            	call PauseUnit(s__KisameGreatSharkDance__Spell_caster[this], false)
