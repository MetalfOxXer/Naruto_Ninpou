        if s__ShisuiSusanooDrill_count[this] > 5 then
            call TimerStartEx(NewTimerEx(this) , 0.01 , false , function s__ShisuiSusanooDrill_startDamage , "ShisuiSusanooDrill_startDamage")
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
