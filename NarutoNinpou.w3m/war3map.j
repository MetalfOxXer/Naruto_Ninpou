 function s__KushinaQ_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x2
  local real y2
  local real x= GetUnitX(s__KushinaQ_caster[this])
  local real y= GetUnitY(s__KushinaQ_caster[this])
