//Implemented from module Alloc:
    
        function s__NejiHasangeki_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__NejiHasangeki_Alloc___recycle[(0)] == 0 ) then
                set s__NejiHasangeki_Alloc___instanceCount=s__NejiHasangeki_Alloc___instanceCount + 1
                set this=s__NejiHasangeki_Alloc___instanceCount
            else
                set this=s__NejiHasangeki_Alloc___recycle[(0)]
                set s__NejiHasangeki_Alloc___recycle[(0)]=s__NejiHasangeki_Alloc___recycle[s__NejiHasangeki_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__NejiHasangeki_deallocate takes integer this returns nothing
            set s__NejiHasangeki_Alloc___recycle[this]=s__NejiHasangeki_Alloc___recycle[(0)]
            set s__NejiHasangeki_Alloc___recycle[(0)]=this
        endfunction

    function s__NejiHasangeki_dealDamage takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__NejiHasangeki_caster[s__NejiHasangeki_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
            call UnitDamageTarget(s__NejiHasangeki_caster[s__NejiHasangeki_instance], GetFilterUnit(), 500, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
    endfunction

    function s__NejiHasangeki_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local integer i
        set s__NejiHasangeki_count[this]=s__NejiHasangeki_count[this] + 1
        if s__NejiHasangeki_count[this] >= 6 then
            call ShowUnit(s__NejiHasangeki_dome[this], false)
            call KillUnit(s__NejiHasangeki_dome[this])
            set s__NejiHasangeki_dome[this]=null
            call ShowUnit(s__NejiHasangeki_dome2[this], false)
            call KillUnit(s__NejiHasangeki_dome2[this])
            set s__NejiHasangeki_dome2[this]=null
            set bj_lastCreatedGroup=CreateGroup()
            set s__NejiHasangeki_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NejiHasangeki_wave[this]), GetUnitY(s__NejiHasangeki_wave[this]), 200.0, Filter(function s__NejiHasangeki_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            set i=1
            loop
                exitwhen i > 10
                set x=(((GetUnitX(s__NejiHasangeki_wave[this]) )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 80))*1.0)) // INLINED!!
                set y=(((GetUnitY(s__NejiHasangeki_wave[this]) )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 80))*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
            call ShowUnit(s__NejiHasangeki_wave[this], false)
            call KillUnit(s__NejiHasangeki_wave[this])
            set s__NejiHasangeki_wave[this]=null
            call DestroyGroup(s__NejiHasangeki_damaged[this])
            set s__NejiHasangeki_damaged[this]=null
            call s__NejiHasangeki_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction


    function s__NejiHasangeki_delay3 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local integer i
        set i=1
        loop
            exitwhen i > 5
            set x=(((GetUnitX(s__NejiHasangeki_wave[this]) )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 80))*1.0)) // INLINED!!
            set y=(((GetUnitY(s__NejiHasangeki_wave[this]) )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 80))*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            set i=i + 1
        endloop
        call PauseUnit(s__NejiHasangeki_caster[this], false)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__NejiHasangeki_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__NejiHasangeki_delay2 takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real caster_x= GetUnitX(s__NejiHasangeki_caster[this])
        local real caster_y= GetUnitY(s__NejiHasangeki_caster[this])
        local real new_x= caster_x + Cos(s__NejiHasangeki_angle[this]) * 100
        local real new_y= caster_y + Sin(s__NejiHasangeki_angle[this]) * 100
        local real new_x_2
        local real new_y_2
        local integer i
        set bj_lastCreatedEffect=AddSpecialEffect("dash sfx.mdx", GetUnitX(s__NejiHasangeki_caster[this]), GetUnitY(s__NejiHasangeki_caster[this]))
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__NejiHasangeki_caster[this])) + bj_PI)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__NejiHasangeki_caster[this]) , GetUnitY(s__NejiHasangeki_caster[this])))
		call DestroyEffect(bj_lastCreatedEffect)
        call SetUnitTimeScale(s__NejiHasangeki_caster[this], 1.0)
        set i=0
        loop
            exitwhen i > 1
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__NejiHasangeki_caster[this]), 'h03C', (((GetUnitX(s__NejiHasangeki_caster[this]) )*1.0) + Cos((( s__NejiHasangeki_angle[this] + bj_PI )*1.0)) * (( 50)*1.0)), (((GetUnitY(s__NejiHasangeki_caster[this]) )*1.0) + Sin((( s__NejiHasangeki_angle[this] + bj_PI )*1.0)) * (( 50)*1.0)), Rad2Deg(s__NejiHasangeki_angle[this])) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
            set i=i + 1
        endloop
        set i=0
        loop
            set i=i + 1
            exitwhen i > 9
                set new_x_2=new_x + Cos(s__NejiHasangeki_angle[this]) * ( 100 * i )
                set new_y_2=new_y + Sin(s__NejiHasangeki_angle[this]) * ( 100 * i )
                call SetUnitX(s__NejiHasangeki_wave[this], new_x_2)
                call SetUnitY(s__NejiHasangeki_wave[this], new_y_2)
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x_2, new_y_2, 200.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NejiHasangeki_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__NejiHasangeki_damaged[this]) then
                        call UnitDamageTarget(s__NejiHasangeki_caster[this], bj_lastCreatedUnit, GetHeroAgi(s__NejiHasangeki_caster[this], true) * 10, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                	    call GroupAddUnit(s__NejiHasangeki_damaged[this], bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
        endloop
        call TimerStart(NewTimerEx(this), 0.5, false, function s__NejiHasangeki_delay3)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__NejiHasangeki_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set s__NejiHasangeki_dome2[this]=CreateUnit(GetOwningPlayer(s__NejiHasangeki_caster[this]), 'h016', GetUnitX(s__NejiHasangeki_caster[this]), GetUnitY(s__NejiHasangeki_caster[this]), Rad2Deg(s__NejiHasangeki_angle[this]))
        call SetUnitTimeScalePercent(s__NejiHasangeki_caster[this], 10.00)
        call SetUnitAnimation(s__NejiHasangeki_caster[this], "spell two")
        call SetUnitTimeScale(s__NejiHasangeki_caster[this], 1.5)
        call TimerStart(NewTimerEx(this), 0.25, false, function s__NejiHasangeki_delay2)
        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__NejiHasangeki_actions takes nothing returns nothing
        local integer this= s__NejiHasangeki_allocate()
        local real x
        local real y
        set s__NejiHasangeki_caster[this]=GetTriggerUnit()
        set s__NejiHasangeki_damaged[this]=CreateGroup()
        set s__NejiHasangeki_count[this]=0
        set s__NejiHasangeki_angle[this]=Atan3(GetUnitX(s__NejiHasangeki_caster[this]) , GetUnitY(s__NejiHasangeki_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Neji_T, 100.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cFFFF0000Neji: Let me show you why they call me genius!|r")
        endif
        set s__NejiHasangeki_wave[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__NejiHasangeki_caster[this]), GetUnitY(s__NejiHasangeki_caster[this]), Rad2Deg(s__NejiHasangeki_angle[this]))
        call PauseUnit(s__NejiHasangeki_caster[this], true)
        call SetUnitFacing(s__NejiHasangeki_caster[this], Rad2Deg(s__NejiHasangeki_angle[this]))
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__NejiHasangeki_caster[this]) )*1.0), (( GetUnitY(s__NejiHasangeki_caster[this]))*1.0))) // INLINED!!
        set s__NejiHasangeki_dome[this]=CreateUnit(GetTriggerPlayer(), 'h025', GetUnitX(s__NejiHasangeki_caster[this]), GetUnitY(s__NejiHasangeki_caster[this]), Rad2Deg(s__NejiHasangeki_angle[this]))
        call SetUnitTimeScale(s__NejiHasangeki_dome[this], 0.8)
        call TimerStart(NewTimerEx(this), 0.25, false, function s__NejiHasangeki_delay)
    endfunction
    
    function s__NejiHasangeki_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(14 , s__NejiHasangeki_SPELL_ID , function s__NejiHasangeki_actions)
    endfunction
    
//===========================================================================
// Trigger: NejiUltimateChoice
//===========================================================================
//textmacro instance: UltimateChoice("Neji", "A13W", "A00O", "HASANGEKI", "Hakke: Hasangeki", "A13U", "NIJUU", "Hakke: Hyaku Nijuhassho")

//Implemented from module Alloc:
    
        function s__NejiUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__NejiUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__NejiUltimateChoice_Alloc___instanceCount=s__NejiUltimateChoice_Alloc___instanceCount + 1
                set this=s__NejiUltimateChoice_Alloc___instanceCount
            else
                set this=s__NejiUltimateChoice_Alloc___recycle[(0)]
                set s__NejiUltimateChoice_Alloc___recycle[(0)]=s__NejiUltimateChoice_Alloc___recycle[s__NejiUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__NejiUltimateChoice_deallocate takes integer this returns nothing
            set s__NejiUltimateChoice_Alloc___recycle[this]=s__NejiUltimateChoice_Alloc___recycle[(0)]
            set s__NejiUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__NejiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__NejiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__NejiUltimateChoice_caster[this]), 'A13W', false)
        else
            call s__NejiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__NejiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__NejiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__NejiUltimateChoice_u, s__NejiUltimateChoice_HASANGEKI)
            call UnitMakeAbilityPermanent(s__NejiUltimateChoice_u, true, s__NejiUltimateChoice_HASANGEKI)
        else
            call UnitAddAbility(s__NejiUltimateChoice_u, s__NejiUltimateChoice_NIJUU)
            call UnitMakeAbilityPermanent(s__NejiUltimateChoice_u, true, s__NejiUltimateChoice_NIJUU)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A13W', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A13W', false)
        set s__s__NejiUltimateChoice_b[0]= null
        set s__s__NejiUltimateChoice_b[1]= null
        set s__NejiUltimateChoice_u=null
        call s__Dialog_destroy(s__NejiUltimateChoice_d)
        call DestroyBoolExpr(s__NejiUltimateChoice_pick)
        set s__NejiUltimateChoice_pick=null
        set this=s__NejiUltimateChoice_allocate()
        set s__NejiUltimateChoice_caster[this]=s__NejiUltimateChoice_u
        set s__NejiUltimateChoice_pp[this]=GetOwningPlayer(s__NejiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__NejiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__NejiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__NejiUltimateChoice_HASANGEKI) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__NejiUltimateChoice_NIJUU) == 0 then
            set s__NejiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__NejiUltimateChoice_d,"Pick a skill")
            set s__s__NejiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__NejiUltimateChoice_d)], ("Hakke: Hasangeki" ), ( 0))) // INLINED!!
            set s__s__NejiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__NejiUltimateChoice_d)], ("Hakke: Hyaku Nijuhassho" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__NejiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__NejiUltimateChoice_d,s__NejiUltimateChoice_pick)
            set s__NejiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__NejiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A13W' then
            set s__NejiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__NejiUltimateChoice_onInit takes nothing returns nothing
        set s__NejiUltimateChoice_pick=Condition(function s__NejiUltimateChoice_pickSkill)
