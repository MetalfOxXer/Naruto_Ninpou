        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__KillerBeeAcrobaticSwords_target[this]) )*1.0), (( GetUnitY(s__KillerBeeAcrobaticSwords_target[this]))*1.0))) // INLINED!!
