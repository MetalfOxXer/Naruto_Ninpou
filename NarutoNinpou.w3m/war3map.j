function Trig_Byakugan_Actions takes nothing returns nothing
    set bj_lastCreatedUnit=GetInvisibleDummy(GetTriggerPlayer() , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()))
call UnitAddAbility((bj_lastCreatedUnit ), ( 'A0DO')) // INLINED!!
    call IssuePointOrder(bj_lastCreatedUnit, "farsight", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 10.0)
    //call AddSpecialEffectEx("Abilities\\Spells\\Other\\Andt\\Andt.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
endfunction

function Trig_Byakugan_Reveal takes nothing returns nothing
    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Andt\\Andt.mdl" ), (( GetSpellTargetX() )*1.0), (( GetSpellTargetY())*1.0))) // INLINED!!
endfunction

