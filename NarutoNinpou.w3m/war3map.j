    function s__SaiLions_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__SaiLions_lions[this])
            exitwhen bj_lastCreatedUnit == null
            set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 350)*1.0)) // INLINED!!
            set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 350)*1.0)) // INLINED!!
            call SetUnitX(bj_lastCreatedUnit, x)
            call SetUnitY(bj_lastCreatedUnit, y)
            call IssueTargetOrder(bj_lastCreatedUnit, "attack", s__SaiLions_target[this])
            call GroupRemoveUnit(s__SaiLions_lions[this], bj_lastCreatedUnit)
        endloop
        call DestroyGroup(s__SaiLions_lions[this])
        set s__SaiLions_lions[this]=null
        call s__SaiLions_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__SaiLions_liondamage takes nothing returns nothing
        local real caster_x= GetUnitX(GetAttacker())
        local real caster_y= GetUnitY(GetAttacker())
        local real target_x= GetUnitX(GetTriggerUnit())
        local real target_y= GetUnitY(GetTriggerUnit())
        local real angle= Atan2(( target_y - caster_y ), ( target_x - caster_x ))
        local real distance_x= target_x - caster_x
        local real distance_y= target_y - caster_y
        local real distance= SquareRoot(distance_x * distance_x + distance_y * distance_y)
        local real new_x= target_x + Cos(angle) * distance
        local real new_y= target_y + Sin(angle) * distance
        if GetUnitTypeId(GetAttacker()) == 'nsw1' then
            call SetUnitX(GetAttacker(), new_x)
            call SetUnitY(GetAttacker(), new_y)
            call UnitDamageTarget(s__SaiLions_sai, GetTriggerUnit(), 10 + GetHeroAgi(s__SaiLions_sai, true) / 4, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        endif
    endfunction


    function s__SaiLions_actions takes nothing returns nothing
        local integer this= s__SaiLions_allocate()
        local integer i
        local real x
        local real y
        set s__SaiLions_sai=GetTriggerUnit()
        set s__SaiLions_target[this]=GetSpellTargetUnit()
        set s__SaiLions_lions[this]=CreateGroup()
        set i=1
        loop
            exitwhen i > 10
            set x=(((GetUnitX(GetTriggerUnit()) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) - 90.00 + ( 18 * i )) )*1.0)) * (( 70)*1.0)) // INLINED!!
            set y=(((GetUnitY(GetTriggerUnit()) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(GetTriggerUnit()) - 90.00 + ( 18 * i )) )*1.0)) * (( 70)*1.0)) // INLINED!!
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(GetTriggerUnit()), 'nsw1', x, y, GetUnitFacing(GetTriggerUnit()) - 90.00 + ( 18 * i ))
            call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
            call UnitAddAbility(bj_lastCreatedUnit, 'A02X')
            call UnitAddAbility(bj_lastCreatedUnit, 'A0PI')
            call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0PI', GetUnitAbilityLevel(GetTriggerUnit(), s__SaiLions_SPELL_ID))
            call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", GetSpellTargetUnit())
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0 + ( GetUnitAbilityLevel(GetTriggerUnit(), s__SaiLions_SPELL_ID) * 0.2 ))
            set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 1000)*1.0)) // INLINED!!
            set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(bj_lastCreatedUnit)) )*1.0)) * (( 1000)*1.0)) // INLINED!!
            call IssuePointOrder(bj_lastCreatedUnit, "move", x, y)
            call GroupAddUnit(s__SaiLions_lions[this], bj_lastCreatedUnit)
            set i=i + 1
        endloop
        call TimerStart(NewTimerEx(this), 0.1, false, function s__SaiLions_delay)
    endfunction 
    
    function s__SaiLions_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(20 , s__SaiLions_SPELL_ID , function s__SaiLions_actions)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__SaiLions_liondamage))) // INLINED!!
    endfunction 
    
