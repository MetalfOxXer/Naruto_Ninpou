  local real new_x= (((x )*1.0) + Cos((( new_angle )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( new_angle )*1.0)) * (( 40)*1.0)) // INLINED!!
  local unit u
		set s__HidanRScythe_count[this]=s__HidanRScythe_count[this] + 1
		call SetUnitX(s__HidanRScythe_scythe[this], new_x)
