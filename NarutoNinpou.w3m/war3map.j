    // Constants for the spell

    // Effect model paths

    function s__HagoromoQW_findTrackedUnit takes unit u returns integer
        local integer i= 0
        loop
            exitwhen i >= s__HagoromoQW_trackedCount
            if s__HagoromoQW_trackedUnits[i] == u then
                return i
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction

    function s__HagoromoQW_applyPull takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real targetX
        local real targetY
        local real prevX
        local real prevY
        local real pullAmount
        local real distance
        local real dynamicRadius
        local unit u
        local integer index

        // Ensure we use a valid radius
        set dynamicRadius=( s__HagoromoQW_VINE_RADIUS[this] + 64 ) * s__HagoromoQW_count[this] // Always scale with count starting from 1.0

        // Enumerate units in range of the last spawned ring
        call GroupEnumUnitsInRange(s__HagoromoQW_tempGroup[this], s__HagoromoQW_target_x[this], s__HagoromoQW_target_y[this], dynamicRadius, null)

        // Iterate over units in the group
        loop
            set u=FirstOfGroup(s__HagoromoQW_tempGroup[this])
            exitwhen u == null
            
            if IsUnitAlly(u, GetOwningPlayer(s__HagoromoQW_caster[this])) or IsUnitType(u, UNIT_TYPE_STRUCTURE) == true then
                call GroupRemoveUnit(s__HagoromoQW_tempGroup[this], u)
            endif

            if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoQW_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                // Find if the unit is already tracked
                set index=s__HagoromoQW_findTrackedUnit(u)

                // If the unit is not yet tracked, add it to the array
                if index == - 1 then
                    set s__HagoromoQW_trackedUnits[s__HagoromoQW_trackedCount]=u
                    set s__HagoromoQW_prevUnitX[s__HagoromoQW_trackedCount]=GetUnitX(u)
                    set s__HagoromoQW_prevUnitY[s__HagoromoQW_trackedCount]=GetUnitY(u)
                    set index=s__HagoromoQW_trackedCount
                    set s__HagoromoQW_trackedCount=s__HagoromoQW_trackedCount + 1
                    // Skip the pull effect for the first-time entry
                else
                    // Calculate the distance the unit has moved from its last tracked position
                    set prevX=s__HagoromoQW_prevUnitX[index]
                    set prevY=s__HagoromoQW_prevUnitY[index]
                    set distance=SquareRoot(( GetUnitX(u) - prevX ) * ( GetUnitX(u) - prevX ) + ( GetUnitY(u) - prevY ) * ( GetUnitY(u) - prevY ))

                    // Only pull the unit if they've moved more than 15 units from their last position
                    if distance > ( ( ( ( GetUnitMoveSpeed(u) / 100 ) * 2 ) + 1 ) * 2 ) then
                        // Pull the unit 7.5 units back toward its previous position
                        set pullAmount=( ( ( GetUnitMoveSpeed(u) / 100 ) * 2 ) + 1 ) / distance
                        set targetX=GetUnitX(u) - ( GetUnitX(u) - prevX ) * pullAmount
                        set targetY=GetUnitY(u) - ( GetUnitY(u) - prevY ) * pullAmount

                        // Move the unit to the new position
                        call SetUnitX(u, targetX)
                        call SetUnitY(u, targetY)

                        // Update the previous position to the current position
                        set s__HagoromoQW_prevUnitX[index]=targetX
                        set s__HagoromoQW_prevUnitY[index]=targetY
                    endif
                endif

                // If the unit has left the radius, remove it from tracking
                if SquareRoot(( GetUnitX(u) - s__HagoromoQW_target_x[this] ) * ( GetUnitX(u) - s__HagoromoQW_target_x[this] ) + ( GetUnitY(u) - s__HagoromoQW_target_y[this] ) * ( GetUnitY(u) - s__HagoromoQW_target_y[this] )) > dynamicRadius then
                    // Remove tracking data for the unit
                    set s__HagoromoQW_trackedUnits[index]=s__HagoromoQW_trackedUnits[s__HagoromoQW_trackedCount - 1] // Replace with the last unit to avoid gaps
                    set s__HagoromoQW_prevUnitX[index]=s__HagoromoQW_prevUnitX[s__HagoromoQW_trackedCount - 1] // Shift the previous position values
                    set s__HagoromoQW_prevUnitY[index]=s__HagoromoQW_prevUnitY[s__HagoromoQW_trackedCount - 1]
                    set s__HagoromoQW_trackedCount=s__HagoromoQW_trackedCount - 1
                endif

                call GroupRemoveUnit(s__HagoromoQW_tempGroup[this], u)
            endif
        endloop
        
        set s__HagoromoQW_vineCount[this]=s__HagoromoQW_vineCount[this] + 1

        if s__HagoromoQW_vineCount[this] >= 150 then
            // Destroy vines after a delay
            call TimerStart(NewTimerEx(this), 1.0, false, function sc__HagoromoQW_removeVines)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__HagoromoQW_removeVines takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i= 0
        loop
            exitwhen i >= s__HagoromoQW_VINES_R1[this] + s__HagoromoQW_VINES_R2[this] + s__HagoromoQW_VINES_R3[this]
            call DestroyEffect(s__HagoromoQW_vines[i]) // Remove each vine effect
            set s__HagoromoQW_vines[i]=null
            set i=i + 1
        endloop

        set i=0
        loop
            exitwhen i >= s__HagoromoQW_trackedCount
            if s__HagoromoQW_rootEffects[i] != null then
                call DestroyEffect(s__HagoromoQW_rootEffects[i]) // Remove root effects
                set s__HagoromoQW_rootEffects[i]=null
            endif
            set i=i + 1
        endloop

        call ReleaseTimer(GetExpiredTimer())
        call s__HagoromoQW_deallocate(this)
    endfunction

    function s__HagoromoQW_ensnareEnemies takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real outerVineX= s__HagoromoQW_vineX[s__HagoromoQW_VINES_R3[this] - 1]
        local real outerVineY= s__HagoromoQW_vineY[s__HagoromoQW_VINES_R3[this] - 1]
        local unit u
        local integer index

        // Find enemies within the outer radius
        call GroupEnumUnitsInRange(s__HagoromoQW_tempGroup[this], outerVineX, outerVineY, s__HagoromoQW_OUTER_RADIUS[this] + 50, null)
        loop
            set u=FirstOfGroup(s__HagoromoQW_tempGroup[this])
            exitwhen u == null

            if IsUnitAlly(u, GetOwningPlayer(s__HagoromoQW_caster[this])) or IsUnitType(u, UNIT_TYPE_STRUCTURE) == true then
                call GroupRemoveUnit(s__HagoromoQW_tempGroup[this], u)
            endif

            if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoQW_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                set index=s__HagoromoQW_findTrackedUnit(u)
                if index != - 1 then
                    // Apply root effect visually and store it
                    set s__HagoromoQW_rootEffects[index]=AddSpecialEffectTarget(s__HagoromoQW_ROOT_EFFECT_PATH, u, "origin")
                endif

                // Apply ensnare or root effect to the unit
		call EsnareUnitTimed(s__HagoromoQW_caster[this] , u , 1.25)
                //call BJDebugMsg(R2S((500 + (GetHeroInt(this.caster, true) * (GetHeroLevel(this.caster) / 5))) * 0.5) )
                call UnitDamageTarget(s__HagoromoQW_caster[this], u, 400 + ( ( GetHeroInt(s__HagoromoQW_caster[this], true) * ( GetHeroLevel(s__HagoromoQW_caster[this]) / 10 ) ) * 0.75 ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)

                call GroupRemoveUnit(s__HagoromoQW_tempGroup[this], u)
            endif
        endloop

        call ReleaseTimer(GetExpiredTimer())
    endfunction


    function s__HagoromoQW_createRings takes integer ringNumber,integer vineCount,real angleIncrement,real radius returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real vinePosX
        local real vinePosY
        local integer i= 0

        // Create effects in a circular formation for the specified ring
        loop
            exitwhen i >= vineCount

            set vinePosX=s__HagoromoQW_target_x[this] + radius * Cos(s__HagoromoQW_angle[this] * bj_DEGTORAD)
            set vinePosY=s__HagoromoQW_target_y[this] + radius * Sin(s__HagoromoQW_angle[this] * bj_DEGTORAD)

            // Create vine effects only once
            if s__HagoromoQW_vines[ringNumber + i] == null then
                set s__HagoromoQW_vines[ringNumber + i]=AddSpecialEffect(s__HagoromoQW_VINE_EFFECT_PATH, vinePosX, vinePosY)
                call BlzSetSpecialEffectYaw(s__HagoromoQW_vines[ringNumber + i], Deg2Rad(s__HagoromoQW_angle[this]))
            endif

            // Store the position of each vine for future reference
            set s__HagoromoQW_vineX[ringNumber + i]=vinePosX
            set s__HagoromoQW_vineY[ringNumber + i]=vinePosY

            set s__HagoromoQW_angle[this]=s__HagoromoQW_angle[this] + angleIncrement
            set i=i + 1
        endloop
    endfunction

    function s__HagoromoQW_createRingsPeriodically takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angleIncrement
        local real radius

        if s__HagoromoQW_count[this] == 0 then
            // First ring
            set angleIncrement=360.0 / s__HagoromoQW_VINES_R1[this]
            set radius=s__HagoromoQW_VINE_RADIUS[this]
            call s__HagoromoQW_createRings(0 , s__HagoromoQW_VINES_R1[this] , angleIncrement , radius)
        elseif s__HagoromoQW_count[this] == 1 then
            // Second ring
            set angleIncrement=360.0 / s__HagoromoQW_VINES_R2[this]
            set radius=s__HagoromoQW_VINE_RADIUS[this] * 1.5
            call s__HagoromoQW_createRings(s__HagoromoQW_VINES_R1[this] , s__HagoromoQW_VINES_R2[this] , angleIncrement , radius)
        elseif s__HagoromoQW_count[this] == 2 then
            // Third ring
            set angleIncrement=360.0 / s__HagoromoQW_VINES_R3[this]
            set radius=s__HagoromoQW_VINE_RADIUS[this] * 2.0
            call s__HagoromoQW_createRings(s__HagoromoQW_VINES_R1[this] + s__HagoromoQW_VINES_R2[this] , s__HagoromoQW_VINES_R3[this] , angleIncrement , radius)

            // Start ensnare after 3 seconds and destroy timer after use
            call TimerStart(NewTimerEx(this), 1.50, false, function s__HagoromoQW_ensnareEnemies)
            call ReleaseTimer(GetExpiredTimer())
            return
        endif

        set s__HagoromoQW_count[this]=s__HagoromoQW_count[this] + 1
    endfunction

    function s__HagoromoQW_actions takes nothing returns nothing
        local integer this= s__HagoromoQW_allocate()
        local real caster_x= GetUnitX(s__HagoromoD_Hagoromo)
        local real caster_y= GetUnitY(s__HagoromoD_Hagoromo)
        local real target_x= GetSpellTargetX()
        local real target_y= GetSpellTargetY()

        set s__HagoromoQW_VINES_R1[this]=6 // Number of vines in first ring
        set s__HagoromoQW_VINES_R2[this]=8 // Number of vines in second ring
        set s__HagoromoQW_VINES_R3[this]=10 // Number of vines in third ring
        set s__HagoromoQW_VINE_RADIUS[this]=128.0 // Base radius for vines
        set s__HagoromoQW_PULL_DISTANCE[this]=15.0 // Pull distance for units
        set s__HagoromoQW_OUTER_RADIUS[this]=384.0 // Outer radius for ensnaring

        // Reuse or create the temp group
        if s__HagoromoQW_tempGroup[this] == null then
            set s__HagoromoQW_tempGroup[this]=CreateGroup()
        endif

        set s__HagoromoQW_angle[this]=Atan2(target_y - caster_y, target_x - caster_x) * bj_RADTODEG
        set s__HagoromoQW_caster[this]=s__HagoromoD_Hagoromo
        set s__HagoromoQW_target_x[this]=target_x
        set s__HagoromoQW_target_y[this]=target_y
        set s__HagoromoQW_count[this]=0
        set s__HagoromoQW_vineCount[this]=0

	call SetUnitAnimationByIndex(s__HagoromoQW_caster[this], 45)
        // Start the periodic creation of rings
        call TimerStart(NewTimerEx(this), 0.25, true, function s__HagoromoQW_createRingsPeriodically)

        // Start the slow and pull effect after the rings are created
        call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoQW_applyPull)
    endfunction 


