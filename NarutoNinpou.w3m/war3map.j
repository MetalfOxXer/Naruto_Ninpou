    function s__KabutoKidomaruNet_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KabutoKidomaruNet_missile[this])
        local real y= GetUnitY(s__KabutoKidomaruNet_missile[this])
        local real angle= Atan3(x , y , s__KabutoKidomaruNet_target_x[this] , s__KabutoKidomaruNet_target_y[this])
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local unit u
        call SetUnitX(s__KabutoKidomaruNet_missile[this], new_x)
        call SetUnitY(s__KabutoKidomaruNet_missile[this], new_y)
        call SetUnitFacing(s__KabutoKidomaruNet_missile[this], 180 + Rad2Deg(angle))
        call SetUnitFlyHeight(s__KabutoKidomaruNet_missile[this], 60 + ParabolaZ(300 , s__KabutoKidomaruNet_distance[this] , s__KabutoKidomaruNet_distance[this] - GetDistance(new_x , new_y , s__KabutoKidomaruNet_target_x[this] , s__KabutoKidomaruNet_target_y[this])), 0)
        if GetDistance(new_x , new_y , s__KabutoKidomaruNet_target_x[this] , s__KabutoKidomaruNet_target_y[this]) < 100 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KabutoKidomaruNet_caster[this]), 'h002', s__KabutoKidomaruNet_target_x[this], s__KabutoKidomaruNet_target_y[this], 270)
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KabutoKidomaruNet_target_x[this], s__KabutoKidomaruNet_target_y[this], 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KabutoKidomaruNet_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__KabutoKidomaruNet_caster[this], bj_lastCreatedUnit, 800, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    //set u = CreateAbilityDummy(this.caster, 'A01L')
                    //call IssueTargetOrder(u, "web", bj_lastCreatedUnit)
		    call EsnareUnitTimed(s__KabutoKidomaruNet_caster[this] , bj_lastCreatedUnit , 2.0)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set u=null
            call KillUnit(s__KabutoKidomaruNet_missile[this])
            set s__KabutoKidomaruNet_missile[this]=null
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__KabutoKidomaruNet_kidomaru[this]) )*1.0), (( GetUnitY(s__KabutoKidomaruNet_kidomaru[this]))*1.0))) // INLINED!!
            call KillUnit(s__KabutoKidomaruNet_kidomaru[this])
            call ShowUnit(s__KabutoKidomaruNet_kidomaru[this], false)
            set s__KabutoKidomaruNet_kidomaru[this]=null
            call s__KabutoKidomaruNet_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KabutoKidomaruNet_actions takes nothing returns nothing
