            call SetUnitX(s__ShinoQ_dummy[this], new_x)
            call SetUnitY(s__ShinoQ_dummy[this], new_y)

            set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\cong2.mdl", new_x, new_y)
