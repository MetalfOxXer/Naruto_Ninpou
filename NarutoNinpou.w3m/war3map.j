            set s__GaiDynamicEntry_Alloc___recycle[(0)]=this
        endfunction

    function s__GaiDynamicEntry_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__GaiDynamicEntry_caster[this])
        local real y= GetUnitY(s__GaiDynamicEntry_caster[this])
        local real angle= Atan3(GetUnitX(s__GaiDynamicEntry_caster[this]) , GetUnitY(s__GaiDynamicEntry_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__GaiDynamicEntry_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__GaiDynamicEntry_caster[this])))])) // INLINED!!
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 36)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 36)*1.0)) // INLINED!!
        call SetUnitAnimationByIndex(s__GaiDynamicEntry_caster[this], 26)
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__GaiDynamicEntry_caster[this], new_x)
            call SetUnitY(s__GaiDynamicEntry_caster[this], new_y)
            call SetUnitFacing(s__GaiDynamicEntry_caster[this], Rad2Deg(angle))
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__GaiDynamicEntry_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) and GetUnitTypeId(bj_lastCreatedUnit) != 'e03B' then
                    call SetUnitX(bj_lastCreatedUnit, new_x)
                    call SetUnitY(bj_lastCreatedUnit, new_y)
                    if ModuloInteger(s__GaiDynamicEntry_count[this], 5) == 0 then
                        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    endif
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__GaiDynamicEntry_damaged[this]) then
                    call GroupAddUnit(s__GaiDynamicEntry_damaged[this], bj_lastCreatedUnit)
                    call UnitDamageTarget(s__GaiDynamicEntry_caster[this], bj_lastCreatedUnit, 85 * GetUnitAbilityLevel(s__GaiDynamicEntry_caster[this], s__GaiDynamicEntry_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
	set s__GaiDynamicEntry_count[this]=s__GaiDynamicEntry_count[this] + 1
        if s__GaiDynamicEntry_count[this] > 17 then
            call SetUnitTimeScale(s__GaiDynamicEntry_caster[this], 1.0)
            call SetUnitFlyHeight(s__GaiDynamicEntry_caster[this], 0, 0)
            call DestroyGroup(s__GaiDynamicEntry_damaged[this])
            set s__GaiDynamicEntry_damaged[this]=null
            call s__GaiDynamicEntry_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__GaiDynamicEntry_actions takes nothing returns nothing
        local integer this= s__GaiDynamicEntry_allocate()
        set s__GaiDynamicEntry_caster[this]=GetTriggerUnit()
        set s__GaiDynamicEntry_count[this]=0
        call SetUnitTimeScale(s__GaiDynamicEntry_caster[this], 3.0)
        call SetUnitAnimation(s__GaiDynamicEntry_caster[this], "spell 7")
        call SetUnitFlyHeight(s__GaiDynamicEntry_caster[this], 50, 0)
        set s__GaiDynamicEntry_damaged[this]=CreateGroup()
        call TimerStart(NewTimerEx(this), 0.03, true, function s__GaiDynamicEntry_periodic)
    endfunction
    
    function s__GaiDynamicEntry_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(29 , s__GaiDynamicEntry_SPELL_ID , function s__GaiDynamicEntry_actions)
    endfunction
    
