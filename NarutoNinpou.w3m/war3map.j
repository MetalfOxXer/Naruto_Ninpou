    function s__ChiyoFlyingKunais_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x
        local real y
        local real new_x
        local real new_y
