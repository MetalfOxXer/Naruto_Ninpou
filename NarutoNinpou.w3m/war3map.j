//Implemented from module Alloc:
    
        function s__SMission_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SMission_Alloc___recycle[(0)] == 0 ) then
                set s__SMission_Alloc___instanceCount=s__SMission_Alloc___instanceCount + 1
                set this=s__SMission_Alloc___instanceCount
            else
                set this=s__SMission_Alloc___recycle[(0)]
                set s__SMission_Alloc___recycle[(0)]=s__SMission_Alloc___recycle[s__SMission_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__SMission_deallocate takes integer this returns nothing
            set s__SMission_Alloc___recycle[this]=s__SMission_Alloc___recycle[(0)]
            set s__SMission_Alloc___recycle[(0)]=this
        endfunction
   
 function s__SMission_start takes nothing returns nothing
  local integer this= (1)
  local integer team
  local boolean haspoints
		if GetItemTypeId(GetManipulatedItem()) == 'I05D' then
			if not udg_MissionsEnabled then
				return
			endif
               		if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
                   		set team=0
                   		set haspoints=( GetTeamPoints(7) - GetTeamPoints(3) ) >= 250 or ( GetTeamPoints(11) - GetTeamPoints(3) >= 250 )
               		elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
                   		set team=1
                   		set haspoints=( GetTeamPoints(3) - GetTeamPoints(7) ) >= 250 or ( GetTeamPoints(11) - GetTeamPoints(7) >= 250 )
               		else
                   		set team=2
                   		set haspoints=( GetTeamPoints(3) - GetTeamPoints(11) ) >= 250 or ( GetTeamPoints(7) - GetTeamPoints(11) >= 250 )
               		endif
               		if not udg_MissionSRankActive then
                   		if not udg_MissionSRankTeamCompleted[team] then
                           		if haspoints then
                                   		set udg_MissionSRankActive=true
                                   		set udg_MissionSRankTeams[team]=true
                                   		set udg_MissionSUnit=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
                                   		set udg_MissionSCount=0
										set s__SMission_delayMission=false
                               	   		call TimerStart(NewTimerEx(this), 0.1, false, function sc__SMission_actions)
                           		else
                           			call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Your team must have 250 points below the winning team before doing this mission.|r")
                           		endif
                   		else
                           		call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000This mission was already done by your team.|r")
                   		endif
               		else
                   		call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Someone is already doing this mission at this moment.|r")
               		endif
       		else
           		return
       		endif
       endfunction 
   
 function s__SMission_actions takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
         local unit u
       		call SetUnitPosition(udg_MissionSUnit, GetRectCenterX(gg_rct_MissionSEntry), GetRectCenterY(gg_rct_MissionSEntry))
       		set u=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'N01R', 9982, 2562, 128)
           	call UnitAddItemEx(u , 'I030')
           	call UnitAddItemEx(u , 'I006')
		call UnitAddItemEx(u , 'I038')
       		call SetHeroLevel(u, 1, true)
       		call PanCameraToTimedForPlayer(GetOwningPlayer(udg_MissionSUnit), GetRectCenterX(gg_rct_MissionSEntry), GetRectCenterY(gg_rct_MissionSEntry), 0)
       		set u=null
           	call ReleaseTimer(GetExpiredTimer())
 endfunction 
   
 function s__SMission_death takes nothing returns nothing
  local integer team
		if GetTriggerUnit() == udg_MissionSUnit then
			if IsPlayerAlly(GetTriggerPlayer(), Player(3)) then
                       		set team=0
                   	elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) then
                       		set team=1
                   	else
                       		set team=2
                   	endif
                   	set udg_MissionSRankActive=false
                   	set udg_MissionSRankTeams[team]=false
                   	set udg_MissionSUnit=null
               		set bj_lastCreatedGroup=CreateGroup()
                   	call GroupEnumUnitsInRange(bj_lastCreatedGroup, 9982, 2562, 1000, null)
                   	loop
                           set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                           exitwhen bj_lastCreatedUnit == null
                           if ( GetUnitTypeId(bj_lastCreatedUnit) == 'N01R' ) then
                           	call KillUnit(bj_lastCreatedUnit)
                   	   endif
                           call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                   	endloop
                   	call DestroyGroup(bj_lastCreatedGroup)
               	endif
       endfunction 
   
 function s__SMission_GetBank takes nothing returns unit
  local unit bank= null
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsOfPlayer(bj_lastCreatedGroup, GetOwningPlayer(udg_MissionSUnit), null)
		loop
                	set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
                 	if GetUnitTypeId(bj_lastCreatedUnit) == 'ncop' then
                     		set bank=bj_lastCreatedUnit
                    	 	exitwhen true
                 	endif
                 	call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
         	endloop
         	call DestroyGroup(bj_lastCreatedGroup)
         	return bank
 endfunction
   
  function s__SMission_delay3 takes nothing returns nothing
   local integer team
   local integer i
			if IsPlayerAlly(GetOwningPlayer(udg_MissionSUnit), Player(3)) then
				set team=0
			elseif IsPlayerAlly(GetOwningPlayer(udg_MissionSUnit), Player(7)) then
				set team=1
			else
				set team=2
			endif
			set udg_MissionSRankTeamCompleted[team]=true
			call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(GetOwningPlayer(udg_MissionSUnit)) + 1] + GetUnitName(udg_MissionSUnit) + " |cff87ceebcompleted a S-Rank mission!|r")
			//call UnitAddItemByIdSwapped('I05E', GetBank())
			set i=0
			loop
				exitwhen i > 11
				if IsPlayerAlly(Player(i), GetOwningPlayer(udg_MissionSUnit)) and udg_units33[i + 1] != null then
					set udg_SRankComplete[GetPlayerId(Player(i)) + 1]=1
            				call AdjustPlayerStateBJ(10, Player(i), PLAYER_STATE_RESOURCE_LUMBER)
				endif
				set i=i + 1
			endloop
			if IsPlayerAlly(GetOwningPlayer(udg_MissionSUnit), Player(3)) then
					call SetUnitPosition(udg_MissionSUnit, GetRectCenterX(gg_rct_FountainKonohagakure), GetRectCenterY(gg_rct_FountainKonohagakure))
			elseif IsPlayerAlly(GetOwningPlayer(udg_MissionSUnit), Player(7)) then
					call SetUnitPosition(udg_MissionSUnit, GetRectCenterX(gg_rct_FountainOtogakure), GetRectCenterY(gg_rct_FountainOtogakure))
			else
					call SetUnitPosition(udg_MissionSUnit, GetRectCenterX(gg_rct_FountainAkatsuki), GetRectCenterY(gg_rct_FountainAkatsuki))
			endif
			set udg_MissionSUnit=null
			set udg_MissionSRankActive=false
			call ReleaseTimer(GetExpiredTimer())
  endfunction



 function s__SMission_death2 takes nothing returns nothing
          	if udg_MissionSCount >= 1 and udg_MissionSRankActive and not s__SMission_delayMission then
				set s__SMission_delayMission=true
				call TimerStartEx((NewTimerEx(0)) , 3.0 , false , function s__SMission_delay3 , "MissionSRank_delay3") // INLINED!!
          	endif
 endfunction 
   
       function s__SMission_onInit takes nothing returns nothing
           call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_PICKUP_ITEM ) , Filter(( function s__SMission_start))) // INLINED!!
           call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__SMission_death))) // INLINED!!
           call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__SMission_death2))) // INLINED!!
       endfunction 
   
