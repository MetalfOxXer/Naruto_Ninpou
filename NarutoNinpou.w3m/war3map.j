        call SetUnitY(s__SasoriNewBlade_dummy[this], GetUnitY(s__SasoriNewBlade_caster[this]))
        //call PauseUnit(this.caster, true)
        call SetUnitPropWindow(s__SasoriNewBlade_caster[this], 0)
        call SetUnitAnimation(s__SasoriNewBlade_caster[this], "spell two")
        set s__SasoriNewBlade_target[this]=null
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__SasoriNewBlade_periodic , "SasoriNewBlade_periodic")
    endfunction
    
