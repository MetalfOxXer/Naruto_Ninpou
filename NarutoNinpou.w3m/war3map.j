            set s__KabutoSpells___KabutoPoison_clouds[this]=CreateGroup()
            loop
                set i=i + 1
                exitwhen i > 6
                set angle=Deg2Rad(GetUnitFacing(GetTriggerUnit()) + ( - 126 + ( 36 * i ) ))
                set new_x=caster_x + Cos(angle) * 100
                set new_y=caster_y + Sin(angle) * 100
                set new_x_2=caster_x + Cos(angle) * 500
                set new_y_2=caster_y + Sin(angle) * 500
                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e024', new_x, new_y, Rad2Deg(angle))
                call SetUnitVertexColor((bj_lastCreatedUnit ), ( 255 ), ( 0 ), ( 255 ), ( 255)) // INLINED!!
                call SetUnitX(bj_lastCreatedUnit, new_x)
                call SetUnitY(bj_lastCreatedUnit, new_y)
                call IssuePointOrder(bj_lastCreatedUnit, "move", new_x_2, new_y_2)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 4.0)
                call GroupAddUnit(s__KabutoSpells___KabutoPoison_clouds[this], bj_lastCreatedUnit)
            endloop
