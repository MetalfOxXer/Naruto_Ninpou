        function s__RoshiGeyser_dealDamage takes nothing returns boolean
		if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__RoshiGeyser_caster[s__RoshiGeyser_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
			if GetUnitState(s__RoshiGeyser_caster[s__RoshiGeyser_instance], UNIT_STATE_LIFE) < GetUnitState(s__RoshiGeyser_caster[s__RoshiGeyser_instance], UNIT_STATE_MAX_LIFE) / 2 and GetUnitState(s__RoshiGeyser_caster[s__RoshiGeyser_instance], UNIT_STATE_LIFE) > 0.405 then
				call UnitDamageTarget(s__RoshiGeyser_caster[s__RoshiGeyser_instance], GetFilterUnit(), ( 50 + GetHeroStr(s__RoshiGeyser_caster[s__RoshiGeyser_instance], true) / 1.25 ) / 3 * GetUnitAbilityLevel(s__RoshiGeyser_caster[s__RoshiGeyser_instance], s__RoshiGeyser_SPELL_ID) * ( 1.5 - GetUnitState(s__RoshiGeyser_caster[s__RoshiGeyser_instance], UNIT_STATE_LIFE) / GetUnitState(s__RoshiGeyser_caster[s__RoshiGeyser_instance], UNIT_STATE_MAX_LIFE) ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
			else
				call UnitDamageTarget(s__RoshiGeyser_caster[s__RoshiGeyser_instance], GetFilterUnit(), ( 50 + GetHeroStr(s__RoshiGeyser_caster[s__RoshiGeyser_instance], true) / 1.25 ) / 3 * GetUnitAbilityLevel(s__RoshiGeyser_caster[s__RoshiGeyser_instance], s__RoshiGeyser_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
			endif
			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl" ), (( GetUnitX(GetFilterUnit()) )*1.0), (( GetUnitY(GetFilterUnit()))*1.0))) // INLINED!!
		endif
          return false
        endfunction


 function s__RoshiGeyser_finish takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
         local unit u
        	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__RoshiGeyser_caster[this]), 'e04U', GetUnitX(s__RoshiGeyser_caster[this]), GetUnitY(s__RoshiGeyser_caster[this]), 270)
		call SetUnitAnimation(bj_lastCreatedUnit, "birth")
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\Lava Crack.mdx" ), (( GetUnitX(s__RoshiGeyser_caster[this]) )*1.0), (( GetUnitY(s__RoshiGeyser_caster[this]))*1.0))) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("war3mapImported\\bwaxec.mdx" ), (( GetUnitX(s__RoshiGeyser_caster[this]) )*1.0), (( GetUnitY(s__RoshiGeyser_caster[this]))*1.0))) // INLINED!!
        	set u=CreateAbilityDummy(s__RoshiGeyser_caster[this] , 'A0BU')
        	call SetUnitAbilityLevel(u, 'A0BU', 2)
        	call IssueImmediateOrder(u, "stomp")
		set u=null
        	set bj_lastCreatedGroup=CreateGroup()
        	set s__RoshiGeyser_instance=this
        	call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__RoshiGeyser_caster[this]), GetUnitY(s__RoshiGeyser_caster[this]), 450.0, Filter(function s__RoshiGeyser_dealDamage))
        	call DestroyGroup(bj_lastCreatedGroup)
		set s__RoshiGeyser_count[this]=s__RoshiGeyser_count[this] + 1
        	if s__RoshiGeyser_count[this] > 1 then
		    call s__RoshiGeyser_deallocate(this)
		    call ReleaseTimer(GetExpiredTimer())
        	endif
 endfunction 

