        call UnitAddAbility(bj_lastCreatedUnit, 'A09A')
        call IssueTargetOrderById(bj_lastCreatedUnit, 852274, GetTriggerUnit())
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
        call TimerStartEx((NewTimerEx(0)) , 0.2 , false , function s__KakashiLightningClone_clone , "KakashiLightningClone_clone") // INLINED!!
    endfunction
    
