function Trig_ObitoSetGlobals_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'U00Y' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ObitoSetGlobals_Actions takes nothing returns nothing
    set obito=GetTriggerUnit()
    call DisableTrigger(GetTriggeringTrigger())
endfunction

//===========================================================================
function InitTrig_ObitoSetGlobals takes nothing returns nothing
    set gg_trg_ObitoSetGlobals=CreateTrigger()
    call TriggerRegisterEnterRectSimple(gg_trg_ObitoSetGlobals, GetPlayableMapRect())
    call TriggerAddCondition(gg_trg_ObitoSetGlobals, Condition(function Trig_ObitoSetGlobals_Conditions))
