			call ReleaseTimer(GetExpiredTimer())
			set u=null
			return
		endif
		if GetWidgetLife(u) > 0.405 then
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(u), GetUnitY(u), 1000, null)
