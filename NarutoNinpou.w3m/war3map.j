//Implemented from module Alloc:
    
        function s__Ox_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__Ox_Alloc___recycle[(0)] == 0 ) then
                set s__Ox_Alloc___instanceCount=s__Ox_Alloc___instanceCount + 1
                set this=s__Ox_Alloc___instanceCount
            else
                set this=s__Ox_Alloc___recycle[(0)]
                set s__Ox_Alloc___recycle[(0)]=s__Ox_Alloc___recycle[s__Ox_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__Ox_deallocate takes integer this returns nothing
            set s__Ox_Alloc___recycle[this]=s__Ox_Alloc___recycle[(0)]
            set s__Ox_Alloc___recycle[(0)]=this
        endfunction
    
    function s__Ox_destroy takes integer this returns nothing
        call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__Ox_oxen[this]) )*1.0), (( GetUnitY(s__Ox_oxen[this]))*1.0))) // INLINED!!
        call KillUnit(s__Ox_oxen[this])
        call ShowUnit(s__Ox_oxen[this], false)
        call DestroyGroup(s__Ox_damaged[this])
        set s__Ox_oxen[this]=null
        set s__Ox_damaged[this]=null
        set s__Ox_caster[this]=null
        call s__Ox_deallocate(this)
    endfunction
    
    function s__Ox_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__Ox_oxen[this])
        local real y= GetUnitY(s__Ox_oxen[this])
        local real new_x= (((x )*1.0) + Cos((( s__Ox_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__Ox_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__Ox_count[this]=s__Ox_count[this] + 1
        call SetUnitX(s__Ox_oxen[this], new_x)
        call SetUnitY(s__Ox_oxen[this], new_y)
	    call SetUnitFacing(s__Ox_oxen[this], Rad2Deg(s__Ox_angle[this]))
        if ModuloInteger(s__Ox_count[this], 5) == 0 then
            call KillUnit((CreateUnit((GetOwningPlayer(s__Ox_caster[this]) ), ( 'e02G' ), (( new_x )*1.0), (( new_y )*1.0), (( GetRandomReal(0, 360))*1.0)))) // INLINED!!
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__Ox_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    set new_x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( s__Ox_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                    set new_y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( s__Ox_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
                    if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(bj_lastCreatedUnit, new_x)
                        call SetUnitY(bj_lastCreatedUnit, new_y)
                    endif
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                    if not IsUnitInGroup(bj_lastCreatedUnit, s__Ox_damaged[this]) then
                        call UnitDamageTarget(s__Ox_caster[this], bj_lastCreatedUnit, 1.0 * GetHeroInt(s__Ox_caster[this], true) * GetUnitAbilityLevel(s__Ox_caster[this], s__Ox_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			            if (UnitHasItemOfTypeBJ((s__Ox_caster[this] ), ( 'I01X'))) then // INLINED!!
            			    call SlowArea(s__Ox_caster[this] , GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , 300.0)
			            endif
                        call GroupAddUnit(s__Ox_damaged[this], bj_lastCreatedUnit)
                    endif
                endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__Ox_count[this] > 39 then
            call s__Ox_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__Ox_actions takes nothing returns nothing
        local integer this= s__Ox_allocate()
        set s__Ox_caster[this]=GetTriggerUnit()
        set s__Ox_damaged[this]=CreateGroup()
        set s__Ox_angle[this]=Atan3(GetUnitX(s__Ox_caster[this]) , GetUnitY(s__Ox_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        set s__Ox_oxen[this]=CreateUnit(GetTriggerPlayer(), 'h0A6', GetUnitX(s__Ox_caster[this]), GetUnitY(s__Ox_caster[this]), GetUnitFacing(s__Ox_caster[this]))
        call SetUnitAnimationByIndex(s__Ox_oxen[this], 5)
        call SetUnitTimeScale(s__Ox_oxen[this], 3.0)
        set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'h01V' ), (( GetUnitX(s__Ox_caster[this]) )*1.0), (( GetUnitY(s__Ox_caster[this]) )*1.0), (( 270.0)*1.0))) // INLINED!!
        call SetUnitAnimation(bj_lastCreatedUnit, "birth")
        call RecycleUnitDelayed(bj_lastCreatedUnit , 3.5)
        call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__Ox_caster[this]) )*1.0), (( GetUnitY(s__Ox_caster[this]))*1.0))) // INLINED!!
        call SetUnitAnimation(s__Ox_caster[this], "spell two")
        set s__Ox_count[this]=0
        call TimerStart(NewTimerEx(this), 0.03, true, function s__Ox_periodic)
    endfunction
    
    function s__Ox_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(95 , s__Ox_SPELL_ID , function s__Ox_actions)
    endfunction
    
