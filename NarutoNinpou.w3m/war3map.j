        //A0K0
        
        function s__GaiHachimon___Spell_destroy takes integer this returns nothing
            set s__GaiHachimon___Spell_caster[this]=null
            call s__GaiHachimon___Spell_deallocate(this)
        endfunction
        
        function s__GaiHachimon___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local integer id= (GetUnitUserData((s__GaiHachimon___Spell_caster[this]))) // INLINED!!
            if s__OPEN_GATE_COUNTER[id] == 8 then
                call UnitRemoveBuffs(s__GaiHachimon___Spell_caster[this], false, true)
            endif
	        set s__GaiHachimon___Spell_count[this]=s__GaiHachimon___Spell_count[this] + 1
            if ModuloInteger(s__GaiHachimon___Spell_count[this], 33) == 2 then
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaiHachimon___Spell_caster[this]), s__GaiHachimon___Spell_SPELL_ID, false)
            endif
            if GetUnitAbilityLevel(s__GaiHachimon___Spell_caster[this], 'B02Y') == 0 or s__GaiHachimon___Spell_count[this] > 30 * 33 then
                //if not bool_hirudora then
                    call AddUnitAnimationProperties(s__GaiHachimon___Spell_caster[this], "alternate", false)
                    //call UnitRemoveAbility(this.caster, 'A0JZ')
                    call UnitRemoveAbility(s__GaiHachimon___Spell_caster[this], 'B030')
                    call UnitRemoveAbility(s__GaiHachimon___Spell_caster[this], 'A0OA')
                //endif
                call UnitRemoveAbility(s__GaiHachimon___Spell_caster[this], 'B02Z')
                call UnitRemoveAbility(s__GaiHachimon___Spell_caster[this], 'A0JZ')
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__GaiHachimon___Spell_caster[this]), s__GaiHachimon___Spell_SPELL_ID, true)
                if s__OPEN_GATE_COUNTER[id] == 8 then
                    call SetUnitState(s__GaiHachimon___Spell_caster[this], UNIT_STATE_LIFE, GetUnitState(s__GaiHachimon___Spell_caster[this], UNIT_STATE_LIFE) * 0.1)
                elseif s__OPEN_GATE_COUNTER[id] > 3 then
                    //call StunUnitTimed(this.caster, 0.7 *  OPEN_GATE_COUNTER[id]) 
                    call SetUnitState(s__GaiHachimon___Spell_caster[this], UNIT_STATE_LIFE, GetUnitState(s__GaiHachimon___Spell_caster[this], UNIT_STATE_LIFE) * ( 1 - s__OPEN_GATE_COUNTER[id] * 0.015 ))
                endif
                set s__OPEN_GATE_COUNTER[id]= 0
                call s__GaiHachimon___Spell_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
        
        function s__GaiHachimon___Spell_actions2 takes nothing returns nothing
            local integer id= (GetUnitUserData((GetTriggerUnit()))) // INLINED!!
         local integer this= s__GaiHachimon___Spell_allocate()
            if GetUnitAbilityLevel(GetTriggerUnit(), s__GaiHachimon___Spell_SPELL_ID) == 0 then
                call s__GaiHachimon___Spell_deallocate(this)
                return
            endif
            if s__OPEN_GATE_COUNTER[id] < GetUnitAbilityLevel(GetTriggerUnit(), s__GaiHachimon___Spell_SPELL_ID) then
                if s__OPEN_GATE_COUNTER[id] >= 8 then
                    call s__GaiHachimon___Spell_deallocate(this)
                elseif s__OPEN_GATE_COUNTER[id] == 7 and GetHeroLevel(GetTriggerUnit()) < 60 then
                    call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000You reached the maximum gate level for the current Hachimon level.|r")
                    //call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000You can only open the Gate of Death after level 50.|r")
                    call s__GaiHachimon___Spell_deallocate(this)
                else
                    //if OPEN_GATE_COUNTER[id] == 0 then 
                    //    set OPEN_GATE_COUNTER[id] = 
                    //endif
                    set s__OPEN_GATE_COUNTER[id]= IMinBJ(7, 1 + GetUnitAbilityLevel(GetTriggerUnit(), s__GaiHachimon___Spell_SPELL_ID))
                    set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0)
                    call UnitAddAbility(bj_lastCreatedUnit, 'A0K0')
                    call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0K0', s__OPEN_GATE_COUNTER[id])
                    call IssueTargetOrder(bj_lastCreatedUnit, "bloodlust", GetTriggerUnit())
                    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
                    if s__OPEN_GATE_COUNTER[id] > 3 then
                        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 0)
                        call UnitAddAbility(bj_lastCreatedUnit, 'A0K9')
                        call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A0K9', s__OPEN_GATE_COUNTER[id] - 3)
                        call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", GetTriggerUnit())
                        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
                    endif
                    if s__OPEN_GATE_COUNTER[id] == 8 then
                        call UnitAddAbility(GetTriggerUnit(), 'A0OA')
                        call UnitRemoveAbility(GetTriggerUnit(), 'A0JZ')
                    endif
                endif
            else
                call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000You reached the maximum gate level for the current Hachimon level.|r")
            endif
        endfunction
        
        function s__GaiHachimon___Spell_actions takes nothing returns nothing
            local integer this= s__GaiHachimon___Spell_allocate()
            set s__GaiHachimon___Spell_caster[this]=GetTriggerUnit()
            set s__GaiHachimon___Spell_count[this]=0
            call AddUnitAnimationProperties(s__GaiHachimon___Spell_caster[this], "alternate", true)
            call UnitAddAbility(s__GaiHachimon___Spell_caster[this], 'A0JZ')
            call AddLoadingBar(s__GaiHachimon___Spell_caster[this] , 30.0)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__GaiHachimon___Spell_periodic)
        endfunction
        
        function s__GaiHachimon___Spell_critical_actions takes unit caster,unit target returns nothing
            local real caster_x= GetUnitX(caster)
            local real caster_y= GetUnitY(caster)
            local real target_x= GetUnitX(target)
            local real target_y= GetUnitY(target)
            local real angle= Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            local real distance_x= target_x - caster_x
            local real distance_y= target_y - caster_y
            local real distance= SquareRoot(distance_x * distance_x + distance_y * distance_y)
            local real new_x= target_x + Cos(angle) * distance
            local real new_y= target_y + Sin(angle) * distance
	        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
				call SetUnitX(caster, new_x)
				call SetUnitY(caster, new_y)
		    endif
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( caster_x )*1.0), (( caster_y)*1.0))) // INLINED!!
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster), 'e01H', caster_x, caster_y, GetUnitFacing(caster))
            call SetUnitX(bj_lastCreatedUnit, caster_x)
            call SetUnitY(bj_lastCreatedUnit, caster_y)
            call SetUnitTimeScale(bj_lastCreatedUnit, 5.0)
            call SetUnitAnimation(bj_lastCreatedUnit, "spell 1")
            call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 150)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.15)
            call DestroyEffect(AddSpecialEffect(("abilities\\weapons\\catapult\\catapultmissile.mdl" ), (( target_x )*1.0), (( target_y)*1.0))) // INLINED!!
            call UnitDamageTarget(caster, target, ( 0.1 * GetHeroStr(caster, true) * GetUnitAbilityLevel(caster, 'A0L2') ) + ( 20 * GetUnitAbilityLevel(caster, 'A0L2') ), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        endfunction
        
        function s__GaiHachimon___Spell_critical takes nothing returns nothing
            local integer i= GetRandomInt(1, 100)
            if GetUnitTypeId(GetAttacker()) == 'E01P' and IsUnitEnemy(GetAttacker(), GetTriggerPlayer()) and i <= 30 then
                call s__GaiHachimon___Spell_critical_actions(GetAttacker() , GetTriggerUnit())
            endif
        endfunction
        
        function s__GaiHachimon___Spell_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(51 , s__GaiHachimon___Spell_SPELL_ID , function s__GaiHachimon___Spell_actions)
            call RegisterSpellEffectEventForId(51 , 'A0JZ' , function s__GaiHachimon___Spell_actions2)
            call RegisterPlayerUnitEventForId(51 , EVENT_PLAYER_UNIT_ATTACKED , function s__GaiHachimon___Spell_critical)
            set bool_hirudora=false
        endfunction
        
    
