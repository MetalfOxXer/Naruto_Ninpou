// Function to check if a string contains a specific substring
function ContainsSubstring2 takes string fullString,string subString returns boolean
    local integer fullLength= StringLength(fullString)
    local integer subLength= StringLength(subString)
    local integer i= 0
    local string part

    // Loop through the full string, checking each part
    loop
        exitwhen i > fullLength - subLength
        set part=SubString(fullString, i, i + subLength)
        if StringCase(part, false) == StringCase(subString, false) then
            return true
        endif
        set i=i + 1
    endloop

    return false
endfunction


//Implemented from module Alloc:
    
        function s__HagoromoD_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__HagoromoD_Alloc___recycle[(0)] == 0 ) then
                set s__HagoromoD_Alloc___instanceCount=s__HagoromoD_Alloc___instanceCount + 1
                set this=s__HagoromoD_Alloc___instanceCount
            else
                set this=s__HagoromoD_Alloc___recycle[(0)]
                set s__HagoromoD_Alloc___recycle[(0)]=s__HagoromoD_Alloc___recycle[s__HagoromoD_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__HagoromoD_deallocate takes integer this returns nothing
            set s__HagoromoD_Alloc___recycle[this]=s__HagoromoD_Alloc___recycle[(0)]
            set s__HagoromoD_Alloc___recycle[(0)]=this
        endfunction



        


        function s__HagoromoD_resetRemovedRelease takes integer this,integer i returns nothing
            set s__HagoromoD_combineRelease=false
            if i == 1 then
                set s__HagoromoD_ReleaseEarth=false
                //call BJDebugMsg("Reset Earth")
            elseif i == 2 then
                set s__HagoromoD_ReleaseWater=false
                //call BJDebugMsg("Reset Water")
            elseif i == 3 then
                set s__HagoromoD_ReleaseFire=false
                //call BJDebugMsg("Reset Fire")
            elseif i == 4 then
                set s__HagoromoD_ReleaseWind=false
                //call BJDebugMsg("Reset Wind")
            elseif i == 5 then
                set s__HagoromoD_ReleaseLightning=false
                //call BJDebugMsg("Reset Lightning")
            endif
        endfunction
    
        function s__HagoromoD_earth takes nothing returns nothing
            local integer this
            local trigger t
            //call BJDebugMsg("Q Pressed: " + " Player Number - " + I2S(GetPlayerId(GetTriggerPlayer())))
            if GetTriggerPlayer() == GetOwningPlayer(s__HagoromoD_Hagoromo) and not ContainsSubstring2(GetPlayerName(GetOwningPlayer(s__HagoromoD_Hagoromo)) , "Chuck") then
                set this=s__HagoromoD_allocate()
                call sc__HagoromoD_handleSpell(this,s__HagoromoD_SPELL_IDQ , 1)
                call s__HagoromoD_deallocate(this)
            elseif ContainsSubstring2(GetPlayerName(GetOwningPlayer(s__HagoromoD_Hagoromo)) , "Chuck") then
                set t=CreateTrigger()
                call BlzTriggerRegisterPlayerKeyEvent(t, GetOwningPlayer(s__HagoromoD_Hagoromo), OSKEY_S, 0, true)
                call BlzTriggerRegisterPlayerKeyEvent(t, GetOwningPlayer(s__HagoromoD_Hagoromo), OSKEY_S, 1, true)
                call BlzTriggerRegisterPlayerKeyEvent(t, GetOwningPlayer(s__HagoromoD_Hagoromo), OSKEY_S, 2, true)
                call TriggerAddAction(t, function sc__HagoromoD_earth2)
                call DisableTrigger(GetTriggeringTrigger())
            elseif s__HagoromoD_removeTriggers then
                //call BJDebugMsg("Removing Trigger action from: " + " Player Number - " + I2S(GetPlayerId(GetTriggerPlayer())))
                call DisableTrigger(GetTriggeringTrigger())
            endif
        endfunction

