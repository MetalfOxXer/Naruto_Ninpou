            set s__SakuraUltimateChoice_Alloc___recycle[this]=s__SakuraUltimateChoice_Alloc___recycle[(0)]
            set s__SakuraUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__SakuraUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__SakuraUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__SakuraUltimateChoice_caster[this]), 'A0SL', false)
        else
            call s__SakuraUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SakuraUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__SakuraUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__SakuraUltimateChoice_u, s__SakuraUltimateChoice_OKASHO)
            call UnitMakeAbilityPermanent(s__SakuraUltimateChoice_u, true, s__SakuraUltimateChoice_OKASHO)
        else
            call UnitAddAbility(s__SakuraUltimateChoice_u, s__SakuraUltimateChoice_SAKURABYAKUGOU)
            call UnitMakeAbilityPermanent(s__SakuraUltimateChoice_u, true, s__SakuraUltimateChoice_SAKURABYAKUGOU)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0SL', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0SL', false)
        set s__s__SakuraUltimateChoice_b[0]= null
        set s__s__SakuraUltimateChoice_b[1]= null
        set s__SakuraUltimateChoice_u=null
        call s__Dialog_destroy(s__SakuraUltimateChoice_d)
        call DestroyBoolExpr(s__SakuraUltimateChoice_pick)
        set s__SakuraUltimateChoice_pick=null
        set this=s__SakuraUltimateChoice_allocate()
        set s__SakuraUltimateChoice_caster[this]=s__SakuraUltimateChoice_u
        set s__SakuraUltimateChoice_pp[this]=GetOwningPlayer(s__SakuraUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__SakuraUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__SakuraUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__SakuraUltimateChoice_OKASHO) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__SakuraUltimateChoice_SAKURABYAKUGOU) == 0 then
            set s__SakuraUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__SakuraUltimateChoice_d,"Pick a skill")
            set s__s__SakuraUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__SakuraUltimateChoice_d)], ("Okasho" ), ( 0))) // INLINED!!
            set s__s__SakuraUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__SakuraUltimateChoice_d)], ("Byakugou" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__SakuraUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__SakuraUltimateChoice_d,s__SakuraUltimateChoice_pick)
            set s__SakuraUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__SakuraUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0SL' then
            set s__SakuraUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__SakuraUltimateChoice_onInit takes nothing returns nothing
        set s__SakuraUltimateChoice_pick=Condition(function s__SakuraUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__SakuraUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0SL' ) , Filter(( function s__SakuraUltimateChoice_actions))) // INLINED!!
    endfunction 
    
