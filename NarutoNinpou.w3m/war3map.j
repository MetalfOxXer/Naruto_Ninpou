            call PlaySoundOnUnitBJ(gg_snd_Itachi_Yasaka_Q, 100, GetTriggerUnit())
        endif
        set s__Yasaka_caster[this]=GetTriggerUnit()
        set s__Yasaka_target[this]=GetSpellTargetUnit()
        set s__Yasaka_missile[this]=CreateUnit(GetTriggerPlayer(), 'e03Q', GetUnitX(s__Yasaka_caster[this]), GetUnitY(s__Yasaka_caster[this]), 0)
        call SetUnitAnimation(itachi_susanoo, "spell one")
        call TimerStart(NewTimerEx(this), 0.03, true, function s__Yasaka_periodic)
    endfunction 
    
