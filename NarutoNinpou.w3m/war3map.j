		call SetUnitAnimationByIndex(s__KimimaroKaramatsu_caster[this], 5)
		call SetUnitFlyHeight(s__KimimaroKaramatsu_caster[this], Parabola(0 , 0 , 300 , s__KimimaroKaramatsu_dist[this] , 30 * s__KimimaroKaramatsu_count[this]), 0)
		call SetUnitFacing(s__KimimaroKaramatsu_caster[this], Rad2Deg(angle))
