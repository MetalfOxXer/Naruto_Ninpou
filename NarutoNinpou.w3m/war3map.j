 function s__JuugoAttack_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real unit_x= GetUnitX(s__JuugoAttack_caster[this])
  local real unit_y= GetUnitY(s__JuugoAttack_caster[this])
  local real new_x
  local real new_y
  local integer i= 0
  local integer j= 0
		loop
                	set i=i + 1
			set j=0
                	exitwhen i > 25
			loop
				set j=j + 1
				exitwhen j > 6
					set s__JuugoAttack_facing[this]=Rad2Deg(s__JuugoAttack_angle[this]) + ( - 49 + 14 * j )
					set new_x=(((unit_x )*1.0) + Cos((( Deg2Rad(s__JuugoAttack_facing[this]) )*1.0)) * (( 28 * i)*1.0)) // INLINED!!
					set new_y=(((unit_y )*1.0) + Sin((( Deg2Rad(s__JuugoAttack_facing[this]) )*1.0)) * (( 28 * i)*1.0)) // INLINED!!
					set bj_lastCreatedGroup=CreateGroup()
					call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
					loop
						set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
						exitwhen bj_lastCreatedUnit == null
						if bj_lastCreatedUnit != s__JuugoAttack_caster[this] and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__JuugoAttack_damaged[this]) and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__JuugoAttack_caster[this])) then
							if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
								call UnitDamageTarget(s__JuugoAttack_caster[this], bj_lastCreatedUnit, s__JuugoAttack_damage[this], true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
							endif
							if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == true then
								call UnitDamageTarget(s__JuugoAttack_caster[this], bj_lastCreatedUnit, s__JuugoAttack_damage[this], true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
							endif
							call GroupAddUnit(s__JuugoAttack_damaged[this], bj_lastCreatedUnit)
						endif
						call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
					endloop
					call DestroyGroup(bj_lastCreatedGroup)
                	endloop
		endloop
		call DestroyGroup(s__JuugoAttack_damaged[this])
		set s__JuugoAttack_damaged[this]=null
		set s__JuugoAttack_caster[this]=null
        	call s__JuugoAttack_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction
		
		
		
 function s__JuugoAttack_attack takes nothing returns nothing
     local integer this= s__JuugoAttack_allocate()
            local real caster_x
            local real offset= 30
            local real caster_y
            local real new_x
            local real new_y
            local real target_x
            local real target_y
            local integer i= 0
            if not IsUnitIllusion(GetAttacker()) and GetUnitTypeId(GetAttacker()) == 'E034' and ( GetUnitAbilityLevel(GetAttacker(), 'B02D') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B00N') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B02J') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B04N') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B03N') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B00G') > 0 or GetUnitAbilityLevel(GetAttacker(), 'B00K') > 0 ) and IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) == true then
            	set s__JuugoAttack_damage[this]=GetUnitState(GetAttacker(), UNIT_STATE_MAX_LIFE) * GetUnitAbilityLevel(GetAttacker(), 'A0CI') * 0.003
            	if GetUnitState(GetAttacker(), UNIT_STATE_LIFE) > s__JuugoAttack_damage[this] then
            		call SetUnitLifeBJ(GetAttacker(), GetUnitState(GetAttacker(), UNIT_STATE_LIFE) - s__JuugoAttack_damage[this] / 4)
            	endif
            	set target_x=GetUnitX(GetTriggerUnit())
            	set target_y=GetUnitY(GetTriggerUnit())
            	set s__JuugoAttack_damaged[this]=CreateGroup()
            	set s__JuugoAttack_caster[this]=GetAttacker()
            	call SetUnitAnimationByIndex(s__JuugoAttack_caster[this], 12)
            	set caster_x=GetUnitX(s__JuugoAttack_caster[this])
            	set caster_y=GetUnitY(s__JuugoAttack_caster[this])
            	set new_x=(((GetUnitX(s__JuugoAttack_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__JuugoAttack_caster[this])) )*1.0)) * (( 250)*1.0)) // INLINED!!
            	set new_y=(((GetUnitY(s__JuugoAttack_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__JuugoAttack_caster[this])) )*1.0)) * (( 250)*1.0)) // INLINED!!
            	set s__JuugoAttack_angle[this]=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            	set bj_lastCreatedEffect=AddSpecialEffect("PunchImpact.mdx", new_x, new_y)
            	call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__JuugoAttack_angle[this])
            	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
            	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
            	call TimerStartEx(NewTimerEx(this) , 0.03 , false , function s__JuugoAttack_periodic , "JuugoAttackScope_periodic")
	    else
        	call s__JuugoAttack_deallocate(this)
            endif
        endfunction
		


