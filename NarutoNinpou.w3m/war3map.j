                call UnitDamageTarget(s__HidanRW_caster[s__HidanRW_instance], GetFilterUnit(), ( 300 * GetUnitAbilityLevel(s__HidanRW_caster[s__HidanRW_instance], 'A0IJ') ) + GetHeroStr(s__HidanRW_caster[s__HidanRW_instance], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
