        call ReleaseTimer(GetExpiredTimer())
    endfunction
    
    function s__GaaraShukakuClaws_destroy takes integer this returns nothing
        call DestroyGroup(s__GaaraShukakuClaws_damaged[this])
        set s__GaaraShukakuClaws_damaged[this]=null
        set s__GaaraShukakuClaws_caster[this]=null
        call s__GaaraShukakuClaws_deallocate(this)
    endfunction
    
    function s__GaaraShukakuClaws_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local integer i
        set s__GaaraShukakuClaws_count[this]=s__GaaraShukakuClaws_count[this] + 1
        set i=0
        loop
            exitwhen i >= 12
            set x=(((s__GaaraShukakuClaws_x[this] )*1.0) + Cos((( Deg2Rad(360 / 12 * i) )*1.0)) * (( 20 * s__GaaraShukakuClaws_count[this])*1.0)) // INLINED!!
            set y=(((s__GaaraShukakuClaws_y[this] )*1.0) + Sin((( Deg2Rad(360 / 12 * i) )*1.0)) * (( 20 * s__GaaraShukakuClaws_count[this])*1.0)) // INLINED!!
            if ModuloInteger(s__GaaraShukakuClaws_count[this], 8) == 1 then
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__GaaraShukakuClaws_caster[this]), 'e08D', x, y, 360 / 12 * i)
                //call SetUnitScaleEx(bj_lastCreatedUnit, 5.0 - 0.16 * this.count, 5.0 - 0.16 * this.count, 5.0 - 0.16 * this.count)
                call SetUnitScale(bj_lastCreatedUnit, 2.0, 2.0, 2.0)
                call SetUnitX(bj_lastCreatedUnit, x)
                call SetUnitY(bj_lastCreatedUnit, y)
                //call KillUnit(bj_lastCreatedUnit)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
                //call AddSpecialEffectEx("Effects\\s_Earth_Smash.mdx", x, y)
            endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 180.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__GaaraShukakuClaws_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__GaaraShukakuClaws_damaged[this]) then
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                        call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                        call StunUnitTimed(s__GaaraShukakuClaws_caster[this] , bj_lastCreatedUnit , 2.0)
                        call SetUnitFlyHeight(bj_lastCreatedUnit, 300, 2100)
                        call SetUnitAnimation(bj_lastCreatedUnit, "death")
                        call TimerStart(NewTimerEx((GetUnitUserData((bj_lastCreatedUnit)))), 0.5, false, function s__GaaraShukakuClaws_fall) // INLINED!!
                    endif
                    call UnitDamageTarget(s__GaaraShukakuClaws_caster[this], bj_lastCreatedUnit, 1200, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(s__GaaraShukakuClaws_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=i + 1
        endloop
        if s__GaaraShukakuClaws_count[this] > 25 then
            call s__GaaraShukakuClaws_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__GaaraShukakuClaws_actions takes nothing returns nothing
        local integer this= s__GaaraShukakuClaws_allocate()
        set s__GaaraShukakuClaws_caster[this]=GetTriggerUnit()
        set s__GaaraShukakuClaws_damaged[this]=CreateGroup()
        set s__GaaraShukakuClaws_count[this]=0
        set s__GaaraShukakuClaws_x[this]=GetUnitX(s__GaaraShukakuClaws_caster[this])
        set s__GaaraShukakuClaws_y[this]=GetUnitY(s__GaaraShukakuClaws_caster[this])
        call TimerStart(NewTimerEx(this), 0.03, true, function s__GaaraShukakuClaws_periodic)
    endfunction
    
