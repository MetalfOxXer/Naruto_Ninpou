// Trigger: KonanFlyLevel
//===========================================================================

    function s__KonanFlyLevel_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
        if u == null then
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetHeroLevel(u) >= 35 and UnitAlive(u) and GetUnitAbilityLevel(u, 'A0WS') == 0 and GetUnitTypeId(u) != 'H048' and GetUnitAbilityLevel(u, 'A0DZ') == 10 and GetUnitAbilityLevel(u, 'A0WX') == 10 and GetUnitAbilityLevel(u, 'A0E0') == 10 and GetUnitAbilityLevel(u, 'A0E4') == 1 then
                call UnitRemoveAbility(u, 'A0D2')
                call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0D2', false)
                call UnitAddAbility(u, 'A0WS')
		call SetUnitFlyHeight(u, 200, 400)
		call SetUnitMoveSpeed(u, 370)
    		call AddUnitAnimationProperties(u, "alternate", true)
                 call ModifyHeroSkillPoints(u, bj_MODIFYMETHOD_SET, 0)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 

    function s__KonanFlyLevel_leave takes nothing returns nothing
        if GetUnitTypeId(GetLeavingUnit()) == 'H041' then
            call TimerStart(NewTimerEx((GetUnitUserData((GetLeavingUnit())))), 1.0, true, function s__KonanFlyLevel_periodic) // INLINED!!
        endif
    endfunction 

    function s__KonanFlyLevel_death takes nothing returns nothing
        if ( GetUnitTypeId(GetTriggerUnit()) == 'H048' or GetUnitTypeId(GetTriggerUnit()) == 'H041' ) and GetHeroLevel(GetTriggerUnit()) < 35 and GetHeroLevel(GetTriggerUnit()) >= 10 then
            call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0D2', true)
        endif
    endfunction

    function s__KonanFlyLevel_onInit takes nothing returns nothing
        call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__KonanFlyLevel_leave))) // INLINED!!
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_DEATH ) , Filter(( function s__KonanFlyLevel_death))) // INLINED!!
    endfunction 

//===========================================================================
// Trigger: CloneSwap
//===========================================================================

    
    function s__KonohamaruCloneSwap_actions takes nothing returns nothing
        
        local group g= CreateGroup()
        local unit u1
        local unit u2
        local real x1
        local real y1
        local real x2
        local real y2
        call GroupAddUnit(g, GetTriggerUnit())
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRect(bj_lastCreatedGroup, GetPlayableMapRect(), null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if GetOwningPlayer(bj_lastCreatedUnit) == GetTriggerPlayer() and IsUnitIllusion(bj_lastCreatedUnit) then
                call GroupAddUnit(g, bj_lastCreatedUnit)
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        loop
            set u1=FirstOfGroup(g)
            exitwhen u1 == null
            call GroupRemoveUnit(g, u1)
            set u2=GroupPickRandomUnit(g)
            exitwhen u2 == null
            set x1=GetUnitX(u1)
            set y1=GetUnitY(u1)
            set x2=GetUnitX(u2)
            set y2=GetUnitY(u2)
            call SetUnitX(u1, x2)
            call SetUnitY(u1, y2)
            call SetUnitX(u2, x1)
            call SetUnitY(u2, y1)
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( x2 )*1.0), (( y2)*1.0))) // INLINED!!
        endloop
        call DestroyGroup(g)
        set g=null
        set u1=null
        set u2=null
        call ShowUnit(GetTriggerUnit(), false)
        call ShowUnit(GetTriggerUnit(), true)
        call SelectUnitForPlayerSingle(GetTriggerUnit(), GetTriggerPlayer())
    endfunction
    
    function s__KonohamaruCloneSwap_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(66 , s__KonohamaruCloneSwap_SPELL_ID , function s__KonohamaruCloneSwap_actions)
    endfunction
    
