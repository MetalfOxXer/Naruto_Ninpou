    function s__NagatoAnimalArea_periodic takes nothing returns nothing
        local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
	if u == null then
            call ReleaseTimer(GetExpiredTimer())
        elseif GetWidgetLife(u) < 0.405 then
	    call UnitRemoveAbility(udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1], 'Binv')
	    call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(u) )*1.0), (( GetUnitY(u))*1.0))) // INLINED!!
	    call ShowUnit(u, false)
            call ReleaseTimer(GetExpiredTimer())
        else
            if GetDistanceUnits(u , udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1]) < 500 then
                set u=CreateAbilityDummy(udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1] , 'A0NF')
                call SetUnitAbilityLevel(u, 'A0NF', GetUnitAbilityLevel(udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1], 'A045'))
                call IssueTargetOrder(u, "invisibility", udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1])
            else
                call UnitRemoveAbility(udg_units33[GetPlayerId(GetOwningPlayer(u)) + 1], 'Binv')
            endif
        endif
    endfunction 

    function s__NagatoAnimalArea_actions takes unit caster returns nothing
        local integer i
     local unit u
        if udg_PeinPaths[(GetUnitUserData((caster)))] == 2 then // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRect(bj_lastCreatedGroup, GetPlayableMapRect(), null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                set i=GetUnitTypeId(bj_lastCreatedUnit)
                if i == 'h08T' or i == 'h092' or i == 'h08U' or i == 'h08V' or i == 'h08W' or i == 'h08X' or i == 'h08Y' or i == 'h08Z' or i == 'h090' or i == 'h091' or i == 'h075' or i == 'e02M' then
                    call KillUnit(bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
	        call SetUnitAnimation(caster, "spell two")
	
	    if udg_ShinraChannelings[(GetUnitUserData((caster)))] > 1.5 then // INLINED!!
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(caster), 'e02M', GetUnitX(caster), GetUnitY(caster), 270)
            call TimerStart(NewTimerEx((GetUnitUserData((bj_lastCreatedUnit)))), 1.5, true, function s__NagatoAnimalArea_periodic) // INLINED!!
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 20.0)
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(caster), GetUnitY(caster), 400, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(caster)) then
                    set u=CreateAbilityDummy(caster , 'A0NF')
                    call SetUnitAbilityLevel(u, 'A0NF', GetUnitAbilityLevel(caster, 'A045'))
                    call IssueTargetOrder(u, "invisibility", bj_lastCreatedUnit)
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
	    else
            	set bj_lastCreatedUnit=CreateAbilityDummy(caster , 'A06A')
            	call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A06A', GetUnitAbilityLevel(caster, s__NagatoAnimalArea_SPELL_ID))
            	call IssueImmediateOrder(bj_lastCreatedUnit, "wateryminion")
            	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
	    endif
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(caster) ), ( 'h01V' ), (( GetUnitX(caster) )*1.0), (( GetUnitY(caster) )*1.0), (( 270.0)*1.0))) // INLINED!!
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call RecycleUnitDelayed(bj_lastCreatedUnit , 3.5)
            call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(caster) )*1.0), (( GetUnitY(caster))*1.0))) // INLINED!!
        endif
    endfunction

