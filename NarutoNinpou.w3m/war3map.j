    endfunction 

    function s__IchigoENew_actions takes nothing returns nothing
        local integer this= s__IchigoENew_allocate()
        local real x
        local real y
        set s__IchigoENew_caster[this]=GetTriggerUnit()
        set s__IchigoENew_target[this]=GetSpellTargetUnit()
        set x=(((GetUnitX(s__IchigoENew_target[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__IchigoENew_target[this])) )*1.0)) * (( 120)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__IchigoENew_target[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__IchigoENew_target[this])) )*1.0)) * (( 120)*1.0)) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__IchigoENew_caster[this]) )*1.0), (( GetUnitY(s__IchigoENew_caster[this]))*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        call DestroyEffect(AddSpecialEffect(("war3mapImported\\Blood.mdl" ), (( GetUnitX(s__IchigoENew_target[this]) )*1.0), (( GetUnitY(s__IchigoENew_target[this]))*1.0))) // INLINED!!
        call UnitDamageTarget(s__IchigoENew_caster[this], s__IchigoENew_target[this], 0.4 * GetHeroAgi(s__IchigoENew_caster[this], true) * GetUnitAbilityLevel(s__IchigoENew_caster[this], s__IchigoENew_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        if udg_integers13[GetPlayerId(GetOwningPlayer(s__IchigoENew_caster[this])) + 1] >= 15 then
            call UnitDamageTarget(s__IchigoENew_caster[this], s__IchigoENew_target[this], ( 0.25 * GetHeroInt(s__IchigoENew_caster[this], true) + 0.25 * GetHeroStr(s__IchigoENew_caster[this], true) + 0.25 * GetHeroAgi(s__IchigoENew_caster[this], true) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif

        set bj_lastCreatedUnit=CreateAbilityDummy(s__IchigoENew_caster[this] , 'A1DP')
	    call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A1DP', GetUnitAbilityLevel(s__IchigoENew_caster[this], s__IchigoENew_SPELL_ID))
        call IssueTargetOrder(bj_lastCreatedUnit, "innerfire", s__IchigoENew_caster[this])
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)

        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__IchigoENew_caster[this]), 'n03F', GetUnitX(s__IchigoENew_caster[this]), GetUnitY(s__IchigoENew_caster[this]), GetUnitFacing(s__IchigoENew_caster[this]))
        call UnitAddAbility(bj_lastCreatedUnit, 'A057')
        call IssueTargetOrderBJ(bj_lastCreatedUnit, "attack", s__IchigoENew_target[this])
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)

        call SetUnitFacing(s__IchigoENew_caster[this], Rad2Deg(Atan3(x , y , GetUnitX(s__IchigoENew_target[this]) , GetUnitY(s__IchigoENew_target[this]))))
        call SetUnitX(s__IchigoENew_caster[this], x)
        call SetUnitY(s__IchigoENew_caster[this], y)
        call IssueTargetOrder(s__IchigoENew_caster[this], "attack", s__IchigoENew_target[this])

        call TimerStart(NewTimerEx(this), 0.1, false, function s__IchigoENew_periodic)
    endfunction 

