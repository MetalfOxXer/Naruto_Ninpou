    function s__TentenNewSemi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__TentenNewSemi_dummy[this])
        local real y= GetUnitY(s__TentenNewSemi_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__TentenNewSemi_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__TentenNewSemi_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local unit u= null
        set s__TentenNewSemi_count[this]=s__TentenNewSemi_count[this] + 1
		set s___TentenNewSemi_chains[s__TentenNewSemi_chains[this]+s__TentenNewSemi_count[this]]=AddSpecialEffect("war3mapImported\\ChainElement.mdl", new_x, new_y)
		//call BlzSetSpecialEffectPitch(this.chains[this.count], -1.57)
		call BlzSetSpecialEffectYaw(s___TentenNewSemi_chains[s__TentenNewSemi_chains[this]+s__TentenNewSemi_count[this]], s__TentenNewSemi_angle[this])
		call BlzSetSpecialEffectScale(s___TentenNewSemi_chains[s__TentenNewSemi_chains[this]+s__TentenNewSemi_count[this]], 2.0)
		call BlzSetSpecialEffectHeight(s___TentenNewSemi_chains[s__TentenNewSemi_chains[this]+s__TentenNewSemi_count[this]], 100 + GetPointZ(new_x , new_y))
		set s___TentenNewSemi_chains_x[s__TentenNewSemi_chains_x[this]+s__TentenNewSemi_count[this]]=new_x
		set s___TentenNewSemi_chains_y[s__TentenNewSemi_chains_y[this]+s__TentenNewSemi_count[this]]=new_y
        call SetUnitX(s__TentenNewSemi_dummy[this], new_x)
        call SetUnitY(s__TentenNewSemi_dummy[this], new_y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TentenNewSemi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set s__TentenNewSemi_target[this]=bj_lastCreatedUnit
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    set u=bj_lastCreatedUnit
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
            set s__TentenNewSemi_target[this]=u
            //call PauseUnit(this.caster, false)
            call PauseUnit(s__TentenNewSemi_target[this], true)
            call StunUnitTimed(s__TentenNewSemi_caster[this] , s__TentenNewSemi_target[this] , 2.5)
            set s__TentenNewSemi_angle[this]=GetAngleUnits(s__TentenNewSemi_dummy[this] , s__TentenNewSemi_target[this])
