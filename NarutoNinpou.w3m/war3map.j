// Trigger: KankuroSemi
//===========================================================================

function Trig_KankuroSemi1_Prevent takes nothing returns nothing
endfunction

function Trig_KankuroSemi1_Actions takes nothing returns nothing
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
		call PlaySoundOnUnitBJ(gg_snd_Kankuro_R, 100.0, GetTriggerUnit())
	endif
	set udg_KankuroIsKuroari=GetSpellAbilityId() == 'A0B0'
	set udg_KankuroHasCrow=udg_KankuroKarasu != null
	set udg_KankuroCount=0
	if udg_KankuroIsKuroari then
        call BlzStartUnitAbilityCooldown(udg_units33[GetPlayerId(GetTriggerPlayer()) + 1], 'A05U', 60.0)
		set udg_locations01[10]=GetUnitLoc(GetTriggerUnit())
		set udg_units15[10]=GetSpellTargetUnit()
		set udg_locations01[20]=PolarProjectionBJ(udg_locations01[10], 120.00, ( GetUnitFacing(GetTriggerUnit()) + 60.00 ))
		if udg_KankuroHasCrow then
			call SetUnitX(udg_KankuroKarasu, GetLocationX(udg_locations01[20]))
			call SetUnitY(udg_KankuroKarasu, GetLocationY(udg_locations01[20]))
			call SetUnitFacing(udg_KankuroKarasu, GetUnitFacing(GetTriggerUnit()))
			call PauseUnit(udg_KankuroKarasu, true)
			call SetUnitAnimation(udg_KankuroKarasu, "spell")
			set udg_units15[11]=udg_KankuroKarasu
		else
			call CreateNUnitsAtLoc(1, 'n007', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call CreateNUnitsAtLoc(1, 'hwt2', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A02Q')
			set udg_units15[11]=bj_lastCreatedUnit
			call SetUnitAnimation(bj_lastCreatedUnit, "spell")
		endif
		call RemoveLocation(udg_locations01[20])
		set udg_locations01[20]=PolarProjectionBJ(udg_locations01[10], 120.00, ( GetUnitFacing(GetTriggerUnit()) - 60.00 ))
		call SetUnitX(udg_KankuroKuroari, GetLocationX(udg_locations01[20]))
		call SetUnitY(udg_KankuroKuroari, GetLocationY(udg_locations01[20]))
		set udg_units15[12]=udg_KankuroKuroari
		call PauseUnit(udg_KankuroKuroari, true)
		call SetUnitAnimation(udg_KankuroKuroari, "spell")
		call RemoveLocation(udg_locations01[10])
		call EnableTrigger(udg_trigger361)
	else
		set udg_locations01[10]=GetUnitLoc(GetTriggerUnit())
		set udg_units15[10]=GetSpellTargetUnit()
		set udg_locations01[20]=PolarProjectionBJ(udg_locations01[10], 120.00, ( GetUnitFacing(GetTriggerUnit()) + 60.00 ))
		if udg_KankuroHasCrow then
			call SetUnitX(udg_KankuroKarasu, GetLocationX(udg_locations01[20]))
			call SetUnitY(udg_KankuroKarasu, GetLocationY(udg_locations01[20]))
			call SetUnitFacing(udg_KankuroKarasu, GetUnitFacing(GetTriggerUnit()))
			call PauseUnit(udg_KankuroKarasu, true)
			call SetUnitAnimation(udg_KankuroKarasu, "spell")
			set udg_units15[11]=udg_KankuroKarasu
		else
			call CreateNUnitsAtLoc(1, 'n007', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call CreateNUnitsAtLoc(1, 'hwt2', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A02Q')
			set udg_units15[11]=bj_lastCreatedUnit
			call SetUnitAnimation(bj_lastCreatedUnit, "spell")
		endif
		call RemoveLocation(udg_locations01[20])
		set udg_locations01[20]=PolarProjectionBJ(udg_locations01[10], 120.00, ( GetUnitFacing(GetTriggerUnit()) - 60.00 ))
		if udg_KankuroKuroari != null then
            call BlzStartUnitAbilityCooldown(udg_KankuroKuroari, 'A0B0', 60.0)
			call SetUnitX(udg_KankuroKuroari, GetLocationX(udg_locations01[20]))
			call SetUnitY(udg_KankuroKuroari, GetLocationY(udg_locations01[20]))
			call PauseUnit(udg_KankuroKuroari, true)
			set udg_units15[12]=udg_KankuroKuroari
		else
			call CreateNUnitsAtLoc(1, 'n007', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call CreateNUnitsAtLoc(1, 'hwt3', GetOwningPlayer(GetTriggerUnit()), udg_locations01[20], GetUnitFacing(GetTriggerUnit()))
			call UnitAddAbility(bj_lastCreatedUnit, 'A02Q')
			set udg_units15[12]=bj_lastCreatedUnit
		endif
		call SetUnitAnimation(bj_lastCreatedUnit, "spell")
		call RemoveLocation(udg_locations01[10])
		//call TriggerSleepAction(0.30)
		call EnableTrigger(udg_trigger361)
	endif
endfunction

function Trig_KankuroSemi2_Func003Func007C takes nothing returns boolean
	return ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) <= 50.00 ) ) or ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) >= 1500.00 ) )
endfunction

function Trig_KankuroSemi2_Func003C takes nothing returns boolean
	return ( ( ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) <= 50.00 ) ) or ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) >= 1500.00 ) ) ) )
endfunction

function Trig_KankuroSemi2_Actions takes nothing returns nothing
	set udg_locations03[50]=GetUnitLoc(udg_units15[12])
	set udg_locations03[51]=GetUnitLoc(udg_units15[10])
	set udg_KankuroCount=udg_KankuroCount + 1
	if ( ( ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) <= 50.00 ) ) or ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) >= 1500.00 ) ) ) ) or ( udg_KankuroCount > 150 ) then
		call DisableTrigger(GetTriggeringTrigger())
		set udg_KankuroCount=0
		call EnableTrigger(udg_trigger362)
		call SetUnitAnimation(udg_units15[12], "spell two")
		call PauseUnit(udg_units15[10], true)
		call TriggerSleepAction(0.10)
		call ShowUnitHide(udg_units15[10])
	else
		set udg_locations03[52]=PolarProjectionBJ(udg_locations03[50], 20.00, AngleBetweenPoints(udg_locations03[50], udg_locations03[51]))
		call SetUnitPositionLocFacingLocBJ(udg_units15[12], udg_locations03[52], udg_locations03[51])
call AddSpecialEffectLocBJ((udg_locations03[50] ), ( "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		set udg_locations03[53]=GetUnitLoc(udg_units15[11])
		set udg_locations03[54]=PolarProjectionBJ(udg_locations03[52], 300.00, ( AngleBetweenPoints(udg_locations03[50], udg_locations03[53]) + 10.00 ))
		call SetUnitPositionLocFacingLocBJ(udg_units15[11], udg_locations03[54], udg_locations03[51])
call AddSpecialEffectLocBJ((udg_locations03[53] ), ( "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations03[52])
		call RemoveLocation(udg_locations03[53])
		call RemoveLocation(udg_locations03[54])
	endif
	call RemoveLocation(udg_locations03[50])
	call RemoveLocation(udg_locations03[51])
endfunction

function Trig_KankuroSemi3_Func003C takes nothing returns boolean
	return ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) <= 50.00 ) )
endfunction

function Trig_KankuroSemi3_Actions takes nothing returns nothing
	set udg_locations03[50]=GetUnitLoc(udg_units15[12])
	set udg_locations03[51]=GetUnitLoc(udg_units15[11])
	set udg_KankuroCount=udg_KankuroCount + 1
	if ( ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) <= 50.00 ) ) or ( udg_KankuroCount > 100 ) then
		call DisableTrigger(GetTriggeringTrigger())
		call SetUnitPositionLocFacingBJ(udg_units15[11], udg_locations03[50], GetUnitFacing(udg_units15[12]))
		call SetUnitAnimation(udg_units15[11], "spell two")
		call TriggerSleepAction(1.33)
call AddSpecialEffectLocBJ((udg_locations03[50] ), ( "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		set bj_forLoopAIndex=1
		set bj_forLoopAIndexEnd=6
		loop
			exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
			set udg_locations03[52]=PolarProjectionBJ(udg_locations03[50], GetRandomReal(0, 75.00), GetRandomReal(0, 360))
call AddSpecialEffectLocBJ((udg_locations03[52] ), ( "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl")) // INLINED!!
			call DestroyEffect(bj_lastCreatedEffect)
			call RemoveLocation(udg_locations03[52])
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		call ShowUnitShow(udg_units15[10])
		call PauseUnit(udg_units15[10], false)
		call CreateNUnitsAtLoc(1, 'nbee', GetOwningPlayer(udg_unit52), udg_locations01[50], GetRandomReal(0, 360))
		if udg_KankuroIsKuroari then
			call PauseUnit(udg_units15[12], false)
			call SetUnitAnimation(udg_units15[12], "stand")
			if udg_KankuroHasCrow then
				call PauseUnit(udg_units15[11], false)
				call SetUnitAnimation(udg_units15[11], "stand")
			else
				call RemoveUnit(udg_units15[11])
			endif
		else
			if udg_KankuroHasCrow then
				call PauseUnit(udg_units15[11], false)
				call SetUnitAnimation(udg_units15[11], "stand")
			else
				call RemoveUnit(udg_units15[11])
			endif
			if udg_units15[12] != udg_KankuroKuroari then
				call RemoveUnit(udg_units15[12])
			else
				call PauseUnit(udg_units15[12], false)
			endif
		endif
		call UnitDamageTarget(udg_unit52, udg_units15[10], ( 800.0 * GetUnitAbilityLevel(udg_unit52, 'A05U') ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
		call SelectUnitForPlayerSingle(udg_units15[10], GetOwningPlayer(udg_units15[10]))


		//call TriggerSleepAction(2.00)
		//call PauseUnit(udg_units15[10],false)
	else
		set udg_locations03[52]=PolarProjectionBJ(udg_locations03[50], ( DistanceBetweenPoints(udg_locations03[50], udg_locations03[51]) - 15.00 ), ( AngleBetweenPoints(udg_locations03[50], udg_locations03[51]) + 10.00 ))
		call SetUnitPositionLocFacingLocBJ(udg_units15[11], udg_locations03[52], udg_locations03[50])
call AddSpecialEffectLocBJ((udg_locations03[51] ), ( "Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")) // INLINED!!
		call DestroyEffect(bj_lastCreatedEffect)
		call RemoveLocation(udg_locations03[52])
	endif
	call RemoveLocation(udg_locations03[50])
	call RemoveLocation(udg_locations03[51])
	call UnitAddAbility(bj_lastCreatedUnit, 'A02Q')
endfunction

function InitTrig_KankuroSemi takes nothing returns nothing
	call RegisterSpellEffectEventForId(4 , 'A0B0' , function Trig_KankuroSemi1_Actions)
    	call RegisterSpellEffectEventForId(4 , 'A05U' , function Trig_KankuroSemi1_Actions)
	call RegisterPlayerUnitEventForId(4 , EVENT_PLAYER_UNIT_SPELL_CAST , function Trig_KankuroSemi1_Prevent)
	set udg_trigger361=CreateTrigger()
	call DisableTrigger(udg_trigger361)
	call TriggerRegisterTimerEventPeriodic(udg_trigger361, 0.02)
	call TriggerAddAction(udg_trigger361, function Trig_KankuroSemi2_Actions)
	set udg_trigger362=CreateTrigger()
	call DisableTrigger(udg_trigger362)
	call TriggerRegisterTimerEventPeriodic(udg_trigger362, 0.03)
	call TriggerAddAction(udg_trigger362, function Trig_KankuroSemi3_Actions)
endfunction 

//===========================================================================
// Trigger: KankuroFlamethrower
//===========================================================================
function Trig_KankuroFlamethrower_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0GI' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0AX' ) ) then
        return true
    endif
    return false
endfunction

function Trig_KankuroFlamethrower_Conditions takes nothing returns boolean
    if ( not Trig_KankuroFlamethrower_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_KankuroFlamethrower_Actions takes nothing returns nothing
    set udg_KankuroIsScorpion=GetSpellAbilityId() == 'A0AX'
    set udg_Kankuro_Fire_Point[1]=GetUnitLoc(GetTriggerUnit())
    set udg_Kankuro_Fire_Point[2]=GetSpellTargetLoc()
    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
        call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Kankuro: That's why you should never dare to challenge a master puppeteer!|r")
        call PlaySoundOnUnitBJ(gg_snd_Kankuro_T, 100, GetTriggerUnit())
    endif
    if udg_KankuroIsScorpion then
        set udg_Kankuro_Fire_Caster=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
        set udg_Kankuro_Fire_Point[3]=udg_Kankuro_Fire_Point[1]
        set udg_F_U[0]=GetTriggerUnit()
        call BlzStartUnitAbilityCooldown(udg_Kankuro_Fire_Caster, 'A0GI', 70.0)
    else
        set udg_Kankuro_Fire_Caster=GetTriggerUnit()
        set udg_Kankuro_Fire_Point[3]=PolarProjectionBJ(udg_Kankuro_Fire_Point[1], 100.00, AngleBetweenPoints(udg_Kankuro_Fire_Point[1], udg_Kankuro_Fire_Point[2]))
        //call AddSpecialEffectLocBJEx( udg_Kankuro_Fire_Point[3], "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" )
        //call DestroyEffect( GetLastCreatedEffectBJ() )
        set bj_lastCreatedUnit=GetDummy(GetOwningPlayer(udg_Kankuro_Fire_Caster) , "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" , GetLocationX(udg_Kankuro_Fire_Point[3]) , GetLocationY(udg_Kankuro_Fire_Point[1]) , 270)
        call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        if udg_KankuroScorpion != null then
            call BlzStartUnitAbilityCooldown(udg_KankuroScorpion, 'A0AX', 70.0)
            call SetUnitPositionLoc(udg_KankuroScorpion, udg_Kankuro_Fire_Point[3])
            call SetUnitFacing(udg_KankuroScorpion, AngleBetweenPoints(udg_Kankuro_Fire_Point[1], udg_Kankuro_Fire_Point[2]))
            call PauseUnit(udg_KankuroScorpion, true)
            set udg_F_U[0]=udg_KankuroScorpion
        else
            call CreateNUnitsAtLoc(1, 'h02W', GetTriggerPlayer(), udg_Kankuro_Fire_Point[3], AngleBetweenPoints(udg_Kankuro_Fire_Point[1], udg_Kankuro_Fire_Point[2]))
            set udg_F_U[0]=GetLastCreatedUnit()
        endif
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call RemoveLocation(udg_Kankuro_Fire_Point[GetForLoopIndexA()])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
    set udg_F_P[0]=GetUnitLoc(udg_F_U[0])
    set udg_F_P[1]=GetSpellTargetLoc()
    set udg_F_R[0]=AngleBetweenPoints(udg_F_P[0], udg_F_P[1])
    set udg_F_P[2]=PolarProjectionBJ(udg_F_P[0], 50.00, udg_F_R[0])
    set udg_F_I=0
    call PauseUnitBJ(true, udg_F_U[0])
    call SetUnitAnimation(udg_F_U[0], "spell")
    call StartTimerBJ(udg_F_T[0], true, 0.02)
endfunction

function Trig_KankuroFlamethrower_Cast takes nothing returns nothing

endfunction

//===========================================================================
function InitTrig_KankuroFlamethrower takes nothing returns nothing
    //call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CAST, function Trig_KankuroFlamethrower_Cast)
    set gg_trg_KankuroFlamethrower=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KankuroFlamethrower, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_KankuroFlamethrower, Condition(function Trig_KankuroFlamethrower_Conditions))
    call TriggerAddAction(gg_trg_KankuroFlamethrower, function Trig_KankuroFlamethrower_Actions)
    call EnableTriggerForId(4 , gg_trg_KankuroFlamethrower)
endfunction


//===========================================================================
// Trigger: KankuroFlamethrower LOOP
//===========================================================================
function Trig_KankuroFlamethrower_LOOP_Func001C takes nothing returns boolean
    if ( not ( udg_F_I == 20 ) ) then
        return false
    endif
    return true
endfunction

function Trig_KankuroFlamethrower_LOOP_Actions takes nothing returns nothing
    if ( Trig_KankuroFlamethrower_LOOP_Func001C() ) then
        set udg_F_I=( udg_F_I + 2 )
        call SetUnitTimeScalePercent(udg_F_U[0], 0.00)
        set udg_F_R[1]=( DistanceBetweenPoints(udg_F_P[2], udg_F_P[1]) / 20.00 )
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=R2I(udg_F_R[1])
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_F_P[3]=PolarProjectionBJ(udg_F_P[2], ( I2R(GetForLoopIndexA()) * 20.00 ), udg_F_R[0])
            call CreateNUnitsAtLoc(1, 'h02V', GetOwningPlayer(udg_F_U[0]), udg_F_P[3], udg_F_R[0])
            call UnitApplyTimedLifeBJ(2.50, 'BTLF', GetLastCreatedUnit())
            call RemoveLocation(udg_F_P[3])
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        call PauseTimerBJ(true, udg_F_T[0])
        call StartTimerBJ(udg_F_T[1], true, 0.15)
    else
        set udg_F_I=( udg_F_I + 1 )
    endif
endfunction

//===========================================================================
function InitTrig_KankuroFlamethrower_LOOP takes nothing returns nothing
    set gg_trg_KankuroFlamethrower_LOOP=CreateTrigger()
    call TriggerRegisterTimerExpireEventBJ(gg_trg_KankuroFlamethrower_LOOP, udg_F_T[0])
    call TriggerAddAction(gg_trg_KankuroFlamethrower_LOOP, function Trig_KankuroFlamethrower_LOOP_Actions)
endfunction


//===========================================================================
// Trigger: KankuroFlamethrower LOOP2
//===========================================================================
function Trig_F_loop_2_Func001Func008002003001 takes nothing returns boolean
    return ( IsUnitAliveBJ(GetFilterUnit()) == true )
endfunction

function Trig_F_loop_2_Func001Func008002003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_F_U[0])) == true )
endfunction

function Trig_F_loop_2_Func001Func008002003 takes nothing returns boolean
    return GetBooleanAnd((IsUnitAliveBJ(GetFilterUnit()) == true), (IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_F_U[0])) == true)) // INLINED!!
endfunction

function Trig_F_loop_2_Func001Func009A takes nothing returns nothing
    if IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == true then
        call UnitDamageTargetBJ(udg_F_U[0], GetEnumUnit(), ( ( 7.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, udg_Kankuro_Fire_Caster, true)) ) / 17.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
    else
        call UnitDamageTargetBJ(udg_F_U[0], GetEnumUnit(), ( ( 12.00 * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, udg_Kankuro_Fire_Caster, true)) ) / 17.00 ), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC)
    endif
	call SlowArea(GetTriggerUnit() , GetUnitX(GetEnumUnit()) , GetUnitY(GetEnumUnit()) , 500)


    set udg_F_P[3]=GetUnitLoc(GetEnumUnit())
call AddSpecialEffectLocBJ((udg_F_P[3] ), ( "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl")) // INLINED!!
    call DestroyEffect(GetLastCreatedEffectBJ())
    call RemoveLocation(udg_F_P[3])
endfunction

function Trig_F_loop_2_Func001Func011C takes nothing returns boolean
    if ( not ( udg_F_I > 35 ) ) then
        return false
    endif
    return true
endfunction

function Trig_F_loop_2_Func001C takes nothing returns boolean
    if ( not ( udg_F_I > 17 ) ) then
        return false
    endif
    return true
endfunction

function Trig_F_loop_2_Actions takes nothing returns nothing
    if ( Trig_F_loop_2_Func001C() ) then
        set udg_F_I=( udg_F_I + 1 )
call AddSpecialEffectLocBJ((udg_F_P[1] ), ( "Shockwave.mdx")) // INLINED!!
        call DestroyEffect(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ((udg_F_P[1] ), ( "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")) // INLINED!!
        call DestroyEffect(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ((udg_F_P[1] ), ( "NewGroundEX.mdx")) // INLINED!!
        call DestroyEffect(GetLastCreatedEffectBJ())
        set udg_F_G=GetUnitsInRangeOfLocMatching(500.00, udg_F_P[1], Condition(function Trig_F_loop_2_Func001Func008002003))
        call ForGroupBJ(udg_F_G, function Trig_F_loop_2_Func001Func009A)
        call DestroyGroup(udg_F_G)
        if ( Trig_F_loop_2_Func001Func011C() ) then
            set bj_lastCreatedEffect=AddSpecialEffect("AnimeFireEffectJiraiya.mdl", GetLocationX(udg_F_P[1]), GetLocationY(udg_F_P[1]))
            call DestroyEffect(bj_lastCreatedEffect)
            call PauseTimerBJ(true, udg_F_T[1])
            call RemoveLocation(udg_F_P[0])
            call RemoveLocation(udg_F_P[1])
            call RemoveLocation(udg_F_P[2])
            call SetUnitTimeScalePercent(udg_F_U[0], 100.00)
            call ResetUnitAnimation(udg_F_U[0])
            call PauseUnitBJ(false, udg_F_U[0])
            call IssueImmediateOrder(udg_F_U[0], "stop")
            if not udg_KankuroIsScorpion then
                set udg_Kankuro_Fire_Point[1]=GetUnitLoc(udg_F_U[0])
                set bj_lastCreatedUnit=GetDummy(GetOwningPlayer(udg_Kankuro_Fire_Caster) , "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" , GetLocationX(udg_Kankuro_Fire_Point[1]) , GetLocationY(udg_Kankuro_Fire_Point[1]) , 270)
                call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
                call RemoveLocation(udg_Kankuro_Fire_Point[1])
                if udg_F_U[0] != udg_KankuroScorpion then
                    call RemoveUnit(udg_F_U[0])
                else
                    call PauseUnit(udg_F_U[0], false)
                endif
                set udg_F_U[0]=null
            endif
        else
            call DoNothing()
        endif
    else
        call DoNothing()
    endif
endfunction

//===========================================================================
function InitTrig_KankuroFlamethrower_LOOP2 takes nothing returns nothing
    set gg_trg_KankuroFlamethrower_LOOP2=CreateTrigger()
