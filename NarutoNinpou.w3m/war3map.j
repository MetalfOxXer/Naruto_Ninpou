    function s__KonanSeaPaper_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= GetRandomReal(0, 2 * bj_PI)
        local real offset= GetRandomReal(0, 1300)
        local real x= (((s__KonanSeaPaper_caster_x[this] )*1.0) + Cos((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real y= (((s__KonanSeaPaper_caster_y[this] )*1.0) + Sin((( angle )*1.0)) * (( offset)*1.0)) // INLINED!!
        local real fly= GetRandomReal(400, 800)
        local real life= GetRandomReal(0.3, 0.8)
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__KonanSeaPaper_caster[this]) ), ( 'h04B' ), (( x )*1.0), (( y )*1.0), (( GetRandomReal(0, 360))*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, GetRandomReal(2.0, 4.0), 0, 0)
        call SetUnitFlyHeight(bj_lastCreatedUnit, fly, 0)
        call SetUnitFlyHeight(bj_lastCreatedUnit, 0, fly * ( 1 / life ))
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', life)
        set s__KonanSeaPaper_count[this]=s__KonanSeaPaper_count[this] + 1
        if s__KonanSeaPaper_count[this] > 33 * 4 then
            call s__KonanSeaPaper_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KonanSeaPaper_actions takes nothing returns nothing
        local integer this= s__KonanSeaPaper_allocate()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Konan: In order to kill you, I have prepared 600 billion explosive tags.|r")
            call PlaySoundOnUnitBJ(gg_snd_Konan_T_Aoe, 100, GetTriggerUnit())
        endif
        set s__KonanSeaPaper_caster[this]=GetTriggerUnit()
        set s__KonanSeaPaper_caster_x[this]=GetUnitX(s__KonanSeaPaper_caster[this])
        set s__KonanSeaPaper_caster_y[this]=GetUnitY(s__KonanSeaPaper_caster[this])
        set s__KonanSeaPaper_count[this]=0
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KonanSeaPaper_periodic)
    endfunction 
    
    function s__KonanSeaPaper_die takes nothing returns nothing
        local unit caster
        if GetUnitTypeId(GetTriggerUnit()) == 'h04B' then
            set caster=udg_units33[GetPlayerId(GetTriggerPlayer()) + 1]
            call DestroyEffect(AddSpecialEffect(("LW10.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 600, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(caster)) and bj_lastCreatedUnit != caster then
                    call UnitDamageTarget(caster, bj_lastCreatedUnit, 0.15 * GetHeroInt(caster, true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                elseif IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    call UnitDamageTarget(caster, bj_lastCreatedUnit, 0.3 * GetHeroInt(caster, true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        set caster=null
    endfunction 
    
    function s__KonanSeaPaper_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(38 , s__KonanSeaPaper_SPELL_ID , function s__KonanSeaPaper_actions)
        call RegisterPlayerUnitEventForId(38 , EVENT_PLAYER_UNIT_DEATH , function s__KonanSeaPaper_die)
    endfunction 
    
