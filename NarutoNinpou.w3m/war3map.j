 function s__SasoriPuppetHold_hold takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= GetUnitX(s__SasoriPuppetHold_target[this])
  local real y= GetUnitY(s__SasoriPuppetHold_target[this])
  local real angle= Deg2Rad(GetUnitFacing(s__SasoriPuppetHold_target[this])) + 90
  local real angle2= Deg2Rad(GetUnitFacing(s__SasoriPuppetHold_target[this])) - 90
  local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 300)*1.0)) // INLINED!!
  local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 300)*1.0)) // INLINED!!
  local real new_x2= (((x )*1.0) + Cos((( angle2 )*1.0)) * (( 300)*1.0)) // INLINED!!
  local real new_y2= (((y )*1.0) + Sin((( angle2 )*1.0)) * (( 300)*1.0)) // INLINED!!
		call SetUnitX(s__SasoriPuppetHold_projectile[this], new_x)
		call SetUnitY(s__SasoriPuppetHold_projectile[this], new_y)
		call SetUnitX(s__SasoriPuppetHold_projectile2[this], new_x2)
		call SetUnitY(s__SasoriPuppetHold_projectile2[this], new_y2)
		set s__SasoriPuppetHold_count[this]=s__SasoriPuppetHold_count[this] + 1
		call UnitDamageTarget(s__SasoriPuppetHold_caster[this], s__SasoriPuppetHold_target[this], ( 4 * GetHeroStr(s__SasoriPuppetHold_caster[this], true) ) / 50, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
		if s__SasoriPuppetHold_count[this] > 50 then
			call s__Lightning_release(s__SasoriPuppetHold_chain[this],0.5)
			call s__Lightning_release(s__SasoriPuppetHold_chain2[this],0.5)
			call ShowUnit(s__SasoriPuppetHold_projectile[this], false)
			call KillUnit(s__SasoriPuppetHold_projectile[this])
			set s__SasoriPuppetHold_projectile[this]=null
			call ShowUnit(s__SasoriPuppetHold_projectile2[this], false)
			call KillUnit(s__SasoriPuppetHold_projectile2[this])
			set s__SasoriPuppetHold_projectile2[this]=null
			call SetUnitPropWindow(s__SasoriPuppetHold_target[this], s__SasoriPuppetHold_window[this])
            		call s__SasoriPuppetHold_deallocate(this)
           		call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction


