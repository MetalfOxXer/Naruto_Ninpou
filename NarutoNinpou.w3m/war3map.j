//===========================================================================
// Trigger: ShinoE
//===========================================================================
    
//Implemented from module Alloc:
    
        function s__ShinoE_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShinoE_Alloc___recycle[(0)] == 0 ) then
                set s__ShinoE_Alloc___instanceCount=s__ShinoE_Alloc___instanceCount + 1
                set this=s__ShinoE_Alloc___instanceCount
            else
                set this=s__ShinoE_Alloc___recycle[(0)]
                set s__ShinoE_Alloc___recycle[(0)]=s__ShinoE_Alloc___recycle[s__ShinoE_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShinoE_deallocate takes integer this returns nothing
            set s__ShinoE_Alloc___recycle[this]=s__ShinoE_Alloc___recycle[(0)]
            set s__ShinoE_Alloc___recycle[(0)]=this
        endfunction
        
        function s__ShinoE_actions takes nothing returns nothing
            local integer this= s__ShinoE_allocate()
            local real x
            local real y
            local integer i
            local real dist
            local real angle
            set s__ShinoE_caster[this]=GetTriggerUnit()
            set i=0
            loop
                set i=i + 1
                exitwhen i > 10
                set dist=GetRandomReal(25, 150)
                set angle=Deg2Rad(36 * i)
                set x=(((GetUnitX(s__ShinoE_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__ShinoE_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                if GetSpellAbilityId() == 'Aroa' then
                    set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ShinoE_caster[this]), 'unec', x, y, 36 * i)
                else
                    set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__ShinoE_caster[this]), 'u00T', x, y, 36 * i)
                endif
                set x=GetUnitX(s__ShinoE_caster[this]) + Cos(Deg2Rad(36 * i)) * 4000
                set y=GetUnitY(s__ShinoE_caster[this]) + Sin(Deg2Rad(36 * i)) * 4000
                call SetUnitMoveSpeed(bj_lastCreatedUnit, 522)
                call IssuePointOrder(bj_lastCreatedUnit, "move", x, y)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0 + GetUnitAbilityLevel(s__ShinoE_caster[this], GetSpellAbilityId()) / 5)
            endloop
            set s__ShinoE_caster[this]=null
            call s__ShinoE_deallocate(this)
        endfunction 
        

        function s__ShinoE_onInit takes nothing returns nothing
            call RegisterSpellEffectEvent2(('Aroa' ) , Filter(( function s__ShinoE_actions))) // INLINED!!
            call RegisterSpellEffectEvent2(('A0UN' ) , Filter(( function s__ShinoE_actions))) // INLINED!!
        endfunction 
        
    
//===========================================================================
// Trigger: ShinoR
//===========================================================================
    
//Implemented from module Alloc:
    
        function s__ShinoR_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ShinoR_Alloc___recycle[(0)] == 0 ) then
                set s__ShinoR_Alloc___instanceCount=s__ShinoR_Alloc___instanceCount + 1
                set this=s__ShinoR_Alloc___instanceCount
            else
                set this=s__ShinoR_Alloc___recycle[(0)]
                set s__ShinoR_Alloc___recycle[(0)]=s__ShinoR_Alloc___recycle[s__ShinoR_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__ShinoR_deallocate takes integer this returns nothing
            set s__ShinoR_Alloc___recycle[this]=s__ShinoR_Alloc___recycle[(0)]
            set s__ShinoR_Alloc___recycle[(0)]=this
        endfunction
        


        function s__ShinoR_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real damage= ( ( 800 + GetHeroInt(s__ShinoR_caster[this], true) ) * GetUnitAbilityLevel(s__ShinoR_caster[this], s__ShinoR_SPELL_ID) )
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__ShinoR_target_x[this], s__ShinoR_target_y[this], 400, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ShinoR_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                        if s__ShinoR_count[this] < 5 then
                            call UnitDamageTarget(s__ShinoR_caster[this], bj_lastCreatedUnit, damage / 3 / 5, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        else
                            call UnitDamageTarget(s__ShinoR_caster[this], bj_lastCreatedUnit, damage / 3 / 5 * 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        endif
			if BlzIsUnitInvulnerable(bj_lastCreatedUnit) == false then
                        	call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_MANA) - ( 300 * GetUnitAbilityLevel(s__ShinoR_caster[this], s__ShinoR_SPELL_ID) ) / 10)
			endif
                        if ModuloInteger(s__ShinoR_count[this], 5) == 0 then
                            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\CarrionSwarm\\CarrionSwarmDamage.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                        endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__ShinoR_count[this]=s__ShinoR_count[this] + 1
            if s__ShinoR_count[this] >= 10 then
                call s__ShinoR_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction 

        
        function s__ShinoR_actions takes nothing returns nothing
            local integer this= s__ShinoR_allocate()
            local real x
            local real y
            local integer i
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Shino_R, 80.0, GetTriggerUnit())
            endif
            set s__ShinoR_caster[this]=GetTriggerUnit()
            set s__ShinoR_count[this]=0
            set s__ShinoR_target_x[this]=GetSpellTargetX()
            set s__ShinoR_target_y[this]=GetSpellTargetY()
            call SetUnitAnimation(GetTriggerUnit(), "spell one")
            set i=1
            loop
                exitwhen i > 5
                set x=(((s__ShinoR_target_x[this] )*1.0) + Cos((( Deg2Rad(72 * i) )*1.0)) * (( 600)*1.0)) // INLINED!!
                set y=(((s__ShinoR_target_y[this] )*1.0) + Sin((( Deg2Rad(72 * i) )*1.0)) * (( 600)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'ucrm', x, y, 270)
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
                call IssuePointOrder(bj_lastCreatedUnit, "move", s__ShinoR_target_x[this], s__ShinoR_target_y[this])
                set i=i + 1
            endloop
            call TimerStartEx(NewTimerEx(this) , 0.15 , true , function s__ShinoR_periodic , "ShinoR_periodic")
        endfunction 
        

        function s__ShinoR_onInit takes nothing returns nothing
            call RegisterSpellEffectEventForId(17 , s__ShinoR_SPELL_ID , function s__ShinoR_actions)
        endfunction 
        
