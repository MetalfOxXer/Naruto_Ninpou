        function s__KisameSamehadaFusion__KisameSamehadaFusion_actions takes nothing returns nothing
            local integer this= s__KisameSamehadaFusion__KisameSamehadaFusion_allocate()
            local integer i
            local real x
            local real y
            set s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]=GetTriggerUnit()
            set i=1
            loop
                exitwhen i > 12
                set x=(((GetUnitX(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]) )*1.0) + Cos((( 30 * i )*1.0)) * (( 100)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]) )*1.0) + Sin((( 30 * i )*1.0)) * (( 100)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]), 'h02E', x, y, 30 * i)
                call UnitApplyTimedLifeBJ(1.50, 'BTLF', bj_lastCreatedUnit)
                set i=i + 1
            endloop
            if GetUnitTypeId(GetTriggerUnit()) == 'U005' then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Kisame: The stronger my opponent is, the stronger I grow... I never tire... and thats why some call me the biju without a tail|r")
                    call PlaySoundOnUnitBJ(gg_snd_Kisame_T, 100, GetTriggerUnit())
                endif
                set s__KisameSamehadaFusion__KisameSamehadaFusion_bubble[this]=CreateUnit(GetOwningPlayer(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]), 'h04G', GetUnitX(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]), GetUnitY(s__KisameSamehadaFusion__KisameSamehadaFusion_caster[this]), 30)
		        call SlowAura(s__KisameSamehadaFusion__KisameSamehadaFusion_bubble[this] , 0.15 , 700)
                call TimerStart(NewTimerEx(this), 0.01, false, function s__KisameSamehadaFusion__KisameSamehadaFusion_Delay)
            endif
        endfunction

        function s__KisameSamehadaFusion__KisameSamehadaFusion_death takes nothing returns nothing
            if GetUnitTypeId(GetTriggerUnit()) == 'h02E' then
                call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
                call ShowUnit(GetTriggerUnit(), false)
            endif
        endfunction

    
