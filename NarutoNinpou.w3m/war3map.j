        set s__ZabuzaKirigakureFarm_mist[this]=CreateGroup()
        loop
            exitwhen i > 2
            loop
                exitwhen j > 10
                set x=(((s__ZabuzaKirigakureFarm_caster_x[this] )*1.0) + Cos((( Deg2Rad(32 * j) )*1.0)) * (( 400)*1.0)) // INLINED!!
                set y=(((s__ZabuzaKirigakureFarm_caster_y[this] )*1.0) + Sin((( Deg2Rad(32 * j) )*1.0)) * (( 400)*1.0)) // INLINED!!
                set x1=(((s__ZabuzaKirigakureFarm_caster_x[this] )*1.0) + Cos((( Deg2Rad(32 * j) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                set y1=(((s__ZabuzaKirigakureFarm_caster_y[this] )*1.0) + Sin((( Deg2Rad(32 * j) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'z002', x, y, GetRandomDirectionDeg())
                if j == 1 then
                    call SlowAura(bj_lastCreatedUnit , 0.4 , 400)
                endif
                call IssuePointOrder(bj_lastCreatedUnit, "move", x1, y1)
                call GroupAddUnit(s__ZabuzaKirigakureFarm_mist[this], bj_lastCreatedUnit)
                set bj_lastCreatedUnit=null
                set j=j + 1
            endloop
            set i=i + 1
        endloop
        call TimerStart(NewTimerEx(this), 1.0, false, function s__ZabuzaKirigakureFarm_hide)
    endfunction
    
