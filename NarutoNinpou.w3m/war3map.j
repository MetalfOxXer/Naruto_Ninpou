                    if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TayuyaQOgre_caster[this])) and not IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) then
                        call GroupAddUnit(s__TayuyaQOgre_shockDamaged[wave], bj_lastCreatedUnit)
                        call StunUnitTimed(s__TayuyaQOgre_caster[this] , bj_lastCreatedUnit , 1.5)
                        call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, dmg, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
