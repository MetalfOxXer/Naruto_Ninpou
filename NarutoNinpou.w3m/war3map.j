//===========================================================================
//textmacro instance: UltimateChoice("Madara", "A0P8", "A0HQ", "SUSANOO", "Perfect Susano'o", "A0P3", "RIKUUDOU", "Rikuudou Mode")

//Implemented from module Alloc:
    
        function s__MadaraUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MadaraUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__MadaraUltimateChoice_Alloc___instanceCount=s__MadaraUltimateChoice_Alloc___instanceCount + 1
                set this=s__MadaraUltimateChoice_Alloc___instanceCount
            else
                set this=s__MadaraUltimateChoice_Alloc___recycle[(0)]
                set s__MadaraUltimateChoice_Alloc___recycle[(0)]=s__MadaraUltimateChoice_Alloc___recycle[s__MadaraUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MadaraUltimateChoice_deallocate takes integer this returns nothing
            set s__MadaraUltimateChoice_Alloc___recycle[this]=s__MadaraUltimateChoice_Alloc___recycle[(0)]
            set s__MadaraUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__MadaraUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__MadaraUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__MadaraUltimateChoice_caster[this]), 'A0P8', false)
        else
            call s__MadaraUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__MadaraUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__MadaraUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__MadaraUltimateChoice_u, s__MadaraUltimateChoice_SUSANOO)
            call UnitMakeAbilityPermanent(s__MadaraUltimateChoice_u, true, s__MadaraUltimateChoice_SUSANOO)
        else
            call UnitAddAbility(s__MadaraUltimateChoice_u, s__MadaraUltimateChoice_RIKUUDOU)
            call UnitMakeAbilityPermanent(s__MadaraUltimateChoice_u, true, s__MadaraUltimateChoice_RIKUUDOU)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0P8', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0P8', false)
        set s__s__MadaraUltimateChoice_b[0]= null
        set s__s__MadaraUltimateChoice_b[1]= null
        set s__MadaraUltimateChoice_u=null
        call s__Dialog_destroy(s__MadaraUltimateChoice_d)
        call DestroyBoolExpr(s__MadaraUltimateChoice_pick)
        set s__MadaraUltimateChoice_pick=null
        set this=s__MadaraUltimateChoice_allocate()
        set s__MadaraUltimateChoice_caster[this]=s__MadaraUltimateChoice_u
        set s__MadaraUltimateChoice_pp[this]=GetOwningPlayer(s__MadaraUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__MadaraUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__MadaraUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__MadaraUltimateChoice_SUSANOO) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__MadaraUltimateChoice_RIKUUDOU) == 0 then
            set s__MadaraUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__MadaraUltimateChoice_d,"Pick a skill")
            set s__s__MadaraUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__MadaraUltimateChoice_d)], ("Perfect Susano'o" ), ( 0))) // INLINED!!
            set s__s__MadaraUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__MadaraUltimateChoice_d)], ("Rikuudou Mode" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__MadaraUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__MadaraUltimateChoice_d,s__MadaraUltimateChoice_pick)
            set s__MadaraUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__MadaraUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0P8' then
            set s__MadaraUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__MadaraUltimateChoice_onInit takes nothing returns nothing
        set s__MadaraUltimateChoice_pick=Condition(function s__MadaraUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__MadaraUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0P8' ) , Filter(( function s__MadaraUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Madara", "A0P8", "A0HQ", "SUSANOO", "Perfect Susano'o", "A0P3", "RIKUUDOU", "Rikuudou Mode")

