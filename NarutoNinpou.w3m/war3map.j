        	set s__NejiNewUltimate_dummy[this]=null
        	set s__NejiNewUltimate_domo2[this]=null
        	set s__NejiNewUltimate_domo3[this]=null
		set s__NejiNewUltimate_domo[this]=null
		call SetUnitInvulnerable(s__NejiNewUltimate_caster[this], false)
		call s__NejiNewUltimate_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction
	
 function s__NejiNewUltimate_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real new_x
  local real new_y
  local real angle
  local real offset
         local unit u
         local group g
        	if ModuloInteger(s__NejiNewUltimate_count[this], 10) == 0 then
            		//call IssueImmediateOrder(this.dummy, "stomp")
        	endif
		call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__NejiNewUltimate_caster[this]) )*1.0), (( GetUnitY(s__NejiNewUltimate_caster[this]))*1.0))) // INLINED!!
		//call AddSpecialEffectEx("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", GetUnitX(this.caster), GetUnitY(this.caster))
		set angle=Atan3(GetUnitX(s__NejiNewUltimate_caster[this]) , GetUnitY(s__NejiNewUltimate_caster[this]) , s__NejiNewUltimate_target_x[this] , s__NejiNewUltimate_target_y[this])
		set new_x=(((GetUnitX(s__NejiNewUltimate_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
		set new_y=(((GetUnitY(s__NejiNewUltimate_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
		//call SetUnitX(this.domo, GetUnitX(this.caster))
		//call SetUnitY(this.domo, GetUnitY(this.caster))
        
		set s__NejiNewUltimate_count[this]=s__NejiNewUltimate_count[this] + 1
        	set g=CreateGroup()
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NejiNewUltimate_domo[this]), GetUnitY(s__NejiNewUltimate_domo[this]), 600, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NejiNewUltimate_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				call UnitDamageTarget(s__NejiNewUltimate_caster[this], bj_lastCreatedUnit, 13 * GetHeroAgi(s__NejiNewUltimate_caster[this], true) / 133.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
				if ModuloInteger(s__NejiNewUltimate_count[this], 5) == 1 then
					call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
					call SetUnitAnimation(bj_lastCreatedUnit, "death")
				endif
                call GroupAddUnit(g, bj_lastCreatedUnit)
			endif
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if GetDistance(GetUnitX(s__NejiNewUltimate_caster[this]) , GetUnitY(s__NejiNewUltimate_caster[this]) , s__NejiNewUltimate_target_x[this] , s__NejiNewUltimate_target_y[this]) < 50 then
            set u=GroupPickRandomUnit(g)
            //if u != null then 
            //    set this.target_x = GetUnitX(u)
            //    set this.target_y = GetUnitY(u)
            //endif 
		    call sc__NejiNewUltimate_start(this)
		endif
        call DestroyGroup(g)
		if s__NejiNewUltimate_count[this] > 133 then
            call SetUnitAnimation(s__NejiNewUltimate_caster[this], "morph")
			call s__NejiNewUltimate_destroy(this)
			//call SetUnitPropWindow(this.caster, this.window)
		endif
 endfunction 

 function s__NejiNewUltimate_start takes integer this returns nothing
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__NejiNewUltimate_domo[this]) )*1.0), (( GetUnitY(s__NejiNewUltimate_domo[this]))*1.0))) // INLINED!!
		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__NejiNewUltimate_caster[this]), 'hgry', GetUnitX(s__NejiNewUltimate_caster[this]), GetUnitY(s__NejiNewUltimate_caster[this]), GetUnitFacing(s__NejiNewUltimate_caster[this]))
		call SetUnitTimeScale(bj_lastCreatedUnit, 3.0)
		call SetUnitAnimationWithRarity(bj_lastCreatedUnit, "attack", RARITY_FREQUENT)
		call SetUnitVertexColorBJEx(bj_lastCreatedUnit , 100 , 100 , 100 , 60.00)
		call UnitApplyTimedLifeBJ(0.10, 'BTLF', bj_lastCreatedUnit)
		call SetUnitAnimationWithRarity(s__NejiNewUltimate_caster[this], "attack", RARITY_FREQUENT)
        call SetUnitX(bj_lastCreatedUnit, GetUnitX(s__NejiNewUltimate_caster[this]))
        call SetUnitY(bj_lastCreatedUnit, GetUnitY(s__NejiNewUltimate_caster[this]))
 endfunction 

 function s__NejiNewUltimate_decreaseTime takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call SetUnitTimeScale(s__NejiNewUltimate_domo2[this], 0.2)
        	set s__NejiNewUltimate_domo3[this]=CreateUnit(GetOwningPlayer(s__NejiNewUltimate_caster[this]), 'h06M', GetUnitX(s__NejiNewUltimate_domo[this]), GetUnitY(s__NejiNewUltimate_domo[this]), 270)
		set s__NejiNewUltimate_domo4[this]=CreateUnit(GetOwningPlayer(s__NejiNewUltimate_caster[this]), 'e073', GetUnitX(s__NejiNewUltimate_domo[this]), GetUnitY(s__NejiNewUltimate_domo[this]), 270)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 


        function s__NejiNewUltimate_delay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            call TimerStart(NewTimerEx(this), 0.02, true, function s__NejiNewUltimate_periodic)
	    call TimerStart(NewTimerEx(this), 0.5, false, function s__NejiNewUltimate_decreaseTime)
            call ReleaseTimer(GetExpiredTimer())
        endfunction 
        

 function s__NejiNewUltimate_actions takes nothing returns nothing
  local integer this= s__NejiNewUltimate_allocate()
  local real new_x
  local real new_y
		set s__NejiNewUltimate_caster[this]=GetTriggerUnit()
		set s__NejiNewUltimate_domo[this]=CreateUnit(GetTriggerPlayer(), 'h06M', GetUnitX(s__NejiNewUltimate_caster[this]), GetUnitY(s__NejiNewUltimate_caster[this]), 270)
        set s__NejiNewUltimate_domo2[this]=CreateUnit(GetTriggerPlayer(), 'h025', GetUnitX(s__NejiNewUltimate_domo[this]), GetUnitY(s__NejiNewUltimate_domo[this]), 270)
		call UnitAddAbility(s__NejiNewUltimate_caster[this], 'A02Q')
		call SetUnitAnimation(s__NejiNewUltimate_caster[this], "morph")
		call SetUnitTimeScale(s__NejiNewUltimate_caster[this], 2.0)
		set bj_lastCreatedUnit=CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'e007', GetUnitX(s__NejiNewUltimate_caster[this]), GetUnitY(s__NejiNewUltimate_caster[this]), 270)
		call UnitAddAbility(bj_lastCreatedUnit, 'A13V')
		call IssueTargetOrder(bj_lastCreatedUnit, "slow", s__NejiNewUltimate_caster[this])
		call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
		call PauseUnit(s__NejiNewUltimate_caster[this], true)
		if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Neji_T2_Hakke_Hyaku, 100, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Neji: People share only one common fate - death!|r")
        endif
		set s__NejiNewUltimate_count[this]=0
		set s__NejiNewUltimate_angle[this]=0
		set s__NejiNewUltimate_window[this]=GetUnitPropWindow(s__NejiNewUltimate_caster[this])
		//call SetUnitPropWindow(this.caster, 0)
		call SetUnitInvulnerable(s__NejiNewUltimate_caster[this], true)
		set s__NejiNewUltimate_target_x[this]=GetUnitX(s__NejiNewUltimate_caster[this])
		set s__NejiNewUltimate_target_y[this]=GetUnitY(s__NejiNewUltimate_caster[this])
        	set s__NejiNewUltimate_dummy[this]=GetInvisibleDummy(GetOwningPlayer(s__NejiNewUltimate_caster[this]) , GetUnitX(s__NejiNewUltimate_caster[this]) , GetUnitY(s__NejiNewUltimate_caster[this]))
        	call UnitAddAbility(s__NejiNewUltimate_dummy[this], 'A0BU')
		set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__NejiNewUltimate_caster[this]), 'e007', GetUnitX(s__NejiNewUltimate_caster[this]), GetUnitY(s__NejiNewUltimate_caster[this]), 270)
		call UnitAddAbility(bj_lastCreatedUnit, 'A15R')
		call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
		call TimerStart(NewTimerEx(this), 0.5, true, function s__NejiNewUltimate_delay)
 endfunction 
	
 function s__NejiNewUltimate_onInit takes nothing returns nothing
		call RegisterSpellEffectEventForId(14 , s__NejiNewUltimate_SPELL_ID , function s__NejiNewUltimate_actions)
 endfunction 

