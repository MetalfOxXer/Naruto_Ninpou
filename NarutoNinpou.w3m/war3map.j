    // Define a RealMax function for real numbers
    function RealMax takes real a,real b returns real
        if a > b then
            return a
        endif
        return b
    endfunction

    // Define a RealMin function for real numbers
    function RealMin takes real a,real b returns real
        if a < b then
            return a
        endif
        return b
    endfunction


//Implemented from module Alloc:
    
        function s__HagoromoRQ_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__HagoromoRQ_Alloc___recycle[(0)] == 0 ) then
                set s__HagoromoRQ_Alloc___instanceCount=s__HagoromoRQ_Alloc___instanceCount + 1
                set this=s__HagoromoRQ_Alloc___instanceCount
            else
                set this=s__HagoromoRQ_Alloc___recycle[(0)]
                set s__HagoromoRQ_Alloc___recycle[(0)]=s__HagoromoRQ_Alloc___recycle[s__HagoromoRQ_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__HagoromoRQ_deallocate takes integer this returns nothing
            set s__HagoromoRQ_Alloc___recycle[this]=s__HagoromoRQ_Alloc___recycle[(0)]
            set s__HagoromoRQ_Alloc___recycle[(0)]=this
        endfunction


        function s__HagoromoRQ_onCreate takes integer this returns nothing
            set s__HagoromoRQ_cosAngle[this]=Cos(s__HagoromoRQ_angle[this])
            set s__HagoromoRQ_sinAngle[this]=Sin(s__HagoromoRQ_angle[this])
        endfunction

        function s__HagoromoRQ_applyVisualCompression takes integer this returns nothing
            local real baseX= s__HagoromoRQ_casterX[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_cosAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
            local real baseY= s__HagoromoRQ_casterY[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_sinAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]
            local real centerX
         local real centerY
            local integer row
            local integer col
            local integer effectIndex
            local boolean hasEnemy

            set row=HagoromoPolarityShift___ROWS - 1
            loop
                exitwhen row < 0
                set col=0
                loop
                    exitwhen col >= HagoromoPolarityShift___COLS
                    set centerX=baseX + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
                    set centerY=baseY + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]

                    call GroupEnumUnitsInRange(HagoromoPolarityShift___tempGroup, centerX, centerY, HagoromoPolarityShift___CIRCLE_RADIUS, null)
                    set hasEnemy=FirstOfGroup(HagoromoPolarityShift___tempGroup) != null

                    if hasEnemy then
                        if row == 2 then
                            // Row 2 compresses into row 1
                            set effectIndex=row * HagoromoPolarityShift___COLS + col
                            set s__HagoromoPolarityShift___offsets[effectIndex]= RealMin(HagoromoPolarityShift___MAX_OFFSET , s__HagoromoPolarityShift___offsets[effectIndex] + HagoromoPolarityShift___COMPRESSION_SPEED)
                            set s__HagoromoPolarityShift___compressionFactors[effectIndex]= 1.0

                            // If a unit is detected in row 1, row 2 should compress all the way into row 0
                            if s__HagoromoPolarityShift___compressionFactors[( row - 1 ) * HagoromoPolarityShift___COLS + col] > 0.0 then
                                set s__HagoromoPolarityShift___offsets[effectIndex]= RealMin(HagoromoPolarityShift___MAX_OFFSET * 2 , s__HagoromoPolarityShift___offsets[effectIndex] + HagoromoPolarityShift___COMPRESSION_SPEED)
                            endif
                        elseif row == 1 then
                            // Row 1 compresses into row 0
                            set effectIndex=row * HagoromoPolarityShift___COLS + col
                            set s__HagoromoPolarityShift___offsets[effectIndex]= RealMin(HagoromoPolarityShift___MAX_OFFSET , s__HagoromoPolarityShift___offsets[effectIndex] + HagoromoPolarityShift___COMPRESSION_SPEED)
                            set s__HagoromoPolarityShift___compressionFactors[effectIndex]= 1.0

                            // Ensure row 2 compresses to row 0 if row 1 is occupied
                            if s__HagoromoPolarityShift___compressionFactors[effectIndex] > 0.0 then
                                set effectIndex=( row + 1 ) * HagoromoPolarityShift___COLS + col
                                set s__HagoromoPolarityShift___offsets[effectIndex]= RealMin(HagoromoPolarityShift___MAX_OFFSET * 2 , s__HagoromoPolarityShift___offsets[effectIndex] + HagoromoPolarityShift___COMPRESSION_SPEED)
                            endif
                        endif
                    else
                        set effectIndex=row * HagoromoPolarityShift___COLS + col

                        // Smooth transition back to the original position
                        set s__HagoromoPolarityShift___offsets[effectIndex]= RealMax(HagoromoPolarityShift___MIN_OFFSET , s__HagoromoPolarityShift___offsets[effectIndex] - HagoromoPolarityShift___DECOMPRESSION_SPEED)

                        if s__HagoromoPolarityShift___offsets[effectIndex] > HagoromoPolarityShift___MAX_OFFSET then
                            set s__HagoromoPolarityShift___offsets[effectIndex]= s__HagoromoPolarityShift___offsets[effectIndex] - ( HagoromoPolarityShift___DECOMPRESSION_SPEED * 0.5 ) // Smooth transition from over-compressed state
                        endif
                    
                        set s__HagoromoPolarityShift___compressionFactors[effectIndex]= 0.0
                    endif
                    
                    // Ensure the visual effect is in its correct position
                    set effectIndex=row * HagoromoPolarityShift___COLS + col
                    call BlzSetSpecialEffectPosition(s__HagoromoPolarityShift___effects[effectIndex], centerX - s__HagoromoPolarityShift___offsets[effectIndex] * s__HagoromoRQ_cosAngle[this], centerY - s__HagoromoPolarityShift___offsets[effectIndex] * s__HagoromoRQ_sinAngle[this], 0)
		    call BlzSetSpecialEffectColor(s__HagoromoPolarityShift___effects[effectIndex], 255, R2I(5 + 250 * s__HagoromoPolarityShift___compressionFactors[effectIndex]), 255)
		    call BlzSetSpecialEffectScale(s__HagoromoPolarityShift___effects[effectIndex], 3.0 + ( s__HagoromoPolarityShift___compressionFactors[effectIndex] * 0.5 ))
                    set col=col + 1
                endloop
                set row=row - 1
            endloop
        endfunction

        function s__HagoromoRQ_applyKnockback takes integer this returns nothing
            local real baseX= s__HagoromoRQ_casterX[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_cosAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
            local real baseY= s__HagoromoRQ_casterY[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_sinAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]
            local real centerX
            local real centerY
            local integer row
            local integer col
            local integer effectIndex
            local real knockbackForce
            local unit u

            set row=2
            loop
                exitwhen row < 0
                set col=0
                loop
                    exitwhen col >= HagoromoPolarityShift___COLS
                    set centerX=baseX + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
                    set centerY=baseY + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]

                    call GroupEnumUnitsInRange(HagoromoPolarityShift___tempGroup, centerX, centerY, HagoromoPolarityShift___CIRCLE_RADIUS, null)

                    loop
                        set u=FirstOfGroup(HagoromoPolarityShift___tempGroup)
                        exitwhen u == null

                        // Apply static knockback depending on the row
                        if row == 0 then
                            set knockbackForce=HagoromoPolarityShift___KNOCKBACK_FORCE_ROW_0
                        elseif row == 1 then
                            set knockbackForce=HagoromoPolarityShift___KNOCKBACK_FORCE_ROW_1
                        else
                            set knockbackForce=HagoromoPolarityShift___KNOCKBACK_FORCE_ROW_2
                        endif

                        // Apply the knockback force
                        if knockbackForce != 0 then
                            if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoRQ_caster[this])) and IsUnitType(u, UNIT_TYPE_STRUCTURE) == false then
                            call SetUnitX(u, GetUnitX(u) + knockbackForce * s__HagoromoRQ_cosAngle[this])
                            call SetUnitY(u, GetUnitY(u) + knockbackForce * s__HagoromoRQ_sinAngle[this])
                                //call BJDebugMsg(R2S((500 + (GetHeroInt(this.caster, true) * (GetHeroLevel(this.caster) / 5))) / 150))
                                call UnitDamageTarget(s__HagoromoRQ_caster[this], u, ( ( 500 + ( GetHeroInt(s__HagoromoRQ_caster[this], true) * ( GetHeroLevel(s__HagoromoRQ_caster[this]) / 10.0 ) ) ) / 2 ) / 150, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                            endif
                        endif

                        call GroupRemoveUnit(HagoromoPolarityShift___tempGroup, u)
                    endloop

                    set col=col + 1
                endloop
                set row=row - 1
            endloop
        endfunction

        function s__HagoromoRQ_onTick takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            call s__HagoromoRQ_applyVisualCompression(this)
            call s__HagoromoRQ_applyKnockback(this)

            set s__HagoromoRQ_durationRemaining[this]=s__HagoromoRQ_durationRemaining[this] - HagoromoPolarityShift___TICK_INTERVAL
            if s__HagoromoRQ_durationRemaining[this] <= 0 then
                call sc__HagoromoRQ_cleanup(this)
            endif
        endfunction

        function s__HagoromoRQ_cleanup takes integer this returns nothing
            local real baseX= s__HagoromoRQ_casterX[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_cosAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
            local real baseY= s__HagoromoRQ_casterY[this] + HagoromoPolarityShift___START_OFFSET * s__HagoromoRQ_sinAngle[this] - ( HagoromoPolarityShift___COLS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) - ( HagoromoPolarityShift___ROWS - 1 ) * 0.5 * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]
            local real centerX
            local real centerY
            local integer row
            local integer col
            local integer effectIndex
            local real knockbackForce
            local unit u
            local integer i= 0
            loop
                exitwhen i >= HagoromoPolarityShift___ROWS * HagoromoPolarityShift___COLS
                if s__HagoromoPolarityShift___effects[i] != null then
                    call DestroyEffect(s__HagoromoPolarityShift___effects[i])
                    set s__HagoromoPolarityShift___effects[i]= null
                endif
                set i=i + 1
            endloop
            
            set row=2
            loop
                exitwhen row < 0
                set col=0
                loop
                    exitwhen col >= HagoromoPolarityShift___COLS
                    set centerX=baseX + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Cos(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_cosAngle[this]
                    set centerY=baseY + col * HagoromoPolarityShift___CIRCLE_DISTANCE * Sin(s__HagoromoRQ_angle[this] + bj_PI / 2) + row * HagoromoPolarityShift___CIRCLE_DISTANCE * s__HagoromoRQ_sinAngle[this]

                    call GroupEnumUnitsInRange(HagoromoPolarityShift___tempGroup, centerX, centerY, HagoromoPolarityShift___CIRCLE_RADIUS, null)

                    loop
                        set u=FirstOfGroup(HagoromoPolarityShift___tempGroup)
                        exitwhen u == null
                        if IsUnitEnemy(u, GetOwningPlayer(s__HagoromoRQ_caster[this])) and not IsUnitInGroup(u, s__HagoromoRQ_damaged[this]) then
                            //call BJDebugMsg(R2S((500 + (GetHeroInt(this.caster, true) * (GetHeroLevel(this.caster) / 5))) / 2))
                            call UnitDamageTarget(s__HagoromoRQ_caster[this], u, ( 500 + ( GetHeroInt(s__HagoromoRQ_caster[this], true) * ( GetHeroLevel(s__HagoromoRQ_caster[this]) / 10.0 ) ) ) / 2, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                        endif
                        call GroupAddUnit(s__HagoromoRQ_damaged[this], u)
                        call GroupRemoveUnit(HagoromoPolarityShift___tempGroup, u)
                    endloop

                    set col=col + 1
                endloop
                set row=row - 1
            endloop
            call GroupClear(s__HagoromoRQ_damaged[this])
            call DestroyGroup(s__HagoromoRQ_damaged[this])
            call ReleaseTimer(GetExpiredTimer())
            call s__HagoromoRQ_deallocate(this)
        endfunction

        function s__HagoromoRQ_delay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real targetX= (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__HagoromoD_Hagoromo)))]) // INLINED!!
            local real targetY= (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__HagoromoD_Hagoromo)))]) // INLINED!!

            set s__HagoromoRQ_angle[this]=Atan2(targetY - s__HagoromoRQ_casterY[this], targetX - s__HagoromoRQ_casterX[this])
            set s__HagoromoRQ_durationRemaining[this]=HagoromoPolarityShift___DURATION

            call s__HagoromoRQ_onCreate(this)

            call TimerStart(NewTimerEx(this), HagoromoPolarityShift___TICK_INTERVAL, true, function s__HagoromoRQ_onTick)
        endfunction

        function s__HagoromoRQ_actions takes nothing returns nothing
            local integer this= s__HagoromoRQ_allocate()
            local integer i= 0
            set s__HagoromoRQ_caster[this]=GetTriggerUnit()
            set s__HagoromoRQ_casterX[this]=GetSpellTargetX()
            set s__HagoromoRQ_casterY[this]=GetSpellTargetY()
            set s__HagoromoRQ_damaged[this]=CreateGroup()

	    call SetUnitAnimationByIndex(s__HagoromoRQ_caster[this], 39)
            // Create the visual effects grid and initialize offsets and compression factors
            loop
                exitwhen i >= HagoromoPolarityShift___ROWS * HagoromoPolarityShift___COLS
                if s__HagoromoPolarityShift___effects[i] != null then
                    call DestroyEffect(s__HagoromoPolarityShift___effects[i])
                endif
                set s__HagoromoPolarityShift___effects[i]= AddSpecialEffect(HagoromoPolarityShift___EFFECT_MODEL, s__HagoromoRQ_casterX[this], s__HagoromoRQ_casterY[this])
                call BlzSetSpecialEffectScale(s__HagoromoPolarityShift___effects[i], 3.0)
                call BlzSetSpecialEffectColor(s__HagoromoPolarityShift___effects[i], 255, 255, 255)
                set s__HagoromoPolarityShift___offsets[i]= HagoromoPolarityShift___MIN_OFFSET // Start with no offset
                set s__HagoromoPolarityShift___compressionFactors[i]= 0.0
                set i=i + 1
            endloop

            call TimerStart(NewTimerEx(this), 0.20, false, function s__HagoromoRQ_delay)
        endfunction

