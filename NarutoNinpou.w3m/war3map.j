 function s__MinimapIcons_resetMM takes nothing returns nothing
  local integer id= GetPlayerId(GetTriggerPlayer())
		if udg_MinimapToggleBoolean[id] then
			set udg_MinimapToggleBoolean[id]=false
			call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Enabled Minimap Icons!|r")
		else
			set udg_MinimapToggleBoolean[id]=true
			call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cffff0000Disabled Minimap Icons.|r")
		endif
 endfunction

 function s__MinimapIcons_onInit takes nothing returns nothing
      local trigger tg= CreateTrigger()
      local integer i= 0
    		loop
        		exitwhen i > 16
        		call TriggerRegisterPlayerChatEvent(tg, Player(i), "-togglemm", false)
        		set i=i + 1
    		endloop
    		call TriggerAddAction(tg, function s__MinimapIcons_resetMM)
 endfunction 

