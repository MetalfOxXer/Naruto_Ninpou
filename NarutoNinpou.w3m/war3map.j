    set gg_trg_KaguyaCleanPortals=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_KaguyaCleanPortals, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_KaguyaCleanPortals, Condition(function Trig_KaguyaCleanPortals_Conditions))
    call TriggerAddAction(gg_trg_KaguyaCleanPortals, function Trig_KaguyaCleanPortals_Actions)
endfunction


