            local real x= GetUnitX(s__AsumaAssault_caster[this])
            local real y= GetUnitY(s__AsumaAssault_caster[this])
     local real angle= Atan3(GetUnitX(s__AsumaAssault_caster[this]) , GetUnitY(s__AsumaAssault_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__AsumaAssault_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__AsumaAssault_caster[this])))])) // INLINED!!
            local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 35.0)*1.0)) // INLINED!!
            local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 35.0)*1.0)) // INLINED!!
            local real x1
            local real y1
            if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                call SetUnitX(s__AsumaAssault_caster[this], new_x)
                call SetUnitY(s__AsumaAssault_caster[this], new_y)
		call SetUnitFacing(s__AsumaAssault_caster[this], Rad2Deg(angle))

                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__AsumaAssault_caster[this]) )*1.0), (( GetUnitY(s__AsumaAssault_caster[this]))*1.0))) // INLINED!!
