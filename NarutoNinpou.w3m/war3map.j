    function s__MeiSuriyuudan_damagefix takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__MeiSuriyuudan_caster[s__MeiSuriyuudan_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
                    call UnitDamageTarget(s__MeiSuriyuudan_caster[s__MeiSuriyuudan_instance], GetFilterUnit(), ( 2.0 * GetHeroAgi(s__MeiSuriyuudan_caster[s__MeiSuriyuudan_instance], true) + 500 ) * GetUnitAbilityLevel(s__MeiSuriyuudan_caster[s__MeiSuriyuudan_instance], s__MeiSuriyuudan_SPELL_ID), TRUE, FALSE, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    //if IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
                        //set u = CreateUnit(GetOwningPlayer(instance.caster), 'e007', new_x, new_y, 270)
                        //call UnitAddAbility(u, 'A0QC')
                        //call IssueTargetOrder(u, "soulburn", GetFilterUnit())
                        //call UnitApplyTimedLife(u, 'BTLF', 2.0)
                    //endif
                endif
	return false
    endfunction
    
    function s__MeiSuriyuudan_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__MeiSuriyuudan_caster[this])
        local real y= GetUnitY(s__MeiSuriyuudan_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__MeiSuriyuudan_angle[this] )*1.0)) * (( s__MeiSuriyuudan_dist[this] / 22)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__MeiSuriyuudan_angle[this] )*1.0)) * (( s__MeiSuriyuudan_dist[this] / 22)*1.0)) // INLINED!!
        local unit u
        local integer i
        local integer j
        set s__MeiSuriyuudan_count[this]=s__MeiSuriyuudan_count[this] + 1
        call SetUnitX(s__MeiSuriyuudan_caster[this], new_x)
        call SetUnitY(s__MeiSuriyuudan_caster[this], new_y)
        call SetUnitX(s__MeiSuriyuudan_dragon[this], new_x)
        call SetUnitY(s__MeiSuriyuudan_dragon[this], new_y)
        call SetUnitFlyHeight(s__MeiSuriyuudan_caster[this], ParabolaZ(500 , s__MeiSuriyuudan_dist[this] , s__MeiSuriyuudan_dist[this] / 22.0 * s__MeiSuriyuudan_count[this]), 0)
        call SetUnitFlyHeight(s__MeiSuriyuudan_dragon[this], ParabolaZ(500 , s__MeiSuriyuudan_dist[this] , s__MeiSuriyuudan_dist[this] / 22.0 * s__MeiSuriyuudan_count[this]), 0)
        //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'e00N', new_x, new_y, Rad2Deg(this.angle))
        //call SetUnitFlyHeight(bj_lastCreatedUnit, GetUnitFlyHeight(this.dragon), 0) 
        //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)

		set bj_lastCreatedEffect=AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", new_x, new_y)
		call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__MeiSuriyuudan_angle[this])
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__MeiSuriyuudan_dragon[this]))
		call DestroyEffect(bj_lastCreatedEffect)

        if s__MeiSuriyuudan_count[this] > 22 then
            set i=1
            loop
                exitwhen i > 3
                set j=1
                loop
                    exitwhen j > 10
                    set x=(((new_x )*1.0) + Cos((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                    set y=(((new_y )*1.0) + Sin((( Deg2Rad(36 * j) )*1.0)) * (( 75 * i)*1.0)) // INLINED!!
                    //call AddSpecialEffectEx("war3mapImported\\AquaSpikeVersion2.mdx", x, y)
                    call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                    set j=j + 1
                endloop
                set i=i + 1
            endloop
            set bj_lastCreatedGroup=CreateGroup()
	    set s__MeiSuriyuudan_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300.0, Filter(function s__MeiSuriyuudan_damagefix))
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set u=null
            call s__MeiSuriyuudan_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__MeiSuriyuudan_actions takes nothing returns nothing
        local integer this= s__MeiSuriyuudan_allocate()
        set s__MeiSuriyuudan_caster[this]=GetTriggerUnit()
        set s__MeiSuriyuudan_x[this]=GetSpellTargetX()
        set s__MeiSuriyuudan_y[this]=GetSpellTargetY()
        set s__MeiSuriyuudan_angle[this]=Atan3(GetUnitX(s__MeiSuriyuudan_caster[this]) , GetUnitY(s__MeiSuriyuudan_caster[this]) , s__MeiSuriyuudan_x[this] , s__MeiSuriyuudan_y[this])
        set s__MeiSuriyuudan_dist[this]=GetDistance(GetUnitX(s__MeiSuriyuudan_caster[this]) , GetUnitY(s__MeiSuriyuudan_caster[this]) , s__MeiSuriyuudan_x[this] , s__MeiSuriyuudan_y[this])
        set s__MeiSuriyuudan_count[this]=0
        set s__MeiSuriyuudan_dragon[this]=GetDummy(GetOwningPlayer(s__MeiSuriyuudan_caster[this]) , "war3mapImported\\WyrmwrathIce2.mdl" , GetUnitX(s__MeiSuriyuudan_caster[this]) , GetUnitY(s__MeiSuriyuudan_caster[this]) , Rad2Deg(s__MeiSuriyuudan_angle[this]))
        call PauseUnit(s__MeiSuriyuudan_caster[this], true)
        call SetUnitAnimation(s__MeiSuriyuudan_caster[this], "attack slam")
        call SetUnitTimeScale(s__MeiSuriyuudan_caster[this], 3.0)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__MeiSuriyuudan_periodic)
    endfunction
    
    function s__MeiSuriyuudan_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__MeiSuriyuudan_SPELL_ID ) , Filter(( function s__MeiSuriyuudan_actions))) // INLINED!!
    endfunction
    
