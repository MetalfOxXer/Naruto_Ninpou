 function s__KakashiDogs_dies takes nothing returns nothing
		if GetUnitTypeId(GetTriggerUnit()) == 'nwlt' or GetUnitTypeId(GetTriggerUnit()) == 'h01U' or GetUnitTypeId(GetTriggerUnit()) == 'n01B' or GetUnitTypeId(GetTriggerUnit()) == 'n02I' then
			call ShowUnit(GetTriggerUnit(), false)
			if GetUnitTypeId(GetTriggerUnit()) == 'n02I' then
			else
				call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()))*1.0))) // INLINED!!
			endif
		endif
