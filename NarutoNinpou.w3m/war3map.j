        function s__TayuyaQOgre_shockwavePeriodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local group g= CreateGroup()
            local unit u
            local real dmgBase
            local real dmgMul
            local real ringPrevR
            local real ringR
            local integer pulseIndex

            set s__TayuyaQOgre_count[this]=s__TayuyaQOgre_count[this] + 1

            if s__TayuyaQOgre_shockFx[this] != null then
                call BlzSetSpecialEffectX(s__TayuyaQOgre_shockFx[this], s__TayuyaQOgre_shockX[this])
                call BlzSetSpecialEffectY(s__TayuyaQOgre_shockFx[this], s__TayuyaQOgre_shockY[this])
                call BlzSetSpecialEffectHeight(s__TayuyaQOgre_shockFx[this], GetPointZ(s__TayuyaQOgre_shockX[this] , s__TayuyaQOgre_shockY[this]))
            endif

            if ModuloInteger(s__TayuyaQOgre_count[this], s__TayuyaQOgre_SEG_SPAWN_EVERY) != 0 then
                call DestroyGroup(g)
                set g=null
                return
            endif

            set s__TayuyaQOgre_shockPulse[this]=s__TayuyaQOgre_shockPulse[this] + 1
            set pulseIndex=s__TayuyaQOgre_shockPulse[this]

            if pulseIndex > s__TayuyaQOgre_shockPulseMax[this] then
                if s__TayuyaQOgre_shockFx[this] != null then
                    call DestroyEffect(s__TayuyaQOgre_shockFx[this])
                    set s__TayuyaQOgre_shockFx[this]=null
                endif
                call DestroyGroup(s__TayuyaQOgre_shockDamaged[this])
                set s__TayuyaQOgre_shockDamaged[this]=null
                call s__TayuyaQOgre_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
                call DestroyGroup(g)
                set g=null
                return
            endif

            set ringPrevR=s__TayuyaQOgre_shockPrevR[this]
            set ringR=s__TayuyaQOgre_BASE_RADIUS + s__TayuyaQOgre_SHOCK_STEP * I2R(pulseIndex)

            if pulseIndex == 1 then
                set dmgMul=0.75
            else
                set dmgMul=0.50
            endif

            call s__TayuyaQOgre_SpawnSegmentRing(s__TayuyaQOgre_shockX[this] , s__TayuyaQOgre_shockY[this] , ringR , pulseIndex)

            set dmgBase=( ( 100.0 * I2R(GetUnitAbilityLevel(s__TayuyaQOgre_caster[this], s__TayuyaQOgre_SPELL_ID)) ) + s__TayuyaQOgre_shockDamageBonus[this] ) * dmgMul

            call GroupEnumUnitsInRange(g, s__TayuyaQOgre_shockX[this], s__TayuyaQOgre_shockY[this], ringR + s__TayuyaQOgre_SHOCK_RADIUS_BONUS, null)
            loop
                set u=FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)

                if GetWidgetLife(u) > 0.405 and IsUnitEnemy(u, GetOwningPlayer(s__TayuyaQOgre_caster[this])) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                    if not IsUnitInGroup(u, s__TayuyaQOgre_shockDamaged[this]) then
                        call GroupAddUnit(s__TayuyaQOgre_shockDamaged[this], u)
                        call SlowedUnit(s__TayuyaQOgre_caster[this] , u , 3.0)
                        call UnitDamageTarget(TayuyaCore_Tayuya, u, dmgBase, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    endif
                endif
            endloop
            call DestroyGroup(g)
            set g=null

            set s__TayuyaQOgre_shockPrevR[this]=ringR
            set s__TayuyaQOgre_shockR[this]=ringR

            if pulseIndex >= 2 then
                if s__TayuyaQOgre_shockFx[this] != null then
                    call DestroyEffect(s__TayuyaQOgre_shockFx[this])
                    set s__TayuyaQOgre_shockFx[this]=null
                endif

                call DestroyGroup(s__TayuyaQOgre_shockDamaged[this])
                set s__TayuyaQOgre_shockDamaged[this]=null

                call s__TayuyaQOgre_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
                return
            endif
        endfunction
       
