            call DestroyEffect(bj_lastCreatedEffect)
            call TimerStart(NewTimerEx(this), 2.0, false, function s__HayateSwordStrikeNew_delay)
	endif
	if s__HayateSwordStrikeNew_blink[this] then
	     call TimerStart(NewTimerEx(this), 0.2, false, function s__HayateSwordStrikeNew_teleport)
	     call ReleaseTimer(GetExpiredTimer())
	endif
    endfunction 


