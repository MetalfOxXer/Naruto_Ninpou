    function s__IchigoUnleash_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitRemoveBuffs(s__IchigoUnleash_caster[this], false, true)
        set s__IchigoUnleash_count[this]=s__IchigoUnleash_count[this] + 1
        if s__IchigoUnleash_count[this] >= 100 then
            call s__IchigoUnleash_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__IchigoUnleash_actions takes nothing returns nothing
        local integer this= s__IchigoUnleash_allocate()
        set s__IchigoUnleash_caster[this]=GetTriggerUnit()
	set s__IchigoUnleash_count[this]=0
    	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call PlaySoundOnUnitBJ(gg_snd_Ichigo_R_Active, 100.0, GetTriggerUnit())
        endif
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__IchigoUnleash_periodic , "IchigoUnleash_periodic")
    endfunction 

