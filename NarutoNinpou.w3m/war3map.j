        set s__IrukaWildAxes_startX[this2]=s__IrukaWildAxes_startX[this1]
        set s__IrukaWildAxes_startY[this1]=GetUnitY(s__IrukaWildAxes_caster[this1])
        set s__IrukaWildAxes_startY[this2]=s__IrukaWildAxes_startY[this1]
        set s__IrukaWildAxes_axe[this1]=CreateUnit(GetTriggerPlayer(), s__IrukaWildAxes_DUMMY_ID, s__IrukaWildAxes_startX[this1], s__IrukaWildAxes_startY[this1], 0.)
        set s__IrukaWildAxes_axe[this2]=CreateUnit(GetTriggerPlayer(), s__IrukaWildAxes_DUMMY_ID, s__IrukaWildAxes_startX[this1], s__IrukaWildAxes_startY[this1], 0.)
        set s__IrukaWildAxes_sfx[this1]=CreateUnit(GetTriggerPlayer(), s__IrukaWildAxes_SFX_UNIT_ID, s__IrukaWildAxes_startX[this1], s__IrukaWildAxes_startY[this1], 0.)
        set s__IrukaWildAxes_sfx[this2]=CreateUnit(GetTriggerPlayer(), s__IrukaWildAxes_SFX_UNIT_ID, s__IrukaWildAxes_startX[this1], s__IrukaWildAxes_startY[this1], 0.)
        set s__IrukaWildAxes_damaged[this1]=CreateGroup()
        set s__IrukaWildAxes_damaged[this2]=CreateGroup()
