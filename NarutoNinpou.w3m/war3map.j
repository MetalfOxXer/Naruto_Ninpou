                set s__KillerBeeThrowInk_target_y[this]=GetLocationY(l1)
                set s__KillerBeeThrowInk_current_x[this]=GetUnitX(GetTriggerUnit())
                set s__KillerBeeThrowInk_current_y[this]=GetUnitY(GetTriggerUnit())
