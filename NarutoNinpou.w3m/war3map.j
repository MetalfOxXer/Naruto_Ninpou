    function s__Bird_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
     local real x2= GetUnitX(s__Bird_bird[this])
     local real y2= GetUnitY(s__Bird_bird[this])
     local real new_x= (((x2 )*1.0) + Cos((( s__Bird_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
     local real new_y= (((y2 )*1.0) + Sin((( s__Bird_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        set s__Bird_count[this]=s__Bird_count[this] + 1
        call SetUnitX(s__Bird_bird[this], new_x)
        call SetUnitY(s__Bird_bird[this], new_y)

	if ModuloInteger(s__Bird_count[this], 5) == 0 then
            set x2=(((x2 )*1.0) + Cos((( s__Bird_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set y2=(((y2 )*1.0) + Sin((( s__Bird_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
            set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdx", x2, y2)
            call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__Bird_angle[this])
	    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
            call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
            call DestroyEffect(bj_lastCreatedEffect)
        endif

	set bj_lastCreatedEffect=AddSpecialEffect("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdl", x2, y2)
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__Bird_angle[this])
	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
        call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.3)*1.0) , false) // INLINED!!

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__Bird_bird[this]), GetUnitY(s__Bird_bird[this]), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
