    function s__HagoromoQE_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!

        call SetUnitTimeScale(s__HagoromoQE_lavaBall[this], 1.0)
        call SetUnitTimeScalePercent(s__HagoromoQE_lavaBall[this], ( s__HagoromoQE_distance[this] / 3 ) + 0.25)
        call SetUnitAnimationByIndex(s__HagoromoQE_lavaBall[this], 0)

        // Create a group and grab units in range of the lava ball's offset position
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__HagoromoQE_offset_x[this], s__HagoromoQE_offset_y[this], 200, null)

        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoQE_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set s__HagoromoQE_unitsGrabbed[s__HagoromoQE_grabSize[this]]=bj_lastCreatedUnit
                set s__HagoromoQE_grabSize[this]=s__HagoromoQE_grabSize[this] + 1
                call PauseUnit(s__HagoromoQE_unitsGrabbed[s__HagoromoQE_grabSize[this]], true)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            exitwhen bj_lastCreatedUnit == null
        endloop

        call DestroyGroup(bj_lastCreatedGroup)

        call TimerStart(NewTimerEx(this), 0.02, true, function sc__HagoromoQE_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__HagoromoQE_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HagoromoQE_lavaBall[this])
        local real y= GetUnitY(s__HagoromoQE_lavaBall[this])
        local real new_x= (((x )*1.0) + Cos((( s__HagoromoQE_angle[this] )*1.0)) * (( s__HagoromoQE_distance[this] / s__HagoromoQE_speed[this])*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__HagoromoQE_angle[this] )*1.0)) * (( s__HagoromoQE_distance[this] / s__HagoromoQE_speed[this])*1.0)) // INLINED!!
        local integer i= 0
        local boolean bool= false

        set s__HagoromoQE_count[this]=s__HagoromoQE_count[this] + 1
        
        // Move the lava ball towards the target
        call SetUnitFacing(s__HagoromoQE_lavaBall[this], Rad2Deg(s__HagoromoQE_angle[this]))
        call SetUnitX(s__HagoromoQE_lavaBall[this], new_x)
        call SetUnitY(s__HagoromoQE_lavaBall[this], new_y)

        // Check if it's time to switch the animation after 22 periods
        if s__HagoromoQE_count[this] >= 22 then
            if s__HagoromoQE_animSwitch[this] == false then
                // Switch animation and speed
                set s__HagoromoQE_animSwitch[this]=true
                set s__HagoromoQE_speed[this]=66
                call SetUnitAnimationByIndex(s__HagoromoQE_lavaBall[this], 2)

                call DestroyEffect(AddSpecialEffect("war3mapImported\\lava crack.mdl", GetUnitX(s__HagoromoQE_lavaBall[this]), GetUnitY(s__HagoromoQE_lavaBall[this])))
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__HagoromoQE_lavaBall[this]), GetUnitY(s__HagoromoQE_lavaBall[this]), 200, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoQE_caster[this])) then
                        call StunUnitTimed(s__HagoromoQE_caster[this] , bj_lastCreatedUnit , 0.5)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)

                // Move grabbed units and apply damage
                loop
                    exitwhen s__HagoromoQE_unitsGrabbed[i] == null
                    if s__HagoromoQE_unitsGrabbed[i] != null then
                        set bool=true
                        call SetUnitFacing(s__HagoromoQE_unitsGrabbed[i], Rad2Deg(s__HagoromoQE_angle[this]))
                        call SetUnitX(s__HagoromoQE_unitsGrabbed[i], new_x)
                        call SetUnitY(s__HagoromoQE_unitsGrabbed[i], new_y)
                        call UnitDamageTarget(s__HagoromoQE_caster[this], s__HagoromoQE_unitsGrabbed[i], 350 + GetHeroInt(s__HagoromoD_Hagoromo, true) * ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(s__HagoromoQE_damaged[this], s__HagoromoQE_unitsGrabbed[i])
                        if UnitAddAbility(s__HagoromoQE_unitsGrabbed[i], 'Amrf') then
                            call UnitRemoveAbility(s__HagoromoQE_unitsGrabbed[i], 'Amrf')
                        endif
                        call SetUnitFlyHeight(s__HagoromoQE_unitsGrabbed[i], 0, 0)
                        call PauseUnit(s__HagoromoQE_unitsGrabbed[i], false)
                        set s__HagoromoQE_unitsGrabbed[i]=null
                        set i=i + 1
                    endif
                endloop

                // If any units were grabbed, apply the lava slam effects and cleanup
                if bool then
                    call DestroyEffect(AddSpecialEffect("war3mapImported\\Lava Slam.mdl", GetUnitX(s__HagoromoQE_lavaBall[this]), GetUnitY(s__HagoromoQE_lavaBall[this])))
                    call DestroyEffect(AddSpecialEffect("war3mapImported\\az_tormentedsoul_t1.mdl", GetUnitX(s__HagoromoQE_lavaBall[this]), GetUnitY(s__HagoromoQE_lavaBall[this])))
                    call KillUnit(s__HagoromoQE_lavaBall[this])
                    call RemoveUnit(s__HagoromoQE_lavaBall[this])
                    set s__HagoromoQE_lavaBall[this]=null
                    call s__HagoromoQE_deallocate(this)
                    call ReleaseTimer(GetExpiredTimer())
                endif
                set s__HagoromoQE_grabSize[this]=0 // Reset grab size after completing the action
            endif

            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoQE_caster[this])) then
                    if not IsUnitInGroup(bj_lastCreatedUnit, s__HagoromoQE_damaged[this]) then
                        if GetHeroLevel(s__HagoromoD_Hagoromo) >= 35 then
                            call UnitDamageTarget(s__HagoromoQE_caster[this], bj_lastCreatedUnit, 350 + GetHeroInt(s__HagoromoD_Hagoromo, true) * ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        else
                            call UnitDamageTarget(s__HagoromoQE_caster[this], bj_lastCreatedUnit, 375 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) + ( ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) / 1.5 ) ) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                        endif
                        call GroupAddUnit(s__HagoromoQE_damaged[this], bj_lastCreatedUnit)
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)

            // Handle the movement of grabbed units during the initial phase
        elseif s__HagoromoQE_count[this] < 22 then
            call SetUnitFlyHeight(s__HagoromoQE_lavaBall[this], ParabolaZ(500 , s__HagoromoQE_distance[this] , s__HagoromoQE_distance[this] / s__HagoromoQE_speed[this] * s__HagoromoQE_count[this]), 0)
            
            // Move grabbed units along with the lava ball
            loop
                exitwhen s__HagoromoQE_unitsGrabbed[i] == null
                call SetUnitFacing(s__HagoromoQE_unitsGrabbed[i], Rad2Deg(s__HagoromoQE_angle[this]))
                if UnitAddAbility(s__HagoromoQE_unitsGrabbed[i], 'Amrf') then
                    call UnitRemoveAbility(s__HagoromoQE_unitsGrabbed[i], 'Amrf')
                endif
                call SetUnitFlyHeight(s__HagoromoQE_unitsGrabbed[i], ParabolaZ(500 , s__HagoromoQE_distance[this] , s__HagoromoQE_distance[this] / s__HagoromoQE_speed[this] * s__HagoromoQE_count[this]), 0)
                call SetUnitX(s__HagoromoQE_unitsGrabbed[i], new_x)
                call SetUnitY(s__HagoromoQE_unitsGrabbed[i], new_y)
                set i=i + 1
            endloop
        endif

        if s__HagoromoQE_count[this] >= 100 then
            call KillUnit(s__HagoromoQE_lavaBall[this])
            call s__HagoromoQE_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__HagoromoQE_actions takes nothing returns nothing
        local integer this= s__HagoromoQE_allocate()
        local real caster_x= GetUnitX(s__HagoromoD_Hagoromo)
        local real caster_y= GetUnitY(s__HagoromoD_Hagoromo)
        local real target_x= GetSpellTargetX()
        local real target_y= GetSpellTargetY()
        local real offset_x
        local real offset_y
        local integer i= 0

        // Initialize starting parameters
        set s__HagoromoQE_caster[this]=s__HagoromoD_Hagoromo
        set s__HagoromoQE_target_x[this]=target_x
        set s__HagoromoQE_target_y[this]=target_y
        set s__HagoromoQE_angle[this]=Atan2(target_y - caster_y, target_x - caster_x)
        set s__HagoromoQE_distance[this]=( GetDistance(GetUnitX(s__HagoromoQE_caster[this]) , GetUnitY(s__HagoromoQE_caster[this]) , s__HagoromoQE_target_x[this] , s__HagoromoQE_target_y[this]) ) * 2
        set offset_x=(((target_x )*1.0) + Cos((( s__HagoromoQE_angle[this] - bj_PI )*1.0)) * (( s__HagoromoQE_distance[this])*1.0)) // INLINED!!
        set offset_y=(((target_y )*1.0) + Sin((( s__HagoromoQE_angle[this] - bj_PI )*1.0)) * (( s__HagoromoQE_distance[this])*1.0)) // INLINED!!
        set s__HagoromoQE_offset_x[this]=offset_x
        set s__HagoromoQE_offset_y[this]=offset_y

        call SetUnitAnimationByIndex(s__HagoromoQE_caster[this], 42)
        // Create the lava ball at the offset position
        set s__HagoromoQE_lavaBall[this]=CreateUnit(GetOwningPlayer(s__HagoromoQE_caster[this]), 'h06B', offset_x, offset_y, Rad2Deg(s__HagoromoQE_angle[this]))
        call SetUnitAnimationByIndex(s__HagoromoQE_lavaBall[this], 3)
        call SetUnitTimeScale(s__HagoromoQE_lavaBall[this], 2.0)
        call UnitApplyTimedLife(s__HagoromoQE_lavaBall[this], 'BTLF', 5.0)

        // Initialize counters and groups
        set s__HagoromoQE_count[this]=0
        set s__HagoromoQE_speed[this]=22
        set s__HagoromoQE_animSwitch[this]=false
        set s__HagoromoQE_damaged[this]=CreateGroup()

        call TimerStart(NewTimerEx(this), 0.50, false, function s__HagoromoQE_delay)
    endfunction 

