    function s__NagatoShinraGigaTensei_unshake takes nothing returns nothing
        local integer i= 0
        set i=0
        loop
            exitwhen i > 11
            call CameraClearNoiseForPlayer(Player(i))
            set i=i + 1
        endloop
        call ReleaseTimer(GetExpiredTimer())
    endfunction  
    
    function s__NagatoShinraGigaTensei_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real new_x
        local real new_y
        local real angle
        local integer i
        local integer j
        set s__NagatoShinraGigaTensei_count[this]=s__NagatoShinraGigaTensei_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
	call SetUnitScale(s__NagatoShinraGigaTensei_dummy[this], ( 20 * s__NagatoShinraGigaTensei_count[this] ) / 100.0, 0, 0)
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NagatoShinraGigaTensei_caster[this]), GetUnitY(s__NagatoShinraGigaTensei_caster[this]), 20 * s__NagatoShinraGigaTensei_count[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NagatoShinraGigaTensei_caster[this])) then
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    set x=GetUnitX(bj_lastCreatedUnit)
                    set y=GetUnitY(bj_lastCreatedUnit)
                    set angle=Atan3(GetUnitX(s__NagatoShinraGigaTensei_caster[this]) , GetUnitY(s__NagatoShinraGigaTensei_caster[this]) , x , y)
                    set new_x=(((GetUnitX(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 20 * s__NagatoShinraGigaTensei_count[this])*1.0)) // INLINED!!
                    set new_y=(((GetUnitY(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 20 * s__NagatoShinraGigaTensei_count[this])*1.0)) // INLINED!!
                    if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(bj_lastCreatedUnit, new_x)
                        call SetUnitY(bj_lastCreatedUnit, new_y)
                    endif
                endif
                if not IsUnitInGroup(bj_lastCreatedUnit, s__NagatoShinraGigaTensei_damaged[this]) then
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == true then
                        call UnitDamageTarget(s__NagatoShinraGigaTensei_caster[this], bj_lastCreatedUnit, 20 * GetHeroInt(s__NagatoShinraGigaTensei_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    else
                        call UnitDamageTarget(s__NagatoShinraGigaTensei_caster[this], bj_lastCreatedUnit, 10 * GetHeroInt(s__NagatoShinraGigaTensei_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    endif
                    call GroupAddUnit(s__NagatoShinraGigaTensei_damaged[this], bj_lastCreatedUnit)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        if ModuloInteger(s__NagatoShinraGigaTensei_count[this], 2) == 0 then
            set i=0
            loop
                exitwhen i >= 12
                set x=(((GetUnitX(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Cos((( Deg2Rad(30 * i) )*1.0)) * (( 20 * s__NagatoShinraGigaTensei_count[this])*1.0)) // INLINED!!
                set y=(((GetUnitY(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Sin((( Deg2Rad(30 * i) )*1.0)) * (( 20 * s__NagatoShinraGigaTensei_count[this])*1.0)) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("war3mapImported\\slam.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                set i=i + 1
            endloop
        endif
   if ( RectContainsUnit(gg_rct_Base_Konohagakure, s__NagatoShinraGigaTensei_caster[this]) or RectContainsUnit(gg_rct_Base_Otogakure, s__NagatoShinraGigaTensei_caster[this]) or RectContainsUnit(gg_rct_Base_Akatsuki, s__NagatoShinraGigaTensei_caster[this]) ) then
        if s__NagatoShinraGigaTensei_count[this] > 40 then
            set i=1
            loop
                exitwhen i > 3
                set x=(((GetUnitX(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Cos((( Deg2Rad(120 * i) )*1.0)) * (( 300)*1.0)) // INLINED!!
                set y=(((GetUnitY(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Sin((( Deg2Rad(120 * i) )*1.0)) * (( 300)*1.0)) // INLINED!!
                //set bj_lastCreatedUnit = GetUnit(GetOwningPlayer(this.caster), 'nrac', x, y, 270)
                //call SetUnitTimeScale(bj_lastCreatedUnit, 0.5)
                //call KillUnit(bj_lastCreatedUnit) 
                //call SetUnitTimeScale(bj_lastCreatedUnit, 0.1)
                set j=1
                loop
                    exitwhen j > 6
                    set x=(((GetUnitX(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Cos((( Deg2Rad(j * 60) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                    set y=(((GetUnitY(s__NagatoShinraGigaTensei_caster[this]) )*1.0) + Sin((( Deg2Rad(j * 60) )*1.0)) * (( 100 * i)*1.0)) // INLINED!!
                    //call AddSpecialEffectEx("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", x, y)
                    set j=j + 1
                endloop
