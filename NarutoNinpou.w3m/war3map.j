     function s__ToneriQ_delay3 takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
         local integer i
        	set i=0
        	loop
            		exitwhen i > 7
            		call KillUnit(s__s__ToneriQ_truthballs[i])
            		call ShowUnit(s__s__ToneriQ_truthballs[i], false)
            		set s__s__ToneriQ_truthballs[i]= null
            		set i=i + 1
           	endloop
           	call s__ToneriQ_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction

   function s__ToneriQ_moveMissile takes nothing returns nothing
 local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real x= GetUnitX(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]])
 local real y= GetUnitY(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]])
 local real angle= Atan3(x , y , s__ToneriQ_target_x[this] , s__ToneriQ_target_y[this])
 local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
 local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
 local real height
	set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
	set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 50)*1.0)) // INLINED!!
	if s__ToneriQ_count1[this] >= s__ToneriQ_max_count_2[this] then
		set height=s__ToneriQ_original_height[this] - ( s__ToneriQ_count1[this] - s__ToneriQ_max_count_2[this] ) * 50
	else
		set height=s__ToneriQ_original_height[this] + ParabolaZ(300 , s__ToneriQ_max_count_2[this] , s__ToneriQ_max_count_2[this] - s__ToneriQ_count1[this])
	endif
	call SetUnitX(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]], new_x)
	call SetUnitY(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]], new_y)
	call SetUnitFlyHeight(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]], height, 0)
	set s__ToneriQ_count1[this]=s__ToneriQ_count1[this] + 1
	if s__ToneriQ_count1[this] >= s__ToneriQ_max_count[this] then
		call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ToneriQ_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				call UnitDamageTarget(s__ToneriQ_caster[this], bj_lastCreatedUnit, 12 * GetUnitAbilityLevel(s__ToneriQ_caster[this], s__ToneriQ_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
		if s__ToneriQ_count[this] < 7 then
			set s__ToneriQ_count[this]=s__ToneriQ_count[this] + 1
			set s__ToneriQ_count1[this]=0
			call TimerStart(NewTimerEx(this), 0.01, false, function sc__ToneriQ_delay)
			call ReleaseTimer(GetExpiredTimer())
		else
			call TimerStart(NewTimerEx(this), 0.5, false, function s__ToneriQ_delay3)
			call ReleaseTimer(GetExpiredTimer())
		endif
	endif
   endfunction 


 function s__ToneriQ_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set s__ToneriQ_original_height[this]=GetUnitFlyHeight(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]])
		set s__ToneriQ_max_count_2[this]=R2I(GetDistance(GetUnitX(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]]) , GetUnitY(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]]) , s__ToneriQ_target_x[this] , s__ToneriQ_target_y[this]) / 50)
		set s__ToneriQ_max_count[this]=R2I(GetDistance(GetUnitX(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]]) , GetUnitY(s__s__ToneriQ_truthballs[s__ToneriQ_count[this]]) , s__ToneriQ_target_x[this] , s__ToneriQ_target_y[this]) / 50 + s__ToneriQ_original_height[this] / 50)
        	call TimerStart(NewTimerEx(this), 0.01, true, function s__ToneriQ_moveMissile)
		call ReleaseTimer(GetExpiredTimer())
 endfunction

 function s__ToneriQ_actionstwo takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer i
		set s__ToneriQ_count[this]=0
