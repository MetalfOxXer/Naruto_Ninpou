    function s__NagatoSixPaths_actions takes nothing returns nothing
        local integer this
        if GetSpellAbilityId() == s__NagatoSixPaths_DEVA_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=0 // INLINED!!
        elseif GetSpellAbilityId() == s__NagatoSixPaths_ASURA_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=1 // INLINED!!
        elseif GetSpellAbilityId() == s__NagatoSixPaths_ANIMAL_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=2 // INLINED!!
        elseif GetSpellAbilityId() == s__NagatoSixPaths_HUMAN_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=3 // INLINED!!
        elseif GetSpellAbilityId() == s__NagatoSixPaths_PRETA_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=4 // INLINED!!
        elseif GetSpellAbilityId() == s__NagatoSixPaths_NARAKA_PATH_SPELL_ID then
            set udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))]=5 // INLINED!!
        endif
        set this=s__NagatoSixPaths_allocate()
        set s__NagatoSixPaths_caster[this]=GetTriggerUnit()
        call TimerStart(NewTimerEx(this), 0.1, false, function s__NagatoSixPaths_delay1)
    endfunction
    
    function s__NagatoSixPaths_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_DEVA_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_ASURA_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_ANIMAL_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_HUMAN_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_PRETA_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
        call RegisterSpellEffectEventForId(10 , s__NagatoSixPaths_NARAKA_PATH_SPELL_ID , function s__NagatoSixPaths_actions)
    endfunction
    
