		call SetPlayerAbilityAvailable(GetOwningPlayer(udg_units31[636]), 'A0WA', true)
		call SetPlayerAbilityAvailable(GetOwningPlayer(udg_units31[636]), 'A0BH', true)
		call SetPlayerAbilityAvailable(GetOwningPlayer(udg_units31[636]), 'A05K', true)
		call SetPlayerAbilityAvailable(GetOwningPlayer(udg_units31[636]), 'A03G', true)
