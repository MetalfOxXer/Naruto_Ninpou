				set s__JuugoJumpR_target_y[this]=(s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__JuugoJumpR_caster[this])))]) // INLINED!!
				set s__JuugoJumpR_target_x[this]=(s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__JuugoJumpR_caster[this])))]) // INLINED!!
				set s__JuugoJumpR_dist[this]=GetDistance(GetUnitX(s__JuugoJumpR_caster[this]) , GetUnitY(s__JuugoJumpR_caster[this]) , s__JuugoJumpR_target_x[this] , s__JuugoJumpR_target_y[this])
				if s__JuugoJumpR_dist[this] > 800 then
					set angle=Atan3(s__JuugoJumpR_caster_x[this] , s__JuugoJumpR_caster_y[this] , s__JuugoJumpR_target_x[this] , s__JuugoJumpR_target_y[this])
					set s__JuugoJumpR_target_x[this]=(((s__JuugoJumpR_caster_x[this] )*1.0) + Cos((( angle )*1.0)) * (( 900)*1.0)) // INLINED!!
					set s__JuugoJumpR_target_y[this]=(((s__JuugoJumpR_caster_y[this] )*1.0) + Sin((( angle )*1.0)) * (( 900)*1.0)) // INLINED!!
					set s__JuugoJumpR_dist[this]=GetDistance(GetUnitX(s__JuugoJumpR_caster[this]) , GetUnitY(s__JuugoJumpR_caster[this]) , s__JuugoJumpR_target_x[this] , s__JuugoJumpR_target_y[this])
				endif
				call SetUnitFlyHeight(s__JuugoJumpR_caster[this], 0.0, 600)
			endif
			if s__JuugoJumpR_count[this] > 30 then
				set angle=Atan3(s__JuugoJumpR_caster_x[this] , s__JuugoJumpR_caster_y[this] , s__JuugoJumpR_target_x[this] , s__JuugoJumpR_target_y[this])
				set new_x=(((s__JuugoJumpR_caster_x[this] )*1.0) + Cos((( angle )*1.0)) * (( s__JuugoJumpR_dist[this] / 16.0 * ( s__JuugoJumpR_count[this] - 30 ))*1.0)) // INLINED!!
				set new_y=(((s__JuugoJumpR_caster_y[this] )*1.0) + Sin((( angle )*1.0)) * (( s__JuugoJumpR_dist[this] / 16.0 * ( s__JuugoJumpR_count[this] - 30 ))*1.0)) // INLINED!!
				call SetUnitX(s__JuugoJumpR_caster[this], new_x)
				call SetUnitY(s__JuugoJumpR_caster[this], new_y)
			endif
			if ( GetDistance(GetUnitX(s__JuugoJumpR_caster[this]) , GetUnitY(s__JuugoJumpR_caster[this]) , s__JuugoJumpR_target_x[this] , s__JuugoJumpR_target_y[this]) < 80 and s__JuugoJumpR_count[this] > 30 ) or s__JuugoJumpR_count[this] > 83 then
				set bj_lastCreatedEffect=AddSpecialEffect("DustWithWave.mdx", GetUnitX(s__JuugoJumpR_caster[this]), GetUnitY(s__JuugoJumpR_caster[this]))
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3)
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 1.5)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 1)*1.0) , false) // INLINED!!
			if IsUnitVisible(s__JuugoJumpR_caster[this], GetLocalPlayer()) then
