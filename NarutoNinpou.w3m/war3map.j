            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KankuroSalamander_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__KankuroSalamander_damaged[this]) then
