 function s__JuugoCharge_items takes nothing returns nothing
    	if GetUnitTypeId(GetTriggerUnit()) == 'E034' and s__JuugoCharge_charge2 == true then
        	call IssueImmediateOrder(GetTriggerUnit(), "stop")
    	endif
 endfunction
	
 function s__JuugoCharge_damagefix takes nothing returns boolean
        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__JuugoCharge_caster[s__JuugoCharge_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true then
            call UnitDamageTarget(s__JuugoCharge_caster[s__JuugoCharge_instance], GetFilterUnit(), GetHeroStr(s__JuugoCharge_caster[s__JuugoCharge_instance], true) * ( 6 + s__JuugoCharge_range[s__JuugoCharge_instance] / 1000 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
			call GroupAddUnit(s__JuugoCharge_damaged[s__JuugoCharge_instance], GetFilterUnit())
            set s__JuugoCharge_target[s__JuugoCharge_instance]=GetFilterUnit()
        endif
	return false
 endfunction
	
    function s__JuugoCharge_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x
  local real y
  local real target_x
  local real target_y
  local real new_target_x= (((GetUnitX(s__JuugoCharge_target[this]) )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
  local real new_target_y= (((GetUnitY(s__JuugoCharge_target[this]) )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
        local real new_x= (((GetUnitX(s__JuugoCharge_target[this]) )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
        local real new_y= (((GetUnitY(s__JuugoCharge_target[this]) )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__JuugoCharge_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
				if not IsUnitInGroup(bj_lastCreatedUnit, s__JuugoCharge_moving[this]) then
					call PauseUnit(bj_lastCreatedUnit, true)
					call GroupAddUnit(s__JuugoCharge_moving[this], bj_lastCreatedUnit)
				endif
				if not IsUnitInGroup(bj_lastCreatedUnit, s__JuugoCharge_damaged[this]) then
					set s__JuugoCharge_damage[this]=0.75 * s__JuugoCharge_damage[this]
					call UnitDamageTarget(s__JuugoCharge_caster[this], bj_lastCreatedUnit, s__JuugoCharge_damage[this], true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					call GroupAddUnit(s__JuugoCharge_damaged[this], bj_lastCreatedUnit)
				endif
                set target_x=GetUnitX(bj_lastCreatedUnit)
                set target_y=GetUnitY(bj_lastCreatedUnit)
                set new_target_x=(((target_x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
                set new_target_y=(((target_y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( RMaxBJ(35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this], 25) / 3)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_target_x, new_target_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitX(bj_lastCreatedUnit, new_target_x)
                    call SetUnitY(bj_lastCreatedUnit, new_target_y)
                endif
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
		
        if ( ( RMaxBJ(( 35 + s__JuugoCharge_count[this] + 35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this] ), 50) / 3 * s__JuugoCharge_count3[this] / 2 ) >= 0.33 * ( 35 + 35 + s__JuugoCharge_count[this] ) * s__JuugoCharge_count[this] / 2 and ( RMaxBJ(( 35 + s__JuugoCharge_count[this] + 35 + s__JuugoCharge_count[this] - s__JuugoCharge_count3[this] ), 50) / 3 * s__JuugoCharge_count3[this] / 2 ) >= 0.20 * s__JuugoCharge_range[this] ) or IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
				call SetUnitAnimationByIndex(s__JuugoCharge_caster[this], 3)
			//if IsUnitVisible(this.caster, GetLocalPlayer()) then	
				//call PlaySoundOnUnitBJ(gg_snd_Juugo_Smash, 130, this.caster)
			//endif
	        loop
            	set bj_lastCreatedUnit=FirstOfGroup(s__JuugoCharge_moving[this])
            	exitwhen bj_lastCreatedUnit == null
				if IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
					call UnitDamageTarget(s__JuugoCharge_caster[this], bj_lastCreatedUnit, RMaxBJ(500, s__JuugoCharge_range[this] / 4), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					call StunUnitTimed(s__JuugoCharge_caster[this] , bj_lastCreatedUnit , RMaxBJ(0.5, s__JuugoCharge_range[this] / 2500))
				endif
            	call PauseUnit(bj_lastCreatedUnit, false)
            	call GroupRemoveUnit(s__JuugoCharge_moving[this], bj_lastCreatedUnit)
            endloop
            call SetUnitAnimation(s__JuugoCharge_caster[this], "spell slam three")
	        call PauseUnit(s__JuugoCharge_caster[this], false)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(s__JuugoCharge_target[this]) )*1.0), (( GetUnitY(s__JuugoCharge_target[this]))*1.0))) // INLINED!!
            call DestroyGroup(s__JuugoCharge_damaged[this])
			call DestroyGroup(s__JuugoCharge_moving[this])
            set s__JuugoCharge_damaged[this]=null
			set s__JuugoCharge_moving[this]=null
            call s__JuugoCharge_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
			return
        endif
		set s__JuugoCharge_count3[this]=s__JuugoCharge_count3[this] + 1
		if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			call SetUnitX(s__JuugoCharge_target[this], new_x)
			call SetUnitY(s__JuugoCharge_target[this], new_y)
			call SetUnitX(s__JuugoCharge_caster[this], new_x)
			call SetUnitY(s__JuugoCharge_caster[this], new_y)
		endif
		//make sure it doesnt bug
		if s__JuugoCharge_count3[this] >= 700 then
			loop
            	set bj_lastCreatedUnit=FirstOfGroup(s__JuugoCharge_moving[this])
            	exitwhen bj_lastCreatedUnit == null
				if IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
					call UnitDamageTarget(s__JuugoCharge_caster[this], bj_lastCreatedUnit, RMaxBJ(500, s__JuugoCharge_range[this] / 4), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					call StunUnitTimed(s__JuugoCharge_caster[this] , bj_lastCreatedUnit , RMaxBJ(0.5, s__JuugoCharge_range[this] / 2500))
				endif
            	call PauseUnit(bj_lastCreatedUnit, false)
            	call GroupRemoveUnit(s__JuugoCharge_moving[this], bj_lastCreatedUnit)
            endloop
            call SetUnitAnimation(s__JuugoCharge_caster[this], "spell slam three")
	        call PauseUnit(s__JuugoCharge_caster[this], false)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( GetUnitX(s__JuugoCharge_target[this]) )*1.0), (( GetUnitY(s__JuugoCharge_target[this]))*1.0))) // INLINED!!
            call DestroyGroup(s__JuugoCharge_damaged[this])
			call DestroyGroup(s__JuugoCharge_moving[this])
            set s__JuugoCharge_damaged[this]=null
			set s__JuugoCharge_moving[this]=null
            call s__JuugoCharge_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
			return
		endif
    endfunction 

    function s__JuugoCharge_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__JuugoCharge_caster[this])
        local real y= GetUnitY(s__JuugoCharge_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 35 + s__JuugoCharge_count[this])*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 35 + s__JuugoCharge_count[this])*1.0)) // INLINED!!
        local real x2
        local real y2
		
		//Checking for black areas
		if IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
			if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 100)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 100)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
				if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 200)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 200)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
					if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 300)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 300)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
						if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 400)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 400)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
							if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 500)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 500)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
								if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 600)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 600)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
									if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 700)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 700)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
										if IsTerrainPathable((((x )*1.0) + Cos((( s__JuugoCharge_angle[this] )*1.0)) * (( 800)*1.0)), (((y )*1.0) + Sin((( s__JuugoCharge_angle[this] )*1.0)) * (( 800)*1.0)), PATHING_TYPE_WALKABILITY) then // INLINED!!
											set new_x=x
											set new_y=y
										endif
									endif
								endif
							endif
						endif
					endif
				endif
			endif
		endif
		
		call SetUnitTimeScale(s__JuugoCharge_caster[this], 1.0)
        call SetUnitAnimationByIndex(s__JuugoCharge_caster[this], 7)
        call SetUnitX(s__JuugoCharge_caster[this], new_x)
        call SetUnitY(s__JuugoCharge_caster[this], new_y)
        call SetUnitFacing(s__JuugoCharge_caster[this], Rad2Deg(s__JuugoCharge_angle[this]))
		//Circular wind Effect
		if ModuloInteger(s__JuugoCharge_count[this], 5) == 0 then
			set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_Wind.md", new_x, new_y)
			call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__JuugoCharge_angle[this])
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(s__JuugoCharge_caster[this]) , GetUnitY(s__JuugoCharge_caster[this])))
			call DestroyEffect(bj_lastCreatedEffect)
        endif
		
        set s__JuugoCharge_count[this]=s__JuugoCharge_count[this] + 1
		
		//On impact with the first hero
        set bj_lastCreatedGroup=CreateGroup()
		set s__JuugoCharge_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300, Filter(function s__JuugoCharge_damagefix))
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
		call DestroyGroup(bj_lastCreatedGroup)
		//Starts the dash once connects with the first hero
		if s__JuugoCharge_target[this] != null then
			if IsUnitVisible(s__JuugoCharge_caster[this], GetLocalPlayer()) then
				call PlaySoundOnUnitBJ(gg_snd_Juugo_T2, 130, s__JuugoCharge_caster[this])
			endif
			call TimerStart(NewTimerEx(this), 0.01, true, function s__JuugoCharge_knockback)
			call ReleaseTimer(GetExpiredTimer())
            call DestroyGroup(bj_lastCreatedGroup)
            return
		endif
		//In case it misses
        if ( 35 + 35 + s__JuugoCharge_count[this] ) * s__JuugoCharge_count[this] / 2 >= s__JuugoCharge_range[this] then
			call PauseUnit(s__JuugoCharge_caster[this], false)
            call s__JuugoCharge_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    
    function s__JuugoCharge_charge takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real angle2
		set angle2=Atan3(GetUnitX(s__JuugoCharge_caster[this]) , GetUnitY(s__JuugoCharge_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__JuugoCharge_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__JuugoCharge_caster[this])))])) // INLINED!!
		call SetUnitFacing(s__JuugoCharge_caster[this], Rad2Deg(angle2))
		if GetWidgetLife(s__JuugoCharge_caster[this]) > 0.405 then
			call SetUnitAnimationByIndex(s__JuugoCharge_caster[this], 10)
			if IsUnitVisible(s__JuugoCharge_caster[this], GetLocalPlayer()) and s__JuugoCharge_count2[this] == 16 then
				call PlaySoundOnUnitBJ(gg_snd_Juugo_T_Charge, 100, s__JuugoCharge_caster[this])
			endif
			
			//Blue charging effects
			if s__JuugoCharge_count2[this] == 0 then
				set s__JuugoCharge_wave1[this]=AddSpecialEffect("DustWaveDash2.mdx", (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 100)*1.0)), (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 100)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave1[this], angle2)
				call BlzSetSpecialEffectColor(s__JuugoCharge_wave1[this], 0, 255, 255)
				if GetUnitLifePercent(s__JuugoCharge_caster[this]) < 50 then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave1[this], 0.15)
				else
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave1[this], 0.075)
				endif
				call BlzSetSpecialEffectScale(s__JuugoCharge_wave1[this], 1.6)
			endif
			
			if s__JuugoCharge_count2[this] == 43 then
				set s__JuugoCharge_wave2[this]=AddSpecialEffect("DustWaveDash2.mdx", (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 150)*1.0)), (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 150)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave2[this], angle2)
				call BlzSetSpecialEffectColor(s__JuugoCharge_wave2[this], 51, 255, 255)
				if GetUnitLifePercent(s__JuugoCharge_caster[this]) < 50 then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave2[this], 0.2)
				else
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave2[this], 0.1)
				endif
				call BlzSetSpecialEffectScale(s__JuugoCharge_wave2[this], 1.4)
			endif
			
			if s__JuugoCharge_count2[this] == 86 then
				set s__JuugoCharge_wave3[this]=AddSpecialEffect("DustWaveDash2.mdx", (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 250)*1.0)), (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 250)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave3[this], angle2)
				call BlzSetSpecialEffectColor(s__JuugoCharge_wave3[this], 102, 255, 255)
				if GetUnitLifePercent(s__JuugoCharge_caster[this]) < 50 then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave3[this], 0.4)
				else
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave3[this], 0.2)
				endif
				call BlzSetSpecialEffectScale(s__JuugoCharge_wave3[this], 1.2)
			endif
			
			if s__JuugoCharge_count2[this] == 129 then
				set s__JuugoCharge_wave4[this]=AddSpecialEffect("DustWaveDash2.mdx", (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 350)*1.0)), (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 350)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave4[this], angle2)
				call BlzSetSpecialEffectColor(s__JuugoCharge_wave4[this], 153, 255, 255)
				if GetUnitLifePercent(s__JuugoCharge_caster[this]) < 50 then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave4[this], 0.8)
				else
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave4[this], 0.4)
				endif
				call BlzSetSpecialEffectScale(s__JuugoCharge_wave4[this], 1.0)
			endif
			//Ajusting the effects to match the character
			if s__JuugoCharge_wave1[this] != null then
				call BlzSetSpecialEffectX(s__JuugoCharge_wave1[this], (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 100)*1.0))) // INLINED!!
				call BlzSetSpecialEffectY(s__JuugoCharge_wave1[this], (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 100)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave1[this], angle2)
			endif
			if s__JuugoCharge_wave2[this] != null then
				call BlzSetSpecialEffectX(s__JuugoCharge_wave2[this], (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 150)*1.0))) // INLINED!!
				call BlzSetSpecialEffectY(s__JuugoCharge_wave2[this], (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 150)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave2[this], angle2)
			endif
			if s__JuugoCharge_wave3[this] != null then
				call BlzSetSpecialEffectX(s__JuugoCharge_wave3[this], (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 250)*1.0))) // INLINED!!
				call BlzSetSpecialEffectY(s__JuugoCharge_wave3[this], (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 250)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave3[this], angle2)
			endif
			if s__JuugoCharge_wave3[this] != null then
				call BlzSetSpecialEffectX(s__JuugoCharge_wave4[this], (((GetUnitX(s__JuugoCharge_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( - 350)*1.0))) // INLINED!!
				call BlzSetSpecialEffectY(s__JuugoCharge_wave4[this], (((GetUnitY(s__JuugoCharge_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( - 350)*1.0))) // INLINED!!
				call BlzSetSpecialEffectYaw(s__JuugoCharge_wave4[this], angle2)
			endif
			if GetUnitLifePercent(s__JuugoCharge_caster[this]) < 50 then
				set s__JuugoCharge_count2[this]=s__JuugoCharge_count2[this] + 2
			else
				set s__JuugoCharge_count2[this]=s__JuugoCharge_count2[this] + 1
			endif
			
			//Max charging or Charging cancelled(Max charging happens when count2 is 132)
			if s__JuugoCharge_count2[this] > 180 or s__JuugoCharge_move == 1 then
			call SetUnitPropWindow(s__JuugoCharge_caster[this], s__JuugoCharge_window[this])
				if s__JuugoCharge_wave1[this] != null then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave1[this], 5)
					call DestroyEffect(s__JuugoCharge_wave1[this])
					set s__JuugoCharge_wave1[this]=null
				endif
				if s__JuugoCharge_wave2[this] != null then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave2[this], 5)
					call DestroyEffect(s__JuugoCharge_wave2[this])
					set s__JuugoCharge_wave2[this]=null
				endif
				if s__JuugoCharge_wave3[this] != null then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave3[this], 5)
					call DestroyEffect(s__JuugoCharge_wave3[this])
					set s__JuugoCharge_wave3[this]=null
				endif
				if s__JuugoCharge_wave4[this] != null then
					call BlzSetSpecialEffectTimeScale(s__JuugoCharge_wave4[this], 5)
					call DestroyEffect(s__JuugoCharge_wave4[this])
