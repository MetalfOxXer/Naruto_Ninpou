                set this=s__ObitoFlame_Alloc___instanceCount
            else
                set this=s__ObitoFlame_Alloc___recycle[(0)]
                set s__ObitoFlame_Alloc___recycle[(0)]=s__ObitoFlame_Alloc___recycle[s__ObitoFlame_Alloc___recycle[(0)]]
