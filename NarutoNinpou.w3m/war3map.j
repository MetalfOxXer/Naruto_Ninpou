			call SetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE, GetUnitState(GetTriggerUnit(), UNIT_STATE_LIFE) + GetUnitState(GetTriggerUnit(), UNIT_STATE_MAX_LIFE) * s__s__NarutoNewD_accumulated[(GetUnitUserData((GetSpellTargetUnit())))] / 150) // INLINED!!
