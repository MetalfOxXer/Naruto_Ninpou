            if GetUnitTypeId(s__HidanTakeBlood_caster[this]) == 'U004' then
                call SetUnitAnimationByIndex(bj_lastCreatedUnit, GetRandomInt(3, 4))
            else
                call SetUnitAnimationByIndex(bj_lastCreatedUnit, GetRandomInt(10, 11))
            endif
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.3)
        endif
        set s__HidanTakeBlood_count[this]=s__HidanTakeBlood_count[this] + 1
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_crow_x )*1.0), (( new_crow_y)*1.0))) // INLINED!!
        if not IsTerrainPathable(new_crow_x, new_crow_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__HidanTakeBlood_caster[this], new_crow_x)
            call SetUnitY(s__HidanTakeBlood_caster[this], new_crow_y)
            call SetUnitFacing(s__HidanTakeBlood_caster[this], Rad2Deg(angle))
        else
            set s__HidanTakeBlood_count[this]=21
        endif
        if not IsTerrainPathable(new_target_x, new_target_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__HidanTakeBlood_target[this], new_target_x)
            call SetUnitY(s__HidanTakeBlood_target[this], new_target_y)
            call SetUnitFacing(s__HidanTakeBlood_target[this], Rad2Deg(angle) + 180)
        else
            set s__HidanTakeBlood_count[this]=21
        endif
        if s__HidanTakeBlood_count[this] > 20 then
            set s__HidanTakeBlood_BloodTimer=15
            set s__HidanTakeBlood_BloodTarget=s__HidanTakeBlood_target[this]
            call SetUnitTimeScale(s__HidanTakeBlood_caster[this], 1.0)
            call PauseUnit(s__HidanTakeBlood_caster[this], false)
            call PauseUnit(s__HidanTakeBlood_target[this], false)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" ), (( new_target_x )*1.0), (( new_target_y)*1.0))) // INLINED!!
            call PauseUnit(s__HidanTakeBlood_target[this], false)
            call StunUnitTimed(s__HidanTakeBlood_caster[this] , s__HidanTakeBlood_target[this] , 2.0)
            call SetUnitAnimation(s__HidanTakeBlood_target[this], "death")
            call UnitDamageTarget(s__HidanTakeBlood_caster[this], s__HidanTakeBlood_target[this], GetUnitAbilityLevel(s__HidanTakeBlood_caster[this], s__HidanTakeBlood_SPELL_ID) * GetHeroStr(s__HidanTakeBlood_caster[this], true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
            call CreateTextTagUnitBJ("Got blood for 15 seconds", s__HidanTakeBlood_caster[this], 0, 10.00, 100, 100.00, 100.00, 0)
            call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
            call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 3.00)
