			if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__MadaraTengaiShinsei_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
				call UnitDamageTarget(s__MadaraTengaiShinsei_caster[this], bj_lastCreatedUnit, 3.0 * GetHeroInt(s__MadaraTengaiShinsei_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
