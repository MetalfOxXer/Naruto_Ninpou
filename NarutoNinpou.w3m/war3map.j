    function s__KonoRasengan_move takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer i
        local real x= GetUnitX(s__KonoRasengan_target[this])
        local real y= GetUnitY(s__KonoRasengan_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__KonoRasengan_angle[this] )*1.0)) * (( 42)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KonoRasengan_angle[this] )*1.0)) * (( 42)*1.0)) // INLINED!!
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__KonoRasengan_target[this], new_x)
            call SetUnitY(s__KonoRasengan_target[this], new_y)
        endif
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!

        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 120, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KonoRasengan_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__KonoRasengan_damaged[this]) then
                call UnitDamageTarget(s__KonoRasengan_caster[this], bj_lastCreatedUnit, ( GetHeroStr(s__KonoRasengan_caster[this], true) ) * GetUnitAbilityLevel(s__KonoRasengan_caster[this], s__KonoRasengan_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                call StunUnitTimed(s__KonoRasengan_caster[this] , bj_lastCreatedUnit , 1.5)
                call GroupAddUnit(s__KonoRasengan_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        set s__KonoRasengan_count[this]=s__KonoRasengan_count[this] + 1
        if s__KonoRasengan_count[this] >= 5 then
            set i=0
            loop
                exitwhen i > 8
                set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(s__KonoRasengan_target[this]), GetUnitY(s__KonoRasengan_target[this]))
                call DestroyEffect(bj_lastCreatedEffect)
                set x=GetUnitX(s__KonoRasengan_target[this])
                set y=GetUnitY(s__KonoRasengan_target[this])
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 250))*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 250))*1.0)) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl", new_x, new_y)
                call DestroyEffect(bj_lastCreatedEffect)
                set i=i + 1
            endloop
            call PauseUnit(s__KonoRasengan_target[this], false)
            call DestroyGroup(s__KonoRasengan_damaged[this])
            set s__KonoRasengan_damaged[this]=null
            call s__KonoRasengan_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction

    function s__KonoRasengan_rasengan takes nothing returns nothing
        local integer this
        if s__KonoRasengan_rasengan2 and GetUnitTypeId(GetAttacker()) == 'H093' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false and not IsUnitIllusion(GetAttacker()) then
                set this=s__KonoRasengan_allocate()
                set s__KonoRasengan_rasengan2=false
                set s__KonoRasengan_caster[this]=GetAttacker()
                set s__KonoRasengan_target[this]=GetTriggerUnit()
                set s__KonoRasengan_count[this]=0
                set s__KonoRasengan_damaged[this]=CreateGroup()
                set s__KonoRasengan_angle[this]=Atan3(GetUnitX(s__KonoRasengan_caster[this]) , GetUnitY(s__KonoRasengan_caster[this]) , GetUnitX(s__KonoRasengan_target[this]) , GetUnitY(s__KonoRasengan_target[this]))
                set bj_lastCreatedEffect=AddSpecialEffect("s_FreezingRing.mdl", GetUnitX(s__KonoRasengan_caster[this]), GetUnitY(s__KonoRasengan_caster[this]))
                call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
                call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__KonoRasengan_caster[this]) + 180))
                call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 60 + GetPointZ(GetUnitX(s__KonoRasengan_caster[this]) , GetUnitY(s__KonoRasengan_caster[this])))
                call DestroyEffect(bj_lastCreatedEffect)
                call PauseUnit(s__KonoRasengan_target[this], true)
                call UnitRemoveAbility(GetAttacker(), 'B00U')
                call TimerStart(NewTimerEx(this), 0.03, true, function s__KonoRasengan_move)
        endif
    endfunction

        function s__KonoRasengan_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            set s__KonoRasengan_count[this]=s__KonoRasengan_count[this] + 1
            if s__KonoRasengan_count[this] > 99 or not s__KonoRasengan_rasengan2 then
                call DestroyEffect(s__KonoRasengan_rasengan3[this])
                set s__KonoRasengan_rasengan3[this]=null
                set s__KonoRasengan_rasengan2=false
                call s__KonoRasengan_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction

        function s__KonoRasengan_actions takes nothing returns nothing
            local integer this= s__KonoRasengan_allocate()
            set s__KonoRasengan_caster[this]=GetTriggerUnit()
            set s__KonoRasengan_count[this]=0
            set s__KonoRasengan_rasengan2=true
            set s__KonoRasengan_rasengan3[this]=AddSpecialEffectTarget("war3mapImported\\lxw jhxcom_2000.mdx", s__KonoRasengan_caster[this], "right hand")
            call TimerStartEx(NewTimerEx(this) , 0.06 , true , function s__KonoRasengan_periodic , "KonoRasengan_periodic")
        endfunction 

