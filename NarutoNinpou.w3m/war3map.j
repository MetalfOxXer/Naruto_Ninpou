            local timer initTimer
            local trigger t1
            local trigger t2
            local trigger t3

            set initTimer=CreateTimer()
            call TimerStart(initTimer, 5.00, false, function s__HiruzenD_initTriggersMethod)

            // Spawn Hiruzen
            set t1=CreateTrigger()
            call TriggerRegisterEnterRectSimple(t1, GetPlayableMapRect())
            call TriggerAddCondition(t1, Condition(function s__HiruzenD_conditionsSpawn))
            call TriggerAddAction(t1, function s__HiruzenD_actionsSpawn)

