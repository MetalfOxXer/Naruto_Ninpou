    function s__ToneriT_explode takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local integer i= 0
 local real x
 local real y
	loop
		exitwhen i > 7
		set x=(((s__ToneriT_firstx[this] )*1.0) + Cos((( s__ToneriT_angle[this] )*1.0)) * (( 150 * i)*1.0)) // INLINED!!
