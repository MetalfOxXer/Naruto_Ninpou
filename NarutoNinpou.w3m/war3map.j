//textmacro instance: UltimateChoice("NarutoSemi", "A14V", "A088", "RASENSHURIKEN", "Yoton: Rasenshuriken", "A14W", "GUDOUDAMA", "Serial Gudoudama")

//Implemented from module Alloc:
    
