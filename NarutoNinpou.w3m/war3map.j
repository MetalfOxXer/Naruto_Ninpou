        function s__GengetsuMirage_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__GengetsuMirage_Alloc___recycle[(0)] == 0 ) then
                set s__GengetsuMirage_Alloc___instanceCount=s__GengetsuMirage_Alloc___instanceCount + 1
                set this=s__GengetsuMirage_Alloc___instanceCount
            else
                set this=s__GengetsuMirage_Alloc___recycle[(0)]
                set s__GengetsuMirage_Alloc___recycle[(0)]=s__GengetsuMirage_Alloc___recycle[s__GengetsuMirage_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__GengetsuMirage_deallocate takes integer this returns nothing
            set s__GengetsuMirage_Alloc___recycle[this]=s__GengetsuMirage_Alloc___recycle[(0)]
            set s__GengetsuMirage_Alloc___recycle[(0)]=this
        endfunction

        function s__GengetsuMirage_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
   local integer i
   local real randomAngle
            local real randomOffset
   local real x= GetUnitX(s__GengetsuMirage_caster[this])
   local real y= GetUnitY(s__GengetsuMirage_caster[this])
   local real new_x= (((x )*1.0) + Cos((( s__GengetsuMirage_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
   local real new_y= (((y )*1.0) + Sin((( s__GengetsuMirage_angle[this] )*1.0)) * (( 40)*1.0)) // INLINED!!
   local real distance= GetDistance(new_x , new_y , s__GengetsuMirage_target_x[this] , s__GengetsuMirage_target_y[this])
			call SetUnitX(s__GengetsuMirage_caster[this], new_x)
			call SetUnitY(s__GengetsuMirage_caster[this], new_y)
            if distance <= 50 then

				set i=1
				loop
					exitwhen i > 6
					set randomAngle=60 * i
					set randomOffset=175
					set new_x=s__GengetsuMirage_target_x[this] + Cos(randomAngle * bj_DEGTORAD) * randomOffset
					set new_y=s__GengetsuMirage_target_y[this] + Sin(randomAngle * bj_DEGTORAD) * randomOffset
					set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(udg_units33[GetPlayerId(GetOwningPlayer(s__GengetsuMirage_caster[this])) + 1]), 'e00Z', new_x, new_y, GetRandomReal(1, 360))
					call SetUnitTimeScale(bj_lastCreatedUnit, GetRandomReal(0.7, 1.2))
					call SetUnitScale(bj_lastCreatedUnit, 1.0, 1.0, 1.0)
					call KillUnit(bj_lastCreatedUnit)
					set i=i + 1
				endloop

				set bj_lastCreatedGroup=CreateGroup()
				call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__GengetsuMirage_target_x[this], s__GengetsuMirage_target_y[this], 250.0, null)
				loop
					set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
					exitwhen bj_lastCreatedUnit == null
					if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(udg_units33[GetPlayerId(GetOwningPlayer(s__GengetsuMirage_caster[this])) + 1])) then
						call UnitDamageTarget(udg_units33[GetPlayerId(GetOwningPlayer(s__GengetsuMirage_caster[this])) + 1], bj_lastCreatedUnit, GetHeroInt(udg_units33[GetPlayerId(GetOwningPlayer(s__GengetsuMirage_caster[this])) + 1], true) / 2, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
					endif
					call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				endloop
				call DestroyGroup(bj_lastCreatedGroup)

				call ShowUnit(s__GengetsuMirage_caster[this], false)
				call KillUnit(s__GengetsuMirage_caster[this])
                set s__GengetsuMirage_caster[this]=null
                call s__GengetsuMirage_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction



 function s__GengetsuMirage_attack takes nothing returns nothing
  local integer this
  local real x
  local real y
		if GetUnitTypeId(GetAttacker()) == 'H06L' then
			if IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetAttacker())) then
                		call UnitDamageTarget(GetAttacker(), GetTriggerUnit(), GetHeroInt(GetAttacker(), true) / 6, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
				if not IsUnitIllusion(GetAttacker()) then
					if GetHeroLevel(GetAttacker()) >= 35 then
						set s__GengetsuMirage_GengetsuClones=s__GengetsuMirage_GengetsuClones + 1
					endif
					set bj_lastCreatedUnit=CreateAbilityDummy(GetAttacker() , 'A03A')
					call SetUnitAbilityLevel(bj_lastCreatedUnit, 'A03A', 4)
					call IssueTargetOrderById(bj_lastCreatedUnit, 852274, GetAttacker())

					set bj_lastCreatedGroup=CreateGroup()
					call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetAttacker()), GetUnitY(GetAttacker()), 1000, null)
					loop
						set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
						exitwhen bj_lastCreatedUnit == null
						call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
						if GetUnitTypeId(bj_lastCreatedUnit) == 'H06L' and IsUnitIllusion(bj_lastCreatedUnit) then
							set x=(((GetUnitX(GetAttacker()) )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 200))*1.0)) // INLINED!!
							set y=(((GetUnitY(GetAttacker()) )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 200))*1.0)) // INLINED!!
							call SetUnitX(bj_lastCreatedUnit, x)
							call SetUnitY(bj_lastCreatedUnit, y)
							call UnitAddAbility(bj_lastCreatedUnit, 'Avul')
							call UnitAddAbility(bj_lastCreatedUnit, 'Aloc')
							call IssueTargetOrder(bj_lastCreatedUnit, "attack", GetTriggerUnit())
							if ModuloInteger(s__GengetsuMirage_GengetsuClones, 5) == 0 then
								set this=s__GengetsuMirage_allocate()
								set s__GengetsuMirage_target_x[this]=GetUnitX(GetTriggerUnit())
								set s__GengetsuMirage_target_y[this]=GetUnitY(GetTriggerUnit())
								set s__GengetsuMirage_angle[this]=Atan3(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit) , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()))
								set s__GengetsuMirage_caster[this]=CreateUnit(GetOwningPlayer(bj_lastCreatedUnit), 'e05N', x, y, Rad2Deg(s__GengetsuMirage_angle[this]))
								call SetUnitScale(s__GengetsuMirage_caster[this], 2.0, 1.0, 1.0)
								call SetUnitAnimationByIndex(s__GengetsuMirage_caster[this], 1)
								call PauseUnit(s__GengetsuMirage_caster[this], true)
								call TimerStart(NewTimerEx(this), 0.03, true, function s__GengetsuMirage_periodic)
							endif
						endif
					endloop
					call DestroyGroup(bj_lastCreatedGroup)
				endif
			endif
		endif
 endfunction 

 function s__GengetsuMirage_onInit takes nothing returns nothing
		set s__GengetsuMirage_GengetsuClones=1
		call RegisterPlayerUnitEventForId(47 , EVENT_PLAYER_UNIT_ATTACKED , function s__GengetsuMirage_attack)
 endfunction 


