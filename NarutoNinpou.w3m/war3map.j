 function s__HanzoSpread_spreadPeriodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if GetWidgetLife(s__HanzoSpread_target[this]) > 0.405 then
			call DestroyEffect(AddSpecialEffect(("war3mapImported\\Poison_Explosion" ), (( GetUnitX(s__HanzoSpread_target[this]) )*1.0), (( GetUnitY(s__HanzoSpread_target[this]))*1.0))) // INLINED!!
			set bj_lastCreatedGroup=CreateGroup()
			call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__HanzoSpread_target[this]), GetUnitY(s__HanzoSpread_target[this]), 350, null)
			loop
				set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
				exitwhen bj_lastCreatedUnit == null
				call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
				if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HanzoSpread_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
					call UnitDamageTarget(s__HanzoSpread_caster[this], bj_lastCreatedUnit, 1.5 * GetHeroStr(s__HanzoSpread_caster[this], true) + 1.5 * GetHeroAgi(s__HanzoSpread_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
					if s__HanzoSpread_target[this] != bj_lastCreatedUnit then
						call sc__HanzoSpread2_spread(s__HanzoSpread_caster[this] , bj_lastCreatedUnit)
					endif
				endif
			endloop
			call DestroyGroup(bj_lastCreatedGroup)
        else
            call s__HanzoSpread_deallocate(this)
        endif
		call s__HanzoSpread_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
 endfunction
	
	
	
	
	
	
 function s__HanzoSpread_spread takes unit caster,unit tar returns nothing
  local integer this= s__HanzoSpread_allocate()
		set s__HanzoSpread_caster[this]=caster
		set s__HanzoSpread_target[this]=tar
		call TimerStart(NewTimerEx(this), 0.5, false, function s__HanzoSpread_spreadPeriodic)
    endfunction 

