    function s__TobiramaDragon_dealDamage takes nothing returns boolean
   local unit u
			if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__TobiramaDragon_caster[s__TobiramaDragon_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true then
					call UnitDamageTarget(s__TobiramaDragon_caster[s__TobiramaDragon_instance], GetFilterUnit(), ( 50 + GetHeroAgi(s__TobiramaDragon_caster[s__TobiramaDragon_instance], true) / 2 ) * GetUnitAbilityLevel(s__TobiramaDragon_caster[s__TobiramaDragon_instance], 'A0Q6'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
			endif
	    return false
 endfunction

 function s__TobiramaDragon_delay takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		call KillUnit(s__TobiramaDragon_dragon[this])
		call ShowUnit(s__TobiramaDragon_dragon[this], false)
		call s__TobiramaDragon_deallocate(this)
 endfunction 

 function s__TobiramaDragon_finish takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		set bj_lastCreatedGroup=CreateGroup()
		set s__TobiramaDragon_instance=this
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__TobiramaDragon_target_x[this], s__TobiramaDragon_target_y[this], 500, Filter(function s__TobiramaDragon_dealDamage))
		call DestroyGroup(bj_lastCreatedGroup)
		call SlowArea(s__TobiramaDragon_caster[this] , s__TobiramaDragon_target_x[this] , s__TobiramaDragon_target_y[this] , 500)
		call TimerStart(NewTimerEx(this), 0.8, false, function s__TobiramaDragon_delay)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 

 function s__TobiramaDragon_actions takes nothing returns nothing
  local integer this= s__TobiramaDragon_allocate()
		set s__TobiramaDragon_caster[this]=GetTriggerUnit()
		set s__TobiramaDragon_target_x[this]=GetSpellTargetX()
		set s__TobiramaDragon_target_y[this]=GetSpellTargetY()
		set s__TobiramaDragon_dragon[this]=CreateUnit(GetTriggerPlayer(), 'e07T', GetUnitX(s__TobiramaDragon_caster[this]), GetUnitY(s__TobiramaDragon_caster[this]), Rad2Deg(Atan3(GetUnitX(s__TobiramaDragon_caster[this]) , GetUnitY(s__TobiramaDragon_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
		call SetUnitAnimation(s__TobiramaDragon_dragon[this], "death")
		call SetUnitTimeScale(s__TobiramaDragon_dragon[this], 1.5)
		call TimerStart(NewTimerEx(this), 0.5, false, function s__TobiramaDragon_finish)
 endfunction 

