        function s__TayuyaR_dash takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x= GetUnitX(s__TayuyaR_caster[this])
            local real y= GetUnitY(s__TayuyaR_caster[this])
            local real new_x= (((x )*1.0) + Cos((( s__TayuyaR_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
            local real new_y= (((y )*1.0) + Sin((( s__TayuyaR_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
            local real x2
            local real y2
            local unit u= null
            call SetUnitX(s__TayuyaR_caster[this], new_x)
            call SetUnitY(s__TayuyaR_caster[this], new_y)
            call SetUnitFacing(s__TayuyaR_caster[this], Rad2Deg(s__TayuyaR_angle[this]))
            set s__TayuyaR_count[this]=s__TayuyaR_count[this] + 1
            if ModuloInteger(s__TayuyaR_count[this], 5) == 0 then
                set x2=(((x )*1.0) + Cos((( s__TayuyaR_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
                set y2=(((y )*1.0) + Sin((( s__TayuyaR_angle[this] + bj_PI )*1.0)) * (( 230)*1.0)) // INLINED!!
                set bj_lastCreatedEffect=AddSpecialEffect("GoodDashWave.mdx", x2, y2)
                call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__TayuyaR_angle[this])
                call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(x2 , y2))
                call DestroyEffect(bj_lastCreatedEffect)
            endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 150, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TayuyaR_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    set u=bj_lastCreatedUnit
                endif
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            if u != null then
                set TayuyaCore_DokiMark=u
                //call SetUnitInvulnerable(this.caster, true)
                call ShowUnit(TayuyaCore_Tayuya, false)
                call PauseUnit(TayuyaCore_Puppet, true)
                call ShowUnit(TayuyaCore_Puppet, false)
                call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(TayuyaCore_Puppet) )*1.0), (( GetUnitY(TayuyaCore_Puppet))*1.0))) // INLINED!!
                call SetUnitAnimation(s__TayuyaR_caster[this], "stand")
                set s__TayuyaR_target[this]=u
                set s__TayuyaR_targetLoc[this]=GetUnitLoc(u)
                call SetUnitAnimation(s__TayuyaR_target[this], "death")
                set s__TayuyaR_count[this]=0

                set TayuyaCore_OgreRCasting=true
                call PauseUnit(s__TayuyaR_target[this], true)
                set s__TayuyaR_count[this]=0
                call TimerStart(NewTimerEx(this), 0.03, false, function s__TayuyaR_spawn)
                call ReleaseTimer(GetExpiredTimer())
            elseif s__TayuyaR_count[this] > 500 / 35.0 then
                call SetUnitInvulnerable(s__TayuyaR_caster[this], false)
                call PauseUnit(s__TayuyaR_caster[this], false)
                call SetUnitAnimation(s__TayuyaR_caster[this], "stand")
                call SetUnitTimeScale(s__TayuyaR_caster[this], 1.0)
                call s__TayuyaR_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction 

