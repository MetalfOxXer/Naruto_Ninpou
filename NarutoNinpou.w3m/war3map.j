            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__KakashiNewRaikiri_caster[this]) ), ( 'h03U' ), (( GetUnitX(s__KakashiNewRaikiri_caster[this]) )*1.0), (( GetUnitY(s__KakashiNewRaikiri_caster[this]) )*1.0), (( 270)*1.0))) // INLINED!!
            call SetUnitScale(bj_lastCreatedUnit, 0.75, 0, 0)
            call KillUnit(bj_lastCreatedUnit)
            set s__KakashiNewRaikiri_max_count[this]=R2I(GetDistance(GetUnitX(s__KakashiNewRaikiri_caster[this]) , GetUnitY(s__KakashiNewRaikiri_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) / 100)
            call TimerStart(NewTimerEx(this), 0.1, false, function s__KakashiNewRaikiri_delay1)
