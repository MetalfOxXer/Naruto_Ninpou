            set s__KaguyaLava___Spell_caster[this]=GetTriggerUnit()
            
            if udg_KaguyaTeleport1[id] != null and GetDistance(GetSpellTargetX() , GetSpellTargetY() , GetUnitX(udg_KaguyaTeleport1[id]) , GetUnitY(udg_KaguyaTeleport1[id])) < 200 then
                set s__KaguyaLava___Spell_target_x[this]=GetUnitX(udg_KaguyaTeleport2[id])
                set s__KaguyaLava___Spell_target_y[this]=GetUnitY(udg_KaguyaTeleport2[id])
            elseif udg_KaguyaTeleport2[id] != null and GetDistance(GetSpellTargetX() , GetSpellTargetY() , GetUnitX(udg_KaguyaTeleport2[id]) , GetUnitY(udg_KaguyaTeleport2[id])) < 200 then
                set s__KaguyaLava___Spell_target_x[this]=GetUnitX(udg_KaguyaTeleport1[id])
                set s__KaguyaLava___Spell_target_y[this]=GetUnitY(udg_KaguyaTeleport1[id])
            else
                set s__KaguyaLava___Spell_target_x[this]=GetSpellTargetX()
                set s__KaguyaLava___Spell_target_y[this]=GetSpellTargetY()
            endif
            
            set angle=Atan3(GetUnitX(s__KaguyaLava___Spell_caster[this]) , GetUnitY(s__KaguyaLava___Spell_caster[this]) , x , y)
            set x=(((GetUnitX(s__KaguyaLava___Spell_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( 200.0)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__KaguyaLava___Spell_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( 200.0)*1.0)) // INLINED!!
            
			set bj_lastCreatedEffect=AddSpecialEffect("Mr.War3_SKM.mdl", s__KaguyaLava___Spell_target_x[this], s__KaguyaLava___Spell_target_y[this])
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
			call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 3.0)
			call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.75)*1.0) , false) // INLINED!!
            
            call PauseUnit(s__KaguyaLava___Spell_caster[this], true)
            
            set s__KaguyaLava___Spell_damaged[this]=CreateGroup()
            
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__KaguyaLava___Spell_target_x[this], s__KaguyaLava___Spell_target_y[this], 300, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KaguyaLava___Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    call SetUnitFlyHeight(bj_lastCreatedUnit, 700.0, 0)
                    call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 1400.0)
                    call UnitAddAbility(bj_lastCreatedUnit, 'A0IV')
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call SetUnitAnimation(bj_lastCreatedUnit, "death")
                    call SetUnitPosition(bj_lastCreatedUnit, x, y)
                    call GroupAddUnit(s__KaguyaLava___Spell_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            
			set bj_lastCreatedEffect=AddSpecialEffect("Mr.War3_SKM.mdl", x, y)
			call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
			call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 3.0)
			call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.75)*1.0) , false) // INLINED!!
			
            set i=1
            loop
                exitwhen i > 5
                set new_x=(((x )*1.0) + Cos((( Deg2Rad(72 * i) )*1.0)) * (( 75)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( Deg2Rad(72 * i) )*1.0)) * (( 75)*1.0)) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("Effects\\s_New_Katon.mdl", new_x, new_y)
				call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, GetRandomReal(0, 360))
				call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.5)*1.0) , false) // INLINED!!
                set i=i + 1
            endloop
            set l=Location(x, y)
            call TerrainDeformationCraterBJ(0.5, false, l, 350, 300)
            call RemoveLocation(l)
            set l=null
           
            call TimerStart(NewTimerEx(this), 0.5, false, function s__KaguyaLava___Spell_damage)
        endfunction
        
