        endfunction

    function s__SasoriFlamethrower_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local boolean has_fire= false
        local integer i= 0
        local group g
        if s__SasoriFlamethrower_count[this] < 100 then
            set x=(((GetUnitX(s__SasoriFlamethrower_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__SasoriFlamethrower_caster[this])) )*1.0)) * (( 25)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__SasoriFlamethrower_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__SasoriFlamethrower_caster[this])) )*1.0)) * (( 25)*1.0)) // INLINED!!
            set s__s__SasoriFlamethrower_fire[(this)*(1)+s__SasoriFlamethrower_count[this]]= AddSpecialEffect("Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl", x, y)
            call BlzSetSpecialEffectRoll(s__s__SasoriFlamethrower_fire[(this)*(1)+s__SasoriFlamethrower_count[this]], Deg2Rad(GetUnitFacing(s__SasoriFlamethrower_caster[this])))
	        call BlzSetSpecialEffectHeight(s__s__SasoriFlamethrower_fire[(this)*(1)+s__SasoriFlamethrower_count[this]], GetPointZ(x , y))
            set s__s__SasoriFlamethrower_angles[(this)*(1)+s__SasoriFlamethrower_count[this]]= Deg2Rad(GetUnitFacing(s__SasoriFlamethrower_caster[this]))
            set s__s__SasoriFlamethrower_xs[(this)*(1)+s__SasoriFlamethrower_count[this]]= x
            set s__s__SasoriFlamethrower_ys[(this)*(1)+s__SasoriFlamethrower_count[this]]= y
            set s__s__SasoriFlamethrower_counts[(this)*(1)+s__SasoriFlamethrower_count[this]]= 0
            set s__SasoriFlamethrower_count[this]=s__SasoriFlamethrower_count[this] + 1
        endif
        set g=CreateGroup()
        loop
            exitwhen i > s__SasoriFlamethrower_count[this]
            if s__s__SasoriFlamethrower_fire[(this)*(1)+i] != null then
                set has_fire=true
                set x=(((s__s__SasoriFlamethrower_xs[(this)*(1)+i] )*1.0) + Cos((( s__s__SasoriFlamethrower_angles[(this)*(1)+i] )*1.0)) * (( 50)*1.0)) // INLINED!!
                set y=(((s__s__SasoriFlamethrower_ys[(this)*(1)+i] )*1.0) + Sin((( s__s__SasoriFlamethrower_angles[(this)*(1)+i] )*1.0)) * (( 50)*1.0)) // INLINED!!
                call BlzSetSpecialEffectX(s__s__SasoriFlamethrower_fire[(this)*(1)+i], x)
                call BlzSetSpecialEffectY(s__s__SasoriFlamethrower_fire[(this)*(1)+i], y)
                call BlzSetSpecialEffectScale(s__s__SasoriFlamethrower_fire[(this)*(1)+i], 0.8 + 0.3 * s__s__SasoriFlamethrower_counts[(this)*(1)+i])
                call BlzSetSpecialEffectHeight(s__s__SasoriFlamethrower_fire[(this)*(1)+i], 100 + 5 * s__s__SasoriFlamethrower_counts[(this)*(1)+i] + GetPointZ(x , y))
                set s__s__SasoriFlamethrower_xs[(this)*(1)+i]= x
                set s__s__SasoriFlamethrower_ys[(this)*(1)+i]= y
                set s__s__SasoriFlamethrower_counts[(this)*(1)+i]= s__s__SasoriFlamethrower_counts[(this)*(1)+i] + 1
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__s__SasoriFlamethrower_xs[(this)*(1)+i], s__s__SasoriFlamethrower_ys[(this)*(1)+i], 300, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriFlamethrower_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, g) then
                        call UnitDamageTarget(s__SasoriFlamethrower_caster[this], bj_lastCreatedUnit, 0.10 * GetHeroStr(s__SasoriFlamethrower_caster[this], true), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(g, bj_lastCreatedUnit)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
                if s__s__SasoriFlamethrower_counts[(this)*(1)+i] > 15 then
                    call DestroyEffect(s__s__SasoriFlamethrower_fire[(this)*(1)+i])
                    set s__s__SasoriFlamethrower_fire[(this)*(1)+i]= null
                endif
            endif
            set i=i + 1
        endloop
        call DestroyGroup(g)
        set g=null
        if not has_fire then
            call s__SasoriFlamethrower_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    function s__SasoriFlamethrower_actions takes nothing returns nothing
        local integer this= s__SasoriFlamethrower_allocate()
	    if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
		    call PlaySoundOnUnitBJ(gg_snd_Sasori_Q, 100.0, GetTriggerUnit())
        endif
        set s__SasoriFlamethrower_caster[this]=GetTriggerUnit()
        set s__SasoriFlamethrower_count[this]=0
        call TimerStartEx(NewTimerEx(this) , 0.01 , true , function s__SasoriFlamethrower_periodic , "SasoriFlamethrower_periodic")
    endfunction 

