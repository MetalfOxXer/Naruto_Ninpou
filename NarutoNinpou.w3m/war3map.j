//===========================================================================
// Trigger: MadaraResetSpells
//
// 
//             
//            
//             
//             
//             
//===========================================================================
function Trig_MadaraResetSpells_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'N011' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MadaraResetSpells_Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A1BB', GetTriggerUnit()) < 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MadaraResetSpells_Actions takes nothing returns nothing
    if ( Trig_MadaraResetSpells_Func001C() ) then
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HE', true)
         call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HM', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0CX', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HO', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0P3', true)
    else
    endif
endfunction

//===========================================================================
function InitTrig_MadaraResetSpells takes nothing returns nothing
    set gg_trg_MadaraResetSpells=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_MadaraResetSpells, EVENT_PLAYER_HERO_REVIVE_FINISH)
    call TriggerAddCondition(gg_trg_MadaraResetSpells, Condition(function Trig_MadaraResetSpells_Conditions))
    call TriggerAddAction(gg_trg_MadaraResetSpells, function Trig_MadaraResetSpells_Actions)
endfunction

