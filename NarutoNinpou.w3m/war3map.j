    function s__KakuzuNewW_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KakuzuNewW_target[this])
        local real y= GetUnitY(s__KakuzuNewW_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__KakuzuNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KakuzuNewW_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__KakuzuNewW_count[this]=s__KakuzuNewW_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            call SetUnitX(s__KakuzuNewW_target[this], new_x)
            call SetUnitY(s__KakuzuNewW_target[this], new_y)
        else
            set s__KakuzuNewW_count[this]=16
        endif
        if s__KakuzuNewW_count[this] > 15 then
            call KillUnit(s__KakuzuNewW_dummy[this])
            set s__KakuzuNewW_dummy[this]=null
            call PauseUnit(s__KakuzuNewW_target[this], false)
            set s__KakuzuNewW_target[this]=null
            call s__KakuzuNewW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KakuzuNewW_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KakuzuNewW_dummy[this])
        local real y= GetUnitY(s__KakuzuNewW_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__KakuzuNewW_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__KakuzuNewW_angle[this] )*1.0)) * (( 35)*1.0)) // INLINED!!
        local unit u= null
        local integer i
	if ModuloInteger(s__KakuzuNewW_count[this], 3) == 0 then
        	set s__s__KakuzuNewW_tentacles[(this)*(1)+s__KakuzuNewW_count[this]]= CreateUnit(GetOwningPlayer(s__KakuzuNewW_caster[this]), 'u006', x, y, Rad2Deg(s__KakuzuNewW_angle[this]) - 90 + GetRandomReal(- 15, 15))
		call SetUnitAnimation(s__s__KakuzuNewW_tentacles[(this)*(1)+s__KakuzuNewW_count[this]], "stand")
		call SetUnitTimeScale(s__s__KakuzuNewW_tentacles[(this)*(1)+s__KakuzuNewW_count[this]], GetRandomReal(1, 2))
		//call SetUnitScale(tentacles[this][this.count], GetRandomReal(0.6, 0.8), 0, 0)
	        call SetUnitScale(s__s__KakuzuNewW_tentacles[(this)*(1)+s__KakuzuNewW_count[this]], GetRandomReal(0.4, 0.6), 0, 0)
	endif
        set s__KakuzuNewW_count[this]=s__KakuzuNewW_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 180.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KakuzuNewW_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                if u == null or GetWidgetLife(bj_lastCreatedUnit) < GetWidgetLife(u) then
                    set u=bj_lastCreatedUnit
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
	    set i=0
	    loop
		exitwhen i == s__KakuzuNewW_count[this]
		if s__s__KakuzuNewW_tentacles[(this)*(1)+i] != null then
			call KillUnit(s__s__KakuzuNewW_tentacles[(this)*(1)+i])
		endif
		set s__s__KakuzuNewW_tentacles[(this)*(1)+i]= null
		set i=i + 1
	    endloop
            set i=0
            loop
                exitwhen i > 5
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakuzuNewW_caster[this]), 'u003', GetUnitX(u), GetUnitY(u), Rad2Deg(s__KakuzuNewW_angle[this]))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
                call SetUnitTimeScale(bj_lastCreatedUnit, 1.3 + 0.1 * i)
                set i=i + 1
            endloop
            set i=0
            loop
                exitwhen i > 5
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KakuzuNewW_caster[this]), 'n00O', GetUnitX(u), GetUnitY(u), Rad2Deg(s__KakuzuNewW_angle[this]))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 5.0)
                set i=i + 1
            endloop
            call UnitDamageTarget(s__KakuzuNewW_caster[this], u, GetHeroStr(s__KakuzuNewW_caster[this], true) * GetUnitAbilityLevel(s__KakuzuNewW_caster[this], s__KakuzuNewW_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
            set s__KakuzuNewW_count[this]=0
            set s__KakuzuNewW_target[this]=u
           // call PauseUnit(this.caster, false)
            call SetUnitTimeScale(s__KakuzuNewW_caster[this], 1.0)
            //call SetUnitVertexColorEx(this.caster, 255, 255, 255, 255)
           // call UnitRemoveAbility(this.caster, 'B04X')
            //call SetUnitInvulnerable(this.caster, false)
            call SetUnitPropWindow(s__KakuzuNewW_caster[this], udg_Kakuzu_Window)
            call PauseUnit(s__KakuzuNewW_target[this], true)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__KakuzuNewW_knockback)
            call ReleaseTimer(GetExpiredTimer())
        elseif s__KakuzuNewW_count[this] > 20 then
           // call PauseUnit(this.caster, false)
            call SetUnitTimeScale(s__KakuzuNewW_caster[this], 1.0)
            call SetUnitPropWindow(s__KakuzuNewW_caster[this], udg_Kakuzu_Window)
            //call SetUnitVertexColorEx(this.caster, 255, 255, 255, 255)
            //call UnitRemoveAbility(this.caster, 'B04X')
            //call SetUnitInvulnerable(this.caster, false)
	    set i=0
	    loop
		exitwhen i == s__KakuzuNewW_count[this]
		if s__s__KakuzuNewW_tentacles[(this)*(1)+i] != null then
			call KillUnit(s__s__KakuzuNewW_tentacles[(this)*(1)+i])
		endif
		set s__s__KakuzuNewW_tentacles[(this)*(1)+i]= null
		set i=i + 1
	    endloop
            call KillUnit(s__KakuzuNewW_dummy[this])
            set s__KakuzuNewW_dummy[this]=null
            call s__KakuzuNewW_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        else //if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then 
            call SetUnitX(s__KakuzuNewW_dummy[this], new_x)
            call SetUnitY(s__KakuzuNewW_dummy[this], new_y)
            
       // else 
       //     set this.count = 21 
        endif
    endfunction 
    
