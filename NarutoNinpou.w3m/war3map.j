    function s__HagoromoTE_damagenumunits1 takes nothing returns boolean
        if GetWidgetLife(GetFilterUnit()) > 0.405 then
            //call BJDebugMsg(GetUnitName(GetFilterUnit()))
            call UnitDamageTarget(s__HagoromoD_Hagoromo, GetFilterUnit(), ( ( 800 + ( GetHeroInt(s__HagoromoD_Hagoromo, true) * ( GetHeroLevel(s__HagoromoD_Hagoromo) / 10.0 ) ) ) * 0.4 ) / 66.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif
        return false
    endfunction

    function s__HagoromoTE_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real progress
        local real newX
        local real newY
        local real newX2
        local real newY2
        local real newX3
        local real newY3
        local integer i= 0

        // First phase: move units toward the target while keeping the relative positions
        if not s__HagoromoTE_switch[this] then
            set progress=s__HagoromoTE_count[this] / I2R(s__HagoromoTE_duration[this])
            set newX=s__HagoromoTE_startX[this] + progress * ( s__HagoromoTE_endX[this] - s__HagoromoTE_startX[this] )
            set newY=s__HagoromoTE_startY[this] + progress * ( s__HagoromoTE_endY[this] - s__HagoromoTE_startY[this] )

            // Calculate the positions for the second and third units relative to the first
            set newX2=(((newX )*1.0) + Cos((( s__HagoromoTE_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this]))*1.0)) // INLINED!!
            set newY2=(((newY )*1.0) + Sin((( s__HagoromoTE_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this]))*1.0)) // INLINED!!
            set newX3=(((newX )*1.0) + Cos((( s__HagoromoTE_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this]))*1.0)) // INLINED!!
            set newY3=(((newY )*1.0) + Sin((( s__HagoromoTE_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this]))*1.0)) // INLINED!!

            set s__HagoromoTE_count[this]=s__HagoromoTE_count[this] + 1

            call SetUnitX(s__HagoromoTE_amaterasu1[this], newX)
            call SetUnitY(s__HagoromoTE_amaterasu1[this], newY)

            call SetUnitX(s__HagoromoTE_amaterasu2[this], newX2)
            call SetUnitY(s__HagoromoTE_amaterasu2[this], newY2)
            call SetUnitFacing(s__HagoromoTE_amaterasu2[this], Rad2Deg(Atan3(newX2 , newY2 , (((newX )*1.0) + Cos((( s__HagoromoTE_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this] + 2))*1.0)) , (((newY )*1.0) + Sin((( s__HagoromoTE_angle[this] + bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this] + 2))*1.0))))) // INLINED!!

            call SetUnitX(s__HagoromoTE_amaterasu3[this], newX3)
            call SetUnitY(s__HagoromoTE_amaterasu3[this], newY3)
            call SetUnitFacing(s__HagoromoTE_amaterasu3[this], Rad2Deg(Atan3(newX3 , newY3 , (((newX )*1.0) + Cos((( s__HagoromoTE_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this] + 2))*1.0)) , (((newY )*1.0) + Sin((( s__HagoromoTE_angle[this] - bj_PI / 2 )*1.0)) * (( ParabolaZ(400 , 32 , s__HagoromoTE_count[this] + 2))*1.0))))) // INLINED!!
        
        // Second phase: deal damage to nearby enemies
        else
            set s__HagoromoTE_count[this]=s__HagoromoTE_count[this] + 1

            // Check for units within range and deal damage to enemies
            //call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(this.amaterasu1), GetUnitY(this.amaterasu1), 300, null)

            set i=0
            loop
                exitwhen i > s__HagoromoTE_targetsHit[this]
            set s__HagoromoTE_recycle[this]=CreateGroup()
                call GroupEnumUnitsInRange(s__HagoromoTE_recycle[this], GetUnitX(s__HagoromoBlazeRelease__targets[i]), GetUnitY(s__HagoromoBlazeRelease__targets[i]), 200, Filter(function s__HagoromoTE_damagenumunits1))

            call DestroyGroup(s__HagoromoTE_recycle[this])
            set s__HagoromoTE_recycle[this]=null
                set i=i + 1
            endloop

        endif

        // Switch phases after 33 ticks, transition to second phase where damage is applied
        if s__HagoromoTE_count[this] > 33 then
            if not s__HagoromoTE_switch[this] then
                set s__HagoromoTE_switch[this]=true
                set s__HagoromoTE_count[this]=- 33

                // Damage nearby units during the phase transition
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, newX, newY, 300, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__HagoromoTE_caster[this])) and not IsUnitInGroup(bj_lastCreatedUnit, s__HagoromoTE_damaged[this]) then
                        call UnitDamageTarget(s__HagoromoTE_caster[this], bj_lastCreatedUnit, ( ( 800 + ( GetHeroInt(s__HagoromoTE_caster[this], true) * ( GetHeroLevel(s__HagoromoTE_caster[this]) / 10.0 ) ) ) * 0.6 ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                        call GroupAddUnit(s__HagoromoTE_damaged[this], bj_lastCreatedUnit)
                        set s__HagoromoBlazeRelease__targets[s__HagoromoTE_targetsHit[this]]= bj_lastCreatedUnit
                        set s__HagoromoBlazeRelease__effects[s__HagoromoTE_targetsHit[this]]= AddSpecialEffectTarget("war3mapImported\\Amaterasu_Purple.mdl", bj_lastCreatedUnit, "origin")
                        set s__HagoromoTE_targetsHit[this]=1 + s__HagoromoTE_targetsHit[this]
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)

                // Kill the current units and replace them with a new visual effect
                call KillUnit(s__HagoromoTE_amaterasu1[this])
                call KillUnit(s__HagoromoTE_amaterasu2[this])
                call KillUnit(s__HagoromoTE_amaterasu3[this])
                //set this.amaterasu1 = GetUnit(GetOwningPlayer(this.caster), 'h07U', this.endX, this.endY, GetUnitFacing(this.caster))
                //call SetUnitAnimation(this.amaterasu1, "stand")
                //call SetUnitScale(this.amaterasu1, 1.25, 1.25, 1.0)
            else
                set i=0
                loop
                    exitwhen i >= 99
                    if s__HagoromoBlazeRelease__effects[i] != null then
                        call DestroyEffect(s__HagoromoBlazeRelease__effects[i])
                    endif
                    set s__HagoromoBlazeRelease__effects[i]= null
                    set s__HagoromoBlazeRelease__targets[i]= null
                    set i=i + 1
                endloop
        
                call KillUnit(s__HagoromoTE_amaterasu1[this])
                set s__HagoromoTE_amaterasu1[this]=null
                call DestroyGroup(s__HagoromoTE_damaged[this])
                set s__HagoromoTE_damaged[this]=null
                call s__HagoromoTE_deallocate(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction 
    
    function s__HagoromoTE_actions takes nothing returns nothing
        local integer this= s__HagoromoTE_allocate()
        local integer i= 0

        // Set up initial caster and position values
        set s__HagoromoTE_caster[this]=GetTriggerUnit()
        set s__HagoromoTE_startX[this]=GetUnitX(s__HagoromoTE_caster[this])
        set s__HagoromoTE_startY[this]=GetUnitY(s__HagoromoTE_caster[this])
        set s__HagoromoTE_endX[this]=GetSpellTargetX()
        set s__HagoromoTE_endY[this]=GetSpellTargetY()
        set s__HagoromoTE_angle[this]=Atan3(s__HagoromoTE_startX[this] , s__HagoromoTE_startY[this] , s__HagoromoTE_endX[this] , s__HagoromoTE_endY[this])
        set s__HagoromoTE_distance[this]=GetDistance(s__HagoromoTE_startX[this] , s__HagoromoTE_startY[this] , s__HagoromoTE_endX[this] , s__HagoromoTE_endY[this])

        set s__HagoromoTE_count[this]=0
        set s__HagoromoTE_targetsHit[this]=0
        set s__HagoromoTE_duration[this]=32
        set s__HagoromoTE_damaged[this]=CreateGroup()

	    call SetUnitAnimationByIndex(s__HagoromoTE_caster[this], 40)
        // Create initial units for the spell effect
        set s__HagoromoTE_amaterasu1[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h07W' ), (( s__HagoromoTE_startX[this] )*1.0), (( s__HagoromoTE_startY[this] )*1.0), (( GetUnitFacing(s__HagoromoTE_caster[this]))*1.0))) // INLINED!!
        call SetUnitAnimation(s__HagoromoTE_amaterasu1[this], "death")
        set s__HagoromoTE_amaterasu2[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h07U' ), (( s__HagoromoTE_startX[this] )*1.0), (( s__HagoromoTE_startY[this] )*1.0), (( GetUnitFacing(s__HagoromoTE_caster[this]))*1.0))) // INLINED!!
        call SetUnitAnimation(s__HagoromoTE_amaterasu2[this], "stand")
        set s__HagoromoTE_amaterasu3[this]=(CreateUnit((GetTriggerPlayer() ), ( 'h07U' ), (( s__HagoromoTE_startX[this] )*1.0), (( s__HagoromoTE_startY[this] )*1.0), (( GetUnitFacing(s__HagoromoTE_caster[this]))*1.0))) // INLINED!!
        call SetUnitAnimation(s__HagoromoTE_amaterasu3[this], "stand")
        
        set s__HagoromoTE_switch[this]=false

        loop
            exitwhen i >= 99
            if s__HagoromoBlazeRelease__effects[i] != null then
                call DestroyEffect(s__HagoromoBlazeRelease__effects[i])
            endif
            set s__HagoromoBlazeRelease__effects[i]= null
            set s__HagoromoBlazeRelease__targets[i]= null
            set i=i + 1
        endloop

        call TimerStart(NewTimerEx(this), 0.03, true, function s__HagoromoTE_periodic)
    endfunction 
    
// scope HagoromoBlazeRelease ends
