	set s__MadaraTengaiShinsei_meteor[this]=null
	call s__MadaraTengaiShinsei_deallocate(this)
	call ReleaseTimer(GetExpiredTimer())
    endfunction 

   function s__MadaraTengaiShinsei_counter takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local integer this2
