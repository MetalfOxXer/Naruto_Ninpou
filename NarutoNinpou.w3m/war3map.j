    function s__PakuraD_burn takes nothing returns nothing
        local unit orb
        local unit u
        local group g= CreateGroup()
        local group enemies= CreateGroup()
        local integer orbCount= s__PakuraD_PakuraOrbCount
        local real intDmg= I2R(GetHeroInt(Pakura, true)) * 2.0

        call GroupAddGroup(PakuraAllOrbs, g)
        loop
            set orb=FirstOfGroup(g)
            exitwhen orb == null
            if IsUnitAliveBJ(orb) then
                call GroupClear(enemies)
                call GroupEnumUnitsInRange(enemies, GetUnitX(orb), GetUnitY(orb), 250, null)
                loop
                    set u=FirstOfGroup(enemies)
                    exitwhen u == null
                    if IsUnitEnemy(orb, GetOwningPlayer(u)) and GetWidgetLife(u) > 0.405 and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
                        if orbCount > 0 then
                            call UnitDamageTarget(orb, u, intDmg / I2R(orbCount), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, null)
                            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\ImmolationRed\\ImmolationRedTarget.mdl", GetUnitX(u), GetUnitY(u)))
                        endif
                    endif
                    call GroupRemoveUnit(enemies, u)
                endloop
            else
                call GroupRemoveUnit(PakuraAllOrbs, orb)
			    if s__PakuraD_PakuraOrbCount > 0 then
			    	set s__PakuraD_PakuraOrbCount=s__PakuraD_PakuraOrbCount - 1
			    endif

            endif
            call GroupRemoveUnit(g, orb)
        endloop

        call DestroyGroup(g)
        call DestroyGroup(enemies)

        if s__PakuraD_PakuraOrbCount <= 0 then
            call PauseTimer(PakuraBurnTimer)
            call ReleaseTimer(PakuraBurnTimer)
            set PakuraBurnTimer=null
            set PakuraBurnActive=false
        endif
    endfunction

    function s__PakuraD_BeginBurnTimer takes nothing returns nothing
        if not PakuraBurnActive and s__PakuraD_PakuraOrbCount > 0 then
            set PakuraBurnActive=true
            if PakuraBurnTimer == null then
                set PakuraBurnTimer=CreateTimer()
            endif
            call TimerStart(PakuraBurnTimer, 1.0, true, function s__PakuraD_burn)
        endif
    endfunction

    function s__PakuraD_cleanUp takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__PakuraD_orbs[this])
            exitwhen bj_lastCreatedUnit == null
            call KillUnit(bj_lastCreatedUnit)
            call RemoveUnit(bj_lastCreatedUnit)
            call GroupRemoveUnit(PakuraAllOrbs, bj_lastCreatedUnit)
            call GroupRemoveUnit(s__PakuraD_orbs[this], bj_lastCreatedUnit)
        endloop

        call DestroyGroup(s__PakuraD_orbs[this])
        call s__PakuraD_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__PakuraD_actions takes nothing returns nothing
        local integer this= s__PakuraD_allocate()
        local integer i
        local integer mid
        local real offset
        local real facing
        local real spread
        local real distance
        local real range
        local real adjustment
        local real x
        local real y
        local real x2
        local real y2
        local unit orb
    
        set s__PakuraD_caster[this]=GetTriggerUnit()
        set s__PakuraD_orbs[this]=CreateGroup()
        set Pakura=s__PakuraD_caster[this]
    
        set x2=(s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__PakuraD_caster[this])))]) // INLINED!!
        set y2=(s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__PakuraD_caster[this])))]) // INLINED!!
        set distance=GetDistance(GetUnitX(s__PakuraD_caster[this]) , GetUnitY(s__PakuraD_caster[this]) , x2 , y2)
        if distance > 400 then
            set distance=400
        endif
        if distance < 150.0 then
            set distance=150.0
        endif
    
        set range=BlzGetAbilityRealLevelField(BlzGetUnitAbility(s__PakuraD_caster[this], s__PakuraD_SPELL_ID), ABILITY_RLF_CAST_RANGE, 0)
    
        set s__PakuraD_orb_count[this]=1 + ( GetHeroLevel(s__PakuraD_caster[this]) / 10 )
    
        set facing=Atan2(y2 - GetUnitY(s__PakuraD_caster[this]), x2 - GetUnitX(s__PakuraD_caster[this]))
        set facing=facing * bj_RADTODEG
    
        set spread=s__PakuraD_MIN_SPREAD + ( distance / range ) * ( s__PakuraD_MAX_SPREAD - s__PakuraD_MIN_SPREAD )
        set offset=spread
    
        set mid=( s__PakuraD_orb_count[this] - 1 ) / 2
        set adjustment=0.0
    
        if ModuloInteger(s__PakuraD_orb_count[this], 2) == 0 then
            set adjustment=offset / 2.0
        endif
    
        set i=0
        loop
            exitwhen i >= s__PakuraD_orb_count[this]
            set x=(((GetUnitX(s__PakuraD_caster[this]) )*1.0) + Cos((( Deg2Rad(facing + ( i - mid ) * offset - adjustment) )*1.0)) * (( distance)*1.0)) // INLINED!!
            set y=(((GetUnitY(s__PakuraD_caster[this]) )*1.0) + Sin((( Deg2Rad(facing + ( i - mid ) * offset - adjustment) )*1.0)) * (( distance)*1.0)) // INLINED!!
    
            set orb=CreateUnit(GetOwningPlayer(s__PakuraD_caster[this]), 'h09F', x, y, 0)
            call GroupAddUnit(s__PakuraD_orbs[this], orb)
	    call UnitApplyTimedLife(orb, 'BTLF', 7.1)
            call GroupAddUnit(PakuraAllOrbs, orb)
            set s__PakuraD_PakuraOrbCount=s__PakuraD_PakuraOrbCount + 1
    
            set i=i + 1
        endloop
	call SetUnitAnimationByIndex(s__PakuraD_caster[this], 0)
        call s__PakuraD_BeginBurnTimer()

        call TimerStart(NewTimerEx(this), 7.00, false, function s__PakuraD_cleanUp)
    endfunction

    function s__PakuraD_onInit takes nothing returns nothing
        set PakuraAllOrbs=CreateGroup()
        call RegisterSpellEffectEventForId(87 , s__PakuraD_SPELL_ID , function s__PakuraD_actions)
    endfunction

