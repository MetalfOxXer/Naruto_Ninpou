//Implemented from module Alloc:
    
        function s__HagoromoTR_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__HagoromoTR_Alloc___recycle[(0)] == 0 ) then
                set s__HagoromoTR_Alloc___instanceCount=s__HagoromoTR_Alloc___instanceCount + 1
                set this=s__HagoromoTR_Alloc___instanceCount
            else
                set this=s__HagoromoTR_Alloc___recycle[(0)]
                set s__HagoromoTR_Alloc___recycle[(0)]=s__HagoromoTR_Alloc___recycle[s__HagoromoTR_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__HagoromoTR_deallocate takes integer this returns nothing
            set s__HagoromoTR_Alloc___recycle[this]=s__HagoromoTR_Alloc___recycle[(0)]
            set s__HagoromoTR_Alloc___recycle[(0)]=this
        endfunction

        function s__HagoromoTR_applyDamageReduction takes nothing returns nothing
            local integer this= LoadInteger(HagoromoTR__h, GetHandleId(GetTriggerUnit()), 0)
            local real damage= GetEventDamage()
            local unit damagedUnit= GetTriggerUnit()
            local unit damageSource= GetEventDamageSource()
            
            if damagedUnit == s__HagoromoTR_caster[this] and damage >= 10 then
                set s__HagoromoTR_damageReduction[this]=damage * 0.75 // Reduce damage by 25%
                //call BJDebugMsg("Original Damage: " + R2S(damage))
                //call BJDebugMsg("Reduced Damage: " + R2S(this.damageReduction))
                call BlzSetEventDamage(s__HagoromoTR_damageReduction[this]) // Apply reduced damage
                if not s__HagoromoTR_isTeleportTriggered[this] then
                    set s__HagoromoTR_isTeleportTriggered[this]=true
                    call TimerStart(NewTimerEx(this), 0.03, false, function sc__HagoromoTR_teleportToTarget)
                endif
            endif
        endfunction

        function s__HagoromoTR_delay takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
	    call SetUnitAnimationByIndex(s__HagoromoTR_caster[this], 5)
            call DestroyEffect(s__HagoromoTR_startEffect[this])
            call DestroyEffect(s__HagoromoTR_endEffect[this])
            call s__HagoromoTR_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__HagoromoTR_teleportToTarget takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            call DestroyTrigger(s__HagoromoTR_trig[this])
	        call SetUnitAnimationByIndex(s__HagoromoTR_caster[this], 4)
            set s__HagoromoTR_startEffect[this]=AddSpecialEffect("war3mapImported\\blink-yellow2.mdl", GetUnitX(s__HagoromoTR_caster[this]), GetUnitY(s__HagoromoTR_caster[this]))
            call BlzPlaySpecialEffectWithTimeScale(s__HagoromoTR_startEffect[this], ANIM_TYPE_BIRTH, 2.0)
            call SetUnitX(s__HagoromoTR_caster[this], s__HagoromoTR_target_x[this])
            call SetUnitY(s__HagoromoTR_caster[this], s__HagoromoTR_target_y[this])
            set s__HagoromoTR_endEffect[this]=AddSpecialEffect("war3mapImported\\blink-yellow2.mdl", GetUnitX(s__HagoromoTR_caster[this]), GetUnitY(s__HagoromoTR_caster[this]))
            call BlzPlaySpecialEffectWithTimeScale(s__HagoromoTR_endEffect[this], ANIM_TYPE_BIRTH, 2.0)
            //call BJDebugMsg("Swift Release - Teleport executed")
            call TimerStart(NewTimerEx(this), 1.0, false, function s__HagoromoTR_delay)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__HagoromoTR_removeEffect takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            if s__HagoromoTR_isTeleportTriggered[this] == false then
                call TimerStart(NewTimerEx(this), 0.03, false, function s__HagoromoTR_teleportToTarget)
            endif
            call s__HagoromoTR_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction

        function s__HagoromoTR_actions takes nothing returns nothing
            local integer this= s__HagoromoTR_allocate()
            set s__HagoromoTR_caster[this]=GetTriggerUnit()
            set s__HagoromoTR_target_x[this]=GetSpellTargetX()
            set s__HagoromoTR_target_y[this]=GetSpellTargetY()
            set s__HagoromoTR_start_x[this]=GetUnitX(s__HagoromoTR_caster[this])
            set s__HagoromoTR_start_y[this]=GetUnitY(s__HagoromoTR_caster[this])
            set s__HagoromoTR_damageReduction[this]=0
            set s__HagoromoTR_isTeleportTriggered[this]=false
            set s__HagoromoTR_duration[this]=3 // Duration of the buff in seconds
            
            call AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", s__HagoromoTR_target_x[this], s__HagoromoTR_target_y[this])
            
            // Store the current instance in the hashtable
            call SaveInteger(HagoromoTR__h, GetHandleId(s__HagoromoTR_caster[this]), 0, this)
            
            // Create the trigger
            set s__HagoromoTR_trig[this]=CreateTrigger()
            call TriggerRegisterUnitEvent(s__HagoromoTR_trig[this], s__HagoromoTR_caster[this], EVENT_UNIT_DAMAGED)
            call TriggerAddAction(s__HagoromoTR_trig[this], function s__HagoromoTR_applyDamageReduction)
            
            call TimerStart(NewTimerEx(this), s__HagoromoTR_duration[this], false, function s__HagoromoTR_removeEffect)
        endfunction


// scope HagoromoTR ends

