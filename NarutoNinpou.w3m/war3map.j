        local real y
        local real x1
        local real y1
        local real i= 1
        local real j= 1
        set s__ZabuzaKirigakureFarm_caster[this]=GetTriggerUnit()
        set s__ZabuzaKirigakureFarm_count[this]=0
        set s__ZabuzaKirigakureFarm_caster_x[this]=GetUnitX(s__ZabuzaKirigakureFarm_caster[this])
