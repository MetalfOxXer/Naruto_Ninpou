        local real y= GetUnitY(s__HayateNewW_caster[this])
        local real angle= Atan3(s__HayateNewW_slashtarget_x , s__HayateNewW_slashtarget_y , GetUnitX(s__HayateNewW_caster[this]) , GetUnitY(s__HayateNewW_caster[this]))
