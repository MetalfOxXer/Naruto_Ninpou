 function s__DanzoMokuton_dealDamage takes nothing returns boolean
	    if GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__DanzoMokuton_caster[s__DanzoMokuton_instance])) then
            call UnitDamageTarget(s__DanzoMokuton_caster[s__DanzoMokuton_instance], GetFilterUnit(), GetHeroInt(s__DanzoMokuton_caster[s__DanzoMokuton_instance], true) * GetUnitAbilityLevel(s__DanzoMokuton_caster[s__DanzoMokuton_instance], s__DanzoMokuton_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            call EsnareUnitTimed(s__DanzoMokuton_caster[s__DanzoMokuton_instance] , GetFilterUnit() , 2.0)
        endif
	    return false
 endfunction
    
    function s__DanzoMokuton_actions takes nothing returns nothing
        local integer this= s__DanzoMokuton_allocate()
        local integer i
        local real x
        local real y
        set s__DanzoMokuton_caster[this]=GetTriggerUnit()
        set s__DanzoMokuton_target_x[this]=GetSpellTargetX()
        set s__DanzoMokuton_target_y[this]=GetSpellTargetY()
        set i=1
        loop
            exitwhen i > 10
            set x=(((s__DanzoMokuton_target_x[this] )*1.0) + Cos((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
            set y=(((s__DanzoMokuton_target_y[this] )*1.0) + Sin((( Deg2Rad(36 * i) )*1.0)) * (( 100)*1.0)) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
            set i=i + 1
        endloop
        set i=1
        loop
            exitwhen i > 5
            set x=(((s__DanzoMokuton_target_x[this] )*1.0) + Cos((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 150))*1.0)) // INLINED!!
            set y=(((s__DanzoMokuton_target_y[this] )*1.0) + Sin((( Deg2Rad(GetRandomReal(0, 360)) )*1.0)) * (( GetRandomReal(0, 150))*1.0)) // INLINED!!
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__DanzoMokuton_caster[this]) ), ( 'echm' ), (( x )*1.0), (( y )*1.0), (( 270.0)*1.0))) // INLINED!!
            call SetUnitScale(bj_lastCreatedUnit, 1.5, 0, 0)
            call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(- 100, 0), 0)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.0)
            set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__DanzoMokuton_caster[this]) ), ( 'ohun' ), (( x )*1.0), (( y )*1.0), (( 270.0)*1.0))) // INLINED!!
            call SetUnitTimeScale(bj_lastCreatedUnit, 0.5)
            call KillUnit(bj_lastCreatedUnit)
            set i=i + 1
        endloop
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__DanzoMokuton_caster[this]) ), ( 'h039' ), (( x )*1.0), (( y )*1.0), (( 270.0)*1.0))) // INLINED!!
        call SetUnitTimeScale(bj_lastCreatedUnit, 6.0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
        set bj_lastCreatedGroup=CreateGroup()
        set s__DanzoMokuton_instance=this
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__DanzoMokuton_target_x[this], s__DanzoMokuton_target_y[this], 350.0, Filter(function s__DanzoMokuton_dealDamage))
        call DestroyGroup(bj_lastCreatedGroup)
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__DanzoMokuton_caster[this]) ), ( 'h039' ), (( x )*1.0), (( y )*1.0), (( 270.0)*1.0))) // INLINED!!
        call SetUnitTimeScale(bj_lastCreatedUnit, 6.0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.5)
        call IssueImmediateOrder(bj_lastCreatedUnit, "stand")
        call s__DanzoMokuton_deallocate(this)
    endfunction 
    
    function s__DanzoMokuton_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(41 , s__DanzoMokuton_SPELL_ID , function s__DanzoMokuton_actions)
    endfunction 
    
