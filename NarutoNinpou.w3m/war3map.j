 function s__KinkakuRopeNew_dealDamage takes nothing returns boolean
             local unit u
                if GetWidgetLife(GetFilterUnit()) > 0.405 and IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__KinkakuRopeNew_caster[s__KinkakuRopeNew_instance])) and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false then
                    call UnitDamageTarget(s__KinkakuRopeNew_caster[s__KinkakuRopeNew_instance], GetFilterUnit(), GetHeroStr(s__KinkakuRopeNew_caster[s__KinkakuRopeNew_instance], true) / 2 * GetUnitAbilityLevel(s__KinkakuRopeNew_caster[s__KinkakuRopeNew_instance], s__KinkakuRopeNew_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                    set u=CreateAbilityDummy(s__KinkakuRopeNew_caster[s__KinkakuRopeNew_instance] , 'A0OG')
		    call SetUnitX(u, GetUnitX(GetFilterUnit()))
		    call SetUnitY(u, GetUnitY(GetFilterUnit()))
                    call IssueTargetOrder(u, "web", GetFilterUnit())
                endif
	    return false
 endfunction
	
    function s__KinkakuRopeNew_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__KinkakuRopeNew_missile[this])
        local real y= GetUnitY(s__KinkakuRopeNew_missile[this])
        local real angle
        local real new_x
        local real new_y
        set angle=Atan3(x , y , GetUnitX(s__KinkakuRopeNew_target[this]) , GetUnitY(s__KinkakuRopeNew_target[this]))
        set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        call SetUnitX(s__KinkakuRopeNew_missile[this], new_x)
        call SetUnitY(s__KinkakuRopeNew_missile[this], new_y)
        set s__KinkakuRopeNew_distance[this]=GetDistance(new_x , new_y , GetUnitX(s__KinkakuRopeNew_target[this]) , GetUnitY(s__KinkakuRopeNew_target[this]))
        call SetUnitFacing(s__KinkakuRopeNew_missile[this], 180 + Rad2Deg(angle))
        call SetUnitFlyHeight(s__KinkakuRopeNew_missile[this], 60 + ParabolaZ(300 , s__KinkakuRopeNew_distance[this] , s__KinkakuRopeNew_distance[this] - GetDistance(new_x , new_y , s__KinkakuRopeNew_target_x[this] , s__KinkakuRopeNew_target_y[this])), 0)
        if GetDistance(new_x , new_y , GetUnitX(s__KinkakuRopeNew_target[this]) , GetUnitY(s__KinkakuRopeNew_target[this])) < 100 then
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__KinkakuRopeNew_caster[this]), 'h05S', GetUnitX(s__KinkakuRopeNew_target[this]), GetUnitY(s__KinkakuRopeNew_target[this]), 270)
            call SetUnitAnimation(bj_lastCreatedUnit, "birth")
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
            set bj_lastCreatedGroup=CreateGroup()
	        set s__KinkakuRopeNew_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KinkakuRopeNew_target[this]), GetUnitY(s__KinkakuRopeNew_target[this]), 300, Filter(function s__KinkakuRopeNew_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            call KillUnit(s__KinkakuRopeNew_missile[this])
            set s__KinkakuRopeNew_missile[this]=null
            call s__KinkakuRopeNew_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KinkakuRopeNew_actions takes nothing returns nothing
        local integer this= s__KinkakuRopeNew_allocate()
        set s__KinkakuRopeNew_caster[this]=GetTriggerUnit()
        set s__KinkakuRopeNew_target[this]=GetSpellTargetUnit()
        set s__KinkakuRopeNew_target_x[this]=GetUnitX(s__KinkakuRopeNew_target[this])
        set s__KinkakuRopeNew_target_y[this]=GetUnitY(s__KinkakuRopeNew_target[this])
        set s__KinkakuRopeNew_missile[this]=CreateUnit(GetTriggerPlayer(), 'h0AJ', GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 180 + Rad2Deg(Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())))
        set s__KinkakuRopeNew_distance[this]=GetDistance(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , s__KinkakuRopeNew_target_x[this] , s__KinkakuRopeNew_target_y[this])
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__KinkakuRopeNew_periodic , "KinkakuRopeNew_periodic")
    endfunction 
   
    function s__KinkakuRopeNew_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__KinkakuRopeNew_SPELL_ID ) , Filter(( function s__KinkakuRopeNew_actions))) // INLINED!!
    endfunction 

