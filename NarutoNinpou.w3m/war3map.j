	return GetBooleanAnd(( GetBooleanAnd(( IsUnitAliveBJ(GetFilterUnit()) ), ( IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false )) ), ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) ))
endfunction

