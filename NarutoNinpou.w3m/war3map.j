            set s__TentenTensasai__Spell_scroll[this]=null
            call KillUnit(s__TentenTensasai__Spell_bomb[this])
            call ShowUnit(s__TentenTensasai__Spell_bomb[this], false)
            set s__TentenTensasai__Spell_bomb[this]=null
            call s__TentenTensasai__Spell_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endfunction
        
        function s__TentenTensasai__Spell_rain takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real x
            local real y
            local real offset
            local real new_x
            local real new_y
            local integer i= 0
            loop
                exitwhen i > 8
                    set x=(((s__TentenTensasai__Spell_target_x[this] )*1.0) + Cos((( Deg2Rad(90) + s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50 * i)*1.0)) // INLINED!!
                    set y=(((s__TentenTensasai__Spell_target_y[this] )*1.0) + Sin((( Deg2Rad(90) + s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50 * i)*1.0)) // INLINED!!
                    set offset=GetRandomInt(0, 200)
                    set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( offset)*1.0)) // INLINED!!
                    set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( offset)*1.0)) // INLINED!!
                    if s__TentenTensasai__Spell_count[this] <= 16 and ModuloInteger(s__TentenTensasai__Spell_count[this], 2) == 0 then
                        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TentenTensasai__Spell_caster[this]), 'h0AC', new_x, new_y, 270)
                        call SetUnitFlyHeight(bj_lastCreatedUnit, 500, 0)
                        call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 1000)
                        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
                    endif
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 300.0, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                        if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TentenTensasai__Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__TentenTensasai__Spell_damaged[this]) then
                            call UnitDamageTarget(s__TentenTensasai__Spell_caster[this], bj_lastCreatedUnit, 6000 / 16.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                            call GroupAddUnit(s__TentenTensasai__Spell_damaged[this], bj_lastCreatedUnit)
                        endif
                    endloop
                    call DestroyGroup(bj_lastCreatedGroup)

                    set x=(((s__TentenTensasai__Spell_target_x[this] )*1.0) + Cos((( Deg2Rad(- 90) + s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50 * i)*1.0)) // INLINED!!
                    set y=(((s__TentenTensasai__Spell_target_y[this] )*1.0) + Sin((( Deg2Rad(- 90) + s__TentenTensasai__Spell_angle[this] )*1.0)) * (( 50 * i)*1.0)) // INLINED!!
                    set offset=GetRandomInt(0, 200)
                    set new_x=(((x )*1.0) + Cos((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( offset)*1.0)) // INLINED!!
                    set new_y=(((y )*1.0) + Sin((( Deg2Rad(GetRandomInt(0, 360)) )*1.0)) * (( offset)*1.0)) // INLINED!!
                    if s__TentenTensasai__Spell_count[this] <= 16 and ModuloInteger(s__TentenTensasai__Spell_count[this], 2) == 0 then
                        set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__TentenTensasai__Spell_caster[this]), 'h0AC', new_x, new_y, 270)
                        call SetUnitFlyHeight(bj_lastCreatedUnit, 500, 0)
                        call SetUnitFlyHeight(bj_lastCreatedUnit, 0, 1000)
                        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.5)
                    endif
                    set bj_lastCreatedGroup=CreateGroup()
                    call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 300.0, null)
                    loop
                        set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                        exitwhen bj_lastCreatedUnit == null
                        call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                        if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__TentenTensasai__Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__TentenTensasai__Spell_damaged[this]) then
                            call UnitDamageTarget(s__TentenTensasai__Spell_caster[this], bj_lastCreatedUnit, 6666 / 16.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                            call GroupAddUnit(s__TentenTensasai__Spell_damaged[this], bj_lastCreatedUnit)
                        endif
                    endloop
                    call DestroyGroup(bj_lastCreatedGroup)

                set i=i + 1
            endloop
            set s__TentenTensasai__Spell_count[this]=s__TentenTensasai__Spell_count[this] + 1
            call GroupClear(s__TentenTensasai__Spell_damaged[this])
            if s__TentenTensasai__Spell_count[this] > 20 then
                set s__TentenTensasai__Spell_bomb[this]=CreateUnit(GetOwningPlayer(s__TentenTensasai__Spell_caster[this]), 'n01W', s__TentenTensasai__Spell_target_x[this], s__TentenTensasai__Spell_target_y[this], 270)
                call SetUnitScale(s__TentenTensasai__Spell_bomb[this], 6.0, 1.0, 1.0)
                call SetUnitFlyHeight(s__TentenTensasai__Spell_bomb[this], 500, 0)
