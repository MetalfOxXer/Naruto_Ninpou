        if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__ShisuiSusanooDrill_caster[s__ShisuiSusanooDrill_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
               call UnitDamageTarget(s__ShisuiSusanooDrill_caster[s__ShisuiSusanooDrill_instance], GetFilterUnit(), ( 5 * GetHeroAgi(s__ShisuiSusanooDrill_caster[s__ShisuiSusanooDrill_instance], true) ), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
        endif
