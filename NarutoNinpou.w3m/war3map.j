    function s__KankuroCrow_destroy takes integer this returns nothing
        set bj_lastCreatedUnit=GetDummy(GetOwningPlayer(s__KankuroCrow_crow[this]) , "Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl" , GetUnitX(s__KankuroCrow_crow[this]) , GetUnitY(s__KankuroCrow_crow[this]) , 270)
        call SetUnitScale(bj_lastCreatedUnit, 3.0, 3.0, 3.0)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
        if not s__KankuroCrow_isKarasu[this] and s__KankuroCrow_crow[this] != udg_KankuroKarasu then
            call KillUnit(s__KankuroCrow_crow[this])
            call ShowUnit(s__KankuroCrow_crow[this], false)
