	set udg_locations03[55]=GetUnitLoc(GetTriggerUnit())
	call CreateNUnitsAtLoc(1, 'u000', GetOwningPlayer(GetTriggerUnit()), udg_locations03[55], GetUnitFacing(GetTriggerUnit()))
	call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 255)
