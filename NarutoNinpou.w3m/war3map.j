            elseif udg_Streak[GetPlayerId(pk) + 1] == 5 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(pk) + 1] + GetUnitName(udg_units33[GetPlayerId(pk) + 1]) + "|r just got a |cffff0000penta kill|r!!")
                endif
                set udg_Bounty[GetPlayerId(pk) + 1]=udg_Bounty[GetPlayerId(pk) + 1] + 4
            elseif udg_Streak[GetPlayerId(pk) + 1] == 6 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(pk) + 1] + GetUnitName(udg_units33[GetPlayerId(pk) + 1]) + "|r just got a |cffff0000hexa kill|r!!")
                endif
                set udg_Bounty[GetPlayerId(pk) + 1]=udg_Bounty[GetPlayerId(pk) + 1] + 5
            elseif udg_Bounty[GetPlayerId(pk) + 1] >= 7 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, udg_strings02[GetPlayerId(pk) + 1] + GetUnitName(udg_units33[GetPlayerId(pk) + 1]) + "|r is |cffff0000DOMINATING|r (x|r" + I2S(udg_BountyKills[GetPlayerId(pk) + 1]) + ")!!!")
                endif
                set udg_Bounty[GetPlayerId(pk) + 1]=udg_Bounty[GetPlayerId(pk) + 1] + 2
            endif
            if assis1 != - 1 and assis2 != - 1 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( ( ( ( "Assisted by " + udg_strings02[assis1 + 1] + GetUnitName(udg_units33[assis1 + 1]) + ( "|r and " + ( udg_strings02[assis2 + 1] + GetUnitName(udg_units33[assis2 + 1]) + ( "|r! " ) ) ) ) ) ) ))
                endif
                if ( GetUnitTypeId(udg_units33[assis1 + 1]) == 'H06Z' or GetUnitTypeId(udg_units33[assis2 + 1]) == 'H06Z' ) then
                    set s__HanabiD_hanabi_kills=s__HanabiD_hanabi_kills + 5
                endif
                if ( GetUnitTypeId(udg_units33[assis1 + 1]) == 'N02G' or GetUnitTypeId(udg_units33[assis2 + 1]) == 'N02G' ) then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                    if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                        set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                    endif
                endif
                set udg_assists[assis1 + 1]=udg_assists[assis1 + 1] + 1
                set udg_integers11[assis1 + 1]=udg_integers11[assis1 + 1] + 2
                set udg_assists[assis2 + 1]=udg_assists[assis2 + 1] + 1
                set udg_integers11[assis2 + 1]=udg_integers11[assis2 + 1] + 2

                // UI
                call s__HeroUIMessage_start(udg_units33[GetPlayerId(pk) + 1] , udg_units33[GetPlayerId(pd) + 1] , udg_units33[assis1 + 1] , udg_units33[assis2 + 1])

                //call HeroIcon.create(GetTriggerUnit(), AHSS_Configurations.PLAYER_ICONS[assis2], 0.245, 0.5, 0.025, 3)
                //call HeroIcon.create(GetTriggerUnit(), AHSS_Configurations.PLAYER_ICONS[assis1], 0.27, 0.5, 0.025, 2)
                //call HeroIcon.create(GetTriggerUnit(), AHSS_Configurations.PLAYER_ICONS[GetPlayerId(pk)], 0.32, 0.5, 0.05, 0)
                //call HeroMessage.create(GetTriggerUnit(), "DeathMessageKilled.blp", 0.4, 0.5)
                //call HeroIcon.create(GetTriggerUnit(), AHSS_Configurations.PLAYER_ICONS[GetPlayerId(pd)], 0.48, 0.5, 0.05, 1)
            elseif assis1 != - 1 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Assisted by " + udg_strings02[assis1 + 1] + GetUnitName(udg_units33[assis1 + 1]) + "|r|cff1ce6b9|r! ")
                endif
                set udg_assists[assis1 + 1]=udg_assists[assis1 + 1] + 1
                set udg_integers11[assis1 + 1]=udg_integers11[assis1 + 1] + 2
                if ( GetUnitTypeId(udg_units33[assis1 + 1]) == 'H06Z' ) then
                    set s__HanabiD_hanabi_kills=s__HanabiD_hanabi_kills + 5
                endif

                if ( GetUnitTypeId(udg_units33[assis1 + 1]) == 'N02G' ) then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                    if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                        set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                    endif
                endif
                // UI
                call s__HeroUIMessage_start(GetKillingUnit() , GetTriggerUnit() , udg_units33[assis1 + 1] , null)
            elseif assis2 != - 1 then
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Assisted by " + udg_strings02[assis2 + 1] + GetUnitName(udg_units33[assis2 + 1]) + "|r|cff1ce6b9|r! ")
                endif
                set udg_assists[assis2 + 1]=udg_assists[assis2 + 1] + 1
                set udg_integers11[assis2 + 1]=udg_integers11[assis2 + 1] + 2
                if ( GetUnitTypeId(udg_units33[assis2 + 1]) == 'H06Z' ) then
                    set s__HanabiD_hanabi_kills=s__HanabiD_hanabi_kills + 5
                endif
                if ( GetUnitTypeId(udg_units33[assis2 + 1]) == 'N02G' ) then
                    set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoCurrentCharges + 1
                    if s__HagoromoD_HagoromoCurrentCharges > s__HagoromoD_HagoromoMaxCharges then
                        set s__HagoromoD_HagoromoCurrentCharges=s__HagoromoD_HagoromoMaxCharges
                    endif
                endif

                // UI
                call s__HeroUIMessage_start(GetKillingUnit() , GetTriggerUnit() , udg_units33[assis2 + 1] , null)
            else
                // UI
                call s__HeroUIMessage_start(GetKillingUnit() , GetTriggerUnit() , null , null)
            endif
            //call UpdateMultiboard()
            //call ForForce(GetPlayersMatching(Condition(function Trig_HeroDeath_Func007Func004001001)),function Trig_HeroDeath_Func007Func004A)
        endif
    else
        if ( ( ( ( GetKillingUnit() == GetTriggerUnit() ) ) or ( ( GetKillingUnit() == null ) ) ) ) then
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( ( ( ( "|cff1ce6b9" + udg_strings02[GetPlayerId(pd) + 1] + GetUnitName(GetTriggerUnit()) ) + "|r have commited suicide! |r" ) ) ))
            endif
            //call AdjustPlayerStateBJ(-1, pk, PLAYER_STATE_RESOURCE_LUMBER)
        else
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( ( ( ( "|cff1ce6b9" + udg_strings02[GetPlayerId(pd) + 1] + GetUnitName(GetTriggerUnit()) ) + "|r was killed by an ally! |r" ) ) ))
            endif
        endif
    endif
    if UnitAddAbility(GetTriggerUnit(), 'A069') then
        call UnitRemoveAbility(GetTriggerUnit(), 'A069')
    endif
    if udg_BattleRoyal then
        if udg_FFA then
            if udg_integers13[GetPlayerId(pk) + 1] >= udg_Survival_Limit then
                set i=0
                loop
                    exitwhen i > 11
                    if i != GetPlayerId(pk) then
                        call TimedDefeat(Player(i))
                    endif
                    set i=i + 1
                endloop
                call TimedVictory(pk)
            endif
        else
            set i=0
            set sum=0
            loop
                exitwhen i > 11
                if IsPlayerAlly(Player(i), pk) then
                    set sum=sum + udg_integers13[i + 1]
                endif
                set i=i + 1
            endloop
            if sum >= udg_Survival_Limit then
                set i=0
                loop
                    exitwhen i > 11
                    if IsPlayerAlly(Player(i), pk) then
                        call TimedVictory(Player(i))
                    else
                        call TimedDefeat(Player(i))
                    endif
                    set i=i + 1
                endloop
            endif
        endif
    endif
    call SetUnitFlyHeight(GetTriggerUnit(), 0.00, 0.00)
    call TriggerSleepAction(3.00)
    if IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(7)) then
        call SetUnitX(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainOtogakure))
        call SetUnitY(GetTriggerUnit(), GetRectCenterY(gg_rct_FountainOtogakure))
    elseif IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(3)) then
        call SetUnitX(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainKonohagakure))
        call SetUnitY(GetTriggerUnit(), GetRectCenterY(gg_rct_FountainKonohagakure))
    else
        call SetUnitX(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainAkatsuki))
        call SetUnitY(GetTriggerUnit(), GetRectCenterY(gg_rct_FountainAkatsuki))
    endif
    if udg_TeamDuelOn then
        call ForceRemovePlayer(udg_TeamDuelPlayers, GetTriggerPlayer())
        call Trig_HeroDeath_CheckIfTeamDuelIsOver()
    endif


    

if udg_BattleRoyal then
    set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=10
elseif udg_ZombieCombo and ( GetUnitTypeId(GetTriggerUnit()) == 'U004' or GetUnitTypeId(GetTriggerUnit()) == 'U009' ) then
    set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=20
else
    // S rank and Item
    if udg_SRankComplete[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] == 1 and (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I00M'))) then // INLINED!!
        set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=25
        // Item
    elseif (UnitHasItemOfTypeBJ((GetTriggerUnit() ), ( 'I00M'))) then // INLINED!!
        if ( 10 + udg_Minutes ) - 15 <= 0 then
            set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=20
        else
            set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=IMinBJ(( 10 + udg_Minutes ) - 15, 30 - 10)
        endif
        // S Rank
    elseif udg_SRankComplete[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] == 1 then
        set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=25
        // Ichigo
    elseif ( GetUnitTypeId(GetTriggerUnit()) == 'U00A' or GetUnitTypeId(GetTriggerUnit()) == 'U00G' or GetUnitTypeId(GetTriggerUnit()) == 'H0A7' ) and udg_integers14[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] >= 10 then
        set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=IMinBJ(( 10 + udg_Minutes ) * 2 / 3, 30)
        set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] + reviveBonus
        // Normal
    else
        if udg_Bounty[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] < 0 then
            set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=IMinBJ(10 + udg_Minutes, 30)
        else
            set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=IMinBJ(10 + udg_Minutes, 30)
        endif
        set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] + reviveBonus
    endif
endif

set udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1] - 3

if IsPlayerAlly(GetTriggerPlayer(), Player(3)) and ( GetTeamPoints(3) >= GetTeamPoints(7) and GetTeamPoints(3) >= GetTeamPoints(11) ) and udg_SRankComplete[GetPlayerId(GetTriggerPlayer()) + 1] == 1 then
    set udg_SRankComplete[GetPlayerId(Player(0)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(1)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(2)) + 1]=0
elseif IsPlayerAlly(GetTriggerPlayer(), Player(7)) and ( GetTeamPoints(7) >= GetTeamPoints(3) and GetTeamPoints(7) >= GetTeamPoints(11) ) and udg_SRankComplete[GetPlayerId(GetTriggerPlayer()) + 1] == 1 then
    set udg_SRankComplete[GetPlayerId(Player(4)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(5)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(6)) + 1]=0
elseif IsPlayerAlly(GetTriggerPlayer(), Player(11)) and ( GetTeamPoints(11) >= GetTeamPoints(3) and GetTeamPoints(11) >= GetTeamPoints(7) ) and udg_SRankComplete[GetPlayerId(GetTriggerPlayer()) + 1] == 1 then
    set udg_SRankComplete[GetPlayerId(Player(8)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(9)) + 1]=0
    set udg_SRankComplete[GetPlayerId(Player(10)) + 1]=0
endif

call TriggerSleepAction(udg_integersrevivetimer[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1])

//call DestroyTimerDialog(udg_timerdialogs01[(1+GetPlayerId(GetTriggerPlayer()))])
if GetTriggerUnit() != null then
    if udg_BattleRoyal then
        call ReviveHero(GetTriggerUnit(), GetRectCenterX(gg_rct_ArenaInvulArea), GetRectCenterY(gg_rct_ArenaInvulArea), false)
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, 999999.0)
        call PlaySoundBJ(udg_sound03)
        call StopSoundBJ(udg_sound03, true)
    else
        if IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(7)) then
            call ReviveHero(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainOtogakure), GetRectCenterY(gg_rct_FountainOtogakure), false)
            if RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) then
            else
                call PanCameraToTimedForPlayer(GetOwningPlayer(GetTriggerUnit()), GetRectCenterX(gg_rct_FountainOtogakure), GetRectCenterY(gg_rct_FountainOtogakure), 0.20)
            endif
            call PlaySoundBJ(udg_sound03)
            set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'zhyd' ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLifeBJ(0.5, 'BTLF', bj_lastCreatedUnit)
            call StopSoundBJ(udg_sound03, true)
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( udg_strings02[GetPlayerId(pd) + 1] + GetUnitName(GetTriggerUnit()) + "|r was revived for Otogakure." ))
            endif
        elseif IsPlayerAlly(GetOwningPlayer(GetTriggerUnit()), Player(3)) then
            call ReviveHero(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainKonohagakure), GetRectCenterY(gg_rct_FountainKonohagakure), false)
            if RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) then
            else
                call PanCameraToTimedForPlayer(GetOwningPlayer(GetTriggerUnit()), GetRectCenterX(gg_rct_FountainKonohagakure), GetRectCenterY(gg_rct_FountainKonohagakure), 0.20)
            endif
            call PlaySoundBJ(udg_sound03)
            set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'zhyd' ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLifeBJ(0.5, 'BTLF', bj_lastCreatedUnit)
            call StopSoundBJ(udg_sound03, true)
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( udg_strings02[GetPlayerId(pd) + 1] + GetUnitName(GetTriggerUnit()) + "|r was revived for Shinobi Alliance." ))
            endif
        else
            call ReviveHero(GetTriggerUnit(), GetRectCenterX(gg_rct_FountainAkatsuki), GetRectCenterY(gg_rct_FountainAkatsuki), false)
            if RectContainsUnit(gg_rct_DuelArena2, GetTriggerUnit()) then
            else
                call PanCameraToTimedForPlayer(GetOwningPlayer(GetTriggerUnit()), GetRectCenterX(gg_rct_FountainAkatsuki), GetRectCenterY(gg_rct_FountainAkatsuki), 0.20)
            endif
            call PlaySoundBJ(udg_sound03)
            set bj_lastCreatedUnit=(CreateUnit((GetTriggerPlayer() ), ( 'zhyd' ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()) )*1.0), (( 270)*1.0))) // INLINED!!
            call UnitApplyTimedLifeBJ(0.5, 'BTLF', bj_lastCreatedUnit)
            call StopSoundBJ(udg_sound03, true)
            if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, ( udg_strings02[GetPlayerId(pd) + 1] + GetUnitName(GetTriggerUnit()) + "|r was revived for Akatsuki." ))
            endif
        endif
    endif
    if ( GetUnitTypeId(GetTriggerUnit()) == 'N011' or GetUnitTypeId(GetTriggerUnit()) == 'N01J' ) and GetUnitAbilityLevel(GetTriggerUnit(), 'A0NS') < 1 and GetHeroLevel(GetTriggerUnit()) >= 38 then
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HE', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HM', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0CX', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0HO', true)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), 'A0P3', true)
    endif
    set udg_units33[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1]=GetTriggerUnit()
    call ShowUnit(GetTriggerUnit(), true)
    call PauseUnit(GetTriggerUnit(), false)
    call SetUnitVertexColor((GetTriggerUnit() ), ( 255 ), ( 255 ), ( 255 ), ( 255)) // INLINED!!
    call SetUnitInvulnerable(GetTriggerUnit(), false)
    call UnitRemoveAbility(GetTriggerUnit(), 'Avul')
    call UnitRemoveAbility(GetTriggerUnit(), 'B02P')
    call SetUnitManaPercentBJ(GetTriggerUnit(), 100.0)
    call SetUnitTimeScale(GetTriggerUnit(), 1.0)
    call SetUnitFlyHeight(GetTriggerUnit(), 0.00, 0.00)
    if udg_HeroWindow[GetUnitPointValue(GetTriggerUnit())] > 0 then
        call SetUnitPropWindow(GetTriggerUnit(), udg_HeroWindow[GetUnitPointValue(GetTriggerUnit())])
    endif
    if udg_TeamDuelOn and not IsPlayerInForce(GetTriggerPlayer(), udg_TeamDuelPlayers) then
        call PauseUnit(udg_units33[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1], true)
        call SetUnitInvulnerable(udg_units33[GetPlayerId(GetOwningPlayer(GetTriggerUnit())) + 1], true)
    endif
endif
endfunction

//===========================================================================
function InitTrig_HeroDeath takes nothing returns nothing
    set gg_trg_HeroDeath=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_HeroDeath, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gg_trg_HeroDeath, Condition(function Trig_HeroDeath_Conditions))
    call TriggerAddAction(gg_trg_HeroDeath, function Trig_HeroDeath_Actions)
endfunction

//===========================================================================
// Trigger: HeroSpellText
//===========================================================================
function Trig_Spelling_Actions_Conditions takes nothing returns boolean
    return GetSpellAbilityId() != 'A08L' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true
endfunction

function Trig_Spelling_Actions_Actions takes nothing returns nothing
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
		if not (GetSpellAbilityId() != 'A08L' and IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true) or GetAbilityName(GetSpellAbilityId()) == "Default string" or GetAbilityName(GetSpellAbilityId()) == "" or GetSpellAbilityId() == 'A04O' or GetSpellAbilityId() == 'A05K' or GetSpellAbilityId() == 'A0RZ' or GetSpellAbilityId() == 'A0YW' or GetSpellAbilityId() == 'A0ZE' or GetSpellAbilityId() == 'A13Y' or GetSpellAbilityId() == 'A0YV' or GetSpellAbilityId() == 'A0RX' or GetSpellAbilityId() == 'A0GP' or GetSpellAbilityId() == 'A0CO' or GetSpellAbilityId() == 'A0UA' or GetSpellAbilityId() == 'A0SA' or GetSpellAbilityId() == 'A0QA' then // INLINED!!
			return
		endif
		if GetSpellAbilityId() == 'A0JZ' then
			if s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 1 then // INLINED!!
				call CreateTextTagUnitBJ("First Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 2 then // INLINED!!
				call CreateTextTagUnitBJ("Second Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 3 then // INLINED!!
				call CreateTextTagUnitBJ("Third Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 4 then // INLINED!!
				call CreateTextTagUnitBJ("Fourth Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 5 then // INLINED!!
				call CreateTextTagUnitBJ("Fifth Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 6 then // INLINED!!
				call CreateTextTagUnitBJ("Sixth Gate: Open!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 7 then // INLINED!!
				call CreateTextTagUnitBJ("Seventh Gate: Open!!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			elseif s__OPEN_GATE_COUNTER[(GetUnitUserData((GetTriggerUnit())))] == 8 then // INLINED!!
				call CreateTextTagUnitBJ("|cffff0000Eighth Gate: Open!!!|r", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			else
				call CreateTextTagUnitBJ("SHIMON: KAI!!!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
			endif
		elseif GetSpellAbilityId() == 'A0GM' and GetUnitAbilityLevel(GetTriggerUnit(), 'B02E') > 0 then
			call CreateTextTagUnitBJ("|cffff0000Heddo Batto|r!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A0GR' and GetUnitAbilityLevel(GetTriggerUnit(), 'B02E') > 0 then
			call CreateTextTagUnitBJ("|cffff0000Lariat|r!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A0LJ' and GetUnitTypeId(GetTriggerUnit()) != 'U00H' then
			//call CreateTextTagUnitBJ( "Black Chidori!" , GetTriggerUnit(), 0, 10, 100, 100, 100, 0 )
		elseif GetSpellAbilityId() == 'A087' and GetUnitTypeId(GetTriggerUnit()) == 'H01N' then
			call CreateTextTagUnitBJ("Fox Claws!!!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A097' and udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 1 then // INLINED!!
			call CreateTextTagUnitBJ("Launch missle!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A045' and udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 1 then // INLINED!!
			call CreateTextTagUnitBJ("Cluster of missles!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A097' and udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 2 then // INLINED!!
			call CreateTextTagUnitBJ("Kuchiyose: Rhino!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A045' and udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 2 then // INLINED!!
			call CreateTextTagUnitBJ("Kuchiyose no Jutsu!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
		elseif GetSpellAbilityId() == 'A097' and udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 3 then // INLINED!!
			call CreateTextTagUnitBJ("Absorb soul!", GetTriggerUnit(), 0, 10, 100, 100, 100, 0)
