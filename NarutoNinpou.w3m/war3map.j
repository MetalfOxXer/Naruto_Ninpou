// Trigger: MitsukiDash
//===========================================================================

//Implemented from module Alloc:
    
        function s__DragonFlash_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__DragonFlash_Alloc___recycle[(0)] == 0 ) then
                set s__DragonFlash_Alloc___instanceCount=s__DragonFlash_Alloc___instanceCount + 1
                set this=s__DragonFlash_Alloc___instanceCount
            else
                set this=s__DragonFlash_Alloc___recycle[(0)]
                set s__DragonFlash_Alloc___recycle[(0)]=s__DragonFlash_Alloc___recycle[s__DragonFlash_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__DragonFlash_deallocate takes integer this returns nothing
            set s__DragonFlash_Alloc___recycle[this]=s__DragonFlash_Alloc___recycle[(0)]
            set s__DragonFlash_Alloc___recycle[(0)]=this
        endfunction

    function s__DragonFlash_actions takes nothing returns nothing
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        local real target_x= GetSpellTargetX()
        local real target_y= GetSpellTargetY()
        local real angle= Atan3(x , y , target_x , target_y)
        local real dist= GetDistance(x , y , target_x , target_y)
        local real new_x
        local real new_y
        local integer i= 0
        local group damaged= CreateGroup()

		set bj_lastCreatedEffect=AddSpecialEffect("DustWaveDash.mdx", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
		call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetPointZ(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit())))
		call DestroyEffect(bj_lastCreatedEffect)

        loop
            exitwhen i > R2I(dist / 30.0)
            set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( ( i + 1 ) * 30)*1.0)) // INLINED!!
            set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( ( i + 1 ) * 30)*1.0)) // INLINED!!
            call SetUnitX(GetTriggerUnit(), new_x)
            call SetUnitY(GetTriggerUnit(), new_y)
            //set bj_lastCreatedUnit = CreateUnit(GetTriggerPlayer(), 'h063', new_x, new_y, Rad2Deg(angle)) 
            call SetUnitX(bj_lastCreatedUnit, new_x)
            call SetUnitY(bj_lastCreatedUnit, new_y)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.15)
            call SetUnitTimeScale(bj_lastCreatedUnit, 0.4)
            call SetUnitAnimation(bj_lastCreatedUnit, "spell throw")
            call SetUnitVertexColor((bj_lastCreatedUnit ), ( 255 ), ( 255 ), ( 255 ), ( 50)) // INLINED!!
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, damaged) then
                    //call AddSpecialEffectEx("Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodKnight.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit)) 
                    call UnitDamageTarget(GetTriggerUnit(), bj_lastCreatedUnit, 10 * GetHeroInt(GetTriggerUnit(), true), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    call GroupAddUnit(damaged, bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=i + 1
        endloop
        call DestroyGroup(damaged)
        set damaged=null
    endfunction
    
    function s__DragonFlash_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(91 , s__DragonFlash_SPELL_ID , function s__DragonFlash_actions)
    endfunction
    
