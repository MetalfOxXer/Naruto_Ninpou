            set TayuyaTAbility__projectileIndex=0
            set TayuyaTAbility__projectileIndex2=0
                
            set TayuyaTAbility__dummySoulsTayuya=CreateUnit(GetOwningPlayer(s__TayuyaT_caster[this]), 'h04L', GetUnitX(s__TayuyaT_caster[this]), GetUnitY(s__TayuyaT_caster[this]), 0)
            set TayuyaTAbility__dummySoulsDoki=CreateUnit(GetOwningPlayer(s__TayuyaT_caster[this]), 'h04L', GetUnitX(s__TayuyaT_puppet[this]), GetUnitY(s__TayuyaT_puppet[this]), 0)
                                                          
            call TimerStart(NewTimerEx(this), 0.5, true, function s__TayuyaT_LaunchProjectile)
            call TimerStart(NewTimerEx(this), 0.5, true, function s__TayuyaT_LaunchProjectile2)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__TayuyaT_MoveDummy)
        endfunction

