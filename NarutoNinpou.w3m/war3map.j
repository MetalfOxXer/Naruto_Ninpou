    function s__InvisibilityShoes_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real x= (((s__InvisibilityShoes_previous_x[this] )*1.0) + Cos((( Deg2Rad(- 90) )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real y= (((s__InvisibilityShoes_previous_y[this] )*1.0) + Sin((( Deg2Rad(- 90) )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_x= (((s__InvisibilityShoes_previous_x[this] )*1.0) + Cos((( Deg2Rad(90) )*1.0)) * (( 40)*1.0)) // INLINED!!
  local real new_y= (((s__InvisibilityShoes_previous_y[this] )*1.0) + Sin((( Deg2Rad(90) )*1.0)) * (( 40)*1.0)) // INLINED!!
        if s__InvisibilityShoes_previous_x[this] != GetUnitX(s__InvisibilityShoes_caster[this]) or s__InvisibilityShoes_previous_y[this] != GetUnitY(s__InvisibilityShoes_caster[this]) then
			if ModuloInteger(s__InvisibilityShoes_count[this], 6) == 0 then
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", x, y)
				call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__InvisibilityShoes_caster[this])))
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
				set bj_lastCreatedEffect=AddSpecialEffect("war3mapImported\\FootprintNormal.MDX", new_x, new_y)
				call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, Deg2Rad(GetUnitFacing(s__InvisibilityShoes_caster[this])))
				call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
				call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
				set s__InvisibilityShoes_previous_x[this]=GetUnitX(s__InvisibilityShoes_caster[this])
				set s__InvisibilityShoes_previous_y[this]=GetUnitY(s__InvisibilityShoes_caster[this])
			endif
        endif
		set s__InvisibilityShoes_count[this]=s__InvisibilityShoes_count[this] + 1
        if s__InvisibilityShoes_count[this] > s__InvisibilityShoes_duration[this] or GetUnitAbilityLevel(s__InvisibilityShoes_caster[this], 'Binv') == 0 then
            call s__InvisibilityShoes_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

 function s__InvisibilityShoes_actions takes nothing returns nothing
  local integer this
  local unit u
		set bj_lastCreatedGroup=CreateGroup()
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()), 300, null)
		loop
			set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
			if IsUnitAlly(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
				set this=s__InvisibilityShoes_allocate()
				set u=CreateAbilityDummy(GetTriggerUnit() , 'A197')
				set s__InvisibilityShoes_duration[this]=100
				if GetSpellAbilityId() == 'A195' then
					call SetUnitAbilityLevel(u, 'A197', 2)
					set s__InvisibilityShoes_duration[this]=150
				elseif GetSpellAbilityId() == 'A196' then
					call SetUnitAbilityLevel(u, 'A197', 3)
					set s__InvisibilityShoes_duration[this]=200
				endif
				call IssueTargetOrder(u, "invisibility", bj_lastCreatedUnit)
                		set s__InvisibilityShoes_caster[this]=bj_lastCreatedUnit
						set s__InvisibilityShoes_count[this]=0
						set s__InvisibilityShoes_previous_x[this]=GetUnitX(s__InvisibilityShoes_caster[this])
						set s__InvisibilityShoes_previous_y[this]=GetUnitY(s__InvisibilityShoes_caster[this])
                		call TimerStart(NewTimerEx(this), 0.04, true, function s__InvisibilityShoes_periodic)
			endif
		endloop
		call DestroyGroup(bj_lastCreatedGroup)
 endfunction 

 function s__InvisibilityShoes_onInit takes nothing returns nothing
		call RegisterSpellEffectEvent2(('A194' ) , Filter(( function s__InvisibilityShoes_actions))) // INLINED!!
		call RegisterSpellEffectEvent2(('A195' ) , Filter(( function s__InvisibilityShoes_actions))) // INLINED!!
