     function s__NagatoChibakuTensei_destroy takes integer this returns nothing
		loop
			set bj_lastCreatedUnit=FirstOfGroup(s__NagatoChibakuTensei_nagato[this])
			exitwhen bj_lastCreatedUnit == null
			call GroupRemoveUnit(s__NagatoChibakuTensei_nagato[this], bj_lastCreatedUnit)
