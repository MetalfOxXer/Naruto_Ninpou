    function s__NagatoNarakaArea_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitApplyTimedLife(s__NagatoNarakaArea_king[this], 'BTLF', 1.0)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__NagatoNarakaArea_king[this]), GetUnitY(s__NagatoNarakaArea_king[this]), 300.0 + 120.0 * s__NagatoNarakaArea_channeling[this], null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__NagatoNarakaArea_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                //call UnitDamageTarget(this.caster, bj_lastCreatedUnit, 80.0 * GetUnitAbilityLevel(this.caster, SPELL_ID), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                //call AddSpecialEffectEx("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
            else
                call DestroyEffect(AddSpecialEffect(("war3mapImported\\Heal Green.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE) + 100 * GetUnitAbilityLevel(s__NagatoNarakaArea_caster[this], s__NagatoNarakaArea_SPELL_ID) * s__NagatoNarakaArea_channeling[this])
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        set s__NagatoNarakaArea_king[this]=null
        set s__NagatoNarakaArea_caster[this]=null
        call s__NagatoNarakaArea_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__NagatoNarakaArea_actions takes unit caster returns nothing
        local integer this
        local real x
        local real y
        set this=s__NagatoNarakaArea_allocate()
        set s__NagatoNarakaArea_caster[this]=caster
        set s__NagatoNarakaArea_channeling[this]=udg_ShinraChannelings[(GetUnitUserData((caster)))] // INLINED!!
        set x=(((GetUnitX(caster) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(caster) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
        set y=(((GetUnitY(caster) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(caster) + 180) )*1.0)) * (( 150.0)*1.0)) // INLINED!!
        set s__NagatoNarakaArea_king[this]=(CreateUnit((GetOwningPlayer(caster) ), ( 'h08Q' ), (( x )*1.0), (( y )*1.0), (( GetUnitFacing(caster))*1.0))) // INLINED!!
        call SetUnitAnimation(s__NagatoNarakaArea_king[this], "spell")
        call TimerStart(NewTimerEx(this), 0.5, false, function s__NagatoNarakaArea_delay)
	call SetUnitAnimation(GetTriggerUnit(), "spell two")
    endfunction
    
