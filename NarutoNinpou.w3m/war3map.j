// Trigger: Combination
//===========================================================================

    
 function s__Combination_dealDamage takes nothing returns boolean
		if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__Combination_caster[s__Combination_instance])) and IsUnitType(GetFilterUnit(), UNIT_TYPE_STRUCTURE) == false and GetWidgetLife(GetFilterUnit()) > 0.405 then
			call UnitDamageTarget(s__Combination_caster[s__Combination_instance], GetFilterUnit(), ( 300 + 4 * GetHeroStr(s__Combination_caster[s__Combination_instance], true) ) * GetUnitAbilityLevel(s__Combination_caster[s__Combination_instance], s__Combination_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
		endif
	    return false
 endfunction

    function s__Combination_destroy takes integer this returns nothing
        set s__Combination_caster[this]=null
        set s__Combination_target[this]=null
        set s__Combination_kinkaku[this]=null
        set s__Combination_ginkaku[this]=null
        call s__Combination_deallocate(this)
    endfunction


 function s__Combination_secondDamage takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call UnitDamageTarget(s__Combination_caster[this], s__Combination_target[this], 500 * GetUnitAbilityLevel(s__Combination_caster[this], s__Combination_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
		call StunUnitTimed(s__Combination_caster[this] , s__Combination_target[this] , 1.5)
		call s__Combination_destroy(this)
		call ReleaseTimer(GetExpiredTimer())
    endfunction 


    function s__Combination_secondPeriodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__Combination_target[this])
        local real y= GetUnitY(s__Combination_target[this])
        call SetUnitX(s__Combination_caster[this], x)
        call SetUnitY(s__Combination_caster[this], y)
	    if GetUnitTypeId(s__Combination_caster[this]) == 'H05Q' then
		    call SetUnitAnimation(s__Combination_caster[this], "Attack")
		    call DestroyEffect(AddSpecialEffect(("FireSlash.mdl" ), (( GetUnitX(s__Combination_target[this]) )*1.0), (( GetUnitY(s__Combination_target[this]))*1.0))) // INLINED!!
		    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
	    else
		    call SetUnitAnimation(s__Combination_caster[this], "Attack")
		    call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_luolei.mdl" ), (( GetUnitX(s__Combination_target[this]) )*1.0), (( GetUnitY(s__Combination_target[this]))*1.0))) // INLINED!!
	    endif
        call TimerStart(NewTimerEx(this), 0.03, false, function s__Combination_secondDamage)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 


 function s__Combination_damage takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
		if GetUnitTypeId(s__Combination_caster[this]) == 'H05Q' then
			call SetUnitFacing(s__Combination_kinkaku[this], GetUnitFacing(s__Combination_target[this]))
			call DestroyEffect(AddSpecialEffect(("by_wood_effect_yubanmeiqin_lightning_luolei.mdl" ), (( GetUnitX(s__Combination_target[this]) )*1.0), (( GetUnitY(s__Combination_target[this]))*1.0))) // INLINED!!
		else
			call SetUnitFacing(s__Combination_ginkaku[this], GetUnitFacing(s__Combination_target[this]))
			call DestroyEffect(AddSpecialEffect(("FireSlash.mdl" ), (( GetUnitX(s__Combination_target[this]) )*1.0), (( GetUnitY(s__Combination_target[this]))*1.0))) // INLINED!!
		        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 3.0)
		endif
		set bj_lastCreatedGroup=CreateGroup()
		set s__Combination_instance=this
		call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__Combination_target[this]), GetUnitY(s__Combination_target[this]), 200, Filter(function s__Combination_dealDamage))
		call DestroyGroup(bj_lastCreatedGroup)
        call KillUnit(s__Combination_ginkaku[this])
		call ShowUnit(s__Combination_ginkaku[this], false)
        call KillUnit(s__Combination_kinkaku[this])
		call ShowUnit(s__Combination_kinkaku[this], false)
        call TimerStart(NewTimerEx(this), 0.5, false, function s__Combination_secondPeriodic)
		call ReleaseTimer(GetExpiredTimer())
 endfunction 
	
    function s__Combination_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__Combination_dummy[this])
        local real y= GetUnitY(s__Combination_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__Combination_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__Combination_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local unit u= null
        set s__Combination_count[this]=s__Combination_count[this] + 1
        call SetUnitX(s__Combination_dummy[this], new_x)
        call SetUnitY(s__Combination_dummy[this], new_y)
	    if GetUnitTypeId(s__Combination_caster[this]) == 'H05Q' then
        	call SetUnitX(s__Combination_kinkaku[this], new_x)
        	call SetUnitY(s__Combination_kinkaku[this], new_y)
		    call SetUnitAnimationByIndex(s__Combination_kinkaku[this], 4)
	    else
        	call SetUnitX(s__Combination_ginkaku[this], new_x)
        	call SetUnitY(s__Combination_ginkaku[this], new_y)
		    call SetUnitAnimationByIndex(s__Combination_ginkaku[this], 1)
	    endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__Combination_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                set s__Combination_target[this]=bj_lastCreatedUnit
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    set u=bj_lastCreatedUnit
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
            set s__Combination_target[this]=u
	    if GetUnitTypeId(s__Combination_caster[this]) == 'H05Q' then
		    call SetUnitAnimation(s__Combination_kinkaku[this], "Spell")
	    else
		    call SetUnitAnimation(s__Combination_ginkaku[this], "Spell two")
	    endif
            call TimerStart(NewTimerEx(this), 1.0, false, function s__Combination_damage)
            call ReleaseTimer(GetExpiredTimer())
        elseif s__Combination_count[this] > 23 then
            if s__Combination_target[this] != null then
            	call KillUnit(s__Combination_ginkaku[this])
		        call ShowUnit(s__Combination_ginkaku[this], false)
        	    call KillUnit(s__Combination_kinkaku[this])
		        call ShowUnit(s__Combination_kinkaku[this], false)
                call s__Combination_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            else
            	call KillUnit(s__Combination_ginkaku[this])
		        call ShowUnit(s__Combination_ginkaku[this], false)
        	    call KillUnit(s__Combination_kinkaku[this])
		        call ShowUnit(s__Combination_kinkaku[this], false)
                call s__Combination_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction
    
    function s__Combination_actions takes nothing returns nothing
        local integer this= s__Combination__allocate()
        set s__Combination_caster[this]=GetTriggerUnit()
        set s__Combination_target_x[this]=GetSpellTargetX()
        set s__Combination_target_y[this]=GetSpellTargetY()
        set s__Combination_target[this]=null
        set s__Combination_angle[this]=Atan3(GetUnitX(s__Combination_caster[this]) , GetUnitY(s__Combination_caster[this]) , s__Combination_target_x[this] , s__Combination_target_y[this])
        set s__Combination_count[this]=0
	    set s__Combination_dummy[this]=CreateUnit(GetTriggerPlayer(), 'e007', GetUnitX(s__Combination_caster[this]), GetUnitY(s__Combination_caster[this]), 270)
	    if GetUnitTypeId(s__Combination_caster[this]) == 'H05Q' then
        	set s__Combination_kinkaku[this]=CreateUnit(GetTriggerPlayer(), 'h05U', GetUnitX(s__Combination_caster[this]), GetUnitY(s__Combination_caster[this]), GetUnitFacing(s__Combination_caster[this]))
		    call AddSpecialEffectTarget("by_wood_effect_yubanmeiqin_lightning_dianjishanghai.mdl", s__Combination_kinkaku[this], "right hand")
		    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 4.0)
	    else
		    set s__Combination_ginkaku[this]=CreateUnit(GetTriggerPlayer(), 'h07P', GetUnitX(s__Combination_caster[this]), GetUnitY(s__Combination_caster[this]), GetUnitFacing(s__Combination_caster[this]))
		    call AddSpecialEffectTarget("fireball.mdl", s__Combination_ginkaku[this], "left hand")
		    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.0)
	    endif
	    call SetUnitX(s__Combination_dummy[this], GetUnitX(s__Combination_caster[this]))
        call SetUnitY(s__Combination_dummy[this], GetUnitY(s__Combination_caster[this]))
        //call SetUnitAnimation(this.caster, "Spell")
        set s__Combination_target[this]=null
        call TimerStartEx(NewTimerEx(this) , 0.03 , true , function s__Combination_periodic , "Combination_periodic")
    endfunction
    
    function s__Combination_onInit takes nothing returns nothing
        call RegisterSpellEffectEvent2((s__Combination_SPELL_ID ) , Filter(( function s__Combination_actions))) // INLINED!!
    endfunction
    
//===========================================================================
// Trigger: UltimateRoar
//===========================================================================
// scope UltimateRoar begins

    
    
//Implemented from module Alloc:
    
        function s__UltimateRoar__Spell_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__UltimateRoar__Spell_Alloc___recycle[(0)] == 0 ) then
                set s__UltimateRoar__Spell_Alloc___instanceCount=s__UltimateRoar__Spell_Alloc___instanceCount + 1
                set this=s__UltimateRoar__Spell_Alloc___instanceCount
            else
                set this=s__UltimateRoar__Spell_Alloc___recycle[(0)]
                set s__UltimateRoar__Spell_Alloc___recycle[(0)]=s__UltimateRoar__Spell_Alloc___recycle[s__UltimateRoar__Spell_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__UltimateRoar__Spell_deallocate takes integer this returns nothing
            set s__UltimateRoar__Spell_Alloc___recycle[this]=s__UltimateRoar__Spell_Alloc___recycle[(0)]
            set s__UltimateRoar__Spell_Alloc___recycle[(0)]=this
        endfunction
        
        
        function s__UltimateRoar__Spell_destroy takes integer this returns nothing
            local integer i= 0
            loop
                set i=i + 1
                exitwhen i > 12
                call RecycleUnit(s__UltimateRoar__wave[(this)*(1)+i])
                set s__UltimateRoar__wave[(this)*(1)+i]= null
            endloop
	    call KillUnit(s__UltimateRoar__Spell_bijuu[this])
            call ShowUnit(s__UltimateRoar__Spell_bijuu[this], false)
	    call KillUnit(s__UltimateRoar__Spell_bijuu2[this])
            call ShowUnit(s__UltimateRoar__Spell_bijuu2[this], false)
	    //call PauseUnit(this.caster, false)
	    call ShowUnit(s__UltimateRoar__Spell_caster[this], true)
            call SelectUnitForPlayerSingle(s__UltimateRoar__Spell_caster[this], GetOwningPlayer(s__UltimateRoar__Spell_caster[this]))


            call DestroyGroup(s__UltimateRoar__Spell_damaged[this])
            set s__UltimateRoar__Spell_damaged[this]=null
            set s__UltimateRoar__Spell_caster[this]=null
            call s__UltimateRoar__Spell_deallocate(this)
        endfunction
        
        function s__UltimateRoar__Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real wave_x
            local real wave_y
            local real new_x
            local real new_y
     local real x
     local real y
            local integer i= 0
     local integer j
            local unit u
            set s__UltimateRoar__Spell_count[this]=s__UltimateRoar__Spell_count[this] + 1
            set j=0
            loop
                set j=j + 1
                exitwhen j > 6
                set x=(((GetUnitX(s__UltimateRoar__Spell_bijuu[this]) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
                set y=(((GetUnitY(s__UltimateRoar__Spell_bijuu[this]) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 60 * ( j + 1 ))*1.0)) // INLINED!!
		call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
		call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 255, 0, 0)
		call DestroyEffect(bj_lastCreatedEffect)
            endloop
            loop
                set i=i + 1
                exitwhen i > 12
                set wave_x=GetUnitX(s__UltimateRoar__wave[(this)*(1)+i])
                set wave_y=GetUnitY(s__UltimateRoar__wave[(this)*(1)+i])
                set new_x=wave_x + Cos(Deg2Rad(GetUnitFacing(s__UltimateRoar__wave[(this)*(1)+i]))) * 60
                set new_y=wave_y + Sin(Deg2Rad(GetUnitFacing(s__UltimateRoar__wave[(this)*(1)+i]))) * 60
                call SetUnitX(s__UltimateRoar__wave[(this)*(1)+i], new_x)
                call SetUnitY(s__UltimateRoar__wave[(this)*(1)+i], new_y)
                if ModuloInteger(s__UltimateRoar__Spell_count[this], 2) == 0 then
			//call AddSpecialEffectEx("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl", new_x, new_y)
                endif
                set bj_lastCreatedGroup=CreateGroup()
                call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 220.0, null)
                loop
                    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__UltimateRoar__Spell_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__UltimateRoar__Spell_damaged[this]) then
