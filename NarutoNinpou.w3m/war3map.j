        set s__KillerBeeSevenSwordsDance_damaged[this]=null
        set s__KillerBeeSevenSwordsDance_caster[this]=null
        call s__KillerBeeSevenSwordsDance_deallocate(this)
    endfunction
    
    function s__KillerBeeSevenSwordsDance_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local unit v
        call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) )*1.0), (( GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]))*1.0))) // INLINED!!
        if GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'B02E') == 0 and GetUnitTypeId(s__KillerBeeSevenSwordsDance_caster[this]) != 'H056' then
	    if s__KillerBeeSevenSwordsDance_count[this] == 0 then
	    	call SetUnitAnimationByIndex(s__KillerBeeSevenSwordsDance_caster[this], 15)
	    endif
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]), GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]), 220.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KillerBeeSevenSwordsDance_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and not IsUnitInGroup(bj_lastCreatedUnit, s__KillerBeeSevenSwordsDance_damaged[this]) then
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\wanhuajing.mdx" ), (( GetUnitX(bj_lastCreatedUnit) )*1.0), (( GetUnitY(bj_lastCreatedUnit))*1.0))) // INLINED!!
                    call UnitDamageTarget(s__KillerBeeSevenSwordsDance_caster[this], bj_lastCreatedUnit, 80.0 * GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], s__KillerBeeSevenSwordsDance_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                    call GroupAddUnit(s__KillerBeeSevenSwordsDance_damaged[this], bj_lastCreatedUnit)
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        else
	    if s__KillerBeeSevenSwordsDance_count[this] == 0 then
	    	call SetUnitAnimationByIndex(s__KillerBeeSevenSwordsDance_caster[this], 16)
	    endif
            //call AddSpecialEffectEx("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", GetUnitX(this.caster), GetUnitY(this.caster))
            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]), GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]), 300.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KillerBeeSevenSwordsDance_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                    set x=(((GetUnitX(bj_lastCreatedUnit) )*1.0) + Cos((( s__KillerBeeSevenSwordsDance_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
                    set y=(((GetUnitY(bj_lastCreatedUnit) )*1.0) + Sin((( s__KillerBeeSevenSwordsDance_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
                    if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                        call SetUnitX(bj_lastCreatedUnit, x)
                        call SetUnitY(bj_lastCreatedUnit, y)
                    endif
                    if not IsUnitInGroup(bj_lastCreatedUnit, s__KillerBeeSevenSwordsDance_damaged[this]) then
                        set bj_lastCreatedEffect=AddSpecialEffect("AnimationExplosion.mdx", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
			call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 40 + GetPointZ(GetUnitX(bj_lastCreatedUnit) , GetUnitY(bj_lastCreatedUnit)))
			call DestroyEffect(bj_lastCreatedEffect)
                        if GetUnitTypeId(s__KillerBeeSevenSwordsDance_caster[this]) == 'H056' then
				call UnitDamageTarget(s__KillerBeeSevenSwordsDance_caster[this], bj_lastCreatedUnit, 80.0 * GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], s__KillerBeeSevenSwordsDance_SPELL_ID) + ( 15 + 0.4 * GetHeroStr(s__KillerBeeSevenSwordsDance_caster[this], true) ) * GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'A0GN'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
			else
				call UnitDamageTarget(s__KillerBeeSevenSwordsDance_caster[this], bj_lastCreatedUnit, 80.0 * GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], s__KillerBeeSevenSwordsDance_SPELL_ID) + ( 15 + 0.4 * GetHeroStr(s__KillerBeeSevenSwordsDance_caster[this], true) ) * GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'B02E'), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                        endif
			call GroupAddUnit(s__KillerBeeSevenSwordsDance_damaged[this], bj_lastCreatedUnit)
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
        endif
        set x=(((GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) )*1.0) + Cos((( s__KillerBeeSevenSwordsDance_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        set y=(((GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]) )*1.0) + Sin((( s__KillerBeeSevenSwordsDance_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        set s__KillerBeeSevenSwordsDance_count[this]=s__KillerBeeSevenSwordsDance_count[this] + 1
        if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__KillerBeeSevenSwordsDance_caster[this], x)
            call SetUnitY(s__KillerBeeSevenSwordsDance_caster[this], y)
            if GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'B02E') == 0 and GetUnitTypeId(s__KillerBeeSevenSwordsDance_caster[this]) != 'H056' then
                if ModuloInteger(s__KillerBeeSevenSwordsDance_count[this], 2) == 0 then
                    set bj_lastCreatedUnit=GetDummy(GetOwningPlayer(s__KillerBeeSevenSwordsDance_caster[this]) , "Effects\\s_Hit_Blue.mdl" , GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) , GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]) , GetRandomReal(0, 360))
                    call RecycleUnitDelayed(bj_lastCreatedUnit , 0.2)
                endif
            else
                if ModuloInteger(s__KillerBeeSevenSwordsDance_count[this], 3) == 0 then
		    set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]), GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]))
		    call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.2)
		    call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
		    call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, s__KillerBeeSevenSwordsDance_angle[this])
		    call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 50 + GetPointZ(GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) , GetUnitY(s__KillerBeeSevenSwordsDance_caster[this])))
		    call DestroyEffect(bj_lastCreatedEffect)
                   // set bj_lastCreatedUnit = GetUnit(GetOwningPlayer(this.caster), 'u00V', GetUnitX(this.caster), GetUnitY(this.caster), Rad2Deg(this.angle))
                   // call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.2)
                endif
            endif
        endif
	//if GetUnitAbilityLevel(this.caster, 'B02E') == 0 then
        //    call SetUnitAnimationByIndex(this.caster, 15)
        //else
         //   call SetUnitAnimationByIndex(this.caster, 20)
        //endif
        if s__KillerBeeSevenSwordsDance_count[this] >= 30 then
            if GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'B02E') == 0 and GetUnitTypeId(s__KillerBeeSevenSwordsDance_caster[this]) != 'H056' then
                call UnitRemoveAbility(s__KillerBeeSevenSwordsDance_caster[this], 'A02Q')
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" ), (( GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) )*1.0), (( GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]))*1.0))) // INLINED!!
            endif
            call s__KillerBeeSevenSwordsDance_destroy(this)
	    call SetUnitTimeScale(s__KillerBeeSevenSwordsDance_caster[this], 1)
            call ReleaseTimer(GetExpiredTimer())
        endif
        set v=null
    endfunction
    
    function s__KillerBeeSevenSwordsDance_actions takes nothing returns nothing
        local integer this= s__KillerBeeSevenSwordsDance_allocate()
        set s__KillerBeeSevenSwordsDance_caster[this]=GetTriggerUnit()
        set s__KillerBeeSevenSwordsDance_damaged[this]=CreateGroup()
        set s__KillerBeeSevenSwordsDance_count[this]=0
        //call PauseUnit(this.caster, true)
	call SetUnitTimeScale(s__KillerBeeSevenSwordsDance_caster[this], 1)
        set s__KillerBeeSevenSwordsDance_angle[this]=Atan3(GetUnitX(s__KillerBeeSevenSwordsDance_caster[this]) , GetUnitY(s__KillerBeeSevenSwordsDance_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        if GetUnitAbilityLevel(s__KillerBeeSevenSwordsDance_caster[this], 'B02E') == 0 then
            call SetUnitAnimationByIndex(s__KillerBeeSevenSwordsDance_caster[this], 15)
            //call SetUnitTimeScale(this.caster, 0.5)
            call UnitAddAbility(GetTriggerUnit(), 'A02Q')
        else
            call SetUnitAnimationByIndex(s__KillerBeeSevenSwordsDance_caster[this], 16)
        endif
        call TimerStart(NewTimerEx(this), 0.03, true, function s__KillerBeeSevenSwordsDance_periodic)
    endfunction
    
    function s__KillerBeeSevenSwordsDance_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(42 , s__KillerBeeSevenSwordsDance_SPELL_ID , function s__KillerBeeSevenSwordsDance_actions)
    endfunction
    
