//===========================================================================
// Trigger: HiruzenCommandMoveSummon
//===========================================================================

function updateHiruzen takes nothing returns nothing
    local location tempLoc= Location(hiruzenMouseX, hiruzenMouseY)
    if GetUnitCurrentOrder(HiruzenCore_Hiruzen) == 0 and metaCtrlDownHiruzen and IsUnitAliveBJ(HiruzenCore_Enma) then
        call IssueImmediateOrder(HiruzenCore_Hiruzen, "stop")
    elseif GetUnitCurrentOrder(HiruzenCore_Hiruzen) == 851971 and metaCtrlDownHiruzen and IsUnitAliveBJ(HiruzenCore_Enma) then
        call IssuePointOrderLoc(HiruzenCore_Hiruzen, "move", tempLoc)
    endif
    call RemoveLocation(tempLoc)
    set tempLoc=null
    call DestroyTimer(GetExpiredTimer())
endfunction

function isRMBPressHiruzen takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(HiruzenCore_Hiruzen) and IsUnitAliveBJ(HiruzenCore_Enma) then
        set hiruzenMoveTimer=CreateTimer()
        if not metaCtrlDownHiruzen then
            set hiruzenMouseX=BlzGetTriggerPlayerMouseX()
            set hiruzenMouseY=BlzGetTriggerPlayerMouseY()
        endif
        call TimerStart(hiruzenMoveTimer, 0.01, true, function updateHiruzen)
        if metaCtrlDownHiruzen then
            return true
        endif
    endif
    return false
endfunction

function isRMBReleaseHiruzen takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(HiruzenCore_Hiruzen) and IsUnitAliveBJ(HiruzenCore_Enma) then
        set hiruzenMoveTimer=CreateTimer()
        call TimerStart(hiruzenMoveTimer, 0.01, true, function updateHiruzen)
        if metaCtrlDownHiruzen then
            return true
        endif
    endif
    return false
endfunction

function actionsHiruzen takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(HiruzenCore_Hiruzen) then
        call IssuePointOrderLocBJ(HiruzenCore_Enma, "move", BlzGetTriggerPlayerMousePosition())
    endif
endfunction

function pressCTRLHiruzen takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(HiruzenCore_Hiruzen) then
        set metaCtrlDownHiruzen=true
    endif
endfunction  

function releaseCTRLHiruzen takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(HiruzenCore_Hiruzen) then
        set metaCtrlDownHiruzen=false
    endif
endfunction

//===========================================================================
function InitTrig_HiruzenCommandMoveSummon takes nothing returns nothing
    local integer i= 0
    
    loop
    exitwhen ( i > 24 )
        call TriggerRegisterPlayerMouseEventBJ(rmbClickTriggerHiruzen, Player(i), bj_MOUSEEVENTTYPE_DOWN)
        call TriggerRegisterPlayerMouseEventBJ(rmbReleaseTriggerHiruzen, Player(i), bj_MOUSEEVENTTYPE_UP)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlDownHiruzenTriggerHiruzen, Player(i), OSKEY_LCONTROL, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlUpTriggerHiruzen, Player(i), OSKEY_LCONTROL, 0, false)
        set i=i + 1
    endloop
    
    call TriggerAddCondition(rmbClickTriggerHiruzen, Condition(function isRMBPressHiruzen))
    call TriggerAddCondition(rmbReleaseTriggerHiruzen, Condition(function isRMBReleaseHiruzen))
    call TriggerAddAction(rmbClickTriggerHiruzen, function actionsHiruzen)
    call TriggerAddAction(rmbReleaseTriggerHiruzen, function actionsHiruzen)
    call TriggerAddAction(metaCtrlDownHiruzenTriggerHiruzen, function pressCTRLHiruzen)
    call TriggerAddAction(metaCtrlUpTriggerHiruzen, function releaseCTRLHiruzen)
endfunction

