        local real x= (((GetUnitX(s__KankuroSalamander_salamander[this]) )*1.0) + Cos((( s__KankuroSalamander_angle[this] )*1.0)) * (( 100 + 50 * s__KankuroSalamander_count[this])*1.0)) // INLINED!!
