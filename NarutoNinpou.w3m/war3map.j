//===========================================================================
// Trigger: ObitoCommandMoveSummon
//===========================================================================

function updateObito takes nothing returns nothing
    local location tempLoc= Location(obitoMouseX, obitoMouseY)
    if GetUnitCurrentOrder(obito) == 0 and metaCtrlDownObito and IsUnitAliveBJ(obitoSummon) then
        call IssueImmediateOrder(obito, "stop")
    elseif GetUnitCurrentOrder(obito) == 851971 and metaCtrlDownObito and IsUnitAliveBJ(obitoSummon) then
        call IssuePointOrderLoc(obito, "move", tempLoc)
    endif
    call RemoveLocation(tempLoc)
    set tempLoc=null
    call DestroyTimer(GetExpiredTimer())
endfunction

function isRMBPressObito takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(obito) and IsUnitAliveBJ(obitoSummon) then
        set obitoMoveTimer=CreateTimer()
        if not metaCtrlDownObito then
            set obitoMouseX=BlzGetTriggerPlayerMouseX()
            set obitoMouseY=BlzGetTriggerPlayerMouseY()
        endif
        call TimerStart(obitoMoveTimer, 0.01, true, function updateObito)
        if metaCtrlDownObito then
            return true
        endif
    endif
    return false
endfunction

function isRMBReleaseObito takes nothing returns boolean
    local player p= GetTriggerPlayer()
    local integer pMouse= s__UserMouse__staticgetindex(p)
    
    if BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT and p == GetOwningPlayer(obito) and IsUnitAliveBJ(obitoSummon) then
        set obitoMoveTimer=CreateTimer()
        call TimerStart(obitoMoveTimer, 0.01, true, function updateObito)
        if metaCtrlDownObito then
            return true
        endif
    endif
    return false
endfunction

function actionsObito takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(obito) then
        call IssuePointOrderLocBJ(obitoSummon, "move", BlzGetTriggerPlayerMousePosition())
    endif
endfunction

function pressCTRLObito takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(obito) then
        set metaCtrlDownObito=true
    endif
endfunction  

function releaseCTRLObito takes nothing returns nothing
    local player p= GetTriggerPlayer()
    
    if p == GetOwningPlayer(obito) then
        set metaCtrlDownObito=false
    endif
endfunction

//===========================================================================
function InitTrig_ObitoCommandMoveSummon takes nothing returns nothing
    local integer i= 0
    
    loop
    exitwhen ( i > 24 )
        call TriggerRegisterPlayerMouseEventBJ(rmbClickTriggerObito, Player(i), bj_MOUSEEVENTTYPE_DOWN)
        call TriggerRegisterPlayerMouseEventBJ(rmbReleaseTriggerObito, Player(i), bj_MOUSEEVENTTYPE_UP)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlDownObitoTriggerObito, Player(i), OSKEY_LCONTROL, 2, true)
        call BlzTriggerRegisterPlayerKeyEvent(metaCtrlUpTriggerObito, Player(i), OSKEY_LCONTROL, 0, false)
        set i=i + 1
    endloop
    
    call TriggerAddCondition(rmbClickTriggerObito, Condition(function isRMBPressObito))
    call TriggerAddCondition(rmbReleaseTriggerObito, Condition(function isRMBReleaseObito))
    call TriggerAddAction(rmbClickTriggerObito, function actionsObito)
    call TriggerAddAction(rmbReleaseTriggerObito, function actionsObito)
    call TriggerAddAction(metaCtrlDownObitoTriggerObito, function pressCTRLObito)
    call TriggerAddAction(metaCtrlUpTriggerObito, function releaseCTRLObito)
endfunction

