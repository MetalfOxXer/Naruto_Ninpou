 function s__TentenNewBomb_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
         local real dist
         local real angle1
         local real x1
         local real y1
  local integer i
		set s__TentenNewBomb_count[this]=s__TentenNewBomb_count[this] + 1
		if s__TentenNewBomb_count[this] > 50 then
			set i=0
			loop
			    set i=i + 1
			    exitwhen i > 20
        			set dist=GetRandomReal(0, 300)
				set angle1=Deg2Rad(GetRandomReal(0, 360))
				set x1=(((s__TentenNewBomb_target_x[this] )*1.0) + Cos((( angle1 )*1.0)) * (( dist)*1.0)) // INLINED!!
				set y1=(((s__TentenNewBomb_target_y[this] )*1.0) + Sin((( angle1 )*1.0)) * (( dist)*1.0)) // INLINED!!
				call DestroyEffect(AddSpecialEffect(("FireCrack.mdx" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
            			call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
            			call DestroyEffect(AddSpecialEffect(("Boom.mdx" ), (( x1 )*1.0), (( y1)*1.0))) // INLINED!!
			endloop
            		set bj_lastCreatedGroup=CreateGroup()
			set s__TentenNewBomb_instance=this
            		call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__TentenNewBomb_target_x[this], s__TentenNewBomb_target_y[this], 350.0, Filter(function s__TentenNewBomb_dealDamage))
