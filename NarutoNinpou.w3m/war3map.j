              if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KaguyaLavaDimension_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                  call UnitDamageTarget(s__KaguyaLavaDimension_caster[this], bj_lastCreatedUnit, 0.25 * GetHeroInt(s__KaguyaLavaDimension_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
              endif
