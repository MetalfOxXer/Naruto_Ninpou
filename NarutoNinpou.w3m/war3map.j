 function s__SpawnCreeps_check takes nothing returns nothing
		if udg_SpawnCreeps then
				call TimerStart((NewTimerEx(0)), 30.0, true, function s__SpawnCreeps_CB1_1_Actions) // INLINED!!
				call TimerStart((NewTimerEx(0)), 5.0, false, function s__SpawnCreeps_CB1_1_Actions) // INLINED!!
				call TimerStart((NewTimerEx(0)), 60.0, true, function s__SpawnCreeps_CB1_2_Actions) // INLINED!!
				call TimerStart((NewTimerEx(0)), 30.0, true, function s__SpawnCreeps_CB2_1_Actions) // INLINED!!
