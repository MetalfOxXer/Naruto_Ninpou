    function s__NagatoShinraTenSeiChannel_periodic takes nothing returns nothing
        local integer id= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set udg_ShinraChannelings[id]=udg_ShinraChannelings[id] + 0.05
    endfunction 
    
    function s__NagatoShinraTenSeiChannel_stop takes nothing returns nothing
        local integer id
        if GetSpellAbilityId() == 'A045' then
            set id=(GetUnitUserData((GetTriggerUnit()))) // INLINED!!
            call PauseTimer(s__s__NagatoShinraTenSeiChannel_t[id])
            if s__s__NagatoShinraTenSeiChannel_canCast[id] then
                if udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 0 then // INLINED!!
                    call sc__NagatoDevaArea_actions(GetTriggerUnit())
                elseif udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 1 then // INLINED!!
                    call sc__NagatoAsuraArea_actions(GetTriggerUnit())
                elseif udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 2 then // INLINED!!
                    call sc__NagatoAnimalArea_actions(GetTriggerUnit())
                elseif udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 3 then // INLINED!!
                    call sc__NagatoHumanArea_actions(GetTriggerUnit())
                elseif udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 4 then // INLINED!!
                    call sc__NagatoPretaArea_actions(GetTriggerUnit())
                elseif udg_PeinPaths[(GetUnitUserData((GetTriggerUnit())))] == 5 then // INLINED!!
                    call sc__NagatoNarakaArea_actions(GetTriggerUnit())
                endif
                set udg_ShinraChannelings[id]=0
                set s__s__NagatoShinraTenSeiChannel_canCast[id]= false
            endif
        endif
    endfunction 
    
    function s__NagatoShinraTenSeiChannel_start takes nothing returns nothing
        local integer id
        if GetSpellAbilityId() == 'A045' then
            set id=(GetUnitUserData((GetTriggerUnit()))) // INLINED!!
            call AddLoadingBar(GetTriggerUnit() , 2.0)
            set udg_ShinraChannelings[id]=0.00
            set s__s__NagatoShinraTenSeiChannel_canCast[id]= false
            set s__s__NagatoShinraTenSeiChannel_t[id]= NewTimerEx(id)
            call TimerStart(s__s__NagatoShinraTenSeiChannel_t[id], 0.05, true, function s__NagatoShinraTenSeiChannel_periodic)
        endif
    endfunction 

    function s__NagatoShinraTenSeiChannel_cast takes nothing returns nothing
        local integer id= (GetUnitUserData((GetTriggerUnit()))) // INLINED!!
        set s__s__NagatoShinraTenSeiChannel_canCast[id]= true
    endfunction 
    
    function s__NagatoShinraTenSeiChannel_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(10 , 'A045' , function s__NagatoShinraTenSeiChannel_cast)
        call RegisterPlayerUnitEventForId(10 , EVENT_PLAYER_UNIT_SPELL_CAST , function s__NagatoShinraTenSeiChannel_start)
        call RegisterPlayerUnitEventForId(10 , EVENT_PLAYER_UNIT_SPELL_FINISH , function s__NagatoShinraTenSeiChannel_stop)
        call RegisterPlayerUnitEventForId(10 , EVENT_PLAYER_UNIT_SPELL_ENDCAST , function s__NagatoShinraTenSeiChannel_stop)
    endfunction



