        endfunction
    
    function s__SaiSnake_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real angle= Atan3(GetUnitX(s__SaiSnake_snake[this]) , GetUnitY(s__SaiSnake_snake[this]) , GetUnitX(s__SaiSnake_target[this]) , GetUnitY(s__SaiSnake_target[this]))
        local real x= (((GetUnitX(s__SaiSnake_snake[this]) )*1.0) + Cos((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real y= (((GetUnitY(s__SaiSnake_snake[this]) )*1.0) + Sin((( angle )*1.0)) * (( 30)*1.0)) // INLINED!!
        call SetUnitX(s__SaiSnake_snake[this], x)
        call SetUnitY(s__SaiSnake_snake[this], y)
        call SetUnitAnimationByIndex(s__SaiSnake_snake[this], 4)
        if GetDistanceUnits(s__SaiSnake_snake[this] , s__SaiSnake_target[this]) < 100 then
            call UnitDamageTarget(s__SaiSnake_caster[this], s__SaiSnake_target[this], 100 * GetUnitAbilityLevel(s__SaiSnake_caster[this], s__SaiSnake_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            call StunUnitTimed(s__SaiSnake_caster[this] , s__SaiSnake_target[this] , 1.5)
            call KillUnit(s__SaiSnake_snake[this])
            call ShowUnit(s__SaiSnake_snake[this], false)
            set s__SaiSnake_snake[this]=null
            call s__SaiSnake_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SaiSnake_actions takes nothing returns nothing
        local integer this
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetSpellTargetX(), GetSpellTargetY(), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetTriggerPlayer()) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                set this=s__SaiSnake_allocate()
                set s__SaiSnake_caster[this]=GetTriggerUnit()
                set s__SaiSnake_target[this]=bj_lastCreatedUnit
                set s__SaiSnake_snake[this]=CreateUnit(GetTriggerPlayer(), 'n02W', GetUnitX(s__SaiSnake_caster[this]), GetUnitY(s__SaiSnake_caster[this]), Rad2Deg(Atan3(GetUnitX(s__SaiSnake_caster[this]) , GetUnitY(s__SaiSnake_caster[this]) , GetUnitX(s__SaiSnake_target[this]) , GetUnitY(s__SaiSnake_target[this]))))
                call TimerStart(NewTimerEx(this), 0.03, true, function s__SaiSnake_periodic)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction 
    
    function s__SaiSnake_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(20 , s__SaiSnake_SPELL_ID , function s__SaiSnake_actions)
    endfunction 
    
