                    exitwhen bj_lastCreatedUnit == null
                    if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(TayuyaCore_Puppet)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                        call UnitDamageTarget(TayuyaCore_Tayuya, bj_lastCreatedUnit, ( 60 + GetHeroInt(TayuyaCore_Tayuya, true) / 3.5 + GetHeroStr(TayuyaCore_Tayuya, true) / 2 ) * GetUnitAbilityLevel(TayuyaCore_Tayuya, s__TayuyaQOgre_SPELL_ID) / 5, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
                endloop
                call DestroyGroup(bj_lastCreatedGroup)
                set TayuyaCore_IsCasting=false
                call TimerStartEx(NewTimerEx(this) , 0.3 , true , function s__TayuyaQOgre_PeriodicStomp , "Ogre01_PeriodicStomp")
            elseif GetUnitTypeId(TayuyaCore_Puppet) == 'h035' then
                set TayuyaCore_IsChanneling=true
                set TayuyaCore_OgreQ=true
                set s__TayuyaQOgre_caster[this]=TayuyaCore_Puppet
