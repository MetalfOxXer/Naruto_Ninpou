// Trigger: OrochmaruKusanagi
//===========================================================================

//Implemented from module Alloc:
    
        function s__OrochimaruNewKusanagi_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__OrochimaruNewKusanagi_Alloc___recycle[(0)] == 0 ) then
                set s__OrochimaruNewKusanagi_Alloc___instanceCount=s__OrochimaruNewKusanagi_Alloc___instanceCount + 1
                set this=s__OrochimaruNewKusanagi_Alloc___instanceCount
            else
                set this=s__OrochimaruNewKusanagi_Alloc___recycle[(0)]
                set s__OrochimaruNewKusanagi_Alloc___recycle[(0)]=s__OrochimaruNewKusanagi_Alloc___recycle[s__OrochimaruNewKusanagi_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__OrochimaruNewKusanagi_deallocate takes integer this returns nothing
            set s__OrochimaruNewKusanagi_Alloc___recycle[this]=s__OrochimaruNewKusanagi_Alloc___recycle[(0)]
            set s__OrochimaruNewKusanagi_Alloc___recycle[(0)]=this
        endfunction

    
    function s__OrochimaruNewKusanagi_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__OrochimaruNewKusanagi_caster[this])
        local real y= GetUnitY(s__OrochimaruNewKusanagi_caster[this])
 local real angle= Atan3(GetUnitX(s__OrochimaruNewKusanagi_caster[this]) , GetUnitY(s__OrochimaruNewKusanagi_caster[this]) , (s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__OrochimaruNewKusanagi_caster[this])))]) , (s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__OrochimaruNewKusanagi_caster[this])))])) // INLINED!!
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__OrochimaruNewKusanagi_count[this]=s__OrochimaruNewKusanagi_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__OrochimaruNewKusanagi_caster[this], new_x)
            call SetUnitY(s__OrochimaruNewKusanagi_caster[this], new_y)
        else
            set s__OrochimaruNewKusanagi_count[this]=41
        endif
	call SetUnitFacing(s__OrochimaruNewKusanagi_caster[this], Rad2Deg(angle))
        if ModuloInteger(s__OrochimaruNewKusanagi_count[this], 3) == 0 then
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        endif
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 280.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__OrochimaruNewKusanagi_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__OrochimaruNewKusanagi_damaged[this]) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call UnitDamageTarget(s__OrochimaruNewKusanagi_caster[this], bj_lastCreatedUnit, 100.0 * GetUnitAbilityLevel(s__OrochimaruNewKusanagi_caster[this], s__OrochimaruNewKusanagi_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                call GroupAddUnit(s__OrochimaruNewKusanagi_damaged[this], bj_lastCreatedUnit)
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
	call SetUnitAnimationByIndex(s__OrochimaruNewKusanagi_caster[this], 11)
        call DestroyGroup(bj_lastCreatedGroup)
        if s__OrochimaruNewKusanagi_count[this] > 40 then
	    call DestroyEffect(s__OrochimaruNewKusanagi_e[this])
	    set s__OrochimaruNewKusanagi_e[this]=null
            //call PauseUnit(this.caster, false)
            call SetUnitAnimation(s__OrochimaruNewKusanagi_caster[this], "spell slam")
            call SetUnitTimeScale(s__OrochimaruNewKusanagi_caster[this], 1.0)
            set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__OrochimaruNewKusanagi_caster[this]), 'h06Y', GetUnitX(s__OrochimaruNewKusanagi_caster[this]), GetUnitY(s__OrochimaruNewKusanagi_caster[this]), 270)
            call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        	call DestroyGroup(s__OrochimaruNewKusanagi_damaged[this])
        	set s__OrochimaruNewKusanagi_damaged[this]=null
            call s__OrochimaruNewKusanagi_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__OrochimaruNewKusanagi_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call SetUnitTimeScale(s__OrochimaruNewKusanagi_caster[this], 1.0)
        call TimerStart(NewTimerEx(this), 0.02, true, function s__OrochimaruNewKusanagi_periodic)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__OrochimaruNewKusanagi_actions takes nothing returns nothing
        local integer this= s__OrochimaruNewKusanagi_allocate()
        set s__OrochimaruNewKusanagi_caster[this]=GetTriggerUnit()
        set s__OrochimaruNewKusanagi_damaged[this]=CreateGroup()
        set s__OrochimaruNewKusanagi_count[this]=0
        set s__OrochimaruNewKusanagi_angle[this]=Atan3(GetUnitX(s__OrochimaruNewKusanagi_caster[this]) , GetUnitY(s__OrochimaruNewKusanagi_caster[this]) , GetSpellTargetX() , GetSpellTargetY())
        //call PauseUnit(this.caster, true)
        //call SetUnitAnimation(this.caster, "attack slam")
	call SetUnitAnimationByIndex(s__OrochimaruNewKusanagi_caster[this], 11)
        set bj_lastCreatedUnit=CreateUnit(GetTriggerPlayer(), 'h06Y', GetUnitX(s__OrochimaruNewKusanagi_caster[this]), GetUnitY(s__OrochimaruNewKusanagi_caster[this]), 270)
        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
        set s__OrochimaruNewKusanagi_e[this]=AddSpecialEffectTarget("Items\\Sword_of_Kusanagi.mdx", s__OrochimaruNewKusanagi_caster[this], "chest")
        call TimerStart(NewTimerEx(this), 0.1, false, function s__OrochimaruNewKusanagi_delay)
    endfunction
    
    function s__OrochimaruNewKusanagi_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(25 , s__OrochimaruNewKusanagi_SPELL_ID , function s__OrochimaruNewKusanagi_actions)
    endfunction
    
//===========================================================================
// Trigger: OrochimaruSemi
//===========================================================================

function Trig_OrochimaruUwabami_Conditions takes nothing returns boolean
	return ( ( GetSpellAbilityId() == 'A0LO' ) )
endfunction

function Trig_OrochimaruUwabami_Func037001003 takes nothing returns boolean
	return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_units11[0])) )
endfunction

function Trig_OrochimaruUwabami_Func037A takes nothing returns nothing
		call UnitDamageTarget(udg_units11[0], GetEnumUnit(), ( 500 + 2 * GetHeroAgi(udg_units11[0], true) ) * GetUnitAbilityLevel(udg_units11[0], 'A0LO'), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
endfunction

function Trig_OrochimaruUwabami_Actions takes nothing returns nothing
	if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) and GetUnitTypeId(GetTriggerUnit()) == 'U002' then
		call PlaySoundOnUnitBJ(gg_snd_Orochimaru_R, 100.0, GetTriggerUnit())
	endif
	//call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.00,"|cFFFF0000Orochimaru: Everything... will be mine!! |r")
	set udg_units11[0]=GetTriggerUnit()
	set udg_units11[1]=GetSpellTargetUnit()
	call TriggerSleepAction(0.10)

	call PauseUnit(udg_units11[1], true)

	call SetUnitFlyHeight(udg_units11[1], 200.00, 400.00)
	
	call SetUnitAnimation(udg_units11[0], "stand")
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=18
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations03[12]=PolarProjectionBJ(GetUnitLoc(udg_units11[1]), 100.00, ( 20.00 * I2R(bj_forLoopAIndex) ))
		call CreateNUnitsAtLocFacingLocBJ(1, 'nwwf', GetOwningPlayer(GetTriggerUnit()), udg_locations03[12], GetUnitLoc(udg_units11[1]))
		call RemoveLocation(GetUnitLoc(bj_lastCreatedUnit))
		call SetUnitAnimation(bj_lastCreatedUnit, "Spell two")
		call UnitApplyTimedLifeBJ(1.80, 'BTLF', bj_lastCreatedUnit)
		call RemoveLocation(udg_locations03[12])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	call TriggerSleepAction(0.50)

	call PauseUnit(udg_units11[0], true)

	call SetUnitTimeScalePercent(GetTriggerUnit(), 0.00)
	call TriggerSleepAction(0.50)
	call SetUnitTimeScalePercent(GetTriggerUnit(), 100.00)
	//call SetUnitAnimationWithRarity(udg_units11[0],"Spell",RARITY_FREQUENT)
	
	call SetUnitAnimation(udg_units11[0], "stand")
	call CameraSetEQNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()), 50.00)
	call CameraSetEQNoiseForPlayer(GetOwningPlayer(udg_units11[1]), 50.00)
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=5
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations03[12]=PolarProjectionBJ(GetUnitLoc(udg_units11[1]), 200.00, ( 72.00 * I2R(bj_forLoopAIndex) ))
		call CreateNUnitsAtLocFacingLocBJ(1, 'e05V', GetOwningPlayer(GetTriggerUnit()), udg_locations03[12], GetUnitLoc(udg_unit10))
		call KillUnit(bj_lastCreatedUnit)
		call SetUnitFlyHeight(bj_lastCreatedUnit, 0.00, 0.00)
		call RemoveLocation(udg_locations03[12])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	set bj_forLoopAIndex=1
	set bj_forLoopAIndexEnd=5
	loop
		exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
		set udg_locations03[12]=PolarProjectionBJ(GetUnitLoc(udg_units11[1]), 1 - 0.00, ( 72.00 * I2R(bj_forLoopAIndex) ))
		call CreateNUnitsAtLocFacingLocBJ(1, 'e05V', GetOwningPlayer(GetTriggerUnit()), udg_locations03[12], GetUnitLoc(udg_unit10))
		call RemoveLocation(udg_locations03[12])
		call SetUnitTimeScale(bj_lastCreatedUnit, 0.4)
		call KillUnit(bj_lastCreatedUnit)
		call SetUnitFlyHeight(bj_lastCreatedUnit, GetRandomReal(50.00, 400.00), 150.00)
		//set udg_locations03[118]=GetRandomLocInRect(RectFromCenterSizeBJ(GetUnitLoc(udg_units11[1]),250.00,250.00))
		//call AddSpecialEffectLocBJEX(udg_locations03[118],"Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl")
		//call RemoveLocation(udg_locations03[118])
		set bj_forLoopAIndex=bj_forLoopAIndex + 1
	endloop
	call TriggerSleepAction(0.10)
	call CameraClearNoiseForPlayer(GetOwningPlayer(GetTriggerUnit()))
	call CameraClearNoiseForPlayer(GetOwningPlayer(udg_units11[1]))
        //call CreateNUnitsAtLoc(1, 'nhef', GetOwningPlayer(GetTriggerUnit()), udg_locations03[12], 270.0)
        //call SetUnitScalePercentEx(bj_lastCreatedUnit, 500.0, 500.0, 500.0)
        //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
	call SetUnitAnimation(udg_units11[1], "Death")
	
	call SetUnitFlyHeight(udg_units11[1], 500.00, 5000.00)
	
	call PauseUnit(udg_units11[0], false)
	call EnableTrigger(udg_trigger86)
	call TriggerSleepAction(0.25)
	call SetUnitFlyHeight(udg_units11[1], 0.00, 6000.00)
	//call TriggerSleepAction(0.20)
	call DisableTrigger(udg_trigger86)
	call PauseUnit(udg_units11[1], false)
	set udg_locations03[12]=GetUnitLoc(udg_units11[1])
	set bj_wantDestroyGroup=true
	call ForGroupBJ(GetUnitsInRangeOfLocMatching(400.00, udg_locations03[12], Condition(function Trig_OrochimaruUwabami_Func037001003)), function Trig_OrochimaruUwabami_Func037A)
	call RemoveLocation(udg_locations03[12])
endfunction

