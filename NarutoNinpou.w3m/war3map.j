			set s__s__ToneriQ_truthballs[i]= CreateUnit(GetOwningPlayer(s__ToneriQ_caster[this]), 'e00O', GetUnitX(s__ToneriQ_caster[this]) + GetRandomReal(- 200, 200), GetUnitY(s__ToneriQ_caster[this]) + GetRandomReal(- 200, 200), 270)
			call SetUnitFlyHeight(s__s__ToneriQ_truthballs[i], GetUnitFlyHeight(s__ToneriQ_caster[this]) + GetRandomReal(100, 300), 0)
			set i=i + 1
		endloop
        	call TimerStart(NewTimerEx(this), 0.01, false, function s__ToneriQ_delay)
		call ReleaseTimer(GetExpiredTimer())
 endfunction

