        endfunction
    
 function s__HiruzenEdoShuriken_dealDamage takes nothing returns boolean
                if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(s__HiruzenEdoShuriken_caster[s__HiruzenEdoShuriken_instance])) and GetWidgetLife(GetFilterUnit()) > 0.405 then
		    call UnitDamageTarget(s__HiruzenEdoShuriken_caster[s__HiruzenEdoShuriken_instance], GetFilterUnit(), ( ( ( 60 * GetHeroStr(s__HiruzenEdoShuriken_caster[s__HiruzenEdoShuriken_instance], true) / 5.5 ) + 10 ) / 2 ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
	    return false
 endfunction
	
    function s__HiruzenEdoShuriken_destroy takes integer this returns nothing
        call KillUnit(s__HiruzenEdoShuriken_missile[this])
        call ShowUnit(s__HiruzenEdoShuriken_missile[this], false)
        set s__HiruzenEdoShuriken_caster[this]=null
        set s__HiruzenEdoShuriken_target[this]=null
        set s__HiruzenEdoShuriken_missile[this]=null
    endfunction
    
    function s__HiruzenEdoShuriken_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__HiruzenEdoShuriken_missile[this])
        local real y= GetUnitY(s__HiruzenEdoShuriken_missile[this])
        local real angle= Atan3(x , y , GetUnitX(s__HiruzenEdoShuriken_target[this]) , GetUnitY(s__HiruzenEdoShuriken_target[this]))
        local real new_x= (((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real dist= GetDistanceUnits(s__HiruzenEdoShuriken_missile[this] , s__HiruzenEdoShuriken_target[this])
        local integer i
        call SetUnitX(s__HiruzenEdoShuriken_missile[this], new_x)
        call SetUnitY(s__HiruzenEdoShuriken_missile[this], new_y)
        if dist <= 50 then
	    call DestroyEffect(AddSpecialEffect(("s_Shadow_Smoke.mdx" ), (( GetUnitX(s__HiruzenEdoShuriken_missile[this]) )*1.0), (( GetUnitY(s__HiruzenEdoShuriken_missile[this]))*1.0))) // INLINED!!
            set i=0
            loop
                exitwhen i > 5
                set new_x=GetRandomReal(x - 100, x + 100)
                set new_y=GetRandomReal(y - 100, y + 100)
                set angle=Atan3(GetUnitX(s__HiruzenEdoShuriken_target[this]) , GetUnitY(s__HiruzenEdoShuriken_target[this]) , new_x , new_y)
                //call AddSpecialEffectEx("Abilities\\Spells\\NightElf\\FanOfKnives\\FanOfKnivesCaster.md", new_x, new_y)
                //call AddSpecialEffectEx("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl", new_x, new_y)
                //set bj_lastCreatedUnit = CreateUnit(GetOwningPlayer(this.caster), 'h07W', new_x, new_y, Rad2Deg(angle)) 
                //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 3.0)
		set bj_lastCreatedUnit=CreateAbilityDummy(s__HiruzenEdoShuriken_caster[this] , 'A155')
		call SetUnitX(bj_lastCreatedUnit, new_x)
		call SetUnitY(bj_lastCreatedUnit, new_y)
		call IssuePointOrder(bj_lastCreatedUnit, "clusterrockets", new_x, new_y)
                set i=i + 1
            endloop
            //if GetHeroLevel(this.caster) < 35 then
            //    call StunUnitTimed(this.caster, this.target, 2.0)
            //endif
            set bj_lastCreatedGroup=CreateGroup()
			set s__HiruzenEdoShuriken_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, x, y, 250, Filter(function s__HiruzenEdoShuriken_dealDamage))
            call s__HiruzenEdoShuriken_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__HiruzenEdoShuriken_actions takes nothing returns nothing
        local integer this= s__HiruzenEdoShuriken_allocate()
        set s__HiruzenEdoShuriken_caster[this]=GetTriggerUnit()
        set s__HiruzenEdoShuriken_target[this]=GetSpellTargetUnit()
        set s__HiruzenEdoShuriken_missile[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h07V', GetUnitX(s__HiruzenEdoShuriken_caster[this]), GetUnitY(s__HiruzenEdoShuriken_caster[this]), GetUnitFacing(s__HiruzenEdoShuriken_caster[this]))
        call TimerStart(NewTimerEx(this), 0.03, true, function s__HiruzenEdoShuriken_periodic)
    endfunction
    
    function s__HiruzenEdoShuriken_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(36 , s__HiruzenEdoShuriken_SPELL_ID , function s__HiruzenEdoShuriken_actions)
        call RegisterSpellEffectEvent2(('A167' ) , Filter(( function s__HiruzenEdoShuriken_actions))) // INLINED!!
    endfunction
    
