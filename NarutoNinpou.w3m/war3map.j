        set y=(((GetUnitY(s__KimimaroNewYanagi2_target[this]) )*1.0) + Sin((( angle )*1.0)) * (( 100)*1.0)) // INLINED!!
        if ModuloInteger(s__KimimaroNewYanagi2_count[this], 2) == 1 and IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            set s__KimimaroNewYanagi2_count[this]=25
        else
            call SetUnitX(s__KimimaroNewYanagi2_target[this], x)
            call SetUnitY(s__KimimaroNewYanagi2_target[this], y)
            set x=(((GetUnitX(s__KimimaroNewYanagi2_target[this]) )*1.0) + Cos((( GetRandomReal(0, bj_PI * 2) )*1.0)) * (( 75)*1.0)) // INLINED!!
