            call TimerStart(NewTimerEx(this), 1.0, true, function s__MinatoJouninD_finish)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__MinatoJouninD_actions takes nothing returns nothing
        local integer this= s__MinatoJouninD_allocate()
        set s__MinatoJouninD_caster[this]=GetTriggerUnit()
        set s__MinatoJouninD_kunai[this]=CreateUnit(GetTriggerPlayer(), 'h07Y', GetUnitX(s__MinatoJouninD_caster[this]), GetUnitY(s__MinatoJouninD_caster[this]), Rad2Deg(Atan3(GetUnitX(s__MinatoJouninD_caster[this]) , GetUnitY(s__MinatoJouninD_caster[this]) , GetSpellTargetX() , GetSpellTargetY())))
        call UnitAddAbility(s__MinatoJouninD_kunai[this], 'A0OX')
        call AddSpecialEffectTarget("Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl", s__MinatoJouninD_kunai[this], "origin")
