    function s__KushinaSeal_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local unit u
	set s__KushinaSeal_count[this]=s__KushinaSeal_count[this] + 1
        call BlzSetSpecialEffectX(s__KushinaSeal_e1[this], GetUnitX(s__KushinaSeal_caster[this]))
        call BlzSetSpecialEffectY(s__KushinaSeal_e1[this], GetUnitY(s__KushinaSeal_caster[this]))
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KushinaSeal_caster[this]), GetUnitY(s__KushinaSeal_caster[this]), 500, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__KushinaSeal_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
		call UnitDamageTarget(s__KushinaSeal_caster[this], bj_lastCreatedUnit, ( 4 * GetHeroStr(s__KushinaSeal_caster[this], true) + 500 ) / 30, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                if not IsUnitInGroup(bj_lastCreatedUnit, s__KushinaSeal_damaged[this]) then
                    call GroupAddUnit(s__KushinaSeal_damaged[this], bj_lastCreatedUnit)
                    set u=CreateAbilityDummy(s__KushinaSeal_caster[this] , 'A0KN')
                    call IssuePointOrder(u, "silence", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit))
            	    call UnitApplyTimedLife(u, 'BTLF', 1.0)
                    set u=null
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__KushinaSeal_count[this] > 30 or GetWidgetLife(s__KushinaSeal_caster[this]) < 0.405 then
            call DestroyGroup(s__KushinaSeal_damaged[this])
            set s__KushinaSeal_damaged[this]=null
            call BlzSetSpecialEffectX(s__KushinaSeal_e1[this], - 7000)
            call BlzSetSpecialEffectY(s__KushinaSeal_e1[this], - 8000)
            call DestroyEffect(s__KushinaSeal_e1[this])
            set s__KushinaSeal_e1[this]=null
            call s__KushinaSeal_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 

    
    function s__KushinaSeal_actions takes nothing returns nothing
        local integer this= s__KushinaSeal_allocate()
        set s__KushinaSeal_caster[this]=GetTriggerUnit()
        set s__KushinaSeal_count[this]=0
        set s__KushinaSeal_e1[this]=AddSpecialEffect("war3mapImported\\fourseal.mdx", GetUnitX(s__KushinaSeal_caster[this]), GetUnitY(s__KushinaSeal_caster[this]))
        call BlzSetSpecialEffectScale(s__KushinaSeal_e1[this], 0.1)
        call BlzSetSpecialEffectTimeScale(s__KushinaSeal_e1[this], 0.5)
        set s__KushinaSeal_damaged[this]=CreateGroup()
        call TimerStartEx(NewTimerEx(this) , 0.1 , true , function s__KushinaSeal_periodic , "KushinaSeal_periodic")
    endfunction 
    
