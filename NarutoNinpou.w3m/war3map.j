    call RegisterSpellEffectEvent2(('A011' ) , Filter(( function Trig_Byakugan_Actions))) // INLINED!!
    call RegisterSpellEffectEvent2(('A0VT' ) , Filter(( function Trig_Byakugan_Reveal))) // INLINED!!
endfunction


//===========================================================================
// Trigger: ByakuganHit
//===========================================================================

function Trig_ByakuganHit_Func006001 takes nothing returns boolean
	return ( UnitHasBuffBJ(GetAttacker(), 'B00F') )
endfunction

function Trig_ByakuganHit_Func006002 takes nothing returns boolean
	return ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false )
endfunction

function Trig_ByakuganHit_Conditions takes nothing returns boolean
	return ( GetBooleanAnd(( UnitHasBuffBJ(GetAttacker(), 'B00F') ), ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false )) )
endfunction

function Trig_ByakuganHit_Actions takes nothing returns nothing
	call SetUnitManaBJ(GetTriggerUnit(), ( GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) - ( 10.00 * I2R(GetUnitAbilityLevel(GetAttacker(), 'A011')) ) ))
	set udg_locations03[154]=PolarProjectionBJ(GetUnitLoc(GetAttacker()), 100.00, GetUnitFacing(GetAttacker()))
call AddSpecialEffectLocBJ((udg_locations03[154] ), ( "ByakuganHitEffect.mdl")) // INLINED!!
	call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, 10 + GetPointZ(GetLocationX(udg_locations03[154]) , GetLocationY(udg_locations03[154])))
	call DestroyEffect(bj_lastCreatedEffect)
	call RemoveLocation(udg_locations03[154])
endfunction

function InitTrig_ByakuganHit takes nothing returns nothing
	set udg_trigger220=CreateTrigger()
	call TriggerRegisterAnyUnitEventBJ(udg_trigger220, EVENT_PLAYER_UNIT_ATTACKED)
	call TriggerAddCondition(udg_trigger220, Condition(function Trig_ByakuganHit_Conditions))
	call TriggerAddAction(udg_trigger220, function Trig_ByakuganHit_Actions)
	call EnableTriggerForId(14 , udg_trigger220)
	call EnableTriggerForId(8 , udg_trigger220)
	call EnableTriggerForId(68 , udg_trigger220)
endfunction 

