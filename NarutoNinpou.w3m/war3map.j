//Implemented from module Alloc:
    
        function s__KakashiUltimateChoice_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__KakashiUltimateChoice_Alloc___recycle[(0)] == 0 ) then
                set s__KakashiUltimateChoice_Alloc___instanceCount=s__KakashiUltimateChoice_Alloc___instanceCount + 1
                set this=s__KakashiUltimateChoice_Alloc___instanceCount
            else
                set this=s__KakashiUltimateChoice_Alloc___recycle[(0)]
                set s__KakashiUltimateChoice_Alloc___recycle[(0)]=s__KakashiUltimateChoice_Alloc___recycle[s__KakashiUltimateChoice_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__KakashiUltimateChoice_deallocate takes integer this returns nothing
            set s__KakashiUltimateChoice_Alloc___recycle[this]=s__KakashiUltimateChoice_Alloc___recycle[(0)]
            set s__KakashiUltimateChoice_Alloc___recycle[(0)]=this
        endfunction
    //private static boolean picked = false 
    
    function s__KakashiUltimateChoice_enableSkill takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__KakashiUltimateChoice_caster[this] != null then
            call SetPlayerAbilityAvailable(GetOwningPlayer(s__KakashiUltimateChoice_caster[this]), 'A0VB', false)
        else
            call s__KakashiUltimateChoice_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__KakashiUltimateChoice_pickSkill takes nothing returns boolean
        local integer i
        local integer this
        if (GetClickedButton()) == s__s__KakashiUltimateChoice_b[0] then // INLINED!!
            call UnitAddAbility(s__KakashiUltimateChoice_u, s__KakashiUltimateChoice_KAMUI)
            call UnitMakeAbilityPermanent(s__KakashiUltimateChoice_u, true, s__KakashiUltimateChoice_KAMUI)
        else
            call UnitAddAbility(s__KakashiUltimateChoice_u, s__KakashiUltimateChoice_SUSANOO)
            call UnitMakeAbilityPermanent(s__KakashiUltimateChoice_u, true, s__KakashiUltimateChoice_SUSANOO)
        endif
        set i=0
        loop
            exitwhen i > 11
            call SetPlayerAbilityAvailable(Player(i), 'A0VB', false)
            set i=i + 1
        endloop
        //call SetPlayerAbilityAvailable(GetOwningPlayer(u), 'A0VB', false)
        set s__s__KakashiUltimateChoice_b[0]= null
        set s__s__KakashiUltimateChoice_b[1]= null
        set s__KakashiUltimateChoice_u=null
        call s__Dialog_destroy(s__KakashiUltimateChoice_d)
        call DestroyBoolExpr(s__KakashiUltimateChoice_pick)
        set s__KakashiUltimateChoice_pick=null
        set this=s__KakashiUltimateChoice_allocate()
        set s__KakashiUltimateChoice_caster[this]=s__KakashiUltimateChoice_u
        set s__KakashiUltimateChoice_pp[this]=GetOwningPlayer(s__KakashiUltimateChoice_u)
        call TimerStart(NewTimerEx(this), 0.1, true, function s__KakashiUltimateChoice_enableSkill)
        return false
    endfunction 
    
    function s__KakashiUltimateChoice_actions takes nothing returns nothing
        if GetTriggerUnit() != udg_InoMental and GetUnitAbilityLevel(GetTriggerUnit(), s__KakashiUltimateChoice_KAMUI) == 0 and GetUnitAbilityLevel(GetTriggerUnit(), s__KakashiUltimateChoice_SUSANOO) == 0 then
            set s__KakashiUltimateChoice_d=s__Dialog_create()
            call s__Dialog__set_title(s__KakashiUltimateChoice_d,"Pick a skill")
            set s__s__KakashiUltimateChoice_b[0]= (DialogAddButton(s__Dialog_dg[(s__KakashiUltimateChoice_d)], ("Kamui" ), ( 0))) // INLINED!!
            set s__s__KakashiUltimateChoice_b[1]= (DialogAddButton(s__Dialog_dg[(s__KakashiUltimateChoice_d)], ("Susano'o" ), ( 1))) // INLINED!!
            call s__Dialog_display(s__KakashiUltimateChoice_d,GetTriggerPlayer() , true)
            call s__Dialog_registerClickEvent(s__KakashiUltimateChoice_d,s__KakashiUltimateChoice_pick)
            set s__KakashiUltimateChoice_u=GetTriggerUnit()
            //set picked = true 
        endif
    endfunction
    
    function s__KakashiUltimateChoice_learn takes nothing returns nothing
        if GetLearnedSkill() == 'A0VB' then
            set s__KakashiUltimateChoice_p=GetTriggerPlayer()
        endif
    endfunction 
    
    function s__KakashiUltimateChoice_onInit takes nothing returns nothing
        set s__KakashiUltimateChoice_pick=Condition(function s__KakashiUltimateChoice_pickSkill)
        call RegisterPlayerUnitEvent2((EVENT_PLAYER_HERO_SKILL ) , Filter(( function s__KakashiUltimateChoice_learn))) // INLINED!!
        call RegisterSpellEffectEvent2(('A0VB' ) , Filter(( function s__KakashiUltimateChoice_actions))) // INLINED!!
    endfunction 
    
//end of: UltimateChoice("Kakashi", "A0VB", "A0BF", "KAMUI", "Kamui", "A0VC", "SUSANOO", "Susano'o")

