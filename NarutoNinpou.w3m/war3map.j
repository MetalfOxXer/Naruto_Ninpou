//Implemented from module Alloc:
    
        function s__MeiNewKomu_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__MeiNewKomu_Alloc___recycle[(0)] == 0 ) then
                set s__MeiNewKomu_Alloc___instanceCount=s__MeiNewKomu_Alloc___instanceCount + 1
                set this=s__MeiNewKomu_Alloc___instanceCount
            else
                set this=s__MeiNewKomu_Alloc___recycle[(0)]
                set s__MeiNewKomu_Alloc___recycle[(0)]=s__MeiNewKomu_Alloc___recycle[s__MeiNewKomu_Alloc___recycle[(0)]]
            endif

    
            return this
        endfunction
    
        function s__MeiNewKomu_deallocate takes integer this returns nothing
            set s__MeiNewKomu_Alloc___recycle[this]=s__MeiNewKomu_Alloc___recycle[(0)]
            set s__MeiNewKomu_Alloc___recycle[(0)]=this
        endfunction
    
    function s__MeiNewKomu_destroy takes integer this returns nothing
        call SetUnitScale(s__MeiNewKomu_cloud[this], 1, 1, 1)
        call KillUnit(s__MeiNewKomu_cloud[this])
	call ShowUnit(s__MeiNewKomu_cloud[this], false)
        set s__MeiNewKomu_cloud[this]=null
	set s__MeiNewKomu_caster[this]=null
        call s__MeiNewKomu_deallocate(this)
    endfunction 
    
    function s__MeiNewKomu_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
 local real dist
 local real angle
 local real x
 local real y
 local integer i
        call SetUnitX(s__MeiNewKomu_cloud[this], GetUnitX(s__MeiNewKomu_caster[this]))
        call SetUnitY(s__MeiNewKomu_cloud[this], GetUnitY(s__MeiNewKomu_caster[this]))
        set s__MeiNewKomu_count[this]=s__MeiNewKomu_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
	if ModuloInteger(s__MeiNewKomu_count[this], 15) == 1 then
		set i=0
		loop
                	set i=i + 1
                	exitwhen i > 12
			set dist=GetRandomReal(25, 150)
			set angle=Deg2Rad(GetRandomReal(0, 360))
			set x=(((GetUnitX(s__MeiNewKomu_caster[this]) )*1.0) + Cos((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
			set y=(((GetUnitY(s__MeiNewKomu_caster[this]) )*1.0) + Sin((( angle )*1.0)) * (( dist)*1.0)) // INLINED!!
                	set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__MeiNewKomu_caster[this]), 'z008', x, y, 24 * i)
                	set x=GetUnitX(s__MeiNewKomu_caster[this]) + Cos(Deg2Rad(30 * i)) * 800
                	set y=GetUnitY(s__MeiNewKomu_caster[this]) + Sin(Deg2Rad(30 * i)) * 800
			call SetUnitScale(bj_lastCreatedUnit, 10, 0, 0)
			call SetUnitVertexColor(bj_lastCreatedUnit, 255, 255, 255, 25)
			call SetUnitMoveSpeed(bj_lastCreatedUnit, 400)
                	call IssuePointOrder(bj_lastCreatedUnit, "move", x, y)
                	call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
           	 endloop
	endif
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__MeiNewKomu_caster[this]), GetUnitY(s__MeiNewKomu_caster[this]), 800, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if bj_lastCreatedUnit != s__MeiNewKomu_caster[this] then
                if IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(s__MeiNewKomu_caster[this])) then
                    call UnitDamageTarget(s__MeiNewKomu_caster[this], bj_lastCreatedUnit, 0.03 * GetHeroAgi(s__MeiNewKomu_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                else
                    call UnitDamageTarget(s__MeiNewKomu_caster[this], bj_lastCreatedUnit, 0.06 * GetHeroAgi(s__MeiNewKomu_caster[this], true), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                        //call UnitRemoveBuffs(bj_lastCreatedUnit, true, true)
                        call SetUnitInvulnerable(bj_lastCreatedUnit, false)
                    endif
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    	if GetWidgetLife(s__MeiNewKomu_caster[this]) < 0.405 or not UnitAlive(s__MeiNewKomu_caster[this]) then
            call s__MeiNewKomu_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        elseif s__MeiNewKomu_count[this] > 230 then
            call s__MeiNewKomu_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__MeiNewKomu_actions takes nothing returns nothing
        local integer this= s__MeiNewKomu_allocate()
 local integer i= 0
 local integer j= 0
 local real x
 local real y
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Mei_T, 100.0, GetTriggerUnit())
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Mei: I'll watch you melt.|r")
        endif
        set s__MeiNewKomu_caster[this]=GetTriggerUnit()
        set s__MeiNewKomu_cloud[this]=(CreateUnit((GetTriggerPlayer() ), ( 'e007' ), (( GetUnitX(GetTriggerUnit()) )*1.0), (( GetUnitY(GetTriggerUnit()) )*1.0), (( 270)*1.0))) // INLINED!!
	call SlowAura(s__MeiNewKomu_cloud[this] , 0.6 , 600)
        set s__MeiNewKomu_count[this]=0
        call AddLoadingBar(s__MeiNewKomu_caster[this] , 7)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__MeiNewKomu_periodic)
    endfunction 
    
    function s__MeiNewKomu_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(30 , s__MeiNewKomu_SPELL_ID , function s__MeiNewKomu_actions)
    endfunction 
    
