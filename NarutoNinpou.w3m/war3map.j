    function s__ObitoNewQ_push takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        set s__ObitoNewQ_count[this]=s__ObitoNewQ_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if not IsUnitHidden(bj_lastCreatedUnit) then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Deg2Rad((LoadInteger(Table__ht, (s__ObitoNewQ_angles[this]), ((GetUnitUserData((bj_lastCreatedUnit))))))) //Atan3(x, y, this.target_x, this.target_y) + bj_PI // INLINED!!
                set new_x=(((x )*1.0) + Cos((( angle + bj_PI )*1.0)) * (( 20)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle + bj_PI )*1.0)) * (( 20)*1.0)) // INLINED!!
                if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
                    call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__ObitoNewQ_count[this] > 3 then
	    set bj_lastCreatedGroup=CreateGroup()
	    call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
            loop
		set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		exitwhen bj_lastCreatedUnit == null
		if RectContainsUnit(gg_rct_KamuiDimensionObito, bj_lastCreatedUnit) and not RectContainsUnit(gg_rct_KamuiDimensionObito, s__ObitoNewQ_caster[this]) then
			call SetUnitPosition(bj_lastCreatedUnit, GetUnitX(s__ObitoNewQ_caster[this]), GetUnitY(s__ObitoNewQ_caster[this]))
		endif
		call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            call s__Table_destroy(s__ObitoNewQ_angles[this])
            call DestroyGroup(s__ObitoNewQ_damaged[this])
            set s__ObitoNewQ_damaged[this]=null
            call s__ObitoNewQ_deallocate(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ObitoNewQ_littleDelay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__ObitoNewQ_caster[this]) ), ( 'h03U' ), (( s__ObitoNewQ_target_x[this] )*1.0), (( s__ObitoNewQ_target_y[this] )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, 0.75, 0, 0)
        //call SetUnitTimeScale(bj_lastCreatedUnit, 4.0)
        //call SetUnitAnimation(bj_lastCreatedUnit, "birth")
        //call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 0.25)
        call KillUnit(bj_lastCreatedUnit)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            call SetUnitX(bj_lastCreatedUnit, s__ObitoNewQ_target_x[this])
            call SetUnitY(bj_lastCreatedUnit, s__ObitoNewQ_target_y[this])
            call ShowUnit(bj_lastCreatedUnit, true)
            if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                call SelectUnitForPlayerSingle(bj_lastCreatedUnit, GetOwningPlayer(bj_lastCreatedUnit))
            endif
            call SetUnitInvulnerable(bj_lastCreatedUnit, false)
            call PauseUnit(bj_lastCreatedUnit, false)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
	set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
	    if GetUnitTypeId(s__ObitoNewQ_caster[this]) == 'U00Y' or GetUnitTypeId(s__ObitoNewQ_caster[this]) == 'U010' then
		    call UnitDamageTarget(s__ObitoNewQ_caster[this], bj_lastCreatedUnit, 100 * GetUnitAbilityLevel(s__ObitoNewQ_caster[this], 'A17Y'), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
        else
	        if GetUnitAbilityLevel(s__ObitoNewQ_caster[this], 'A0DA') > 0 then
		        call UnitDamageTarget(s__ObitoNewQ_caster[this], bj_lastCreatedUnit, GetHeroInt(s__ObitoNewQ_caster[this], true) * GetUnitAbilityLevel(s__ObitoNewQ_caster[this], s__ObitoNewQ_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            else
            	call UnitDamageTarget(s__ObitoNewQ_caster[this], bj_lastCreatedUnit, GetHeroInt(s__ObitoNewQ_caster[this], true) * GetUnitAbilityLevel(s__ObitoNewQ_caster[this], s__ObitoNewQ_SPELL_ID), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
	        endif
	    endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ObitoNewQ_push)
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ObitoNewQ_pull takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x
        local real y
        local real angle
        local real new_x
        local real new_y
        set s__ObitoNewQ_count[this]=s__ObitoNewQ_count[this] + 1
        set bj_lastCreatedGroup=CreateGroup()
        call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if not IsUnitHidden(bj_lastCreatedUnit) then
                set x=GetUnitX(bj_lastCreatedUnit)
                set y=GetUnitY(bj_lastCreatedUnit)
                set angle=Atan3(x , y , s__ObitoNewQ_target_x[this] , s__ObitoNewQ_target_y[this]) + Deg2Rad(8)
                set new_x=(((x )*1.0) + Cos((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
                set new_y=(((y )*1.0) + Sin((( angle )*1.0)) * (( 25)*1.0)) // INLINED!!
                call SetUnitPosition(bj_lastCreatedUnit, new_x, new_y)
                call SaveInteger(Table__ht, (s__ObitoNewQ_angles[this]), ((GetUnitUserData((bj_lastCreatedUnit)))), ( R2I(Rad2Deg(angle)))) // INLINED!!
                call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                if GetDistance(new_x , new_y , s__ObitoNewQ_target_x[this] , s__ObitoNewQ_target_y[this]) < 50 then
                    call ShowUnit(bj_lastCreatedUnit, false)
                    call PauseUnit(bj_lastCreatedUnit, true)
                    call SetUnitInvulnerable(bj_lastCreatedUnit, true)
                    set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(bj_lastCreatedUnit), 'e007', s__ObitoNewQ_target_x[this], s__ObitoNewQ_target_y[this], 270)
                    call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 1.3)
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if s__ObitoNewQ_count[this] > 15 then
            set bj_lastCreatedGroup=CreateGroup()
            call GroupAddGroup(s__ObitoNewQ_damaged[this], bj_lastCreatedGroup)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if not IsUnitHidden(bj_lastCreatedUnit) then
                    call ShowUnit(bj_lastCreatedUnit, false)
                    call SetUnitInvulnerable(bj_lastCreatedUnit, true)
                endif
                call SetUnitX(bj_lastCreatedUnit, s__ObitoNewQ_target_x[this])
                call SetUnitY(bj_lastCreatedUnit, s__ObitoNewQ_target_y[this])
                call IssueImmediateOrder(bj_lastCreatedUnit, "stop")
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set s__ObitoNewQ_count[this]=0
            call TimerStart(NewTimerEx(this), 1.0, false, function s__ObitoNewQ_littleDelay)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__ObitoNewQ_enumUnits takes integer this returns nothing
        set s__ObitoNewQ_target_x[this]=GetUnitX(s__ObitoNewQ_caster[this])
        set s__ObitoNewQ_target_y[this]=GetUnitY(s__ObitoNewQ_caster[this])
        set bj_lastCreatedUnit=(CreateUnit((GetOwningPlayer(s__ObitoNewQ_caster[this]) ), ( 'h03U' ), (( GetUnitX(s__ObitoNewQ_caster[this]) )*1.0), (( GetUnitY(s__ObitoNewQ_caster[this]) )*1.0), (( 270)*1.0))) // INLINED!!
        call SetUnitScale(bj_lastCreatedUnit, 0.75, 0, 0)
        call KillUnit(bj_lastCreatedUnit)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__ObitoNewQ_caster[this]), GetUnitY(s__ObitoNewQ_caster[this]), 400, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__ObitoNewQ_caster[this])) and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                call GroupAddUnit(s__ObitoNewQ_damaged[this], bj_lastCreatedUnit)
                call SetUnitX(bj_lastCreatedUnit, s__ObitoNewQ_target_x[this])
                call SetUnitY(bj_lastCreatedUnit, s__ObitoNewQ_target_y[this])
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
    endfunction 
    
    function s__ObitoNewQ_delay takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        call s__ObitoNewQ_enumUnits(this)
        call TimerStart(NewTimerEx(this), 0.03, true, function s__ObitoNewQ_pull)
	    call SetUnitAnimation(s__ObitoNewQ_caster[this], "spell two")
        call ReleaseTimer(GetExpiredTimer())
    endfunction 
    
    function s__ObitoNewQ_actions takes nothing returns nothing
        local integer this= s__ObitoNewQ_allocate()
        set s__ObitoNewQ_caster[this]=GetTriggerUnit()
        set s__ObitoNewQ_damaged[this]=CreateGroup()
        set s__ObitoNewQ_count[this]=0
        set s__ObitoNewQ_angles[this]=s__Table_create()
        if not IsTerrainPathable(GetSpellTargetX(), GetSpellTargetY(), PATHING_TYPE_WALKABILITY) then
