        function s__SasoriPoison_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__SasoriPoison_Alloc___recycle[(0)] == 0 ) then
                set s__SasoriPoison_Alloc___instanceCount=s__SasoriPoison_Alloc___instanceCount + 1
                set this=s__SasoriPoison_Alloc___instanceCount
