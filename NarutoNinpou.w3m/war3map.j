            call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 300.0, Filter(function s__TayuyaWOgre_damagefix))
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)
            set i=1
            loop
                exitwhen i > s__TayuyaWOgre_count[this] / 4
                set j=0
                loop
                    set j=j + 1
                    exitwhen j > 6
                    set x=(((GetUnitX(TayuyaCore_Puppet) )*1.0) + Cos((( Deg2Rad(72 * j) )*1.0)) * (( 30 * ( i + 1 ))*1.0)) // INLINED!!
                    set y=(((GetUnitY(TayuyaCore_Puppet) )*1.0) + Sin((( Deg2Rad(72 * j) )*1.0)) * (( 30 * ( i + 1 ))*1.0)) // INLINED!!
                    call DestroyEffect(AddSpecialEffect(("war3mapImported\\Ground Crack.mdx" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
                endloop
                set i=i + 1
            endloop
              
            if not TayuyaCore_IsChanneling then
                set TayuyaCore_IsCasting=false
            endif

            call s__TayuyaWOgre_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
