function Trig_JiraiyaGamayu2_Func002Func007A takes nothing returns nothing
	call UnitDamageTarget(GetTriggerUnit(), GetEnumUnit(), ( 60.00 * I2R(GetUnitAbilityLevel(udg_units30[200], 'A05L')) ), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
