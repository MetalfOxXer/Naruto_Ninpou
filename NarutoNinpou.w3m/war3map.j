            set new_y=(((s__HagoromoT_target_y[this] )*1.0) + Sin((( Deg2Rad(24 * i) )*1.0)) * (( 300.0)*1.0)) // INLINED!!
            set s__HagoromoLightningT___indication[i]= AddSpecialEffect("SharedModels\\EntangleWisp.mdl", new_x, new_y)
            call BlzSetSpecialEffectColorByPlayer(s__HagoromoLightningT___indication[i], Player(4))
