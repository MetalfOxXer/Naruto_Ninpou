    function s__KarinExplosiveNote_actions takes nothing returns nothing
        local integer this= s__KarinExplosiveNote_allocate()
        local unit u
        set s__KarinExplosiveNote_explosivecaster=GetTriggerUnit()
        set s__KarinExplosiveNote_b=false
        set s__KarinExplosiveNote_KarinRThrown=false
        set s__KarinExplosiveNote_count[this]=0
        set s__KarinExplosiveNote_e1[this]=AddSpecialEffectTarget("note.mdl", s__KarinExplosiveNote_explosivecaster, "right hand")
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Karin_R_Activation, 100, GetTriggerUnit())
        endif
        set u=CreateAbilityDummy(s__KarinExplosiveNote_explosivecaster , 'A01E')
        call IssueTargetOrder(u, "bloodlust", s__KarinExplosiveNote_explosivecaster)
        set u=null
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__KarinExplosiveNote_explosivecaster), s__KarinExplosiveNote_SPELL_ID, false)
        call UnitAddAbility(s__KarinExplosiveNote_explosivecaster, 'A00K')


        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__KarinExplosiveNote_explosivecaster), GetUnitY(s__KarinExplosiveNote_explosivecaster), 1000, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            if bj_lastCreatedUnit != s__KarinExplosiveNote_explosivecaster and IsUnitAlly(bj_lastCreatedUnit, GetOwningPlayer(s__KarinExplosiveNote_explosivecaster)) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    call SetUnitLifeBJ(bj_lastCreatedUnit, GetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE) + ( ( 100 + 100 * GetUnitAbilityLevel(s__KarinExplosiveNote_explosivecaster, s__KarinExplosiveNote_SPELL_ID) ) ))
                    call CreateTextTagUnitBJ(I2S(( ( 100 + 100 * GetUnitAbilityLevel(s__KarinExplosiveNote_explosivecaster, s__KarinExplosiveNote_SPELL_ID) ) )), bj_lastCreatedUnit, 0, 10.00, 0, 255, 0, 0)
                    call SetTextTagVelocityBJ(GetLastCreatedTextTag(), 128.00, 90)
                    call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
                    call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 2.00)
                    call SetTextTagFadepointBJ(GetLastCreatedTextTag(), 1.00)
                    call SetTextTagAgeBJ(GetLastCreatedTextTag(), 0)
                    if not IsUnitVisible(s__KarinExplosiveNote_explosivecaster, GetLocalPlayer()) then
                        call SetTextTagVisibility(bj_lastCreatedTextTag, false)
                    endif
            endif
        endloop
        call DestroyGroup(bj_lastCreatedGroup)

        call TimerStart(NewTimerEx(this), 0.03, true, function s__KarinExplosiveNote_explosion)
    endfunction 

