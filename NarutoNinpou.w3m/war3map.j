    function s__FoxRush_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__FoxRush_caster[this])
        local real y= GetUnitY(s__FoxRush_caster[this])
        local real new_x= (((x )*1.0) + Cos((( s__FoxRush_angle[this] )*1.0)) * (( 45)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__FoxRush_angle[this] )*1.0)) * (( 45)*1.0)) // INLINED!!
 local integer i
        set s__FoxRush_count[this]=s__FoxRush_count[this] + 1
        call SetUnitAnimationByIndex(s__FoxRush_caster[this], 3)
	if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
        	call SetUnitX(s__FoxRush_caster[this], new_x)
        	call SetUnitY(s__FoxRush_caster[this], new_y)
	else
		set s__FoxRush_count[this]=s__FoxRush_max_count[this]
	endif
        call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        if GetDistance(x , y , s__FoxRush_target_x[this] , s__FoxRush_target_y[this]) <= 100 or s__FoxRush_count[this] >= s__FoxRush_max_count[this] then
		set i=0
		loop
			exitwhen i > 5
			set s__FoxRush_angle[this]=s__FoxRush_angle[this] - 24 + 8 * ( i + 1 )
			set new_x=(((GetUnitX(s__FoxRush_caster[this]) )*1.0) + Cos((( s__FoxRush_angle[this] )*1.0)) * (( 200)*1.0)) // INLINED!!
			set new_y=(((GetUnitY(s__FoxRush_caster[this]) )*1.0) + Sin((( s__FoxRush_angle[this] )*1.0)) * (( 200)*1.0)) // INLINED!!
			set bj_lastCreatedEffect=AddSpecialEffect("war3mapimported\\Earth_Spikes.mdl", new_x, new_y)
			call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, Deg2Rad(45))
			call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__FoxRush_angle[this])
            		call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
            		call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 2.0)
           		call DestroyEffect(bj_lastCreatedEffect)
			set i=i + 1
		endloop
            	call SlowArea(s__FoxRush_caster[this] , GetUnitX(s__FoxRush_caster[this]) , GetUnitY(s__FoxRush_caster[this]) , 400.0)
            	set bj_lastCreatedGroup=CreateGroup()
            	set s__FoxRush_instance=this
            	call GroupEnumUnitsInRange(bj_lastCreatedGroup, GetUnitX(s__FoxRush_caster[this]), GetUnitY(s__FoxRush_caster[this]), 400.0, Filter(function s__FoxRush_dealDamage))
            	call DestroyGroup(bj_lastCreatedGroup)
        	call ReleaseTimer(GetExpiredTimer())
        	call s__FoxRush_deallocate(this)
        endif
     endfunction
    
     function s__FoxRush_actions takes nothing returns nothing
         local integer this= s__FoxRush_allocate()
        	set s__FoxRush_caster[this]=GetTriggerUnit()
        	set s__FoxRush_count[this]=0
        	set s__FoxRush_angle[this]=Atan3(GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY())
		set s__FoxRush_max_count[this]=R2I(GetDistance(GetUnitX(s__FoxRush_caster[this]) , GetUnitY(s__FoxRush_caster[this]) , GetSpellTargetX() , GetSpellTargetY()) / 45)
		set s__FoxRush_target_x[this]=GetSpellTargetX()
		set s__FoxRush_target_y[this]=GetSpellTargetY()
        	call TimerStart(NewTimerEx(this), 0.03, true, function s__FoxRush_periodic)
     endfunction

        function s__FoxRush_onInit takes nothing returns nothing
            call RegisterSpellEffectEvent2((s__FoxRush_SPELL_ID ) , Filter(( function s__FoxRush_actions))) // INLINED!!
        endfunction
        
