	    loop
		    set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
		    exitwhen bj_lastCreatedUnit == null
		    call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
		    if GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
			    call SetUnitPosition(bj_lastCreatedUnit, GetRectCenterX(gg_rct_KaguyaLavaDimension), GetRectCenterY(gg_rct_KaguyaLavaDimension))
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    call PanCameraToTimedForPlayer(GetOwningPlayer(bj_lastCreatedUnit), GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), 0)
                endif
                call GroupAddUnit(s__KaguyaLavaDimension_damaged[this], bj_lastCreatedUnit)
		    endif
	    endloop
        set s__KaguyaLavaDimension_teleport_back=false
	    call DestroyEffect(AddSpecialEffect(("blackblink.mdx" ), (( GetUnitX(s__KaguyaLavaDimension_caster[this]) )*1.0), (( GetUnitY(s__KaguyaLavaDimension_caster[this]))*1.0))) // INLINED!!
        call TimerStart(NewTimerEx(this), 0.5, false, function s__KaguyaLavaDimension_disableSkill)
	    call TimerStart(NewTimerEx(this), 0.5, true, function s__KaguyaLavaDimension_periodic)
 endfunction 

