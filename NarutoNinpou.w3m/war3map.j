//Implemented from module Alloc:
    
        function s__ObitoNewQ_allocate takes nothing returns integer
            local integer this
    
            //call BJDebugMsg("Alloc: " + I2S(instanceCount))
            if ( s__ObitoNewQ_Alloc___recycle[(0)] == 0 ) then
                set s__ObitoNewQ_Alloc___instanceCount=s__ObitoNewQ_Alloc___instanceCount + 1
