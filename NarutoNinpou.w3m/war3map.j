 function s__SasukeChidoriEiso_removeAbility takes nothing returns nothing
  local unit u= (s__UnitDex_Unit[((LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))))]) // INLINED!!
		if ( GetUnitAbilityLevel(u, 'B00T') == 0 and GetUnitAbilityLevel(u, 'A0KU') == 0 ) or ( s__SasukeChidori_blackchidori == false and GetUnitAbilityLevel(u, 'A0KU') > 0 ) then
			if GetUnitAbilityLevel(u, 'B00Y') > 0 then
			else
				call SetPlayerAbilityAvailable(GetOwningPlayer(u), s__SasukeChidoriEiso_SPELL_ID, true)
				call UnitRemoveAbility(u, 'A17A')
			endif
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 

