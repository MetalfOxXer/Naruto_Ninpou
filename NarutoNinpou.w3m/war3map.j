 function s__NarutoLevel_periodic takes nothing returns nothing
		if s__NarutoLevel_naruto == null then
			call ReleaseTimer(GetExpiredTimer())
		endif
		if GetHeroLevel(s__NarutoLevel_naruto) >= 15 and GetUnitAbilityLevel(s__NarutoLevel_naruto, 'A14W') > 0 then
			call SetUnitAbilityLevel(s__NarutoLevel_naruto, 'A14W', 2)
			call ReleaseTimer(GetExpiredTimer())
		elseif GetHeroLevel(s__NarutoLevel_naruto) >= 15 and GetUnitAbilityLevel(s__NarutoLevel_naruto, 'A088') > 0 then
			call SetUnitAbilityLevel(s__NarutoLevel_naruto, 'A088', 2)
			call ReleaseTimer(GetExpiredTimer())
		endif
 endfunction 
	
 function s__NarutoLevel_leave takes nothing returns nothing
		if GetUnitTypeId(GetLeavingUnit()) == 'H07E' then
			set s__NarutoLevel_naruto=GetLeavingUnit()
			call TimerStartEx((NewTimerEx(0)) , 1.0 , true , function s__NarutoLevel_periodic , "NarutoLevel_periodic") // INLINED!!
		endif
 endfunction

 function s__NarutoLevel_onInit takes nothing returns nothing
		call TriggerAddCondition(RegisterPlayerUnitEvent__leave_trigger, Filter((function s__NarutoLevel_leave))) // INLINED!!
 endfunction 

