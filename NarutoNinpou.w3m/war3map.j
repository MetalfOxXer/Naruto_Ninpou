    function s__PakuraE_dealDamage takes nothing returns boolean
        local unit u= GetFilterUnit()
        if GetWidgetLife(u) > 0.405 and IsUnitEnemy(u, GetOwningPlayer(s__PakuraE_caster[s__PakuraE_instance])) then
            call UnitDamageTarget(s__PakuraE_caster[s__PakuraE_instance], u, ( GetHeroInt(s__PakuraE_caster[s__PakuraE_instance], true) / 2 ) * GetUnitAbilityLevel(s__PakuraE_caster[s__PakuraE_instance], s__PakuraE_SPELL_ID), true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
            call StunUnitTimed(s__PakuraE_caster[s__PakuraE_instance] , u , ( 1.0 + 0.1 * GetUnitAbilityLevel(s__PakuraE_caster[s__PakuraE_instance], s__PakuraE_SPELL_ID) ))
            call AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", GetUnitX(u), GetUnitY(u))
        endif
        return false
    endfunction

    function s__PakuraE_cleanUp takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        
        loop
            set bj_lastCreatedUnit=FirstOfGroup(s__PakuraE_orbs[this])
            exitwhen bj_lastCreatedUnit == null
            call KillUnit(bj_lastCreatedUnit)
            call ShowUnit(bj_lastCreatedUnit, false)
            call RemoveUnit(bj_lastCreatedUnit)
            call GroupRemoveUnit(PakuraAllOrbs, bj_lastCreatedUnit)
            call GroupRemoveUnit(s__PakuraE_orbs[this], bj_lastCreatedUnit)
        endloop

        call DestroyGroup(s__PakuraE_orbs[this])
        set s__PakuraE_orbs[this]=null
        call s__PakuraE_deallocate(this)
        call ReleaseTimer(GetExpiredTimer())
    endfunction

    function s__PakuraE_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local integer this2
        local real fx
        local real fy
        local real x
        local real y
        local real new_x
        local real new_y
        local real angle
        local real angle2
        local real tx
        local real ty
        local real speed
        local real offset
        local integer i= 0
        local unit orb

        set s__PakuraE_time[this]=s__PakuraE_time[this] + 0.03
        set offset=s__PakuraE_angle[this]

        if s__PakuraE_phase[this] == 0 then
            set s__PakuraE_angle[this]=s__PakuraE_angle[this] + 5.0
            loop
                exitwhen i >= s__PakuraE_PAKURAE_ORBS
                set angle=offset + ( 360 / s__PakuraE_PAKURAE_ORBS ) * i
                set x=(((GetUnitX(s__PakuraE_follow[this]) )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( s__PakuraE_radius[this])*1.0)) // INLINED!!
                set y=(((GetUnitY(s__PakuraE_follow[this]) )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( s__PakuraE_radius[this])*1.0)) // INLINED!!
                call SetUnitX(s__PakuraE_Orb[(this)*(1)+i], x)
                call SetUnitY(s__PakuraE_Orb[(this)*(1)+i], y)
                set i=i + 1
            endloop

            if not IsUnitAliveBJ(s__PakuraE_caster[this]) or s__PakuraE_time[this] >= s__PakuraE_ORBIT_DURATION or s__PakuraE_PakuraE_Recasted then
                set s__PakuraE_launched[this]=false
                set s__PakuraE_follow[this]=CreateUnit(GetOwningPlayer(s__PakuraE_caster[this]), 'h0AD', GetUnitX(s__PakuraE_caster[this]), GetUnitY(s__PakuraE_caster[this]), 0)
                set s__PakuraE_startX[this]=GetUnitX(s__PakuraE_follow[this])
                set s__PakuraE_startY[this]=GetUnitY(s__PakuraE_follow[this])
                
                if not s__PakuraE_PakuraE_Recasted then
                    set s__PakuraE_PakuraEcastX=(s__UserMouse_mouseX[s__UserMouse__staticgetindex((GetOwningPlayer(s__PakuraE_caster[this])))]) // INLINED!!
                    set s__PakuraE_PakuraEcastY=(s__UserMouse_mouseY[s__UserMouse__staticgetindex((GetOwningPlayer(s__PakuraE_caster[this])))]) // INLINED!!
                endif
                
                set angle2=Atan3(GetUnitX(s__PakuraE_caster[this]) , GetUnitY(s__PakuraE_caster[this]) , s__PakuraE_PakuraEcastX , s__PakuraE_PakuraEcastY)
                if GetDistance(GetUnitX(s__PakuraE_caster[this]) , GetUnitY(s__PakuraE_caster[this]) , s__PakuraE_PakuraEcastX , s__PakuraE_PakuraEcastY) >= 1250 then
                    set s__PakuraE_PakuraEcastX=(((GetUnitX(s__PakuraE_caster[this]) )*1.0) + Cos((( angle2 )*1.0)) * (( 1250)*1.0)) // INLINED!!
                    set s__PakuraE_PakuraEcastY=(((GetUnitY(s__PakuraE_caster[this]) )*1.0) + Sin((( angle2 )*1.0)) * (( 1250)*1.0)) // INLINED!!
                endif
                set s__PakuraE_distance[this]=GetDistance(GetUnitX(s__PakuraE_caster[this]) , GetUnitY(s__PakuraE_caster[this]) , s__PakuraE_PakuraEcastX , s__PakuraE_PakuraEcastY)
                set s__PakuraE_phase[this]=1
                set s__PakuraE_time[this]=0.0
                call UnitRemoveAbility(s__PakuraE_caster[this], s__PakuraE_RECAST_ID)
                call SetPlayerAbilityAvailable(GetOwningPlayer(s__PakuraE_caster[this]), s__PakuraE_SPELL_ID, true)
                set s__PakuraE_PakuraE_Recasted=false // Reset the flag
            endif

        elseif s__PakuraE_phase[this] == 1 then

            set s__PakuraE_angle[this]=s__PakuraE_angle[this] + 15 + ( s__PakuraE_distanceTrav[this] / s__PakuraE_distance[this] * 25 )
            set fx=GetUnitX(s__PakuraE_follow[this])
            set fy=GetUnitY(s__PakuraE_follow[this])
            set speed=s__PakuraE_LAUNCH_SPEED
            set angle=Atan3(fx , fy , s__PakuraE_PakuraEcastX , s__PakuraE_PakuraEcastY)

            set tx=(((fx )*1.0) + Cos((( angle )*1.0)) * (( speed)*1.0)) // INLINED!!
            set ty=(((fy )*1.0) + Sin((( angle )*1.0)) * (( speed)*1.0)) // INLINED!!
            call SetUnitX(s__PakuraE_follow[this], tx)
            call SetUnitY(s__PakuraE_follow[this], ty)
            set s__PakuraE_distanceTrav[this]=s__PakuraE_distanceTrav[this] + speed

            set i=0
            loop
                exitwhen i >= s__PakuraE_PAKURAE_ORBS
                set angle=offset + ( 360 / s__PakuraE_PAKURAE_ORBS ) * i
                set x=(((GetUnitX(s__PakuraE_follow[this]) )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( 200 - ( s__PakuraE_distanceTrav[this] / s__PakuraE_distance[this] * 100 ))*1.0)) // INLINED!!
                set y=(((GetUnitY(s__PakuraE_follow[this]) )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( 200 - ( s__PakuraE_distanceTrav[this] / s__PakuraE_distance[this] * 100 ))*1.0)) // INLINED!!
                call SetUnitX(s__PakuraE_Orb[(this)*(1)+i], x)
                call SetUnitY(s__PakuraE_Orb[(this)*(1)+i], y)
                set i=i + 1
            endloop

            set bj_lastCreatedGroup=CreateGroup()
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, tx, ty, 200.0, null)
            loop
                set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
                exitwhen bj_lastCreatedUnit == null
                if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__PakuraE_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 then
                    if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                        set s__PakuraE_PakuraEcastX=GetUnitX(bj_lastCreatedUnit)
                        set s__PakuraE_PakuraEcastY=GetUnitY(bj_lastCreatedUnit)
                    endif
                endif
                call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
            endloop
            call DestroyGroup(bj_lastCreatedGroup)


            if s__PakuraE_time[this] >= 0.87 or GetDistance(tx , ty , s__PakuraE_PakuraEcastX , s__PakuraE_PakuraEcastY) < 50 then
                set s__PakuraE_phase[this]=2
                set s__PakuraE_time[this]=0.0
            endif

        elseif s__PakuraE_phase[this] == 2 then

            set bj_lastCreatedGroup=CreateGroup()
            set s__PakuraE_instance=this
            call GroupEnumUnitsInRange(bj_lastCreatedGroup, s__PakuraE_PakuraEcastX, s__PakuraE_PakuraEcastY, 200, Filter(function s__PakuraE_dealDamage))
            call DestroyGroup(bj_lastCreatedGroup)
            set bj_lastCreatedEffect=AddSpecialEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", s__PakuraE_PakuraEcastX, s__PakuraE_PakuraEcastY)
            call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
            call DestroyEffect(bj_lastCreatedEffect)

            set i=0
            loop
                exitwhen i >= s__PakuraE_PAKURAE_ORBS
                set angle=offset + ( 360 / s__PakuraE_PAKURAE_ORBS ) * i
                set x=(((s__PakuraE_PakuraEcastX )*1.0) + Cos((( Deg2Rad(angle) )*1.0)) * (( 50)*1.0)) // INLINED!!
                set y=(((s__PakuraE_PakuraEcastY )*1.0) + Sin((( Deg2Rad(angle) )*1.0)) * (( 50)*1.0)) // INLINED!!
                call SetUnitX(s__PakuraE_Orb[(this)*(1)+i], x)
                call SetUnitY(s__PakuraE_Orb[(this)*(1)+i], y)
                set i=i + 1
            endloop


            set this2=s__PakuraE_allocate()
            set i=0
            loop
                exitwhen i >= s__PakuraE_PAKURAE_ORBS
                if s__PakuraE_Orb[(this)*(1)+i] != null then
                    call UnitApplyTimedLife(s__PakuraE_Orb[(this)*(1)+i], 'BTLF', 7.1)
                    call GroupAddUnit(PakuraAllOrbs, s__PakuraE_Orb[(this)*(1)+i])
                    call GroupAddUnit(s__PakuraE_orbs[this2], s__PakuraE_Orb[(this)*(1)+i])
                    set s__PakuraD_PakuraOrbCount=s__PakuraD_PakuraOrbCount + 1
                    set s__PakuraE_Orb[(this)*(1)+i]= null
                endif
                set i=i + 1
            endloop
            call s__PakuraD_BeginBurnTimer()
            call TimerStart(NewTimerEx(this2), 1.00, false, function s__PakuraE_cleanUp)
            call RemoveUnit(s__PakuraE_follow[this])
            call ReleaseTimer(GetExpiredTimer())
            call s__PakuraE_deallocate(this)
        endif
    endfunction

    function s__PakuraE_actions takes nothing returns nothing
        local integer this= s__PakuraE_allocate()
        local integer i= 0

        set s__PakuraE_caster[this]=GetTriggerUnit()
        set s__PakuraE_follow[this]=s__PakuraE_caster[this]
        set s__PakuraE_launched[this]=true
        set s__PakuraE_radius[this]=200.00
        set s__PakuraE_angle[this]=0.0
        set s__PakuraE_time[this]=0.0
        set s__PakuraE_PakuraEcastX=0
        set s__PakuraE_PakuraEcastY=0
        set s__PakuraE_phase[this]=0
        set s__PakuraE_distanceTrav[this]=0.0
        set s__PakuraE_isRecast[this]=false
        set s__PakuraE_range[this]=BlzGetAbilityRealLevelField(BlzGetUnitAbility(s__PakuraE_caster[this], s__PakuraE_SPELL_ID), ABILITY_RLF_CAST_RANGE, 0)
        loop
            exitwhen i >= s__PakuraE_PAKURAE_ORBS
            set s__PakuraE_Orb[(this)*(1)+i]= CreateUnit(GetOwningPlayer(s__PakuraE_caster[this]), 'h0AF', GetUnitX(s__PakuraE_caster[this]), GetUnitY(s__PakuraE_caster[this]), 0)
            set i=i + 1
        endloop
        call UnitAddAbility(s__PakuraE_caster[this], s__PakuraE_RECAST_ID)
        call SetPlayerAbilityAvailable(GetOwningPlayer(s__PakuraE_caster[this]), s__PakuraE_SPELL_ID, false)
        call SetUnitAnimation(s__PakuraE_caster[this], "spell slam")
        set s__PakuraE_PakuraE_Recasted=false
        call TimerStart(NewTimerEx(this), 0.03, true, function s__PakuraE_periodic)
    endfunction

    function s__PakuraE_recast takes nothing returns nothing
        set s__PakuraE_PakuraEcastX=GetSpellTargetX()
        set s__PakuraE_PakuraEcastY=GetSpellTargetY()
        set s__PakuraE_PakuraE_Recasted=true
        call UnitRemoveAbility(GetTriggerUnit(), s__PakuraE_RECAST_ID)
        call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()), s__PakuraE_SPELL_ID, true)
    endfunction

