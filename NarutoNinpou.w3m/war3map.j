    endfunction
    
    function s__SuigetsuGoshuiwan_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real target_x= GetUnitX(s__SuigetsuGoshuiwan_target[this])
        local real target_y= GetUnitY(s__SuigetsuGoshuiwan_target[this])
        local real new_x= (((target_x )*1.0) + Cos((( s__SuigetsuGoshuiwan_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_y= (((target_y )*1.0) + Sin((( s__SuigetsuGoshuiwan_angle[this] )*1.0)) * (( 50)*1.0)) // INLINED!!
        set s__SuigetsuGoshuiwan_count[this]=s__SuigetsuGoshuiwan_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__SuigetsuGoshuiwan_target[this], new_x)
            call SetUnitY(s__SuigetsuGoshuiwan_target[this], new_y)
            call DestroyEffect(AddSpecialEffect(("Effects\\s_Earth_Smash.mdx" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        else
            //set this.count = 11
        endif
        if s__SuigetsuGoshuiwan_count[this] > 10 then
	    set s__SuigetsuGoshuiwan_count[this]=0
            set s__SuigetsuGoshuiwan_distance[this]=GetDistance(GetUnitX(s__SuigetsuGoshuiwan_caster[this]) , GetUnitY(s__SuigetsuGoshuiwan_caster[this]) , new_x , new_y)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__SuigetsuGoshuiwan_jump)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__SuigetsuGoshuiwan_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real caster_x= GetUnitX(s__SuigetsuGoshuiwan_caster[this])
        local real caster_y= GetUnitY(s__SuigetsuGoshuiwan_caster[this])
        local real target_x= GetUnitX(s__SuigetsuGoshuiwan_target[this])
        local real target_y= GetUnitY(s__SuigetsuGoshuiwan_target[this])
        local real angle= Atan3(caster_x , caster_y , target_x , target_y)
        local real new_x= (((target_x )*1.0) + Cos((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
        local real new_y= (((target_y )*1.0) + Sin((( angle )*1.0)) * (( 20)*1.0)) // INLINED!!
        local real new_x_2= (((target_x )*1.0) + Cos((( s__SuigetsuGoshuiwan_angle[this] - bj_PI )*1.0)) * (( 50)*1.0)) // INLINED!!
        local real new_y_2= (((target_y )*1.0) + Sin((( s__SuigetsuGoshuiwan_angle[this] - bj_PI )*1.0)) * (( 50)*1.0)) // INLINED!!
        set s__SuigetsuGoshuiwan_count[this]=s__SuigetsuGoshuiwan_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__SuigetsuGoshuiwan_target[this], new_x)
            call SetUnitY(s__SuigetsuGoshuiwan_target[this], new_y)
	    call SetUnitX(s__SuigetsuGoshuiwan_caster[this], target_x)
	    call SetUnitY(s__SuigetsuGoshuiwan_caster[this], target_y)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
        else
            //set this.count = 16
        endif
        if ModuloInteger(s__SuigetsuGoshuiwan_count[this], 5) == 1 then
            call SetUnitAnimation(s__SuigetsuGoshuiwan_caster[this], "attack")
            call UnitDamageTarget(s__SuigetsuGoshuiwan_caster[this], s__SuigetsuGoshuiwan_target[this], ( ( 3.0 * GetHeroAgi(s__SuigetsuGoshuiwan_caster[this], true) + 3.0 * GetHeroStr(s__SuigetsuGoshuiwan_caster[this], true) ) * GetUnitAbilityLevel(s__SuigetsuGoshuiwan_caster[this], s__SuigetsuGoshuiwan_SPELL_ID) ) / 4, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
        endif
        set bj_lastCreatedEffect=AddSpecialEffect("GenericSlash.mdx", target_x, target_y)
        call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, angle)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.3)*1.0) , true) // INLINED!!
        set bj_lastCreatedEffect=AddSpecialEffect("sy jhxcom_2000.mdl", target_x, target_y)
        call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, angle + Deg2Rad(GetRandomReal(- 20, 20)))
        call BlzSetSpecialEffectColor(bj_lastCreatedEffect, 200, 200, 200)
        call BlzSetSpecialEffectAlpha(bj_lastCreatedEffect, 150)
        call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 0.8)
        call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 4.0)
        call BlzPlaySpecialEffect(bj_lastCreatedEffect, ANIM_TYPE_ATTACK)
        call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , true) // INLINED!!
        if s__SuigetsuGoshuiwan_count[this] > 15 then
            set s__SuigetsuGoshuiwan_count[this]=0
            set s__SuigetsuGoshuiwan_angle[this]=angle
            call SetUnitTimeScale(s__SuigetsuGoshuiwan_caster[this], 1.0)
            call SetUnitAnimationByIndex(s__SuigetsuGoshuiwan_caster[this], 2)

	        call KillUnit(CreateUnit(GetOwningPlayer(s__SuigetsuGoshuiwan_caster[this]), 'e068', GetUnitX(s__SuigetsuGoshuiwan_target[this]), GetUnitY(s__SuigetsuGoshuiwan_target[this]), Rad2Deg(s__SuigetsuGoshuiwan_angle[this])))

            call TimerStart(NewTimerEx(this), 0.03, true, function s__SuigetsuGoshuiwan_knockback)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction
    
    function s__SuigetsuGoshuiwan_actions takes nothing returns nothing
        local integer this= s__SuigetsuGoshuiwan_allocate()
        set s__SuigetsuGoshuiwan_caster[this]=GetTriggerUnit()
        set s__SuigetsuGoshuiwan_target[this]=GetSpellTargetUnit()
        if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
            call PlaySoundOnUnitBJ(gg_snd_Suigetsu_R, 100.0, GetTriggerUnit())
        endif
        call PauseUnit(s__SuigetsuGoshuiwan_caster[this], true)
        call PauseUnit(s__SuigetsuGoshuiwan_target[this], true)
        set s__SuigetsuGoshuiwan_count[this]=0
        //call SetUnitTimeScale(this.caster, 5.0)
        //call SetUnitAnimationByIndex(this.caster, 2)

        call TimerStart(NewTimerEx(this), 0.1, true, function s__SuigetsuGoshuiwan_periodic)
    endfunction
    
    function s__SuigetsuGoshuiwan_onInit takes nothing returns nothing
        call RegisterSpellEffectEventForId(46 , s__SuigetsuGoshuiwan_SPELL_ID , function s__SuigetsuGoshuiwan_actions)
    endfunction
    
