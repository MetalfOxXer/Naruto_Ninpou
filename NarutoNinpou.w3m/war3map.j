            call ReleaseTimer(GetExpiredTimer())
        endfunction
        
        function s__RockLeeUraRenge___Spell_periodic takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real angle= GetRandomReal(0, 360)
            local real height= GetRandomReal(0, 500)
            local real offset= GetRandomReal(0, 500)
            local real new_x= s__RockLeeUraRenge___Spell_target_x[this] + Cos(Deg2Rad(angle)) * offset
            local real new_y= s__RockLeeUraRenge___Spell_target_y[this] + Sin(Deg2Rad(angle)) * offset
            call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_caster[this], height, 0)
            call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_target[this], height, 0)
            call SetUnitX(s__RockLeeUraRenge___Spell_caster[this], new_x)
            call SetUnitY(s__RockLeeUraRenge___Spell_caster[this], new_y)
            call SetUnitFacing(s__RockLeeUraRenge___Spell_caster[this], angle)
            call SetUnitX(s__RockLeeUraRenge___Spell_target[this], new_x)
            call SetUnitY(s__RockLeeUraRenge___Spell_target[this], new_y)
            call SetUnitFacing(s__RockLeeUraRenge___Spell_target[this], angle + 180)

		set bj_lastCreatedEffect=AddSpecialEffect("Hit.mdx", GetUnitX(s__RockLeeUraRenge___Spell_target[this]), GetUnitY(s__RockLeeUraRenge___Spell_target[this]))
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, GetUnitFlyHeight(s__RockLeeUraRenge___Spell_target[this]) + GetPointZ(GetUnitX(s__RockLeeUraRenge___Spell_target[this]) , GetUnitY(s__RockLeeUraRenge___Spell_target[this])))
		call DestroyEffect(bj_lastCreatedEffect)

            if ModuloInteger(s__RockLeeUraRenge___Spell_count[this], 2) == 0 then
		set bj_lastCreatedEffect=AddSpecialEffect("s_FreezingRing.mdl", new_x, new_y)
		call BlzSetSpecialEffectPitch(bj_lastCreatedEffect, - 1.57)
		call BlzSetSpecialEffectRoll(bj_lastCreatedEffect, Deg2Rad(angle))
		call BlzSetSpecialEffectHeight(bj_lastCreatedEffect, height + GetPointZ(new_x , new_y))
		call BlzSetSpecialEffectTimeScale(bj_lastCreatedEffect, 2.0)
		call DestroyEffect(bj_lastCreatedEffect)
            endif
            call SetUnitAnimation(s__RockLeeUraRenge___Spell_caster[this], "attack")
            set s__RockLeeUraRenge___Spell_count[this]=s__RockLeeUraRenge___Spell_count[this] + 1
            if s__RockLeeUraRenge___Spell_count[this] > 100 then
                call SetUnitTimeScale(s__RockLeeUraRenge___Spell_caster[this], 1.0)
                call SetUnitAnimation(s__RockLeeUraRenge___Spell_target[this], "death")
                call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_caster[this], 600, 0)
                call SetUnitFlyHeight(s__RockLeeUraRenge___Spell_target[this], 500, 0)
                call SetUnitAnimationByIndex(s__RockLeeUraRenge___Spell_caster[this], 9)
call AddSpecialEffectTarget(("SuperShinyThingy.mdx" ), ( s__RockLeeUraRenge___Spell_caster[this] ), ( "left foot")) // INLINED!!
                call TimerStart(NewTimerEx(this), 0.1, false, function s__RockLeeUraRenge___Spell_pause3)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endfunction
        
        function s__RockLeeUraRenge___Spell_actions2 takes nothing returns nothing
            local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
            local real target_x= GetUnitX(s__RockLeeUraRenge___Spell_target[this])
            local real target_y= GetUnitY(s__RockLeeUraRenge___Spell_target[this])
            call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" ), (( target_x )*1.0), (( target_y)*1.0))) // INLINED!!
            call SetUnitAnimation(s__RockLeeUraRenge___Spell_caster[this], "attack")
            set s__RockLeeUraRenge___Spell_count[this]=0
            call TimerStart(NewTimerEx(this), 0.02, true, function s__RockLeeUraRenge___Spell_periodic)
        endfunction
        
        function s__RockLeeUraRenge___Spell_actions takes nothing returns nothing
            local integer this
            local real caster_x
            local real caster_y
            local real target_x
            local real target_y
            local real angle
            local real distance_x
            local real distance_y
            local real distance
            local real new_x
            local real new_y
            local integer i= 0
            if true then //GetUnitAbilityLevel(GetTriggerUnit(), 'B02Y') > 0 then 
                if IsUnitVisible(GetTriggerUnit(), GetLocalPlayer()) then
                   call PlaySoundOnUnitBJ(gg_snd_Rock_Lee_T, 100.0, GetTriggerUnit())
                endif
                set this=s__RockLeeUraRenge___Spell_allocate()
                set s__RockLeeUraRenge___Spell_caster[this]=GetTriggerUnit()
		set s__RockLeeUraRenge___Spell_caster_x[this]=GetUnitX(s__RockLeeUraRenge___Spell_caster[this])
		set s__RockLeeUraRenge___Spell_caster_y[this]=GetUnitY(s__RockLeeUraRenge___Spell_caster[this])
                set s__RockLeeUraRenge___Spell_target[this]=GetSpellTargetUnit()
                set caster_x=GetUnitX(s__RockLeeUraRenge___Spell_caster[this])
                set caster_y=GetUnitY(s__RockLeeUraRenge___Spell_caster[this])
                set target_x=GetUnitX(s__RockLeeUraRenge___Spell_target[this])
                set target_y=GetUnitY(s__RockLeeUraRenge___Spell_target[this])
		set s__RockLeeUraRenge___Spell_gatelevel[this]=s__OPEN_GATE_COUNTER[(GetUnitUserData((s__RockLeeUraRenge___Spell_caster[this])))] // INLINED!!
                set angle=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
                set distance_x=caster_x - target_x
                set distance_y=caster_y - target_y
                set distance=SquareRoot(distance_x * distance_x + distance_y * distance_y)
                set s__RockLeeUraRenge___Spell_e1[this]=(AddSpecialEffectTarget(("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl" ), ( s__RockLeeUraRenge___Spell_caster[this] ), ( "right hand"))) // INLINED!!
                set s__RockLeeUraRenge___Spell_e2[this]=(AddSpecialEffectTarget(("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl" ), ( s__RockLeeUraRenge___Spell_caster[this] ), ( "left hand"))) // INLINED!!
                loop
                    set i=i + 1
                    exitwhen i > R2I(distance / 40)
                    set new_x=caster_x + Cos(angle) * 40 * i
                    set new_y=caster_y + Sin(angle) * 40 * i
                    call DestroyEffect(AddSpecialEffect(("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" ), (( new_x )*1.0), (( new_y)*1.0))) // INLINED!!
                endloop
                call SetUnitX(s__RockLeeUraRenge___Spell_caster[this], target_x)
                call SetUnitY(s__RockLeeUraRenge___Spell_caster[this], target_y)
                call PauseUnit(s__RockLeeUraRenge___Spell_caster[this], true)
                call PauseUnit(s__RockLeeUraRenge___Spell_target[this], true)
                call SetUnitAnimation(s__RockLeeUraRenge___Spell_caster[this], "spell slam")
                call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" ), (( caster_x )*1.0), (( caster_y)*1.0))) // INLINED!!
                set s__RockLeeUraRenge___Spell_target_x[this]=target_x
                set s__RockLeeUraRenge___Spell_target_y[this]=target_y
                call SetUnitTimeScale(s__RockLeeUraRenge___Spell_caster[this], 10.0)
                if IsUnitVisible(s__RockLeeUraRenge___Spell_caster[this], GetLocalPlayer()) then
                    //call PlaySoundOnUnitBJ(gg_snd_Rock_Lee_D, 100.0, this.caster)
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|cffff0000Rock Lee: No matter what happens to my body, victory will be mine!|r")
                endif
                call TimerStart(NewTimerEx(this), 0.02, false, function s__RockLeeUraRenge___Spell_actions2)
            endif
        endfunction
        
        function s__RockLeeUraRenge___Spell_onInit takes nothing returns nothing
           	    call RegisterSpellEffectEventForId(51 , s__RockLeeUraRenge___Spell_SPELL_ID , function s__RockLeeUraRenge___Spell_actions)
        endfunction
        
    
