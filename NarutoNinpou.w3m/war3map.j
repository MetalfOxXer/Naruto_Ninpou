        set s__IrukaWildAxes_targetX[this1]=GetLocationX(targetLoc)
        set s__IrukaWildAxes_targetX[this2]=s__IrukaWildAxes_targetX[this1]
        set s__IrukaWildAxes_targetY[this1]=GetLocationY(targetLoc)
        set s__IrukaWildAxes_targetY[this2]=s__IrukaWildAxes_targetY[this1]
        call RemoveLocation(targetLoc)
        set targetLoc=null

        set distToTarget=SquareRoot(( s__IrukaWildAxes_targetX[this1] - s__IrukaWildAxes_startX[this1] ) * ( s__IrukaWildAxes_targetX[this1] - s__IrukaWildAxes_startX[this1] ) + ( s__IrukaWildAxes_targetY[this1] - s__IrukaWildAxes_startY[this1] ) * ( s__IrukaWildAxes_targetY[this1] - s__IrukaWildAxes_startY[this1] ))

        if distToTarget < 50. then
            set baseAngle=Atan2(s__IrukaWildAxes_targetY[this1] - s__IrukaWildAxes_startY[this1], s__IrukaWildAxes_targetX[this1] - s__IrukaWildAxes_startX[this1])
            set distToTarget=500.
            set s__IrukaWildAxes_targetX[this1]=s__IrukaWildAxes_startX[this1] + distToTarget * Cos(baseAngle)
            set s__IrukaWildAxes_targetY[this1]=s__IrukaWildAxes_startY[this1] + distToTarget * Sin(baseAngle)
            set s__IrukaWildAxes_targetX[this2]=s__IrukaWildAxes_targetX[this1]
            set s__IrukaWildAxes_targetY[this2]=s__IrukaWildAxes_targetY[this1]
        else
            set baseAngle=Atan2(s__IrukaWildAxes_targetY[this1] - s__IrukaWildAxes_startY[this1], s__IrukaWildAxes_targetX[this1] - s__IrukaWildAxes_startX[this1])
        endif

        set perpAngle1=baseAngle + angleOffset
        set perpAngle2=baseAngle - angleOffset

        set ctrl1Dist=distToTarget * 0.3
        set s__IrukaWildAxes_ctrl1x[this1]=s__IrukaWildAxes_startX[this1] + ctrl1Dist * Cos(baseAngle) + s__IrukaWildAxes_WIDTH * Cos(perpAngle1)
        set s__IrukaWildAxes_ctrl1y[this1]=s__IrukaWildAxes_startY[this1] + ctrl1Dist * Sin(baseAngle) + s__IrukaWildAxes_WIDTH * Sin(perpAngle1)
        set s__IrukaWildAxes_ctrl1x[this2]=s__IrukaWildAxes_startX[this1] + ctrl1Dist * Cos(baseAngle) + s__IrukaWildAxes_WIDTH * Cos(perpAngle2)
        set s__IrukaWildAxes_ctrl1y[this2]=s__IrukaWildAxes_startY[this1] + ctrl1Dist * Sin(baseAngle) + s__IrukaWildAxes_WIDTH * Sin(perpAngle2)

        set s__IrukaWildAxes_ctrl2x[this1]=( s__IrukaWildAxes_targetX[this1] - 0.25 * s__IrukaWildAxes_startX[this1] - 0.375 * s__IrukaWildAxes_ctrl1x[this1] ) / 0.375
        set s__IrukaWildAxes_ctrl2y[this1]=( s__IrukaWildAxes_targetY[this1] - 0.25 * s__IrukaWildAxes_startY[this1] - 0.375 * s__IrukaWildAxes_ctrl1y[this1] ) / 0.375
        set s__IrukaWildAxes_ctrl2x[this2]=( s__IrukaWildAxes_targetX[this1] - 0.25 * s__IrukaWildAxes_startX[this1] - 0.375 * s__IrukaWildAxes_ctrl1x[this2] ) / 0.375
        set s__IrukaWildAxes_ctrl2y[this2]=( s__IrukaWildAxes_targetY[this1] - 0.25 * s__IrukaWildAxes_startY[this1] - 0.375 * s__IrukaWildAxes_ctrl1y[this2] ) / 0.375

        set s__IrukaWildAxes_progress[this1]=0.
        set s__IrukaWildAxes_progress[this2]=0.

        call TimerStart(NewTimerEx(this1), s__IrukaWildAxes_PERIOD, true, function s__IrukaWildAxes_periodic)
        call TimerStart(NewTimerEx(this2), s__IrukaWildAxes_PERIOD, true, function s__IrukaWildAxes_periodic)
    endfunction

