    function s__SasoriNewBlade_knockback takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SasoriNewBlade_target[this])
        local real y= GetUnitY(s__SasoriNewBlade_target[this])
        local real new_x= (((x )*1.0) + Cos((( s__SasoriNewBlade_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__SasoriNewBlade_angle[this] )*1.0)) * (( 25)*1.0)) // INLINED!!
        set s__SasoriNewBlade_count[this]=s__SasoriNewBlade_count[this] + 1
        if not IsTerrainPathable(new_x, new_y, PATHING_TYPE_WALKABILITY) then
            call SetUnitX(s__SasoriNewBlade_target[this], new_x)
            call SetUnitY(s__SasoriNewBlade_target[this], new_y)
            call DestroyEffect(AddSpecialEffect(("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl" ), (( x )*1.0), (( y)*1.0))) // INLINED!!
        else
            set s__SasoriNewBlade_count[this]=21
        endif
        if s__SasoriNewBlade_count[this] > 2 then
            call s__SasoriNewBlade_destroy(this)
            call ReleaseTimer(GetExpiredTimer())
        endif
    endfunction 
    
    function s__SasoriNewBlade_pull takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        if s__SasoriNewBlade_count[this] > 0 then
			call BlzSetSpecialEffectScale(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]], 0)
            call DestroyEffect(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]])
            if s__SasoriNewBlade_target[this] != null then
                call SetUnitX(s__SasoriNewBlade_target[this], s___SasoriNewBlade_chains_x[s__SasoriNewBlade_chains_x[this]+s__SasoriNewBlade_count[this]])
                call SetUnitY(s__SasoriNewBlade_target[this], s___SasoriNewBlade_chains_y[s__SasoriNewBlade_chains_y[this]+s__SasoriNewBlade_count[this]])
            endif
            set s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]]=null
            set s__SasoriNewBlade_count[this]=s__SasoriNewBlade_count[this] - 1
        else
            if s__SasoriNewBlade_target[this] != null then
                set s__SasoriNewBlade_angle[this]=Deg2Rad(GetUnitFacing(s__SasoriNewBlade_caster[this]))
                call SetUnitAnimation(s__SasoriNewBlade_caster[this], "attack")
                set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(s__SasoriNewBlade_caster[this]), 'e004', GetUnitX(s__SasoriNewBlade_caster[this]), GetUnitY(s__SasoriNewBlade_caster[this]), GetUnitFacing(s__SasoriNewBlade_caster[this]))
                call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 2.0)
                //call StunUnitTimed(this.caster, this.target, 2.0)
                call UnitDamageTarget(s__SasoriNewBlade_caster[this], s__SasoriNewBlade_target[this], GetHeroStr(s__SasoriNewBlade_caster[this], true) * 10, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, null)
                call PauseUnit(s__SasoriNewBlade_target[this], false)
                call SetUnitPropWindow(s__SasoriNewBlade_caster[this], s__SasoriNewBlade_window[this])
                call TimerStart(NewTimerEx(this), 0.03, true, function s__SasoriNewBlade_knockback)
                call ReleaseTimer(GetExpiredTimer())
            else
                call SetUnitPropWindow(s__SasoriNewBlade_caster[this], s__SasoriNewBlade_window[this])
                call s__SasoriNewBlade_destroy(this)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction
    
    function s__SasoriNewBlade_periodic takes nothing returns nothing
        local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
        local real x= GetUnitX(s__SasoriNewBlade_dummy[this])
        local real y= GetUnitY(s__SasoriNewBlade_dummy[this])
        local real new_x= (((x )*1.0) + Cos((( s__SasoriNewBlade_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local real new_y= (((y )*1.0) + Sin((( s__SasoriNewBlade_angle[this] )*1.0)) * (( 30)*1.0)) // INLINED!!
        local unit u= null
        set s__SasoriNewBlade_count[this]=s__SasoriNewBlade_count[this] + 1
        set s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]]=AddSpecialEffect("Abilities\\Weapons\\WardenMissile\\WardenMissile.mdl", new_x, new_y)
		//call BlzSetSpecialEffectPitch(this.chains[this.count], -1.57)
		call BlzSetSpecialEffectYaw(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]], s__SasoriNewBlade_angle[this])
		call BlzSetSpecialEffectScale(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]], 2.0)
		call BlzSetSpecialEffectHeight(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]], 100 + GetPointZ(new_x , new_y))
		set s___SasoriNewBlade_chains_x[s__SasoriNewBlade_chains_x[this]+s__SasoriNewBlade_count[this]]=new_x
		set s___SasoriNewBlade_chains_y[s__SasoriNewBlade_chains_y[this]+s__SasoriNewBlade_count[this]]=new_y
        call SetUnitX(s__SasoriNewBlade_dummy[this], new_x)
        call SetUnitY(s__SasoriNewBlade_dummy[this], new_y)
        set bj_lastCreatedGroup=CreateGroup()
        call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 180.0, null)
        loop
            set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
            exitwhen bj_lastCreatedUnit == null
            if IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__SasoriNewBlade_caster[this])) and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_STRUCTURE) == false then
                set s__SasoriNewBlade_target[this]=bj_lastCreatedUnit
                if IsUnitType(bj_lastCreatedUnit, UNIT_TYPE_HERO) == true then
                    set u=bj_lastCreatedUnit
                endif
            endif
            call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
        endloop
        call DestroyGroup(bj_lastCreatedGroup)
        if u != null then
            set s__SasoriNewBlade_target[this]=u
            //call PauseUnit(this.caster, false)
            call PauseUnit(s__SasoriNewBlade_target[this], true)
            call TimerStart(NewTimerEx(this), 0.03, true, function s__SasoriNewBlade_pull)
            call ReleaseTimer(GetExpiredTimer())
        elseif s__SasoriNewBlade_count[this] > 20 then
            if s__SasoriNewBlade_target[this] != null then
                call PauseUnit(s__SasoriNewBlade_caster[this], false)
                call PauseUnit(s__SasoriNewBlade_target[this], true)
                call TimerStart(NewTimerEx(this), 0.03, true, function s__SasoriNewBlade_pull)
                call ReleaseTimer(GetExpiredTimer())
            else
                call PauseUnit(s__SasoriNewBlade_caster[this], false)
                call SetUnitAnimation(s__SasoriNewBlade_caster[this], "stand")
                call SetUnitPropWindow(s__SasoriNewBlade_caster[this], s__SasoriNewBlade_window[this])
                loop
                    call DestroyEffect(AddSpecialEffect(("Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl" ), (( s___SasoriNewBlade_chains_x[s__SasoriNewBlade_chains_x[this]+s__SasoriNewBlade_count[this]] )*1.0), (( s___SasoriNewBlade_chains_y[s__SasoriNewBlade_chains_y[this]+s__SasoriNewBlade_count[this]])*1.0))) // INLINED!!
					call BlzSetSpecialEffectScale(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]], 0)
                    call DestroyEffect(s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]])
                    set s___SasoriNewBlade_chains[s__SasoriNewBlade_chains[this]+s__SasoriNewBlade_count[this]]=null
                    set s__SasoriNewBlade_count[this]=s__SasoriNewBlade_count[this] - 1
                    exitwhen s__SasoriNewBlade_count[this] == 0
                endloop
                call s__SasoriNewBlade_destroy(this)
                //call TimerStart(NewTimerEx(this), 0.03, true, function thistype.pull)
                call ReleaseTimer(GetExpiredTimer())
            endif
        endif
    endfunction
    
    function s__SasoriNewBlade_actions takes nothing returns nothing
        local integer this= s__SasoriNewBlade__allocate()
        set s__SasoriNewBlade_caster[this]=GetTriggerUnit()
