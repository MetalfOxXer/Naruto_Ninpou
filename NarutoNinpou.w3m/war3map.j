 function s__Ogre01Attack_periodic takes nothing returns nothing
  local integer this= (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) // INLINED!!
  local real unit_x= GetUnitX(s__Ogre01Attack_caster[this])
  local real unit_y= GetUnitY(s__Ogre01Attack_caster[this])
  local real new_x
  local real new_y
  local integer i= 0
  local integer j= 0
		loop
                	set i=i + 1
			set j=0
                	exitwhen i > 25
			loop
				set j=j + 1
				exitwhen j > 6
					set s__Ogre01Attack_facing[this]=Rad2Deg(s__Ogre01Attack_angle[this]) + ( - 49 + 14 * j )
					set new_x=(((unit_x )*1.0) + Cos((( Deg2Rad(s__Ogre01Attack_facing[this]) )*1.0)) * (( 28 * i)*1.0)) // INLINED!!
					set new_y=(((unit_y )*1.0) + Sin((( Deg2Rad(s__Ogre01Attack_facing[this]) )*1.0)) * (( 28 * i)*1.0)) // INLINED!!
					set bj_lastCreatedGroup=CreateGroup()
					call GroupEnumUnitsInRange(bj_lastCreatedGroup, new_x, new_y, 200, null)
					loop
						set bj_lastCreatedUnit=FirstOfGroup(bj_lastCreatedGroup)
						exitwhen bj_lastCreatedUnit == null
						if bj_lastCreatedUnit != s__Ogre01Attack_caster[this] and bj_lastCreatedUnit != TayuyaCore_Tayuya and GetWidgetLife(bj_lastCreatedUnit) > 0.405 and not IsUnitInGroup(bj_lastCreatedUnit, s__Ogre01Attack_damaged[this]) and IsUnitEnemy(bj_lastCreatedUnit, GetOwningPlayer(s__Ogre01Attack_caster[this])) then
							call UnitDamageTarget(s__Ogre01Attack_caster[this], bj_lastCreatedUnit, BlzGetUnitBaseDamage(s__Ogre01Attack_caster[this], 0), true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_MAGIC, null)
							call GroupAddUnit(s__Ogre01Attack_damaged[this], bj_lastCreatedUnit)
						endif
						call GroupRemoveUnit(bj_lastCreatedGroup, bj_lastCreatedUnit)
					endloop
					call DestroyGroup(bj_lastCreatedGroup)
                	endloop
		endloop
		call DestroyGroup(s__Ogre01Attack_damaged[this])
		set s__Ogre01Attack_damaged[this]=null
		set s__Ogre01Attack_caster[this]=null
        	call s__Ogre01Attack_deallocate(this)
		call ReleaseTimer(GetExpiredTimer())
 endfunction
		
		
		
 function s__Ogre01Attack_attack takes nothing returns nothing
     local integer this= s__Ogre01Attack_allocate()
            local real caster_x
            local real offset= 30
            local real caster_y
            local real new_x
            local real new_y
            local real target_x
            local real target_y
            local integer i= 0
            if GetUnitTypeId(GetAttacker()) == 'h034' then //   and GetUnitAbilityLevel(GetAttacker(), 'B03B') > 0 and IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(TayuyaCore_Tayuya))) == true     	
            	set target_x=GetUnitX(GetTriggerUnit())
            	set target_y=GetUnitY(GetTriggerUnit())
            	set s__Ogre01Attack_damaged[this]=CreateGroup()
            	set s__Ogre01Attack_caster[this]=GetAttacker()
            	set caster_x=GetUnitX(s__Ogre01Attack_caster[this])
            	set caster_y=GetUnitY(s__Ogre01Attack_caster[this])
            	set new_x=(((GetUnitX(s__Ogre01Attack_caster[this]) )*1.0) + Cos((( Deg2Rad(GetUnitFacing(s__Ogre01Attack_caster[this])) )*1.0)) * (( 250)*1.0)) // INLINED!!
            	set new_y=(((GetUnitY(s__Ogre01Attack_caster[this]) )*1.0) + Sin((( Deg2Rad(GetUnitFacing(s__Ogre01Attack_caster[this])) )*1.0)) * (( 250)*1.0)) // INLINED!!
            	set s__Ogre01Attack_angle[this]=Atan2(( target_y - caster_y ), ( target_x - caster_x ))
            	set bj_lastCreatedEffect=AddSpecialEffect("PunchImpact.mdx", new_x, new_y)
            	call BlzSetSpecialEffectYaw(bj_lastCreatedEffect, s__Ogre01Attack_angle[this])
            	call BlzSetSpecialEffectScale(bj_lastCreatedEffect, 1.5)
            	call s__EffectUtils__EffectTimer_create((bj_lastCreatedEffect ) , (( 0.2)*1.0) , false) // INLINED!!
            	call TimerStartEx(NewTimerEx(this) , 0.03 , false , function s__Ogre01Attack_periodic , "OgreAttackScope_periodic")
	    else
        	call s__Ogre01Attack_deallocate(this)
            endif
        endfunction
		


 function s__Ogre01Attack_onInit takes nothing returns nothing
		call RegisterPlayerUnitEvent2((EVENT_PLAYER_UNIT_ATTACKED ) , Filter(( function s__Ogre01Attack_attack))) // INLINED!!
 endfunction 
	
 
