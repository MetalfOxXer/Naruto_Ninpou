                set s__AHSS_Graphics_logoImg[this]=CreateDestructable((s__AHSS_Paths_logo[(s__AHSS_Graphics_paths[this])]), GetUnitX(s__AHSS_Graphics_dummy[this]), GetUnitY(s__AHSS_Graphics_dummy[this]) + 75, 270, 6.0, 1) // INLINED!!
            endif
